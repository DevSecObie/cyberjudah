{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  // The data set as a static-assets Worker: every file the engine wrote under dist/,
  // served at data.cyberjudah.io with the cache headers from dist/_headers. No code runs.
  "name": "cyberjudah-data",
  "compatibility_date": "2025-05-01",
  "workers_dev": true,
  "assets": { "directory": "../../dist", "not_found_handling": "none", "html_handling": "none" },
  "routes": [{ "pattern": "data.cyberjudah.io", "custom_domain": true }]
}
