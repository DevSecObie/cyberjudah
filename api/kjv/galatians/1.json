{"book":"Galatians","chapter":1,"translation":"KJV","url":"/bible/galatians/1","verses":[{"verse":1,"text":"Paul, an apostle, (not of men, neither by man, but by Jesus Christ, and God the Father, who raised him from the dead;)","words":[["Paul,",["G3972"]],["an apostle,",["G652"]],["(not",["G3756"]],["of",["G575"]],["men,",["G444"]],["neither",["G3761"]],["by",["G1223"]],["man,",["G444"]],["but",["G235"]],["by",["G1223"]],["Jesus",["G2424"]],["Christ,",["G5547"]],["and",["G2532"]],["God",["G2316"]],["the Father,",["G3962"]],["who",["G3588"]],["raised",["G1453"]],["him",["G846"]],["from",["G1537"]],["the dead;)",[]]]},{"verse":2,"text":"And all the brethren which are with me, unto the churches of Galatia:","words":[["And",["G2532"]],["all",["G3956"]],["the brethren",["G80"]],["which are with",["G4862"]],["me,",["G1698"]],["unto the churches",["G1577"]],["of Galatia:",[]]]},{"verse":3,"text":"Grace be to you and peace from God the Father, and from our Lord Jesus Christ,","words":[["Grace",["G5485"]],["be to you",["G5213"]],["and",["G2532"]],["peace",["G1515"]],["from",["G575"]],["God",["G2316"]],["the Father,",["G3962"]],["and",["G2532"]],["from our",["G2257"]],["Lord",["G2962"]],["Jesus",["G2424"]],["Christ,",[]]]},{"verse":4,"text":"Who gave himself for our sins, that he might deliver us from this present evil world, according to the will of God and our Father:","words":[["Who",["G3588"]],["gave",["G1325"]],["himself",["G1438"]],["for",["G5228"]],["our",["G2257"]],["sins,",["G266"]],["that",["G3704"]],["he might deliver",["G1807"]],["us",["G2248"]],["from",["G1537"]],["this present",["G1764"]],["evil",["G4190"]],["world,",["G165"]],["according",["G2596"]],["to the will",["G2307"]],["of God",["G2316"]],["and",["G2532"]],["our",["G2257"]],["Father:",[]]]},{"verse":5,"text":"To whom be glory for ever and ever. Amen.","words":[["To whom",["G3739"]],["be glory",["G1391"]],["for",["G1519"]],["ever",["G165"]],["and ever.",["G165"]],["Amen.",[]]]},{"verse":6,"text":"I marvel that ye are so soon removed from him that called you into the grace of Christ unto another gospel:","words":[["I marvel",["G2296"]],["that",["G3754"]],["ye are",["G3346"]],["so",["G3779"]],["soon",["G5030"]],["removed",["G3346"]],["from",["G575"]],["him that called",["G2564"]],["you",["G5209"]],["into",["G1722"]],["the grace",["G5485"]],["of Christ",["G5547"]],["unto",["G1519"]],["another",["G2087"]],["gospel:",[]]]},{"verse":7,"text":"Which is not another; but there be some that trouble you, and would pervert the gospel of Christ.","words":[["Which",["G3739"]],["is",["G2076"]],["not",["G3756"]],["another;",["G243"]],["but there be",["G1526"]],["some",["G5100"]],["that",["G1508"]],["trouble",["G5015"]],["you,",["G5209"]],["and",["G2532"]],["would",["G2309"]],["pervert",["G3344"]],["the gospel",["G2098"]],["of Christ.",[]]]},{"verse":8,"text":"But though we, or an angel from heaven, preach any other gospel unto you than that which we have preached unto you, let him be accursed.","words":[["But",["G235"]],["though",["G2532","G1437"]],["we,",["G2249"]],["or",["G2228"]],["an angel",["G32"]],["from",["G1537"]],["heaven,",["G3772"]],["preach any other gospel",["G2097"]],["unto you",["G5213"]],["than",["G3844"]],["that which",["G3739"]],["we have preached",["G2097"]],["unto you,",["G5213"]],["let him be",["G2077"]],["accursed.",[]]]},{"verse":9,"text":"As we said before, so say I now again, If any man preach any other gospel unto you than that ye have received, let him be accursed.","words":[["As",["G5613"]],["we said before,",["G4280"]],["so",["G2532"]],["say I",["G3004"]],["now",["G737"]],["again,",["G3825"]],["If any",["G1536"]],["man preach",["G2097"]],["any other",["G3844"]],["gospel",["G2097"]],["unto you",["G5209"]],["than",["G3844"]],["that",["G3739"]],["ye have received,",["G3880"]],["let him be",["G2077"]],["accursed.",[]]]},{"verse":10,"text":"For do I now persuade men, or God? or do I seek to please men? for if I yet pleased men, I should not be the servant of Christ.","words":[["For",["G1063"]],["do I",["G3982"]],["now",["G737"]],["persuade",["G3982"]],["men,",["G444"]],["or",["G2228"]],["God?",["G2316"]],["or",["G2228"]],["do I seek",["G2212"]],["to please",["G700"]],["men?",["G444"]],["for",["G1063"]],["if",["G1487"]],["I",["G700"]],["yet",["G2089"]],["pleased",["G700"]],["men,",["G444"]],["I should",["G302"]],["not",["G3756"]],["be",["G2252"]],["the servant",["G1401"]],["of Christ.",[]]]},{"verse":11,"text":"But I certify you, brethren, that the gospel which was preached of me is not after man.","words":[["But",["G1161"]],["I certify",["G1107"]],["you,",["G5213"]],["brethren,",["G80"]],["that",["G3754"]],["the gospel",["G2098"]],["which",["G3588"]],["was preached",["G2097"]],["of",["G5259"]],["me",["G1700"]],["is",["G2076"]],["not",["G3756"]],["after",["G2596"]],["man.",[]]]},{"verse":12,"text":"For I neither received it of man, neither was I taught it, but by the revelation of Jesus Christ.","words":[["For",["G1063"]],["I",["G1473"]],["neither",["G3761"]],["received",["G3880"]],["it",["G846"]],["of",["G3844"]],["man,",["G444"]],["neither",["G3777"]],["was I taught",["G1321"]],["it, but",["G235"]],["by",["G1223"]],["the revelation",["G602"]],["of Jesus",["G2424"]],["Christ.",[]]]},{"verse":13,"text":"For ye have heard of my conversation in time past in the Jews’ religion, how that beyond measure I persecuted the church of God, and wasted it:","words":[["For",["G1063"]],["ye have heard",["G191"]],["of my",["G1699"]],["conversation",["G391"]],["in time past",["G4218"]],["in",["G1722"]],["the Jews’ religion,",["G2454"]],["how that",["G3754"]],["beyond",["G2596"]],["measure",["G5236"]],["I persecuted",["G1377"]],["the church",["G1577"]],["of God,",["G2316"]],["and",["G2532"]],["wasted",["G4199"]],["it:",[]]]},{"verse":14,"text":"And profited in the Jews’ religion above many my equals in mine own nation, being more exceedingly zealous of the traditions of my fathers.","words":[["And",["G2532"]],["profited",["G4298"]],["in",["G1722"]],["the Jews’ religion",["G2454"]],["above",["G5228"]],["many",["G4183"]],["my equals",["G4915"]],["in",["G1722"]],["mine own",["G3450"]],["nation,",["G1085"]],["being",["G5225"]],["more exceedingly",["G4056"]],["zealous",["G2207"]],["of the traditions",["G3862"]],["of my",["G3450"]],["fathers.",[]]]},{"verse":15,"text":"But when it pleased God, who separated me from my mother’s womb, and called me by his grace,","words":[["But",["G1161"]],["when",["G3753"]],["it pleased",["G2106"]],["God,",["G2316"]],["who",["G3588"]],["separated",["G873"]],["me",["G3165"]],["from",["G1537"]],["my",["G3450"]],["mother’s womb,",["G2836"]],["and",["G2532"]],["called",["G2564"]],["me by",["G1223"]],["his",["G846"]],["grace,",[]]]},{"verse":16,"text":"To reveal his Son in me, that I might preach him among the heathen; immediately I conferred not with flesh and blood:","words":[["To reveal",["G601"]],["his",["G846"]],["Son",["G5207"]],["in",["G1722"]],["me,",["G1698"]],["that",["G2443"]],["I might preach",["G2097"]],["him",["G846"]],["among",["G1722"]],["the heathen;",["G1484"]],["immediately",["G2112"]],["I conferred",["G4323"]],["not",["G3756"]],["with flesh",["G4561"]],["and",["G2532"]],["blood:",[]]]},{"verse":17,"text":"Neither went I up to Jerusalem to them which were apostles before me; but I went into Arabia, and returned again unto Damascus.","words":[["Neither",["G3761"]],["went I up",["G424"]],["to",["G1519"]],["Jerusalem",["G2414"]],["to",["G4314"]],["them which were apostles",["G652"]],["before",["G4253"]],["me;",["G1700"]],["but",["G235"]],["I went",["G565"]],["into",["G1519"]],["Arabia,",["G688"]],["and",["G2532"]],["returned",["G5290"]],["again",["G3825"]],["unto",["G1519"]],["Damascus.",[]]]},{"verse":18,"text":"Then after three years I went up to Jerusalem to see Peter, and abode with him fifteen days.","words":[["Then",["G1899"]],["after",["G3326"]],["three",["G5140"]],["years",["G2094"]],["I went up",["G424"]],["to",["G1519"]],["Jerusalem",["G2414"]],["to see",["G2477"]],["Peter,",["G4074"]],["and",["G2532"]],["abode",["G1961"]],["with",["G4314"]],["him",["G846"]],["fifteen",["G1178"]],["days.",[]]]},{"verse":19,"text":"But other of the apostles saw I none, save James the Lord’s brother.","words":[["But",["G1161"]],["other",["G2087"]],["of the apostles",["G652"]],["saw I",["G1492"]],["none,",["G3756"]],["save",["G1508"]],["James",["G2385"]],["the Lord’s brother.",[]]]},{"verse":20,"text":"Now the things which I write unto you, behold, before God, I lie not.","words":[["Now",["G1161"]],["the things which",["G3739"]],["I write",["G1125"]],["unto you,",["G5213"]],["behold,",["G2400"]],["before",["G1799"]],["God,",["G2316","G3754"]],["I lie",["G5574"]],["not.",[]]]},{"verse":21,"text":"Afterwards I came into the regions of Syria and Cilicia;","words":[["Afterwards",["G1899"]],["I came",["G2064"]],["into",["G1519"]],["the regions",["G2824"]],["of Syria",["G4947"]],["and",["G2532"]],["Cilicia;",[]]]},{"verse":22,"text":"And was unknown by face unto the churches of Judea which were in Christ:","words":[["And",["G1161"]],["was",["G2252"]],["unknown",["G50"]],["by face",["G4383"]],["unto the churches",["G1577"]],["of Judea",["G2449"]],["which",["G3588"]],["were in",["G1722"]],["Christ:",[]]]},{"verse":23,"text":"But they had heard only, That he which persecuted us in times past now preacheth the faith which once he destroyed.","words":[["But",["G1161"]],["they had",["G2258"]],["heard",["G191"]],["only,",["G3440"]],["That",["G3754"]],["he which persecuted",["G1377"]],["us",["G2248"]],["in times past",["G4218"]],["now",["G3568"]],["preacheth",["G2097"]],["the faith",["G4102"]],["which",["G3739"]],["once",["G4218"]],["he destroyed.",[]]]},{"verse":24,"text":"And they glorified God in me.","words":[["And",["G2532"]],["they glorified",["G1392"]],["God",["G2316"]],["in",["G1722"]],["me.",[]]]}]}