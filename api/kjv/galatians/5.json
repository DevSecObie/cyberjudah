{"book":"Galatians","chapter":5,"translation":"KJV","url":"/bible/galatians/5","verses":[{"verse":1,"text":"Stand fast therefore in the liberty wherewith Christ hath made us free, and be not entangled again with the yoke of bondage.","words":[["Stand fast",["G4739"]],["therefore",["G3767"]],["in the liberty",["G1657"]],["wherewith",["G3739"]],["Christ",["G5547"]],["hath made",["G1659"]],["us",["G2248"]],["free,",["G1659"]],["and",["G2532"]],["be",["G1758"]],["not",["G3361"]],["entangled",["G1758"]],["again",["G3825"]],["with the yoke",["G2218"]],["of bondage.",[]]]},{"verse":2,"text":"Behold, I Paul say unto you, that if ye be circumcised, Christ shall profit you nothing.","words":[["Behold,",["G2396"]],["I",["G1473"]],["Paul",["G3972"]],["say",["G3004"]],["unto you,",["G5213"]],["that",["G3754"]],["if",["G1437"]],["ye be circumcised,",["G4059"]],["Christ",["G5547"]],["shall profit",["G5623"]],["you",["G5209"]],["nothing.",[]]]},{"verse":3,"text":"For I testify again to every man that is circumcised, that he is a debtor to do the whole law.","words":[["For",["G1161"]],["I testify",["G3143"]],["again",["G3825"]],["to every",["G3956"]],["man",["G444"]],["that is circumcised,",["G4059"]],["that",["G3754"]],["he is",["G2076"]],["a debtor",["G3781"]],["to do",["G4160"]],["the whole",["G3650"]],["law.",[]]]},{"verse":4,"text":"Christ is become of no effect unto you, whosoever of you are justified by the law; ye are fallen from grace.","words":[["Christ",["G5547"]],["is become of no effect unto you,",["G575","G2673"]],["whosoever of you",["G3748"]],["are justified",["G1344"]],["by",["G1722"]],["the law;",["G3551"]],["ye are fallen from",["G1601"]],["grace.",[]]]},{"verse":5,"text":"For we through the Spirit wait for the hope of righteousness by faith.","words":[["For",["G1063"]],["we",["G2249"]],["through the Spirit",["G4151"]],["wait for",["G553"]],["the hope",["G1680"]],["of righteousness",["G1343"]],["by",["G1537"]],["faith.",[]]]},{"verse":6,"text":"For in Jesus Christ neither circumcision availeth any thing, nor uncircumcision; but faith which worketh by love.","words":[["For",["G1063"]],["in",["G1722"]],["Jesus",["G2424"]],["Christ",["G5547"]],["neither",["G3777"]],["circumcision",["G4061"]],["availeth",["G2480"]],["any thing,",["G5100"]],["nor",["G3777"]],["uncircumcision;",["G203"]],["but",["G235"]],["faith",["G4102"]],["which worketh",["G1754"]],["by",["G1223"]],["love.",[]]]},{"verse":7,"text":"Ye did run well; who did hinder you that ye should not obey the truth?","words":[["Ye did run",["G5143"]],["well;",["G2573"]],["who",["G5101"]],["did hinder",["G348","G1465"]],["you",["G5209"]],["that ye should",["G3982"]],["not",["G3361"]],["obey",["G3982"]],["the truth?",[]]]},{"verse":8,"text":"This persuasion cometh not of him that calleth you.","words":[["This persuasion",["G3988"]],["cometh not",["G3756"]],["of",["G1537"]],["him that calleth",["G2564"]],["you.",[]]]},{"verse":9,"text":"A little leaven leaveneth the whole lump.","words":[["A little",["G3398"]],["leaven",["G2219"]],["leaveneth",["G2220"]],["the whole",["G3650"]],["lump.",[]]]},{"verse":10,"text":"I have confidence in you through the Lord, that ye will be none otherwise minded: but he that troubleth you shall bear his judgment, whosoever he be.","words":[["I",["G1473"]],["have confidence",["G3982"]],["in",["G1519"]],["you",["G5209"]],["through",["G1722"]],["the Lord,",["G2962"]],["that",["G3754"]],["ye will be",["G5426"]],["none",["G3762"]],["otherwise",["G243"]],["minded:",["G5426"]],["but",["G1161"]],["he that troubleth",["G5015"]],["you",["G5209"]],["shall bear",["G941"]],["his judgment,",["G2917"]],["whosoever",["G3748"]],["he be.",["G302"]]]},{"verse":11,"text":"And I, brethren, if I yet preach circumcision, why do I yet suffer persecution? then is the offence of the cross ceased.","words":[["And",["G1161"]],["I,",["G1473"]],["brethren,",["G80"]],["if",["G1487"]],["I",["G2784"]],["yet",["G2089"]],["preach",["G2784"]],["circumcision,",["G4061"]],["why",["G5101"]],["do I",["G1377"]],["yet",["G2089"]],["suffer persecution?",["G1377"]],["then",["G686"]],["is",["G2673"]],["the offence",["G4625"]],["of the cross",["G4716"]],["ceased.",[]]]},{"verse":12,"text":"I would they were even cut off which trouble you.","words":[["I would",["G3785"]],["they were",["G609"]],["even",["G2532"]],["cut off",["G609"]],["which trouble",["G387"]],["you.",[]]]},{"verse":13,"text":"For, brethren, ye have been called unto liberty; only use not liberty for an occasion to the flesh, but by love serve one another.","words":[["For,",["G1063"]],["brethren,",["G80"]],["ye",["G5210"]],["have been called",["G2564"]],["unto",["G1909"]],["liberty;",["G1657"]],["only",["G3440"]],["use not",["G3361"]],["liberty",["G1657"]],["for",["G1519"]],["an occasion",["G874"]],["to the flesh,",["G4561"]],["but",["G235"]],["by",["G1223"]],["love",["G26"]],["serve",["G1398"]],["one another.",[]]]},{"verse":14,"text":"For all the law is fulfilled in one word, even in this; Thou shalt love thy neighbour as thyself.","words":[["For",["G1063"]],["all",["G3956"]],["the law",["G3551"]],["is fulfilled",["G4137"]],["in",["G1722"]],["one",["G1520"]],["word,",["G3056"]],["even in",["G1722"]],["this; Thou shalt love",["G25"]],["thy",["G4675"]],["neighbour",["G4139"]],["as",["G5613"]],["thyself.",[]]]},{"verse":15,"text":"But if ye bite and devour one another, take heed that ye be not consumed one of another.","words":[["But",["G1161"]],["if",["G1487"]],["ye bite",["G1143"]],["and",["G2532"]],["devour",["G2719"]],["one another,",["G240"]],["take heed",["G991"]],["that ye be",["G355"]],["not",["G3361"]],["consumed",["G355"]],["one",["G240"]],["of",["G5259"]],["another.",[]]]},{"verse":16,"text":"This I say then, Walk in the Spirit, and ye shall not fulfil the lust of the flesh.","words":[["This I say",["G3004"]],["then,",["G1161"]],["Walk",["G4043"]],["in the Spirit,",["G4151"]],["and",["G2532"]],["ye shall",["G5055"]],["not",["G3364"]],["fulfil",["G5055"]],["the lust",["G1939"]],["of the flesh.",[]]]},{"verse":17,"text":"For the flesh lusteth against the Spirit, and the Spirit against the flesh: and these are contrary the one to the other: so that ye cannot do the things that ye would.","words":[["For",["G1063"]],["the flesh",["G4561"]],["lusteth",["G1937"]],["against",["G2596"]],["the Spirit,",["G4151"]],["and",["G1161"]],["the Spirit",["G4151"]],["against",["G2596"]],["the flesh:",["G4561"]],["and",["G1161"]],["these",["G5023"]],["are contrary",["G480"]],["the one to the other:",["G240"]],["so that",["G2443"]],["ye cannot",["G3363"]],["do",["G4160"]],["the things",["G5023"]],["that",["G3739","G302"]],["ye would.",[]]]},{"verse":18,"text":"But if ye be led of the Spirit, ye are not under the law.","words":[["But",["G1161"]],["if",["G1487"]],["ye be led",["G71"]],["of the Spirit,",["G4151"]],["ye are",["G2075"]],["not",["G3756"]],["under",["G5259"]],["the law.",[]]]},{"verse":19,"text":"Now the works of the flesh are manifest, which are these; Adultery, fornication, uncleanness, lasciviousness,","words":[["Now",["G1161"]],["the works",["G2041"]],["of the flesh",["G4561"]],["are",["G2076"]],["manifest,",["G5318"]],["which",["G3748"]],["are",["G2076"]],["these; Adultery,",["G3430"]],["fornication,",["G4202"]],["uncleanness,",["G167"]],["lasciviousness,",[]]]},{"verse":20,"text":"Idolatry, witchcraft, hatred, variance, emulations, wrath, strife, seditions, heresies,","words":[["Idolatry,",["G1495"]],["witchcraft,",["G5331"]],["hatred,",["G2189"]],["variance,",["G2054"]],["emulations,",["G2205"]],["wrath,",["G2372"]],["strife,",["G2052"]],["seditions,",["G1370"]],["heresies,",[]]]},{"verse":21,"text":"Envyings, murders, drunkenness, revellings, and such like: of the which I tell you before, as I have also told you in time past, that they which do such things shall not inherit the kingdom of God.","words":[["Envyings,",["G5355"]],["murders,",["G5408"]],["drunkenness,",["G3178"]],["revellings,",["G2970"]],["and",["G2532"]],["such",["G5125"]],["like:",["G3664"]],["of the which",["G3739"]],["I tell",["G4302"]],["you",["G5213"]],["before,",["G4302"]],["as",["G2531"]],["I have",["G4277"]],["also",["G2532"]],["told you in time past,",["G4277"]],["that",["G3754"]],["they which do",["G4238"]],["such things",["G5108"]],["shall",["G2816"]],["not",["G3756"]],["inherit",["G2816"]],["the kingdom",["G932"]],["of God.",[]]]},{"verse":22,"text":"But the fruit of the Spirit is love, joy, peace, longsuffering, gentleness, goodness, faith,","words":[["But",["G1161"]],["the fruit",["G2590"]],["of the Spirit",["G4151"]],["is",["G2076"]],["love,",["G26"]],["joy,",["G5479"]],["peace,",["G1515"]],["longsuffering,",["G3115"]],["gentleness,",["G5544"]],["goodness,",["G19"]],["faith,",[]]]},{"verse":23,"text":"Meekness, temperance: against such there is no law.","words":[["Meekness,",["G4236"]],["temperance:",["G1466"]],["against",["G2596"]],["such",["G5108"]],["there is",["G2076"]],["no",["G3756"]],["law.",[]]]},{"verse":24,"text":"And they that are Christ’s have crucified the flesh with the affections and lusts.","words":[["And",["G1161"]],["they that are",["G3588"]],["Christ’s have crucified",["G4717"]],["the flesh",["G4561"]],["with",["G4862"]],["the affections",["G3804"]],["and",["G2532"]],["lusts.",[]]]},{"verse":25,"text":"If we live in the Spirit, let us also walk in the Spirit.","words":[["If",["G1487"]],["we live",["G2198"]],["in the Spirit,",["G4151"]],["let us",["G4748"]],["also",["G2532"]],["walk",["G4748"]],["in the Spirit.",[]]]},{"verse":26,"text":"Let us not be desirous of vain glory, provoking one another, envying one another.","words":[["Let us",["G1096"]],["not",["G3361"]],["be",["G1096"]],["desirous of vain glory,",["G2755"]],["provoking",["G4292"]],["one another,",["G240"]],["envying",["G5354"]],["one another.",[]]]}]}