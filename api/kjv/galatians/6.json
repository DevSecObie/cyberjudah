{"book":"Galatians","chapter":6,"translation":"KJV","url":"/bible/galatians/6","verses":[{"verse":1,"text":"Brethren, if a man be overtaken in a fault, ye which are spiritual, restore such an one in the spirit of meekness; considering thyself, lest thou also be tempted.","words":[["Brethren,",["G80"]],["if",["G1437","G2532"]],["a man",["G444"]],["be overtaken",["G4301"]],["in",["G1722"]],["a",["G5100"]],["fault,",["G3900"]],["ye",["G5210"]],["which",["G3588"]],["are spiritual,",["G4152"]],["restore",["G2675"]],["such an one",["G5108"]],["in",["G1722"]],["the spirit",["G4151"]],["of meekness;",["G4236"]],["considering",["G4648"]],["thyself,",["G4572"]],["lest",["G3361"]],["thou",["G4771"]],["also",["G2532"]],["be tempted.",[]]]},{"verse":2,"text":"Bear ye one another’s burdens, and so fulfil the law of Christ.","words":[["Bear ye",["G941"]],["one another’s burdens,",["G922"]],["and",["G2532"]],["so",["G3779"]],["fulfil",["G378"]],["the law",["G3551"]],["of Christ.",[]]]},{"verse":3,"text":"For if a man think himself to be something, when he is nothing, he deceiveth himself.","words":[["For",["G1063"]],["if a man",["G1536"]],["think himself",["G1380"]],["to be",["G1511"]],["something,",["G5100"]],["when he is",["G5607"]],["nothing,",["G3367"]],["he deceiveth",["G5422"]],["himself.",[]]]},{"verse":4,"text":"But let every man prove his own work, and then shall he have rejoicing in himself alone, and not in another.","words":[["But",["G1161"]],["let",["G1381"]],["every man",["G1538"]],["prove",["G1381"]],["his own",["G1438"]],["work,",["G2041"]],["and",["G2532"]],["then",["G5119"]],["shall he have",["G2192"]],["rejoicing",["G2745"]],["in",["G1519"]],["himself",["G1438"]],["alone,",["G3441"]],["and",["G2532"]],["not",["G3756"]],["in",["G1519"]],["another.",[]]]},{"verse":5,"text":"For every man shall bear his own burden.","words":[["For",["G1063"]],["every man",["G1538"]],["shall bear",["G941"]],["his own",["G2398"]],["burden.",[]]]},{"verse":6,"text":"Let him that is taught in the word communicate unto him that teacheth in all good things.","words":[["Let",["G1161"]],["him that is taught",["G2727"]],["in the word",["G3056"]],["communicate",["G2841"]],["unto him that teacheth",["G2727"]],["in",["G1722"]],["all",["G3956"]],["good things.",[]]]},{"verse":7,"text":"Be not deceived; God is not mocked: for whatsoever a man soweth, that shall he also reap.","words":[["Be",["G4105"]],["not",["G3361"]],["deceived;",["G4105"]],["God",["G2316"]],["is",["G3456"]],["not",["G3756"]],["mocked:",["G3456"]],["for",["G1063"]],["whatsoever",["G3739","G1437"]],["a man",["G444"]],["soweth,",["G4687"]],["that",["G5124"]],["shall he",["G2325"]],["also",["G2532"]],["reap.",[]]]},{"verse":8,"text":"For he that soweth to his flesh shall of the flesh reap corruption; but he that soweth to the Spirit shall of the Spirit reap life everlasting.","words":[["For",["G3754"]],["he that soweth",["G4687"]],["to",["G1519"]],["his",["G1438"]],["flesh",["G4561"]],["shall",["G2325"]],["of",["G1537"]],["the flesh",["G4561"]],["reap",["G2325"]],["corruption;",["G5356"]],["but",["G1161"]],["he that soweth",["G4687"]],["to",["G1519"]],["the Spirit",["G4151"]],["shall",["G2325"]],["of",["G1537"]],["the Spirit",["G4151"]],["reap",["G2325"]],["life",["G2222"]],["everlasting.",[]]]},{"verse":9,"text":"And let us not be weary in well doing: for in due season we shall reap, if we faint not.","words":[["And",["G1161"]],["let us",["G1573"]],["not",["G3361"]],["be weary",["G1573"]],["in well",["G2570"]],["doing:",["G4160"]],["for",["G1063"]],["in due",["G2398"]],["season",["G2540"]],["we shall reap,",["G2325"]],["if we faint",["G1590"]],["not.",[]]]},{"verse":10,"text":"As we have therefore opportunity, let us do good unto all men, especially unto them who are of the household of faith.","words":[["As",["G5613"]],["we have",["G2192"]],["therefore",["G686","G3767"]],["opportunity,",["G2540"]],["let us do",["G2038"]],["good",["G18"]],["unto",["G4314"]],["all",["G3956"]],["men, especially",["G1161","G3122"]],["unto",["G4314"]],["them who are of the household",["G3609"]],["of faith.",[]]]},{"verse":11,"text":"Ye see how large a letter I have written unto you with mine own hand.","words":[["Ye see",["G1492"]],["how large",["G4080"]],["a letter",["G1121"]],["I have written",["G1125"]],["unto you",["G5213"]],["with mine own",["G1699"]],["hand.",[]]]},{"verse":12,"text":"As many as desire to make a fair shew in the flesh, they constrain you to be circumcised; only lest they should suffer persecution for the cross of Christ.","words":[["As many as",["G3745"]],["desire",["G2309"]],["to make a fair shew",["G2146"]],["in",["G1722"]],["the flesh,",["G4561"]],["they",["G3778"]],["constrain",["G315"]],["you",["G5209"]],["to be circumcised;",["G4059"]],["only",["G3440"]],["lest",["G3363"]],["they should suffer persecution",["G1377"]],["for the cross",["G4716"]],["of Christ.",[]]]},{"verse":13,"text":"For neither they themselves who are circumcised keep the law; but desire to have you circumcised, that they may glory in your flesh.","words":[["For",["G1063"]],["neither",["G3761"]],["they themselves",["G846"]],["who are circumcised",["G4059"]],["keep",["G5442"]],["the law;",["G3551"]],["but",["G235"]],["desire",["G2309"]],["to have",["G4059"]],["you",["G5209"]],["circumcised,",["G4059"]],["that",["G2443"]],["they may glory",["G2744"]],["in",["G1722"]],["your",["G5212"]],["flesh.",[]]]},{"verse":14,"text":"But God forbid that I should glory, save in the cross of our Lord Jesus Christ, by whom the world is crucified unto me, and I unto the world.","words":[["But",["G1161"]],["God forbid",["G3361","G1096"]],["that I",["G1698"]],["should glory,",["G2744"]],["save",["G1508"]],["in",["G1722"]],["the cross",["G4716"]],["of our",["G2257"]],["Lord",["G2962"]],["Jesus",["G2424"]],["Christ,",["G5547"]],["by",["G1223"]],["whom",["G3739"]],["the world",["G2889"]],["is crucified",["G4717"]],["unto me,",["G1698"]],["and I",["G2504"]],["unto the world.",[]]]},{"verse":15,"text":"For in Christ Jesus neither circumcision availeth any thing, nor uncircumcision, but a new creature.","words":[["For",["G1063"]],["in",["G1722"]],["Christ",["G5547"]],["Jesus",["G2424"]],["neither",["G3777"]],["circumcision",["G4061"]],["availeth",["G2480"]],["any thing,",["G5100"]],["nor",["G3777"]],["uncircumcision,",["G203"]],["but",["G235"]],["a new",["G2537"]],["creature.",[]]]},{"verse":16,"text":"And as many as walk according to this rule, peace be on them, and mercy, and upon the Israel of God.","words":[["And",["G2532"]],["as many as",["G3745"]],["walk",["G4748"]],["according to",["G2583"]],["this",["G5129"]],["rule,",["G2583"]],["peace",["G1515"]],["be on",["G1909"]],["them,",["G846"]],["and",["G2532"]],["mercy,",["G1656"]],["and",["G2532"]],["upon",["G1909"]],["the Israel",["G2474"]],["of God.",[]]]},{"verse":17,"text":"From henceforth let no man trouble me: for I bear in my body the marks of the Lord Jesus.","words":[["From henceforth",["G3064"]],["let",["G3930"]],["no man",["G3367"]],["trouble",["G3930"]],["me:",["G2873","G3427"]],["for",["G1063"]],["I",["G1473"]],["bear",["G941"]],["in",["G1722"]],["my",["G3450"]],["body",["G4983"]],["the marks",["G4742"]],["of the Lord",["G2962"]],["Jesus.",[]]]},{"verse":18,"text":"Brethren, the grace of our Lord Jesus Christ be with your spirit. Amen. Unto the Galatians written from Rome.","words":[["Brethren,",["G80"]],["the grace",["G5485"]],["of our",["G2257"]],["Lord",["G2962"]],["Jesus",["G2424"]],["Christ",["G5547"]],["be with",["G3326"]],["your",["G5216"]],["spirit.",["G4151"]],["Amen. Unto the Galatians written from Rome.",[]]]}]}