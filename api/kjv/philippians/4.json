{"book":"Philippians","chapter":4,"translation":"KJV","url":"/bible/philippians/4","verses":[{"verse":1,"text":"Therefore, my brethren dearly beloved and longed for, my joy and crown, so stand fast in the Lord, my dearly beloved.","words":[["Therefore,",["G5620"]],["my",["G3450"]],["brethren",["G80"]],["dearly beloved",["G27"]],["and",["G2532"]],["longed for,",["G1973"]],["my",["G3450"]],["joy",["G5479"]],["and",["G2532"]],["crown,",["G4735"]],["so",["G3779"]],["stand fast",["G4739"]],["in",["G1722"]],["the Lord,",["G2962"]],["my dearly beloved.",[]]]},{"verse":2,"text":"I beseech Euodias, and beseech Syntyche, that they be of the same mind in the Lord.","words":[["I beseech",["G3870"]],["Euodias,",["G2136"]],["and",["G2532"]],["beseech",["G3870"]],["Syntyche,",["G4941"]],["that they be of",["G5426"]],["the same",["G846"]],["mind",["G5426"]],["in",["G1722"]],["the Lord.",[]]]},{"verse":3,"text":"And I intreat thee also, true yokefellow, help those women which laboured with me in the gospel, with Clement also, and with other my fellowlabourers, whose names are in the book of life.","words":[["And",["G2532"]],["I intreat",["G2065"]],["thee",["G4571"]],["also,",["G2532"]],["true",["G1103"]],["yokefellow,",["G4805"]],["help",["G4815"]],["those women",["G846"]],["which",["G3748"]],["laboured",["G4866"]],["with me",["G3427"]],["in",["G1722"]],["the gospel,",["G2098"]],["with",["G3326"]],["Clement",["G2815"]],["also,",["G2532"]],["and",["G2532"]],["with other",["G3062"]],["my",["G3450"]],["fellowlabourers,",["G4904"]],["whose",["G3739"]],["names",["G3686"]],["are in",["G1722"]],["the book",["G976"]],["of life.",[]]]},{"verse":4,"text":"Rejoice in the Lord alway: and again I say, Rejoice.","words":[["Rejoice",["G5463"]],["in",["G1722"]],["the Lord",["G2962"]],["alway:",["G3842"]],["and again",["G3825"]],["I say,",["G2046"]],["Rejoice.",[]]]},{"verse":5,"text":"Let your moderation be known unto all men. The Lord is at hand.","words":[["Let",["G1097"]],["your",["G5216"]],["moderation",["G1933"]],["be known",["G1097"]],["unto all",["G3956"]],["men.",["G444"]],["The Lord",["G2962"]],["is at hand.",[]]]},{"verse":6,"text":"Be careful for nothing; but in every thing by prayer and supplication with thanksgiving let your requests be made known unto God.","words":[["Be careful",["G3309"]],["for nothing;",["G3367"]],["but",["G235"]],["in",["G1722"]],["every thing",["G3956"]],["by prayer",["G4335"]],["and",["G2532"]],["supplication",["G1162"]],["with",["G3326"]],["thanksgiving",["G2169"]],["let",["G1107"]],["your",["G5216"]],["requests",["G155"]],["be made known",["G1107"]],["unto",["G4314"]],["God.",[]]]},{"verse":7,"text":"And the peace of God, which passeth all understanding, shall keep your hearts and minds through Christ Jesus.","words":[["And",["G2532"]],["the peace",["G1515"]],["of God,",["G2316"]],["which",["G3588"]],["passeth",["G5242"]],["all",["G3956"]],["understanding,",["G3563"]],["shall keep",["G5432"]],["your",["G5216"]],["hearts",["G2588"]],["and",["G2532"]],["minds",["G5216","G3540"]],["through",["G1722"]],["Christ",["G5547"]],["Jesus.",[]]]},{"verse":8,"text":"Finally, brethren, whatsoever things are true, whatsoever things are honest, whatsoever things are just, whatsoever things are pure, whatsoever things are lovely, whatsoever things are of good report; if there be any virtue, and if there be any praise, think on these things.","words":[["Finally,",["G3063"]],["brethren,",["G80"]],["whatsoever things",["G3745"]],["are",["G2076"]],["true,",["G227"]],["whatsoever things",["G3745"]],["are honest,",["G4586"]],["whatsoever things",["G3745"]],["are just,",["G1342"]],["whatsoever things",["G3745"]],["are pure,",["G53"]],["whatsoever things",["G3745"]],["are lovely,",["G4375"]],["whatsoever things",["G3745"]],["are of good report;",["G2163"]],["if there be any",["G1536"]],["virtue,",["G703"]],["and",["G2532"]],["if there be any",["G1536"]],["praise,",["G1868"]],["think",["G3049"]],["on these things.",[]]]},{"verse":9,"text":"Those things, which ye have both learned, and received, and heard, and seen in me, do: and the God of peace shall be with you.","words":[["Those things,",["G5023"]],["which",["G3739"]],["ye have",["G3129"]],["both",["G2532"]],["learned,",["G3129"]],["and",["G2532"]],["received,",["G3880"]],["and",["G2532"]],["heard,",["G191"]],["and",["G2532"]],["seen",["G1492"]],["in",["G1722"]],["me,",["G1698"]],["do:",["G4238"]],["and",["G2532"]],["the God",["G2316"]],["of peace",["G1515"]],["shall be",["G2071"]],["with",["G3326"]],["you.",[]]]},{"verse":10,"text":"But I rejoiced in the Lord greatly, that now at the last your care of me hath flourished again; wherein ye were also careful, but ye lacked opportunity.","words":[["But",["G1161"]],["I rejoiced",["G5463"]],["in",["G1722"]],["the Lord",["G2962"]],["greatly,",["G3171"]],["that",["G3754"]],["now",["G2235"]],["at the last",["G4218"]],["your care",["G5426"]],["of",["G5228"]],["me",["G1700"]],["hath flourished again;",["G330"]],["wherein",["G1909","G3739"]],["ye were",["G5426"]],["also",["G2532"]],["careful,",["G5426"]],["but",["G1161"]],["ye lacked opportunity.",[]]]},{"verse":11,"text":"Not that I speak in respect of want: for I have learned, in whatsoever state I am, therewith to be content.","words":[["Not",["G3756"]],["that I speak",["G3004"]],["in respect",["G3754","G2596"]],["of want:",["G5304"]],["for",["G1063"]],["I",["G1473"]],["have learned,",["G3129"]],["in",["G1722"]],["whatsoever state",["G3739"]],["I am,",["G1510"]],["therewith to be",["G1511"]],["content.",[]]]},{"verse":12,"text":"I know both how to be abased, and I know how to abound: every where and in all things I am instructed both to be full and to be hungry, both to abound and to suffer need.","words":[["I know",["G1492"]],["both how to be abased,",["G5013"]],["and",["G2532"]],["I know",["G1492"]],["how to abound:",["G4052"]],["every where",["G1722","G3956"]],["and",["G2532"]],["in",["G1722"]],["all things",["G3956"]],["I am instructed",["G3453"]],["both",["G2532"]],["to be full",["G5526"]],["and",["G2532"]],["to be hungry,",["G3983"]],["both",["G2532"]],["to abound",["G4052"]],["and",["G2532"]],["to suffer need.",[]]]},{"verse":13,"text":"I can do all things through Christ which strengtheneth me.","words":[["I can do",["G2480"]],["all things",["G3956"]],["through",["G1722"]],["Christ",["G5547"]],["which",["G3588"]],["strengtheneth",["G1743"]],["me.",[]]]},{"verse":14,"text":"Notwithstanding ye have well done, that ye did communicate with my affliction.","words":[["Notwithstanding",["G4133"]],["ye have well",["G2573"]],["done,",["G4160"]],["that ye did communicate with",["G4790"]],["my",["G3450"]],["affliction.",[]]]},{"verse":15,"text":"Now ye Philippians know also, that in the beginning of the gospel, when I departed from Macedonia, no church communicated with me as concerning giving and receiving, but ye only.","words":[["Now",["G1161"]],["ye",["G5210"]],["Philippians",["G5374"]],["know",["G1492"]],["also,",["G2532"]],["that",["G3754"]],["in",["G1722"]],["the beginning",["G746"]],["of the gospel,",["G2098"]],["when",["G3753"]],["I departed",["G1831"]],["from",["G575"]],["Macedonia,",["G3109"]],["no",["G3762"]],["church",["G1577"]],["communicated with",["G2841"]],["me",["G3427"]],["as",["G1519"]],["concerning",["G3056"]],["giving",["G1394"]],["and",["G2532"]],["receiving,",["G3028"]],["but",["G1508"]],["ye",["G5210"]],["only.",[]]]},{"verse":16,"text":"For even in Thessalonica ye sent once and again unto my necessity.","words":[["For",["G3754"]],["even",["G2532"]],["in",["G1722"]],["Thessalonica",["G2332"]],["ye sent",["G3992"]],["once",["G2532","G530"]],["and",["G2532"]],["again",["G1364"]],["unto",["G1519"]],["my",["G3427"]],["necessity.",[]]]},{"verse":17,"text":"Not because I desire a gift: but I desire fruit that may abound to your account.","words":[["Not",["G3756"]],["because",["G3754"]],["I desire",["G1934"]],["a gift:",["G1390"]],["but",["G235"]],["I desire",["G1934"]],["fruit",["G2590"]],["that may abound",["G4121"]],["to",["G1519"]],["your",["G5216"]],["account.",[]]]},{"verse":18,"text":"But I have all, and abound: I am full, having received of Epaphroditus the things which were sent from you, an odour of a sweet smell, a sacrifice acceptable, wellpleasing to God.","words":[["But",["G1161"]],["I have",["G568"]],["all,",["G3956"]],["and",["G2532"]],["abound:",["G4052"]],["I am full,",["G4137"]],["having received",["G1209"]],["of",["G3844"]],["Epaphroditus",["G1891"]],["the things which were sent from",["G3844"]],["you,",["G5216"]],["an odour",["G3744"]],["of a sweet smell,",["G2175"]],["a sacrifice",["G2378"]],["acceptable,",["G1184"]],["wellpleasing",["G2101"]],["to God.",[]]]},{"verse":19,"text":"But my God shall supply all your need according to his riches in glory by Christ Jesus.","words":[["But",["G1161"]],["my",["G3450"]],["God",["G2316"]],["shall supply",["G4137"]],["all",["G3956"]],["your",["G5216"]],["need",["G5532"]],["according to",["G2596"]],["his",["G846"]],["riches",["G4149"]],["in",["G1722"]],["glory",["G1391"]],["by",["G1722"]],["Christ",["G5547"]],["Jesus.",[]]]},{"verse":20,"text":"Now unto God and our Father be glory for ever and ever. Amen.","words":[["Now",["G1161"]],["unto God",["G2316"]],["and",["G2532"]],["our",["G2257"]],["Father",["G3962"]],["be glory",["G1391"]],["for",["G1519"]],["ever",["G165"]],["and ever.",["G165"]],["Amen.",[]]]},{"verse":21,"text":"Salute every saint in Christ Jesus. The brethren which are with me greet you.","words":[["Salute",["G782"]],["every",["G3956"]],["saint",["G40"]],["in",["G1722"]],["Christ",["G5547"]],["Jesus.",["G2424"]],["The brethren",["G80"]],["which are with",["G4862"]],["me",["G1698"]],["greet",["G782"]],["you.",[]]]},{"verse":22,"text":"All the saints salute you, chiefly they that are of Cesar’s household.","words":[["All",["G3956"]],["the saints",["G40"]],["salute",["G782"]],["you,",["G5209","G1161"]],["chiefly",["G3122"]],["they that are of",["G1537"]],["Cesar’s household.",[]]]},{"verse":23,"text":"The grace of our Lord Jesus Christ be with you all. Amen. It was written to the Philippians from Rome by Epaphroditus.","words":[["The grace",["G5485"]],["of our",["G2257"]],["Lord",["G2962"]],["Jesus",["G2424"]],["Christ",["G5547"]],["be with",["G3326"]],["you",["G5216"]],["all.",["G3956"]],["Amen. It was written to the Philippians from Rome by Epaphroditus.",[]]]}]}