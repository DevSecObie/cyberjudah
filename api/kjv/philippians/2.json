{"book":"Philippians","chapter":2,"translation":"KJV","url":"/bible/philippians/2","verses":[{"verse":1,"text":"If there be therefore any consolation in Christ, if any comfort of love, if any fellowship of the Spirit, if any bowels and mercies,","words":[["If there be therefore",["G3767"]],["any",["G1536"]],["consolation",["G3874"]],["in",["G1722"]],["Christ,",["G5547"]],["if any",["G1536"]],["comfort",["G3890"]],["of love,",["G26"]],["if any",["G1536"]],["fellowship",["G2842"]],["of the Spirit,",["G4151"]],["if any",["G1536"]],["bowels",["G4698"]],["and",["G2532"]],["mercies,",[]]]},{"verse":2,"text":"Fulfil ye my joy, that ye be likeminded, having the same love, being of one accord, of one mind.","words":[["Fulfil ye",["G4137"]],["my",["G3450"]],["joy,",["G5479"]],["that",["G2443"]],["ye be likeminded,",["G846","G5426"]],["having",["G2192"]],["the same",["G846"]],["love,",["G26"]],["being of one accord,",["G4861"]],["of one",["G1520"]],["mind.",[]]]},{"verse":3,"text":"Let nothing be done through strife or vainglory; but in lowliness of mind let each esteem other better than themselves.","words":[["Let nothing",["G3367"]],["be done through",["G2596"]],["strife",["G2052"]],["or",["G2228"]],["vainglory;",["G2754"]],["but",["G235"]],["in lowliness of mind",["G5012"]],["let",["G2233"]],["each",["G240"]],["esteem",["G2233"]],["other",["G240"]],["better than",["G5242"]],["themselves.",[]]]},{"verse":4,"text":"Look not every man on his own things, but every man also on the things of others.","words":[["Look",["G4648"]],["not",["G3361"]],["every man",["G1538"]],["on his own things,",["G1438"]],["but",["G235"]],["every man",["G1538"]],["also",["G2532"]],["on the things",["G3588"]],["of others.",[]]]},{"verse":5,"text":"Let this mind be in you, which was also in Christ Jesus:","words":[["Let",["G5426"]],["this",["G5124"]],["mind be",["G5426"]],["in",["G1722"]],["you,",["G5213"]],["which",["G3739"]],["was also",["G2532"]],["in",["G1722"]],["Christ",["G5547"]],["Jesus:",[]]]},{"verse":6,"text":"Who, being in the form of God, thought it not robbery to be equal with God:","words":[["Who,",["G3739"]],["being",["G5225"]],["in",["G1722"]],["the form",["G3444"]],["of God,",["G2316"]],["thought it",["G2233"]],["not",["G3756"]],["robbery",["G725"]],["to be",["G1511"]],["equal",["G2470"]],["with God:",[]]]},{"verse":7,"text":"But made himself of no reputation, and took upon him the form of a servant, and was made in the likeness of men:","words":[["But",["G235"]],["made",["G2758"]],["himself",["G1438"]],["of no reputation,",["G2758"]],["and took upon him",["G2983"]],["the form",["G3444"]],["of a servant,",["G1401"]],["and was made",["G1096"]],["in",["G1722"]],["the likeness",["G3667"]],["of men:",[]]]},{"verse":8,"text":"And being found in fashion as a man, he humbled himself, and became obedient unto death, even the death of the cross.","words":[["And",["G2532"]],["being found",["G2147"]],["in fashion",["G4976"]],["as",["G5613"]],["a man,",["G444"]],["he humbled",["G5013"]],["himself,",["G1438"]],["and became",["G1096"]],["obedient",["G5255"]],["unto",["G3360"]],["death,",["G2288"]],["even",["G1161"]],["the death",["G2288"]],["of the cross.",[]]]},{"verse":9,"text":"Wherefore God also hath highly exalted him, and given him a name which is above every name:","words":[["Wherefore",["G1352"]],["God",["G2316"]],["also",["G2532"]],["hath highly exalted",["G5251"]],["him,",["G846"]],["and",["G2532"]],["given",["G5483"]],["him",["G846"]],["a name",["G3686"]],["which",["G3588"]],["is above",["G5228"]],["every",["G3956"]],["name:",[]]]},{"verse":10,"text":"That at the name of Jesus every knee should bow, of things in heaven, and things in earth, and things under the earth;","words":[["That",["G2443"]],["at",["G1722"]],["the name",["G3686"]],["of Jesus",["G2424"]],["every",["G3956"]],["knee",["G1119"]],["should bow,",["G2578"]],["of things in heaven,",["G2032"]],["and",["G2532"]],["things in earth,",["G1919"]],["and",["G2532"]],["things under the earth;",[]]]},{"verse":11,"text":"And that every tongue should confess that Jesus Christ is Lord, to the glory of God the Father.","words":[["And",["G2532"]],["that every",["G3956"]],["tongue",["G1100"]],["should confess",["G1843"]],["that",["G3754"]],["Jesus",["G2424"]],["Christ",["G5547"]],["is Lord,",["G2962"]],["to",["G1519"]],["the glory",["G1391"]],["of God",["G2316"]],["the Father.",[]]]},{"verse":12,"text":"Wherefore, my beloved, as ye have always obeyed, not as in my presence only, but now much more in my absence, work out your own salvation with fear and trembling.","words":[["Wherefore,",["G5620"]],["my",["G3450"]],["beloved,",["G27"]],["as",["G2531"]],["ye have",["G5219"]],["always",["G3842"]],["obeyed,",["G5219"]],["not",["G3361"]],["as",["G5613"]],["in",["G1722"]],["my",["G3450"]],["presence",["G3952"]],["only,",["G3440"]],["but",["G235"]],["now",["G3568"]],["much",["G4183"]],["more",["G3123"]],["in",["G1722"]],["my",["G3450"]],["absence,",["G666"]],["work out",["G2716"]],["your own",["G1438"]],["salvation",["G4991"]],["with",["G3326"]],["fear",["G5401"]],["and",["G2532"]],["trembling.",[]]]},{"verse":13,"text":"For it is God which worketh in you both to will and to do of his good pleasure.","words":[["For",["G1063"]],["it is",["G2076"]],["God",["G2316"]],["which",["G3588"]],["worketh",["G1754"]],["in",["G1722"]],["you",["G5213"]],["both",["G2532"]],["to will",["G2309"]],["and",["G2532"]],["to do",["G1754"]],["of",["G5228"]],["his good pleasure.",[]]]},{"verse":14,"text":"Do all things without murmurings and disputings:","words":[["Do",["G4160"]],["all things",["G3956"]],["without",["G5565"]],["murmurings",["G1112"]],["and",["G2532"]],["disputings:",[]]]},{"verse":15,"text":"That ye may be blameless and harmless, the sons of God, without rebuke, in the midst of a crooked and perverse nation, among whom ye shine as lights in the world;","words":[["That",["G2443"]],["ye may be",["G1096"]],["blameless",["G273"]],["and",["G2532"]],["harmless,",["G185"]],["the sons",["G5043"]],["of God,",["G2316"]],["without rebuke,",["G298"]],["in",["G1722"]],["the midst",["G3319"]],["of a crooked",["G4646"]],["and",["G2532"]],["perverse",["G1294"]],["nation,",["G1074"]],["among",["G1722"]],["whom",["G3739"]],["ye shine",["G5316"]],["as",["G5613"]],["lights",["G5458"]],["in",["G1722"]],["the world;",[]]]},{"verse":16,"text":"Holding forth the word of life; that I may rejoice in the day of Christ, that I have not run in vain, neither laboured in vain.","words":[["Holding forth",["G1907"]],["the word",["G3056"]],["of life;",["G2222"]],["that",["G1519"]],["I",["G1698"]],["may rejoice",["G2745"]],["in",["G1519"]],["the day",["G2250"]],["of Christ,",["G5547"]],["that",["G3754"]],["I have",["G5143"]],["not",["G3756"]],["run",["G5143"]],["in",["G1519"]],["vain,",["G2756"]],["neither",["G3761"]],["laboured",["G2872"]],["in",["G1519"]],["vain.",[]]]},{"verse":17,"text":"Yea, and if I be offered upon the sacrifice and service of your faith, I joy, and rejoice with you all.","words":[["Yea,",["G235"]],["and if",["G1499"]],["I be offered",["G4689"]],["upon",["G1909"]],["the sacrifice",["G2378"]],["and",["G2532"]],["service",["G3009"]],["of your",["G5216"]],["faith,",["G4102"]],["I joy,",["G5463"]],["and",["G2532"]],["rejoice with",["G4796"]],["you",["G5213"]],["all.",[]]]},{"verse":18,"text":"For the same cause also do ye joy, and rejoice with me.","words":[["For",["G1161"]],["the same cause",["G846"]],["also",["G2532"]],["do",["G5463"]],["ye",["G5210"]],["joy,",["G5463"]],["and",["G2532"]],["rejoice with",["G4796"]],["me.",[]]]},{"verse":19,"text":"But I trust in the Lord Jesus to send Timotheus shortly unto you, that I also may be of good comfort, when I know your state.","words":[["But",["G1161"]],["I trust",["G1679"]],["in",["G1722"]],["the Lord",["G2962"]],["Jesus",["G2424"]],["to send",["G3992"]],["Timotheus",["G5095"]],["shortly",["G5030"]],["unto you,",["G5213"]],["that",["G2443"]],["I also",["G2504"]],["may be of good comfort,",["G2174"]],["when I know",["G1097"]],["your",["G5216"]],["state.",[]]]},{"verse":20,"text":"For I have no man likeminded, who will naturally care for your state.","words":[["For",["G1063"]],["I have",["G2192"]],["no man",["G3762"]],["likeminded,",["G2473"]],["who",["G3748"]],["will naturally",["G1104"]],["care",["G3309"]],["for your",["G5216"]],["state.",[]]]},{"verse":21,"text":"For all seek their own, not the things which are Jesus Christ’s.","words":[["For",["G1063"]],["all",["G3956"]],["seek",["G2212"]],["their own,",["G1438"]],["not",["G3756"]],["the things which are",["G3588"]],["Jesus",["G2424"]],["Christ’s.",[]]]},{"verse":22,"text":"But ye know the proof of him, that, as a son with the father, he hath served with me in the gospel.","words":[["But",["G1161"]],["ye know",["G1097"]],["the proof",["G1382"]],["of him,",["G846"]],["that,",["G3754"]],["as",["G5613"]],["a son",["G5043"]],["with the father,",["G3962"]],["he hath served",["G1398"]],["with",["G4862"]],["me",["G1698"]],["in",["G1519"]],["the gospel.",[]]]},{"verse":23,"text":"Him therefore I hope to send presently, so soon as I shall see how it will go with me.","words":[["Him",["G3303","G5126"]],["therefore",["G3767"]],["I hope",["G1679"]],["to send",["G3992"]],["presently,",["G1824"]],["so soon as",["G5613"]],["I",["G302"]],["shall see",["G542"]],["how",["G4012"]],["it will go with me.",[]]]},{"verse":24,"text":"But I trust in the Lord that I also myself shall come shortly.","words":[["But",["G1161"]],["I trust",["G3982"]],["in",["G1722"]],["the Lord",["G2962"]],["that",["G3754"]],["I",["G2064"]],["also",["G2532"]],["myself",["G846"]],["shall come",["G2064"]],["shortly.",[]]]},{"verse":25,"text":"Yet I supposed it necessary to send to you Epaphroditus, my brother, and companion in labour, and fellowsoldier, but your messenger, and he that ministered to my wants.","words":[["Yet",["G1161"]],["I supposed",["G2233"]],["it necessary",["G316"]],["to send",["G3992"]],["to",["G4314"]],["you",["G5209"]],["Epaphroditus,",["G1891"]],["my",["G3450"]],["brother,",["G80"]],["and",["G2532"]],["companion in labour,",["G4904"]],["and",["G2532"]],["fellowsoldier,",["G4961"]],["but",["G1161"]],["your",["G5216"]],["messenger,",["G652"]],["and",["G2532"]],["he that ministered",["G3011"]],["to my",["G3450"]],["wants.",[]]]},{"verse":26,"text":"For he longed after you all, and was full of heaviness, because that ye had heard that he had been sick.","words":[["For",["G1894"]],["he",["G2258"]],["longed after",["G1971"]],["you",["G5209"]],["all,",["G3956"]],["and",["G2532"]],["was full of heaviness,",["G85"]],["because",["G1360"]],["that ye had heard",["G191"]],["that",["G3754"]],["he had been sick.",[]]]},{"verse":27,"text":"For indeed he was sick nigh unto death: but God had mercy on him; and not on him only, but on me also, lest I should have sorrow upon sorrow.","words":[["For",["G1063"]],["indeed",["G2532"]],["he was sick",["G770"]],["nigh",["G3897"]],["unto death:",["G2288"]],["but",["G235"]],["God",["G2316"]],["had mercy",["G1653"]],["on him;",["G846"]],["and",["G1161"]],["not",["G3756"]],["on him",["G846"]],["only,",["G3440"]],["but",["G235"]],["on me",["G1691"]],["also,",["G2532"]],["lest",["G3363"]],["I should have",["G2192"]],["sorrow",["G3077"]],["upon",["G1909"]],["sorrow.",[]]]},{"verse":28,"text":"I sent him therefore the more carefully, that, when ye see him again, ye may rejoice, and that I may be the less sorrowful.","words":[["I sent",["G3992"]],["him",["G846"]],["therefore",["G3767"]],["the more carefully,",["G4708"]],["that,",["G2443"]],["when ye see",["G1492"]],["him",["G846"]],["again,",["G3825"]],["ye may rejoice,",["G5463"]],["and that I",["G2504"]],["may be",["G5600"]],["the less sorrowful.",[]]]},{"verse":29,"text":"Receive him therefore in the Lord with all gladness; and hold such in reputation:","words":[["Receive",["G4327"]],["him",["G846"]],["therefore",["G3767"]],["in",["G1722"]],["the Lord",["G2962"]],["with",["G3326"]],["all",["G3956"]],["gladness;",["G5479"]],["and",["G2532"]],["hold",["G2192"]],["such",["G5108"]],["in reputation:",[]]]},{"verse":30,"text":"Because for the work of Christ he was nigh unto death, not regarding his life, to supply your lack of service toward me.","words":[["Because",["G3754"]],["for",["G1223"]],["the work",["G2041"]],["of Christ",["G5547"]],["he was nigh",["G1448"]],["unto",["G3360"]],["death,",["G2288"]],["not regarding",["G3851"]],["his life,",["G5590"]],["to",["G2443"]],["supply",["G378"]],["your",["G5216"]],["lack",["G5303"]],["of service",["G3009"]],["toward",["G4314"]],["me.",[]]]}]}