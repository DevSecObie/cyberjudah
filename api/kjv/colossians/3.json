G1161"]],["he that doeth wrong",["G91"]],["shall receive",["G2865"]],["for the wrong",["G91"]],["which",["G3739"]],["he hath done:",["G91"]],["and",["G2532"]],["there is",["G2076"]],["no",["G3756"]],["respect of persons.",[]]]}]}