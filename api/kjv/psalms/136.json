{"book":"Psalms","chapter":136,"translation":"KJV","url":"/bible/psalms/136","verses":[{"verse":1,"text":"O give thanks unto the Lord; for he is good: for his mercy endureth for ever.","words":[["O give thanks",["H3034"]],["unto the Lord;",["H3068"]],["for he is good:",["H2896"]],["for his mercy",["H2617"]],["endureth for ever.",[]]]},{"verse":2,"text":"O give thanks unto the God of gods: for his mercy endureth for ever.","words":[["O give thanks",["H3034"]],["unto the God",["H430"]],["of gods:",["H430"]],["for his mercy",["H2617"]],["endureth for ever.",[]]]},{"verse":3,"text":"O give thanks to the Lord of lords: for his mercy endureth for ever.","words":[["O give thanks",["H3034"]],["to the Lord",["H113"]],["of lords:",["H113"]],["for his mercy",["H2617"]],["endureth for ever.",[]]]},{"verse":4,"text":"To him who alone doeth great wonders: for his mercy endureth for ever.","words":[["To him who alone doeth",["H6213"]],["great",["H1419"]],["wonders:",["H6381"]],["for his mercy",["H2617"]],["endureth for ever.",[]]]},{"verse":5,"text":"To him that by wisdom made the heavens: for his mercy endureth for ever.","words":[["To him that by wisdom",["H8394"]],["made",["H6213"]],["the heavens:",["H8064"]],["for his mercy",["H2617"]],["endureth for ever.",[]]]},{"verse":6,"text":"To him that stretched out the earth above the waters: for his mercy endureth for ever.","words":[["To him that stretched out",["H7554"]],["the earth",["H776"]],["above the waters:",["H4325"]],["for his mercy",["H2617"]],["endureth for ever.",[]]]},{"verse":7,"text":"To him that made great lights: for his mercy endureth for ever:","words":[["To him that made",["H6213"]],["great",["H1419"]],["lights:",["H216"]],["for his mercy",["H2617"]],["endureth for ever:",[]]]},{"verse":8,"text":"The sun to rule by day: for his mercy endureth for ever:","words":[["The sun",["H8121"]],["to rule",["H4475"]],["by day:",["H3117"]],["for his mercy",["H2617"]],["endureth for ever:",[]]]},{"verse":9,"text":"The moon and stars to rule by night: for his mercy endureth for ever.","words":[["The moon",["H3394"]],["and stars",["H3556"]],["to rule",["H4475"]],["by night:",["H3915"]],["for his mercy",["H2617"]],["endureth for ever.",[]]]},{"verse":10,"text":"To him that smote Egypt in their firstborn: for his mercy endureth for ever:","words":[["To him that smote",["H5221"]],["Egypt",["H4714"]],["in their firstborn:",["H1060"]],["for his mercy",["H2617"]],["endureth for ever:",[]]]},{"verse":11,"text":"And brought out Israel from among them: for his mercy endureth for ever:","words":[["And brought out",["H3318"]],["Israel",["H3478"]],["from among",["H8432"]],["them: for his mercy",["H2617"]],["endureth for ever:",[]]]},{"verse":12,"text":"With a strong hand, and with a stretched out arm: for his mercy endureth for ever.","words":[["With a strong",["H2389"]],["hand,",["H3027"]],["and with a stretched out",["H5186"]],["arm:",["H2220"]],["for his mercy",["H2617"]],["endureth for ever.",[]]]},{"verse":13,"text":"To him which divided the Red sea into parts: for his mercy endureth for ever:","words":[["To him which divided",["H1504"]],["the Red",["H5488"]],["sea",["H3220"]],["into parts:",["H1506"]],["for his mercy",["H2617"]],["endureth for ever:",[]]]},{"verse":14,"text":"And made Israel to pass through the midst of it: for his mercy endureth for ever:","words":[["And made Israel",["H3478"]],["to pass through",["H5674"]],["the midst",["H8432"]],["of it: for his mercy",["H2617"]],["endureth for ever:",[]]]},{"verse":15,"text":"But overthrew Pharaoh and his host in the Red sea: for his mercy endureth for ever.","words":[["But overthrew",["H5287"]],["Pharaoh",["H6547"]],["and his host",["H2428"]],["in the Red",["H5488"]],["sea:",["H3220"]],["for his mercy",["H2617"]],["endureth for ever.",[]]]},{"verse":16,"text":"To him which led his people through the wilderness: for his mercy endureth for ever.","words":[["To him which led",["H3212"]],["his people",["H5971"]],["through the wilderness:",["H4057"]],["for his mercy",["H2617"]],["endureth for ever.",[]]]},{"verse":17,"text":"To him which smote great kings: for his mercy endureth for ever:","words":[["To him which smote",["H5221"]],["great",["H1419"]],["kings:",["H4428"]],["for his mercy",["H2617"]],["endureth for ever:",[]]]},{"verse":18,"text":"And slew famous kings: for his mercy endureth for ever:","words":[["And slew",["H2026"]],["famous",["H117"]],["kings:",["H4428"]],["for his mercy",["H2617"]],["endureth for ever:",[]]]},{"verse":19,"text":"Sihon king of the Amorites: for his mercy endureth for ever:","words":[["Sihon",["H5511"]],["king",["H4428"]],["of the Amorites:",["H567"]],["for his mercy",["H2617"]],["endureth for ever:",[]]]},{"verse":20,"text":"And Og the king of Bashan: for his mercy endureth for ever:","words":[["And Og",["H5747"]],["the king",["H4428"]],["of Bashan:",["H1316"]],["for his mercy",["H2617"]],["endureth for ever:",[]]]},{"verse":21,"text":"And gave their land for an heritage: for his mercy endureth for ever:","words":[["And gave",["H5414"]],["their land",["H776"]],["for an heritage:",["H5159"]],["for his mercy",["H2617"]],["endureth for ever:",[]]]},{"verse":22,"text":"Even an heritage unto Israel his servant: for his mercy endureth for ever.","words":[["Even an heritage",["H5159"]],["unto Israel",["H3478"]],["his servant:",["H5650"]],["for his mercy",["H2617"]],["endureth for ever.",[]]]},{"verse":23,"text":"Who remembered us in our low estate: for his mercy endureth for ever:","words":[["Who remembered",["H2142"]],["us in our low estate:",["H8216"]],["for his mercy",["H2617"]],["endureth for ever:",[]]]},{"verse":24,"text":"And hath redeemed us from our enemies: for his mercy endureth for ever.","words":[["And hath redeemed",["H6561"]],["us from our enemies:",["H6862"]],["for his mercy",["H2617"]],["endureth for ever.",[]]]},{"verse":25,"text":"Who giveth food to all flesh: for his mercy endureth for ever.","words":[["Who giveth",["H5414"]],["food",["H3899"]],["to all flesh:",["H1320"]],["for his mercy",["H2617"]],["endureth for ever.",[]]]},{"verse":26,"text":"O give thanks unto the God of heaven: for his mercy endureth for ever.","words":[["O give thanks",["H3034"]],["unto the God",["H410"]],["of heaven:",["H8064"]],["for his mercy",["H2617"]],["endureth for ever.",[]]]}]}