{"book":"Psalms","chapter":97,"translation":"KJV","url":"/bible/psalms/97","verses":[{"verse":1,"text":"The Lord reigneth; let the earth rejoice; let the multitude of isles be glad thereof.","words":[["The Lord",["H3068"]],["reigneth;",["H4427"]],["let the earth",["H776"]],["rejoice;",["H1523"]],["let the multitude",["H7227"]],["of isles",["H339"]],["be glad thereof.",[]]]},{"verse":2,"text":"Clouds and darkness are round about him: righteousness and judgment are the habitation of his throne.","words":[["Clouds",["H6051"]],["and darkness",["H6205"]],["are round about",["H5439"]],["him: righteousness",["H6664"]],["and judgment",["H4941"]],["are the habitation",["H4349"]],["of his throne.",[]]]},{"verse":3,"text":"A fire goeth before him, and burneth up his enemies round about.","words":[["A fire",["H784"]],["goeth",["H3212"]],["before",["H6440"]],["him, and burneth up",["H3857"]],["his enemies",["H6862"]],["round about.",[]]]},{"verse":4,"text":"His lightnings enlightened the world: the earth saw, and trembled.","words":[["His lightnings",["H1300"]],["enlightened",["H215"]],["the world:",["H8398"]],["the earth",["H776"]],["saw,",["H7200"]],["and trembled.",[]]]},{"verse":5,"text":"The hills melted like wax at the presence of the Lord, at the presence of the Lord of the whole earth.","words":[["The hills",["H2022"]],["melted",["H4549"]],["like wax",["H1749"]],["at the presence",["H6440"]],["of the Lord,",["H3068"]],["at the presence",["H6440"]],["of the Lord",["H113"]],["of the whole earth.",[]]]},{"verse":6,"text":"The heavens declare his righteousness, and all the people see his glory.","words":[["The heavens",["H8064"]],["declare",["H5046"]],["his righteousness,",["H6664"]],["and all the people",["H5971"]],["see",["H7200"]],["his glory.",[]]]},{"verse":7,"text":"Confounded be all they that serve graven images, that boast themselves of idols: worship him, all ye gods.","words":[["Confounded",["H954"]],["be all they that serve",["H5647"]],["graven images,",["H6459"]],["that boast",["H1984"]],["themselves of idols:",["H457"]],["worship",["H7812"]],["him, all ye gods.",[]]]},{"verse":8,"text":"Zion heard, and was glad; and the daughters of Judah rejoiced because of thy judgments, O Lord.","words":[["Zion",["H6726"]],["heard,",["H8085"]],["and was glad;",["H8055"]],["and the daughters",["H1323"]],["of Judah",["H3063"]],["rejoiced",["H1523"]],["because of thy judgments,",["H4941"]],["O Lord.",[]]]},{"verse":9,"text":"For thou, Lord, art high above all the earth: thou art exalted far above all gods.","words":[["For thou, Lord,",["H3068"]],["art high above",["H5945"]],["all the earth:",["H776"]],["thou art exalted",["H5927"]],["far above",["H3966"]],["all gods.",[]]]},{"verse":10,"text":"Ye that love the Lord, hate evil: he preserveth the souls of his saints; he delivereth them out of the hand of the wicked.","words":[["Ye that love",["H157"]],["the Lord,",["H3068"]],["hate",["H8130"]],["evil:",["H7451"]],["he preserveth",["H8104"]],["the souls",["H5315"]],["of his saints;",["H2623"]],["he delivereth",["H5337"]],["them out of the hand",["H3027"]],["of the wicked.",[]]]},{"verse":11,"text":"Light is sown for the righteous, and gladness for the upright in heart.","words":[["Light",["H216"]],["is sown",["H2232"]],["for the righteous,",["H6662"]],["and gladness",["H8057"]],["for the upright",["H3477"]],["in heart.",[]]]},{"verse":12,"text":"Rejoice in the Lord, ye righteous; and give thanks at the remembrance of his holiness.","words":[["Rejoice",["H8055"]],["in the Lord,",["H3068"]],["ye righteous;",["H6662"]],["and give thanks",["H3034"]],["at the remembrance",["H2143"]],["of his holiness.",[]]]}]}