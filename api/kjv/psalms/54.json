{"book":"Psalms","chapter":54,"translation":"KJV","url":"/bible/psalms/54","verses":[{"verse":1,"text":"Save me, O God, by thy name, and judge me by thy strength.","words":[["Save",["H3467"]],["me, O God,",["H430"]],["by thy name,",["H8034"]],["and judge",["H1777"]],["me by thy strength.",[]]]},{"verse":2,"text":"Hear my prayer, O God; give ear to the words of my mouth.","words":[["Hear",["H8085"]],["my prayer,",["H8605"]],["O God;",["H430"]],["give ear",["H238"]],["to the words",["H561"]],["of my mouth.",[]]]},{"verse":3,"text":"For strangers are risen up against me, and oppressors seek after my soul: they have not set God before them. Selah.","words":[["For strangers",["H2114"]],["are risen up",["H6965"]],["against me, and oppressors",["H6184"]],["seek",["H1245"]],["after my soul:",["H5315"]],["they have not set",["H7760"]],["God",["H430"]],["before them. Selah.",[]]]},{"verse":4,"text":"Behold, God is mine helper: the Lord is with them that uphold my soul.","words":[["Behold, God",["H430"]],["is mine helper:",["H5826"]],["the Lord",["H136"]],["is with them that uphold",["H5564"]],["my soul.",[]]]},{"verse":5,"text":"He shall reward evil unto mine enemies: cut them off in thy truth.","words":[["He shall reward",["H7725","H7725"]],["evil",["H7451"]],["unto mine enemies:",["H8324"]],["cut them off",["H6789"]],["in thy truth.",[]]]},{"verse":6,"text":"I will freely sacrifice unto thee: I will praise thy name, O Lord; for it is good.","words":[["I will freely",["H5071"]],["sacrifice",["H2076"]],["unto thee: I will praise",["H3034"]],["thy name,",["H8034"]],["O Lord;",["H3068"]],["for it is good.",[]]]},{"verse":7,"text":"For he hath delivered me out of all trouble: and mine eye hath seen his desire upon mine enemies.","words":[["For he hath delivered",["H5337"]],["me out of all trouble:",["H6869"]],["and mine eye",["H5869"]],["hath seen",["H7200"]],["his desire upon mine enemies.",[]]]}]}