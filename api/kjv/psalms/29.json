{"book":"Psalms","chapter":29,"translation":"KJV","url":"/bible/psalms/29","verses":[{"verse":1,"text":"Give unto the Lord, O ye mighty, give unto the Lord glory and strength.","words":[["Give",["H3051"]],["unto the Lord,",["H3068"]],["O ye mighty,",["H1121","H410"]],["give",["H3051"]],["unto the Lord",["H3068"]],["glory",["H3519"]],["and strength.",[]]]},{"verse":2,"text":"Give unto the Lord the glory due unto his name; worship the Lord in the beauty of holiness.","words":[["Give",["H3051"]],["unto the Lord",["H3068"]],["the glory",["H3519"]],["due unto his name;",["H8034"]],["worship",["H7812"]],["the Lord",["H3068"]],["in the beauty",["H1927"]],["of holiness.",[]]]},{"verse":3,"text":"The voice of the Lord is upon the waters: the God of glory thundereth: the Lord is upon many waters.","words":[["The voice",["H6963"]],["of the Lord",["H3068"]],["is upon the waters:",["H4325"]],["the God",["H410"]],["of glory",["H3519"]],["thundereth:",["H7481"]],["the Lord",["H3068"]],["is upon many",["H7227"]],["waters.",[]]]},{"verse":4,"text":"The voice of the Lord is powerful; the voice of the Lord is full of majesty.","words":[["The voice",["H6963"]],["of the Lord",["H3068"]],["is powerful;",["H3581"]],["the voice",["H6963"]],["of the Lord",["H3068"]],["is full of majesty.",[]]]},{"verse":5,"text":"The voice of the Lord breaketh the cedars; yea, the Lord breaketh the cedars of Lebanon.","words":[["The voice",["H6963"]],["of the Lord",["H3068"]],["breaketh",["H7665"]],["the cedars;",["H730"]],["yea, the Lord",["H3068"]],["breaketh",["H7665"]],["the cedars",["H730"]],["of Lebanon.",[]]]},{"verse":6,"text":"He maketh them also to skip like a calf; Lebanon and Sirion like a young unicorn.","words":[["He maketh them also to skip",["H7540"]],["like a calf;",["H5695"]],["Lebanon",["H3844"]],["and Sirion",["H8303"]],["like a young",["H1121"]],["unicorn.",[]]]},{"verse":7,"text":"The voice of the Lord divideth the flames of fire.","words":[["The voice",["H6963"]],["of the Lord",["H3068"]],["divideth",["H2672"]],["the flames",["H3852"]],["of fire.",[]]]},{"verse":8,"text":"The voice of the Lord shaketh the wilderness; the Lord shaketh the wilderness of Kadesh.","words":[["The voice",["H6963"]],["of the Lord",["H3068"]],["shaketh",["H2342"]],["the wilderness;",["H4057"]],["the Lord",["H3068"]],["shaketh",["H2342"]],["the wilderness",["H4057"]],["of Kadesh.",[]]]},{"verse":9,"text":"The voice of the Lord maketh the hinds to calve, and discovereth the forests: and in his temple doth every one speak of his glory.","words":[["The voice",["H6963"]],["of the Lord",["H3068"]],["maketh the hinds",["H355"]],["to calve,",["H2342"]],["and discovereth",["H2834"]],["the forests:",["H3295"]],["and in his temple",["H1964"]],["doth every one speak",["H559"]],["of his glory.",[]]]},{"verse":10,"text":"The Lord sitteth upon the flood; yea, the Lord sitteth King for ever.","words":[["The Lord",["H3068"]],["sitteth",["H3427"]],["upon the flood;",["H3999"]],["yea, the Lord",["H3068"]],["sitteth",["H3427"]],["King",["H4428"]],["for ever.",[]]]},{"verse":11,"text":"The Lord will give strength unto his people; the Lord will bless his people with peace.","words":[["The Lord",["H3068"]],["will give",["H5414"]],["strength",["H5797"]],["unto his people;",["H5971"]],["the Lord",["H3068"]],["will bless",["H1288"]],["his people",["H5971"]],["with peace.",[]]]}]}