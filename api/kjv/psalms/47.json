{"book":"Psalms","chapter":47,"translation":"KJV","url":"/bible/psalms/47","verses":[{"verse":1,"text":"O clap your hands, all ye people; shout unto God with the voice of triumph.","words":[["O clap",["H8628"]],["your hands,",["H3709"]],["all ye people;",["H5971"]],["shout",["H7321"]],["unto God",["H430"]],["with the voice",["H6963"]],["of triumph.",[]]]},{"verse":2,"text":"For the Lord most high is terrible; he is a great King over all the earth.","words":[["For the Lord",["H3068"]],["most high",["H5945"]],["is terrible;",["H3372"]],["he is a great",["H1419"]],["King",["H4428"]],["over all the earth.",[]]]},{"verse":3,"text":"He shall subdue the people under us, and the nations under our feet.","words":[["He shall subdue",["H1696"]],["the people",["H5971"]],["under us, and the nations",["H3816"]],["under our feet.",[]]]},{"verse":4,"text":"He shall choose our inheritance for us, the excellency of Jacob whom he loved. Selah.","words":[["He shall choose",["H977"]],["our inheritance",["H5159"]],["for us, the excellency",["H1347"]],["of Jacob",["H3290"]],["whom he loved.",["H157"]],["Selah.",[]]]},{"verse":5,"text":"God is gone up with a shout, the Lord with the sound of a trumpet.","words":[["God",["H430"]],["is gone up",["H5927"]],["with a shout,",["H8643"]],["the Lord",["H3068"]],["with the sound",["H6963"]],["of a trumpet.",[]]]},{"verse":6,"text":"Sing praises to God, sing praises: sing praises unto our King, sing praises.","words":[["Sing praises",["H2167"]],["to God,",["H430"]],["sing praises:",["H2167"]],["sing praises",["H2167"]],["unto our King,",["H4428"]],["sing praises.",[]]]},{"verse":7,"text":"For God is the King of all the earth: sing ye praises with understanding.","words":[["For God",["H430"]],["is the King",["H4428"]],["of all the earth:",["H776"]],["sing ye praises",["H2167"]],["with understanding.",[]]]},{"verse":8,"text":"God reigneth over the heathen: God sitteth upon the throne of his holiness.","words":[["God",["H430"]],["reigneth",["H4427"]],["over the heathen:",["H1471"]],["God",["H430"]],["sitteth",["H3427"]],["upon the throne",["H3678"]],["of his holiness.",[]]]},{"verse":9,"text":"The princes of the people are gathered together, even the people of the God of Abraham: for the shields of the earth belong unto God: he is greatly exalted.","words":[["The princes",["H5081"]],["of the people",["H5971"]],["are gathered together,",["H622"]],["even the people",["H5971"]],["of the God",["H430"]],["of Abraham:",["H85"]],["for the shields",["H4043"]],["of the earth",["H776"]],["belong unto God:",["H430"]],["he is greatly",["H3966"]],["exalted.",[]]]}]}