{"book":"Psalms","chapter":148,"translation":"KJV","url":"/bible/psalms/148","verses":[{"verse":1,"text":"Praise ye the Lord. Praise ye the Lord from the heavens: praise him in the heights.","words":[["Praise",["H1984"]],["ye the Lord.",["H3050"]],["Praise",["H1984"]],["ye the Lord",["H3068"]],["from the heavens:",["H8064"]],["praise",["H1984"]],["him in the heights.",[]]]},{"verse":2,"text":"Praise ye him, all his angels: praise ye him, all his hosts.","words":[["Praise",["H1984"]],["ye him, all his angels:",["H4397"]],["praise",["H1984"]],["ye him, all his hosts.",[]]]},{"verse":3,"text":"Praise ye him, sun and moon: praise him, all ye stars of light.","words":[["Praise",["H1984"]],["ye him, sun",["H8121"]],["and moon:",["H3394"]],["praise",["H1984"]],["him, all ye stars",["H3556"]],["of light.",[]]]},{"verse":4,"text":"Praise him, ye heavens of heavens, and ye waters that be above the heavens.","words":[["Praise",["H1984"]],["him, ye heavens",["H8064"]],["of heavens,",["H8064"]],["and ye waters",["H4325"]],["that be above the heavens.",[]]]},{"verse":5,"text":"Let them praise the name of the Lord: for he commanded, and they were created.","words":[["Let them praise",["H1984"]],["the name",["H8034"]],["of the Lord:",["H3068"]],["for he commanded,",["H6680"]],["and they were created.",[]]]},{"verse":6,"text":"He hath also stablished them for ever and ever: he hath made a decree which shall not pass.","words":[["He hath also stablished",["H5975"]],["them for ever",["H5703"]],["and ever:",["H5769"]],["he hath made",["H5414"]],["a decree",["H2706"]],["which shall not pass.",[]]]},{"verse":7,"text":"Praise the Lord from the earth, ye dragons, and all deeps:","words":[["Praise",["H1984"]],["the Lord",["H3068"]],["from the earth,",["H776"]],["ye dragons,",["H8577"]],["and all deeps:",[]]]},{"verse":8,"text":"Fire, and hail; snow, and vapour; stormy wind fulfilling his word:","words":[["Fire,",["H784"]],["and hail;",["H1259"]],["snow,",["H7950"]],["and vapour;",["H7008"]]