{"book":"Psalms","chapter":147,"translation":"KJV","url":"/bible/psalms/147","verses":[{"verse":1,"text":"Praise ye the Lord: for it is good to sing praises unto our God; for it is pleasant; and praise is comely.","words":[["Praise",["H1984"]],["ye the Lord:",["H3050"]],["for it is good",["H2896"]],["to sing praises",["H2167"]],["unto our God;",["H430"]],["for it is pleasant;",["H5273"]],["and praise",["H8416"]],["is comely.",[]]]},{"verse":2,"text":"The Lord doth build up Jerusalem: he gathereth together the outcasts of Israel.","words":[["The Lord",["H3068"]],["doth build up",["H1129"]],["Jerusalem:",["H3389"]],["he gathereth together",["H3664"]],["the outcasts",["H1760"]],["of Israel.",[]]]},{"verse":3,"text":"He healeth the broken in heart, and bindeth up their wounds.","words":[["He healeth",["H7495"]],["the broken",["H7665"]],["in heart,",["H3820"]],["and bindeth up",["H2280"]],["their wounds.",[]]]},{"verse":4,"text":"He telleth the number of the stars; he calleth them all by their names.","words":[["He telleth",["H4487"]],["the number",["H4557"]],["of the stars;",["H3556"]],["he calleth",["H7121"]],["them all by their names.",[]]]},{"verse":5,"text":"Great is our Lord, and of great power: his understanding is infinite.","words":[["Great",["H1419"]],["is our Lord,",["H113"]],["and of great",["H7227"]],["power:",["H3581"]],["his understanding",["H8394"]],["is infinite.",[]]]},{"verse":6,"text":"The Lord lifteth up the meek: he casteth the wicked down to the ground.","words":[["The Lord",["H3068"]],["lifteth up",["H5749"]],["the meek:",["H6035"]],["he casteth",["H8213"]],["the wicked",["H7563"]],["down",["H8213"]],["to the ground.",[]]]},{"verse":7,"text":"Sing unto the Lord with thanksgiving; sing praise upon the harp unto our God:","words":[["Sing",["H6030"]],["unto the Lord",["H3068"]],["with thanksgiving;",["H8426"]],["sing praise",["H2167"]],["upon the harp",["H3658"]],["unto our God:",[]]]},{"verse":8,"text":"Who covereth the heaven with clouds, who prepareth rain for the earth, who maketh grass to grow upon the mountains.","words":[["Who covereth",["H3680"]],["the heaven",["H8064"]],["with clouds,",["H5645"]],["who prepareth",["H3559"]],["rain",["H4306"]],["for the earth,",["H776"]],["who maketh grass",["H2682"]],["to grow",["H6779"]],["upon the mountains.",[]]]},{"verse":9,"text":"He giveth to the beast his food, and to the young ravens which cry.","words":[["He giveth",["H5414"]],["to the beast",["H929"]],["his food,",["H3899"]],["and to the young",["H1121"]],["ravens",["H6158"]],["which cry.",[]]]},{"verse":10,"text":"He delighteth not in the strength of the horse: he taketh not pleasure in the legs of a man.","words":[["He delighteth",["H2654"]],["not in the strength",["H1369"]],["of the horse:",["H5483"]],["he taketh not pleasure",["H7521"]],["in the legs",["H7785"]],["of a man.",[]]]},{"verse":11,"text":"The Lord taketh pleasure in them that fear him, in those that hope in his mercy.","words":[["The Lord",["H3068"]],["taketh pleasure",["H7521"]],["in them that fear",["H3373"]],["him, in those that hope",["H3176"]],["in his mercy.",[]]]},{"verse":12,"text":"Praise the Lord, O Jerusalem; praise thy God, O Zion.","words":[["Praise",["H7623"]],["the Lord,",["H3068"]],["O Jerusalem;",["H3389"]],["praise",["H1984"]],["thy God,",["H430"]],["O Zion.",[]]]},{"verse":13,"text":"For he hath strengthened the bars of thy gates; he hath blessed thy children within thee.","words":[["For he hath strengthened",["H2388"]],["the bars",["H1280"]],["of thy gates;",["H8179"]],["he hath blessed",["H1288"]],["thy children",["H1121"]],["within thee.",[]]]},{"verse":14,"text":"He maketh peace in thy borders, and filleth thee with the finest of the wheat.","words":[["He maketh",["H7760"]],["peace",["H7965"]],["in thy borders,",["H1366"]],["and filleth",["H7646"]],["thee with the finest",["H2459"]],["of the wheat.",[]]]},{"verse":15,"text":"He sendeth forth his commandment upon earth: his word runneth very swiftly.","words":[["He sendeth forth",["H7971"]],["his commandment",["H565"]],["upon earth:",["H776"]],["his word",["H1697"]],["runneth",["H7323"]],["very swiftly.",[]]]},{"verse":16,"text":"He giveth snow like wool: he scattereth the hoarfrost like ashes.","words":[["He giveth",["H5414"]],["snow",["H7950"]],["like wool:",["H6785"]],["he scattereth",["H6340"]],["the hoarfrost",["H3713"]],["like ashes.",[]]]},{"verse":17,"text":"He casteth forth his ice like morsels: who can stand before his cold?","words":[["He casteth forth",["H7993"]],["his ice",["H7140"]],["like morsels:",["H6595"]],["who can stand",["H5975"]],["before",["H6440"]],["his cold?",[]]]},{"verse":18,"text":"He sendeth out his word, and melteth them: he causeth his wind to blow, and the waters flow.","words":[["He sendeth out",["H7971"]],["his word,",["H1697"]],["and melteth",["H4529"]],["them: he causeth his wind",["H7307"]],["to blow,",["H5380"]],["and the waters",["H4325"]],["flow.",[]]]},{"verse":19,"text":"He sheweth his word unto Jacob, his statutes and his judgments unto Israel.","words":[["He sheweth",["H5046"]],["his word",["H1697","H1697"]],["unto Jacob,",["H3290"]],["his statutes",["H2706"]],["and his judgments",["H4941"]],["unto Israel.",[]]]},{"verse":20,"text":"He hath not dealt so with any nation: and as for his judgments, they have not known them. Praise ye the Lord.","words":[["He hath not dealt",["H6213"]],["so with any nation:",["H1471"]],["and as for his judgments,",["H4941"]],["they have not known",["H3045"]],["them. Praise",["H1984"]],["ye the Lord.",[]]]}]}