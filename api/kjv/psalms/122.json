{"book":"Psalms","chapter":122,"translation":"KJV","url":"/bible/psalms/122","verses":[{"verse":1,"text":"I was glad when they said unto me, Let us go into the house of the Lord.","words":[["I was glad",["H8055"]],["when they said",["H559"]],["unto me, Let us go",["H3212"]],["into the house",["H1004"]],["of the Lord.",[]]]},{"verse":2,"text":"Our feet shall stand within thy gates, O Jerusalem.","words":[["Our feet",["H7272"]],["shall stand",["H5975"]],["within thy gates,",["H8179"]],["O Jerusalem.",[]]]},{"verse":3,"text":"Jerusalem is builded as a city that is compact together:","words":[["Jerusalem",["H3389"]],["is builded",["H1129"]],["as a city",["H5892"]],["that is compact",["H2266"]],["together:",[]]]},{"verse":4,"text":"Whither the tribes go up, the tribes of the Lord, unto the testimony of Israel, to give thanks unto the name of the Lord.","words":[["Whither",["H8033"]],["the tribes",["H7626"]],["go up,",["H5927"]],["the tribes",["H7626"]],["of the Lord,",["H3050"]],["unto the testimony",["H5715"]],["of Israel,",["H3478"]],["to give thanks",["H3034"]],["unto the name",["H8034"]],["of the Lord.",[]]]},{"verse":5,"text":"For there are set thrones of judgment, the thrones of the house of David.","words":[["For there are set",["H3427"]],["thrones",["H3678"]],["of judgment,",["H4941"]],["the thrones",["H3678"]],["of the house",["H1004"]],["of David.",[]]]},{"verse":6,"text":"Pray for the peace of Jerusalem: they shall prosper that love thee.","words":[["Pray",["H7592"]],["for the peace",["H7965"]],["of Jerusalem:",["H3389"]],["they shall prosper",["H7951"]],["that love thee.",[]]]},{"verse":7,"text":"Peace be within thy walls, and prosperity within thy palaces.","words":[["Peace",["H7965"]],["be within thy walls,",["H2426"]],["and prosperity",["H7962"]],["within thy palaces.",[]]]},{"verse":8,"text":"For my brethren and companions’ sakes, I will now say, Peace be within thee.","words":[["For my brethren",["H251"]],["and companions’",["H7453"]],["sakes, I will now say,",["H1696"]],["Peace be within thee.",[]]]},{"verse":9,"text":"Because of the house of the Lord our God I will seek thy good.","words":[["Because of the house",["H1004"]],["of the Lord",["H3068"]],["our God",["H430"]],["I will seek",["H1245"]],["thy good.",[]]]}]}