{"book":"Psalms","chapter":99,"translation":"KJV","url":"/bible/psalms/99","verses":[{"verse":1,"text":"The Lord reigneth; let the people tremble: he sitteth between the cherubims; let the earth be moved.","words":[["The Lord",["H3068"]],["reigneth;",["H4427"]],["let the people",["H5971"]],["tremble:",["H7264"]],["he sitteth",["H3427"]],["between the cherubims;",["H3742"]],["let the earth",["H776"]],["be moved.",[]]]},{"verse":2,"text":"The Lord is great in Zion; and he is high above all the people.","words":[["The Lord",["H3068"]],["is great",["H1419"]],["in Zion;",["H6726"]],["and he is high",["H7311"]],["above all the people.",[]]]},{"verse":3,"text":"Let them praise thy great and terrible name; for it is holy.","words":[["Let them praise",["H3034"]],["thy great",["H1419"]],["and terrible",["H3372"]],["name;",["H8034"]],["for it is holy.",[]]]},{"verse":4,"text":"The king’s strength also loveth judgment; thou dost establish equity, thou executest judgment and righteousness in Jacob.","words":[["The king’s strength",["H5797"]],["also loveth",["H157"]],["judgment;",["H4941"]],["thou dost establish",["H3559"]],["equity,",["H4339"]],["thou executest",["H6213"]],["judgment",["H4941"]],["and righteousness",["H6666"]],["in Jacob.",[]]]},{"verse":5,"text":"Exalt ye the Lord our God, and worship at his footstool; for he is holy.","words":[["Exalt",["H7311"]],["ye the Lord",["H3068"]],["our God,",["H430"]],["and worship",["H7812"]],["at his footstool;",["H7272","H1916"]],["for he is holy.",[]]]},{"verse":6,"text":"Moses and Aaron among his priests, and Samuel among them that call upon his name; they called upon the Lord, and he answered them.","words":[["Moses",["H4872"]],["and Aaron",["H175"]],["among his priests,",["H3548"]],["and Samuel",["H8050"]],["among them that call",["H7121"]],["upon his name;",["H8034"]],["they called",["H7121"]],["upon the Lord,",["H3068"]],["and he answered them.",[]]]},{"verse":7,"text":"He spake unto them in the cloudy pillar: they kept his testimonies, and the ordinance that he gave them.","words":[["He spake",["H1696"]],["unto them in the cloudy",["H6051"]],["pillar:",["H5982"]],["they kept",["H8104"]],["his testimonies,",["H5713"]],["and the ordinance",["H2706"]],["that he gave them.",[]]]},{"verse":8,"text":"Thou answeredst them, O Lord our God: thou wast a God that forgavest them, though thou tookest vengeance of their inventions.","words":[["Thou answeredst",["H6030"]],["them, O Lord",["H3068"]],["our God:",["H430"]],["thou wast a God",["H410"]],["that forgavest",["H5375"]],["them, though thou tookest vengeance",["H5358"]],["of their inventions.",[]]]},{"verse":9,"text":"Exalt the Lord our God, and worship at his holy hill; for the Lord our God is holy.","words":[["Exalt",["H7311"]],["the Lord",["H3068"]],["our God,",["H430"]],["and worship",["H7812"]],["at his holy",["H6944"]],["hill;",["H2022"]],["for the Lord",["H3068"]],["our God",["H430"]],["is holy.",[]]]}]}