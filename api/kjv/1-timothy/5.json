{"book":"1 Timothy","chapter":5,"translation":"KJV","url":"/bible/1-timothy/5","verses":[{"verse":1,"text":"Rebuke not an elder, but intreat him as a father; and the younger men as brethren;","words":[["Rebuke",["G1969"]],["not",["G3361"]],["an elder,",["G4245"]],["but",["G235"]],["intreat",["G3870"]],["him as",["G5613"]],["a father;",["G3962"]],["and the younger men",["G3501"]],["as",["G5613"]],["brethren;",["G80"]]]},{"verse":2,"text":"The elder women as mothers; the younger as sisters, with all purity.","words":[["The elder women",["G4245"]],["as",["G5613"]],["mothers;",["G3384"]],["the younger",["G3501"]],["as",["G5613"]],["sisters,",["G79"]],["with",["G1722"]],["all",["G3956"]],["purity.",["G47"]]]},{"verse":3,"text":"Honour widows that are widows indeed.","words":[["Honour",["G5091"]],["widows",["G5503"]],["that are widows",["G5503"]],["indeed.",["G3689"]]]},{"verse":4,"text":"But if any widow have children or nephews, let them learn first to shew piety at home, and to requite their parents: for that is good and acceptable before God.","words":[["But",["G1161"]],["if any",["G1536"]],["widow",["G5503"]],["have",["G2192"]],["children",["G5043"]],["or",["G2228"]],["nephews,",["G1549"]],["let them learn",["G3129"]],["first",["G4412"]],["to shew piety",["G2151"]],["at home,",["G2398","G3624"]],["and",["G2532"]],["to requite",["G287","G591"]],["their parents:",["G4269"]],["for",["G1063"]],["that",["G5124"]],["is",["G2076"]],["good",["G2570"]],["and",["G2532"]],["acceptable",["G587"]],["before",["G1799"]],["God.",["G2316"]]]},{"verse":5,"text":"Now she that is a widow indeed, and desolate, trusteth in God, and continueth in supplications and prayers night and day.","words":[["Now",["G1161"]],["she that is a widow",["G5503"]],["indeed,",["G3689"]],["and",["G2532"]],["desolate,",["G3443"]],["trusteth",["G1679"]],["in",["G1909"]],["God,",["G2316"]],["and",["G2532"]],["continueth",["G4357"]],["in supplications",["G1162"]],["and",["G2532"]],["prayers",["G4335"]],["night",["G3571"]],["and",["G2532"]],["day.",["G2250"]]]},{"verse":6,"text":"But she that liveth in pleasure is dead while she liveth.","words":[["But",["G1161"]],["she that liveth in pleasure",["G4684"]],["is dead",["G2348"]],["while she liveth.",["G2198"]]]},{"verse":7,"text":"And these things give in charge, that they may be blameless.","words":[["And",["G2532"]],["these things",["G5023"]],["give in charge,",["G3853"]],["that",["G2443"]],["they may be",["G5600"]],["blameless.",["G423"]]]},{"verse":8,"text":"But if any provide not for his own, and specially for those of his own house, he hath denied the faith, and is worse than an infidel.","words":[["But",["G1161"]],["if any",["G1536"]],["provide",["G4306"]],["not",["G3756"]],["for his own,",["G2398"]],["and",["G2532"]],["specially",["G3122"]],["for those of his own house,",["G3609"]],["he hath denied",["G720"]],["the faith,",["G4102"]],["and",["G2532"]],["is",["G2076"]],["worse than",["G5501"]],["an infidel.",["G571"]]]},{"verse":9,"text":"Let not a widow be taken into the number under threescore years old, having been the wife of one man,","words":[["Let",["G2639"]],["not",["G3361"]],["a widow",["G5503"]],["be taken into the number",["G2639"]],["under",["G1640"]],["threescore",["G1835"]],["years old,",["G2094"]],["having been",["G1096"]],["the wife",["G1135"]],["of one",["G1520"]],["man,",["G435"]]]},{"verse":10,"text":"Well reported of for good works; if she have brought up children, if she have lodged strangers, if she have washed the saints’ feet, if she have relieved the afflicted, if she have diligently followed every good work.","words":[["Well reported of",["G3140"]],["for",["G1722"]],["good",["G2570"]],["works;",["G2041"]],["if",["G1487"]],["she have brought up",["G5044"]],["children, if",["G1487"]],["she have lodged strangers,",["G3580"]],["if",["G1487"]],["she have washed",["G3538"]],["the saints’",["G40"]],["feet,",["G4228"]],["if",["G1487"]],["she have relieved",["G1884"]],["the afflicted,",["G2346"]],["if",["G1487"]],["she have diligently followed",["G1872"]],["every",["G3956"]],["good",["G18"]],["work.",["G2041"]]]},{"verse":11,"text":"But the younger widows refuse: for when they have begun to wax wanton against Christ, they will marry;","words":[["But",["G1161"]],["the younger",["G3501"]],["widows",["G5503"]],["refuse:",["G3868"]],["for",["G1063"]],["when",["G3752"]],["they have begun to wax wanton against",["G2691"]],["Christ,",["G5547"]],["they will",["G2309"]],["marry;",["G1060"]]]},{"verse":12,"text":"Having damnation, because they have cast off their first faith.","words":[["Having",["G2192"]],["damnation,",["G2917"]],["because",["G3754"]],["they have cast off",["G114"]],["their first",["G4413"]],["faith.",["G4102"]]]},{"verse":13,"text":"And withal they learn to be idle, wandering about from house to house; and not only idle, but tattlers also and busybodies, speaking things which they ought not.","words":[["And",["G1161","G2532"]],["withal",["G260"]],["they learn",["G3129"]],["to be idle,",["G692"]],["wandering about",["G4022"]],["from house to house;",["G3614"]],["and",["G1161"]],["not",["G3756"]],["only",["G3440"]],["idle,",["G692"]],["but",["G235"]],["tattlers",["G5397"]],["also",["G2532"]],["and",["G2532"]],["busybodies,",["G4021"]],["speaking",["G2980"]],["things which",["G3588"]],["they ought",["G1163"]],["not.",["G3361"]]]},{"verse":14,"text":"I will therefore that the younger women marry, bear children, guide the house, give none occasion to the adversary to speak reproachfully.","words":[["I will",["G1014"]],["therefore",["G3767"]],["that the younger women",["G3501"]],["marry,",["G1060"]],["bear children,",["G5041"]],["guide the house,",["G3616"]],["give",["G1325"]],["none",["G3367"]],["occasion",["G874"]],["to the adversary",["G480"]],["to",["G5484"]],["speak reproachfully.",["G3059"]]]},{"verse":15,"text":"For some are already turned aside after Satan.","words":[["For",["G1063"]],["some",["G5100"]],["are",["G1624"]],["already",["G2235"]],["turned aside",["G1624"]],["after",["G3694"]],["Satan.",["G4567"]]]},{"verse":16,"text":"If any man or woman that believeth have widows, let them relieve them, and let not the church be charged; that it may relieve them that are widows indeed.","words":[["If any",["G1536"]],["man",["G4103"]],["or",["G2228"]],["woman that believeth",["G4103"]],["have",["G2192"]],["widows,",["G5503"]],["let them relieve",["G1884"]],["them,",["G846"]],["and",["G2532"]],["let",["G916"]],["not",["G3361"]],["the church",["G1577"]],["be charged;",["G916"]],["that",["G2443"]],["it may relieve",["G1884"]],["them that are widows",["G5503"]],["indeed.",["G3689"]]]},{"verse":17,"text":"Let the elders that rule well be counted worthy of double honour, especially they who labour in the word and doctrine.","words":[["Let",["G515"]],["the elders",["G4245"]],["that rule",["G4291"]],["well",["G2573"]],["be counted worthy",["G515"]],["of double",["G1362"]],["honour,",["G5092"]],["especially",["G3122"]],["they who labour",["G2872"]],["in",["G1722"]],["the word",["G3056"]],["and",["G2532"]],["doctrine.",["G1319"]]]},{"verse":18,"text":"For the scripture saith, Thou shalt not muzzle the ox that treadeth out the corn. And, The labourer is worthy of his reward.","words":[["For",["G1063"]],["the scripture",["G1124"]],["saith,",["G3004"]],["Thou shalt",["G5392"]],["not",["G3756"]],["muzzle",["G5392"]],["the ox",["G1016"]],["that treadeth out the corn.",["G248"]],["And,",["G2532"]],["The labourer",["G2040"]],["is worthy",["G514"]],["of his",["G846"]],["reward.",["G3408"]]]},{"verse":19,"text":"Against an elder receive not an accusation, but before two or three witnesses.","words":[["Against",["G2596"]],["an elder",["G4245"]],["receive",["G3858"]],["not",["G3361"]],["an accusation,",["G2724"]],["but",["G1508","G1622"]],["before",["G1909"]],["two",["G1417"]],["or",["G2228"]],["three",["G5140"]],["witnesses.",["G3144"]]]},{"verse":20,"text":"Them that sin rebuke before all, that others also may fear.","words":[["Them that sin",["G264"]],["rebuke",["G1651"]],["before",["G1799"]],["all,",["G3956"]],["that",["G2443"]],["others",["G3062"]],["also",["G2532"]],["may",["G2192"]],["fear.",["G5401"]]]},{"verse":21,"text":"I charge thee before God, and the Lord Jesus Christ, and the elect angels, that thou observe these things without preferring one before another, doing nothing by partiality.","words":[["I charge",["G1263"]],["thee before",["G1799"]],["God,",["G2316"]],["and",["G2532"]],["the Lord",["G2962"]],["Jesus",["G2424"]],["Christ,",["G5547"]],["and",["G2532"]],["the elect",["G1588"]],["angels,",["G32"]],["that",["G2443"]],["thou observe",["G5442"]],["these things",["G5023"]],["without",["G5565"]],["preferring one before another,",["G4299"]],["doing",["G4160"]],["nothing",["G3367"]],["by",["G2596"]],["partiality.",["G4346"]]]},{"verse":22,"text":"Lay hands suddenly on no man, neither be partaker of other men’s sins: keep thyself pure.","words":[["Lay",["G2007"]],["hands",["G5495"]],["suddenly",["G5030"]],["on",["G2007"]],["no man,",["G3367"]],["neither",["G3366"]],["be partaker",["G2841"]],["of other",["G245"]],["men’s sins:",["G266"]],["keep",["G5083"]],["thyself",["G4572"]],["pure.",["G53"]]]},{"verse":23,"text":"Drink no longer water, but use a little wine for thy stomach’s sake and thine often infirmities.","words":[["Drink",["G5202"]],["no longer",["G3371"]],["water,",["G5202"]],["but",["G235"]],["use",["G5530"]],["a little",["G3641"]],["wine",["G3631"]],["for",["G1223"]],["thy",["G4675"]],["stomach’s sake",["G4751"]],["and",["G2532"]],["thine",["G4675"]],["often",["G4437"]],["infirmities.",["G769"]]]},{"verse":24,"text":"Some men’s sins are open beforehand, going before to judgment; and some men they follow after.","words":[["Some",["G5100"]],["men’s sins",["G266"]],["are",["G1526"]],["open beforehand,",["G4271"]],["going before",["G4254"]],["to",["G1519"]],["judgment;",["G2920"]],["and",["G1161","G2532"]],["some",["G5100"]],["men they follow after.",["G1872"]]]},{"verse":25,"text":"Likewise also the good works of some are manifest beforehand; and they that are otherwise cannot be hid.","words":[["Likewise",["G5615"]],["also",["G2532"]],["the good",["G2570"]],["works",["G2041"]],["of some are",["G2076"]],["manifest beforehand;",["G4271"]],["and",["G2532"]],["they that are",["G2192"]],["otherwise",["G247"]],["cannot",["G3756","G1410"]],["be hid.",["G2928"]]]}]}