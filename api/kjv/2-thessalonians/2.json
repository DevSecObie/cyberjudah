{"book":"2 Thessalonians","chapter":2,"translation":"KJV","url":"/bible/2-thessalonians/2","verses":[{"verse":1,"text":"Now we beseech you, brethren, by the coming of our Lord Jesus Christ, and by our gathering together unto him,","words":[["Now",["G1161"]],["we beseech",["G2065"]],["you,",["G5209"]],["brethren,",["G80"]],["by",["G5228"]],["the coming",["G3952"]],["of our",["G2257"]],["Lord",["G2962"]],["Jesus",["G2424"]],["Christ,",["G5547"]],["and",["G2532"]],["by our",["G2257"]],["gathering together",["G1997"]],["unto",["G1909"]],["him,",["G846"]]]},{"verse":2,"text":"That ye be not soon shaken in mind, or be troubled, neither by spirit, nor by word, nor by letter as from us, as that the day of Christ is at hand.","words":[["That",["G1519"]],["ye",["G5209"]],["be",["G4531"]],["not",["G3361"]],["soon",["G5030"]],["shaken",["G4531"]],["in",["G575"]],["mind,",["G3563"]],["or",["G3383"]],["be troubled,",["G2360"]],["neither",["G3383"]],["by",["G1223"]],["spirit,",["G4151"]],["nor",["G3383"]],["by",["G1223"]],["word,",["G3056"]],["nor",["G3383"]],["by",["G1223"]],["letter",["G1992"]],["as",["G5613"]],["from",["G1223"]],["us,",["G2257"]],["as",["G5613"]],["that",["G3754"]],["the day",["G2250"]],["of Christ",["G5547"]],["is at hand.",["G1764"]]]},{"verse":3,"text":"Let no man deceive you by any means: for that day shall not come, except there come a falling away first, and that man of sin be revealed, the son of perdition;","words":[["Let",["G1818"]],["no",["G3361"]],["man",["G5100"]],["deceive",["G1818"]],["you",["G5209"]],["by",["G2596"]],["any",["G3367"]],["means:",["G5158"]],["for",["G3754"]],["that day shall not come, except",["G3362"]],["there come",["G2064"]],["a falling away",["G646"]],["first,",["G4412"]],["and",["G2532"]],["that man",["G444"]],["of sin",["G266"]],["be revealed,",["G601"]],["the son",["G5207"]],["of perdition;",["G684"]]]},{"verse":4,"text":"Who opposeth and exalteth himself above all that is called God, or that is worshipped; so that he as God sitteth in the temple of God, shewing himself that he is God.","words":[["Who",["G3588"]],["opposeth",["G480"]],["and",["G2532"]],["exalteth",["G5229"]],["himself above",["G1909"]],["all",["G3956"]],["that is called",["G3004"]],["God,",["G2316"]],["or",["G2228"]],["that is worshipped;",["G4574"]],["so",["G5620"]],["that he",["G846"]],["as",["G5613"]],["God",["G2316"]],["sitteth",["G2523"]],["in",["G1519"]],["the temple",["G3485"]],["of God,",["G2316"]],["shewing",["G584"]],["himself",["G1438"]],["that",["G3754"]],["he is",["G2076"]],["God.",["G2316"]]]},{"verse":5,"text":"Remember ye not, that, when I was yet with you, I told you these things?","words":[["Remember ye",["G3421"]],["not,",["G3756"]],["that,",["G3754"]],["when I was",["G5607"]],["yet",["G2089"]],["with",["G4314"]],["you,",["G5209"]],["I told",["G3004"]],["you",["G5213"]],["these things?",["G5023"]]]},{"verse":6,"text":"And now ye know what withholdeth that he might be revealed in his time.","words":[["And",["G2532"]],["now",["G3568"]],["ye know",["G1492"]],["what withholdeth",["G2722"]],["that",["G1519"]],["he",["G846"]],["might be revealed",["G601"]],["in",["G1722"]],["his",["G1438"]],["time.",["G2540"]]]},{"verse":7,"text":"For the mystery of iniquity doth already work: only he who now letteth will let, until he be taken out of the way.","words":[["For",["G1063"]],["the mystery",["G3466"]],["of iniquity",["G458"]],["doth",["G1754"]],["already",["G2235"]],["work:",["G1754"]],["only",["G3440"]],["he who now",["G737"]],["letteth",["G2722"]],["will let, until",["G2193"]],["he be taken",["G1096"]],["out of",["G1537"]],["the way.",["G3319"]]]},{"verse":8,"text":"And then shall that Wicked be revealed, whom the Lord shall consume with the spirit of his mouth, and shall destroy with the brightness of his coming:","words":[["And",["G2532"]],["then",["G5119"]],["shall",["G601"]],["that Wicked",["G459"]],["be revealed,",["G601"]],["whom",["G3739"]],["the Lord",["G2962"]],["shall consume",["G355"]],["with the spirit",["G4151"]],["of his",["G846"]],["mouth,",["G4750"]],["and",["G2532"]],["shall destroy",["G2673"]],["with the brightness",["G2015"]],["of his",["G846"]],["coming:",["G3952"]]]},{"verse":9,"text":"Even him, whose coming is after the working of Satan with all power and signs and lying wonders,","words":[["Even him, whose",["G3739"]],["coming",["G3952"]],["is",["G2076"]],["after",["G2596"]],["the working",["G1753"]],["of Satan",["G4567"]],["with",["G1722"]],["all",["G3956"]],["power",["G1411"]],["and",["G2532"]],["signs",["G4592"]],["and",["G2532"]],["lying",["G5579"]],["wonders,",["G5059"]]]},{"verse":10,"text":"And with all deceivableness of unrighteousness in them that perish; because they received not the love of the truth, that they might be saved.","words":[["And",["G2532"]],["with",["G1722"]],["all",["G3956"]],["deceivableness",["G539"]],["of unrighteousness",["G93"]],["in",["G1722"]],["them that perish;",["G622"]],["because",["G473","G3739"]],["they received",["G1209"]],["not",["G3756"]],["the love",["G26"]],["of the truth,",["G225"]],["that",["G1519"]],["they",["G846"]],["might be saved.",["G4982"]]]},{"verse":11,"text":"And for this cause God shall send them strong delusion, that they should believe a lie:","words":[["And",["G2532"]],["for this",["G5124"]],["cause",["G1223"]],["God",["G2316"]],["shall send",["G3992"]],["them",["G846"]],["strong",["G1753"]],["delusion,",["G4106"]],["that",["G1519"]],["they",["G846"]],["should believe",["G4100"]],["a lie:",["G5579"]]]},{"verse":12,"text":"That they all might be damned who believed not the truth, but had pleasure in unrighteousness.","words":[["That",["G2443"]],["they all",["G3956"]],["might be damned",["G2919"]],["who",["G3588"]],["believed",["G4100"]],["not",["G3361"]],["the truth,",["G225"]],["but",["G235"]],["had pleasure",["G2106"]],["in",["G1722"]],["unrighteousness.",["G93"]]]},{"verse":13,"text":"But we are bound to give thanks alway to God for you, brethren beloved of the Lord, because God hath from the beginning chosen you to salvation through sanctification of the Spirit and belief of the truth:","words":[["But",["G1161"]],["we",["G2249"]],["are bound",["G3784"]],["to give thanks",["G2168"]],["alway",["G3842"]],["to God",["G2316"]],["for",["G4012"]],["you,",["G5216"]],["brethren",["G80"]],["beloved",["G25"]],["of",["G5259"]],["the Lord,",["G2962"]],["because",["G3754"]],["God",["G2316"]],["hath",["G138"]],["from",["G575"]],["the beginning",["G746"]],["chosen",["G138"]],["you",["G5209"]],["to",["G1519"]],["salvation",["G4991"]],["through",["G1722"]],["sanctification",["G38"]],["of the Spirit",["G4151"]],["and",["G2532"]],["belief",["G4102"]],["of the truth:",["G225"]]]},{"verse":14,"text":"Whereunto he called you by our gospel, to the obtaining of the glory of our Lord Jesus Christ.","words":[["Whereunto",["G1519","G3739"]],["he called",["G2564"]],["you",["G5209"]],["by",["G1223"]],["our",["G2257"]],["gospel,",["G2098"]],["to",["G1519"]],["the obtaining",["G4047"]],["of the glory",["G1391"]],["of our",["G2257"]],["Lord",["G2962"]],["Jesus",["G2424"]],["Christ.",["G5547"]]]},{"verse":15,"text":"Therefore, brethren, stand fast, and hold the traditions which ye have been taught, whether by word, or our epistle.","words":[["Therefore,",["G686","G3767"]],["brethren,",["G80"]],["stand fast,",["G4739"]],["and",["G2532"]],["hold",["G2902"]],["the traditions",["G3862"]],["which",["G3739"]],["ye have been taught,",["G1321"]],["whether",["G1535"]],["by",["G1223"]],["word,",["G3056"]],["or",["G1535","G1223"]],["our",["G2257"]],["epistle.",["G1992"]]]},{"verse":16,"text":"Now our Lord Jesus Christ himself, and God, even our Father, which hath loved us, and hath given us everlasting consolation and good hope through grace,","words":[["Now",["G1161"]],["our",["G2257"]],["Lord",["G2962"]],["Jesus",["G2424"]],["Christ",["G5547"]],["himself,",["G846"]],["and",["G2532"]],["God,",["G2316"]],["even",["G2532"]],["our",["G2257"]],["Father,",["G3962"]],["which",["G3588"]],["hath loved",["G25"]],["us,",["G2248"]],["and",["G2532"]],["hath given",["G1325"]],["us everlasting",["G166"]],["consolation",["G3874"]],["and",["G2532"]],["good",["G18"]],["hope",["G1680"]],["through",["G1722"]],["grace,",["G5485"]]]},{"verse":17,"text":"Comfort your hearts, and stablish you in every good word and work.","words":[["Comfort",["G3870"]],["your",["G5216"]],["hearts,",["G2588"]],["and",["G2532"]],["stablish",["G4741"]],["you",["G5209"]],["in",["G1722"]],["every",["G3956"]],["good",["G18"]],["word",["G3056"]],["and",["G2532"]],["work.",["G2041"]]]}]}