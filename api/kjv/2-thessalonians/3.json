{"book":"2 Thessalonians","chapter":3,"translation":"KJV","url":"/bible/2-thessalonians/3","verses":[{"verse":1,"text":"Finally, brethren, pray for us, that the word of the Lord may have free course, and be glorified, even as it is with you:","words":[["Finally,",["G3063"]],["brethren,",["G80"]],["pray",["G4336"]],["for",["G4012"]],["us,",["G2257"]],["that",["G2443"]],["the word",["G3056"]],["of the Lord",["G2962"]],["may have free course,",["G5143"]],["and",["G2532"]],["be glorified,",["G1392"]],["even",["G2532"]],["as",["G2531"]],["it is with",["G4314"]],["you:",["G5209"]]]},{"verse":2,"text":"And that we may be delivered from unreasonable and wicked men: for all men have not faith.","words":[["And",["G2532"]],["that",["G2443"]],["we may be delivered",["G4506"]],["from",["G575"]],["unreasonable",["G824"]],["and",["G2532"]],["wicked",["G4190"]],["men:",["G444"]],["for",["G1063"]],["all",["G3956"]],["men have not",["G3756"]],["faith.",["G4102"]]]},{"verse":3,"text":"But the Lord is faithful, who shall stablish you, and keep you from evil.","words":[["But",["G1161"]],["the Lord",["G2962"]],["is",["G2076"]],["faithful,",["G4103"]],["who",["G3739"]],["shall stablish",["G4741"]],["you,",["G5209"]],["and",["G2532"]],["keep",["G5442"]],["you from",["G575"]],["evil.",["G4190"]]]},{"verse":4,"text":"And we have confidence in the Lord touching you, that ye both do and will do the things which we command you.","words":[["And",["G1161"]],["we have confidence",["G3982"]],["in",["G1722"]],["the Lord",["G2962"]],["touching",["G1909"]],["you,",["G5209"]],["that",["G3754"]],["ye both",["G2532"]],["do",["G4160"]],["and",["G2532"]],["will do",["G4160"]],["the things which",["G3739"]],["we command",["G3853"]],["you.",["G5213"]]]},{"verse":5,"text":"And the Lord direct your hearts into the love of God, and into the patient waiting for Christ.","words":[["And",["G1161"]],["the Lord",["G2962"]],["direct",["G2720"]],["your",["G5216"]],["hearts",["G2588"]],["into",["G1519"]],["the love",["G26"]],["of God,",["G2316"]],["and",["G2532"]],["into",["G1519"]],["the patient waiting",["G5281"]],["for Christ.",["G5547"]]]},{"verse":6,"text":"Now we command you, brethren, in the name of our Lord Jesus Christ, that ye withdraw yourselves from every brother that walketh disorderly, and not after the tradition which he received of us.","words":[["Now",["G1161"]],["we command",["G3853"]],["you,",["G5213"]],["brethren,",["G80"]],["in",["G1722"]],["the name",["G3686"]],["of our",["G2257"]],["Lord",["G2962"]],["Jesus",["G2424"]],["Christ,",["G5547"]],["that ye withdraw",["G4724"]],["yourselves",["G5209"]],["from",["G575"]],["every",["G3956"]],["brother",["G80"]],["that walketh",["G4043"]],["disorderly,",["G814"]],["and",["G2532"]],["not",["G3361"]],["after",["G2596"]],["the tradition",["G3862"]],["which",["G3739"]],["he received",["G3880"]],["of",["G3844"]],["us.",["G2257"]]]},{"verse":7,"text":"For yourselves know how ye ought to follow us: for we behaved not ourselves disorderly among you;","words":[["For",["G1063"]],["yourselves",["G846"]],["know",["G1492"]],["how",["G4459"]],["ye ought",["G1163"]],["to follow",["G3401"]],["us:",["G2248"]],["for",["G3754"]],["we behaved",["G812"]],["not",["G3756"]],["ourselves disorderly",["G812"]],["among",["G1722"]],["you;",["G5213"]]]},{"verse":8,"text":"Neither did we eat any man’s bread for nought; but wrought with labour and travail night and day, that we might not be chargeable to any of you:","words":[["Neither",["G3761"]],["did we eat",["G5315"]],["any man’s bread",["G740"]],["for nought;",["G1432"]],["but",["G235"]],["wrought",["G2038"]],["with",["G1722"]],["labour",["G2873"]],["and",["G2532"]],["travail",["G3449"]],["night",["G3571"]],["and",["G2532"]],["day,",["G2250"]],["that",["G4314"]],["we might",["G1912"]],["not",["G3361"]],["be chargeable",["G1912"]],["to any",["G5100"]],["of you:",["G5216"]]]},{"verse":9,"text":"Not because we have not power, but to make ourselves an ensample unto you to follow us.","words":[["Not",["G3756"]],["because",["G3754"]],["we have",["G2192"]],["not",["G3756"]],["power,",["G1849"]],["but",["G235"]],["to",["G2443"]],["make",["G1325"]],["ourselves",["G1438"]],["an ensample",["G5179"]],["unto you",["G5213"]],["to",["G1519"]],["follow",["G3401"]],["us.",["G2248"]]]},{"verse":10,"text":"For even when we were with you, this we commanded you, that if any would not work, neither should he eat.","words":[["For",["G1063"]],["even",["G2532"]],["when",["G3753"]],["we were",["G2258"]],["with",["G4314"]],["you,",["G5209"]],["this",["G5124"]],["we commanded",["G3853"]],["you,",["G5213"]],["that",["G3754"]],["if any",["G1536"]],["would",["G2309"]],["not",["G3756"]],["work,",["G2038"]],["neither",["G3366"]],["should he eat.",["G2068"]]]},{"verse":11,"text":"For we hear that there are some which walk among you disorderly, working not at all, but are busybodies.","words":[["For",["G1063"]],["we hear",["G191"]],["that there are some",["G5100"]],["which walk",["G4043"]],["among",["G1722"]],["you",["G5213"]],["disorderly,",["G814"]],["working",["G2038"]],["not at all,",["G3367"]],["but",["G235"]],["are busybodies.",["G4020"]]]},{"verse":12,"text":"Now them that are such we command and exhort by our Lord Jesus Christ, that with quietness they work, and eat their own bread.","words":[["Now",["G1161"]],["them that are such",["G5108"]],["we command",["G3853"]],["and",["G2532"]],["exhort",["G3870"]],["by",["G1223"]],["our",["G2257"]],["Lord",["G2962"]],["Jesus",["G2424"]],["Christ,",["G5547"]],["that",["G2443"]],["with",["G3326"]],["quietness",["G2271"]],["they work,",["G2038"]],["and eat",["G2068"]],["their own",["G1438"]],["bread.",["G740"]]]},{"verse":13,"text":"But ye, brethren, be not weary in well doing.","words":[["But",["G1161"]],["ye,",["G5210"]],["brethren,",["G80"]],["be",["G1573"]],["not",["G3361"]],["weary",["G1573"]],["in well doing.",["G2569"]]]},{"verse":14,"text":"And if any man obey not our word by this epistle, note that man, and have no company with him, that he may be ashamed.","words":[["And",["G1161"]],["if any man",["G1536"]],["obey",["G5219"]],["not",["G3756"]],["our",["G2257"]],["word",["G3056"]],["by",["G1223"]],["this epistle,",["G1992"]],["note",["G4593"]],["that",["G5126"]],["man, and",["G2532"]],["have",["G4874"]],["no",["G3361"]],["company with",["G4874"]],["him,",["G846"]],["that",["G2443"]],["he may be ashamed.",["G1788"]]]},{"verse":15,"text":"Yet count him not as an enemy, but admonish him as a brother.","words":[["Yet",["G2532"]],["count",["G2233"]],["him not",["G3361"]],["as",["G5613"]],["an enemy,",["G2190"]],["but",["G235"]],["admonish",["G3560"]],["him as",["G5613"]],["a brother.",["G80"]]]},{"verse":16,"text":"Now the Lord of peace himself give you peace always by all means. The Lord be with you all.","words":[["Now",["G1161"]],["the Lord",["G2962"]],["of peace",["G1515"]],["himself",["G846"]],["give",["G1325"]],["you",["G5213"]],["peace",["G1515"]],["always",["G1223","G3956"]],["by",["G1722"]],["all",["G3956"]],["means.",["G5158"]],["The Lord",["G2962"]],["be with",["G3326"]],["you",["G5216"]],["all.",["G3956"]]]},{"verse":17,"text":"The salutation of Paul with mine own hand, which is the token in every epistle: so I write.","words":[["The salutation",["G783"]],["of Paul",["G3972"]],["with mine own",["G1699"]],["hand,",["G5495"]],["which",["G3739"]],["is",["G2076"]],["the token",["G4592"]],["in",["G1722"]],["every",["G3956"]],["epistle:",["G1992"]],["so",["G3779"]],["I write.",["G1125"]]]},{"verse":18,"text":"The grace of our Lord Jesus Christ be with you all. Amen. The second epistle to the Thessalonians was written from Athens.","words":[["The grace",["G5485"]],["of our",["G2257"]],["Lord",["G2962"]],["Jesus",["G2424"]],["Christ",["G5547"]],["be with",["G3326"]],["you",["G5216"]],["all.",["G3956"]],["Amen.",["G281"]],["The second epistle to the Thessalonians was written from Athens.",[]]]}]}