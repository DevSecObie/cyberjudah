{"book":"1 Thessalonians","chapter":5,"translation":"KJV","url":"/bible/1-thessalonians/5","verses":[{"verse":1,"text":"But of the times and the seasons, brethren, ye have no need that I write unto you.","words":[["But",["G1161"]],["of",["G4012"]],["the times",["G5550"]],["and",["G2532"]],["the seasons,",["G2540"]],["brethren,",["G80"]],["ye have",["G2192"]],["no",["G3756"]],["need",["G5532"]],["that I write",["G1125"]],["unto you.",["G5213"]]]},{"verse":2,"text":"For yourselves know perfectly that the day of the Lord so cometh as a thief in the night.","words":[["For",["G1063"]],["yourselves",["G846"]],["know",["G1492"]],["perfectly",["G199"]],["that",["G3754"]],["the day",["G2250"]],["of the Lord",["G2962"]],["so",["G3779"]],["cometh",["G2064"]],["as",["G5613"]],["a thief",["G2812"]],["in",["G1722"]],["the night.",["G3571"]]]},{"verse":3,"text":"For when they shall say, Peace and safety; then sudden destruction cometh upon them, as travail upon a woman with child; and they shall not escape.","words":[["For",["G1063"]],["when",["G3752"]],["they shall say,",["G3004"]],["Peace",["G1515"]],["and",["G2532"]],["safety;",["G803"]],["then",["G5119"]],["sudden",["G160"]],["destruction",["G3639"]],["cometh upon",["G2186"]],["them,",["G846"]],["as",["G5618"]],["travail",["G5604"]],["upon",["G1722"]],["a woman with child;",["G1064","G2192"]],["and",["G2532"]],["they shall",["G1628"]],["not",["G3364"]],["escape.",["G1628"]]]},{"verse":4,"text":"But ye, brethren, are not in darkness, that that day should overtake you as a thief.","words":[["But",["G1161"]],["ye,",["G5210"]],["brethren,",["G80"]],["are",["G2075"]],["not",["G3756"]],["in",["G1722"]],["darkness,",["G4655"]],["that",["G2443"]],["that day",["G2250"]],["should overtake",["G2638"]],["you",["G5209"]],["as",["G5613"]],["a thief.",["G2812"]]]},{"verse":5,"text":"Ye are all the children of light, and the children of the day: we are not of the night, nor of darkness.","words":[["Ye",["G5210"]],["are",["G2075"]],["all",["G3956"]],["the children",["G5207"]],["of light,",["G5457"]],["and",["G2532"]],["the children",["G5207"]],["of the day:",["G2250"]],["we are",["G2070"]],["not",["G3756"]],["of the night,",["G3571"]],["nor",["G3761"]],["of darkness.",["G4655"]]]},{"verse":6,"text":"Therefore let us not sleep, as do others; but let us watch and be sober.","words":[["Therefore",["G686","G3767"]],["let us",["G2518"]],["not",["G3361"]],["sleep,",["G2518"]],["as",["G5613","G2532"]],["do others;",["G3062"]],["but",["G235"]],["let us watch",["G1127"]],["and",["G2532"]],["be sober.",["G3525"]]]},{"verse":7,"text":"For they that sleep sleep in the night; and they that be drunken are drunken in the night.","words":[["For",["G1063"]],["they that sleep",["G2518"]],["sleep",["G2518"]],["in the night;",["G3571"]],["and",["G2532"]],["they that be drunken",["G3182"]],["are drunken",["G3184"]],["in the night.",["G3571"]]]},{"verse":8,"text":"But let us, who are of the day, be sober, putting on the breastplate of faith and love; and for an helmet, the hope of salvation.","words":[["But",["G1161"]],["let",["G3525"]],["us,",["G2249"]],["who are",["G5607"]],["of the day,",["G2250"]],["be sober,",["G3525"]],["putting on",["G1746"]],["the breastplate",["G2382"]],["of faith",["G4102"]],["and",["G2532"]],["love;",["G26"]],["and",["G2532"]],["for an helmet,",["G4030"]],["the hope",["G1680"]],["of salvation.",["G4991"]]]},{"verse":9,"text":"For God hath not appointed us to wrath, but to obtain salvation by our Lord Jesus Christ,","words":[["For",["G3754"]],["God",["G2316"]],["hath",["G5087"]],["not",["G3756"]],["appointed",["G5087"]],["us",["G2248"]],["to",["G1519"]],["wrath,",["G3709"]],["but",["G235"]],["to",["G1519"]],["obtain",["G4047"]],["salvation",["G4991"]],["by",["G1223"]],["our",["G2257"]],["Lord",["G2962"]],["Jesus",["G2424"]],["Christ,",["G5547"]]]},{"verse":10,"text":"Who died for us, that, whether we wake or sleep, we should live together with him.","words":[["Who",["G3588"]],["died",["G599"]],["for",["G5228"]],["us,",["G2257"]],["that,",["G2443"]],["whether",["G1535"]],["we wake",["G1127"]],["or",["G1535"]],["sleep,",["G2518"]],["we should live",["G2198"]],["together",["G260"]],["with",["G4862"]],["him.",["G846"]]]},{"verse":11,"text":"Wherefore comfort yourselves together, and edify one another, even as also ye do.","words":[["Wherefore",["G1352"]],["comfort",["G3870"]],["yourselves together,",["G240"]],["and",["G2532"]],["edify",["G3618"]],["one",["G1520"]],["another,",["G1520"]],["even",["G2531"]],["as also",["G2532"]],["ye do.",["G4160"]]]},{"verse":12,"text":"And we beseech you, brethren, to know them which labour among you, and are over you in the Lord, and admonish you;","words":[["And",["G1161"]],["we beseech",["G2065"]],["you,",["G5209"]],["brethren,",["G80"]],["to know",["G1492"]],["them which",["G3588"]],["labour",["G2872"]],["among",["G1722"]],["you,",["G5213"]],["and",["G2532"]],["are over",["G4291"]],["you",["G5216"]],["in",["G1722"]],["the Lord,",["G2962"]],["and",["G2532"]],["admonish",["G3560"]],["you;",["G5209"]]]},{"verse":13,"text":"And to esteem them very highly in love for their work’s sake. And be at peace among yourselves.","words":[["And",["G2532"]],["to esteem",["G2233"]],["them",["G846"]],["very",["G5228"]],["highly",["G1537","G4053"]],["in",["G1722"]],["love",["G26"]],["for",["G1223"]],["their",["G846"]],["work’s sake.",["G2041"]],["And be at peace",["G1514"]],["among",["G1722"]],["yourselves.",["G1438"]]]},{"verse":14,"text":"Now we exhort you, brethren, warn them that are unruly, comfort the feebleminded, support the weak, be patient toward all men.","words":[["Now",["G1161"]],["we exhort",["G3870"]],["you,",["G5209"]],["brethren,",["G80"]],["warn",["G3560"]],["them that are unruly,",["G813"]],["comfort",["G3888"]],["the feebleminded,",["G3642"]],["support",["G472"]],["the weak,",["G772"]],["be patient",["G3114"]],["toward",["G4314"]],["all",["G3956"]],["men.",[]]]},{"verse":15,"text":"See that none render evil for evil unto any man; but ever follow that which is good, both among yourselves, and to all men.","words":[["See",["G3708"]],["that none",["G3361","G5100"]],["render",["G591"]],["evil",["G2556"]],["for",["G473"]],["evil",["G2556"]],["unto any",["G5100"]],["man; but",["G235"]],["ever",["G3842"]],["follow",["G1377"]],["that which",["G3588"]],["is good,",["G18"]],["both",["G2532"]],["among",["G1519"]],["yourselves,",["G240"]],["and",["G2532"]],["to",["G1519"]],["all",["G3956"]],["men.",[]]]},{"verse":16,"text":"Rejoice evermore.","words":[["Rejoice",["G5463"]],["evermore.",["G3842"]]]},{"verse":17,"text":"Pray without ceasing.","words":[["Pray",["G4336"]],["without ceasing.",["G89"]]]},{"verse":18,"text":"In every thing give thanks: for this is the will of God in Christ Jesus concerning you.","words":[["In",["G1722"]],["every thing",["G3956"]],["give thanks:",["G2168"]],["for",["G1063"]],["this",["G5124"]],["is the will",["G2307"]],["of God",["G2316"]],["in",["G1722"]],["Christ",["G5547"]],["Jesus",["G2424"]],["concerning",["G1519"]],["you.",["G5209"]]]},{"verse":19,"text":"Quench not the Spirit.","words":[["Quench",["G4570"]],["not",["G3361"]],["the Spirit.",["G4151"]]]},{"verse":20,"text":"Despise not prophesyings.","words":[["Despise",["G1848"]],["not",["G3361"]],["prophesyings.",["G4394"]]]},{"verse":21,"text":"Prove all things; hold fast that which is good.","words":[["Prove",["G1381"]],["all things;",["G3956"]],["hold fast",["G2722"]],["that which",["G3588"]],["is good.",["G2570"]]]},{"verse":22,"text":"Abstain from all appearance of evil.","words":[["Abstain",["G567"]],["from",["G575"]],["all",["G3956"]],["appearance",["G1491"]],["of evil.",["G4190"]]]},{"verse":23,"text":"And the very God of peace sanctify you wholly; and I pray God your whole spirit and soul and body be preserved blameless unto the coming of our Lord Jesus Christ.","words":[["And",["G1161"]],["the very",["G846"]],["God",["G2316"]],["of peace",["G1515"]],["sanctify",["G37"]],["you",["G5209"]],["wholly;",["G3651"]],["and",["G2532"]],["I pray God your",["G5216"]],["whole",["G3648"]],["spirit",["G4151"]],["and",["G2532"]],["soul",["G5590"]],["and",["G2532"]],["body",["G4983"]],["be preserved",["G5083"]],["blameless",["G274"]],["unto",["G1722"]],["the coming",["G3952"]],["of our",["G2257"]],["Lord",["G2962"]],["Jesus",["G2424"]],["Christ.",["G5547"]]]},{"verse":24,"text":"Faithful is he that calleth you, who also will do it.","words":[["Faithful",["G4103"]],["is he that calleth",["G2564"]],["you,",["G5209"]],["who",["G3739"]],["also",["G2532"]],["will do",["G4160"]],["it.",[]]]},{"verse":25,"text":"Brethren, pray for us.","words":[["Brethren,",["G80"]],["pray",["G4336"]],["for",["G4012"]],["us.",["G2257"]]]},{"verse":26,"text":"Greet all the brethren with an holy kiss.","words":[["Greet",["G782"]],["all",["G3956"]],["the brethren",["G80"]],["with",["G1722"]],["an holy",["G40"]],["kiss.",["G5370"]]]},{"verse":27,"text":"I charge you by the Lord that this epistle be read unto all the holy brethren.","words":[["I charge",["G3726"]],["you",["G5209"]],["by the Lord",["G2962"]],["that this epistle",["G1992"]],["be read",["G314"]],["unto all",["G3956"]],["the holy",["G40"]],["brethren.",["G80"]]]},{"verse":28,"text":"The grace of our Lord Jesus Christ be with you. Amen. The first epistle unto the Thessalonians was written from Athens.","words":[["The grace",["G5485"]],["of our",["G2257"]],["Lord",["G2962"]],["Jesus",["G2424"]],["Christ",["G5547"]],["be with",["G3326"]],["you.",["G5216"]],["Amen.",["G281"]],["The first epistle unto the Thessalonians was written from Athens.",[]]]}]}