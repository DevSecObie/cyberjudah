{"book":"1 Corinthians","chapter":15,"translation":"KJV","url":"/bible/1-corinthians/15","verses":[{"verse":1,"text":"Moreover, brethren, I declare unto you the gospel which I preached unto you, which also ye have received, and wherein ye stand;","words":[["Moreover,",["G1161"]],["brethren,",["G80"]],["I declare",["G1107"]],["unto you",["G5213"]],["the gospel",["G2098"]],["which",["G3739"]],["I preached",["G2097"]],["unto you,",["G5213"]],["which",["G3739"]],["also",["G2532"]],["ye have received,",["G3880"]],["and",["G2532"]],["wherein",["G1722","G3739"]],["ye stand;",["G2476"]]]},{"verse":2,"text":"By which also ye are saved, if ye keep in memory what I preached unto you, unless ye have believed in vain.","words":[["By",["G1223"]],["which",["G3739"]],["also",["G2532"]],["ye are saved,",["G4982"]],["if",["G1487"]],["ye keep",["G2722"]],["in memory what",["G5101","G3056"]],["I preached",["G2097"]],["unto you,",["G5213"]],["unless",["G1622","G1508"]],["ye have believed",["G4100"]],["in vain.",["G1500"]]]},{"verse":3,"text":"For I delivered unto you first of all that which I also received, how that Christ died for our sins according to the scriptures;","words":[["For",["G1063"]],["I delivered",["G3860"]],["unto you",["G5213"]],["first of all",["G1722","G4413"]],["that which",["G3739"]],["I",["G3880"]],["also",["G2532"]],["received,",["G3880"]],["how",["G3754"]],["that Christ",["G5547"]],["died",["G599"]],["for",["G5228"]],["our",["G2257"]],["sins",["G266"]],["according",["G2596"]],["to the scriptures;",["G1124"]]]},{"verse":4,"text":"And that he was buried, and that he rose again the third day according to the scriptures:","words":[["And",["G2532"]],["that",["G3754"]],["he was buried,",["G2290"]],["and",["G2532"]],["that",["G3754"]],["he rose again",["G1453"]],["the third",["G5154"]],["day",["G2250"]],["according",["G2596"]],["to the scriptures:",["G1124"]]]},{"verse":5,"text":"And that he was seen of Cephas, then of the twelve:","words":[["And",["G2532"]],["that",["G3754"]],["he was seen",["G3700"]],["of Cephas,",["G2786"]],["then",["G1534"]],["of the twelve:",["G1427"]]]},{"verse":6,"text":"After that, he was seen of above five hundred brethren at once; of whom the greater part remain unto this present, but some are fallen asleep.","words":[["After that,",["G1899"]],["he was seen",["G3700"]],["of above",["G1883"]],["five hundred",["G4001"]],["brethren",["G80"]],["at once;",["G2178"]],["of",["G1537"]],["whom",["G3739"]],["the greater part",["G4119"]],["remain",["G3306"]],["unto",["G2193"]],["this present,",["G737"]],["but",["G1161"]],["some",["G5100","G2532"]],["are fallen asleep.",["G2837"]]]},{"verse":7,"text":"After that, he was seen of James; then of all the apostles.","words":[["After that,",["G1899"]],["he was seen",["G3700"]],["of James;",["G2385"]],["then",["G1534"]],["of all",["G3956"]],["the apostles.",["G652"]]]},{"verse":8,"text":"And last of all he was seen of me also, as of one born out of due time.","words":[["And",["G1161"]],["last",["G2078"]],["of all",["G3956"]],["he was seen",["G3700"]],["of me also,",["G2504"]],["as",["G5619"]],["of one born out of due time.",["G1626"]]]},{"verse":9,"text":"For I am the least of the apostles, that am not meet to be called an apostle, because I persecuted the church of God.","words":[["For",["G1063"]],["I",["G1473"]],["am",["G1510"]],["the least",["G1646"]],["of the apostles,",["G652"]],["that",["G3739"]],["am",["G1510"]],["not",["G3756"]],["meet",["G2425"]],["to be called",["G2564"]],["an apostle,",["G652"]],["because",["G1360"]],["I persecuted",["G1377"]],["the church",["G1577"]],["of God.",["G2316"]]]},{"verse":10,"text":"But by the grace of God I am what I am: and his grace which was bestowed upon me was not in vain; but I laboured more abundantly than they all: yet not I, but the grace of God which was with me.","words":[["But",["G1161"]],["by the grace",["G5485"]],["of God",["G2316"]],["I am",["G1510"]],["what",["G3739"]],["I am:",["G1510"]],["and",["G2532"]],["his",["G846"]],["grace",["G5485"]],["which was bestowed upon",["G1519"]],["me",["G1691"]],["was",["G1096"]],["not",["G3756"]],["in vain;",["G2756"]],["but",["G235"]],["I laboured",["G2872"]],["more abundantly",["G4054"]],["than they",["G846"]],["all:",["G3956"]],["yet",["G1161"]],["not",["G3756"]],["I,",["G1473"]],["but",["G235"]],["the grace",["G5485"]],["of God",["G2316"]],["which",["G3588"]],["was with",["G4862"]],["me.",["G1698"]]]},{"verse":11,"text":"Therefore whether it were I or they, so we preach, and so ye believed.","words":[["Therefore",["G3767"]],["whether",["G1535"]],["it were I",["G1473"]],["or",["G1535"]],["they,",["G1565"]],["so",["G3779"]],["we preach,",["G2784"]],["and",["G2532"]],["so",["G3779"]],["ye believed.",["G4100"]]]},{"verse":12,"text":"Now if Christ be preached that he rose from the dead, how say some among you that there is no resurrection of the dead?","words":[["Now",["G1161"]],["if",["G1487"]],["Christ",["G5547"]],["be preached",["G2784"]],["that",["G3754"]],["he rose",["G1453"]],["from",["G1537"]],["the dead,",["G3498"]],["how",["G4459"]],["say",["G3004"]],["some",["G5100"]],["among",["G1722"]],["you",["G5213"]],["that",["G3754"]],["there is",["G2076"]],["no",["G3756"]],["resurrection",["G386"]],["of the dead?",["G3498"]]]},{"verse":13,"text":"But if there be no resurrection of the dead, then is Christ not risen:","words":[["But",["G1161"]],["if",["G1487"]],["there be",["G2076"]],["no",["G3756"]],["resurrection",["G386"]],["of the dead,",["G3498"]],["then",["G3761"]],["is",["G1453"]],["Christ",["G5547"]],["not",["G3761"]],["risen:",["G1453"]]]},{"verse":14,"text":"And if Christ be not risen, then is our preaching vain, and your faith is also vain.","words":[["And",["G1161"]],["if",["G1487"]],["Christ",["G5547"]],["be",["G1453"]],["not",["G3756"]],["risen,",["G1453"]],["then",["G686"]],["is our",["G2257"]],["preaching",["G2782"]],["vain,",["G2756"]],["and",["G2532"]],["your",["G5216"]],["faith",["G4102"]],["is",["G1161"]],["also",["G2532"]],["vain.",["G2756"]]]},{"verse":15,"text":"Yea, and we are found false witnesses of God; because we have testified of God that he raised up Christ: whom he raised not up, if so be that the dead rise not.","words":[["Yea,",["G1161"]],["and",["G2532"]],["we are found",["G2147"]],["false witnesses",["G5575"]],["of God;",["G2316"]],["because",["G3754"]],["we have testified",["G3140"]],["of",["G2596"]],["God",["G2316"]],["that",["G3754"]],["he raised up",["G1453"]],["Christ:",["G5547"]],["whom",["G3739"]],["he raised",["G1453"]],["not",["G3756"]],["up,",["G1453"]],["if",["G1512"]],["so be",["G686"]],["that the dead",["G3498"]],["rise",["G1453"]],["not.",["G3756"]]]},{"verse":16,"text":"For if the dead rise not, then is not Christ raised:","words":[["For",["G1063"]],["if",["G1487"]],["the dead",["G3498"]],["rise",["G1453"]],["not,",["G3756"]],["then is",["G1453"]],["not",["G3761"]],["Christ",["G5547"]],["raised:",["G1453"]]]},{"verse":17,"text":"And if Christ be not raised, your faith is vain; ye are yet in your sins.","words":[["And",["G1161"]],["if",["G1487"]],["Christ",["G5547"]],["be",["G1453"]],["not",["G3756"]],["raised,",["G1453"]],["your",["G5216"]],["faith",["G4102"]],["is vain;",["G3152"]],["ye are",["G2075"]],["yet",["G2089"]],["in",["G1722"]],["your",["G5216"]],["sins.",["G266"]]]},{"verse":18,"text":"Then they also which are fallen asleep in Christ are perished.","words":[["Then",["G686"]],["they also",["G2532"]],["which are fallen asleep",["G2837"]],["in",["G1722"]],["Christ",["G5547"]],["are perished.",["G622"]]]},{"verse":19,"text":"If in this life only we have hope in Christ, we are of all men most miserable.","words":[["If",["G1487"]],["in",["G1722"]],["this",["G5026"]],["life",["G2222"]],["only",["G3440"]],["we have hope",["G1679","G2070"]],["in",["G1722"]],["Christ,",["G5547"]],["we are",["G2070"]],["of all",["G3956"]],["men",["G444"]],["most miserable.",["G1652"]]]},{"verse":20,"text":"But now is Christ risen from the dead, and become the firstfruits of them that slept.","words":[["But",["G1161"]],["now",["G3570"]],["is",["G1453"]],["Christ",["G5547"]],["risen",["G1453"]],["from",["G1537"]],["the dead,",["G3498"]],["and become",["G1096"]],["the firstfruits",["G536"]],["of them that slept.",["G2837"]]]},{"verse":21,"text":"For since by man came death, by man came also the resurrection of the dead.","words":[["For",["G1063"]],["since",["G1894"]],["by",["G1223"]],["man",["G444"]],["came death,",["G2288"]],["by",["G1223"]],["man",["G444"]],["came also",["G2532"]],["the resurrection",["G386"]],["of the dead.",["G3498"]]]},{"verse":22,"text":"For as in Adam all die, even so in Christ shall all be made alive.","words":[["For",["G1063"]],["as",["G5618"]],["in",["G1722"]],["Adam",["G76"]],["all",["G3956"]],["die,",["G599"]],["even",["G2532"]],["so",["G3779"]],["in",["G1722"]],["Christ",["G5547"]],["shall",["G2227"]],["all",["G3956"]],["be made alive.",["G2227"]]]},{"verse":23,"text":"But every man in his own order: Christ the firstfruits; afterward they that are Christ’s at his coming.","words":[["But",["G1161"]],["every man",["G1538"]],["in",["G1722"]],["his own",["G2398"]],["order:",["G5001"]],["Christ",["G5547"]],["the firstfruits;",["G536"]],["afterward",["G1899"]],["they that are",["G3588"]],["Christ’s at",["G1722"]],["his",["G846"]],["coming.",["G3952"]]]},{"verse":24,"text":"Then cometh the end, when he shall have delivered up the kingdom to God, even the Father; when he shall have put down all rule and all authority and power.","words":[["Then",["G1534"]],["cometh the end,",["G5056"]],["when",["G3752"]],["he shall have delivered up",["G3860"]],["the kingdom",["G932"]],["to God,",["G2316"]],["even",["G2532"]],["the Father;",["G3962"]],["when",["G3752"]],["he shall have put down",["G2673"]],["all",["G3956"]],["rule",["G746"]],["and",["G2532"]],["all",["G3956"]],["authority",["G1849"]],["and",["G2532"]],["power.",["G1411"]]]},{"verse":25,"text":"For he must reign, till he hath put all enemies under his feet.","words":[["For",["G1063"]],["he",["G846"]],["must",["G1163"]],["reign,",["G936"]],["till",["G891","G3757"]],["he hath put",["G302","G5087"]],["all",["G3956"]],["enemies",["G2190"]],["under",["G5259"]],["his",["G846"]],["feet.",["G4228"]]]},{"verse":26,"text":"The last enemy that shall be destroyed is death.","words":[["The last",["G2078"]],["enemy",["G2190"]],["that shall be destroyed",["G2673"]],["is death.",["G2288"]]]},{"verse":27,"text":"For he hath put all things under his feet. But when he saith all things are put under him, it is manifest that he is excepted, which did put all things under him.","words":[["For",["G1063"]],["he hath put",["G5293"]],["all things",["G3956"]],["under",["G5259"]],["his",["G846"]],["feet.",["G4228"]],["But",["G1161"]],["when",["G3752"]],["he saith",["G2036","G3754"]],["all things",["G3956"]],["are put under",["G5293"]],["him, it is manifest",["G1212"]],["that",["G3754"]],["he is excepted,",["G1622"]],["which did put",["G5293"]],["all things",["G3956"]],["under",["G5293"]],["him.",["G846"]]]},{"verse":28,"text":"And when all things shall be subdued unto him, then shall the Son also himself be subject unto him that put all things under him, that God may be all in all.","words":[["And",["G1161"]],["when",["G3752"]],["all things",["G3956"]],["shall be subdued",["G5293"]],["unto him,",["G846"]],["then",["G5119"]],["shall",["G5293"]],["the Son",["G5207"]],["also",["G2532"]],["himself",["G846"]],["be subject",["G5293"]],["unto him that put",["G5293"]],["all things",["G3956"]],["under",["G5293"]],["him,",["G846"]],["that",["G2443"]],["God",["G2316"]],["may be",["G5600"]],["all",["G3956"]],["in",["G1722"]],["all.",["G3956"]]]},{"verse":29,"text":"Else what shall they do which are baptized for the dead, if the dead rise not at all? why are they then baptized for the dead?","words":[["Else",["G1893"]],["what",["G5101"]],["shall they do",["G4160"]],["which are baptized",["G907"]],["for",["G5228"]],["the dead,",["G3498"]],["if",["G1487"]],["the dead",["G3498"]],["rise",["G1453"]],["not",["G3756"]],["at all?",["G3654"]],["why",["G5101","G2532"]],["are they then baptized",["G907"]],["for",["G5228"]],["the dead?",["G3498"]]]},{"verse":30,"text":"And why stand we in jeopardy every hour?","words":[["And",["G2532"]],["why",["G5101"]],["stand",["G2793"]],["we",["G2249"]],["in jeopardy",["G2793"]],["every",["G3956"]],["hour?",["G5610"]]]},{"verse":31,"text":"I protest by your rejoicing which I have in Christ Jesus our Lord, I die daily.","words":[["I protest by",["G3513"]],["your",["G5212"]],["rejoicing",["G2251","G2746"]],["which",["G3739"]],["I have",["G2192"]],["in",["G1722"]],["Christ",["G5547"]],["Jesus",["G2424"]],["our",["G2257"]],["Lord,",["G2962"]],["I die",["G599"]],["daily.",["G2596","G2250"]]]},{"verse":32,"text":"If after the manner of men I have fought with beasts at Ephesus, what advantageth it me, if the dead rise not? let us eat and drink; for to morrow we die.","words":[["If",["G1487"]],["after the manner",["G2596"]],["of men",["G444"]],["I have fought with beasts",["G2341"]],["at",["G1722"]],["Ephesus,",["G2181"]],["what",["G5101"]],["advantageth it",["G3786"]],["me,",["G3427"]],["if",["G1487"]],["the dead",["G3498"]],["rise",["G1453"]],["not?",["G3756"]],["let us eat",["G5315"]],["and",["G2532"]],["drink;",["G4095"]],["for",["G1063"]],["to morrow",["G839"]],["we die.",["G599"]]]},{"verse":33,"text":"Be not deceived: evil communications corrupt good manners.","words":[["Be",["G4105"]],["not",["G3361"]],["deceived:",["G4105"]],["evil",["G2556"]],["communications",["G3657"]],["corrupt",["G5351"]],["good",["G5543"]],["manners.",["G2239"]]]},{"verse":34,"text":"Awake to righteousness, and sin not; for some have not the knowledge of God: I speak this to your shame.","words":[["Awake",["G1594"]],["to righteousness,",["G1346"]],["and",["G2532"]],["sin",["G264"]],["not;",["G3361"]],["for",["G1063"]],["some",["G5100"]],["have",["G2192"]],["not the knowledge",["G56"]],["of God:",["G2316"]],["I speak",["G3004"]],["this to",["G4314"]],["your",["G5213"]],["shame.",["G1791"]]]},{"verse":35,"text":"But some man will say, How are the dead raised up? and with what body do they come?","words":[["But",["G235"]],["some",["G5100"]],["man will say,",["G2046"]],["How",["G4459"]],["are",["G1453"]],["the dead",["G3498"]],["raised up?",["G1453"]],["and",["G1161"]],["with what",["G4169"]],["body",["G4983"]],["do they come?",["G2064"]]]},{"verse":36,"text":"Thou fool, that which thou sowest is not quickened, except it die:","words":[["Thou fool,",["G878"]],["that which",["G3739"]],["thou",["G4771"]],["sowest",["G4687"]],["is",["G2227"]],["not",["G3756"]],["quickened,",["G2227"]],["except",["G3362"]],["it die:",["G599"]]]},{"verse":37,"text":"And that which thou sowest, thou sowest not that body that shall be, but bare grain, it may chance of wheat, or of some other grain:","words":[["And",["G2532"]],["that which",["G3739"]],["thou sowest,",["G4687"]],["thou sowest",["G4687"]],["not",["G3756"]],["that body",["G4983"]],["that shall be,",["G1096"]],["but",["G235"]],["bare",["G1131"]],["grain,",["G2848"]],["it may chance",["G1487","G5177"]],["of wheat,",["G4621"]],["or",["G2228"]],["of some",["G5100"]],["other",["G3062"]],["grain:",[]]]},{"verse":38,"text":"But God giveth it a body as it hath pleased him, and to every seed his own body.","words":[["But",["G1161"]],["God",["G2316"]],["giveth",["G1325"]],["it",["G846"]],["a body",["G4983"]],["as",["G2531"]],["it hath pleased him,",["G2309"]],["and",["G2532"]],["to every",["G1538"]],["seed",["G4690"]],["his own",["G2398"]],["body.",["G4983"]]]},{"verse":39,"text":"All flesh is not the same flesh: but there is one kind of flesh of men, another flesh of beasts, another of fishes, and another of birds.","words":[["All",["G3956"]],["flesh",["G4561"]],["is not",["G3756"]],["the same",["G846"]],["flesh:",["G4561"]],["but",["G235","G3303"]],["there is one",["G243"]],["kind of flesh",["G4561"]],["of men,",["G444","G1161"]],["another",["G243"]],["flesh",["G4561"]],["of beasts,",["G2934","G1161"]],["another",["G243"]],["of fishes,",["G2486"]],["and",["G1161"]],["another",["G243"]],["of birds.",["G4421"]]]},{"verse":40,"text":"There are also celestial bodies, and bodies terrestrial: but the glory of the celestial is one, and the glory of the terrestrial is another.","words":[["There are also",["G2532"]],["celestial",["G2032"]],["bodies,",["G4983"]],["and",["G2532"]],["bodies",["G4983"]],["terrestrial:",["G1919"]],["but",["G235","G3303"]],["the glory",["G1391"]],["of the celestial",["G2032"]],["is one,",["G2087"]],["and",["G1161"]],["the glory of the terrestrial",["G1919"]],["is another.",["G2087"]]]},{"verse":41,"text":"There is one glory of the sun, and another glory of the moon, and another glory of the stars: for one star differeth from another star in glory.","words":[["There is one",["G243"]],["glory",["G1391"]],["of the sun,",["G2246"]],["and",["G2532"]],["another",["G243"]],["glory",["G1391"]],["of the moon,",["G4582"]],["and",["G2532"]],["another",["G243"]],["glory",["G1391"]],["of the stars:",["G792"]],["for",["G1063"]],["one star",["G792"]],["differeth from",["G1308"]],["another star",["G792"]],["in",["G1722"]],["glory.",["G1391"]]]},{"verse":42,"text":"So also is the resurrection of the dead. It is sown in corruption; it is raised in incorruption:","words":[["So",["G3779"]],["also",["G2532"]],["is the resurrection",["G386"]],["of the dead.",["G3498"]],["It is sown",["G4687"]],["in",["G1722"]],["corruption;",["G5356"]],["it is raised",["G1453"]],["in",["G1722"]],["incorruption:",["G861"]]]},{"verse":43,"text":"It is sown in dishonour; it is raised in glory: it is sown in weakness; it is raised in power:","words":[["It is sown",["G4687"]],["in",["G1722"]],["dishonour;",["G819"]],["it is raised",["G1453"]],["in",["G1722"]],["glory:",["G1391"]],["it is sown",["G4687"]],["in",["G1722"]],["weakness;",["G769"]],["it is raised",["G1453"]],["in",["G1722"]],["power:",["G1411"]]]},{"verse":44,"text":"It is sown a natural body; it is raised a spiritual body. There is a natural body, and there is a spiritual body.","words":[["It is sown",["G4687"]],["a natural",["G5591"]],["body;",["G4983"]],["it is raised",["G1453"]],["a spiritual",["G4152"]],["body.",["G4983"]],["There is",["G2076"]],["a natural",["G5591"]],["body,",["G4983"]],["and",["G2532"]],["there is",["G2076"]],["a spiritual",["G4152"]],["body.",["G4983"]]]},{"verse":45,"text":"And so it is written, The first man Adam was made a living soul; the last Adam was made a quickening spirit.","words":[["And",["G2532"]],["so",["G3779"]],["it is written,",["G1125"]],["The first",["G4413"]],["man",["G444"]],["Adam",["G76"]],["was made",["G1096","G1519"]],["a living",["G2198"]],["soul;",["G5590"]],["the last",["G2078"]],["Adam",["G76"]],["was made",["G1519"]],["a quickening",["G2227"]],["spirit.",["G4151"]]]},{"verse":46,"text":"Howbeit that was not first which is spiritual, but that which is natural; and afterward that which is spiritual.","words":[["Howbeit",["G235"]],["that was not",["G3756"]],["first",["G4412"]],["which is spiritual,",["G4152"]],["but",["G235"]],["that which is natural;",["G5591"]],["and afterward",["G1899"]],["that which is spiritual.",["G4152"]]]},{"verse":47,"text":"The first man is of the earth, earthy: the second man is the Lord from heaven.","words":[["The first",["G4413"]],["man",["G444"]],["is of",["G1537"]],["the earth,",["G1093"]],["earthy:",["G5517"]],["the second",["G1208"]],["man",["G444"]],["is the Lord",["G2962"]],["from",["G1537"]],["heaven.",["G3772"]]]},{"verse":48,"text":"As is the earthy, such are they also that are earthy: and as is the heavenly, such are they also that are heavenly.","words":[["As",["G3634"]],["is the earthy,",["G5517"]],["such",["G5108"]],["are they also",["G2532"]],["that are earthy:",["G5517"]],["and",["G2532"]],["as is",["G3634"]],["the heavenly,",["G2032"]],["such",["G5108"]],["are they",["G2032"]],["also",["G2532"]],["that are heavenly.",["G2032"]]]},{"verse":49,"text":"And as we have borne the image of the earthy, we shall also bear the image of the heavenly.","words":[["And",["G2532"]],["as",["G2531"]],["we have borne",["G5409"]],["the image",["G1504"]],["of the earthy,",["G5517"]],["we shall",["G5409"]],["also",["G2532"]],["bear",["G5409"]],["the image",["G1504"]],["of the heavenly.",["G2032"]]]},{"verse":50,"text":"Now this I say, brethren, that flesh and blood cannot inherit the kingdom of God; neither doth corruption inherit incorruption.","words":[["Now",["G1161"]],["this",["G5124"]],["I say,",["G5346"]],["brethren,",["G80"]],["that",["G3754"]],["flesh",["G4561"]],["and",["G2532"]],["blood",["G129"]],["cannot",["G3756","G1410"]],["inherit",["G2816"]],["the kingdom",["G932"]],["of God;",["G2316"]],["neither",["G3761"]],["doth",["G2816"]],["corruption",["G5356"]],["inherit",["G2816"]],["incorruption.",["G861"]]]},{"verse":51,"text":"Behold, I shew you a mystery; We shall not all sleep, but we shall all be changed,","words":[["Behold,",["G2400"]],["I shew",["G3004"]],["you",["G5213"]],["a mystery;",["G3466"]],["We shall",["G2837"]],["not",["G3756"]],["all",["G3956","G3303"]],["sleep,",["G2837"]],["but",["G1161"]],["we shall",["G236"]],["all",["G3956"]],["be changed,",["G236"]]]},{"verse":52,"text":"In a moment, in the twinkling of an eye, at the last trump: for the trumpet shall sound, and the dead shall be raised incorruptible, and we shall be changed.","words":[["In",["G1722"]],["a moment,",["G823"]],["in",["G1722"]],["the twinkling",["G4493"]],["of an eye,",["G3788"]],["at",["G1722"]],["the last",["G2078"]],["trump:",["G4536"]],["for",["G1063"]],["the trumpet shall sound,",["G4537"]],["and",["G2532"]],["the dead",["G3498"]],["shall be raised",["G1453"]],["incorruptible,",["G862"]],["and",["G2532"]],["we",["G2249"]],["shall be changed.",["G236"]]]},{"verse":53,"text":"For this corruptible must put on incorruption, and this mortal must put on immortality.","words":[["For",["G1063"]],["this",["G5124"]],["corruptible",["G5349"]],["must",["G1163"]],["put on",["G1746"]],["incorruption,",["G861"]],["and",["G2532"]],["this",["G5124"]],["mortal",["G2349"]],["must put on",["G1746"]],["immortality.",["G110"]]]},{"verse":54,"text":"So when this corruptible shall have put on incorruption, and this mortal shall have put on immortality, then shall be brought to pass the saying that is written, Death is swallowed up in victory.","words":[["So",["G1161"]],["when",["G3752"]],["this",["G5124"]],["corruptible",["G5349"]],["shall have put on",["G1746"]],["incorruption,",["G861"]],["and",["G2532"]],["this",["G5124"]],["mortal",["G2349"]],["shall have put on",["G1746"]],["immortality,",["G110"]],["then",["G5119"]],["shall be brought to pass",["G1096"]],["the saying",["G3056"]],["that is written,",["G1125"]],["Death",["G2288"]],["is swallowed up",["G2666"]],["in",["G1519"]],["victory.",["G3534"]]]},{"verse":55,"text":"O death, where is thy sting? O grave, where is thy victory?","words":[["O death,",["G2288"]],["where",["G4226"]],["is thy",["G4675"]],["sting?",["G2759"]],["O grave,",["G86"]],["where",["G4226"]],["is thy",["G4675"]],["victory?",["G3534"]]]},{"verse":56,"text":"The sting of death is sin; and the strength of sin is the law.","words":[["The sting",["G2759"]],["of death",["G2288"]],["is sin;",["G266"]],["and",["G1161"]],["the strength",["G1411"]],["of sin",["G266"]],["is the law.",["G3551"]]]},{"verse":57,"text":"But thanks be to God, which giveth us the victory through our Lord Jesus Christ.","words":[["But",["G1161"]],["thanks",["G5485"]],["be to God,",["G2316"]],["which",["G3588"]],["giveth",["G1325"]],["us",["G2254"]],["the victory",["G3534"]],["through",["G1223"]],["our",["G2257"]],["Lord",["G2962"]],["Jesus",["G2424"]],["Christ.",["G5547"]]]},{"verse":58,"text":"Therefore, my beloved brethren, be ye stedfast, unmoveable, always abounding in the work of the Lord, forasmuch as ye know that your labour is not in vain in the Lord.","words":[["Therefore,",["G5620"]],["my",["G3450"]],["beloved",["G27"]],["brethren,",["G80"]],["be ye",["G1096"]],["stedfast,",["G1476"]],["unmoveable,",["G277"]],["always",["G3842"]],["abounding",["G4052"]],["in",["G1722"]],["the work",["G2041"]],["of the Lord,",["G2962"]],["forasmuch as ye know",["G1492"]],["that",["G3754"]],["your",["G5216"]],["labour",["G2873"]],["is",["G2076"]],["not",["G3756"]],["in vain",["G2756"]],["in",["G1722"]],["the Lord.",["G2962"]]]}]}