{"book":"1 Corinthians","chapter":7,"translation":"KJV","url":"/bible/1-corinthians/7","verses":[{"verse":1,"text":"Now concerning the things whereof ye wrote unto me: It is good for a man not to touch a woman.","words":[["Now",["G1161"]],["concerning",["G4012"]],["the things whereof",["G3739"]],["ye wrote",["G1125"]],["unto me:",["G3427"]],["It is good",["G2570"]],["for a man",["G444"]],["not",["G3361"]],["to touch",["G680"]],["a woman.",["G1135"]]]},{"verse":2,"text":"Nevertheless, to avoid fornication, let every man have his own wife, and let every woman have her own husband.","words":[["Nevertheless,",["G1223","G1161"]],["to avoid fornication,",["G4202"]],["let",["G2192"]],["every man",["G1538"]],["have",["G2192"]],["his own",["G1438"]],["wife,",["G1135"]],["and",["G2532"]],["let",["G2192"]],["every woman",["G1538"]],["have",["G2192"]],["her own",["G2398"]],["husband.",["G435"]]]},{"verse":3,"text":"Let the husband render unto the wife due benevolence: and likewise also the wife unto the husband.","words":[["Let",["G591"]],["the husband",["G435"]],["render",["G591"]],["unto the wife",["G1135"]],["due",["G3784"]],["benevolence:",["G2133"]],["and",["G1161"]],["likewise",["G3668"]],["also",["G2532"]],["the wife",["G1135"]],["unto the husband.",["G435"]]]},{"verse":4,"text":"The wife hath not power of her own body, but the husband: and likewise also the husband hath not power of his own body, but the wife.","words":[["The wife",["G1135"]],["hath",["G1850"]],["not",["G3756"]],["power",["G1850"]],["of her own",["G2398"]],["body,",["G4983"]],["but",["G235"]],["the husband:",["G435"]],["and",["G1161"]],["likewise",["G3668"]],["also",["G2532"]],["the husband",["G435"]],["hath",["G1850"]],["not",["G3756"]],["power",["G1850"]],["of his own",["G2398"]],["body,",["G4983"]],["but",["G235"]],["the wife.",["G1135"]]]},{"verse":5,"text":"Defraud ye not one the other, except it be with consent for a time, that ye may give yourselves to fasting and prayer; and come together again, that Satan tempt you not for your incontinency.","words":[["Defraud ye",["G650"]],["not",["G3361"]],["one the other,",["G240"]],["except",["G1509","G302"]],["it be",["G5100"]],["with",["G1537"]],["consent",["G4859"]],["for",["G4314"]],["a time,",["G2540"]],["that",["G2443"]],["ye may give yourselves",["G4980"]],["to fasting",["G3521"]],["and",["G2532"]],["prayer;",["G4335"]],["and",["G2532"]],["come",["G4905"]],["together",["G1909","G846"]],["again,",["G3825"]],["that",["G3363"]],["Satan",["G4567"]],["tempt",["G3985"]],["you",["G5209"]],["not",["G3363"]],["for",["G1223"]],["your",["G5216"]],["incontinency.",["G192"]]]},{"verse":6,"text":"But I speak this by permission, and not of commandment.","words":[["But",["G1161"]],["I speak",["G3004"]],["this",["G5124"]],["by",["G2596"]],["permission,",["G4774"]],["and not",["G3756"]],["of",["G2596"]],["commandment.",["G2003"]]]},{"verse":7,"text":"For I would that all men were even as I myself. But every man hath his proper gift of God, one after this manner, and another after that.","words":[["For",["G1063"]],["I would",["G2309"]],["that all",["G3956"]],["men",["G444"]],["were",["G1511"]],["even",["G2532"]],["as",["G5613"]],["I myself.",["G1683"]],["But",["G235"]],["every man",["G1538"]],["hath",["G2192"]],["his proper",["G2398"]],["gift",["G5486"]],["of",["G1537"]],["God,",["G2316"]],["one",["G3739","G3303"]],["after this manner,",["G3779"]],["and",["G1161"]],["another",["G3739"]],["after that.",["G3779"]]]},{"verse":8,"text":"I say therefore to the unmarried and widows, It is good for them if they abide even as I.","words":[["I say",["G3004"]],["therefore",["G1161"]],["to the unmarried",["G22"]],["and",["G2532"]],["widows,",["G5503"]],["It is",["G2076"]],["good",["G2570"]],["for them",["G846"]],["if",["G1437"]],["they abide",["G3306"]],["even",["G2504"]],["as",["G5613"]],["I.",["G2504"]]]},{"verse":9,"text":"But if they cannot contain, let them marry: for it is better to marry than to burn.","words":[["But",["G1161"]],["if",["G1487"]],["they",["G1467"]],["cannot",["G3756"]],["contain,",["G1467"]],["let them marry:",["G1060"]],["for",["G1063"]],["it is",["G2076"]],["better",["G2909"]],["to marry",["G1060"]],["than",["G2228"]],["to burn.",["G4448"]]]},{"verse":10,"text":"And unto the married I command, yet not I, but the Lord, Let not the wife depart from her husband:","words":[["And",["G1161"]],["unto the married",["G1060"]],["I command,",["G3853"]],["yet not",["G3756"]],["I,",["G1473"]],["but",["G235"]],["the Lord,",["G2962"]],["Let",["G5563"]],["not",["G3361"]],["the wife",["G1135"]],["depart",["G5563"]],["from",["G575"]],["her husband:",["G435"]]]},{"verse":11,"text":"But and if she depart, let her remain unmarried, or be reconciled to her husband: and let not the husband put away his wife.","words":[["But",["G1161"]],["and",["G2532"]],["if",["G1437"]],["she depart,",["G5563"]],["let her remain",["G3306"]],["unmarried,",["G22"]],["or",["G2228"]],["be reconciled",["G2644"]],["to her husband:",["G435"]],["and",["G2532"]],["let",["G863"]],["not",["G3361"]],["the husband",["G435"]],["put away",["G863"]],["his wife.",["G1135"]]]},{"verse":12,"text":"But to the rest speak I, not the Lord: If any brother hath a wife that believeth not, and she be pleased to dwell with him, let him not put her away.","words":[["But",["G1161"]],["to the rest",["G3062"]],["speak",["G3004"]],["I,",["G1473"]],["not",["G3756"]],["the Lord:",["G2962"]],["If any",["G1536"]],["brother",["G80"]],["hath",["G2192"]],["a wife",["G1135"]],["that believeth not,",["G571"]],["and",["G2532"]],["she",["G846"]],["be pleased",["G4909"]],["to dwell",["G3611"]],["with",["G3326"]],["him,",["G846"]],["let him",["G863"]],["not",["G3361"]],["put",["G863"]],["her",["G846"]],["away.",["G863"]]]},{"verse":13,"text":"And the woman which hath an husband that believeth not, and if he be pleased to dwell with her, let her not leave him.","words":[["And",["G2532"]],["the woman",["G1135"]],["which",["G3748"]],["hath",["G2192"]],["an husband",["G435"]],["that believeth not,",["G571"]],["and",["G2532"]],["if he",["G846"]],["be pleased",["G4909"]],["to dwell",["G3611"]],["with",["G3326"]],["her,",["G846"]],["let her",["G863"]],["not",["G3361"]],["leave",["G863"]],["him.",["G846"]]]},{"verse":14,"text":"For the unbelieving husband is sanctified by the wife, and the unbelieving wife is sanctified by the husband: else were your children unclean; but now are they holy.","words":[["For",["G1063"]],["the unbelieving",["G571"]],["husband",["G435"]],["is sanctified",["G37"]],["by",["G1722"]],["the wife,",["G1135"]],["and",["G2532"]],["the unbelieving",["G571"]],["wife",["G1135"]],["is sanctified",["G37"]],["by",["G1722"]],["the husband:",["G435"]],["else",["G686","G1893"]],["were",["G2076"]],["your",["G5216"]],["children",["G5043"]],["unclean;",["G169"]],["but",["G1161"]],["now",["G3568"]],["are they",["G2076"]],["holy.",["G40"]]]},{"verse":15,"text":"But if the unbelieving depart, let him depart. A brother or a sister is not under bondage in such cases: but God hath called us to peace.","words":[["But",["G1161"]],["if",["G1487"]],["the unbelieving",["G571"]],["depart,",["G5563"]],["let him depart.",["G5563"]],["A brother",["G80"]],["or",["G2228"]],["a sister",["G79"]],["is",["G1402"]],["not",["G3756"]],["under bondage",["G1402"]],["in",["G1722"]],["such",["G5108"]],["cases: but",["G1161"]],["God",["G2316"]],["hath called",["G2564"]],["us",["G2248"]],["to",["G1722"]],["peace.",["G1515"]]]},{"verse":16,"text":"For what knowest thou, O wife, whether thou shalt save thy husband? or how knowest thou, O man, whether thou shalt save thy wife?","words":[["For",["G1063"]],["what",["G5101"]],["knowest thou,",["G1492"]],["O wife,",["G1135"]],["whether",["G1487"]],["thou shalt save",["G4982"]],["thy husband?",["G435"]],["or",["G2228"]],["how",["G5101"]],["knowest thou,",["G1492"]],["O man,",["G435"]],["whether",["G1487"]],["thou shalt save",["G4982"]],["thy wife?",["G1135"]]]},{"verse":17,"text":"But as God hath distributed to every man, as the Lord hath called every one, so let him walk. And so ordain I in all churches.","words":[["But",["G1508"]],["as",["G5613"]],["God",["G2316"]],["hath distributed",["G3307"]],["to every man,",["G1538"]],["as",["G5613"]],["the Lord",["G2962"]],["hath called",["G2564"]],["every one,",["G1538"]],["so",["G3779"]],["let him walk.",["G4043"]],["And",["G2532"]],["so",["G3779"]],["ordain I",["G1299"]],["in",["G1722"]],["all",["G3956"]],["churches.",["G1577"]]]},{"verse":18,"text":"Is any man called being circumcised? let him not become uncircumcised. Is any called in uncircumcision? let him not be circumcised.","words":[["Is",["G2564"]],["any man",["G5100"]],["called",["G2564"]],["being circumcised?",["G4059"]],["let him",["G1986"]],["not",["G3361"]],["become uncircumcised.",["G1986"]],["Is",["G2564"]],["any",["G5100"]],["called",["G2564"]],["in",["G1722"]],["uncircumcision?",["G203"]],["let him",["G4059"]],["not",["G3361"]],["be circumcised.",["G4059"]]]},{"verse":19,"text":"Circumcision is nothing, and uncircumcision is nothing, but the keeping of the commandments of God.","words":[["Circumcision",["G4061"]],["is",["G2076"]],["nothing,",["G3762"]],["and",["G2532"]],["uncircumcision",["G203"]],["is",["G2076"]],["nothing,",["G3762"]],["but",["G235"]],["the keeping",["G5084"]],["of the commandments",["G1785"]],["of God.",["G2316"]]]},{"verse":20,"text":"Let every man abide in the same calling wherein he was called.","words":[["Let",["G3306"]],["every man",["G1538"]],["abide",["G3306"]],["in",["G1722"]],["the same",["G5026"]],["calling",["G2821"]],["wherein",["G1722","G3739"]],["he was called.",["G2564"]]]},{"verse":21,"text":"Art thou called being a servant? care not for it: but if thou mayest be made free, use it rather.","words":[["Art thou called",["G2564"]],["being a servant?",["G1401"]],["care",["G3199","G4671"]],["not",["G3361"]],["for it:",["G3199"]],["but",["G235"]],["if",["G1499"]],["thou mayest",["G1410"]],["be made",["G1096"]],["free,",["G1658"]],["use",["G5530"]],["it rather.",["G3123"]]]},{"verse":22,"text":"For he that is called in the Lord, being a servant, is the Lord’s freeman: likewise also he that is called, being free, is Christ’s servant.","words":[["For",["G1063"]],["he that is called",["G2564"]],["in",["G1722"]],["the Lord,",["G2962"]],["being a servant,",["G1401"]],["is",["G2076"]],["the Lord’s freeman:",["G558"]],["likewise",["G3668"]],["also",["G2532"]],["he that is called,",["G2564"]],["being free,",["G1658"]],["is",["G2076"]],["Christ’s servant.",["G1401"]]]},{"verse":23,"text":"Ye are bought with a price; be not ye the servants of men.","words":[["Ye are bought",["G59"]],["with a price;",["G5092"]],["be",["G1096"]],["not",["G3361"]],["ye",["G1096"]],["the servants",["G1401"]],["of men.",["G444"]]]},{"verse":24,"text":"Brethren, let every man, wherein he is called, therein abide with God.","words":[["Brethren,",["G80"]],["let",["G3306"]],["every man,",["G1538"]],["wherein",["G1722","G3739"]],["he is called,",["G2564"]],["therein",["G1722","G5129"]],["abide",["G3306"]],["with",["G3844"]],["God.",["G2316"]]]},{"verse":25,"text":"Now concerning virgins I have no commandment of the Lord: yet I give my judgment, as one that hath obtained mercy of the Lord to be faithful.","words":[["Now",["G1161"]],["concerning",["G4012"]],["virgins",["G3933"]],["I have",["G2192"]],["no",["G3756"]],["commandment",["G2003"]],["of the Lord:",["G2962"]],["yet",["G1161"]],["I give",["G1325"]],["my judgment,",["G1106"]],["as",["G5613"]],["one that hath obtained mercy",["G1653"]],["of",["G5259"]],["the Lord",["G2962"]],["to be",["G1511"]],["faithful.",["G4103"]]]},{"verse":26,"text":"I suppose therefore that this is good for the present distress, I say, that it is good for a man so to be.","words":[["I suppose",["G3543"]],["therefore",["G3767"]],["that this",["G5124"]],["is",["G5225"]],["good",["G2570"]],["for",["G1223"]],["the present",["G1764"]],["distress,",["G318"]],["I say, that",["G3754"]],["it is good",["G2570"]],["for a man",["G444"]],["so",["G3779"]],["to be.",["G1511"]]]},{"verse":27,"text":"Art thou bound unto a wife? seek not to be loosed. Art thou loosed from a wife? seek not a wife.","words":[["Art thou bound",["G1210"]],["unto a wife?",["G1135"]],["seek",["G2212"]],["not",["G3361"]],["to be loosed.",["G3080"]],["Art thou loosed",["G3089"]],["from",["G575"]],["a wife?",["G1135"]],["seek",["G2212"]],["not",["G3361"]],["a wife.",["G1135"]]]},{"verse":28,"text":"But and if thou marry, thou hast not sinned; and if a virgin marry, she hath not sinned. Nevertheless such shall have trouble in the flesh: but I spare you.","words":[["But",["G1161"]],["and",["G2532"]],["if",["G1437"]],["thou marry,",["G1060"]],["thou hast",["G264"]],["not",["G3756"]],["sinned;",["G264"]],["and",["G2532"]],["if",["G1437"]],["a virgin",["G3933"]],["marry,",["G1060"]],["she hath",["G264"]],["not",["G3756"]],["sinned.",["G264"]],["Nevertheless",["G1161"]],["such",["G5108"]],["shall have",["G2192"]],["trouble",["G2347"]],["in the flesh:",["G4561"]],["but",["G1161"]],["I",["G1473"]],["spare",["G5339"]],["you.",["G5216"]]]},{"verse":29,"text":"But this I say, brethren, the time is short: it remaineth, that both they that have wives be as though they had none;","words":[["But",["G1161"]],["this",["G5124"]],["I say,",["G5346"]],["brethren,",["G80"]],["the time",["G2540"]],["is short:",["G4958"]],["it remaineth,",["G2076","G3063"]],["that",["G2443"]],["both",["G2532"]],["they that have",["G2192"]],["wives",["G1135"]],["be",["G5600"]],["as though",["G5613"]],["they had",["G2192"]],["none;",["G3361"]]]},{"verse":30,"text":"And they that weep, as though they wept not; and they that rejoice, as though they rejoiced not; and they that buy, as though they possessed not;","words":[["And",["G2532"]],["they that weep,",["G2799"]],["as",["G5613"]],["though they wept",["G2799"]],["not;",["G3361"]],["and",["G2532"]],["they that rejoice,",["G5463"]],["as",["G5613"]],["though they rejoiced",["G5463"]],["not;",["G3361"]],["and",["G2532"]],["they that buy,",["G59"]],["as",["G5613"]],["though they possessed",["G2722"]],["not;",["G3361"]]]},{"verse":31,"text":"And they that use this world, as not abusing it: for the fashion of this world passeth away.","words":[["And",["G2532"]],["they that use",["G5530"]],["this",["G5127"]],["world,",["G2889"]],["as",["G5613"]],["not",["G3361"]],["abusing",["G2710"]],["it: for",["G1063"]],["the fashion",["G4976"]],["of this",["G5129"]],["world",["G2889"]],["passeth away.",["G3855"]]]},{"verse":32,"text":"But I would have you without carefulness. He that is unmarried careth for the things that belong to the Lord, how he may please the Lord:","words":[["But",["G1161"]],["I would have",["G1511","G2309"]],["you",["G5209"]],["without carefulness.",["G275"]],["He that is unmarried",["G22"]],["careth",["G3309"]],["for the things that belong to",["G3588"]],["the Lord,",["G2962"]],["how",["G4459"]],["he may please",["G700"]],["the Lord:",["G2962"]]]},{"verse":33,"text":"But he that is married careth for the things that are of the world, how he may please his wife.","words":[["But",["G1161"]],["he that is married",["G1060"]],["careth",["G3309"]],["for the things that are",["G3588"]],["of the world,",["G2889"]],["how",["G4459"]],["he may please",["G700"]],["his wife.",["G1135"]]]},{"verse":34,"text":"There is difference also between a wife and a virgin. The unmarried woman careth for the things of the Lord, that she may be holy both in body and in spirit: but she that is married careth for the things of the world, how she may please her husband.","words":[["There is difference also between",["G3307"]],["a wife",["G1135"]],["and",["G2532"]],["a virgin.",["G3933"]],["The unmarried woman",["G22"]],["careth for",["G3309"]],["the things",["G3588"]],["of the Lord,",["G2962"]],["that",["G2443"]],["she may be",["G5600"]],["holy",["G40"]],["both",["G2532"]],["in body",["G4983"]],["and",["G2532"]],["in spirit:",["G4151"]],["but",["G1161"]],["she that is married",["G1060"]],["careth",["G3309"]],["for the things",["G3588"]],["of the world,",["G2889"]],["how",["G4459"]],["she may please",["G700"]],["her husband.",["G435"]]]},{"verse":35,"text":"And this I speak for your own profit; not that I may cast a snare upon you, but for that which is comely, and that ye may attend upon the Lord without distraction.","words":[["And",["G1161"]],["this",["G5124"]],["I speak",["G3004"]],["for",["G4314"]],["your",["G5216"]],["own",["G846"]],["profit;",["G4851"]],["not",["G3756"]],["that",["G2443"]],["I may cast",["G1911"]],["a snare",["G1029"]],["upon you,",["G5213"]],["but",["G235"]],["for that which",["G4314"]],["is comely,",["G2158"]],["and",["G2532"]],["that ye may attend upon",["G2145"]],["the Lord",["G2962"]],["without distraction.",["G563"]]]},{"verse":36,"text":"But if any man think that he behaveth himself uncomely toward his virgin, if she pass the flower of her age, and need so require, let him do what he will, he sinneth not: let them marry.","words":[["But",["G1161"]],["if any man",["G1536"]],["think",["G3543"]],["that he behaveth himself uncomely",["G807"]],["toward",["G1909"]],["his",["G846"]],["virgin,",["G3933"]],["if",["G1437"]],["she pass the flower of her age,",["G5230","G5600"]],["and",["G2532"]],["need",["G3784"]],["so",["G3779"]],["require,",["G1096"]],["let him do",["G4160"]],["what",["G3739"]],["he will,",["G2309"]],["he sinneth",["G264"]],["not:",["G3756"]],["let them marry.",["G1060"]]]},{"verse":37,"text":"Nevertheless he that standeth stedfast in his heart, having no necessity, but hath power over his own will, and hath so decreed in his heart that he will keep his virgin, doeth well.","words":[["Nevertheless",["G1161"]],["he",["G3739"]],["that standeth",["G2476"]],["stedfast",["G1476"]],["in",["G1722"]],["his heart,",["G2588"]],["having",["G2192"]],["no",["G3361"]],["necessity,",["G318"]],["but",["G1161"]],["hath",["G2192"]],["power",["G1849"]],["over",["G4012"]],["his own",["G2398"]],["will,",["G2307"]],["and",["G2532"]],["hath",["G2919"]],["so",["G5124"]],["decreed",["G2919"]],["in",["G1722"]],["his",["G846"]],["heart",["G2588"]],["that he will keep",["G5083"]],["his",["G1438"]],["virgin,",["G3933"]],["doeth",["G4160"]],["well.",["G2573"]]]},{"verse":38,"text":"So then he that giveth her in marriage doeth well; but he that giveth her not in marriage doeth better.","words":[["So",["G5620"]],["then",["G2532"]],["he that giveth her in marriage",["G1547"]],["doeth",["G4160"]],["well;",["G2573"]],["but",["G1161"]],["he that giveth her",["G1547"]],["not",["G3361"]],["in marriage",["G1547"]],["doeth",["G4160"]],["better.",["G2908"]]]},{"verse":39,"text":"The wife is bound by the law as long as her husband liveth; but if her husband be dead, she is at liberty to be married to whom she will; only in the Lord.","words":[["The wife",["G1135"]],["is bound",["G1210"]],["by the law",["G3551","G1909"]],["as long",["G5550"]],["as",["G3745"]],["her",["G846"]],["husband",["G435"]],["liveth;",["G2198"]],["but",["G1161"]],["if",["G1437"]],["her",["G846"]],["husband",["G435"]],["be dead,",["G2837"]],["she is",["G2076"]],["at liberty",["G1658"]],["to be married",["G1060"]],["to whom",["G3739"]],["she will;",["G2309"]],["only",["G3440"]],["in",["G1722"]],["the Lord.",["G2962"]]]},{"verse":40,"text":"But she is happier if she so abide, after my judgment: and I think also that I have the Spirit of God.","words":[["But",["G1161"]],["she is",["G2076"]],["happier",["G3107"]],["if",["G1437"]],["she",["G3306"]],["so",["G3779"]],["abide,",["G3306"]],["after",["G2596"]],["my",["G1699"]],["judgment:",["G1106"]],["and",["G1161"]],["I think",["G1380"]],["also",["G2504"]],["that I have",["G2192"]],["the Spirit",["G4151"]],["of God.",["G2316"]]]}]}