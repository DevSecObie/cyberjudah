{"book":"1 Corinthians","chapter":11,"translation":"KJV","url":"/bible/1-corinthians/11","verses":[{"verse":1,"text":"Be ye followers of me, even as I also am of Christ.","words":[["Be",["G1096"]],["ye followers",["G3402"]],["of me,",["G3450"]],["even as",["G2531"]],["I also",["G2504"]],["am of Christ.",["G5547"]]]},{"verse":2,"text":"Now I praise you, brethren, that ye remember me in all things, and keep the ordinances, as I delivered them to you.","words":[["Now",["G1161"]],["I praise",["G1867"]],["you,",["G5209"]],["brethren,",["G80"]],["that",["G3754"]],["ye remember",["G3415"]],["me",["G3450"]],["in all things,",["G3956"]],["and",["G2532"]],["keep",["G2722"]],["the ordinances,",["G3862"]],["as",["G2531"]],["I delivered",["G3860"]],["them to you.",["G5213"]]]},{"verse":3,"text":"But I would have you know, that the head of every man is Christ; and the head of the woman is the man; and the head of Christ is God.","words":[["But",["G1161"]],["I would have",["G2309"]],["you",["G5209"]],["know,",["G1492"]],["that",["G3754"]],["the head",["G2776"]],["of every",["G3956"]],["man",["G435"]],["is",["G2076"]],["Christ;",["G5547"]],["and",["G1161"]],["the head",["G2776"]],["of the woman",["G1135"]],["is the man;",["G435"]],["and",["G1161"]],["the head",["G2776"]],["of Christ",["G5547"]],["is God.",["G2316"]]]},{"verse":4,"text":"Every man praying or prophesying, having his head covered, dishonoureth his head.","words":[["Every",["G3956"]],["man",["G435"]],["praying",["G4336"]],["or",["G2228"]],["prophesying,",["G4395"]],["having",["G2192"]],["his head",["G2776"]],["covered,",["G2596"]],["dishonoureth",["G2617"]],["his",["G846"]],["head.",["G2776"]]]},{"verse":5,"text":"But every woman that prayeth or prophesieth with her head uncovered dishonoureth her head: for that is even all one as if she were shaven.","words":[["But",["G1161"]],["every",["G3956"]],["woman",["G1135"]],["that prayeth",["G4336"]],["or",["G2228"]],["prophesieth",["G4395"]],["with her head",["G2776"]],["uncovered",["G177"]],["dishonoureth",["G2617"]],["her",["G1438"]],["head:",["G2776"]],["for",["G1063"]],["that is",["G2076"]],["even",["G2532"]],["all one",["G1520"]],["as if",["G846"]],["she were shaven.",["G3587"]]]},{"verse":6,"text":"For if the woman be not covered, let her also be shorn: but if it be a shame for a woman to be shorn or shaven, let her be covered.","words":[["For",["G1063"]],["if",["G1487"]],["the woman",["G1135"]],["be",["G2619"]],["not",["G3756"]],["covered,",["G2619"]],["let her",["G2751"]],["also",["G2532"]],["be shorn:",["G2751"]],["but",["G1161"]],["if",["G1487"]],["it be a shame",["G149"]],["for a woman",["G1135"]],["to be shorn",["G2751"]],["or",["G2228"]],["shaven,",["G3587"]],["let her be covered.",["G2619"]]]},{"verse":7,"text":"For a man indeed ought not to cover his head, forasmuch as he is the image and glory of God: but the woman is the glory of the man.","words":[["For",["G1063"]],["a man",["G435"]],["indeed",["G3303"]],["ought",["G3784"]],["not",["G3756"]],["to cover",["G2619"]],["his head,",["G2776"]],["forasmuch as he is",["G5225"]],["the image",["G1504"]],["and",["G2532"]],["glory",["G1391"]],["of God:",["G2316"]],["but",["G1161"]],["the woman",["G1135"]],["is",["G2076"]],["the glory",["G1391"]],["of the man.",["G435"]]]},{"verse":8,"text":"For the man is not of the woman; but the woman of the man.","words":[["For",["G1063"]],["the man",["G435"]],["is",["G2076"]],["not",["G3756"]],["of",["G1537"]],["the woman;",["G1135"]],["but",["G235"]],["the woman",["G1135"]],["of",["G1537"]],["the man.",["G435"]]]},{"verse":9,"text":"Neither was the man created for the woman; but the woman for the man.","words":[["Neither",["G3756"]],["was",["G2936"]],["the man",["G435"]],["created",["G2936"]],["for",["G1223"]],["the woman;",["G1135"]],["but",["G235"]],["the woman",["G1135"]],["for",["G1223"]],["the man.",["G435"]]]},{"verse":10,"text":"For this cause ought the woman to have power on her head because of the angels.","words":[["For this",["G5124"]],["cause",["G1223"]],["ought",["G3784"]],["the woman",["G1135"]],["to have",["G2192"]],["power",["G1849"]],["on",["G1909"]],["her head",["G2776"]],["because",["G1223"]],["of the angels.",["G32"]]]},{"verse":11,"text":"Nevertheless neither is the man without the woman, neither the woman without the man, in the Lord.","words":[["Nevertheless",["G4133"]],["neither",["G3777"]],["is the man",["G435"]],["without",["G5565"]],["the woman,",["G1135"]],["neither",["G3777"]],["the woman",["G1135"]],["without",["G5565"]],["the man,",["G435"]],["in",["G1722"]],["the Lord.",["G2962"]]]},{"verse":12,"text":"For as the woman is of the man, even so is the man also by the woman; but all things of God.","words":[["For",["G1063"]],["as",["G5618"]],["the woman",["G1135"]],["is of",["G1537"]],["the man,",["G435"]],["even so",["G3779"]],["is the man",["G435"]],["also",["G2532"]],["by",["G1223"]],["the woman;",["G1135"]],["but",["G1161"]],["all things",["G3956"]],["of",["G1537"]],["God.",["G2316"]]]},{"verse":13,"text":"Judge in yourselves: is it comely that a woman pray unto God uncovered?","words":[["Judge",["G2919"]],["in",["G1722"]],["yourselves:",["G5213","G846"]],["is it",["G2076"]],["comely",["G4241"]],["that a woman",["G1135"]],["pray",["G4336"]],["unto God",["G2316"]],["uncovered?",["G177"]]]},{"verse":14,"text":"Doth not even nature itself teach you, that, if a man have long hair, it is a shame unto him?","words":[["Doth",["G2228"]],["not even",["G3761"]],["nature",["G5449"]],["itself",["G846"]],["teach",["G1321"]],["you,",["G5209"]],["that,",["G3754"]],["if",["G1437","G3303"]],["a man",["G435"]],["have long hair,",["G2863"]],["it is",["G2076"]],["a shame",["G819"]],["unto him?",["G846"]]]},{"verse":15,"text":"But if a woman have long hair, it is a glory to her: for her hair is given her for a covering.","words":[["But",["G1161"]],["if",["G1437"]],["a woman",["G1135"]],["have long hair,",["G2863"]],["it is",["G2076"]],["a glory",["G1391"]],["to her:",["G846"]],["for",["G3754"]],["her hair",["G2864"]],["is given",["G1325"]],["her",["G846"]],["for",["G473"]],["a covering.",["G4018"]]]},{"verse":16,"text":"But if any man seem to be contentious, we have no such custom, neither the churches of God.","words":[["But",["G1161"]],["if any man",["G1536"]],["seem",["G1380"]],["to be",["G1511"]],["contentious,",["G5380"]],["we",["G2249"]],["have",["G2192"]],["no",["G3756"]],["such",["G5108"]],["custom,",["G4914"]],["neither",["G3761"]],["the churches",["G1577"]],["of God.",["G2316"]]]},{"verse":17,"text":"Now in this that I declare unto you I praise you not, that ye come together not for the better, but for the worse.","words":[["Now",["G1161"]],["in this",["G5124"]],["that I declare",["G3853"]],["unto you I praise",["G1867"]],["you not,",["G3756"]],["that",["G3754"]],["ye come together",["G4905"]],["not",["G3756"]],["for",["G1519"]],["the better,",["G2909"]],["but",["G235"]],["for",["G1519"]],["the worse.",["G2276"]]]},{"verse":18,"text":"For first of all, when ye come together in the church, I hear that there be divisions among you; and I partly believe it.","words":[["For",["G1063","G3303"]],["first of all,",["G4412"]],["when ye",["G5216"]],["come together",["G4905"]],["in",["G1722"]],["the church,",["G1577"]],["I hear",["G191"]],["that there be",["G5225"]],["divisions",["G4978"]],["among",["G1722"]],["you;",["G5213"]],["and",["G2532"]],["I partly",["G3313"]],["believe",["G4100"]],["it.",["G5100"]]]},{"verse":19,"text":"For there must be also heresies among you, that they which are approved may be made manifest among you.","words":[["For",["G1063"]],["there must",["G1163"]],["be",["G1511"]],["also",["G2532"]],["heresies",["G139"]],["among",["G1722"]],["you,",["G5213"]],["that",["G2443"]],["they which are approved",["G1384"]],["may be made",["G1096"]],["manifest",["G5318"]],["among",["G1722"]],["you.",["G5213"]]]},{"verse":20,"text":"When ye come together therefore into one place, this is not to eat the Lord’s supper.","words":[["When ye",["G5216"]],["come together",["G4905"]],["therefore",["G3767"]],["into",["G1909"]],["one place,",["G846"]],["this is",["G2076"]],["not",["G3756"]],["to eat",["G5315"]],["the Lord’s supper.",["G1173"]]]},{"verse":21,"text":"For in eating every one taketh before other his own supper: and one is hungry, and another is drunken.","words":[["For",["G1063"]],["in",["G1722"]],["eating",["G5315"]],["every one",["G1538"]],["taketh before",["G4301"]],["other his own",["G2398"]],["supper:",["G1173"]],["and",["G2532"]],["one",["G3739","G3303"]],["is hungry,",["G3983"]],["and",["G1161"]],["another",["G3739"]],["is drunken.",["G3184"]]]},{"verse":22,"text":"What? have ye not houses to eat and to drink in? or despise ye the church of God, and shame them that have not? What shall I say to you? shall I praise you in this? I praise you not.","words":[["What?",["G1063"]],["have ye",["G2192"]],["not",["G3378"]],["houses",["G3614"]],["to eat",["G2068"]],["and",["G2532"]],["to drink",["G4095"]],["in?",["G1519"]],["or",["G2228"]],["despise ye",["G2706"]],["the church",["G1577"]],["of God,",["G2316"]],["and",["G2532"]],["shame",["G2617"]],["them that have",["G2192"]],["not?",["G3361"]],["What",["G5101"]],["shall I say",["G2036"]],["to you?",["G5213"]],["shall I praise",["G1867"]],["you",["G5209"]],["in",["G1722"]],["this?",["G5129"]],["I praise",["G1867"]],["you not.",["G3756"]]]},{"verse":23,"text":"For I have received of the Lord that which also I delivered unto you, That the Lord Jesus the same night in which he was betrayed took bread:","words":[["For",["G1063"]],["I",["G1473"]],["have received",["G3880"]],["of",["G575"]],["the Lord",["G2962"]],["that which",["G3739"]],["also",["G2532"]],["I delivered",["G3860"]],["unto you,",["G5213"]],["That",["G3754"]],["the Lord",["G2962"]],["Jesus",["G2424"]],["the same night",["G3571"]],["in",["G1722"]],["which",["G3739"]],["he was betrayed",["G3860"]],["took",["G2983"]],["bread:",["G740"]]]},{"verse":24,"text":"And when he had given thanks, he brake it, and said, Take, eat: this is my body, which is broken for you: this do in remembrance of me.","words":[["And",["G2532"]],["when he had given thanks,",["G2168"]],["he brake",["G2806"]],["it, and",["G2532"]],["said,",["G2036"]],["Take,",["G2983"]],["eat:",["G5315"]],["this",["G5124"]],["is",["G2076"]],["my",["G3450"]],["body,",["G4983"]],["which",["G3588"]],["is broken",["G2806"]],["for",["G5228"]],["you:",["G5216"]],["this",["G5124"]],["do",["G4160"]],["in",["G1519"]],["remembrance",["G364"]],["of me.",["G1699"]]]},{"verse":25,"text":"After the same manner also he took the cup, when he had supped, saying, This cup is the new testament in my blood: this do ye, as oft as ye drink it, in remembrance of me.","words":[["After the same manner",["G5615"]],["also",["G2532"]],["he took the cup,",["G4221"]],["when",["G3326"]],["he had supped,",["G1172"]],["saying,",["G3004"]],["This",["G5124"]],["cup",["G4221"]],["is",["G2076"]],["the new",["G2537"]],["testament",["G1242"]],["in",["G1722"]],["my",["G1699"]],["blood:",["G129"]],["this",["G5124"]],["do ye,",["G4160"]],["as oft as",["G3740","G302"]],["ye drink",["G4095"]],["it, in",["G1519"]],["remembrance",["G364"]],["of me.",["G1699"]]]},{"verse":26,"text":"For as often as ye eat this bread, and drink this cup, ye do shew the Lord’s death till he come.","words":[["For",["G1063"]],["as often as",["G302","G3740"]],["ye eat",["G2068"]],["this",["G5126"]],["bread,",["G740"]],["and",["G2532"]],["drink",["G4095"]],["this",["G5124"]],["cup,",["G4221"]],["ye do shew",["G2605"]],["the Lord’s death",["G2288"]],["till",["G891","G302"]],["he",["G3739"]],["come.",["G2064"]]]},{"verse":27,"text":"Wherefore whosoever shall eat this bread, and drink this cup of the Lord, unworthily, shall be guilty of the body and blood of the Lord.","words":[["Wherefore",["G5620"]],["whosoever",["G3739","G302"]],["shall eat",["G2068"]],["this",["G5126"]],["bread,",["G740"]],["and",["G2228"]],["drink",["G4095"]],["this cup",["G4221"]],["of the Lord,",["G2962"]],["unworthily,",["G371"]],["shall be",["G2071"]],["guilty",["G1777"]],["of the body",["G4983"]],["and",["G2532"]],["blood",["G129"]],["of the Lord.",["G2962"]]]},{"verse":28,"text":"But let a man examine himself, and so let him eat of that bread, and drink of that cup.","words":[["But",["G1161"]],["let",["G1381"]],["a man",["G444"]],["examine",["G1381"]],["himself,",["G1438"]],["and",["G2532"]],["so",["G3779"]],["let him eat",["G2068"]],["of",["G1537"]],["that bread,",["G740"]],["and",["G2532"]],["drink",["G4095"]],["of",["G1537"]],["that cup.",["G4221"]]]},{"verse":29,"text":"For he that eateth and drinketh unworthily, eateth and drinketh damnation to himself, not discerning the Lord’s body.","words":[["For",["G1063"]],["he that eateth",["G2068"]],["and",["G2532"]],["drinketh",["G4095"]],["unworthily,",["G371"]],["eateth",["G2068"]],["and",["G2532"]],["drinketh",["G4095"]],["damnation",["G2917"]],["to himself,",["G1438"]],["not",["G3361"]],["discerning",["G1252"]],["the Lord’s body.",["G4983"]]]},{"verse":30,"text":"For this cause many are weak and sickly among you, and many sleep.","words":[["For",["G1223"]],["this",["G5124"]],["cause",["G1223"]],["many",["G4183"]],["are weak",["G772"]],["and",["G2532"]],["sickly",["G732"]],["among",["G1722"]],["you,",["G5213"]],["and",["G2532"]],["many",["G2425"]],["sleep.",["G2837"]]]},{"verse":31,"text":"For if we would judge ourselves, we should not be judged.","words":[["For",["G1063"]],["if",["G1487"]],["we would judge",["G1252"]],["ourselves,",["G1438"]],["we should",["G302"]],["not",["G3756"]],["be judged.",["G2919"]]]},{"verse":32,"text":"But when we are judged, we are chastened of the Lord, that we should not be condemned with the world.","words":[["But",["G1161"]],["when we are judged,",["G2919"]],["we are chastened",["G3811"]],["of",["G5259"]],["the Lord,",["G2962"]],["that",["G3363"]],["we should",["G2632"]],["not",["G3363"]],["be condemned",["G2632"]],["with",["G4862"]],["the world.",["G2889"]]]},{"verse":33,"text":"Wherefore, my brethren, when ye come together to eat, tarry one for another.","words":[["Wherefore,",["G5620"]],["my",["G3450"]],["brethren,",["G80"]],["when ye come together",["G4905"]],["to",["G1519"]],["eat,",["G5315"]],["tarry",["G1551"]],["one for another.",["G240"]]]},{"verse":34,"text":"And if any man hunger, let him eat at home; that ye come not together unto condemnation. And the rest will I set in order when I come.","words":[["And",["G1161"]],["if any man",["G1536"]],["hunger,",["G3983"]],["let him eat",["G2068"]],["at",["G1722"]],["home;",["G3624"]],["that",["G3363"]],["ye come",["G4905"]],["not",["G3363"]],["together",["G4905"]],["unto",["G1519"]],["condemnation.",["G2917"]],["And",["G1161"]],["the rest",["G3062"]],["will I set in order",["G1299"]],["when",["G5613","G302"]],["I come.",["G2064"]]]}]}