{"book":"1 Corinthians","chapter":9,"translation":"KJV","url":"/bible/1-corinthians/9","verses":[{"verse":1,"text":"Am I not an apostle? am I not free? have I not seen Jesus Christ our Lord? are not ye my work in the Lord?","words":[["Am",["G1510"]],["I not",["G3756"]],["an apostle?",["G652"]],["am",["G1510"]],["I not",["G3756"]],["free?",["G1658"]],["have I not",["G3780"]],["seen",["G3708"]],["Jesus",["G2424"]],["Christ",["G5547"]],["our",["G2257"]],["Lord?",["G2962"]],["are",["G2075"]],["not",["G3756"]],["ye",["G5210"]],["my",["G3450"]],["work",["G2041"]],["in",["G1722"]],["the Lord?",["G2962"]]]},{"verse":2,"text":"If I be not an apostle unto others, yet doubtless I am to you: for the seal of mine apostleship are ye in the Lord.","words":[["If",["G1487"]],["I be",["G1510"]],["not",["G3756"]],["an apostle",["G652"]],["unto others,",["G243"]],["yet",["G235"]],["doubtless",["G1065"]],["I am",["G1510"]],["to you:",["G5213"]],["for",["G1063"]],["the seal",["G4973"]],["of mine",["G1699"]],["apostleship",["G651"]],["are",["G2075"]],["ye",["G5210"]],["in",["G1722"]],["the Lord.",["G2962"]]]},{"verse":3,"text":"Mine answer to them that do examine me is this,","words":[["Mine",["G1699"]],["answer",["G627"]],["to them that do examine",["G350"]],["me",["G1691"]],["is",["G2076"]],["this,",["G3778"]]]},{"verse":4,"text":"Have we not power to eat and to drink?","words":[["Have we",["G2192"]],["not",["G3378"]],["power",["G1849"]],["to eat",["G5315"]],["and",["G2532"]],["to drink?",["G4095"]]]},{"verse":5,"text":"Have we not power to lead about a sister, a wife, as well as other apostles, and as the brethren of the Lord, and Cephas?","words":[["Have we",["G2192"]],["not",["G3378"]],["power",["G1849"]],["to lead about",["G4013"]],["a sister,",["G79"]],["a wife,",["G1135"]],["as well as",["G5613","G2532"]],["other",["G3062"]],["apostles,",["G652"]],["and",["G2532"]],["as the brethren",["G80"]],["of the Lord,",["G2962"]],["and",["G2532"]],["Cephas?",["G2786"]]]},{"verse":6,"text":"Or I only and Barnabas, have not we power to forbear working?","words":[["Or",["G2228"]],["I",["G1473"]],["only",["G3441"]],["and",["G2532"]],["Barnabas,",["G921"]],["have",["G2192"]],["not",["G3756"]],["we",["G2192"]],["power",["G1849"]],["to forbear",["G3361"]],["working?",["G2038"]]]},{"verse":7,"text":"Who goeth a warfare any time at his own charges? who planteth a vineyard, and eateth not of the fruit thereof? or who feedeth a flock, and eateth not of the milk of the flock?","words":[["Who",["G5101"]],["goeth a warfare",["G4754"]],["any time at",["G4218"]],["his own",["G2398"]],["charges?",["G3800"]],["who",["G5101"]],["planteth",["G5452"]],["a vineyard,",["G290"]],["and",["G2532"]],["eateth",["G2068"]],["not",["G3756"]],["of",["G1537"]],["the fruit",["G2590"]],["thereof?",["G846"]],["or",["G2228"]],["who",["G5101"]],["feedeth",["G4165"]],["a flock,",["G4167"]],["and",["G2532"]],["eateth",["G2068"]],["not",["G3756"]],["of",["G1537"]],["the milk",["G1051"]],["of the flock?",["G4167"]]]},{"verse":8,"text":"Say I these things as a man? or saith not the law the same also?","words":[["Say I",["G2980"]],["these things",["G5023"]],["as",["G3361","G2596"]],["a man?",["G444"]],["or",["G2228"]],["saith",["G3004"]],["not",["G3780"]],["the law",["G3551"]],["the same",["G5023"]],["also?",["G2532"]]]},{"verse":9,"text":"For it is written in the law of Moses, Thou shalt not muzzle the mouth of the ox that treadeth out the corn. Doth God take care for oxen?","words":[["For",["G1063"]],["it is written",["G1125"]],["in",["G1722"]],["the law",["G3551"]],["of Moses,",["G3475"]],["Thou shalt",["G5392"]],["not",["G3756"]],["muzzle",["G5392"]],["the mouth of the ox",["G1016"]],["that treadeth out the corn.",["G248","G3361"]],["Doth",["G3199"]],["God",["G2316"]],["take care",["G3199"]],["for oxen?",["G1016"]]]},{"verse":10,"text":"Or saith he it altogether for our sakes? For our sakes, no doubt, this is written: that he that ploweth should plow in hope; and that he that thresheth in hope should be partaker of his hope.","words":[["Or",["G2228"]],["saith he",["G3004"]],["it altogether",["G3843"]],["for",["G1223"]],["our",["G2248"]],["sakes?",["G1223"]],["For",["G1223"]],["our",["G2248"]],["sakes,",["G1223"]],["no doubt,",["G1063"]],["this is written:",["G1125"]],["that",["G3754"]],["he that ploweth",["G722"]],["should",["G3784"]],["plow",["G722"]],["in",["G1909"]],["hope;",["G1680"]],["and",["G2532"]],["that he that thresheth",["G248"]],["in hope",["G1680"]],["should be partaker",["G3348"]],["of",["G1909"]],["his",["G846"]],["hope.",["G1680"]]]},{"verse":11,"text":"If we have sown unto you spiritual things, is it a great thing if we shall reap your carnal things?","words":[["If",["G1487"]],["we",["G2249"]],["have sown",["G4687"]],["unto you",["G5213"]],["spiritual things,",["G4152"]],["is it a great thing",["G3173"]],["if",["G1487"]],["we",["G2249"]],["shall reap",["G2325"]],["your",["G5216"]],["carnal things?",["G4559"]]]},{"verse":12,"text":"If others be partakers of this power over you, are not we rather? Nevertheless we have not used this power; but suffer all things, lest we should hinder the gospel of Christ.","words":[["If",["G1487"]],["others",["G243"]],["be partakers",["G3348"]],["of this power",["G1849"]],["over you,",["G5216"]],["are not",["G3756"]],["we",["G2249"]],["rather?",["G3123"]],["Nevertheless",["G235"]],["we have",["G5530"]],["not",["G3756"]],["used",["G5530"]],["this",["G5026"]],["power;",["G1849"]],["but",["G235"]],["suffer",["G4722"]],["all things,",["G3956"]],["lest",["G3363"]],["we should",["G1325","G5100"]],["hinder",["G1464"]],["the gospel",["G2098"]],["of Christ.",["G5547"]]]},{"verse":13,"text":"Do ye not know that they which minister about holy things live of the things of the temple? and they which wait at the altar are partakers with the altar?","words":[["Do ye",["G1492"]],["not",["G3756"]],["know",["G1492"]],["that",["G3754"]],["they which minister",["G2038"]],["about holy things",["G2413"]],["live",["G2068"]],["of the things of",["G1537"]],["the temple?",["G2411"]],["and they which wait",["G4332"]],["at the altar",["G2379"]],["are partakers",["G4829"]],["with the altar?",["G2379"]]]},{"verse":14,"text":"Even so hath the Lord ordained that they which preach the gospel should live of the gospel.","words":[["Even",["G2532"]],["so",["G3779"]],["hath",["G1299"]],["the Lord",["G2962"]],["ordained",["G1299"]],["that they which preach",["G2605"]],["the gospel",["G2098"]],["should live",["G2198"]],["of",["G1537"]],["the gospel.",["G2098"]]]},{"verse":15,"text":"But I have used none of these things: neither have I written these things, that it should be so done unto me: for it were better for me to die, than that any man should make my glorying void.","words":[["But",["G1161"]],["I",["G1473"]],["have used",["G5530"]],["none",["G3762"]],["of these things:",["G5130","G1161"]],["neither",["G3756"]],["have I written",["G1125"]],["these things,",["G5023"]],["that",["G2443"]],["it should be",["G1096"]],["so",["G3779"]],["done",["G1096"]],["unto",["G1722"]],["me:",["G1698"]],["for",["G1063"]],["it were better",["G3123"]],["for me",["G3427"]],["to die,",["G599","G2570"]],["than",["G2228"]],["that",["G2443"]],["any man",["G5100"]],["should make",["G2758"]],["my",["G3450"]],["glorying",["G2745"]],["void.",["G2758"]]]},{"verse":16,"text":"For though I preach the gospel, I have nothing to glory of: for necessity is laid upon me; yea, woe is unto me, if I preach not the gospel!","words":[["For",["G1063"]],["though",["G1437"]],["I preach the gospel,",["G2097"]],["I",["G3427"]],["have",["G2076"]],["nothing",["G3756"]],["to glory of:",["G2745"]],["for",["G1063"]],["necessity",["G318"]],["is laid upon",["G1945"]],["me;",["G3427"]],["yea,",["G1161"]],["woe",["G3759"]],["is",["G2076"]],["unto me,",["G3427"]],["if",["G3362"]],["I preach",["G2097"]],["not",["G3362"]],["the gospel!",["G2097"]]]},{"verse":17,"text":"For if I do this thing willingly, I have a reward: but if against my will, a dispensation of the gospel is committed unto me.","words":[["For",["G1063"]],["if",["G1487"]],["I do",["G4238"]],["this thing",["G5124"]],["willingly,",["G1635"]],["I have",["G2192"]],["a reward:",["G3408"]],["but",["G1161"]],["if",["G1487"]],["against my will,",["G210"]],["a dispensation",["G3622"]],["of the gospel is committed unto me.",["G4100"]]]},{"verse":18,"text":"What is my reward then? Verily that, when I preach the gospel, I may make the gospel of Christ without charge, that I abuse not my power in the gospel.","words":[["What",["G5101"]],["is",["G2076"]],["my",["G3427"]],["reward",["G3408"]],["then?",["G3767"]],["Verily that,",["G2443"]],["when I preach the gospel,",["G2097"]],["I may make",["G5087"]],["the gospel",["G2098"]],["of Christ",["G5547"]],["without charge,",["G77"]],["that",["G1519"]],["I abuse",["G2710"]],["not",["G3361"]],["my",["G3450"]],["power",["G1849"]],["in",["G1722"]],["the gospel.",["G2098"]]]},{"verse":19,"text":"For though I be free from all men, yet have I made myself servant unto all, that I might gain the more.","words":[["For",["G1063"]],["though I be",["G5607"]],["free",["G1658"]],["from",["G1537"]],["all",["G3956"]],["men, yet have I made",["G1402"]],["myself",["G1683"]],["servant",["G1402"]],["unto all,",["G3956"]],["that",["G2443"]],["I might gain",["G2770"]],["the more.",["G4119"]]]},{"verse":20,"text":"And unto the Jews I became as a Jew, that I might gain the Jews; to them that are under the law, as under the law, that I might gain them that are under the law;","words":[["And",["G2532"]],["unto the Jews",["G2453"]],["I became",["G1096"]],["as",["G5613"]],["a Jew,",["G2453"]],["that",["G2443"]],["I might gain",["G2770"]],["the Jews;",["G2453"]],["to them that are under",["G5259"]],["the law,",["G3551"]],["as",["G5613"]],["under",["G5259"]],["the law,",["G3551"]],["that",["G2443"]],["I might gain",["G2770"]],["them that are under",["G5259"]],["the law;",["G3551"]]]},{"verse":21,"text":"To them that are without law, as without law, (being not without law to God, but under the law to Christ,) that I might gain them that are without law.","words":[["To them that are without law,",["G459"]],["as",["G5613"]],["without law,",["G459"]],["(being",["G5607"]],["not",["G3361"]],["without law",["G459"]],["to God,",["G2316"]],["but",["G235"]],["under the law",["G1772"]],["to Christ,)",["G5547"]],["that",["G2443"]],["I might gain",["G2770"]],["them that are without law.",["G459"]]]},{"verse":22,"text":"To the weak became I as weak, that I might gain the weak: I am made all things to all men, that I might by all means save some.","words":[["To the weak",["G772"]],["became I",["G1096"]],["as",["G5613"]],["weak,",["G772"]],["that",["G2443"]],["I might gain",["G2770"]],["the weak:",["G772"]],["I am made",["G1096"]],["all things",["G3956"]],["to all",["G3956"]],["men, that",["G2443"]],["I might",["G4982"]],["by all means",["G3843"]],["save",["G4982"]],["some.",["G5100"]]]},{"verse":23,"text":"And this I do for the gospel’s sake, that I might be partaker thereof with you.","words":[["And",["G1161"]],["this",["G5124"]],["I do",["G4160"]],["for",["G1223"]],["the gospel’s sake,",["G1223"]],["that",["G2443"]],["I might be",["G1096"]],["partaker",["G4791"]],["thereof",["G846"]],["with",["G4791"]],["you.",[]]]},{"verse":24,"text":"Know ye not that they which run in a race run all, but one receiveth the prize? So run, that ye may obtain.","words":[["Know ye",["G1492"]],["not",["G3756"]],["that",["G3754"]],["they which run",["G5143"]],["in",["G1722"]],["a race",["G4712"]],["run",["G5143"]],["all,",["G3956","G3303"]],["but",["G1161"]],["one",["G1520"]],["receiveth",["G2983"]],["the prize?",["G1017"]],["So",["G3779"]],["run,",["G5143"]],["that",["G2443"]],["ye may obtain.",["G2638"]]]},{"verse":25,"text":"And every man that striveth for the mastery is temperate in all things. Now they do it to obtain a corruptible crown; but we an incorruptible.","words":[["And",["G1161"]],["every man",["G3956"]],["that striveth for the mastery",["G75"]],["is temperate",["G1467"]],["in all things.",["G3956","G3303"]],["Now",["G3767"]],["they",["G1565"]],["do it to",["G2443"]],["obtain",["G2983"]],["a corruptible",["G5349"]],["crown;",["G4735"]],["but",["G1161"]],["we",["G2249"]],["an incorruptible.",["G862"]]]},{"verse":26,"text":"I therefore so run, not as uncertainly; so fight I, not as one that beateth the air:","words":[["I",["G1473"]],["therefore",["G5106"]],["so",["G3779"]],["run,",["G5143"]],["not",["G3756"]],["as",["G5613"]],["uncertainly;",["G84"]],["so",["G3779"]],["fight I,",["G4438"]],["not",["G3756"]],["as",["G5613"]],["one that beateth",["G1194"]],["the air:",["G109"]]]},{"verse":27,"text":"But I keep under my body, and bring it into subjection: lest that by any means, when I have preached to others, I myself should be a castaway.","words":[["But",["G235"]],["I keep under",["G5299"]],["my",["G3450"]],["body,",["G4983"]],["and",["G2532"]],["bring it into subjection:",["G1396"]],["lest that by any means,",["G3381","G4458"]],["when I have preached",["G2784"]],["to others,",["G243"]],["I myself",["G846"]],["should be",["G1096"]],["a castaway.",["G96"]]]}]}