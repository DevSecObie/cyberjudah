{"book":"1 Chronicles","chapter":1,"translation":"KJV","url":"/bible/1-chronicles/1","verses":[{"verse":1,"text":"Adam, Sheth, Enosh,","words":[["Adam,",["H121"]],["Sheth,",["H8352"]],["Enosh,",["H583"]]]},{"verse":2,"text":"Kenan, Mahalaleel, Jered,","words":[["Kenan,",["H7018"]],["Mahalaleel,",["H4111"]],["Jered,",["H3382"]]]},{"verse":3,"text":"Henoch, Methuselah, Lamech,","words":[["Henoch,",["H2585"]],["Methuselah,",["H4968"]],["Lamech,",["H3929"]]]},{"verse":4,"text":"Noah, Shem, Ham, and Japheth.","words":[["Noah,",["H5146"]],["Shem,",["H8035"]],["Ham,",["H2526"]],["and Japheth.",["H3315"]]]},{"verse":5,"text":"The sons of Japheth; Gomer, and Magog, and Madai, and Javan, and Tubal, and Meshech, and Tiras.","words":[["The sons",["H1121"]],["of Japheth;",["H3315"]],["Gomer,",["H1586"]],["and Magog,",["H4031"]],["and Madai,",["H4074"]],["and Javan,",["H3120"]],["and Tubal,",["H8422"]],["and Meshech,",["H4902"]],["and Tiras.",["H8494"]]]},{"verse":6,"text":"And the sons of Gomer; Ashchenaz, and Riphath, and Togarmah.","words":[["And the sons",["H1121"]],["of Gomer;",["H1586"]],["Ashchenaz,",["H813"]],["and Riphath,",["H7384"]],["and Togarmah.",["H8425"]]]},{"verse":7,"text":"And the sons of Javan; Elishah, and Tarshish, Kittim, and Dodanim.","words":[["And the sons",["H1121"]],["of Javan;",["H3120"]],["Elishah,",["H473"]],["and Tarshish,",["H8659"]],["Kittim,",["H3794"]],["and Dodanim.",["H1721"]]]},{"verse":8,"text":"The sons of Ham; Cush, and Mizraim, Put, and Canaan.","words":[["The sons",["H1121"]],["of Ham;",["H2526"]],["Cush,",["H3568"]],["and Mizraim,",["H4714"]],["Put,",["H6316"]],["and Canaan.",["H3667"]]]},{"verse":9,"text":"And the sons of Cush; Seba, and Havilah, and Sabta, and Raamah, and Sabtecha. And the sons of Raamah; Sheba, and Dedan.","words":[["And the sons",["H1121"]],["of Cush;",["H3568"]],["Seba,",["H5434"]],["and Havilah,",["H2341"]],["and Sabta,",["H5454"]],["and Raamah,",["H7484"]],["and Sabtecha.",["H5455"]],["And the sons",["H1121"]],["of Raamah;",["H7484"]],["Sheba,",["H7614"]],["and Dedan.",["H1719"]]]},{"verse":10,"text":"And Cush begat Nimrod: he began to be mighty upon the earth.","words":[["And Cush",["H3568"]],["begat",["H3205"]],["Nimrod:",["H5248"]],["he began",["H2490"]],["to be mighty",["H1368"]],["upon the earth.",["H776"]]]},{"verse":11,"text":"And Mizraim begat Ludim, and Anamim, and Lehabim, and Naphtuhim,","words":[["And Mizraim",["H4714"]],["begat",["H3205"]],["Ludim,",["H3866"]],["and Anamim,",["H6047"]],["and Lehabim,",["H3853"]],["and Naphtuhim,",["H5320"]]]},{"verse":12,"text":"And Pathrusim, and Casluhim, (of whom came the Philistines,) and Caphthorim.","words":[["And Pathrusim,",["H6625"]],["and Casluhim,",["H3695"]],["(of whom came",["H3318"]],["the Philistines,)",["H6430"]],["and Caphthorim.",["H3732"]]]},{"verse":13,"text":"And Canaan begat Zidon his firstborn, and Heth,","words":[["And Canaan",["H3667"]],["begat",["H3205"]],["Zidon",["H6721"]],["his firstborn,",["H1060"]],["and Heth,",["H2845"]]]},{"verse":14,"text":"The Jebusite also, and the Amorite, and the Girgashite,","words":[["The Jebusite",["H2983"]],["also, and the Amorite,",["H567"]],["and the Girgashite,",["H1622"]]]},{"verse":15,"text":"And the Hivite, and the Arkite, and the Sinite,","words":[["And the Hivite,",["H2340"]],["and the Arkite,",["H6208"]],["and the Sinite,",["H5513"]]]},{"verse":16,"text":"And the Arvadite, and the Zemarite, and the Hamathite.","words":[["And the Arvadite,",["H721"]],["and the Zemarite,",["H6786"]],["and the Hamathite.",["H2577"]]]},{"verse":17,"text":"The sons of Shem; Elam, and Asshur, and Arphaxad, and Lud, and Aram, and Uz, and Hul, and Gether, and Meshech.","words":[["The sons",["H1121"]],["of Shem;",["H8035"]],["Elam,",["H5867"]],["and Asshur,",["H804"]],["and Arphaxad,",["H775"]],["and Lud,",["H3865"]],["and Aram,",["H758"]],["and Uz,",["H5780"]],["and Hul,",["H2343"]],["and Gether,",["H1666"]],["and Meshech.",["H4902"]]]},{"verse":18,"text":"And Arphaxad begat Shelah, and Shelah begat Eber.","words":[["And Arphaxad",["H775"]],["begat",["H3205"]],["Shelah,",["H7974"]],["and Shelah",["H7974"]],["begat",["H3205"]],["Eber.",["H5677"]]]},{"verse":19,"text":"And unto Eber were born two sons: the name of the one was Peleg; because in his days the earth was divided: and his brother’s name was Joktan.","words":[["And unto Eber",["H5677"]],["were born",["H3205"]],["two",["H8147"]],["sons:",["H1121"]],["the name",["H8034"]],["of the one",["H259"]],["was Peleg;",["H6389"]],["because in his days",["H3117"]],["the earth",["H776"]],["was divided:",["H6385"]],["and his brother’s name",["H8034"]],["was Joktan.",["H3355"]]]},{"verse":20,"text":"And Joktan begat Almodad, and Sheleph, and Hazarmaveth, and Jerah,","words":[["And Joktan",["H3355"]],["begat",["H3205"]],["Almodad,",["H486"]],["and Sheleph,",["H8026"]],["and Hazarmaveth,",["H2700"]],["and Jerah,",["H3392"]]]},{"verse":21,"text":"Hadoram also, and Uzal, and Diklah,","words":[["Hadoram",["H1913"]],["also, and Uzal,",["H187"]],["and Diklah,",["H1853"]]]},{"verse":22,"text":"And Ebal, and Abimael, and Sheba,","words":[["And Ebal,",["H5858"]],["and Abimael,",["H39"]],["and Sheba,",["H7614"]]]},{"verse":23,"text":"And Ophir, and Havilah, and Jobab. All these were the sons of Joktan.","words":[["And Ophir,",["H211"]],["and Havilah,",["H2341"]],["and Jobab.",["H3103"]],["All these were the sons",["H1121"]],["of Joktan.",["H3355"]]]},{"verse":24,"text":"Shem, Arphaxad, Shelah,","words":[["Shem,",["H8035"]],["Arphaxad,",["H775"]],["Shelah,",["H7974"]]]},{"verse":25,"text":"Eber, Peleg, Reu,","words":[["Eber,",["H5677"]],["Peleg,",["H6389"]],["Reu,",["H7466"]]]},{"verse":26,"text":"Serug, Nahor, Terah,","words":[["Serug,",["H8286"]],["Nahor,",["H5152"]],["Terah,",["H8646"]]]},{"verse":27,"text":"Abram; the same is Abraham.","words":[["Abram;",["H87"]],["the same is Abraham.",["H85"]]]},{"verse":28,"text":"The sons of Abraham; Isaac, and Ishmael.","words":[["The sons",["H1121"]],["of Abraham;",["H85"]],["Isaac,",["H3327"]],["and Ishmael.",["H3458"]]]},{"verse":29,"text":"These are their generations: The firstborn of Ishmael, Nebaioth; then Kedar, and Adbeel, and Mibsam,","words":[["These are their generations:",["H8435"]],["The firstborn",["H1060"]],["of Ishmael,",["H3458"]],["Nebaioth;",["H5032"]],["then Kedar,",["H6938"]],["and Adbeel,",["H110"]],["and Mibsam,",["H4017"]]]},{"verse":30,"text":"Mishma, and Dumah, Massa, Hadad, and Tema,","words":[["Mishma,",["H4927"]],["and Dumah,",["H1746"]],["Massa,",["H4854"]],["Hadad,",["H2301"]],["and Tema,",["H8485"]]]},{"verse":31,"text":"Jetur, Naphish, and Kedemah. These are the sons of Ishmael.","words":[["Jetur,",["H3195"]],["Naphish,",["H5305"]],["and Kedemah.",["H6929"]],["These are the sons",["H1121"]],["of Ishmael.",["H3458"]]]},{"verse":32,"text":"Now the sons of Keturah, Abraham’s concubine: she bare Zimran, and Jokshan, and Medan, and Midian, and Ishbak, and Shuah. And the sons of Jokshan; Sheba, and Dedan.","words":[["Now the sons",["H1121"]],["of Keturah,",["H6989"]],["Abraham’s concubine:",["H6370"]],["she bare",["H3205"]],["Zimran,",["H2175"]],["and Jokshan,",["H3370"]],["and Medan,",["H4091"]],["and Midian,",["H4080"]],["and Ishbak,",["H3435"]],["and Shuah.",["H7744"]],["And the sons",["H1121"]],["of Jokshan;",["H3370"]],["Sheba,",["H7614"]],["and Dedan.",["H1719"]]]},{"verse":33,"text":"And the sons of Midian; Ephah, and Epher, and Henoch, and Abida, and Eldaah. All these are the sons of Keturah.","words":[["And the sons",["H1121"]],["of Midian;",["H4080"]],["Ephah,",["H5891"]],["and Epher,",["H6081"]],["and Henoch,",["H2585"]],["and Abida,",["H28"]],["and Eldaah.",["H420"]],["All these are the sons",["H1121"]],["of Keturah.",["H6989"]]]},{"verse":34,"text":"And Abraham begat Isaac. The sons of Isaac; Esau and Israel.","words":[["And Abraham",["H85"]],["begat",["H3205"]],["Isaac.",["H3327"]],["The sons",["H1121"]],["of Isaac;",["H3327"]],["Esau",["H6215"]],["and Israel.",["H3478"]]]},{"verse":35,"text":"The sons of Esau; Eliphaz, Reuel, and Jeush, and Jaalam, and Korah.","words":[["The sons",["H1121"]],["of Esau;",["H6215"]],["Eliphaz,",["H464"]],["Reuel,",["H7467"]],["and Jeush,",["H3266"]],["and Jaalam,",["H3281"]],["and Korah.",["H7141"]]]},{"verse":36,"text":"The sons of Eliphaz; Teman, and Omar, Zephi, and Gatam, Kenaz, and Timna, and Amalek.","words":[["The sons",["H1121"]],["of Eliphaz;",["H464"]],["Teman,",["H8487"]],["and Omar,",["H201"]],["Zephi,",["H6825"]],["and Gatam,",["H1609"]],["Kenaz,",["H7073"]],["and Timna,",["H8555"]],["and Amalek.",["H6002"]]]},{"verse":37,"text":"The sons of Reuel; Nahath, Zerah, Shammah, and Mizzah.","words":[["The sons",["H1121"]],["of Reuel;",["H7467"]],["Nahath,",["H5184"]],["Zerah,",["H2226"]],["Shammah,",["H8048"]],["and Mizzah.",["H4199"]]]},{"verse":38,"text":"And the sons of Seir; Lotan, and Shobal, and Zibeon, and Anah, and Dishon, and Ezer, and Dishan.","words":[["And the sons",["H1121"]],["of Seir;",["H8165"]],["Lotan,",["H3877"]],["and Shobal,",["H7732"]],["and Zibeon,",["H6649"]],["and Anah,",["H6034"]],["and Dishon,",["H1787"]],["and Ezer,",["H687"]],["and Dishan.",["H1789"]]]},{"verse":39,"text":"And the sons of Lotan; Hori, and Homam: and Timna was Lotan’s sister.","words":[["And the sons",["H1121"]],["of Lotan;",["H3877"]],["Hori,",["H2753"]],["and Homam:",["H1950"]],["and Timna",["H8555"]],["was Lotan’s sister.",["H269"]]]},{"verse":40,"text":"The sons of Shobal; Alian, and Manahath, and Ebal, Shephi, and Onam. And the sons of Zibeon; Aiah, and Anah.","words":[["The sons",["H1121"]],["of Shobal;",["H7732"]],["Alian,",["H5935"]],["and Manahath,",["H4506"]],["and Ebal,",["H5858"]],["Shephi,",["H8195"]],["and Onam.",["H208"]],["And the sons",["H1121"]],["of Zibeon;",["H6649"]],["Aiah,",["H345"]],["and Anah.",["H6034"]]]},{"verse":41,"text":"The sons of Anah; Dishon. And the sons of Dishon; Amram, and Eshban, and Ithran, and Cheran.","words":[["The sons",["H1121"]],["of Anah;",["H6034"]],["Dishon.",["H1787"]],["And the sons",["H1121"]],["of Dishon;",["H1787"]],["Amram,",["H2566"]],["and Eshban,",["H790"]],["and Ithran,",["H3506"]],["and Cheran.",["H3763"]]]},{"verse":42,"text":"The sons of Ezer; Bilhan, and Zavan, and Jakan. The sons of Dishan; Uz, and Aran.","words":[["The sons",["H1121"]],["of Ezer;",["H687"]],["Bilhan,",["H1092"]],["and Zavan,",["H2190"]],["and Jakan.",["H3292"]],["The sons",["H1121"]],["of Dishan;",["H1789"]],["Uz,",["H5780"]],["and Aran.",["H765"]]]},{"verse":43,"text":"Now these are the kings that reigned in the land of Edom before any king reigned over the children of Israel; Bela the son of Beor: and the name of his city was Dinhabah.","words":[["Now these are the kings",["H4428"]],["that reigned",["H4427"]],["in the land",["H776"]],["of Edom",["H123"]],["before",["H6440"]],["any king",["H4428"]],["reigned",["H4427"]],["over the children",["H1121"]],["of Israel;",["H3478"]],["Bela",["H1106"]],["the son",["H1121"]],["of Beor:",["H1160"]],["and the name",["H8034"]],["of his city",["H5892"]],["was Dinhabah.",["H1838"]]]},{"verse":44,"text":"And when Bela was dead, Jobab the son of Zerah of Bozrah reigned in his stead.","words":[["And when Bela",["H1106"]],["was dead,",["H4191"]],["Jobab",["H3103"]],["the son",["H1121"]],["of Zerah",["H2226"]],["of Bozrah",["H1224"]],["reigned",["H4427"]],["in his stead.",[]]]},{"verse":45,"text":"And when Jobab was dead, Husham of the land of the Temanites reigned in his stead.","words":[["And when Jobab",["H3103"]],["was dead,",["H4191"]],["Husham",["H2367"]],["of the land",["H776"]],["of the Temanites",["H8489"]],["reigned",["H4427"]],["in his stead.",[]]]},{"verse":46,"text":"And when Husham was dead, Hadad the son of Bedad, which smote Midian in the field of Moab, reigned in his stead: and the name of his city was Avith.","words":[["And when Husham",["H2367"]],["was dead,",["H4191"]],["Hadad",["H1908"]],["the son",["H1121"]],["of Bedad,",["H911"]],["which smote",["H5221"]],["Midian",["H4080"]],["in the field",["H7704"]],["of Moab,",["H4124"]],["reigned",["H4427"]],["in his stead: and the name",["H8034"]],["of his city",["H5892"]],["was Avith.",["H5762"]]]},{"verse":47,"text":"And when Hadad was dead, Samlah of Masrekah reigned in his stead.","words":[["And when Hadad",["H1908"]],["was dead,",["H4191"]],["Samlah",["H8072"]],["of Masrekah",["H4957"]],["reigned",["H4427"]],["in his stead.",[]]]},{"verse":48,"text":"And when Samlah was dead, Shaul of Rehoboth by the river reigned in his stead.","words":[["And when Samlah",["H8072"]],["was dead,",["H4191"]],["Shaul",["H7586"]],["of Rehoboth",["H7344"]],["by the river",["H5104"]],["reigned",["H4427"]],["in his stead.",[]]]},{"verse":49,"text":"And when Shaul was dead, Baal–hanan the son of Achbor reigned in his stead.","words":[["And when Shaul",["H7586"]],["was dead,",["H4191"]],["Baal–hanan",["H1177"]],["the son",["H1121"]],["of Achbor",["H5907"]],["reigned",["H4427"]],["in his stead.",[]]]},{"verse":50,"text":"And when Baal–hanan was dead, Hadad reigned in his stead: and the name of his city was Pai; and his wife’s name was Mehetabel, the daughter of Matred, the daughter of Mezahab.","words":[["And when Baal–hanan",["H1177"]],["was dead,",["H4191"]],["Hadad",["H1908"]],["reigned",["H4427"]],["in his stead: and the name",["H8034"]],["of his city",["H5892"]],["was Pai;",["H6464"]],["and his wife’s name",["H8034"]],["was Mehetabel,",["H4105"]],["the daughter",["H1323"]],["of Matred,",["H4308"]],["the daughter",["H1323"]],["of Mezahab.",["H4314"]]]},{"verse":51,"text":"Hadad died also. And the dukes of Edom were; duke Timnah, duke Aliah, duke Jetheth,","words":[["Hadad",["H1908"]],["died",["H4191"]],["also. And the dukes",["H441"]],["of Edom",["H123"]],["were; duke",["H441"]],["Timnah,",["H8555"]],["duke",["H441"]],["Aliah,",["H5933"]],["duke",["H441"]],["Jetheth,",["H3509"]]]},{"verse":52,"text":"Duke Aholibamah, duke Elah, duke Pinon,","words":[["Duke",["H441"]],["Aholibamah,",["H173"]],["duke",["H441"]],["Elah,",["H425"]],["duke",["H441"]],["Pinon,",["H6373"]]]},{"verse":53,"text":"Duke Kenaz, duke Teman, duke Mibzar,","words":[["Duke",["H441"]],["Kenaz,",["H7073"]],["duke",["H441"]],["Teman,",["H8487"]],["duke",["H441"]],["Mibzar,",["H4014"]]]},{"verse":54,"text":"Duke Magdiel, duke Iram. These are the dukes of Edom.","words":[["Duke",["H441"]],["Magdiel,",["H4025"]],["duke",["H441"]],["Iram.",["H5902"]],["These are the dukes",["H441"]],["of Edom.",["H123"]]]}]}