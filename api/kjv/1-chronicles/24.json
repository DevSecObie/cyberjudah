{"book":"1 Chronicles","chapter":24,"translation":"KJV","url":"/bible/1-chronicles/24","verses":[{"verse":1,"text":"Now these are the divisions of the sons of Aaron. The sons of Aaron; Nadab, and Abihu, Eleazar, and Ithamar.","words":[["Now these are the divisions",["H4256"]],["of the sons",["H1121"]],["of Aaron.",["H175"]],["The sons",["H1121"]],["of Aaron;",["H175"]],["Nadab,",["H5070"]],["and Abihu,",["H30"]],["Eleazar,",["H499"]],["and Ithamar.",["H385"]]]},{"verse":2,"text":"But Nadab and Abihu died before their father, and had no children: therefore Eleazar and Ithamar executed the priest’s office.","words":[["But Nadab",["H5070"]],["and Abihu",["H30"]],["died",["H4191"]],["before",["H6440"]],["their father,",["H1"]],["and had no children:",["H1121"]],["therefore Eleazar",["H499"]],["and Ithamar",["H385"]],["executed the priest’s office.",["H3547"]]]},{"verse":3,"text":"And David distributed them, both Zadok of the sons of Eleazar, and Ahimelech of the sons of Ithamar, according to their offices in their service.","words":[["And David",["H1732"]],["distributed",["H2505"]],["them, both Zadok",["H6659"]],["of the sons",["H1121"]],["of Eleazar,",["H499"]],["and Ahimelech",["H288"]],["of the sons",["H1121"]],["of Ithamar,",["H385"]],["according to their offices",["H6486"]],["in their service.",["H5656"]]]},{"verse":4,"text":"And there were more chief men found of the sons of Eleazar than of the sons of Ithamar; and thus were they divided. Among the sons of Eleazar there were sixteen chief men of the house of their fathers, and eight among the sons of Ithamar according to the house of their fathers.","words":[["And there were more",["H7227"]],["chief",["H7218"]],["men",["H1397"]],["found",["H4672"]],["of the sons",["H1121"]],["of Eleazar",["H499"]],["than of the sons",["H1121"]],["of Ithamar;",["H385"]],["and thus were they divided.",["H2505"]],["Among the sons",["H1121"]],["of Eleazar",["H499"]],["there were sixteen",["H8337","H6240"]],["chief men",["H7218"]],["of the house",["H1004"]],["of their fathers,",["H1"]],["and eight",["H8083"]],["among the sons",["H1121"]],["of Ithamar",["H385"]],["according to the house",["H1004"]],["of their fathers.",["H1"]]]},{"verse":5,"text":"Thus were they divided by lot, one sort with another; for the governors of the sanctuary, and governors of the house of God, were of the sons of Eleazar, and of the sons of Ithamar.","words":[["Thus were they divided",["H2505"]],["by lot,",["H1486"]],["one sort",["H428"]],["with another;",["H428"]],["for the governors",["H8269"]],["of the sanctuary,",["H6944"]],["and governors",["H8269"]],["of the house of God,",["H430"]],["were of the sons",["H1121"]],["of Eleazar,",["H499"]],["and of the sons",["H1121"]],["of Ithamar.",["H385"]]]},{"verse":6,"text":"And Shemaiah the son of Nethaneel the scribe, one of the Levites, wrote them before the king, and the princes, and Zadok the priest, and Ahimelech the son of Abiathar, and before the chief of the fathers of the priests and Levites: one principal household being taken for Eleazar, and one taken for Ithamar.","words":[["And Shemaiah",["H8098"]],["the son",["H1121"]],["of Nethaneel",["H5417"]],["the scribe,",["H5608"]],["one of the Levites,",["H3881"]],["wrote",["H3789"]],["them before",["H6440"]],["the king,",["H4428"]],["and the princes,",["H8269"]],["and Zadok",["H6659"]],["the priest,",["H3548"]],["and Ahimelech",["H288"]],["the son",["H1121"]],["of Abiathar,",["H54"]],["and before the chief",["H7218"]],["of the fathers",["H1"]],["of the priests",["H3548"]],["and Levites:",["H3881"]],["one",["H259"]],["principal",["H1"]],["household",["H1004"]],["being taken",["H270"]],["for Eleazar,",["H499"]],["and one taken",["H270"]],["for Ithamar.",["H385"]]]},{"verse":7,"text":"Now the first lot came forth to Jehoiarib, the second to Jedaiah,","words":[["Now the first",["H7223"]],["lot",["H1486"]],["came forth",["H3318"]],["to Jehoiarib,",["H3080"]],["the second",["H8145"]],["to Jedaiah,",["H3048"]]]},{"verse":8,"text":"The third to Harim, the fourth to Seorim,","words":[["The third",["H7992"]],["to Harim,",["H2766"]],["the fourth",["H7243"]],["to Seorim,",["H8188"]]]},{"verse":9,"text":"The fifth to Malchijah, the sixth to Mijamin,","words":[["The fifth",["H2549"]],["to Malchijah,",["H4441"]],["the sixth",["H8345"]],["to Mijamin,",["H4326"]]]},{"verse":10,"text":"The seventh to Hakkoz, the eighth to Abijah,","words":[["The seventh",["H7637"]],["to Hakkoz,",["H6976"]],["the eighth",["H8066"]],["to Abijah,",["H29"]]]},{"verse":11,"text":"The ninth to Jeshua, the tenth to Shecaniah,","words":[["The ninth",["H8671"]],["to Jeshua,",["H3442"]],["the tenth",["H6224"]],["to Shecaniah,",["H7935"]]]},{"verse":12,"text":"The eleventh to Eliashib, the twelfth to Jakim,","words":[["The eleventh",["H6249","H6240"]],["to Eliashib,",["H475"]],["the twelfth",["H8147","H6240"]],["to Jakim,",["H3356"]]]},{"verse":13,"text":"The thirteenth to Huppah, the fourteenth to Jeshebeab,","words":[["The thirteenth",["H7969","H6240"]],["to Huppah,",["H2647"]],["the fourteenth",["H702","H6240"]],["to Jeshebeab,",["H3428"]]]},{"verse":14,"text":"The fifteenth to Bilgah, the sixteenth to Immer,","words":[["The fifteenth",["H2568","H6240"]],["to Bilgah,",["H1083"]],["the sixteenth",["H8337","H6240"]],["to Immer,",["H564"]]]},{"verse":15,"text":"The seventeenth to Hezir, the eighteenth to Aphses,","words":[["The seventeenth",["H7651","H6240"]],["to Hezir,",["H2387"]],["the eighteenth",["H8083","H6240"]],["to Aphses,",["H6483"]]]},{"verse":16,"text":"The nineteenth to Pethahiah, the twentieth to Jehezekel,","words":[["The nineteenth",["H8672","H6240"]],["to Pethahiah,",["H6611"]],["the twentieth",["H6242"]],["to Jehezekel,",["H3168"]]]},{"verse":17,"text":"The one and twentieth to Jachin, the two and twentieth to Gamul,","words":[["The one",["H259"]],["and twentieth",["H6242"]],["to Jachin,",["H3199"]],["the two",["H8147"]],["and twentieth",["H6242"]],["to Gamul,",["H1577"]]]},{"verse":18,"text":"The three and twentieth to Delaiah, the four and twentieth to Maaziah.","words":[["The three",["H7969"]],["and twentieth",["H6242"]],["to Delaiah,",["H1806"]],["the four",["H702"]],["and twentieth",["H6242"]],["to Maaziah.",["H4590"]]]},{"verse":19,"text":"These were the orderings of them in their service to come into the house of the Lord, according to their manner, under Aaron their father, as the Lord God of Israel had commanded him.","words":[["These were the orderings",["H6486"]],["of them in their service",["H5656"]],["to come",["H935"]],["into the house",["H1004"]],["of the Lord,",["H3068"]],["according to their manner,",["H4941"]],["under",["H3027"]],["Aaron",["H175"]],["their father,",["H1"]],["as the Lord",["H3068"]],["God",["H430"]],["of Israel",["H3478"]],["had commanded",["H6680"]],["him.",[]]]},{"verse":20,"text":"And the rest of the sons of Levi were these: Of the sons of Amram; Shubael: of the sons of Shubael; Jehdeiah.","words":[["And the rest",["H3498"]],["of the sons",["H1121"]],["of Levi",["H3878"]],["were these: Of the sons",["H1121"]],["of Amram;",["H6019"]],["Shubael:",["H7619"]],["of the sons",["H1121"]],["of Shubael;",["H7619"]],["Jehdeiah.",["H3165"]]]},{"verse":21,"text":"Concerning Rehabiah: of the sons of Rehabiah, the first was Isshiah.","words":[["Concerning Rehabiah:",["H7345"]],["of the sons",["H1121"]],["of Rehabiah,",["H7345"]],["the first",["H7218"]],["was Isshiah.",["H3449"]]]},{"verse":22,"text":"Of the Izharites; Shelomoth: of the sons of Shelomoth; Jahath.","words":[["Of the Izharites;",["H3325"]],["Shelomoth:",["H8013"]],["of the sons",["H1121"]],["of Shelomoth;",["H8013"]],["Jahath.",["H3189"]]]},{"verse":23,"text":"And the sons of Hebron; Jeriah the first, Amariah the second, Jahaziel the third, Jekameam the fourth.","words":[["And the sons",["H1121"]],["of Hebron; Jeriah",["H3404"]],["the first, Amariah",["H568"]],["the second,",["H8145"]],["Jahaziel",["H3166"]],["the third,",["H7992"]],["Jekameam",["H3360"]],["the fourth.",["H7243"]]]},{"verse":24,"text":"Of the sons of Uzziel; Michah: of the sons of Michah; Shamir.","words":[["Of the sons",["H1121"]],["of Uzziel;",["H5816"]],["Michah:",["H4318"]],["of the sons",["H1121"]],["of Michah;",["H4318"]],["Shamir.",["H8053"]]]},{"verse":25,"text":"The brother of Michah was Isshiah: of the sons of Isshiah; Zechariah.","words":[["The brother",["H251"]],["of Michah",["H4318"]],["was Isshiah:",["H3449"]],["of the sons",["H1121"]],["of Isshiah;",["H3449"]],["Zechariah.",["H2148"]]]},{"verse":26,"text":"The sons of Merari were Mahli and Mushi: the sons of Jaaziah; Beno.","words":[["The sons",["H1121"]],["of Merari",["H4847"]],["were Mahli",["H4249"]],["and Mushi:",["H4187"]],["the sons",["H1121"]],["of Jaaziah;",["H3269"]],["Beno.",["H1121"]]]},{"verse":27,"text":"The sons of Merari by Jaaziah; Beno, and Shoham, and Zaccur, and Ibri.","words":[["The sons",["H1121"]],["of Merari",["H4847"]],["by Jaaziah;",["H3269"]],["Beno,",["H1121"]],["and Shoham,",["H7719"]],["and Zaccur,",["H2139"]],["and Ibri.",["H5681"]]]},{"verse":28,"text":"Of Mahli came Eleazar, who had no sons.","words":[["Of Mahli",["H4249"]],["came Eleazar,",["H499"]],["who had no sons.",["H1121"]]]},{"verse":29,"text":"Concerning Kish: the son of Kish was Jerahmeel.","words":[["Concerning Kish:",["H7027"]],["the son",["H1121"]],["of Kish",["H7027"]],["was Jerahmeel.",["H3396"]]]},{"verse":30,"text":"The sons also of Mushi; Mahli, and Eder, and Jerimoth. These were the sons of the Levites after the house of their fathers.","words":[["The sons",["H1121"]],["also of Mushi;",["H4187"]],["Mahli,",["H4249"]],["and Eder,",["H5740"]],["and Jerimoth.",["H3406"]],["These were the sons",["H1121"]],["of the Levites",["H3881"]],["after the house",["H1004"]],["of their fathers.",["H1"]]]},{"verse":31,"text":"These likewise cast lots over against their brethren the sons of Aaron in the presence of David the king, and Zadok, and Ahimelech, and the chief of the fathers of the priests and Levites, even the principal fathers over against their younger brethren.","words":[["These likewise cast",["H5307"]],["lots",["H1486"]],["over against",["H5980"]],["their brethren",["H251"]],["the sons",["H1121"]],["of Aaron",["H175"]],["in the presence",["H6440"]],["of David",["H1732"]],["the king,",["H4428"]],["and Zadok,",["H6659"]],["and Ahimelech,",["H288"]],["and the chief",["H7218"]],["of the fathers",["H1"]],["of the priests",["H3548"]],["and Levites,",["H3881"]],["even the principal",["H7218"]],["fathers",["H1"]],["over against",["H5980"]],["their younger",["H6996"]],["brethren.",["H251"]]]}]}