hat were instructed in the songs of the Lord, even all that were cunning, was two hundred fourscore and eight.","words":[["So the number",["H4557"]],["of them, with their brethren",["H251"]],["that were instructed",["H3925"]],["in the songs",["H7892"]],["of the Lord,",["H3068"]],["even all that were cunning,",["H995"]],["was two hundred",["H3967"]],["fourscore",["H8084"]],["and eight.",["H8083"]]]},{"verse":8,"text":"And they cast lots, ward against ward, as well the small as the great, the teacher as the scholar.","words":[["And they cast",["H5307"]],["lots,",["H1486"]],["ward",["H4931"]],["against",["H5980"]],["ward, as well the small",["H6996"]],["as the great,",["H1419"]],["the teacher",["H995"]],["as the scholar.",["H8527"]]]},{"verse":9,"text":"Now the first lot came forth for Asaph to Joseph: the second to Gedaliah, who with his brethren and sons were twelve:","words":[["Now the first",["H7223"]],["lot",["H1486"]],["came forth",["H3318"]],["for Asaph",["H623"]],["to Joseph:",["H3130"]],["the second",["H8145"]],["to Gedaliah,",["H1436"]],["who with his brethren",["H251"]],["and sons",["H1121"]],["were twelve:",["H8147","H6240"]]]},{"verse":10,"text":"The third to Zaccur, he, his sons, and his brethren, were twelve:","words":[["The third",["H7992"]],["to Zaccur,",["H2139"]],["he, his sons,",["H1121"]],["and his brethren,",["H251"]],["were twelve:",["H8147","H6240"]]]},{"verse":11,"text":"The fourth to Izri, he, his sons, and his brethren, were twelve:","words":[["The fourth",["H7243"]],["to Izri,",["H3339"]],["he, his sons,",["H1121"]],["and his brethren,",["H251"]],["were twelve:",["H8147","H6240"]]]},{"verse":12,"text":"The fifth to Nethaniah, he, his sons, and his brethren, were twelve:","words":[["The fifth",["H2549"]],["to Nethaniah,",["H5418"]],["he, his sons,",["H1121"]],["and his brethren,",["H251"]],["were twelve:",["H8147","H6240"]]]},{"verse":13,"text":"The sixth to Bukkiah, he, his sons, and his brethren, were twelve:","words":[["The sixth",["H8345"