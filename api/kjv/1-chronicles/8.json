{"book":"1 Chronicles","chapter":8,"translation":"KJV","url":"/bible/1-chronicles/8","verses":[{"verse":1,"text":"Now Benjamin begat Bela his firstborn, Ashbel the second, and Aharah the third,","words":[["Now Benjamin",["H1144"]],["begat",["H3205"]],["Bela",["H1106"]],["his firstborn,",["H1060"]],["Ashbel",["H788"]],["the second,",["H8145"]],["and Aharah",["H315"]],["the third,",["H7992"]]]},{"verse":2,"text":"Nohah the fourth, and Rapha the fifth.","words":[["Nohah",["H5119"]],["the fourth,",["H7243"]],["and Rapha",["H7498"]],["the fifth.",["H2549"]]]},{"verse":3,"text":"And the sons of Bela were, Addar, and Gera, and Abihud,","words":[["And the sons",["H1121"]],["of Bela",["H1106"]],["were, Addar,",["H146"]],["and Gera,",["H1617"]],["and Abihud,",["H31"]]]},{"verse":4,"text":"And Abishua, and Naaman, and Ahoah,","words":[["And Abishua,",["H50"]],["and Naaman,",["H5283"]],["and Ahoah,",["H265"]]]},{"verse":5,"text":"And Gera, and Shephuphan, and Huram.","words":[["And Gera,",["H1617"]],["and Shephuphan,",["H8197"]],["and Huram.",["H2361"]]]},{"verse":6,"text":"And these are the sons of Ehud: these are the heads of the fathers of the inhabitants of Geba, and they removed them to Manahath:","words":[["And these are the sons",["H1121"]],["of Ehud:",["H261"]],["these are the heads",["H7218"]],["of the fathers",["H1"]],["of the inhabitants",["H3427"]],["of Geba,",["H1387"]],["and they removed",["H1540"]],["them to Manahath:",["H4506"]]]},{"verse":7,"text":"And Naaman, and Ahiah, and Gera, he removed them, and begat Uzza, and Ahihud.","words":[["And Naaman,",["H5283"]],["and Ahiah,",["H281"]],["and Gera,",["H1617"]],["he removed",["H1540"]],["them, and begat",["H3205"]],["Uzza,",["H5798"]],["and Ahihud.",["H284"]]]},{"verse":8,"text":"And Shaharaim begat children in the country of Moab, after he had sent them away; Hushim and Baara were his wives.","words":[["And Shaharaim",["H7842"]],["begat",["H3205"]],["children in the country",["H7704"]],["of Moab,",["H4124"]],["after",["H4480"]],["he had sent them away;",["H7971"]],["Hushim",["H2366"]],["and Baara",["H1199"]],["were his wives.",["H802"]]]},{"verse":9,"text":"And he begat of Hodesh his wife, Jobab, and Zibia, and Mesha, and Malcham,","words":[["And he begat",["H3205"]],["of Hodesh",["H2321"]],["his wife,",["H802"]],["Jobab,",["H3103"]],["and Zibia,",["H6644"]],["and Mesha,",["H4331"]],["and Malcham,",["H4445"]]]},{"verse":10,"text":"And Jeuz, and Shachia, and Mirma. These were his sons, heads of the fathers.","words":[["And Jeuz,",["H3263"]],["and Shachia,",["H7634"]],["and Mirma.",["H4821"]],["These were his sons,",["H1121"]],["heads",["H7218"]],["of the fathers.",["H1"]]]},{"verse":11,"text":"And of Hushim he begat Abitub, and Elpaal.","words":[["And of Hushim",["H2366"]],["he begat",["H3205"]],["Abitub,",["H36"]],["and Elpaal.",["H508"]]]},{"verse":12,"text":"The sons of Elpaal; Eber, and Misham, and Shamed, who built Ono, and Lod, with the towns thereof:","words":[["The sons",["H1121"]],["of Elpaal;",["H508"]],["Eber,",["H5677"]],["and Misham,",["H4936"]],["and Shamed,",["H8106"]],["who built",["H1129"]],["Ono,",["H207"]],["and Lod,",["H3850"]],["with the towns",["H1323"]],["thereof:",[]]]},{"verse":13,"text":"Beriah also, and Shema, who were heads of the fathers of the inhabitants of Aijalon, who drove away the inhabitants of Gath:","words":[["Beriah",["H1283"]],["also, and Shema,",["H8087"]],["who",["H1992"]],["were heads",["H7218"]],["of the fathers",["H1"]],["of the inhabitants",["H3427"]],["of Aijalon,",["H357"]],["who drove away",["H1272"]],["the inhabitants",["H3427"]],["of Gath:",["H1661"]]]},{"verse":14,"text":"And Ahio, Shashak, and Jeremoth,","words":[["And Ahio,",["H283"]],["Shashak,",["H8349"]],["and Jeremoth,",["H3406"]]]},{"verse":15,"text":"And Zebadiah, and Arad, and Ader,","words":[["And Zebadiah,",["H2069"]],["and Arad,",["H6166"]],["and Ader,",["H5738"]]]},{"verse":16,"text":"And Michael, and Ispah, and Joha, the sons of Beriah;","words":[["And Michael,",["H4317"]],["and Ispah,",["H3472"]],["and Joha,",["H3109"]],["the sons",["H1121"]],["of Beriah;",["H1283"]]]},{"verse":17,"text":"And Zebadiah, and Meshullam, and Hezeki, and Heber,","words":[["And Zebadiah,",["H2069"]],["and Meshullam,",["H4918"]],["and Hezeki,",["H2395"]],["and Heber,",["H2268"]]]},{"verse":18,"text":"Ishmerai also, and Jezliah, and Jobab, the sons of Elpaal;","words":[["Ishmerai",["H3461"]],["also, and Jezliah,",["H3152"]],["and Jobab,",["H3103"]],["the sons",["H1121"]],["of Elpaal;",["H508"]]]},{"verse":19,"text":"And Jakim, and Zichri, and Zabdi,","words":[["And Jakim,",["H3356"]],["and Zichri,",["H2147"]],["and Zabdi,",["H2067"]]]},{"verse":20,"text":"And Elienai, and Zilthai, and Eliel,","words":[["And Elienai,",["H462"]],["and Zilthai,",["H6769"]],["and Eliel,",["H447"]]]},{"verse":21,"text":"And Adaiah, and Beraiah, and Shimrath, the sons of Shimhi;","words":[["And Adaiah,",["H5718"]],["and Beraiah,",["H1256"]],["and Shimrath,",["H8119"]],["the sons",["H1121"]],["of Shimhi;",["H8096"]]]},{"verse":22,"text":"And Ishpan, and Heber, and Eliel,","words":[["And Ishpan,",["H3473"]],["and Heber,",["H5677"]],["and Eliel,",["H447"]]]},{"verse":23,"text":"And Abdon, and Zichri, and Hanan,","words":[["And Abdon,",["H5658"]],["and Zichri,",["H2147"]],["and Hanan,",["H2605"]]]},{"verse":24,"text":"And Hananiah, and Elam, and Antothijah,","words":[["And Hananiah,",["H2608"]],["and Elam,",["H5867"]],["and Antothijah,",["H6070"]]]},{"verse":25,"text":"And Iphedeiah, and Penuel, the sons of Shashak;","words":[["And Iphedeiah,",["H3301"]],["and Penuel,",["H6439"]],["the sons",["H1121"]],["of Shashak;",["H8349"]]]},{"verse":26,"text":"And Shamsherai, and Shehariah, and Athaliah,","words":[["And Shamsherai,",["H8125"]],["and Shehariah,",["H7841"]],["and Athaliah,",["H6271"]]]},{"verse":27,"text":"And Jaresiah, and Eliah, and Zichri, the sons of Jeroham.","words":[["And Jaresiah,",["H3298"]],["and Eliah,",["H452"]],["and Zichri,",["H2147"]],["the sons",["H1121"]],["of Jeroham.",["H3395"]]]},{"verse":28,"text":"These were heads of the fathers, by their generations, chief men. These dwelt in Jerusalem.","words":[["These were heads",["H7218"]],["of the fathers,",["H1"]],["by their generations,",["H8435"]],["chief",["H7218"]],["men. These dwelt",["H3427"]],["in Jerusalem.",["H3389"]]]},{"verse":29,"text":"And at Gibeon dwelt the father of Gibeon; whose wife’s name was Maachah:","words":[["And at Gibeon",["H1391"]],["dwelt",["H3427"]],["the father",["H1"]],["of Gibeon;",["H1391","H25"]],["whose wife’s name",["H8034"]],["was Maachah:",["H4601"]]]},{"verse":30,"text":"And his firstborn son Abdon, and Zur, and Kish, and Baal, and Nadab,","words":[["And his firstborn",["H1060"]],["son",["H1121"]],["Abdon,",["H5658"]],["and Zur,",["H6698"]],["and Kish,",["H7027"]],["and Baal,",["H1168"]],["and Nadab,",["H5070"]]]},{"verse":31,"text":"And Gedor, and Ahio, and Zacher.","words":[["And Gedor,",["H1446"]],["and Ahio,",["H283"]],["and Zacher.",["H2144"]]]},{"verse":32,"text":"And Mikloth begat Shimeah. And these also dwelt with their brethren in Jerusalem, over against them.","words":[["And Mikloth",["H4732"]],["begat",["H3205"]],["Shimeah.",["H8039"]],["And these also",["H637"]],["dwelt",["H3427"]],["with their brethren",["H251"]],["in Jerusalem,",["H3389"]],["over against them.",["H5048"]]]},{"verse":33,"text":"And Ner begat Kish, and Kish begat Saul, and Saul begat Jonathan, and Malchi–shua, and Abinadab, and Esh–baal.","words":[["And Ner",["H5369"]],["begat",["H3205"]],["Kish,",["H7027"]],["and Kish",["H7027"]],["begat",["H3205"]],["Saul,",["H7586"]],["and Saul",["H7586"]],["begat",["H3205"]],["Jonathan,",["H3083"]],["and Malchi–shua,",["H4444"]],["and Abinadab,",["H41"]],["and Esh–baal.",["H792"]]]},{"verse":34,"text":"And the son of Jonathan was Merib–baal; and Merib–baal begat Micah.","words":[["And the son",["H1121"]],["of Jonathan",["H3083"]],["was Merib–baal;",["H4807"]],["and Merib–baal",["H4807"]],["begat",["H3205"]],["Micah.",["H4318"]]]},{"verse":35,"text":"And the sons of Micah were, Pithon, and Melech, and Tarea, and Ahaz.","words":[["And the sons",["H1121"]],["of Micah",["H4318"]],["were, Pithon,",["H6377"]],["and Melech,",["H4429"]],["and Tarea,",["H8390"]],["and Ahaz.",["H271"]]]},{"verse":36,"text":"And Ahaz begat Jehoadah; and Jehoadah begat Alemeth, and Azmaveth, and Zimri; and Zimri begat Moza,","words":[["And Ahaz",["H271"]],["begat",["H3205"]],["Jehoadah;",["H3085"]],["and Jehoadah",["H3085"]],["begat",["H3205"]],["Alemeth,",["H5964"]],["and Azmaveth,",["H5820"]],["and Zimri;",["H2174"]],["and Zimri",["H2174"]],["begat",["H3205"]],["Moza,",["H4162"]]]},{"verse":37,"text":"And Moza begat Binea: Rapha was his son, Eleasah his son, Azel his son:","words":[["And Moza",["H4162"]],["begat",["H3205"]],["Binea:",["H1150"]],["Rapha",["H7498"]],["was his son,",["H1121"]],["Eleasah",["H501"]],["his son,",["H1121"]],["Azel",["H682"]],["his son:",["H1121"]]]},{"verse":38,"text":"And Azel had six sons, whose names are these, Azrikam, Bocheru, and Ishmael, and Sheariah, and Obadiah, and Hanan. All these were the sons of Azel.","words":[["And Azel",["H682"]],["had six",["H8337"]],["sons,",["H1121"]],["whose names",["H8034"]],["are these, Azrikam,",["H5840"]],["Bocheru,",["H1074"]],["and Ishmael,",["H3458"]],["and Sheariah,",["H8187"]],["and Obadiah,",["H5662"]],["and Hanan.",["H2605"]],["All these were the sons",["H1121"]],["of Azel.",["H682"]]]},{"verse":39,"text":"And the sons of Eshek his brother were, Ulam his firstborn, Jehush the second, and Eliphelet the third.","words":[["And the sons",["H1121"]],["of Eshek",["H6232"]],["his brother",["H251"]],["were, Ulam",["H198"]],["his firstborn,",["H1060"]],["Jehush",["H3266"]],["the second,",["H8145"]],["and Eliphelet",["H467"]],["the third.",["H7992"]]]},{"verse":40,"text":"And the sons of Ulam were mighty men of valour, archers, and had many sons, and sons’ sons, an hundred and fifty. All these are of the sons of Benjamin.","words":[["And the sons",["H1121"]],["of Ulam",["H198"]],["were mighty",["H1368"]],["men",["H582"]],["of valour,",["H2428"]],["archers,",["H1869","H7198"]],["and had many",["H7235"]],["sons,",["H1121"]],["and sons’",["H1121"]],["sons,",["H1121"]],["an hundred",["H3967"]],["and fifty.",["H2572"]],["All these are of the sons",["H1121"]],["of Benjamin.",["H1144"]]]}]}