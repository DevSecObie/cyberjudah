{"book":"Hebrews","chapter":4,"translation":"KJV","url":"/bible/hebrews/4","verses":[{"verse":1,"text":"Let us therefore fear, lest, a promise being left us of entering into his rest, any of you should seem to come short of it.","words":[["Let us",["G5399"]],["therefore",["G3767"]],["fear,",["G5399"]],["lest,",["G3379"]],["a promise",["G1860"]],["being left",["G2641"]],["us of entering",["G1525"]],["into",["G1519"]],["his",["G846"]],["rest,",["G2663"]],["any",["G5100"]],["of",["G1537"]],["you",["G5216"]],["should seem",["G1380"]],["to come short of it.",[]]]},{"verse":2,"text":"For unto us was the gospel preached, as well as unto them: but the word preached did not profit them, not being mixed with faith in them that heard it.","words":[["For",["G2532","G1063"]],["unto us was",["G2070"]],["the gospel preached,",["G2097"]],["as well as",["G2509"]],["unto them:",["G2548"]],["but",["G235"]],["the word",["G3056"]],["preached",["G189"]],["did",["G5623"]],["not",["G3756"]],["profit",["G5623"]],["them,",["G1565"]],["not",["G3361"]],["being mixed",["G4786"]],["with faith",["G4102"]],["in them that heard it.",[]]]},{"verse":3,"text":"For we which have believed do enter into rest, as he said, As I have sworn in my wrath, if they shall enter into my rest: although the works were finished from the foundation of the world.","words":[["For",["G1063"]],["we which",["G3588"]],["have believed",["G4100"]],["do enter",["G1525"]],["into",["G1519"]],["rest,",["G2663"]],["as",["G2531"]],["he said,",["G2046"]],["As",["G5613"]],["I have sworn",["G3660"]],["in",["G1722"]],["my",["G3450"]],["wrath,",["G3709"]],["if",["G1487"]],["they shall enter",["G1525"]],["into",["G1519"]],["my",["G3450"]],["rest:",["G2663"]],["although",["G2543"]],["the works",["G2041"]],["were finished",["G1096"]],["from",["G575"]],["the foundation",["G2602"]],["of the world.",[]]]},{"verse":4,"text":"For he spake in a certain place of the seventh day on this wise, And God did rest the seventh day from all his works.","words":[["For",["G1063"]],["he spake",["G2046"]],["in a certain place",["G4225"]],["of",["G4012"]],["the seventh",["G1442"]],["day on this wise,",["G3779"]],["And",["G2532"]],["God",["G2316"]],["did rest",["G2664"]],["the seventh",["G1722","G1442"]],["day",["G2250"]],["from",["G575"]],["all",["G3956"]],["his",["G846"]],["works.",[]]]},{"verse":5,"text":"And in this place again, If they shall enter into my rest.","words":[["And",["G2532"]],["in",["G1722"]],["this",["G5129"]],["place again,",["G3825"]],["If",["G1487"]],["they shall enter",["G1525"]],["into",["G1519"]],["my",["G3450"]],["rest.",[]]]},{"verse":6,"text":"Seeing therefore it remaineth that some must enter therein, and they to whom it was first preached entered not in because of unbelief:","words":[["Seeing",["G1893"]],["therefore",["G3767"]],["it remaineth",["G620"]],["that some",["G5100"]],["must enter",["G1525"]],["therein,",["G1519","G846"]],["and",["G2532"]],["they to whom it was first",["G4386"]],["preached",["G2097"]],["entered",["G1525"]],["not",["G3756"]],["in",["G1525"]],["because",["G1223"]],["of unbelief:",[]]]},{"verse":7,"text":"Again, he limiteth a certain day, saying in David, To day, after so long a time; as it is said, To day if ye will hear his voice, harden not your hearts.","words":[["Again,",["G3825"]],["he limiteth",["G3724"]],["a certain",["G5100"]],["day,",["G2250"]],["saying",["G3004"]],["in",["G1722"]],["David,",["G1138"]],["To day,",["G4594"]],["after",["G3326"]],["so long",["G5118"]],["a time;",["G5550"]],["as",["G2531"]],["it is said,",["G2046"]],["To day",["G4594"]],["if",["G1437"]],["ye will hear",["G191"]],["his",["G846"]],["voice,",["G5456"]],["harden",["G4645"]],["not",["G3361"]],["your",["G5216"]],["hearts.",[]]]},{"verse":8,"text":"For if Jesus had given them rest, then would he not afterward have spoken of another day.","words":[["For",["G1063"]],["if",["G1487"]],["Jesus",["G2424"]],["had given",["G2664"]],["them",["G846"]],["rest,",["G2664"]],["then would he",["G302"]],["not",["G3756"]],["afterward",["G3326","G5023"]],["have spoken",["G2980"]],["of",["G4012"]],["another",["G243"]],["day.",[]]]},{"verse":9,"text":"There remaineth therefore a rest to the people of God.","words":[["There remaineth",["G620"]],["therefore",["G686"]],["a rest",["G4520"]],["to the people",["G2992"]],["of God.",[]]]},{"verse":10,"text":"For he that is entered into his rest, he also hath ceased from his own works, as God did from his.","words":[["For",["G1063"]],["he that is entered",["G1525"]],["into",["G1519"]],["his",["G846"]],["rest,",["G2663"]],["he",["G846"]],["also",["G2532"]],["hath ceased",["G2664"]],["from",["G575"]],["his own",["G846"]],["works,",["G2041"]],["as",["G5618"]],["God",["G2316"]],["did from",["G575"]],["his.",[]]]},{"verse":11,"text":"Let us labour therefore to enter into that rest, lest any man fall after the same example of unbelief.","words":[["Let us labour",["G4704"]],["therefore",["G3767"]],["to enter",["G1525"]],["into",["G1519"]],["that",["G1565"]],["rest,",["G2663"]],["lest",["G3363"]],["any man",["G5100"]],["fall",["G4098"]],["after",["G1722"]],["the same",["G846"]],["example",["G5262"]],["of unbelief.",[]]]},{"verse":12,"text":"For the word of God is quick, and powerful, and sharper than any twoedged sword, piercing even to the dividing asunder of soul and spirit, and of the joints and marrow, and is a discerner of the thoughts and intents of the heart.","words":[["For",["G1063"]],["the word",["G3056"]],["of God",["G2316"]],["is quick,",["G2198"]],["and",["G2532"]],["powerful,",["G1756"]],["and",["G2532"]],["sharper",["G5114"]],["than",["G5228"]],["any",["G3956"]],["twoedged",["G1366"]],["sword,",["G3162"]],["piercing",["G1338"]],["even to",["G891"]],["the dividing asunder",["G3311"]],["of soul",["G5590"]],["and",["G5037","G2532"]],["spirit,",["G4151"]],["and",["G5037","G2532"]],["of the joints",["G719"]],["and",["G2532"]],["marrow,",["G3452"]],["and",["G2532"]],["is a discerner",["G2924"]],["of the thoughts",["G1761"]],["and",["G2532"]],["intents",["G1771"]],["of the heart.",[]]]},{"verse":13,"text":"Neither is there any creature that is not manifest in his sight: but all things are naked and opened unto the eyes of him with whom we have to do.","words":[["Neither",["G2532","G3756"]],["is there",["G2076"]],["any creature",["G2937"]],["that is not manifest",["G852"]],["in his",["G846"]],["sight:",["G1799"]],["but",["G1161"]],["all things",["G3956"]],["are naked",["G1131"]],["and",["G2532"]],["opened",["G5136"]],["unto the eyes",["G3788"]],["of him",["G846"]],["with",["G4314"]],["whom",["G3739"]],["we have",["G2254"]],["to do.",[]]]},{"verse":14,"text":"Seeing then that we have a great high priest, that is passed into the heavens, Jesus the Son of God, let us hold fast our profession.","words":[["Seeing",["G2192"]],["then",["G3767"]],["that we have",["G2192"]],["a great",["G3173"]],["high priest,",["G749"]],["that is passed into",["G1330"]],["the heavens,",["G3772"]],["Jesus",["G2424"]],["the Son",["G5207"]],["of God,",["G2316"]],["let us hold fast",["G2902"]],["our profession.",[]]]},{"verse":15,"text":"For we have not an high priest which cannot be touched with the feeling of our infirmities; but was in all points tempted like as we are, yet without sin.","words":[["For",["G1063"]],["we have",["G2192"]],["not",["G3756"]],["an high priest",["G749"]],["which cannot",["G3361","G1410"]],["be touched with the feeling",["G4834"]],["of our",["G2257"]],["infirmities;",["G769"]],["but",["G1161"]],["was",["G3985"]],["in",["G2596"]],["all points",["G3956"]],["tempted",["G3985","G3987"]],["like",["G2596"]],["as",["G3665"]],["we are, yet without",["G5565"]],["sin.",[]]]},{"verse":16,"text":"Let us therefore come boldly unto the throne of grace, that we may obtain mercy, and find grace to help in time of need.","words":[["Let us",["G4334"]],["therefore",["G3767"]],["come",["G4334"]],["boldly",["G3326","G3954"]],["unto the throne",["G2362"]],["of grace,",["G5485"]],["that",["G2443"]],["we may obtain",["G2983"]],["mercy,",["G1656"]],["and",["G2532"]],["find",["G2147"]],["grace",["G5485"]],["to help",["G996"]],["in",["G1519"]],["time of need.",[]]]}]}