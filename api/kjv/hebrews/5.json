{"book":"Hebrews","chapter":5,"translation":"KJV","url":"/bible/hebrews/5","verses":[{"verse":1,"text":"For every high priest taken from among men is ordained for men in things pertaining to God, that he may offer both gifts and sacrifices for sins:","words":[["For",["G1063"]],["every",["G3956"]],["high priest",["G749"]],["taken",["G2983"]],["from among",["G1537"]],["men",["G444"]],["is ordained",["G2525"]],["for",["G5228"]],["men",["G444"]],["in things pertaining to",["G4314"]],["God,",["G2316"]],["that",["G2443"]],["he may offer",["G4374"]],["both",["G5037"]],["gifts",["G1435"]],["and",["G2532"]],["sacrifices",["G2378"]],["for",["G5228"]],["sins:",[]]]},{"verse":2,"text":"Who can have compassion on the ignorant, and on them that are out of the way; for that he himself also is compassed with infirmity.","words":[["Who can",["G1410"]],["have compassion",["G3356"]],["on the ignorant,",["G50"]],["and",["G2532"]],["on them that are out of the way;",["G4105"]],["for",["G1893"]],["that he",["G4029"]],["himself",["G846"]],["also",["G2532"]],["is compassed",["G4029"]],["with infirmity.",[]]]},{"verse":3,"text":"And by reason hereof he ought, as for the people, so also for himself, to offer for sins.","words":[["And",["G2532"]],["by reason",["G1223"]],["hereof",["G5026"]],["he ought,",["G3784"]],["as",["G2531"]],["for",["G4012"]],["the people,",["G2992"]],["so",["G3779"]],["also",["G2532"]],["for",["G4012"]],["himself,",["G1438"]],["to offer",["G4374"]],["for",["G5228"]],["sins.",[]]]},{"verse":4,"text":"And no man taketh this honour unto himself, but he that is called of God, as was Aaron.","words":[["And",["G2532"]],["no",["G3756"]],["man",["G5100"]],["taketh",["G2983"]],["this honour",["G5092"]],["unto himself,",["G1438"]],["but",["G235"]],["he that is called",["G2564"]],["of",["G5259"]],["God,",["G2316"]],["as",["G2509","G2532"]],["was Aaron.",[]]]},{"verse":5,"text":"So also Christ glorified not himself to be made an high priest; but he that said unto him, Thou art my Son, to day have I begotten thee.","words":[["So",["G3779"]],["also",["G2532"]],["Christ",["G5547"]],["glorified",["G1392"]],["not",["G3756"]],["himself",["G1438"]],["to be made",["G1096"]],["an high priest;",["G749"]],["but",["G235"]],["he that said",["G2980"]],["unto",["G4314"]],["him,",["G846"]],["Thou",["G4771"]],["art",["G1488"]],["my",["G3450"]],["Son,",["G5207"]],["to day",["G4594"]],["have",["G1080"]],["I",["G1473"]],["begotten",["G1080"]],["thee.",[]]]},{"verse":6,"text":"As he saith also in another place, Thou art a priest for ever after the order of Melchisedec.","words":[["As",["G2531"]],["he saith",["G3004"]],["also",["G2532"]],["in",["G1722"]],["another",["G2087"]],["place, Thou",["G4771"]],["art a priest",["G2409"]],["for",["G1519"]],["ever",["G165"]],["after",["G2596"]],["the order",["G5010"]],["of Melchisedec.",[]]]},{"verse":7,"text":"Who in the days of his flesh, when he had offered up prayers and supplications with strong crying and tears unto him that was able to save him from death, and was heard in that he feared;","words":[["Who",["G3739"]],["in",["G1722"]],["the days",["G2250"]],["of his",["G846"]],["flesh,",["G4561"]],["when he had offered up",["G4374"]],["prayers",["G1162"]],["and",["G5037","G2532"]],["supplications",["G2428"]],["with",["G3326"]],["strong",["G2478"]],["crying",["G2906"]],["and",["G2532"]],["tears",["G1144"]],["unto",["G4314"]],["him that was able",["G1410"]],["to save",["G4982"]],["him",["G846"]],["from",["G1537"]],["death,",["G2288"]],["and",["G2532"]],["was heard",["G1522"]],["in that",["G575"]],["he feared;",[]]]},{"verse":8,"text":"Though he were a Son, yet learned he obedience by the things which he suffered;","words":[["Though",["G2539"]],["he were",["G5607"]],["a Son,",["G5207"]],["yet learned he",["G3129"]],["obedience",["G5218"]],["by",["G575"]],["the things which",["G3739"]],["he suffered;",[]]]},{"verse":9,"text":"And being made perfect, he became the author of eternal salvation unto all them that obey him;","words":[["And",["G2532"]],["being made perfect,",["G5048"]],["he became",["G1096"]],["the author",["G159"]],["of eternal",["G166"]],["salvation",["G4991"]],["unto all",["G3956"]],["them that obey",["G5219"]],["him;",[]]]},{"verse":10,"text":"Called of God an high priest after the order of Melchisedec.","words":[["Called",["G4316"]],["of",["G5259"]],["God",["G2316"]],["an high priest",["G749"]],["after",["G2596"]],["the order",["G5010"]],["of Melchisedec.",[]]]},{"verse":11,"text":"Of whom we have many things to say, and hard to be uttered, seeing ye are dull of hearing.","words":[["Of",["G4012"]],["whom",["G3739"]],["we",["G2254"]],["have",["G3056"]],["many things",["G4183"]],["to say,",["G3056"]],["and",["G2532"]],["hard",["G1421"]],["to be uttered,",["G3004"]],["seeing",["G1893"]],["ye are",["G1096"]],["dull",["G3576"]],["of hearing.",[]]]},{"verse":12,"text":"For when for the time ye ought to be teachers, ye have need that one teach you again which be the first principles of the oracles of God; and are become such as have need of milk, and not of strong meat.","words":[["For",["G2532","G1063"]],["when for",["G1223"]],["the time",["G5550"]],["ye ought",["G3784"]],["to be",["G1511"]],["teachers,",["G1320"]],["ye have",["G2192"]],["need",["G5532"]],["that one teach",["G1321"]],["you",["G5209"]],["again",["G3825"]],["which",["G5101"]],["be the first",["G746"]],["principles",["G4747"]],["of the oracles",["G3051"]],["of God;",["G2316"]],["and",["G2532"]],["are become such as",["G1096"]],["have",["G2192"]],["need",["G5532"]],["of milk,",["G1051"]],["and",["G2532"]],["not",["G3756"]],["of strong",["G4731"]],["meat.",[]]]},{"verse":13,"text":"For every one that useth milk is unskilful in the word of righteousness: for he is a babe.","words":[["For",["G1063"]],["every one",["G3956"]],["that useth",["G3348"]],["milk",["G1051"]],["is unskilful",["G552"]],["in the word",["G3056"]],["of righteousness:",["G1343"]],["for",["G1063"]],["he is",["G2076"]],["a babe.",[]]]},{"verse":14,"text":"But strong meat belongeth to them that are of full age, even those who by reason of use have their senses exercised to discern both good and evil.","words":[["But",["G1161"]],["strong",["G4731"]],["meat",["G5160"]],["belongeth to them that are",["G2076"]],["of full age,",["G5046"]],["even those who by reason",["G1223"]],["of use",["G1838"]],["have",["G2192"]],["their senses",["G145"]],["exercised",["G1128"]],["to",["G4314"]],["discern",["G1253"]],["both",["G5037"]],["good",["G2570"]],["and",["G2532"]],["evil.",[]]]}]}