{"book":"Hebrews","chapter":7,"translation":"KJV","url":"/bible/hebrews/7","verses":[{"verse":1,"text":"For this Melchisedec, king of Salem, priest of the most high God, who met Abraham returning from the slaughter of the kings, and blessed him;","words":[["For",["G1063"]],["this",["G3778"]],["Melchisedec,",["G3198"]],["king",["G935"]],["of Salem,",["G4532"]],["priest",["G2409"]],["of the most high",["G5310"]],["God,",["G2316"]],["who",["G3588"]],["met",["G4876"]],["Abraham",["G11"]],["returning",["G5290"]],["from",["G575"]],["the slaughter",["G2871"]],["of the kings,",["G935"]],["and",["G2532"]],["blessed",["G2127"]],["him;",[]]]},{"verse":2,"text":"To whom also Abraham gave a tenth part of all; first being by interpretation King of righteousness, and after that also King of Salem, which is, King of peace;","words":[["To whom",["G3739"]],["also",["G2532"]],["Abraham",["G11"]],["gave",["G3307"]],["a tenth part",["G1181"]],["of",["G575"]],["all;",["G3956"]],["first",["G4412","G3303"]],["being by interpretation",["G2059"]],["King",["G935"]],["of righteousness,",["G1343"]],["and",["G1161"]],["after that",["G1899"]],["also",["G2532"]],["King",["G935"]],["of Salem,",["G4532"]],["which is,",["G3603"]],["King",["G935"]],["of peace;",[]]]},{"verse":3,"text":"Without father, without mother, without descent, having neither beginning of days, nor end of life; but made like unto the Son of God; abideth a priest continually.","words":[["Without father,",["G540"]],["without mother,",["G282"]],["without descent,",["G35"]],["having",["G2192"]],["neither",["G3383"]],["beginning",["G746"]],["of days,",["G2250"]],["nor",["G3383"]],["end",["G5056"]],["of life;",["G2222"]],["but",["G1161"]],["made like",["G871"]],["unto the Son",["G5207"]],["of God;",["G2316"]],["abideth",["G3306"]],["a priest",["G2409"]],["continually.",["G1519"]]]},{"verse":4,"text":"Now consider how great this man was, unto whom even the patriarch Abraham gave the tenth of the spoils.","words":[["Now",["G1161"]],["consider",["G2334"]],["how great",["G4080"]],["this man",["G3778"]],["was, unto whom",["G3739"]],["even",["G2532"]],["the patriarch",["G3966"]],["Abraham",["G11"]],["gave",["G1325"]],["the tenth",["G1181"]],["of",["G1537"]],["the spoils.",[]]]},{"verse":5,"text":"And verily they that are of the sons of Levi, who receive the office of the priesthood, have a commandment to take tithes of the people according to the law, that is, of their brethren, though they come out of the loins of Abraham:","words":[["And",["G2532"]],["verily",["G3303"]],["they that are of",["G1537"]],["the sons",["G5207"]],["of Levi,",["G3017"]],["who",["G3588"]],["receive",["G2983"]],["the office of the priesthood,",["G2405"]],["have",["G2192"]],["a commandment",["G1785"]],["to take tithes",["G586"]],["of the people",["G2992"]],["according to",["G2596"]],["the law,",["G3551"]],["that is,",["G5123"]],["of their",["G846"]],["brethren,",["G80"]],["though",["G2539"]],["they come",["G1831"]],["out of",["G1537"]],["the loins",["G3751"]],["of Abraham:",[]]]},{"verse":6,"text":"But he whose descent is not counted from them received tithes of Abraham, and blessed him that had the promises.","words":[["But",["G1161"]],["he whose descent is",["G1075"]],["not",["G3361"]],["counted",["G1075"]],["from",["G1537"]],["them",["G846"]],["received tithes",["G1183"]],["of Abraham,",["G11"]],["and",["G2532"]],["blessed",["G2127"]],["him that had",["G2192"]],["the promises.",[]]]},{"verse":7,"text":"And without all contradiction the less is blessed of the better.","words":[["And",["G1161"]],["without",["G5565"]],["all",["G3956"]],["contradiction",["G485"]],["the less",["G1640"]],["is blessed",["G2127"]],["of",["G5259"]],["the better.",[]]]},{"verse":8,"text":"And here men that die receive tithes; but there he receiveth them, of whom it is witnessed that he liveth.","words":[["And",["G2532"]],["here",["G5602","G3303"]],["men",["G444"]],["that die",["G599"]],["receive",["G2983"]],["tithes;",["G1181"]],["but",["G1161"]],["there",["G1563"]],["he receiveth them, of whom it is witnessed",["G3140"]],["that",["G3754"]],["he liveth.",[]]]},{"verse":9,"text":"And as I may so say, Levi also, who receiveth tithes, payed tithes in Abraham.","words":[["And",["G2532"]],["as",["G5613"]],["I may so say,",["G2031","G2036"]],["Levi",["G3017"]],["also,",["G2532"]],["who",["G3588"]],["receiveth",["G2983"]],["tithes,",["G1181"]],["payed tithes",["G1183"]],["in",["G1223"]],["Abraham.",[]]]},{"verse":10,"text":"For he was yet in the loins of his father, when Melchisedec met him.","words":[["For",["G1063"]],["he was",["G2258"]],["yet",["G2089"]],["in",["G1722"]],["the loins",["G3751"]],["of his father,",["G3962"]],["when",["G3753"]],["Melchisedec",["G3198"]],["met",["G4876"]],["him.",[]]]},{"verse":11,"text":"If therefore perfection were by the Levitical priesthood, (for under it the people received the law,) what further need was there that another priest should rise after the order of Melchisedec, and not be called after the order of Aaron?","words":[["If",["G1487","G3303"]],["therefore",["G3767"]],["perfection",["G5050"]],["were",["G2258"]],["by",["G1223"]],["the Levitical",["G3020"]],["priesthood,",["G2420"]],["(for",["G1063"]],["under",["G1909"]],["it",["G846"]],["the people",["G2992"]],["received the law,)",["G3549"]],["what",["G5101"]],["further",["G2089"]],["need",["G5532"]],["was there that another",["G2087"]],["priest",["G2409"]],["should rise",["G450"]],["after",["G2596"]],["the order",["G5010"]],["of Melchisedec,",["G3198"]],["and",["G2532"]],["not",["G3756"]],["be called",["G3004"]],["after",["G2596"]],["the order",["G5010"]],["of Aaron?",[]]]},{"verse":12,"text":"For the priesthood being changed, there is made of necessity a change also of the law.","words":[["For",["G1063"]],["the priesthood",["G2420"]],["being changed,",["G3346"]],["there is made",["G1096"]],["of",["G1537"]],["necessity",["G318"]],["a change",["G3331"]],["also",["G2532"]],["of the law.",[]]]},{"verse":13,"text":"For he of whom these things are spoken pertaineth to another tribe, of which no man gave attendance at the altar.","words":[["For",["G1063"]],["he of",["G1909"]],["whom",["G3739"]],["these things",["G5023"]],["are spoken",["G3004"]],["pertaineth",["G3348"]],["to another",["G2087"]],["tribe,",["G5443"]],["of",["G575"]],["which",["G3739"]],["no man",["G3762"]],["gave attendance",["G4337"]],["at the altar.",[]]]},{"verse":14,"text":"For it is evident that our Lord sprang out of Juda; of which tribe Moses spake nothing concerning priesthood.","words":[["For",["G1063"]],["it is evident",["G4271"]],["that",["G3754"]],["our",["G2257"]],["Lord",["G2962"]],["sprang",["G393"]],["out of",["G1537"]],["Juda;",["G2455"]],["of",["G1519"]],["which",["G3739"]],["tribe",["G5443"]],["Moses",["G3475"]],["spake",["G2980"]],["nothing",["G3762"]],["concerning",["G4012"]],["priesthood.",[]]]},{"verse":15,"text":"And it is yet far more evident: for that after the similitude of Melchisedec there ariseth another priest,","words":[["And",["G2532"]],["it is",["G2076"]],["yet",["G2089"]],["far more",["G4054"]],["evident:",["G2612"]],["for",["G1487"]],["that after",["G2596"]],["the similitude",["G3665"]],["of Melchisedec",["G3198"]],["there ariseth",["G450"]],["another",["G2087"]],["priest,",[]]]},{"verse":16,"text":"Who is made, not after the law of a carnal commandment, but after the power of an endless life.","words":[["Who",["G3739"]],["is made,",["G1096"]],["not",["G3756"]],["after",["G2596"]],["the law",["G3551"]],["of a carnal",["G4559"]],["commandment,",["G1785"]],["but",["G235"]],["after",["G2596"]],["the power",["G1411"]],["of an endless",["G179"]],["life.",[]]]},{"verse":17,"text":"For he testifieth, Thou art a priest for ever after the order of Melchisedec.","words":[["For",["G1063"]],["he testifieth,",["G3140","G3754"]],["Thou",["G4771"]],["art a priest",["G2409"]],["for",["G1519"]],["ever",["G165"]],["after",["G2596"]],["the order",["G5010"]],["of Melchisedec.",[]]]},{"verse":18,"text":"For there is verily a disannulling of the commandment going before for the weakness and unprofitableness thereof.","words":[["For",["G1063"]],["there is",["G1096"]],["verily",["G3303"]],["a disannulling",["G115"]],["of the commandment",["G1785"]],["going before",["G4254"]],["for",["G1223"]],["the weakness",["G772"]],["and",["G2532"]],["unprofitableness",["G512"]],["thereof.",[]]]},{"verse":19,"text":"For the law made nothing perfect, but the bringing in of a better hope did; by the which we draw nigh unto God.","words":[["For",["G1063"]],["the law",["G3551"]],["made",["G5048"]],["nothing",["G3762"]],["perfect,",["G5048"]],["but",["G1161"]],["the bringing in",["G1898"]],["of a better",["G2909"]],["hope",["G1680"]],["did; by",["G1223"]],["the which",["G3739"]],["we draw nigh",["G1448"]],["unto God.",[]]]},{"verse":20,"text":"And inasmuch as not without an oath he was made priest:","words":[["And",["G2532"]],["inasmuch as",["G2596","G3745"]],["not",["G3756"]],["without",["G5565"]],["an oath he was made priest:",[]]]},{"verse":21,"text":"(For those priests were made without an oath; but this with an oath by him that said unto him, The Lord sware and will not repent, Thou art a priest for ever after the order of Melchisedec:)","words":[["(For",["G1063"]],["those priests",["G2409"]],["were",["G3303","G1526"]],["made",["G1096"]],["without",["G5565"]],["an oath;",["G3728"]],["but",["G1161"]],["this with",["G3326"]],["an oath",["G3728"]],["by",["G1223"]],["him that said",["G3004"]],["unto",["G4314"]],["him,",["G846"]],["The Lord",["G2962"]],["sware",["G3660"]],["and",["G2532"]],["will",["G3338"]],["not",["G3756"]],["repent,",["G3338"]],["Thou",["G4771"]],["art a priest",["G2409"]],["for",["G1519"]],["ever",["G165"]],["after",["G2596"]],["the order",["G5010"]],["of Melchisedec:)",[]]]},{"verse":22,"text":"By so much was Jesus made a surety of a better testament.","words":[["By",["G2596"]],["so much",["G5118"]],["was",["G1096"]],["Jesus",["G2424"]],["made",["G1096"]],["a surety",["G1450"]],["of a better",["G2909"]],["testament.",[]]]},{"verse":23,"text":"And they truly were many priests, because they were not suffered to continue by reason of death:","words":[["And",["G2532"]],["they",["G1526"]],["truly",["G3303"]],["were",["G1526","G1096"]],["many",["G4119"]],["priests,",["G2409"]],["because they were not suffered",["G2967"]],["to continue",["G3887"]],["by reason of",["G1223"]],["death:",[]]]},{"verse":24,"text":"But this man, because he continueth ever, hath an unchangeable priesthood.","words":[["But",["G1161"]],["this man, because",["G1223"]],["he",["G846"]],["continueth",["G3306"]],["ever,",["G1519","G165"]],["hath",["G2192"]],["an unchangeable",["G531"]],["priesthood.",[]]]},{"verse":25,"text":"Wherefore he is able also to save them to the uttermost that come unto God by him, seeing he ever liveth to make intercession for them.","words":[["Wherefore",["G3606"]],["he is able",["G1410"]],["also",["G2532"]],["to save them",["G4982"]],["to",["G1519"]],["the uttermost",["G3838"]],["that come",["G4334"]],["unto God",["G2316"]],["by",["G1223"]],["him,",["G846"]],["seeing he ever",["G3842"]],["liveth",["G2198"]],["to",["G1519"]],["make intercession",["G1793"]],["for",["G5228"]],["them.",[]]]},{"verse":26,"text":"For such an high priest became us, who is holy, harmless, undefiled, separate from sinners, and made higher than the heavens;","words":[["For",["G1063"]],["such",["G5108"]],["an high priest",["G749"]],["became",["G4241"]],["us,",["G2254"]],["who is holy,",["G3741"]],["harmless,",["G172"]],["undefiled,",["G283"]],["separate",["G5563"]],["from",["G575"]],["sinners,",["G268"]],["and",["G2532"]],["made",["G1096"]],["higher than",["G5308"]],["the heavens;",[]]]},{"verse":27,"text":"Who needeth not daily, as those high priests, to offer up sacrifice, first for his own sins, and then for the people’s: for this he did once, when he offered up himself.","words":[["Who",["G3739"]],["needeth",["G2192","G318"]],["not",["G3756"]],["daily,",["G2596","G2250"]],["as",["G5618"]],["those high priests,",["G749"]],["to offer up",["G399"]],["sacrifice,",["G2378"]],["first",["G4386"]],["for",["G5228"]],["his own",["G2398"]],["sins,",["G266"]],["and then",["G1899"]],["for the people’s: for",["G1063"]],["this",["G5124"]],["he did",["G4160"]],["once,",["G2178"]],["when he offered up",["G399"]],["himself.",[]]]},{"verse":28,"text":"For the law maketh men high priests which have infirmity; but the word of the oath, which was since the law, maketh the Son, who is consecrated for evermore.","words":[["For",["G1063"]],["the law",["G3551"]],["maketh",["G2525"]],["men",["G444"]],["high priests",["G749"]],["which have",["G2192"]],["infirmity;",["G769"]],["but",["G1161"]],["the word",["G3056"]],["of the oath,",["G3728"]],["which",["G3588"]],["was since",["G3326"]],["the law,",["G3551"]],["maketh the Son,",["G5207"]],["who is consecrated",["G5048"]],["for",["G1519"]],["evermore.",[]]]}]}