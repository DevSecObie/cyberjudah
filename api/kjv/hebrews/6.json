{"book":"Hebrews","chapter":6,"translation":"KJV","url":"/bible/hebrews/6","verses":[{"verse":1,"text":"Therefore leaving the principles of the doctrine of Christ, let us go on unto perfection; not laying again the foundation of repentance from dead works, and of faith toward God,","words":[["Therefore",["G1352"]],["leaving",["G863"]],["the principles",["G746"]],["of the doctrine",["G3056"]],["of Christ,",["G5547"]],["let us go on",["G5342"]],["unto",["G1909"]],["perfection;",["G5047"]],["not",["G3361"]],["laying",["G2598"]],["again",["G3825"]],["the foundation",["G2310"]],["of repentance",["G3341"]],["from",["G575"]],["dead",["G3498"]],["works,",["G2041"]],["and",["G2532"]],["of faith",["G4102"]],["toward",["G1909"]],["God,",[]]]},{"verse":2,"text":"Of the doctrine of baptisms, and of laying on of hands, and of resurrection of the dead, and of eternal judgment.","words":[["Of the doctrine",["G1322"]],["of baptisms,",["G909"]],["and",["G5037"]],["of laying on",["G1936"]],["of hands,",["G5495"]],["and",["G5037"]],["of resurrection",["G386"]],["of the dead,",["G3498"]],["and",["G2532"]],["of eternal",["G166"]],["judgment.",[]]]},{"verse":3,"text":"And this will we do, if God permit.","words":[["And",["G2532"]],["this",["G5124"]],["will we do,",["G4160"]],["if",["G1437","G4007"]],["God",["G2316"]],["permit.",[]]]},{"verse":4,"text":"For it is impossible for those who were once enlightened, and have tasted of the heavenly gift, and were made partakers of the Holy Ghost,","words":[["For",["G1063"]],["it is impossible",["G102"]],["for those who were once",["G530"]],["enlightened,",["G5461"]],["and",["G5037"]],["have tasted",["G1089"]],["of the heavenly",["G2032"]],["gift,",["G1431"]],["and",["G2532"]],["were made",["G1096"]],["partakers",["G3353"]],["of the Holy",["G40"]],["Ghost,",[]]]},{"verse":5,"text":"And have tasted the good word of God, and the powers of the world to come,","words":[["And",["G2532"]],["have tasted",["G1089"]],["the good",["G2570"]],["word",["G4487"]],["of God,",["G2316"]],["and",["G5037"]],["the powers",["G1411"]],["of the world",["G165"]],["to come,",[]]]},{"verse":6,"text":"If they shall fall away, to renew them again unto repentance; seeing they crucify to themselves the Son of God afresh, and put him to an open shame.","words":[["If",["G2532"]],["they shall fall away,",["G3895"]],["to renew them",["G340"]],["again",["G3825"]],["unto",["G1519"]],["repentance;",["G3341"]],["seeing they crucify",["G388"]],["to themselves",["G1438"]],["the Son",["G5207"]],["of God",["G2316"]],["afresh,",["G388"]],["and",["G2532"]],["put him to an open shame.",[]]]},{"verse":7,"text":"For the earth which drinketh in the rain that cometh oft upon it, and bringeth forth herbs meet for them by whom it is dressed, receiveth blessing from God:","words":[["For",["G1063"]],["the earth",["G1093"]],["which",["G3588"]],["drinketh in",["G4095"]],["the rain",["G5205"]],["that cometh",["G2064"]],["oft",["G4178"]],["upon",["G1909"]],["it,",["G846"]],["and",["G2532"]],["bringeth forth",["G5088"]],["herbs",["G1008"]],["meet",["G2111"]],["for them",["G1565","G2532"]],["by",["G1223"]],["whom",["G3739"]],["it is dressed,",["G1090"]],["receiveth",["G3335"]],["blessing",["G2129"]],["from",["G575"]],["God:",[]]]},{"verse":8,"text":"But that which beareth thorns and briers is rejected, and is nigh unto cursing; whose end is to be burned.","words":[["But",["G1161"]],["that which beareth",["G1627"]],["thorns",["G173"]],["and",["G2532"]],["briers",["G5146"]],["is rejected,",["G96"]],["and",["G2532"]],["is nigh",["G1451"]],["unto cursing;",["G2671"]],["whose",["G3739"]],["end",["G5056"]],["is to",["G1519"]],["be burned.",[]]]},{"verse":9,"text":"But, beloved, we are persuaded better things of you, and things that accompany salvation, though we thus speak.","words":[["But,",["G1161"]],["beloved,",["G27"]],["we are persuaded",["G3982"]],["better things",["G2909"]],["of",["G4012"]],["you,",["G5216"]],["and",["G2532"]],["things that accompany",["G2192"]],["salvation,",["G4991"]],["though",["G1499"]],["we",["G2980"]],["thus",["G3779"]],["speak.",[]]]},{"verse":10,"text":"For God is not unrighteous to forget your work and labour of love, which ye have shewed toward his name, in that ye have ministered to the saints, and do minister.","words":[["For",["G1063"]],["God",["G2316"]],["is not",["G3756"]],["unrighteous",["G94"]],["to forget",["G1950"]],["your",["G5216"]],["work",["G2041"]],["and",["G2532"]],["labour",["G2873"]],["of love,",["G26"]],["which",["G3739"]],["ye have shewed",["G1731","G1731"]],["toward",["G1519"]],["his",["G846"]],["name,",["G3686"]],["in that ye have ministered",["G1247"]],["to the saints,",["G40"]],["and",["G2532"]],["do minister.",[]]]},{"verse":11,"text":"And we desire that every one of you do shew the same diligence to the full assurance of hope unto the end:","words":[["And",["G1161"]],["we desire",["G1937"]],["that every one",["G1538"]],["of you",["G5216"]],["do shew",["G1731"]],["the same",["G846"]],["diligence",["G4710"]],["to",["G4314"]],["the full assurance",["G4136"]],["of hope",["G1680"]],["unto",["G891"]],["the end:",[]]]},{"verse":12,"text":"That ye be not slothful, but followers of them who through faith and patience inherit the promises.","words":[["That",["G3363"]],["ye be",["G1096"]],["not",["G3363"]],["slothful,",["G3576"]],["but",["G1161"]],["followers",["G3402"]],["of them who through",["G1223"]],["faith",["G4102"]],["and",["G2532"]],["patience",["G3115"]],["inherit",["G2816"]],["the promises.",[]]]},{"verse":13,"text":"For when God made promise to Abraham, because he could swear by no greater, he sware by himself,","words":[["For",["G1063"]],["when God",["G2316"]],["made promise",["G1861"]],["to Abraham,",["G11"]],["because",["G1893"]],["he could",["G2192"]],["swear",["G3660"]],["by",["G2596"]],["no",["G3762"]],["greater,",["G3187"]],["he sware",["G3660"]],["by",["G2596"]],["himself,",[]]]},{"verse":14,"text":"Saying, Surely blessing I will bless thee, and multiplying I will multiply thee.","words":[["Saying,",["G3004"]],["Surely",["G2229","G3375"]],["blessing",["G2127"]],["I will bless",["G2127"]],["thee,",["G4571"]],["and",["G2532"]],["multiplying",["G4129"]],["I will multiply",["G4129"]],["thee.",[]]]},{"verse":15,"text":"And so, after he had patiently endured, he obtained the promise.","words":[["And",["G2532"]],["so,",["G3779"]],["after he had patiently endured,",["G3114"]],["he obtained",["G2013"]],["the promise.",[]]]},{"verse":16,"text":"For men verily swear by the greater: and an oath for confirmation is to them an end of all strife.","words":[["For",["G1063"]],["men",["G444"]],["verily",["G3303"]],["swear",["G3660"]],["by",["G2596"]],["the greater:",["G3187"]],["and",["G2532"]],["an oath",["G3727"]],["for",["G1519"]],["confirmation",["G951"]],["is to them",["G846"]],["an end",["G4009"]],["of all",["G3956"]],["strife.",[]]]},{"verse":17,"text":"Wherein God, willing more abundantly to shew unto the heirs of promise the immutability of his counsel, confirmed it by an oath:","words":[["Wherein",["G1722","G3739"]],["God,",["G2316"]],["willing",["G1014"]],["more abundantly",["G4054"]],["to shew",["G1925"]],["unto the heirs",["G2818"]],["of promise",["G1860"]],["the immutability",["G276"]],["of his",["G846"]],["counsel,",["G1012"]],["confirmed",["G3315"]],["it by an oath:",[]]]},{"verse":18,"text":"That by two immutable things, in which it was impossible for God to lie, we might have a strong consolation, who have fled for refuge to lay hold upon the hope set before us:","words":[["That",["G2443"]],["by",["G1223"]],["two",["G1417"]],["immutable",["G276"]],["things,",["G4229"]],["in",["G1722"]],["which",["G3739"]],["it was impossible",["G102"]],["for God",["G2316"]],["to lie,",["G5574"]],["we might have",["G2192"]],["a strong",["G2478"]],["consolation,",["G3874"]],["who",["G3588"]],["have fled for refuge",["G2703"]],["to lay hold",["G2902"]],["upon the hope",["G1680"]],["set before us:",[]]]},{"verse":19,"text":"Which hope we have as an anchor of the soul, both sure and stedfast, and which entereth into that within the veil;","words":[["Which",["G3739"]],["hope we have",["G2192"]],["as",["G5613"]],["an anchor",["G45"]],["of the soul,",["G5590"]],["both",["G5037"]],["sure",["G804"]],["and",["G2532"]],["stedfast,",["G949"]],["and",["G2532"]],["which entereth",["G1525"]],["into",["G1519"]],["that within",["G2082"]],["the veil;",[]]]},{"verse":20,"text":"Whither the forerunner is for us entered, even Jesus, made an high priest for ever after the order of Melchisedec.","words":[["Whither",["G3699"]],["the forerunner",["G4274"]],["is",["G1525"]],["for",["G5228"]],["us",["G2257"]],["entered,",["G1525"]],["even Jesus,",["G2424"]],["made",["G1096"]],["an high priest",["G749"]],["for",["G1519"]],["ever",["G165"]],["after",["G2596"]],["the order",["G5010"]],["of Melchisedec.",[]]]}]}