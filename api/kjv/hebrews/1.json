{"book":"Hebrews","chapter":1,"translation":"KJV","url":"/bible/hebrews/1","verses":[{"verse":1,"text":"God, who at sundry times and in divers manners spake in time past unto the fathers by the prophets,","words":[["God,",["G2316"]],["who at sundry times",["G4181"]],["and",["G2532"]],["in divers manners",["G4187"]],["spake",["G2980"]],["in time past",["G3819"]],["unto the fathers",["G3962"]],["by",["G1722"]],["the prophets,",[]]]},{"verse":2,"text":"Hath in these last days spoken unto us by his Son, whom he hath appointed heir of all things, by whom also he made the worlds;","words":[["Hath",["G2980"]],["in",["G1909"]],["these",["G5130"]],["last",["G2078"]],["days",["G2250"]],["spoken",["G2980"]],["unto us",["G2254"]],["by",["G1722"]],["his Son,",["G5207"]],["whom",["G3739"]],["he hath appointed",["G5087"]],["heir",["G2818"]],["of all things,",["G3956"]],["by",["G1223"]],["whom",["G3739"]],["also",["G2532"]],["he made",["G4160"]],["the worlds;",[]]]},{"verse":3,"text":"Who being the brightness of his glory, and the express image of his person, and upholding all things by the word of his power, when he had by himself purged our sins, sat down on the right hand of the Majesty on high;","words":[["Who",["G3739"]],["being",["G5607"]],["the brightness",["G541"]],["of his glory,",["G1391"]],["and",["G2532"]],["the express image",["G5481"]],["of his",["G846"]],["person,",["G5287"]],["and",["G5037"]],["upholding",["G5342"]],["all things",["G3956"]],["by the word",["G4487"]],["of his",["G846"]],["power,",["G1411"]],["when he had",["G4160","G2512"]],["by",["G1223"]],["himself",["G1438"]],["purged",["G4160","G2512"]],["our",["G2257"]],["sins,",["G266"]],["sat down",["G2523"]],["on",["G1722"]],["the right hand",["G1188"]],["of the Majesty",["G3172"]],["on",["G1722"]],["high;",[]]]},{"verse":4,"text":"Being made so much better than the angels, as he hath by inheritance obtained a more excellent name than they.","words":[["Being made",["G1096"]],["so much",["G5118"]],["better than",["G2909"]],["the angels,",["G32"]],["as",["G3745"]],["he hath by inheritance obtained",["G2816"]],["a more excellent",["G1313"]],["name",["G3686"]],["than",["G3844"]],["they.",[]]]},{"verse":5,"text":"For unto which of the angels said he at any time, Thou art my Son, this day have I begotten thee? And again, I will be to him a Father, and he shall be to me a Son?","words":[["For",["G1063"]],["unto which",["G5101"]],["of the angels",["G32"]],["said he",["G2036"]],["at any time,",["G4218"]],["Thou",["G4771"]],["art",["G1488"]],["my",["G3450"]],["Son,",["G5207"]],["this day",["G4594"]],["have",["G1080"]],["I",["G1473"]],["begotten",["G1080"]],["thee?",["G4571"]],["And",["G2532"]],["again,",["G3825"]],["I",["G1473"]],["will be",["G2071"]],["to",["G1519"]],["him",["G846"]],["a Father,",["G3962"]],["and",["G2532"]],["he",["G846"]],["shall be",["G2071"]],["to",["G1519"]],["me",["G3427"]],["a Son?",[]]]},{"verse":6,"text":"And again, when he bringeth in the firstbegotten into the world, he saith, And let all the angels of God worship him.","words":[["And",["G1161"]],["again,",["G3825"]],["when",["G3752"]],["he bringeth in",["G1521"]],["the firstbegotten",["G4416"]],["into",["G1519"]],["the world,",["G3625"]],["he saith,",["G3004"]],["And",["G2532"]],["let",["G4352"]],["all",["G3956"]],["the angels",["G32"]],["of God",["G2316"]],["worship",["G4352"]],["him.",[]]]},{"verse":7,"text":"And of the angels he saith, Who maketh his angels spirits, and his ministers a flame of fire.","words":[["And",["G2532"]],["of",["G4314","G3303"]],["the angels",["G32"]],["he saith,",["G3004"]],["Who maketh",["G4160"]],["his",["G846"]],["angels",["G32"]],["spirits,",["G4151"]],["and",["G2532"]],["his",["G846"]],["ministers",["G3011"]],["a flame",["G5395"]],["of fire.",[]]]},{"verse":8,"text":"But unto the Son he saith, Thy throne, O God, is for ever and ever: a sceptre of righteousness is the sceptre of thy kingdom.","words":[["But",["G1161"]],["unto",["G4314"]],["the Son",["G5207"]],["he saith, Thy",["G4675"]],["throne,",["G2362"]],["O God,",["G2316"]],["is for",["G1519"]],["ever",["G165"]],["and ever:",["G165"]],["a sceptre",["G4464"]],["of righteousness",["G2118"]],["is the sceptre",["G4464"]],["of thy",["G4675"]],["kingdom.",[]]]},{"verse":9,"text":"Thou hast loved righteousness, and hated iniquity; therefore God, even thy God, hath anointed thee with the oil of gladness above thy fellows.","words":[["Thou hast loved",["G25"]],["righteousness,",["G1343"]],["and",["G2532"]],["hated",["G3404"]],["iniquity;",["G458"]],["therefore",["G1223","G5124"]],["God,",["G2316"]],["even thy",["G4675"]],["God,",["G2316"]],["hath anointed",["G5548"]],["thee",["G4571"]],["with the oil",["G1637"]],["of gladness",["G20"]],["above",["G3844"]],["thy",["G4675"]],["fellows.",[]]]},{"verse":10,"text":"And, Thou, Lord, in the beginning hast laid the foundation of the earth; and the heavens are the works of thine hands:","words":[["And,",["G2532"]],["Thou,",["G4771"]],["Lord,",["G2962"]],["in",["G2596"]],["the beginning",["G746"]],["hast laid the foundation",["G2311"]],["of the earth;",["G1093"]],["and",["G2532"]],["the heavens",["G3772"]],["are",["G1526"]],["the works",["G2041"]],["of thine",["G4675"]],["hands:",[]]]},{"verse":11,"text":"They shall perish; but thou remainest; and they all shall wax old as doth a garment;","words":[["They",["G846"]],["shall perish;",["G622"]],["but",["G1161"]],["thou",["G4771"]],["remainest;",["G1265"]],["and",["G2532"]],["they all",["G3956"]],["shall wax old",["G3822"]],["as",["G5613"]],["doth a garment;",[]]]},{"verse":12,"text":"And as a vesture shalt thou fold them up, and they shall be changed: but thou art the same, and thy years shall not fail.","words":[["And",["G2532"]],["as",["G5616"]],["a vesture",["G4018"]],["shalt thou fold",["G1667"]],["them",["G846"]],["up,",["G1667"]],["and",["G2532"]],["they shall be changed:",["G236"]],["but",["G1161"]],["thou",["G4771"]],["art",["G1488"]],["the same,",["G846"]],["and",["G2532"]],["thy",["G4675"]],["years",["G2094"]],["shall",["G1587"]],["not",["G3756"]],["fail.",[]]]},{"verse":13,"text":"But to which of the angels said he at any time, Sit on my right hand, until I make thine enemies thy footstool?","words":[["But",["G1161"]],["to",["G4314"]],["which",["G5101"]],["of the angels",["G32"]],["said he",["G2046"]],["at any time,",["G4218"]],["Sit",["G2521"]],["on",["G1537"]],["my",["G3450"]],["right hand,",["G1188"]],["until",["G302","G2193"]],["I make",["G5087"]],["thine",["G4675"]],["enemies",["G2190"]],["thy",["G4675"]],["footstool?",["G5286"]]]},{"verse":14,"text":"Are they not all ministering spirits, sent forth to minister for them who shall be heirs of salvation?","words":[["Are they",["G1526"]],["not",["G3780"]],["all",["G3956"]],["ministering",["G3010"]],["spirits,",["G4151"]],["sent forth",["G649"]],["to",["G1519"]],["minister",["G1248"]],["for",["G1223"]],["them who shall",["G3195"]],["be heirs of",["G2816"]],["salvation?",[]]]}]}