{"book":"1 Peter","chapter":2,"translation":"KJV","url":"/bible/1-peter/2","verses":[{"verse":1,"text":"Wherefore laying aside all malice, and all guile, and hypocrisies, and envies, and all evil speakings,","words":[["Wherefore",["G3767"]],["laying aside",["G659"]],["all",["G3956"]],["malice,",["G2549"]],["and",["G2532"]],["all",["G3956"]],["guile,",["G1388"]],["and",["G2532"]],["hypocrisies,",["G5272"]],["and",["G2532"]],["envies,",["G5355"]],["and",["G2532"]],["all",["G3956"]],["evil speakings,",["G2636"]]]},{"verse":2,"text":"As newborn babes, desire the sincere milk of the word, that ye may grow thereby:","words":[["As",["G5613"]],["newborn",["G738"]],["babes,",["G1025"]],["desire",["G1971"]],["the sincere",["G97"]],["milk",["G1051"]],["of the word,",["G3050"]],["that",["G2443"]],["ye may grow",["G837"]],["thereby:",["G1722","G846"]]]},{"verse":3,"text":"If so be ye have tasted that the Lord is gracious.","words":[["If so be",["G1512"]],["ye have tasted",["G1089"]],["that",["G3754"]],["the Lord",["G2962"]],["is gracious.",["G5543"]]]},{"verse":4,"text":"To whom coming, as unto a living stone, disallowed indeed of men, but chosen of God, and precious,","words":[["To",["G4314"]],["whom",["G3739"]],["coming,",["G4334"]],["as unto a living",["G2198"]],["stone,",["G3037"]],["disallowed",["G593"]],["indeed",["G3303"]],["of",["G5259"]],["men,",["G444"]],["but",["G1161"]],["chosen",["G1588"]],["of",["G3844"]],["God,",["G2316"]],["and precious,",["G1784"]]]},{"verse":5,"text":"Ye also, as lively stones, are built up a spiritual house, an holy priesthood, to offer up spiritual sacrifices, acceptable to God by Jesus Christ.","words":[["Ye",["G846"]],["also,",["G2532"]],["as",["G5613"]],["lively",["G2198"]],["stones,",["G3037"]],["are built up",["G3618"]],["a spiritual",["G4152"]],["house,",["G3624"]],["an holy",["G40"]],["priesthood,",["G2406"]],["to offer up",["G399"]],["spiritual",["G4152"]],["sacrifices,",["G2378"]],["acceptable",["G2144"]],["to God",["G2316"]],["by",["G1223"]],["Jesus",["G2424"]],["Christ.",["G5547"]]]},{"verse":6,"text":"Wherefore also it is contained in the scripture, Behold, I lay in Sion a chief corner stone, elect, precious: and he that believeth on him shall not be confounded.","words":[["Wherefore",["G1352"]],["also",["G2532"]],["it is contained",["G4023"]],["in",["G1722"]],["the scripture,",["G1124"]],["Behold,",["G2400"]],["I lay",["G5087"]],["in",["G1722"]],["Sion",["G4622"]],["a chief corner",["G204"]],["stone,",["G3037"]],["elect,",["G1588"]],["precious:",["G1784"]],["and",["G2532"]],["he that believeth",["G4100"]],["on",["G1909"]],["him",["G846"]],["shall",["G2617"]],["not be",["G3364"]],["confounded.",["G2617"]]]},{"verse":7,"text":"Unto you therefore which believe he is precious: but unto them which be disobedient, the stone which the builders disallowed, the same is made the head of the corner,","words":[["Unto you",["G5213"]],["therefore",["G3767"]],["which",["G3588"]],["believe",["G4100"]],["he is precious:",["G5092"]],["but",["G1161"]],["unto them which be disobedient,",["G544"]],["the stone",["G3037"]],["which",["G3739"]],["the builders",["G3618"]],["disallowed,",["G593"]],["the same",["G3778"]],["is made",["G1096","G1519"]],["the head",["G2776"]],["of the corner,",["G1137"]]]},{"verse":8,"text":"And a stone of stumbling, and a rock of offence, even to them which stumble at the word, being disobedient: whereunto also they were appointed.","words":[["And",["G2532"]],["a stone",["G3037"]],["of stumbling,",["G4348"]],["and",["G2532"]],["a rock",["G4073"]],["of offence,",["G4625"]],["even to them which",["G3739"]],["stumble",["G4350"]],["at the word,",["G3056"]],["being disobedient:",["G544"]],["whereunto",["G1519","G3739"]],["also",["G2532"]],["they were appointed.",["G5087"]]]},{"verse":9,"text":"But ye are a chosen generation, a royal priesthood, an holy nation, a peculiar people; that ye should shew forth the praises of him who hath called you out of darkness into his marvellous light:","words":[["But",["G1161"]],["ye",["G5210"]],["are a chosen",["G1588"]],["generation,",["G1085"]],["a royal",["G934"]],["priesthood,",["G2406"]],["an holy",["G40"]],["nation,",["G1484"]],["a peculiar",["G1519","G4047"]],["people;",["G2992"]],["that",["G3704"]],["ye should shew forth",["G1804"]],["the praises",["G703"]],["of him who hath called",["G2564"]],["you",["G5209"]],["out of",["G1537"]],["darkness",["G4655"]],["into",["G1519"]],["his",["G846"]],["marvellous",["G2298"]],["light:",["G5457"]]]},{"verse":10,"text":"Which in time past were not a people, but are now the people of God: which had not obtained mercy, but now have obtained mercy.","words":[["Which",["G3588"]],["in time past",["G4218"]],["were not",["G3756"]],["a people,",["G2992"]],["but",["G1161"]],["are now",["G3568"]],["the people",["G2992"]],["of God:",["G2316"]],["which",["G3588"]],["had",["G1653"]],["not",["G3756"]],["obtained mercy,",["G1653"]],["but",["G1161"]],["now",["G3568"]],["have obtained mercy.",["G1653"]]]},{"verse":11,"text":"Dearly beloved, I beseech you as strangers and pilgrims, abstain from fleshly lusts, which war against the soul;","words":[["Dearly beloved,",["G27"]],["I beseech",["G3870"]],["you as",["G5613"]],["strangers",["G3941"]],["and",["G2532"]],["pilgrims,",["G3927"]],["abstain from",["G567"]],["fleshly",["G4559"]],["lusts,",["G1939"]],["which",["G3748"]],["war",["G4754"]],["against",["G2596"]],["the soul;",["G5590"]]]},{"verse":12,"text":"Having your conversation honest among the Gentiles: that, whereas they speak against you as evildoers, they may by your good works, which they shall behold, glorify God in the day of visitation.","words":[["Having",["G2192"]],["your",["G5216"]],["conversation",["G391"]],["honest",["G2570"]],["among",["G1722"]],["the Gentiles:",["G1484"]],["that,",["G2443"]],["whereas",["G1722","G3739"]],["they speak against",["G2635"]],["you",["G5216"]],["as",["G5613"]],["evildoers,",["G2555"]],["they may",["G1392"]],["by",["G1537"]],["your good",["G2570"]],["works,",["G2041"]],["which they shall behold,",["G2029"]],["glorify",["G1392"]],["God",["G2316"]],["in",["G1722"]],["the day",["G2250"]],["of visitation.",["G1984"]]]},{"verse":13,"text":"Submit yourselves to every ordinance of man for the Lord’s sake: whether it be to the king, as supreme;","words":[["Submit yourselves",["G5293"]],["to every",["G3956"]],["ordinance",["G2937"]],["of man",["G442"]],["for",["G1223"]],["the Lord’s sake:",["G2962"]],["whether it be",["G1535"]],["to the king,",["G935"]],["as",["G5613"]],["supreme;",["G5242"]]]},{"verse":14,"text":"Or unto governors, as unto them that are sent by him for the punishment of evildoers, and for the praise of them that do well.","words":[["Or",["G1535"]],["unto governors,",["G2232"]],["as",["G5613"]],["unto them that are sent",["G3992"]],["by",["G1223"]],["him",["G846"]],["for",["G1519","G3303"]],["the punishment",["G1557"]],["of evildoers,",["G2555"]],["and",["G1161"]],["for the praise",["G1868"]],["of them that do well.",["G17"]]]},{"verse":15,"text":"For so is the will of God, that with well doing ye may put to silence the ignorance of foolish men:","words":[["For",["G3754"]],["so",["G3779"]],["is",["G2076"]],["the will",["G2307"]],["of God,",["G2316"]],["that with well doing",["G15"]],["ye may put to silence",["G5392"]],["the ignorance",["G56"]],["of foolish",["G878"]],["men:",["G444"]]]},{"verse":16,"text":"As free, and not using your liberty for a cloke of maliciousness, but as the servants of God.","words":[["As",["G5613"]],["free,",["G1658"]],["and",["G2532"]],["not",["G3361"]],["using",["G2192"]],["your liberty",["G1657"]],["for",["G5613"]],["a cloke",["G1942"]],["of maliciousness,",["G2549"]],["but",["G235"]],["as",["G5613"]],["the servants",["G1401"]],["of God.",["G2316"]]]},{"verse":17,"text":"Honour all men. Love the brotherhood. Fear God. Honour the king.","words":[["Honour",["G5091"]],["all",["G3956"]],["men. Love",["G25"]],["the brotherhood.",["G81"]],["Fear",["G5399"]],["God.",["G2316"]],["Honour",["G5091"]],["the king.",["G935"]]]},{"verse":18,"text":"Servants, be subject to your masters with all fear; not only to the good and gentle, but also to the froward.","words":[["Servants,",["G3610"]],["be subject",["G5293"]],["to your masters",["G1203"]],["with",["G1722"]],["all",["G3956"]],["fear;",["G5401"]],["not",["G3756"]],["only",["G3440"]],["to the good",["G18"]],["and",["G2532"]],["gentle,",["G1933"]],["but",["G235"]],["also",["G2532"]],["to the froward.",["G4646"]]]},{"verse":19,"text":"For this is thankworthy, if a man for conscience toward God endure grief, suffering wrongfully.","words":[["For",["G1063"]],["this",["G5124"]],["is thankworthy,",["G5485"]],["if",["G1487"]],["a man",["G5100"]],["for",["G1223"]],["conscience",["G4893"]],["toward God",["G2316"]],["endure",["G5297"]],["grief,",["G3077"]],["suffering",["G3958"]],["wrongfully.",["G95"]]]},{"verse":20,"text":"For what glory is it, if, when ye be buffeted for your faults, ye shall take it patiently? but if, when ye do well, and suffer for it, ye take it patiently, this is acceptable with God.","words":[["For",["G1063"]],["what",["G4169"]],["glory",["G2811"]],["is it, if,",["G1487"]],["when",["G2532"]],["ye be buffeted",["G2852"]],["for your faults,",["G264"]],["ye shall take it patiently?",["G5278"]],["but",["G235"]],["if,",["G1487"]],["when ye do well,",["G15"]],["and",["G2532"]],["suffer",["G3958"]],["for it, ye take it patiently,",["G5278"]],["this",["G5124"]],["is acceptable",["G5485"]],["with",["G3844"]],["God.",["G2316"]]]},{"verse":21,"text":"For even hereunto were ye called: because Christ also suffered for us, leaving us an example, that ye should follow his steps:","words":[["For",["G1063"]],["even",["G1519"]],["hereunto",["G5124"]],["were ye called:",["G2564"]],["because",["G3754"]],["Christ",["G5547"]],["also",["G2532"]],["suffered",["G3958"]],["for",["G5228"]],["us,",["G2257"]],["leaving",["G5277"]],["us",["G2254"]],["an example,",["G5261"]],["that",["G2443"]],["ye should follow",["G1872"]],["his",["G846"]],["steps:",["G2487"]]]},{"verse":22,"text":"Who did no sin, neither was guile found in his mouth:","words":[["Who",["G3739"]],["did",["G4160"]],["no",["G3756"]],["sin,",["G266"]],["neither",["G3761"]],["was guile",["G1388"]],["found",["G2147"]],["in",["G1722"]],["his",["G846"]],["mouth:",["G4750"]]]},{"verse":23,"text":"Who, when he was reviled, reviled not again; when he suffered, he threatened not; but committed himself to him that judgeth righteously:","words":[["Who,",["G3739"]],["when he was reviled,",["G3058"]],["reviled",["G486"]],["not",["G3756"]],["again;",["G486"]],["when he suffered,",["G3958"]],["he threatened",["G546"]],["not;",["G3756"]],["but",["G1161"]],["committed",["G3860"]],["himself to him that judgeth",["G2919"]],["righteously:",["G1346"]]]},{"verse":24,"text":"Who his own self bare our sins in his own body on the tree, that we, being dead to sins, should live unto righteousness: by whose stripes ye were healed.","words":[["Who",["G3739"]],["his own self",["G846"]],["bare",["G399"]],["our",["G2257"]],["sins",["G266"]],["in",["G1722"]],["his own",["G846"]],["body",["G4983"]],["on",["G1909"]],["the tree,",["G3586"]],["that",["G2443"]],["we,",["G2198"]],["being dead",["G581"]],["to sins,",["G266"]],["should live",["G2198"]],["unto righteousness:",["G1343"]],["by",["G3739"]],["whose",["G846"]],["stripes",["G3468"]],["ye were healed.",["G2390"]]]},{"verse":25,"text":"For ye were as sheep going astray; but are now returned unto the Shepherd and Bishop of your souls.","words":[["For",["G1063"]],["ye were",["G2258"]],["as",["G5613"]],["sheep",["G4263"]],["going astray;",["G4105"]],["but",["G235"]],["are",["G1994"]],["now",["G3568"]],["returned",["G1994"]],["unto",["G1909"]],["the Shepherd",["G4166"]],["and",["G2532"]],["Bishop",["G1985"]],["of your",["G5216"]],["souls.",["G5590"]]]}]}