{"book":"Matthew","chapter":20,"translation":"KJV","url":"/bible/matthew/20","verses":[{"verse":1,"text":"For the kingdom of heaven is like unto a man that is an householder, which went out early in the morning to hire labourers into his vineyard.","words":[["For",["G1063"]],["the kingdom",["G932"]],["of heaven",["G3772"]],["is",["G2076"]],["like",["G3664"]],["unto a man",["G444"]],["that is an householder,",["G3617"]],["which",["G3748"]],["went out",["G1831"]],["early in the morning",["G260","G4404"]],["to hire",["G3409"]],["labourers",["G2040"]],["into",["G1519"]],["his",["G846"]],["vineyard.",[]]]},{"verse":2,"text":"And when he had agreed with the labourers for a penny a day, he sent them into his vineyard.","words":[["And",["G1161"]],["when he had agreed",["G4856"]],["with",["G3326"]],["the labourers",["G2040"]],["for",["G1537"]],["a penny",["G1220"]],["a day,",["G2250"]],["he sent",["G649"]],["them",["G846"]],["into",["G1519"]],["his",["G846"]],["vineyard.",[]]]},{"verse":3,"text":"And he went out about the third hour, and saw others standing idle in the marketplace,","words":[["And",["G2532"]],["he went out",["G1831"]],["about",["G4012"]],["the third",["G5154"]],["hour,",["G5610"]],["and saw",["G1492"]],["others",["G243"]],["standing",["G2476"]],["idle",["G692"]],["in",["G1722"]],["the marketplace,",[]]]},{"verse":4,"text":"And said unto them; Go ye also into the vineyard, and whatsoever is right I will give you. And they went their way.","words":[["And said",["G2036"]],["unto them;",["G2548"]],["Go",["G5217"]],["ye",["G5210"]],["also",["G2532"]],["into",["G1519"]],["the vineyard,",["G290"]],["and",["G2532"]],["whatsoever",["G3739","G1437"]],["is",["G5600"]],["right",["G1342"]],["I will give",["G1325"]],["you.",["G5213"]],["And",["G1161"]],["they went their way.",[]]]},{"verse":5,"text":"Again he went out about the sixth and ninth hour, and did likewise.","words":[["Again",["G3825"]],["he went out",["G1831"]],["about",["G4012"]],["the sixth",["G1623"]],["and",["G2532"]],["ninth",["G1766"]],["hour,",["G5610"]],["and did",["G4160"]],["likewise.",[]]]},{"verse":6,"text":"And about the eleventh hour he went out, and found others standing idle, and saith unto them, Why stand ye here all the day idle?","words":[["And",["G1161"]],["about",["G4012"]],["the eleventh",["G1734"]],["hour",["G5610"]],["he went out,",["G1831"]],["and found",["G2147"]],["others",["G243"]],["standing",["G2476"]],["idle,",["G692"]],["and",["G2532"]],["saith",["G3004"]],["unto them,",["G846"]],["Why",["G5101"]],["stand ye",["G2476"]],["here",["G5602"]],["all",["G3650"]],["the day",["G2250"]],["idle?",[]]]},{"verse":7,"text":"They say unto him, Because no man hath hired us. He saith unto them, Go ye also into the vineyard; and whatsoever is right, that shall ye receive.","words":[["They say",["G3004"]],["unto him,",["G846"]],["Because",["G3754"]],["no man",["G3762"]],["hath hired",["G3409"]],["us.",["G2248"]],["He saith",["G3004"]],["unto them,",["G846"]],["Go",["G5217"]],["ye",["G5210"]],["also",["G2532"]],["into",["G1519"]],["the vineyard;",["G290"]],["and",["G2532"]],["whatsoever",["G3739","G1437"]],["is",["G5600"]],["right,",["G1342"]],["that shall ye receive.",[]]]},{"verse":8,"text":"So when even was come, the lord of the vineyard saith unto his steward, Call the labourers, and give them their hire, beginning from the last unto the first.","words":[["So",["G1161"]],["when even",["G3798"]],["was come,",["G1096"]],["the lord",["G2962"]],["of the vineyard",["G290"]],["saith",["G3004"]],["unto his",["G846"]],["steward,",["G2012"]],["Call",["G2564"]],["the labourers,",["G2040"]],["and",["G2532"]],["give",["G591"]],["them",["G846"]],["their hire,",["G3408"]],["beginning",["G756"]],["from",["G575"]],["the last",["G2078"]],["unto",["G2193"]],["the first.",[]]]},{"verse":9,"text":"And when they came that were hired about the eleventh hour, they received every man a penny.","words":[["And",["G2532"]],["when they came",["G2064"]],["that were hired about",["G4012"]],["the eleventh",["G1734"]],["hour,",["G5610"]],["they received",["G2983"]],["every man",["G303"]],["a penny.",[]]]},{"verse":10,"text":"But when the first came, they supposed that they should have received more; and they likewise received every man a penny.","words":[["But",["G1161"]],["when the first",["G4413"]],["came,",["G2064"]],["they supposed",["G3543"]],["that",["G3754"]],["they should have received",["G2983"]],["more;",["G4119"]],["and",["G2532"]],["they likewise",["G2532"]],["received",["G2983"]],["every man",["G846","G303"]],["a penny.",[]]]},{"verse":11,"text":"And when they had received it, they murmured against the goodman of the house,","words":[["And",["G1161"]],["when they had received",["G2983"]],["it, they murmured",["G1111"]],["against",["G2596"]],["the goodman of the house,",[]]]},{"verse":12,"text":"Saying, These last have wrought but one hour, and thou hast made them equal unto us, which have borne the burden and heat of the day.","words":[["Saying,",["G3004"]],["These",["G3778"]],["last",["G2078"]],["have wrought",["G4160"]],["but one",["G3391"]],["hour,",["G5610"]],["and",["G2532"]],["thou hast made",["G4160"]],["them",["G846"]],["equal",["G2470"]],["unto us,",["G2254"]],["which",["G3588"]],["have borne",["G941"]],["the burden",["G922"]],["and",["G2532"]],["heat",["G2742"]],["of the day.",[]]]},{"verse":13,"text":"But he answered one of them, and said, Friend, I do thee no wrong: didst not thou agree with me for a penny?","words":[["But",["G1161"]],["he answered",["G611"]],["one",["G1520"]],["of them,",["G846"]],["and said,",["G2036"]],["Friend,",["G2083"]],["I do",["G91"]],["thee",["G4571"]],["no",["G3756"]],["wrong:",["G91"]],["didst",["G4856"]],["not",["G3780"]],["thou agree",["G4856"]],["with me",["G3427"]],["for a penny?",[]]]},{"verse":14,"text":"Take that thine is, and go thy way: I will give unto this last, even as unto thee.","words":[["Take",["G142"]],["that thine",["G4674"]],["is, and",["G2532"]],["go thy way:",["G5217","G116