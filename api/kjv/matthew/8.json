{"book":"Matthew","chapter":8,"translation":"KJV","url":"/bible/matthew/8","verses":[{"verse":1,"text":"When he was come down from the mountain, great multitudes followed him.","words":[["When",["G1161"]],["he",["G846"]],["was come down",["G2597"]],["from",["G575"]],["the mountain,",["G3735"]],["great",["G4183"]],["multitudes",["G3793"]],["followed",["G190"]],["him.",[]]]},{"verse":2,"text":"And, behold, there came a leper and worshipped him, saying, Lord, if thou wilt, thou canst make me clean.","words":[["And,",["G2532"]],["behold,",["G2400"]],["there came",["G2064"]],["a leper",["G3015"]],["and worshipped",["G4352"]],["him,",["G846"]],["saying,",["G3004"]],["Lord,",["G2962"]],["if",["G1437"]],["thou wilt,",["G2309"]],["thou canst",["G1410"]],["make",["G2511"]],["me",["G3165"]],["clean.",[]]]},{"verse":3,"text":"And Jesus put forth his hand, and touched him, saying, I will; be thou clean. And immediately his leprosy was cleansed.","words":[["And",["G2532"]],["Jesus",["G2424"]],["put forth",["G1614"]],["his hand,",["G5495"]],["and touched",["G680"]],["him,",["G846"]],["saying,",["G3004"]],["I will;",["G2309"]],["be thou clean.",["G2511"]],["And",["G2532"]],["immediately",["G2112"]],["his",["G846"]],["leprosy",["G3014"]],["was cleansed.",[]]]},{"verse":4,"text":"And Jesus saith unto him, See thou tell no man; but go thy way, shew thyself to the priest, and offer the gift that Moses commanded, for a testimony unto them.","words":[["And",["G2532"]],["Jesus",["G2424"]],["saith",["G3004"]],["unto him,",["G846"]],["See",["G3708"]],["thou tell",["G2036"]],["no man;",["G3367"]],["but",["G235"]],["go thy way,",["G5217"]],["shew",["G1166"]],["thyself",["G4572"]],["to the priest,",["G2409"]],["and",["G2532"]],["offer",["G4374"]],["the gift",["G1435"]],["that",["G3739"]],["Moses",["G3475"]],["commanded,",["G4367"]],["for",["G1519"]],["a testimony",["G3142"]],["unto them.",[]]]},{"verse":5,"text":"And when Jesus was entered into Capernaum, there came unto him a centurion, beseeching him,","words":[["And",["G1161"]],["when",["G1525"]],["Jesus",["G2424"]],["was entered",["G1525"]],["into",["G1519"]],["Capernaum,",["G2584"]],["there came",["G4334"]],["unto him",["G846"]],["a centurion,",["G1543"]],["beseeching",["G3870"]],["him,",[]]]},{"verse":6,"text":"And saying, Lord, my servant lieth at home sick of the palsy, grievously tormented.","words":[["And",["G2532"]],["saying,",["G3004"]],["Lord,",["G2962"]],["my",["G3450"]],["servant",["G3816"]],["lieth",["G906"]],["at",["G1722"]],["home",["G3614"]],["sick of the palsy,",["G3885"]],["grievously",["G1171"]],["tormented.",[]]]},{"verse":7,"text":"And Jesus saith unto him, I will come and heal him.","words":[["And",["G2532"]],["Jesus",["G2424"]],["saith",["G3004"]],["unto him,",["G846"]],["I",["G1473"]],["will come",["G2064"]],["and heal",["G2323"]],["him.",[]]]},{"verse":8,"text":"The centurion answered and said, Lord, I am not worthy that thou shouldest come under my roof: but speak the word only, and my servant shall be healed.","words":[["The centurion",["G1543"]],["answered",["G611"]],["and",["G2532"]],["said,",["G5346"]],["Lord,",["G2962"]],["I am",["G1510"]],["not",["G3756"]],["worthy",["G2425"]],["that",["G2443"]],["thou shouldest come",["G1525"]],["under",["G5259"]],["my",["G3450"]],["roof:",["G4721"]],["but",["G235"]],["speak",["G2036"]],["the word",["G3056"]],["only,",["G3440"]],["and",["G2532"]],["my",["G3450"]],["servant",["G3816"]],["shall be healed.",[]]]},{"verse":9,"text":"For I am a man under authority, having soldiers under me: and I say to this man, Go, and he goeth; and to another, Come, and he cometh; and to my servant, Do this, and he doeth it.","words":[["For",["G1063","G2532"]],["I",["G1473"]],["am",["G1510"]],["a man",["G444"]],["under",["G5259"]],["authority,",["G1849"]],["having",["G2192"]],["soldiers",["G4757"]],["under",["G5259"]],["me:",["G1683"]],["and",["G2532"]],["I say",["G3004"]],["to this",["G5129"]],["man, Go,",["G4198"]],["and",["G2532"]],["he goeth;",["G419