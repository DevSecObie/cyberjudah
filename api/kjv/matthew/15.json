{"book":"Matthew","chapter":15,"translation":"KJV","url":"/bible/matthew/15","verses":[{"verse":1,"text":"Then came to Jesus scribes and Pharisees, which were of Jerusalem, saying,","words":[["Then",["G5119"]],["came",["G4334"]],["to Jesus",["G2424"]],["scribes",["G1122"]],["and",["G2532"]],["Pharisees,",["G5330"]],["which were of",["G575"]],["Jerusalem,",["G2414"]],["saying,",[]]]},{"verse":2,"text":"Why do thy disciples transgress the tradition of the elders? for they wash not their hands when they eat bread.","words":[["Why",["G1302"]],["do thy",["G4675"]],["disciples",["G3101"]],["transgress",["G3845"]],["the tradition",["G3862"]],["of the elders?",["G4245"]],["for",["G1063"]],["they wash",["G3538"]],["not",["G3756"]],["their",["G846"]],["hands",["G5495"]],["when",["G3752"]],["they eat",["G2068"]],["bread.",[]]]},{"verse":3,"text":"But he answered and said unto them, Why do ye also transgress the commandment of God by your tradition?","words":[["But",["G1161"]],["he answered",["G611"]],["and said",["G2036"]],["unto them,",["G846"]],["Why",["G1302"]],["do ye",["G5210"]],["also",["G2532"]],["transgress",["G3845"]],["the commandment",["G1785"]],["of God",["G2316"]],["by",["G1223"]],["your",["G5216"]],["tradition?",[]]]},{"verse":4,"text":"For God commanded, saying, Honour thy father and mother: and, He that curseth father or mother, let him die the death.","words":[["For",["G1063"]],["God",["G2316"]],["commanded,",["G1781"]],["saying,",["G3004"]],["Honour",["G5091"]],["thy",["G4675"]],["father",["G3962"]],["and",["G2532"]],["mother:",["G3384"]],["and,",["G2532"]],["He that curseth",["G2551"]],["father",["G3962"]],["or",["G2228"]],["mother,",["G3384"]],["let him die",["G5053"]],["the death.",[]]]},{"verse":5,"text":"But ye say, Whosoever shall say to his father or his mother, It is a gift, by whatsoever thou mightest be profited by me;","words":[["But",["G1161"]],["ye",["G5210"]],["say,",["G3004"]],["Whosoever",["G3739","G302"]],["shall say",["G2036"]],["to his father",["G3962"]],["or",["G2228"]],["his mother,",["G3384"]],["It is a gift,",["G1435"]],["by",["G1537"]],["whatsoever",["G3739","G1437"]],["thou mightest be profited",["G5623"]],["by me;",[]]]},{"verse":6,"text":"And honour not his father or his mother, he shall be free. Thus have ye made the commandment of God of none effect by your tradition.","words":[["And",["G2532"]],["honour",["G5091"]],["not",["G3364"]],["his",["G846"]],["father",["G3962"]],["or",["G2228"]],["his",["G846"]],["mother,",["G3384"]],["he shall be free. Thus",["G2532"]],["have ye made",["G208"]],["the commandment",["G1785"]],["of God",["G2316"]],["of none effect",["G208"]],["by",["G1223"]],["your",["G5216"]],["tradition.",[]]]},{"verse":7,"text":"Ye hypocrites, well did Esaias prophesy of you, saying,","words":[["Ye hypocrites,",["G5273"]],["well",["G2573"]],["did",["G4395"]],["Esaias",["G2268"]],["prophesy",["G4395"]],["of",["G4012"]],["you,",["G5216"]],["saying,",[]]]},{"verse":8,"text":"This people draweth nigh unto me with their mouth, and honoureth me with their lips; but their heart is far from me.","words":[["This",["G3778"]],["people",["G2992"]],["draweth nigh",["G1448"]],["unto me",["G3427"]],["with their",["G846"]],["mouth,",["G4750"]],["and",["G2532"]],["honoureth",["G5091"]],["me",["G3165"]],["with their lips;",["G5491"]],["but",["G1161"]],["their",["G846"]],["heart",["G2588"]],["is",["G568"]],["far",["G4206"]],["from",["G575"]],["me.",[]]]},{"verse":9,"text":"But in vain they do worship me, teaching for doctrines the commandments of men.","words":[["But",["G1161"]],["in vain",["G3155"]],["they do worship",["G4576"]],["me,",["G3165"]],["teaching",["G1321"]],["for doctrines",["G1319"]],["the commandments",["G1778"]],["of men.",[]]]},{"verse":10,"text":"And he called the multitude, and said unto them, Hear, and understand:","words":[["And",["G2532"]],["he called",["G4341"]],["the multitude,",["G3793"]],["and said",["G2036"]],["unto them,",["G846"]],["Hear,",["G191"]],["and",["G2532"]],["understand:",[]]]},{"verse":11,"text":"Not that which goeth into the mouth defileth a man; but that which cometh out of the mouth, this defileth a man.","words":[["Not",["G3756"]],["that which goeth",["G1525"]],["into",["G1519"]],["the mouth",["G4750"]],["defileth",["G2840"]],["a man;",["G444"]],["but",["G235"]],["that which cometh",["G1607"]],["out of",["G1537"]],["the mouth,",["G4750"]],["this",["G5124"]],["defileth",["G2840"]],["a man.",[]]]},{"verse":12,"text":"Then came his disciples, and said unto him, Knowest thou that the Pharisees were offended, after they heard this saying?","words":[["Then",["G5119"]],["came",["G4334"]],["his",["G846"]],["disciples,",["G3101"]],["and said",["G2036"]],["unto him,",["G846"]],["Knowest thou",["G1492"]],["that",["G3754"]],["the Pharisees",["G5330"]],["were offended,",["G4624"]],["after they heard",["G191"]],["this saying?",[]]]},{"verse":13,"text":"But he answered and said, Every plant, which my heavenly Father hath not planted, shall be rooted up.","words":[["But",["G1161"]],["he answered",["G611"]],["and said,",["G2036"]],["Every",["G3956"]],["plant,",["G5451"]],["which",["G3739"]],["my",["G3450"]],["heavenly",["G3770"]],["Father",["G3962"]],["hath",["G5452"]],["not",["G3756"]],["planted,",["G5452"]],["shall be rooted up.",[]]]},{"verse":14,"text":"Let them alone: they be blind leaders of the blind. And if the blind lead the blind, both shall fall into the ditch.","words":[["Let",["G863"]],["them",["G846"]],["alone:",["G863"]],["they be",["G1526"]],["blind",["G5185"]],["leaders",["G3595"]],["of the blind.",["G5185"]],["And",["G1161"]],["if",["G1437"]],["the blind",["G5185"]],["lead",["G3594"]],["the blind,",["G5185"]],["both",["G297"]],["shall fall",["G4098"]],["into",["G1519"]],["the ditch.",[]]]},{"verse":15,"text":"Then answered Peter and said unto him, Declare unto us this parable.","words":[["Then",["G1161"]],["answered",["G611"]],["Peter",["G4074"]],["and said",["G2036"]],["unto him,",["G846"]],["Declare",["G5419"]],["unto us",["G2254"]],["this",["G5026"]],["parable.",[]]]},{"verse":16,"text":"And Jesus said, Are ye also yet without understanding?","words":[["And",["G1161"]],["Jesus",["G2424"]],["said,",["G2036"]],["Are",["G2075"]],["ye",["G5210"]],["also",["G2532"]],["yet",["G188"]],["without understanding?",[]]]},{"verse":17,"text":"Do not ye yet understand, that whatsoever entereth in at the mouth goeth into the belly, and is cast out into the draught?","words":[["Do",["G3539"]],["not",["G3768"]],["ye",["G3539"]],["yet",["G3768"]],["understand,",["G3539"]],["that",["G3754"]],["whatsoever",["G3956"]],["entereth in",["G1531"]],["at",["G1519"]],["the mouth",["G4750"]],["goeth",["G5562"]],["into",["G1519"]],["the belly,",["G2836"]],["and",["G2532"]],["is cast out",["G1544"]],["into",["G1519"]],["the draught?",[]]]},{"verse":18,"text":"But those things which proceed out of the mouth come forth from the heart; and they defile the man.","words":[["But",["G1161"]],["those things which",["G3588"]],["proceed",["G1607"]],["out of",["G1537"]],["the mouth",["G4750"]],["come forth",["G1831"]],["from",["G1537"]],["the heart;",["G2588"]],["and they",["G2548"]],["defile",["G2840"]],["the man.",[]]]},{"verse":19,"text":"For out of the heart proceed evil thoughts, murders, adulteries, fornications, thefts, false witness, blasphemies:","words":[["For",["G1063"]],["out of",["G1537"]],["the heart",["G2588"]],["proceed",["G1831"]],["evil",["G4190"]],["thoughts,",["G1261"]],["murders,",["G5408"]],["adulteries,",["G3430"]],["fornications,",["G4202"]],["thefts,",["G2829"]],["false witness,",["G5577"]],["blasphemies:",[]]]},{"verse":20,"text":"These are the things which defile a man: but to eat with unwashen hands defileth not a man.","words":[["These",["G5023"]],["are",["G2076"]],["the things which",["G3588"]],["defile",["G2840"]],["a man:",["G444"]],["but",["G1161"]],["to eat",["G5315"]],["with unwashen",["G449"]],["hands",["G5495"]],["defileth",["G2840"]],["not",["G3756"]],["a man.",[]]]},{"verse":21,"text":"Then Jesus went thence, and departed into the coasts of Tyre and Sidon.","words":[["Then",["G2532"]],["Jesus",["G2424"]],["went",["G1831"]],["thence,",["G1564"]],["and departed",["G402"]],["into",["G1519"]],["the coasts",["G3313"]],["of Tyre",["G5184"]],["and",["G2532"]],["Sidon.",[]]]},{"verse":22,"text":"And, behold, a woman of Canaan came out of the same coasts, and cried unto him, saying, Have mercy on me, O Lord, thou Son of David; my daughter is grievously vexed with a devil.","words":[["And,",["G2532"]],["behold,",["G2400"]],["a woman",["G1135"]],["of Canaan",["G5478"]],["came",["G1831"]],["out of",["G575"]],["the same",["G1565"]],["coasts,",["G3725"]],["and cried",["G2905"]],["unto him,",["G846"]],["saying,",["G3004"]],["Have mercy",["G1653"]],["on me,",["G3165"]],["O Lord,",["G2962"]],["thou Son",["G5207"]],["of David;",["G1138"]],["my",["G3450"]],["daughter",["G2364"]],["is grievously",["G2560"]],["vexed with a devil.",[]]]},{"verse":23,"text":"But he answered her not a word. And his disciples came and besought him, saying, Send her away; for she crieth after us.","words":[["But",["G1161"]],["he answered",["G611"]],["her",["G846"]],["not",["G3756"]],["a word.",["G3056"]],["And",["G2532"]],["his",["G846"]],["disciples",["G3101"]],["came",["G4334"]],["and besought",["G2065"]],["him,",["G846"]],["saying,",["G3004"]],["Send",["G630"]],["her",["G846"]],["away;",["G630"]],["for",["G3754"]],["she crieth",["G2896"]],["after",["G3693"]],["us.",[]]]},{"verse":24,"text":"But he answered and said, I am not sent but unto the lost sheep of the house of Israel.","words":[["But",["G1161"]],["he answered",["G611"]],["and said,",["G2036"]],["I am",["G649"]],["not",["G3756"]],["sent",["G649"]],["but",["G1508"]],["unto",["G1519"]],["the lost",["G622"]],["sheep",["G4263"]],["of the house",["G3624"]],["of Israel.",[]]]},{"verse":25,"text":"Then came she and worshipped him, saying, Lord, help me.","words":[["Then",["G1161"]],["came she",["G2064"]],["and worshipped",["G4352"]],["him,",["G846"]],["saying,",["G3004"]],["Lord,",["G2962"]],["help",["G997"]],["me.",[]]]},{"verse":26,"text":"But he answered and said, It is not meet to take the children’s bread, and to cast it to dogs.","words":[["But",["G1161"]],["he answered",["G611"]],["and said,",["G2036"]],["It is",["G2076"]],["not",["G3756"]],["meet",["G2570"]],["to take",["G2983"]],["the children’s bread,",["G740"]],["and",["G2532"]],["to cast",["G906"]],["it to dogs.",[]]]},{"verse":27,"text":"And she said, Truth, Lord: yet the dogs eat of the crumbs which fall from their masters’ table.","words":[["And",["G1161"]],["she said,",["G2036"]],["Truth,",["G3483"]],["Lord:",["G2962"]],["yet",["G2532","G1063"]],["the dogs",["G2952"]],["eat",["G2068"]],["of",["G575"]],["the crumbs",["G5589"]],["which",["G3588"]],["fall",["G4098"]],["from",["G575"]],["their",["G846"]],["masters’",["G2962"]],["table.",[]]]},{"verse":28,"text":"Then Jesus answered and said unto her, O woman, great is thy faith: be it unto thee even as thou wilt. And her daughter was made whole from that very hour.","words":[["Then",["G5119"]],["Jesus",["G2424"]],["answered",["G611"]],["and said",["G2036"]],["unto her,",["G846"]],["O",["G5599"]],["woman,",["G1135"]],["great",["G3173"]],["is thy",["G4675"]],["faith:",["G4102"]],["be it",["G1096"]],["unto thee",["G4671"]],["even as",["G5613"]],["thou wilt.",["G2309"]],["And",["G2532"]],["her",["G846"]],["daughter",["G2364"]],["was made whole",["G2390"]],["from",["G575"]],["that very",["G1565"]],["hour.",[]]]},{"verse":29,"text":"And Jesus departed from thence, and came nigh unto the sea of Galilee; and went up into a mountain, and sat down there.","words":[["And",["G2532"]],["Jesus",["G2424"]],["departed",["G3327"]],["from thence,",["G1564"]],["and came",["G2064"]],["nigh unto",["G3844"]],["the sea",["G2281"]],["of Galilee;",["G1056"]],["and",["G2532"]],["went up",["G305"]],["into",["G1519"]],["a mountain,",["G3735"]],["and sat down",["G2521"]],["there.",[]]]},{"verse":30,"text"