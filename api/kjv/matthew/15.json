"]],["I will",["G2309"]],["not",["G3756"]],["send",["G630"]],["them",["G846"]],["away",["G630"]],["fasting,",["G3523"]],["lest",["G3379"]],["they faint",["G1590"]],["in",["G1722"]],["the way.",[]]]},{"verse":33,"text":"And his disciples say unto him, Whence should we have so much bread in the wilderness, as to fill so great a multitude?","words":[["And",["G2532"]],["his",["G846"]],["disciples",["G3101"]],["say",["G3004"]],["unto him,",["G846"]],["Whence",["G4159"]],["should we",["G2254"]],["have so much",["G5118"]],["bread",["G740"]],["in",["G1722"]],["the wilderness,",["G2047"]],["as",["G5620"]],["to fill",["G5526"]],["so great",["G5118"]],["a multitude?",[]]]},{"verse":34,"text":"And Jesus saith unto them, How many loaves have ye? And they said, Seven, and a few little fishes.","words":[["And",["G2532"]],["Jesus",["G2424"]],["saith",["G3004"]],["unto them,",["G846"]],["How many",["G4214"]],["loaves",["G740"]],["have ye?",["G2192"]],["And",["G1161"]],["they said,",["G2036"]],["Seven,",["G2033"]],["and",["G2532"]],["a few",["G3641"]],["little fishes.",[]]]},{"verse":35,"text":"And he commanded the multitude to sit down on the ground.","words":[["And",["G2532"]],["he commanded",["G2753"]],["the multitude",["G3793"]],["to sit down",["G377"]],["on",["G1909"]],["the ground.",[]]]},{"verse":36,"text":"And he took the seven loaves and the fishes, and gave thanks, and brake them, and gave to his disciples, and the disciples to the multitude.","words":[["And",["G2532"]],["he took",["G2983"]],["the seven",["G2033"]],["loaves",["G740"]],["and",["G2532"]],["the fishes,",["G2486"]],["and gave thanks,",["G2168"]],["and brake",["G2806"]],["them, and",["G2532"]],["gave",["G1325"]],["to his",["G846"]],["disciples,",["G3101"]],["and",["G1161"]],["the disciples",["G3101"]],["to the multitude.",[]]]},{"verse":37,"text":"And they did all eat, and were filled: and they took up of the broken meat that was left seven baskets full.","words":[["And",["G2532"]],["they did",["G5315"]],["all",["G3956"]],["eat,",["G5315"]],["and",["G2532"]],["were filled:",["G5526"]],["and",["G2532"]],["they took up",["G142"]],["of the broken",["G2801"]],["meat that was left",["G4052"]],["seven",["G2033"]],["baskets",["G4711"]],["full.",[]]]},{"verse":38,"text":"And they that did eat were four thousand men, beside women and children.","words":[["And",["G1161"]],["they that did eat",["G2068"]],["were",["G2258"]],["four thousand",["G5070"]],["men,",["G435"]],["beside",["G5565"]],["women",["G1135"]],["and",["G2532"]],["children.",[]]]},{"verse":39,"text":"And he sent away the multitude, and took ship, and came into the coasts of Magdala.","words":[["And",["G2532"]],["he sent away",["G630"]],["the multitude,",["G3793"]],["and took",["G1684"]],["ship,",["G1519","G4143"]],["and",["G2532"]],["came",["G2064"]],["into",["G1519"]],["the coasts",["G3725"]],["of Magdala.",[]]]}]}