"G2983"]],["the fruits",["G2590"]],["of it.",[]]]},{"verse":35,"text":"And the husbandmen took his servants, and beat one, and killed another, and stoned another.","words":[["And",["G2532"]],["the husbandmen",["G1092"]],["took",["G2983"]],["his",["G846"]],["servants,",["G1401"]],["and beat",["G1194"]],["one,",["G3739","G3303"]],["and",["G1161"]],["killed",["G615"]],["another,",["G3739"]],["and",["G1161"]],["stoned",["G3036"]],["another.",[]]]},{"verse":36,"text":"Again, he sent other servants more than the first: and they did unto them likewise.","words":[["Again,",["G3825"]],["he sent",["G649"]],["other",["G243"]],["servants",["G1401"]],["more",["G4119"]],["than the first:",["G4413"]],["and",["G2532"]],["they did",["G4160"]],["unto them",["G846"]],["likewise.",[]]]},{"verse":37,"text":"But last of all he sent unto them his son, saying, They will reverence my son.","words":[["But",["G1161"]],["last of all",["G5305"]],["he sent",["G649"]],["unto",["G4314"]],["them",["G846"]],["his",["G846"]],["son,",["G5207"]],["saying,",["G3004"]],["They will reverence",["G1788"]],["my",["G3450"]],["son.",[]]]},{"verse":38,"text":"But when the husbandmen saw the son, they said among themselves, This is the heir; come, let us kill him, and let us seize on his inheritance.","words":[["But",["G1161"]],["when the husbandmen",["G1092"]],["saw",["G1492"]],["the son,",["G5207"]],["they said",["G2036"]],["among",["G1722"]],["themselves,",["G1438"]],["This",["G3778"]],["is",["G2076"]],["the heir;",["G2818"]],["come,",["G1205"]],["let us kill",["G615"]],["him,",["G846"]],["and",["G2532"]],["let us seize",["G2722"]],["on his",["G846"]],["inheritance.",[]]]},{"verse":39,"text":"And they caught him, and cast him out of the vineyard, and slew him.","words":[["And",["G2532"]],["they caught",["G2983"]],["him,",["G846"]],["and cast",["G1544"]],["him out of",["G1854"]],["the vineyard,",["G290"]],["and",["G2532"]],["slew him.",[]]]},{"verse":40,"text":"When the lord therefore of the vineyard cometh, what will he do unto those husbandmen?","words":[["When",["G3752"]],["the lord",["G2962"]],["therefore",["G3767"]],["of the vineyard",["G290"]],["cometh,",["G2064"]],["what",["G5101"]],["will he do",["G4160"]],["unto those",["G1565"]],["husbandmen?",[]]]},{"verse":41,"text":"They say unto him, He will miserably destroy those wicked men, and will let out his vineyard unto other husbandmen, which shall render him the fruits in their seasons.","words":[["They say",["G3004"]],["unto him,",["G846"]],["He will miserably",["G2560"]],["destroy",["G622"]],["those",["G846"]],["wicked men,",["G2556"]],["and",["G2532"]],["will let out",["G1554"]],["his vineyard",["G290"]],["unto other",["G243"]],["husbandmen,",["G1092"]],["which",["G3748"]],["shall render",["G591"]],["him",["G846"]],["the fruits",["G2590"]],["in",["G1722"]],["their",["G846"]],["seasons.",[]]]},{"verse":42,"text":"Jesus saith unto them, Did ye never read in the scriptures, The stone which the builders rejected, the same is become the head of the corner: this is the Lord’s doing, and it is marvellous in our eyes?","words":[["Jesus",["G2424"]],["saith",["G3004"]],["unto them,",["G846"]],["Did ye",["G314"]],["never",["G3763"]],["read",["G314"]],["in",["G1722"]],["the scriptures,",["G1124"]],["The stone",["G3037"]],["which",["G3739"]],["the builders",["G3618"]],["rejected,",["G593"]],["the same",["G3778"]],["is become",["G1096","G1519"]],["the head",["G2776"]],["of the corner:",["G1137"]],["this",["G3778"]],["is",["G3844"]],["the Lord’s doing,",["G1096"]],["and",["G2532"]],["it is",["G2076"]],["marvellous",["G2298"]],["in",["G1722"]],["our",["G2257"]],["eyes?",[]]]},{"verse":43,"text":"Therefore say I unto you, The kingdom of God shall be taken from you, and given to a nation bringing forth the fruits thereof.","words":[["Therefore",["G1223","G5124"]],["say I",["G3004"]],["unto you,",["G5213","G3754"]],["The kingdom",["G932"]],["of God",["G2316"]],["shall be taken",["G142"]],["from",["G575"]],["you,",["G5216"]],["and