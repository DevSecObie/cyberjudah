o us the parable of the tares of the field.","words":[["Then",["G5119"]],["Jesus",["G2424"]],["sent",["G863"]],["the multitude",["G3793"]],["away,",["G863"]],["and went",["G2064"]],["into",["G1519"]],["the house:",["G3614"]],["and",["G2532"]],["his",["G846"]],["disciples",["G3101"]],["came",["G4334"]],["unto him,",["G846"]],["saying,",["G3004"]],["Declare",["G5419"]],["unto us",["G2254"]],["the parable",["G3850"]],["of the tares",["G2215"]],["of the field.",[]]]},{"verse":37,"text":"He answered and said unto them, He that soweth the good seed is the Son of man;","words":[["He answered",["G611"]],["and",["G1161"]],["said",["G2036"]],["unto them,",["G846"]],["He that soweth",["G4687"]],["the good",["G2570"]],["seed",["G4690"]],["is",["G2076"]],["the Son",["G5207"]],["of man;",[]]]},{"verse":38,"text":"The field is the world; the good seed are the children of the kingdom; but the tares are the children of the wicked one;","words":[["The field",["G68"]],["is",["G2076"]],["the world;",["G2889","G1161"]],["the good",["G2570"]],["seed",["G4690"]],["are",["G3778","G1526"]],["the children",["G5207"]],["of the kingdom;",["G932"]],["but",["G1161"]],["the tares",["G2215"]],["are",["G1526"]],["the children",["G5207"]],["of the wicked one;",[]]]},{"verse":39,"text":"The enemy that sowed them is the devil; the harvest is the end of the world; and the reapers are the angels.","words":[["The enemy",["G2190"]],["that sowed",["G4687"]],["them",["G846"]],["is",["G2076"]],["the devil;",["G1228","G1161"]],["the harvest",["G2326"]],["is",["G2076"]],["the end",["G4930"]],["of the world;",["G165"]],["and",["G1161"]],["the reapers",["G2327"]],["are",["G1526"]],["the angels.",[]]]},{"verse":40,"text":"As therefore the tares are gathered and burned in the fire; so shall it be in the end of this world.","words":[["As",["G5618"]],["therefore",["G3767"]],["the tares",["G2215"]],["are gathered",["G4816"]],["and",["G2532"]],["burned",["G2618"]],["in the fire;",["G4442"]],["so",["G3779"]],["shall it be",["G2071"]],["in",["G1722"]],["the end",["G4930"]],["of this",["G5127"]],["world.",[]]]},{"verse":41,"text":"The Son of man shall send forth his angels, and they shall gather out of his kingdom all things that offend, and them which do iniquity;","words":[["The Son",["G5207"]],["of man",["G444"]],["shall send forth",["G649"]],["his",["G846"]],["angels,",["G32"]],["and",["G2532"]],["they shall gather",["G4816"]],["out of",["G1537"]],["his",["G846"]],["kingdom",["G932"]],["all things",["G3956"]],["that offend,",["G4625"]],["and",["G2532"]],["them which do",["G4160"]],["iniquity;",[]]]},{"verse":42,"text":"And shall cast them into a furnace of fire: there shall be wailing and gnashing of teeth.","words":[["And",["G2532"]],["shall cast",["G906"]],["them",["G846"]],["into",["G1519"]],["a furnace",["G2575"]],["of fire:",["G4442"]],["there",["G1563"]],["shall be",["G2071"]],["wailing",["G2805"]],["and",["G2532"]],["gnashing",["G1030"]],["of teeth.",[]]]},{"verse":43,"text":"Then shall the righteous shine forth as the sun in the kingdom of their Father. Who hath ears to hear, let him hear.","words":[["Then",["G5119"]],["shall the righteous",["G1342"]],["shine forth",["G1584"]],["as",["G5613"]],["the sun",["G2246"]],["in",["G1722"]],["the kingdom",["G932"]],["of their",["G846"]],["Father.",["G3962"]],["Who",["G3588"]],["hath",["G2192"]],["ears",["G3775"]],["to hear,",["G191"]],["let him hear.",[]]]},{"verse":44,"text":"Again, the kingdom of heaven is like unto treasure hid in a field; the which when a man hath found, he hideth, and for joy thereof goeth and selleth all that he hath, and buyeth that field.","words":[["Again,",["G3825"]],["the kingdom",["G932"]],["of heaven",["G3772"]],["is",["G2076"]],["like",["G3664"]],["unto treasure",["G2344"]],["hid",["G2928"]],["in",["G1722"]],["a field;",["G68"]],["the which",["G3739"]],["when a man",["G444"]],["hath found,",["G2147"]],["he hideth,",["G2928"]],["and",["G2532"]],["for",["G575"]],["joy",["G5479"]],["thereof",["G846"]],["goeth",["G5217"]],["and",["G2532"]],["selleth",["G4453"]],["all",["G3956"]],["that",["G3745"]],["he hath,",["G2192"]],["and",["G2532"]],["buyeth",["G59"]],["that",["G1565"]],["field.",[]]]},{"verse":45,"text":"Again, the kingdom of heaven is like unto a merchant man, seeking goodly pearls:","words":[["Again,",["G3825"]],["the kingdom",["G932"]],["of heaven",["G3772"]],["is",["G2076"]],["like",["G3664"]],["unto a merchant",["G1713"]],["man,",["G444"]],["seeking",["G2212"]],["goodly",["G2570"]],["pearls:",[]]]},{"verse":46,"text":"Who, when he had found one pearl of great price, went and sold all that he had, and bought it.","words":[["Who,",["G3739"]],["when he had found",["G2147"]],["one",["G1520"]],["pearl",["G3135"]],["of great price,",["G4186"]],["went",["G565"]],["and sold",["G4097"]],["all",["G3956"]],["that",["G3745"]],["he had,",["G2192"]],["and",["G2532"]],["bought",["G59"]],["it.",[]]]},{"verse":47,"text":"Again, the kingdom of heaven is like unto a net, that was cast into the sea, and gathered of every kind:","words":[["Again,",["G3825"]],["the kingdom",["G932"]],["of heaven",["G3772"]],["is",["G2076"]],["like",["G3664"]],["unto a net,",["G4522"]],["that was cast",["G906"]],["into",["G1519"]],["the sea,",["G2281"]],["and",["G2532"]],["gathered",["G4863"]],["of",["G1537"]],["every",["G3956"]],["kind:",[]]]},{"verse":48,"text":"Which, when it was full, they drew to shore, and sat down, and gathered the good into vessels, but cast the bad away.","words":[["Which,",["G3739"]],["when",["G3753"]],["it was full,",["G4137"]],["they drew",["G307"]],["to",["G1909"]],["shore,",["G123"]],["and",["G2532"]],["sat down,",["G2523"]],["and gathered",["G4816"]],["the good",["G2570"]],["into",["G1519"]],["vessels,",["G30"]],["but",["G1161"]],["cast",["G906"]],["the bad",["G4550"]],["away.",[]]]},{"verse":49,"text":"So shall it be at the end of the world: the angels shall come forth, and sever the wicked from among the just,","words":[["So",["G3779"]],["shall it be",["G2071"]],["at",["G1722"]],["the end",["G4930"]],["of the world:",["G165"]],["the angels",["G32"]],["shall come forth,",["G1831"]],["and",["G2532"]],["sever",["G873"]],["the wicked",["G4190"]],["from",["G1537"]],["among",["G3319"]],["the just,",[]]]},{"verse":50,"text":"And shall cast them into the furnace of fire: there shall be wailing and gnashing of teeth.","words":[["And",["G2532"]],["shall cast",["G906"]],["them",["G846"]],["into",["G1519"]],["the furnace",["G2575"]],["of fire:",["G4442"]],["there",["G1563"]],["shall be",["G2071"]],["wailing",["G2805"]],["and",["G2532"]],["gnashing",["G1030"]],["of teeth.",[]]]},{"verse":51,"text":"Jesus saith unto them, Have ye understood all these things? They say unto him, Yea, Lord.","words":[["Jesus",["G2424"]],["saith",["G3004"]],["unto them,",["G846"]],["Have ye understood",["G4920"]],["all",["G3956"]],["these",["G5023"]],["things?",["G3956"]],["They say",["G3004"]],["unto him,",["G846"]],["Yea,",["G3483"]],["Lord.",[]]]},{"verse":52,"text":"Then said he unto them, Therefore every scribe which is instructed unto the kingdom of heaven is like unto a man that is an householder, which bringeth forth out of his treasure things new and old.","words":[["Then",["G1161"]],["said",["G2036"]],["he unto them,",["G846"]],["Therefore",["G1223","G5124"]],["every",["G3956"]],["scribe",["G1122"]],["which is instructed",["G3100"]],["unto",["G1519"]],["the kingdom",["G932"]],["of heaven",["G3772"]],["is",["G2076"]],["like",["G3664"]],["unto a man",["G444"]],["that is an householder,",["G3617"]],["which",["G3748"]],["bringeth forth",["G1544"]],["out of",["G1537"]],["his",["G846"]],["treasure",["G2344"]],["things new",["G2537"]],["and",["G2532"]],["old.",[]]]},{"verse":53,"text":"And it came to pass, that when Jesus had finished these parables, he departed thence.","words":[["And",["G2532"]],["it came to pass,",["G1096"]],["that when",["G3753"]],["Jesus",["G2424"]],["had finished",["G5055"]],["these",["G5025"]],["parables,",["G3850"]],["he departed",["G3332"]],["thence.",[]]]},{"verse":54,"text":"And when he was come into his own country, he taught them in their synagogue, insomuch that they were astonished, and said, Whence hath this man this wisdom, and these mighty works?","words":[["And",["G2532"]],["when he was come",["G2064"]],["into",["G1519"]],["his own",["G846"]],["country,",["G3968"]],["he taught",["G1321"]],["them",["G846"]],["in",["G1722"]],["their",["G846"]],["synagogue,",["G4864"]],["insomuch that",["G5620"]],["they",["G846"]],["were astonished,",["G1605"]],["and",["G2532"]],["said,",["G3004"]],["Whence",["G4159"]],["hath this man",["G5129"]],["this",["G3778"]],["wisdom,",["G4678"]],["and",["G2532"]],["these mighty works?",[]]]},{"verse":55,"text":"Is not this the carpenter’s son? is not his mother called Mary? and his brethren, James, and Joses, and Simon, and Judas?","words":[["Is",["G2076"]],["not",["G3756"]],["this",["G3778"]],["the carpenter’s son?",["G5207"]],["is",["G3004"]],["not",["G3780"]],["his",["G846"]],["mother",["G3384"]],["called",["G3004"]],["Mary?",["G3137"]],["and",["G2532"]],["his",["G846"]],["brethren,",["G80"]],["James,",["G2385"]],["and",["G2532"]],["Joses,",["G2500"]],["and",["G2532"]],["Simon,",["G4613"]],["and",["G2532"]],["Judas?",[]]]},{"verse":56,"text":"And his sisters, are they not all with us? Whence then hath this man all these things?","words":[["And",["G2532"]],["his",["G846"]],["sisters,",["G79"]],["are they",["G1526"]],["not",["G3780"]],["all",["G3956"]],["with",["G4314"]],["us?",["G2248"]],["Whence",["G4159"]],["then",["G3767"]],["hath this man",["G5129"]],["all",["G3956"]],["these things?",[]]]},{"verse":57,"text":"And they were offended in him. But Jesus said unto them, A prophet is not without honour, save in his own country, and in his own house.","words":[["And",["G2532"]],["they were offended",["G4624"]],["in",["G1722"]],["him.",["G846"]],["But",["G1161"]],["Jesus",["G2424"]],["said",["G2036"]],["unto them,",["G846"]],["A prophet",["G4396"]],["is",["G2076"]],["not",["G3756"]],["without honour,",["G820"]],["save",["G1508"]],["in",["G1722"]],["his own",["G846"]],["country,",["G3968"]],["and",["G2532"]],["in",["G1722"]],["his own",["G846"]],["house.",[]]]},{"verse":58,"text":"And he did not many mighty works there because of their unbelief.","words":[["And",["G2532"]],["he did",["G4160"]],["not",["G3756"]],["many",["G4183"]],["mighty works",["G1411"]],["there",["G1563"]],["because",["G1223"]],["of their",["G846"]],["unbelief.",[]]]}]}