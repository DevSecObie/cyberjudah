{"book":"Matthew","chapter":4,"translation":"KJV","url":"/bible/matthew/4","verses":[{"verse":1,"text":"Then was Jesus led up of the Spirit into the wilderness to be tempted of the devil.","words":[["Then",["G5119"]],["was Jesus",["G2424"]],["led up",["G321"]],["of",["G5259"]],["the Spirit",["G4151"]],["into",["G1519"]],["the wilderness",["G2048"]],["to be tempted",["G3985"]],["of",["G5259"]],["the devil.",[]]]},{"verse":2,"text":"And when he had fasted forty days and forty nights, he was afterward an hungred.","words":[["And",["G2532"]],["when he had fasted",["G3522"]],["forty",["G5062"]],["days",["G2250"]],["and",["G2532"]],["forty",["G5062"]],["nights,",["G3571"]],["he was afterward",["G5305"]],["an hungred.",[]]]},{"verse":3,"text":"And when the tempter came to him, he said, If thou be the Son of God, command that these stones be made bread.","words":[["And",["G2532"]],["when the tempter",["G3985"]],["came",["G4334"]],["to him,",["G846"]],["he said,",["G2036"]],["If",["G1487"]],["thou be",["G1488"]],["the Son",["G5207"]],["of God,",["G2316"]],["command",["G2036"]],["that",["G2443"]],["these",["G3778"]],["stones",["G3037"]],["be made",["G1096"]],["bread.",[]]]},{"verse":4,"text":"But he answered and said, It is written, Man shall not live by bread alone, but by every word that proceedeth out of the mouth of God.","words":[["But",["G1161"]],["he answered",["G611"]],["and said,",["G2036"]],["It is written,",["G1125"]],["Man",["G444"]],["shall",["G2198"]],["not",["G3756"]],["live",["G2198"]],["by",["G1909"]],["bread",["G740"]],["alone,",["G3441"]],["but",["G235"]],["by",["G1909"]],["every",["G3956"]],["word",["G4487"]],["that proceedeth",["G1607"]],["out of",["G1223"]],["the mouth",["G4750"]],["of God.",[]]]},{"verse":5,"text":"Then the devil taketh him up into the holy city, and setteth him on a pinnacle of the temple,","words":[["Then",["G5119"]],["the devil",["G1228"]],["taketh",["G3880"]],["him",["G846"]],["up",["G3880"]],["into",["G1519"]],["the holy",["G40"]],