G1492"]],["the end.",[]]]},{"verse":59,"text":"Now the chief priests, and elders, and all the council, sought false witness against Jesus, to put him to death;","words":[["Now",["G1161"]],["the chief priests,",["G749"]],["and",["G2532"]],["elders,",["G4245"]],["and",["G2532"]],["all",["G3650"]],["the council,",["G4892"]],["sought",["G2212"]],["false witness",["G5577"]],["against",["G2596"]],["Jesus,",["G2424"]],["to",["G3704"]],["put",["G2289"]],["him",["G846"]],["to death;",[]]]},{"verse":60,"text":"But found none: yea, though many false witnesses came, yet found they none. At the last came two false witnesses,","words":[["But",["G2532"]],["found",["G2147"]],["none:",["G3756"]],["yea,",["G2532"]],["though many",["G4183"]],["false witnesses",["G5575"]],["came,",["G4334"]],["yet found they",["G2147"]],["none.",["G3756","G1161"]],["At the last",["G5305"]],["came",["G4334"]],["two",["G1417"]],["false witnesses,",[]]]},{"verse":61,"text":"And said, This fellow said, I am able to destroy the temple of God, and to build it in three days.","words":[["And said,",["G2036"]],["This",["G3778"]],["fellow said,",["G5346"]],["I am able",["G1410"]],["to destroy",["G2647"]],["the temple",["G3485"]],["of God,",["G2316"]],["and",["G2532"]],["to build",["G3618"]],["it",["G846"]],["in",["G1223"]],["three",["G5140"]],["days.",[]]]},{"verse":62,"text":"And the high priest arose, and said unto him, Answerest thou nothing? what is it which these witness against thee?","words":[["And",["G2532"]],["the high priest",["G749"]],["arose,",["G450"]],["and said",["G2036"]],["unto him,",["G846"]],["Answerest thou",["G611"]],["nothing?",["G3762"]],["what",["G5101"]],["is it which these",["G3778"]],["witness against",["G2649"]],["thee?",[]]]},{"verse":63,"text":"But Jesus held his peace. And the high priest answered and said unto him, I adjure thee by the living God, that thou tell us whether thou be the Christ, the Son of God.","words":[["But",["G1161"]],["Jesus",["G2424"]],["held his peace.",["G4623"]],["And",["G2532"]],["the high priest",["G749"]],["answered",["G611"]],["and said",["G2036"]],["unto him,",["G846"]],["I adjure",["G1844"]],["thee",["G4571"]],["by",["G2596"]],["the living",["G2198"]],["God,",["G2316"]],["that",["G2443"]],["thou tell",["G2036"]],["us",["G2254"]],["whether",["G1487"]],["thou",["G4771"]],["be",["G1488"]],["the Christ,",["G5547"]],["the Son",["G5207"]],["of God.",[]]]},{"verse":64,"text":"Jesus saith unto him, Thou hast said: nevertheless I say unto you, Hereafter shall ye see the Son of man sitting on the right hand of power, and coming in the clouds of heaven.","words":[["Jesus",["G2424"]],["saith",["G3004"]],["unto him,",["G846"]],["Thou",["G4771"]],["hast said:",["G2036"]],["nevertheless",["G4133"]],["I say",["G3004"]],["unto you,",["G5213"]],["Hereafter",["G737","G575"]],["shall ye see",["G3700"]],["the Son",["G5207"]],["of man",["G444"]],["sitting",["G2521"]],["on",["G1537"]],["the right hand",["G1188"]],["of power,",["G1411"]],["and",["G2532"]],["coming",["G2064"]],["in",["G1909"]],["the clouds",["G3507"]],["of heaven.",[]]]},{"verse":65,"text":"Then the high priest rent his clothes, saying, He hath spoken blasphemy; what further need have we of witnesses? behold, now ye have heard his blasphemy.","words":[["Then",["G5119"]],["the high priest",["G749"]],["rent",["G1284"]],["his",["G846"]],["clothes,",["G2440"]],["saying,",["G3004","G3754"]],["He hath spoken blasphemy;",["G987"]],["what",["G5101"]],["further",["G2089"]],["need",["G5532"]],["have we",["G2192"]],["of witnesses?",["G3144"]],["behold,",["G2396"]],["now",["G3568"]],["ye have heard",["G191"]],["his",["G846"]],["blasphemy.",[]]]},{"verse":66,"text":"What think ye? They answered and said, He is guilty of death.","words":[["What",["G5101"]],["think",["G1380"]],["ye?",["G5213"]],["They answered",["G611"]],["and",["G1161"]],["said,",["G2036"]],["He is",["G2076"]],["guilty",["G1777"]],["of death.",[]]]},{"verse":67,"text":"Then did they spit in his face, and buffeted him; and others smote him with the palms of their hands,","words":[["Then",["G5119"]],["did they spit",["G1716"]],["in",["G1519"]],["his",["G846"]],["face,",["G4383"]],["and",["G2532"]],["buffeted",["G2852"]],["him;",["G846"]],["and",["G1161"]],["others smote him with the palms of their hands,",[]]]},{"verse":68,"text":"Saying, Prophesy unto us, thou Christ, Who is he that smote thee?","words":[["Saying,",["G3004"]],["Prophesy",["G4395"]],["unto us,",["G2254"]],["thou Christ,",["G5547"]],["Who",["G5101"]],["is he",["G2076"]],["that smote",["G3817"]],["thee?",[]]]},{"verse":69,"text":"Now Peter sat without in the palace: and a damsel came unto him, saying, Thou also wast with Jesus of Galilee.","words":[["Now",["G1161"]],["Peter",["G4074"]],["sat",["G2521"]],["without",["G1854"]],["in",["G1722"]],["the palace:",["G833"]],["and",["G2532"]],["a",["G3391"]],["damsel",["G3814"]],["came",["G4334"]],["unto him,",["G846"]],["saying,",["G3004"]],["Thou",["G4771"]],["also",["G2532"]],["wast",["G2258"]],["with",["G3326"]],["Jesus",["G2424"]],["of Galilee.",[]]]},{"verse":70,"text":"But he denied before them all, saying, I know not what thou sayest.","words":[["But",["G1161"]],["he denied",["G720"]],["before",["G1715"]],["them all,",["G3956"]],["saying,",["G3004"]],["I know",["G1492"]],["not",["G3756"]],["what",["G5101"]],["thou sayest.",[]]]},{"verse":71,"text":"And when he was gone out into the porch, another maid saw him, and said unto them that were there, This fellow was also with Jesus of Nazareth.","words":[["And",["G1161"]],["when he",["G846"]],["was gone out",["G1831"]],["into",["G1519"]],["the porch,",["G4440"]],["another",["G243"]],["maid saw",["G1492"]],["him,",["G846"]],["and",["G2532"]],["said",["G3004"]],["unto them that were there,",["G1563"]],["This",["G3778"]],["fellow was",["G2258"]],["also",["G2532"]],["with",["G3326"]],["Jesus",["G2424"]],["of Nazareth.",[]]]},{"verse":72,"text":"And again he denied with an oath, I do not know the man.","words":[["And",["G2532"]],["again",["G3825"]],["he denied",["G720"]],["with",["G3326"]],["an oath,",["G3727","G3754"]],["I do",["G1492"]],["not",["G3756"]],["know",["G1492"]],["the man.",[]]]},{"verse":73,"text":"And after a while came unto him they that stood by, and said to Peter, Surely thou also art one of them; for thy speech bewrayeth thee.","words":[["And",["G1161"]],["after",["G3326"]],["a while",["G3397"]],["came unto him they",["G4334"]],["that stood by,",["G2476"]],["and said",["G2036"]],["to Peter,",["G4074"]],["Surely",["G230"]],["thou",["G4771"]],["also",["G2532"]],["art",["G1488"]],["one of",["G1537"]],["them;",["G846"]],["for",["G1063","G2532"]],["thy",["G4675"]],["speech",["G2981"]],["bewrayeth",["G1212"]],["thee.",["G4571"]]]},{"verse":74,"text":"Then began he to curse and to swear, saying, I know not the man. And immediately the cock crew.","words":[["Then",["G5119"]],["began he",["G756"]],["to curse",["G2653"]],["and",["G2532"]],["to swear,",["G3660"]],["saying,",["G3754"]],["I know",["G1492"]],["not",["G3756"]],["the man.",["G444"]],["And",["G2532"]],["immediately",["G2112"]],["the cock",["G220"]],["crew.",[]]]},{"verse":75,"text":"And Peter remembered the word of Jesus, which said unto him, Before the cock crow, thou shalt deny me thrice. And he went out, and wept bitterly.","words":[["And",["G2532"]],["Peter",["G4074"]],["remembered",["G3415"]],["the word",["G4487"]],["of Jesus,",["G2424"]],["which",["G3588"]],["said",["G2046"]],["unto him,",["G846"]],["Before",["G3754","G4250"]],["the cock",["G220"]],["crow,",["G5455"]],["thou shalt deny",["G533"]],["me",["G3165"]],["thrice.",["G5151"]],["And",["G2532"]],["he went out,",["G1854"]],["and",["G1831"]],["wept",["G2799"]],["bitterly.",[]]]}]}