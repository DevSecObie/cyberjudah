{"book":"Matthew","chapter":24,"translation":"KJV","url":"/bible/matthew/24","verses":[{"verse":1,"text":"And Jesus went out, and departed from the temple: and his disciples came to him for to shew him the buildings of the temple.","words":[["And",["G2532"]],["Jesus",["G2424"]],["went out,",["G1831"]],["and departed",["G4198"]],["from",["G575"]],["the temple:",["G2411"]],["and",["G2532"]],["his",["G846"]],["disciples",["G3101"]],["came",["G4334"]],["to him for to shew",["G1925"]],["him",["G846"]],["the buildings",["G3619"]],["of the temple.",[]]]},{"verse":2,"text":"And Jesus said unto them, See ye not all these things? verily I say unto you, There shall not be left here one stone upon another, that shall not be thrown down.","words":[["And",["G1161"]],["Jesus",["G2424"]],["said",["G2036"]],["unto them,",["G846"]],["See ye",["G991"]],["not",["G3756"]],["all",["G3956"]],["these things?",["G5023"]],["verily",["G281"]],["I say",["G3004"]],["unto you,",["G5213"]],["There shall",["G863"]],["not",["G3364"]],["be left",["G863"]],["here",["G5602"]],["one stone",["G3037"]],["upon",["G1909"]],["another,",["G3037"]],["that",["G3739"]],["shall",["G2647"]],["not",["G3364"]],["be thrown down.",[]]]},{"verse":3,"text":"And as he sat upon the mount of Olives, the disciples came unto him privately, saying, Tell us, when shall these things be? and what shall be the sign of thy coming, and of the end of the world?","words":[["And",["G1161"]],["as he",["G846"]],["sat",["G2521"]],["upon",["G1909"]],["the mount",["G3735"]],["of Olives,",["G1636"]],["the disciples",["G3101"]],["came",["G4334"]],["unto him",["G846"]],["privately,",["G2596","G2398"]],["saying,",["G3004"]],["Tell",["G2036"]],["us,",["G2254"]],["when",["G4219"]],["shall",["G2071"]],["these things",["G5023"]],["be?",["G2071"]],["and",["G2532"]],["what",["G5101"]],["shall be the sign",["G4592"]],["of thy",["G4674"]],["coming,",["G3952"]],["and",["G2532"]],["of the end",["G4930"]],["of the world?",[]]]},{"verse":4,"text":"And Jesus answered and said unto them, Take heed that no man deceive you.","words":[["And",["G2532"]],["Jesus",["G2424"]],["answered",["G611"]],["and said",["G2036"]],["unto them,",["G846"]],["Take heed",["G991"]],["that no",["G3361"]],["man",["G5100"]],["deceive",["G4105"]],["you.",[]]]},{"verse":5,"text":"For many shall come in my name, saying, I am Christ; and shall deceive many.","words":[["For",["G1063"]],["many",["G4183"]],["shall come",["G2064"]],["in",["G1909"]],["my",["G3450"]],["name,",["G3686"]],["saying,",["G3004"]],["I",["G1473"]],["am",["G1510"]],["Christ;",["G5547"]],["and",["G2532"]],["shall deceive",["G4105"]],["many.",[]]]},{"verse":6,"text":"And ye shall hear of wars and rumours of wars: see that ye be not troubled: for all these things must come to pass, but the end is not yet.","words":[["And",["G1161"]],["ye shall",["G3195"]],["hear",["G191"]],["of wars",["G4171"]],["and",["G2532"]],["rumours",["G189"]],["of wars:",["G4171"]],["see",["G3708"]],["that ye be",["G2360"]],["not",["G3361"]],["troubled:",["G2360"]],["for",["G1063"]],["all",["G3956"]],["these things must",["G1163"]],["come to pass,",["G1096"]],["but",["G235"]],["the end",["G5056"]],["is",["G2076"]],["not yet.",[]]]},{"verse":7,"text":"For nation shall rise against nation, and kingdom against kingdom: and there shall be famines, and pestilences, and earthquakes, in divers places.","words":[["For",["G1063"]],["nation",["G1484"]],["shall rise",["G1453"]],["against",["G1909"]],["nation,",["G1484"]],["and",["G2532"]],["kingdom",["G932"]],["against",["G1909"]],["kingdom:",["G932"]],["and",["G2532"]],["there shall be",["G2071"]],["famines,",["G3042"]],["and",["G2532"]],["pestilences,",["G3061"]],["and",["G2532"]],["earthquakes,",["G4578"]],["in divers",["G2596"]],["places.",[]]]},{"verse":8,"text":"All these are the beginning of sorrows.","words":[["All",["G1161","G3956"]],["these",["G5023"]],["are the beginning",["G746"]],["of sorrows.",[]]]},{"verse":9,"text":"Then shall they deliver you up to be afflicted, and shall kill you: and ye shall be hated of all nations for my name’s sake.","words":[["Then",["G5119"]],["shall they deliver",["G3860"]],["you",["G5209"]],["up",["G3860"]],["to",["G1519"]],["be afflicted,",["G2347"]],["and",["G2532"]],["shall kill",["G615"]],["you:",["G5209"]],["and",["G2532"]],["ye shall be",["G2071"]],["hated",["G3404"]],["of",["G5259"]],["all",["G3956"]],["nations",["G1484"]],["for",["G1223"]],["my",["G3450"]],["name’s sake.",[]]]},{"verse":10,"text":"And then shall many be offended, and shall betray one another, and shall hate one another.","words":[["And",["G2532"]],["then",["G5119"]],["shall many",["G4183"]],["be offended,",["G4624"]],["and",["G2532"]],["shall betray",["G3860"]],["one another,",["G240"]],["and",["G2532"]],["shall hate",["G3404"]],["one another.",[]]]},{"verse":11,"text":"And many false prophets shall rise, and shall deceive many.","words":[["And",["G2532"]],["many",["G4183"]],["false prophets",["G5578"]],["shall rise,",["G1453"]],["and",["G2532"]],["shall deceive",["G4105"]],["many.",[]]]},{"verse":12,"text":"And because iniquity shall abound, the love of many shall wax cold.","words":[["And",["G2532"]],["because",["G1223"]],["iniquity",["G458"]],["shall abound,",["G4129"]],["the love",["G26"]],["of many",["G4183"]],["shall wax cold.",[]]]},{"verse":13,"text":"But he that shall endure unto the end, the same shall be saved.","words":[["But",["G1161"]],["he that shall endure",["G5278"]],["unto",["G1519"]],["the end,",["G5056"]],["the same",["G3778"]],["shall be saved.",[]]]},{"verse":14,"text":"And this gospel of the kingdom shall be preached in all the world for a witness unto all nations; and then shall the end come.","words":[["And",["G2532"]],["this",["G5124"]],["gospel",["G2098"]],["of the kingdom",["G932"]],["shall be preached",["G2784"]],["in",["G1722"]],["all",["G3650"]],["the world",["G3625"]],["for",["G1519"]],["a witness",["G3142"]],["unto all",["G3956"]],["nations;",["G1484"]],["and",["G2532"]],["then",["G5119"]],["shall the end",["G5056"]],["come.",[]]]},{"verse":15,"text":"When ye therefore shall see the abomination of desolation, spoken of by Daniel the prophet, stand in the holy place, (whoso readeth, let him understand:)","words":[["When",["G3752"]],["ye therefore",["G3767"]],["shall see",["G1492"]],["the abomination",["G946"]],["of desolation,",["G2050"]],["spoken of",["G4483"]],["by",["G1223"]],["Daniel",["G1158"]],["the prophet,",["G4396"]],["stand",["G2476","G2476"]],["in",["G1722"]],["the holy",["G40"]],["place,",["G5117"]],["(whoso readeth,",["G314"]],["let him understand:)",[]]]},{"verse":16,"text":"Then let them which be in Judea flee into the mountains:","words":[["Then",["G5119"]],["let them which be in",["G1722"]],["Judea",["G2449"]],["flee",["G5343"]],["into",["G1909"]],["the mountains:",[]]]},{"verse":17,"text":"Let him which is on the housetop not come down to take any thing out of his house:","words":[["Let him which is on",["G1909"]],["the housetop",["G1430"]],["not",["G3361"]],["come down",["G2597"]],["to take",["G142"]],["any thing",["G5100"]],["out of",["G1537"]],["his",["G846"]],["house:",[]]]},{"verse":18,"text":"Neither let him which is in the field return back to take his clothes.","words":[["Neither",["G3361"]],["let him which is in",["G1722"]],["the field",["G68"]],["return",["G1994"]],["back",["G3694"]],["to take",["G142"]],["his",["G846"]],["clothes.",[]]]},{"verse":19,"text":"And woe unto them that are with child, and to them that give suck in those days!","words":[["And",["G1161"]],["woe",["G3759"]],["unto them that are",["G2192"]],["with",["G1722"]],["child,",["G1064"]],["and",["G2532"]],["to them that give suck",["G2337"]],["in",["G1722"]],["those",["G1565"]],["days!",[]]]},{"verse":20,"text":"But pray ye that your flight be not in the winter, neither on the sabbath day:","words":[["But",["G1161"]],["pray ye",["G4336"]],["that",["G3363"]],["your",["G5216"]],["flight",["G5437"]],["be",["G1096"]],["not",["G3363"]],["in the winter,",["G5494"]],["neither",["G3366"]],["on",["G1722"]],["the sabbath day:",[]]]},{"verse":21,"text":"For then shall be great tribulation, such as was not since the beginning of the world to this time, no, nor ever shall be.","words":[["For",["G1063"]],["then",["G5119"]],["shall be",["G2071"]],["great",["G3173"]],["tribulation,",["G2347"]],["such as",["G3634"]],["was",["G1096"]],["not",["G3756"]],["since",["G575"]],["the beginning",["G746"]],["of the world",["G2889"]],["to this",["G2193"]],["time,",["G3568"]],["no,",["G3761"]],["nor ever",["G3364"]],["shall be.",[]]]},{"verse":22,"text":"And except those days should be shortened, there should no flesh be saved: but for the elect’s sake those days shall be shortened.","words":[["And",["G2532"]],["except",["G1508"]],["those",["G1565"]],["days",["G2250"]],["should be shortened,",["G2856"]],["there",["G3756"]],["should",["G302"]],["no",["G3956"]],["flesh",["G4561"]],["be saved:",["G4982"]],["but",["G1161"]],["for",["G1223"]],["the elect’s sake",["G1588"]],["those",["G1565"]],["days",["G2250"]],["shall be shortened.",[]]]},{"verse":23,"text":"Then if any man shall say unto you, Lo, here is Christ, or there; believe it not.","words":[["Then",["G5119"]],["if",["G1437"]],["any man",["G5100"]],["shall say",["G2036"]],["unto you,",["G5213"]],["Lo,",["G2400"]],["here",["G5602"]],["is Christ,",["G5547"]],["or",["G2228"]],["there;",["G5602"]],["believe",["G4100"]],["it not.",[]]]},{"verse":24,"text":"For there shall arise false Christs, and false prophets, and shall shew great signs and wonders; insomuch that, if it were possible, they shall deceive the very elect.","words":[["For",["G1063"]],["there shall arise",["G1453"]],["false Christs,",["G5580"]],["and",["G2532"]],["false prophets,",["G5578"]],["and",["G2532"]],["shall shew",["G1325"]],["great",["G3173"]],["signs",["G4592"]],["and",["G2532"]],["wonders;",["G5059"]],["insomuch that,",["G5620"]],["if",["G1487"]],["it were possible,",["G1415"]],["they shall deceive",["G4105"]],["the very",["G2532"]],["elect.",[]]]},{"verse":25,"text":"Behold, I have told you before.","words":[["Behold,",["G2400"]],["I have told",["G4280"]],["you",["G5213"]],["before.",[]]]},{"verse":26,"text":"Wherefore if they shall say unto you, Behold, he is in the desert; go not forth: behold, he is in the secret chambers; believe it not.","words":[["Wherefore",["G3767"]],["if",["G1437"]],["they shall say",["G2036"]],["unto you,",["G5213"]],["Behold,",["G2400"]],["he is",["G2076"]],["in",["G1722"]],["the desert;",["G2048"]],["go",["G1831"]],["not",["G3361"]],["forth:",["G1831"]],["behold,",["G2400"]],["he is in",["G1722"]],["the secret chambers;",["G5009"]],["believe",["G4100"]],["it not.",[]]]},{"verse":27,"text":"For as the lightning cometh out of the east, and shineth even unto the west; so shall also the coming of the Son of man be.","words":[["For",["G1063"]],["as",["G5618"]],["the lightning",["G796"]],["cometh",["G1831"]],["out of",["G575"]],["the east,",["G395"]],["and",["G2532"]],["shineth",["G5316"]],["even unto",["G2193"]],["the west;",["G1424"]],["so",["G3779"]],["shall",["G2071"]],["also",["G2532"]],["the coming",["G3952"]],["of the Son",["G5207"]],["of man",["G444"]],["be.",[]]]},{"verse":28,"text":"For wheresoever the carcase is, there will the eagles be gathered together.","words":[["For",["G1063"]],["wheresoever",["G1437","G3699"]],["the carcase",["G4430"]],["is,",["G5600"]],["there",["G1563"]],["will",["G4863"]],["the eagles",["G105"]],["be gathered together.",[]]]},{"verse":29,"text":"Immediately after the tribulation of those days shall the sun be darkened, and the moon shall not give her light, and the stars shall fall from heaven, and the powers of the heavens shall be shaken:","words":[["Immediately",["G1161","G2112"]],["after",["G3326"]],["the tribulation",["G2347"]],["of those",["G1565"]],["days",["G2250"]],["shall the sun",["G2246"]],["be darkened,",["G4654"]],["and",["G2532"]],["the moon",["G4582"]],["shall",["G1325"]],["not",["G3756"]],["give",["G1325"]],["her",["G846"]],["light,",["G5338"]],["and",["G2532"]],["the stars",["G792"]],["shall fall",["G4098"]],["from",["G575"]],["heaven,",["G3772"]],["and",["G2532"]],["the powers",["G1411"]],["of the heavens",["G3772"]],["shall be shaken:",[]]]},{"verse":30,"text":"And then shall appear the sign of the Son of man in heaven: and then shall all the tribes of the earth mourn, and they shall see the Son of man coming in the clouds of heaven with power and great glory.","words":[["And",["G2532"]],["then",["G5119"]],["shall appear",["G5316"]],["the sign",["G4592"]],["of the Son",["G5207"]],["of man",["G444"]],["in",["G1722"]],["heaven:",["G3772"]],["and",["G2532"]],["then",["G5119"]],["shall",["G2875"]],["all",["G3956"]],["the tribes",["G5443"]],["of the earth",["G1093"]],["mourn,",["G2875"]],["and",["G2532"]],["they shall see",["G3700"]],["the Son",["G5207"]],["of man",["G444"]],["coming",["G2064"]],["in",["G1909"]],["the clouds",["G3507"]],["of heaven",["G3772"]],["with",["G3326"]],["power",["G1411"]],["and",["G2532"]],["great",["G4183"]],["glory.",[]]]},{"verse":31,"text":"And he shall send his angels with a great sound of a trumpet, and they shall gather together his elect from the four winds, from one end of heaven to the other.","words":[["And",["G2532"]],["he shall send",["G649"]],["his",["G846"]],["angels",["G32"]],["with",["G3326"]],["a great",["G3173"]],["sound",["G5456"]],["of a trumpet,",["G4536"]],["and",["G2532"]],["they shall gather together",["G1996"]],["his",["G846"]],["elect",["G1588"]],["from",["G1537"]],["the four",["G5064"]],["winds,",["G417"]],["from",["G575"]],["one end",["G206"]],["of heaven",["G3772"]],["to",["G2193"]],["the other.",["G206"]]]},{"verse":32,"text":"Now learn a parable of the fig tree; When his branch is yet tender, and putteth forth leaves, ye know that summer is nigh:","words":[["Now",["G1161"]],["learn",["G3129"]],["a parable",["G3850"]],["of",["G575"]],["the fig tree;",["G4808"]],["When",["G3752"]],["his",["G846"]],["branch",["G2798"]],["is",["G1096"]],["yet",["G2235"]],["tender,",["G527"]],["and",["G2532"]],["putteth forth",["G1631"]],["leaves,",["G5444"]],["ye know",["G1097"]],["that",["G3754"]],["summer",["G2330"]],["is nigh:",[]]]},{"verse":33,"text":"So likewise ye, when ye shall see all these things, know that it is near, even at the doors.","words":[["So",["G3779"]],["likewise",["G2532"]],["ye,",["G5210"]],["when",["G3752"]],["ye shall see",["G1492"]],["all",["G3956"]],["these things,",["G5023"]],["know",["G1097"]],["that",["G3754"]],["it is",["G2076"]],["near,",["G1451"]],["even at",["G1909"]],["the doors.",[]]]},{"verse":34,"text":"Verily I say unto you, This generation shall not pass, till all these things be fulfilled.","words":[["Verily",["G281"]],["I say",["G3004"]],["unto you,",["G5213"]],["This",["G3778"]],["generation",["G1074"]],["shall not",["G3364"]],["pass,",["G3928"]],["till",["G302","G2193"]],["all",["G3956"]],["these things",["G5023"]],["be fulfilled.",[]]]},{"verse":35,"text":"Heaven and earth shall pass away, but my words shall not pass away.","words":[["Heaven",["G3772"]],["and",["G2532"]],["earth",["G1093"]],["shall pass away,",["G3928"]],["but",["G1161"]],["my",["G3450"]],["words",["G3056"]],["shall",["G3928"]],["not",["G3364"]],["pass away.",[]]]},{"verse":36,"text":"But of that day and hour knoweth no man, no, not the angels of heaven, but my Father only.","words":[["But",["G1161"]],["of",["G4012"]],["that",["G1565"]],["day",["G2250"]],["and",["G2532"]],["hour",["G5610"]],["knoweth",["G1492"]],["no",["G3762"]],["man, no, not",["G3761"]],["the angels",["G32"]],["of heaven,",["G3772"]],["but",["G1508"]],["my",["G3450"]],["Father",["G3962"]],["only.",[]]]},{"verse":37,"text":"But as the days of Noe were, so shall also the coming of the Son of man be.","words":[["But",["G1161"]],["as",["G5618"]],["the days",["G2250"]],["of Noe",["G3575"]],["were, so",["G3779"]],["shall",["G2071"]],["also",["G2532"]],["the coming",["G3952"]],["of the Son",["G5207"]],["of man",["G444"]],["be.",[]]]},{"verse":38,"text":"For as in the days that were before the flood they were eating and drinking, marrying and giving in marriage, until the day that Noe entered into the ark,","words":[["For",["G1063"]],["as",["G5618"]],["in",["G1722"]],["the days",["G2250"]],["that were",["G2258"]],["before",["G4253"]],["the flood",["G2627"]],["they were eating",["G5176"]],["and",["G2532"]],["drinking,",["G4095"]],["marrying",["G1060"]],["and",["G2532"]],["giving in marriage,",["G1547"]],["until",["G891"]],["the day",["G2250"]],["that",["G3739"]],["Noe",["G3575"]],["entered",["G1525"]],["into",["G1519"]],["the ark,",[]]]},{"verse":39,"text":"And knew not until the flood came, and took them all away; so shall also the coming of the Son of man be.","words":[["And",["G2532"]],["knew",["G1097"]],["not",["G3756"]],["until",["G2193"]],["the flood",["G2627"]],["came,",["G2064"]],["and",["G2532"]],["took",["G142"]],["them all",["G537"]],["away;",["G142"]],["so",["G3779"]],["shall",["G2071"]],["also",["G2532"]],["the coming",["G3952"]],["of the Son",["G5207"]],["of man",["G444"]],["be.",[]]]},{"verse":40,"text":"Then shall two be in the field; the one shall be taken, and the other left.","words":[["Then",["G5119"]],["shall",["G2071"]],["two",["G1417"]],["be",["G2071"]],["in",["G1722"]],["the field;",["G68"]],["the one",["G1520"]],["shall be taken,",["G3880"]],["and",["G2532"]],["the other",["G1520"]],["left.",[]]]},{"verse":41,"text":"Two women shall be grinding at the mill; the one shall be taken, and the other left.","words":[["Two",["G1417"]],["women shall be grinding",["G229"]],["at",["G1722"]],["the mill;",["G3459"]],["the one",["G3391"]],["shall be taken,",["G3880"]],["and",["G2532"]],["the other",["G3391"]],["left.",[]]]},{"verse":42,"text":"Watch therefore: for ye know not what hour your Lord doth come.","words":[["Watch",["G1127"]],["therefore:",["G3767"]],["for",["G3754"]],["ye know",["G1492"]],["not",["G3756"]],["what",["G4169"]],["hour",["G5610"]],["your",["G5216"]],["Lord",["G2962"]],["doth come.",[]]]},{"verse":43,"text":"But know this, that if the goodman of the house had known in what watch the thief would come, he would have watched, and would not have suffered his house to be broken up.","words":[["But",["G1161"]],["know",["G1097"]],["this,",["G1565"]],["that",["G3754"]],["if",["G1487"]],["the goodman of the house",["G3617"]],["had known",["G1492"]],["in what",["G4169"]],["watch",["G5438"]],["the thief",["G2812"]],["would come,",["G2064"]],["he would",["G302"]],["have watched,",["G1127"]],["and",["G2532"]],["would",["G302"]],["not",["G3756"]],["have suffered",["G1439"]],["his",["G846"]],["house",["G3614"]],["to be broken up.",[]]]},{"verse":44,"text":"Therefore be ye also ready: for in such an hour as ye think not the Son of man cometh.","words":[["Therefore",["G1223","G5124"]],["be",["G1096"]],["ye",["G5210"]],["also",["G2532"]],["ready:",["G2092"]],["for",["G3754"]],["in such",["G3739"]],["an hour",["G5610"]],["as ye think",["G1380"]],["not",["G3756"]],["the Son",["G5207"]],["of man",["G444"]],["cometh.",[]]]},{"verse":45,"text":"Who then is a faithful and wise servant, whom his lord hath made ruler over his household, to give them meat in due season?","words":[["Who",["G5101"]],["then",["G686"]],["is",["G2076"]],["a faithful",["G4103"]],["and",["G2532"]],["wise",["G5429"]],["servant,",["G1401"]],["whom",["G3739"]],["his",["G846"]],["lord",["G2962"]],["hath made ruler",["G2525"]],["over",["G1909"]],["his",["G846"]],["household,",["G2322"]],["to give",["G1325"]],["them",["G846"]],["meat",["G5160"]],["in",["G1722"]],["due season?",[]]]},{"verse":46,"text":"Blessed is that servant, whom his lord when he cometh shall find so doing.","words":[["Blessed",["G3107"]],["is that",["G1565"]],["servant,",["G1401"]],["whom",["G3739"]],["his",["G846"]],["lord",["G2962"]],["when he cometh",["G2064"]],["shall find",["G2147"]],["so",["G3779"]],["doing.",[]]]},{"verse":47,"text":"Verily I say unto you, That he shall make him ruler over all his goods.","words":[["Verily",["G281"]],["I say",["G3004"]],["unto you,",["G5213"]],["That",["G3754"]],["he shall make",["G2525"]],["him",["G846"]],["ruler",["G2525"]],["over",["G1909"]],["all",["G3956"]],["his",["G846"]],["goods.",[]]]},{"verse":48,"text":"But and if that evil servant shall say in his heart, My lord delayeth his coming;","words":[["But and",["G1161"]],["if",["G1437"]],["that",["G1565"]],["evil",["G2556"]],["servant",["G1401"]],["shall say",["G2036"]],["in",["G1722"]],["his",["G846"]],["heart,",["G2588"]],["My",["G3450"]],["lord",["G2962"]],["delayeth",["G5549"]],["his coming;",[]]]},{"verse":49,"text":"And shall begin to smite his fellowservants, and to eat and drink with the drunken;","words":[["And",["G2532"]],["shall begin",["G756"]],["to smite",["G5180"]],["his fellowservants,",["G4889"]],["and",["G1161"]],["to eat",["G2068"]],["and",["G2532"]],["drink",["G4095"]],["with",["G3326"]],["the drunken;",[]]]},{"verse":50,"text":"The lord of that servant shall come in a day when he looketh not for him, and in an hour that he is not aware of,","words":[["The lord",["G2962"]],["of that",["G1565"]],["servant",["G1401"]],["shall come",["G2240"]],["in",["G1722"]],["a day",["G2250"]],["when",["G3739"]],["he looketh",["G4328"]],["not",["G3756"]],["for him, and",["G2532"]],["in",["G1722"]],["an hour",["G5610"]],["that",["G3739"]],["he is",["G1097"]],["not",["G3756"]],["aware of,",[]]]},{"verse":51,"text":"And shall cut him asunder, and appoint him his portion with the hypocrites: there shall be weeping and gnashing of teeth.","words":[["And",["G2532"]],["shall cut",["G1371"]],["him",["G846"]],["asunder,",["G1371"]],["and",["G2532"]],["appoint",["G5087"]],["him his",["G846"]],["portion",["G3313"]],["with",["G3326"]],["the hypocrites:",["G5273"]],["there",["G1563"]],["shall be",["G2071"]],["weeping",["G2805"]],["and",["G2532"]],["gnashing",["G1030"]],["of teeth.",[]]]}]}