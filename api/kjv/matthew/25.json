{"book":"Matthew","chapter":25,"translation":"KJV","url":"/bible/matthew/25","verses":[{"verse":1,"text":"Then shall the kingdom of heaven be likened unto ten virgins, which took their lamps, and went forth to meet the bridegroom.","words":[["Then",["G5119"]],["shall the kingdom",["G932"]],["of heaven",["G3772"]],["be likened",["G3666"]],["unto ten",["G1176"]],["virgins,",["G3933"]],["which",["G3748"]],["took",["G2983"]],["their",["G846"]],["lamps,",["G2985"]],["and went forth",["G1831"]],["to meet",["G529","G1519"]],["the bridegroom.",[]]]},{"verse":2,"text":"And five of them were wise, and five were foolish.","words":[["And",["G1161"]],["five",["G4002"]],["of",["G1537"]],["them",["G846"]],["were",["G2258"]],["wise,",["G5429"]],["and",["G2532"]],["five",["G4002"]],["were foolish.",[]]]},{"verse":3,"text":"They that were foolish took their lamps, and took no oil with them:","words":[["They",["G3748"]],["that were foolish",["G3474"]],["took",["G2983"]],["their",["G846","G1438"]],["lamps,",["G2985"]],["and took",["G2983"]],["no",["G3756"]],["oil",["G1637"]],["with",["G3326"]],["them:",[]]]},{"verse":4,"text":"But the wise took oil in their vessels with their lamps.","words":[["But",["G1161"]],["the wise",["G5429"]],["took",["G2983"]],["oil",["G1637"]],["in",["G1722"]],["their",["G846"]],["vessels",["G30"]],["with",["G3326"]],["their",["G846"]],["lamps.",[]]]},{"verse":5,"text":"While the bridegroom tarried, they all slumbered and slept.","words":[["While",["G1161"]],["the bridegroom",["G3566"]],["tarried,",["G5549"]],["they all",["G3956"]],["slumbered",["G3573"]],["and",["G2532"]],["slept.",[]]]},{"verse":6,"text":"And at midnight there was a cry made, Behold, the bridegroom cometh; go ye out to meet him.","words":[["And",["G1161"]],["at midnight",["G3319","G3571"]],["there was a cry",["G2906"]],["made,",["G1096"]],["Behold,",["G2400"]],["the bridegroom",["G3566"]],["cometh;",["G2064"]],["go ye out",["G1831"]],["to",["G1519"]],["meet",["G529"]],["him.",[]]]},{"verse":