 is",["G2076"]],["a desert",["G2048"]],["place,",["G5117"]],["and",["G2532"]],["the time",["G5610"]],["is now",["G2235"]],["past;",["G3928"]],["send",["G630"]],["the multitude",["G3793"]],["away,",["G630"]],["that",["G2443"]],["they may go",["G565"]],["into",["G1519"]],["the villages,",["G2968"]],["and buy",["G59"]],["themselves",["G1438"]],["victuals.",[]]]},{"verse":16,"text":"But Jesus said unto them, They need not depart; give ye them to eat.","words":[["But",["G1161"]],["Jesus",["G2424"]],["said",["G2036"]],["unto them,",["G846"]],["They need",["G5532"]],["not",["G3756"]],["depart;",["G565","G2192"]],["give",["G1325"]],["ye",["G5210"]],["them",["G846"]],["to eat.",[]]]},{"verse":17,"text":"And they say unto him, We have here but five loaves, and two fishes.","words":[["And",["G1161"]],["they say",["G3004"]],["unto him,",["G846"]],["We have",["G2192"]],["here",["G5602"]],["but",["G3756","G1508"]],["five",["G4002"]],["loaves,",["G740"]],["and",["G2532"]],["two",["G1417"]],["fishes.",[]]]},{"verse":18,"text":"He said, Bring them hither to me.","words":[["He said,",["G2036"]],["Bring",["G5342"]],["them",["G846"]],["hither",["G5602"]],["to me.",[]]]},{"verse":19,"text":"And he commanded the multitude to sit down on the grass, and took the five loaves, and the two fishes, and looking up to heaven, he blessed, and brake, and gave the loaves to his disciples, and the disciples to the multitude.","words":[["And",["G2532"]],["he commanded",["G2753"]],["the multitude",["G3793"]],["to sit down",["G347"]],["on",["G1909"]],["the grass,",["G5528"]],["and",["G2532"]],["took",["G2983"]],["the five",["G4002"]],["loaves,",["G740"]],["and",["G2532"]],["the two",["G1417"]],["fishes,",["G2486"]],["and looking up",["G308"]],["to",["G1519"]],["heaven,",["G3772"]],["he blessed,",["G2127"]],["and",["G2532"]],["brake,",["G2806"]],["and gave",["G1325"]],["the loaves",["G740"]],["to his disciples,",["G3101"]],["and",["G1161"]],["the disciples",["G3101"]],["to the multitude.",[]]]},{"verse"