{"book":"Matthew","chapter":14,"translation":"KJV","url":"/bible/matthew/14","verses":[{"verse":1,"text":"At that time Herod the tetrarch heard of the fame of Jesus,","words":[["At",["G1722"]],["that",["G1565"]],["time",["G2540"]],["Herod",["G2264"]],["the tetrarch",["G5076"]],["heard",["G191"]],["of the fame",["G189"]],["of Jesus,",[]]]},{"verse":2,"text":"And said unto his servants, This is John the Baptist; he is risen from the dead; and therefore mighty works do shew forth themselves in him.","words":[["And",["G2532"]],["said",["G2036"]],["unto his",["G846"]],["servants,",["G3816"]],["This",["G3778"]],["is",["G2076"]],["John",["G2491"]],["the Baptist;",["G910"]],["he",["G846"]],["is risen",["G1453"]],["from",["G575"]],["the dead;",["G3498"]],["and",["G2532"]],["therefore",["G1223","G5124"]],["mighty works",["G1411"]],["do shew forth themselves",["G1754"]],["in",["G1722"]],["him.",[]]]},{"verse":3,"text":"For Herod had laid hold on John, and bound him, and put him in prison for Herodias’ sake, his brother Philip’s wife.","words":[["For",["G1063"]],["Herod",["G2264"]],["had laid hold",["G2902"]],["on John,",["G2491"]],["and bound",["G1210"]],["him,",["G846"]],["and",["G2532"]],["put",["G5087"]],["him in",["G1722"]],["prison",["G5438"]],["for",["G1223"]],["Herodias’",["G2266"]],["sake,",["G1223"]],["his",["G846"]],["brother",["G80"]],["Philip’s wife.",[]]]},{"verse":4,"text":"For John said unto him, It is not lawful for thee to have her.","words":[["For",["G1063"]],["John",["G2491"]],["said",["G3004"]],["unto him,",["G846"]],["It is",["G1832"]],["not",["G3756"]],["lawful",["G1832"]],["for thee",["G4671"]],["to have",["G2192"]],["her.",[]]]},{"verse":5,"text":"And when he would have put him to death, he feared the multitude, because they counted him as a prophet.","words":[["And",["G2532"]],["when he would",["G2309"]],["have put",["G615"]],["him",["G846"]],["to death,",["G615"]],["he feared",["G5399"]],["the multitude,",["G3793"]],["because",["G3754"]],["they counte