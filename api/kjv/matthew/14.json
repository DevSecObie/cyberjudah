],["now",["G2235"]],["in the midst",["G3319"]],["of the sea,",["G2281"]],["tossed",["G928"]],["with",["G5259"]],["waves:",["G2949"]],["for",["G1063"]],["the wind",["G417"]],["was",["G2258"]],["contrary.",[]]]},{"verse":25,"text":"And in the fourth watch of the night Jesus went unto them, walking on the sea.","words":[["And",["G1161"]],["in the fourth",["G5067"]],["watch",["G5438"]],["of the night",["G3571"]],["Jesus",["G2424"]],["went",["G565"]],["unto",["G4314"]],["them,",["G846"]],["walking",["G4043"]],["on",["G1909"]],["the sea.",[]]]},{"verse":26,"text":"And when the disciples saw him walking on the sea, they were troubled, saying, It is a spirit; and they cried out for fear.","words":[["And",["G2532"]],["when the disciples",["G3101"]],["saw",["G1492"]],["him",["G846"]],["walking",["G4043"]],["on",["G1909"]],["the sea,",["G2281"]],["they were troubled,",["G5015"]],["saying,",["G3004","G3754"]],["It is",["G2076"]],["a spirit;",["G5326"]],["and",["G2532"]],["they cried out",["G2896"]],["for",["G575"]],["fear.",[]]]},{"verse":27,"text":"But straightway Jesus spake unto them, saying, Be of good cheer; it is I; be not afraid.","words":[["But",["G1161"]],["straightway",["G2112"]],["Jesus",["G2424"]],["spake",["G2980"]],["unto them,",["G846"]],["saying,",["G3004"]],["Be of good cheer;",["G2293"]],["it is",["G1510"]],["I;",["G1473"]],["be",["G5399"]],["not",["G3361"]],["afraid.",[]]]},{"verse":28,"text":"And Peter answered him and said, Lord, if it be thou, bid me come unto thee on the water.","words":[["And",["G1161"]],["Peter",["G4074"]],["answered",["G611"]],["him",["G846"]],["and said,",["G2036"]],["Lord,",["G2962"]],["if",["G1487"]],["it be",["G1488"]],["thou,",["G4771"]],["bid",["G2753"]],["me",["G3165"]],["come",["G2064"]],["unto",["G4314"]],["thee",["G4571"]],["on",["G1909"]],["the water.",[]]]},{"verse":29,"text":"And he said, Come. And when Peter was come down out of the ship, he walked on the water, to go to Jesus.","words":[["And",["G1161"]],["he said,",["G2