{"book":"Matthew","chapter":2,"translation":"KJV","url":"/bible/matthew/2","verses":[{"verse":1,"text":"Now when Jesus was born in Bethlehem of Judea in the days of Herod the king, behold, there came wise men from the east to Jerusalem,","words":[["Now",["G1161"]],["when Jesus",["G2424"]],["was born",["G1080"]],["in",["G1722"]],["Bethlehem",["G965"]],["of Judea",["G2449"]],["in",["G1722"]],["the days",["G2250"]],["of Herod",["G2264"]],["the king,",["G935"]],["behold,",["G2400"]],["there came",["G3854"]],["wise men",["G3097"]],["from",["G575"]],["the east",["G395"]],["to",["G1519"]],["Jerusalem,",[]]]},{"verse":2,"text":"Saying, Where is he that is born King of the Jews? for we have seen his star in the east, and are come to worship him.","words":[["Saying,",["G3004"]],["Where",["G4226"]],["is",["G2076"]],["he that is born",["G5088"]],["King",["G935"]],["of the Jews?",["G2453"]],["for",["G1063"]],["we have seen",["G1492"]],["his",["G846"]],["star",["G792"]],["in",["G1722"]],["the east,",["G395"]],["and",["G2532"]],["are come",["G2064"]],["to worship",["G4352"]],["him.",[]]]},{"verse":3,"text":"When Herod the king had heard these things, he was troubled, and all Jerusalem with him.","words":[["When",["G1161"]],["Herod",["G2264"]],["the king",["G935"]],["had heard",["G191"]],["these things, he was troubled,",["G5015"]],["and",["G2532"]],["all",["G3956"]],["Jerusalem",["G2414"]],["with",["G3326"]],["him.",[]]]},{"verse":4,"text":"And when he had gathered all the chief priests and scribes of the people together, he demanded of them where Christ should be born.","words":[["And",["G2532"]],["when he had gathered",["G4863"]],["all",["G3956"]],["the chief priests",["G749"]],["and",["G2532"]],["scribes",["G1122"]],["of the people",["G2992"]],["together,",["G4863"]],["he demanded",["G4441"]],["of",["G3844"]],["them",["G846"]],["where",["G4226"]],["Christ",["G5547"]],["should be born.",[]]]},{"verse":5,"text":"And they said unto him, In Bethlehem of Judea: for thus it is writte