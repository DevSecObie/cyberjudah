 THE JEWS.",[]]]},{"verse":38,"text":"Then were there two thieves crucified with him, one on the right hand, and another on the left.","words":[["Then",["G5119"]],["were there two",["G1417"]],["thieves",["G3027"]],["crucified",["G4717"]],["with",["G4862"]],["him,",["G846"]],["one",["G1520"]],["on",["G1537"]],["the right hand,",["G1188"]],["and",["G2532"]],["another",["G1520"]],["on",["G1537"]],["the left.",[]]]},{"verse":39,"text":"And they that passed by reviled him, wagging their heads,","words":[["And",["G1161"]],["they that passed by",["G3899"]],["reviled",["G987"]],["him,",["G846"]],["wagging",["G2795"]],["their",["G846"]],["heads,",[]]]},{"verse":40,"text":"And saying, Thou that destroyest the temple, and buildest it in three days, save thyself. If thou be the Son of God, come down from the cross.","words":[["And",["G2532"]],["saying,",["G3004"]],["Thou that destroyest",["G2647"]],["the temple,",["G3485"]],["and",["G2532"]],["buildest",["G3618"]],["it in",["G1722"]],["three",["G5140"]],["days,",["G2250"]],["save",["G4982"]],["thyself.",["G4572"]],["If",["G1487"]],["thou be",["G1488"]],["the Son",["G5207"]],["of God,",["G2316"]],["come down",["G2597"]],["from",["G575"]],["the cross.",[]]]},{"verse":41,"text":"Likewise also the chief priests mocking him, with the scribes and elders, said,","words":[["Likewise",["G3668"]],["also",["G2532"]],["the chief priests",["G749"]],["mocking",["G1702"]],["him, with",["G3326"]],["the scribes",["G1122"]],["and",["G2532"]],["elders,",["G4245"]],["said,",[]]]},{"verse":42,"text":"He saved others; himself he cannot save. If he be the King of Israel, let him now come down from the cross, and we will believe him.","words":[["He saved",["G4982"]],["others;",["G243"]],["himself",["G1438"]],["he cannot",["G3756","G1410"]],["save.",["G4982"]],["If",["G1487"]],["he be",["G2076"]],["the King",["G935"]],["of Israel,",["G2474"]],["let him",["G2597"]],["now",["G3568"]],["come down",["G2597"]],["from",["G575"]],["the cross,",["G4716"]],["and",["G2532"]],["we will believe",["G4100"]],["him.",[]]]},{"verse":43,"text":"He trusted in God; let him deliver him now, if he will have him: for he said, I am the Son of God.","words":[["He trusted",["G3982"]],["in",["G1909"]],["God;",["G2316"]],["let him deliver",["G4506"]],["him",["G846"]],["now,",["G3568"]],["if",["G1487"]],["he will have",["G2309"]],["him:",["G846"]],["for",["G1063"]],["he said,",["G2036","G3754"]],["I am",["G1510"]],["the Son",["G5207"]],["of God.",[]]]},{"verse":44,"text":"The thieves also, which were crucified with him, cast the same in his teeth.","words":[["The thieves",["G3027"]],["also,",["G2532"]],["which",["G3588"]],["were crucified",["G4957"]],["with him,",["G846"]],["cast",["G3679"]],["the same",["G846"]],["in his",["G846"]],["teeth.",[]]]},{"verse":45,"text":"Now from the sixth hour there was darkness over all the land unto the ninth hour.","words":[["Now",["G1161"]],["from",["G575"]],["the sixth",["G1623"]],["hour",["G5610"]],["there was",["G1096"]],["darkness",["G4655"]],["over",["G1909"]],["all",["G3956"]],["the land",["G1093"]],["unto",["G2193"]],["the ninth",["G1766"]],["hour.",[]]]},{"verse":46,"text":"And about the ninth hour Jesus cried with a loud voice, saying, Eli, Eli, lama sabachthani? that is to say, My God, my God, why hast thou forsaken me?","words":[["And",["G1161"]],["about",["G4012"]],["the ninth",["G1766"]],["hour",["G5610"]],["Jesus",["G2424"]],["cried",["G310"]],["with a loud",["G3173"]],["voice,",["G5456"]],["saying,",["G3004"]],["Eli,",["G2241"]],["Eli,",["G2241"]],["lama",["G2982"]],["sabachthani?",["G4518"]],["that",["G5123"]],["is to say, My",["G3450"]],["God,",["G2316"]],["my",["G3450"]],["God,",["G2316"]],["why",["G2444"]],["hast thou forsaken",["G1459"]],["me?",[]]]},{"verse":47,"text":"Some of them that stood there, when they heard that, said, This man calleth for Elias.","words":[["Some of them",["G5100"]],["that stood",["G2476"]],["there,",["G1563"]],["when they heard",["G191"]],["that, said,",["G3004","G3754"]],["This",["G3778"]],["man calleth for",["G5455"]],["Elias.",[]]]},{"verse":48,"text":"And straightway one of them ran, and took a spunge, and filled it with vinegar, and put it on a reed, and gave him to drink.","words":[["And",["G2532"]],["straightway",["G2112"]],["one",["G1520"]],["of",["G1537"]],["them",["G846"]],["ran,",["G5143"]],["and",["G2532"]],["took",["G2983"]],["a spunge,",["G4699"]],["and",["G5037"]],["filled",["G4130"]],["it with vinegar,",["G3690"]],["and",["G2532"]],["put it on",["G4060"]],["a reed,",["G2563"]],["and gave",["G4222"]],["him",["G846"]],["to drink.",[]]]},{"verse":49,"text":"The rest said, Let be, let us see whether Elias will come to save him.","words":[["The",["G1161"]],["rest",["G3062"]],["said,",["G3004"]],["Let be,",["G863"]],["let us see",["G1492"]],["whether",["G1487"]],["Elias",["G2243"]],["will come",["G2064"]],["to save",["G4982"]],["him.",[]]]},{"verse":50,"text":"Jesus, when he had cried again with a loud voice, yielded up the ghost.","words":[["Jesus,",["G2424"]],["when he had cried",["G2896"]],["again",["G3825"]],["with a loud",["G3173"]],["voice,",["G5456"]],["yielded up",["G863"]],["the ghost.",[]]]},{"verse":51,"text":"And, behold, the veil of the temple was rent in twain from the top to the bottom; and the earth did quake, and the rocks rent;","words":[["And,",["G2532"]],["behold,",["G2400"]],["the veil",["G2665"]],["of the temple",["G3485"]],["was rent",["G4977"]],["in",["G1519"]],["twain",["G1417"]],["from",["G575"]],["the top",["G509"]],["to",["G2193"]],["the bottom;",["G2736"]],["and",["G2532"]],["the earth",["G1093"]],["did quake,",["G4579"]],["and",["G2532"]],["the rocks",["G4073"]],["rent;",[]]]},{"verse":52,"text":"And the graves were opened; and many bodies of the saints which slept arose,","words":[["And",["G2532"]],["the graves",["G3419"]],["were opened;",["G455"]],["and",["G2532"]],["many",["G4183"]],["bodies",["G4983"]],["of the saints",["G40"]],["which",["G3588"]],["slept",["G2837"]],["arose,",[]]]},{"verse":53,"text":"And came out of the graves after his resurrection, and went into the holy city, and appeared unto many.","words":[["And",["G2532"]],["came",["G1831"]],["out of",["G1537"]],["the graves",["G3419"]],["after",["G3326"]],["his",["G846"]],["resurrection,",["G1454"]],["and went",["G1525"]],["into",["G1519"]],["the holy",["G40"]],["city,",["G4172"]],["and",["G2532"]],["appeared",["G1718"]],["unto many.",[]]]},{"verse":54,"text":"Now when the centurion, and they that were with him, watching Jesus, saw the earthquake, and those things that were done, they feared greatly, saying, Truly this was the Son of God.","words":[["Now",["G1161"]],["when the centurion,",["G1543"]],["and",["G2532"]],["they that were with",["G3326"]],["him,",["G846"]],["watching",["G5083"]],["Jesus,",["G2424"]],["saw",["G1492"]],["the earthquake,",["G4578"]],["and",["G2532"]],["those things that were done,",["G1096"]],["they feared",["G5399"]],["greatly,",["G4970"]],["saying,",["G3004"]],["Truly",["G230"]],["this",["G3778"]],["was",["G2258"]],["the Son",["G5207"]],["of God.",[]]]},{"verse":55,"text":"And many women were there beholding afar off, which followed Jesus from Galilee, ministering unto him:","words":[["And",["G1161"]],["many",["G4183"]],["women",["G1135"]],["were",["G2258"]],["there",["G1563"]],["beholding",["G2334"]],["afar off,",["G575","G3113"]],["which",["G3748"]],["followed",["G190"]],["Jesus",["G2424"]],["from",["G575"]],["Galilee,",["G1056"]],["ministering",["G1247"]],["unto him:",[]]]},{"verse":56,"text":"Among which was Mary Magdalene, and Mary the mother of James and Joses, and the mother of Zebedee’s children.","words":[["Among",["G1722"]],["which",["G3739"]],["was",["G2258"]],["Mary",["G3137"]],["Magdalene,",["G3094"]],["and",["G2532"]],["Mary",["G3137"]],["the mother",["G3384"]],["of James",["G2385"]],["and",["G2532"]],["Joses,",["G2500"]],["and",["G2532"]],["the mother",["G3384"]],["of Zebedee’s children.",[]]]},{"verse":57,"text":"When the even was come, there came a rich man of Arimathea, named Joseph, who also himself was Jesus’ disciple:","words":[["When",["G1161"]],["the even",["G3798"]],["was come,",["G1096"]],["there came",["G2064"]],["a rich",["G4145"]],["man",["G444"]],["of",["G575"]],["Arimathea,",["G707"]],["named",["G5122"]],["Joseph,",["G2501"]],["who",["G3739"]],["also",["G2532"]],["himself",["G846"]],["was",["G3100"]],["Jesus’",["G2424"]],["disciple:",[]]]},{"verse":58,"text":"He went to Pilate, and begged the body of Jesus. Then Pilate commanded the body to be delivered.","words":[["He",["G3778"]],["went",["G4334"]],["to Pilate,",["G4091"]],["and begged",["G154"]],["the body",["G4983"]],["of Jesus.",["G2424"]],["Then",["G5119"]],["Pilate",["G4091"]],["commanded",["G2753"]],["the body",["G4983"]],["to be delivered.",[]]]},{"verse":59,"text":"And when Joseph had taken the body, he wrapped it in a clean linen cloth,","words":[["And",["G2532"]],["when Joseph",["G2501"]],["had taken",["G2983"]],["the body,",["G4983"]],["he wrapped",["G1794"]],["it",["G846"]],["in a clean",["G2513"]],["linen cloth,",[]]]},{"verse":60,"text":"And laid it in his own new tomb, which he had hewn out in the rock: and he rolled a great stone to the door of the sepulchre, and departed.","words":[["And",["G2532"]],["laid",["G5087"]],["it",["G846"]],["in",["G1722"]],["his own",["G846"]],["new",["G2537"]],["tomb,",["G3419"]],["which",["G3739"]],["he had hewn out",["G2998"]],["in",["G1722"]],["the rock:",["G4073"]],["and",["G2532"]],["he rolled",["G4351"]],["a great",["G3173"]],["stone",["G3037"]],["to the door",["G2374"]],["of the sepulchre,",["G3419"]],["and departed.",[]]]},{"verse":61,"text":"And there was Mary Magdalene, and the other Mary, sitting over against the sepulchre.","words":[["And",["G1161"]],["there",["G1563"]],["was",["G2258"]],["Mary",["G3137"]],["Magdalene,",["G3094"]],["and",["G2532"]],["the other",["G243"]],["Mary,",["G3137"]],["sitting",["G2521"]],["over against",["G561"]],["the sepulchre.",[]]]},{"verse":62,"text":"Now the next day, that followed the day of the preparation, the chief priests and Pharisees came together unto Pilate,","words":[["Now",["G1161"]],["the next day,",["G1887"]],["that",["G3748"]],["followed",["G2076","G3326"]],["the day of the preparation,",["G3904"]],["the chief priests",["G749"]],["and",["G2532"]],["Pharisees",["G5330"]],["came together",["G4863"]],["unto",["G4314"]],["Pilate,",[]]]},{"verse":63,"text":"Saying, Sir, we remember that that deceiver said, while he was yet alive, After three days I will rise again.","words":[["Saying,",["G3004"]],["Sir,",["G2962"]],["we remember",["G3415"]],["that",["G3754"]],["that",["G1565"]],["deceiver",["G4108"]],["said,",["G2036"]],["while he was yet",["G2089"]],["alive,",["G2198"]],["After",["G3326"]],["three",["G5140"]],["days",["G2250"]],["I will rise again.",[]]]},{"verse":64,"text":"Command therefore that the sepulchre be made sure until the third day, lest his disciples come by night, and steal him away, and say unto the people, He is risen from the dead: so the last error shall be worse than the first.","words":[["Command",["G2753"]],["therefore",["G3767"]],["that the sepulchre",["G5028"]],["be made sure",["G805"]],["until",["G2193"]],["the third",["G5154"]],["day,",["G2250"]],["lest",["G3379"]],["his",["G846"]],["disciples",["G3101"]],["come",["G2064"]],["by night,",["G3571"]],["and steal",["G2813"]],["him",["G846"]],["away,",["G2813"]],["and",["G2532"]],["say",["G2036"]],["unto the people,",["G2992"]],["He is risen",["G1453"]],["from",["G575"]],["the dead:",["G3498"]],["so",["G2532"]],["the last",["G2078"]],["error",["G4106"]],["shall be",["G2071"]],["worse than",["G5501"]],["the first.",[]]]},{"verse":65,"text":"Pilate said unto them, Ye have a watch: go your way, make it as sure as ye can.","words":[["Pilate",["G4091"]],["said",["G5346"]],["unto them,",["G846"]],["Ye have",["G2192"]],["a watch:",["G2892"]],["go your way,",["G5217"]],["make it as sure",["G805"]],["as",["G5613"]],["ye can.",[]]]},{