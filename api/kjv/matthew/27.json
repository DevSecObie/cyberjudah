to release unto the people a prisoner, whom they would.","words":[["Now",["G1161"]],["at",["G2596"]],["that feast",["G1859"]],["the governor",["G2232"]],["was wont",["G1486"]],["to release",["G630"]],["unto the people",["G3793"]],["a",["G1520"]],["prisoner,",["G1198"]],["whom",["G3739"]],["they would.",[]]]},{"verse":16,"text":"And they had then a notable prisoner, called Barabbas.","words":[["And",["G1161"]],["they had",["G2192"]],["then",["G5119"]],["a notable",["G1978"]],["prisoner,",["G1198"]],["called",["G3004"]],["Barabbas.",[]]]},{"verse":17,"text":"Therefore when they were gathered together, Pilate said unto them, Whom will ye that I release unto you? Barabbas, or Jesus which is called Christ?","words":[["Therefore",["G3767"]],["when they",["G846"]],["were gathered together,",["G4863"]],["Pilate",["G4091"]],["said",["G2036"]],["unto them,",["G846"]],["Whom",["G5101"]],["will ye",["G2309"]],["that I release",["G630"]],["unto you?",["G5213"]],["Barabbas,",["G912"]],["or",["G2228"]],["Jesus",["G2424"]],["which",["G3588"]],["is called",["G3004"]],["Christ?",[]]]},{"verse":18,"text":"For he knew that for envy they had delivered him.","words":[["For",["G1063"]],["he knew",["G1492"]],["that",["G3754"]],["for",["G1223"]],["envy",["G5355"]],["they had delivered",["G3860"]],["him.",[]]]},{"verse":19,"text":"When he was set down on the judgment seat, his wife sent unto him, saying, Have thou nothing to do with that just man: for I have suffered many things this day in a dream because of him.","words":[["When",["G1161"]],["he",["G846"]],["was set down",["G2521"]],["on",["G1909"]],["the judgment seat,",["G968"]],["his",["G846"]],["wife",["G1135"]],["sent",["G649"]],["unto",["G4314"]],["him,",["G846"]],["saying,",["G3004","G2532"]],["Have thou",["G4671"]],["nothing",["G3367"]],["to do with that",["G1565"]],["just man:",["G1342"]],["for",["G1063"]],["I have suffered",["G3958"]],["many things",["G4183"]],["this day",["G4594"]],["in",["G2596"]],["a dream",["G3677"]],["becaus