{"book":"Revelation","chapter":7,"translation":"KJV","url":"/bible/revelation/7","verses":[{"verse":1,"text":"And after these things I saw four angels standing on the four corners of the earth, holding the four winds of the earth, that the wind should not blow on the earth, nor on the sea, nor on any tree.","words":[["And",["G2532"]],["after",["G3326"]],["these things",["G5023"]],["I saw",["G1492"]],["four",["G5064"]],["angels",["G32"]],["standing",["G2476"]],["on",["G1909"]],["the four",["G5064"]],["corners",["G1137"]],["of the earth,",["G1093"]],["holding",["G2902"]],["the four",["G5064"]],["winds",["G417"]],["of the earth,",["G1093"]],["that",["G3363"]],["the wind",["G417"]],["should",["G4154"]],["not",["G3363"]],["blow",["G4154"]],["on",["G1909"]],["the earth,",["G1093"]],["nor",["G3383"]],["on",["G1909"]],["the sea,",["G2281"]],["nor",["G3383"]],["on",["G1909"]],["any",["G3956"]],["tree.",[]]]},{"verse":2,"text":"And I saw another angel ascending from the east, having the seal of the living God: and he cried with a loud voice to the four angels, to whom it was given to hurt the earth and the sea,","words":[["And",["G2532"]],["I saw",["G1492"]],["another",["G243"]],["angel",["G32"]],["ascending",["G305","G305"]],["from",["G575"]],["the east,",["G395","G2246"]],["having",["G2192"]],["the seal",["G4973"]],["of the living",["G2198"]],["God:",["G2316"]],["and",["G2532"]],["he cried",["G2896"]],["with a loud",["G3173"]],["voice",["G5456"]],["to the four",["G5064"]],["angels,",["G32"]],["to whom",["G3739"]],["it",["G846"]],["was given",["G1325"]],["to hurt",["G91"]],["the earth",["G1093"]],["and",["G2532"]],["the sea,",[]]]},{"verse":3,"text":"Saying, Hurt not the earth, neither the sea, nor the trees, till we have sealed the servants of our God in their foreheads.","words":[["Saying,",["G3004"]],["Hurt",["G91"]],["not",["G3361"]],["the earth,",["G1093"]],["neither",["G3383"]],["the sea,",["G2281"]],["nor",["G3383"]],["the trees,",["G1186"]],["till",["G891","G3739"]],