{"book":"Revelation","chapter":11,"translation":"KJV","url":"/bible/revelation/11","verses":[{"verse":1,"text":"And there was given me a reed like unto a rod: and the angel stood, saying, Rise, and measure the temple of God, and the altar, and them that worship therein.","words":[["And",["G2532"]],["there was given",["G1325"]],["me",["G3427"]],["a reed",["G2563"]],["like",["G3664"]],["unto a rod:",["G4464"]],["and",["G2532"]],["the angel",["G32"]],["stood,",["G2476"]],["saying,",["G3004"]],["Rise,",["G1453"]],["and",["G2532"]],["measure",["G3354"]],["the temple",["G3485"]],["of God,",["G2316"]],["and",["G2532"]],["the altar,",["G2379"]],["and",["G2532"]],["them that worship",["G4352"]],["therein.",["G1722"]]]},{"verse":2,"text":"But the court which is without the temple leave out, and measure it not; for it is given unto the Gentiles: and the holy city shall they tread under foot forty and two months.","words":[["But",["G2532"]],["the court",["G833"]],["which",["G3588"]],["is without",["G1855","G2081"]],["the temple",["G3485"]],["leave",["G1544"]],["out,",["G1854"]],["and",["G2532"]],["measure",["G3354"]],["it",["G846"]],["not;",["G3361"]],["for",["G3754"]],["it is given",["G1325"]],["unto the Gentiles:",["G1484"]],["and",["G2532"]],["the holy",["G40"]],["city",["G4172"]],["shall they tread under foot",["G3961"]],["forty",["G5062"]],["and two",["G1417"]],["months.",[]]]},{"verse":3,"text":"And I will give power unto my two witnesses, and they shall prophesy a thousand two hundred and threescore days, clothed in sackcloth.","words":[["And",["G2532"]],["I will give",["G1325"]],["power unto my",["G3450"]],["two",["G1417"]],["witnesses,",["G3144"]],["and",["G2532"]],["they shall prophesy",["G4395"]],["a thousand",["G5507"]],["two hundred",["G1250"]],["and threescore",["G1835"]],["days,",["G2250"]],["clothed in",["G4016"]],["sackcloth.",[]]]},{"verse":4,"text":"These are the two olive trees, and the two candlesticks standing before the God of the earth.","words":[["These