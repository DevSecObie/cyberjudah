{"book":"Romans","chapter":6,"translation":"KJV","url":"/bible/romans/6","verses":[{"verse":1,"text":"What shall we say then? Shall we continue in sin, that grace may abound?","words":[["What",["G5101"]],["shall we say",["G2046"]],["then?",["G3767"]],["Shall we continue",["G1961"]],["in sin,",["G266"]],["that",["G2443"]],["grace",["G5485"]],["may abound?",[]]]},{"verse":2,"text":"God forbid. How shall we, that are dead to sin, live any longer therein?","words":[["God forbid.",["G3361","G1096"]],["How",["G4459"]],["shall we, that",["G3748"]],["are dead",["G599"]],["to sin,",["G266"]],["live",["G2198"]],["any longer",["G2089"]],["therein?",["G1722"]]]},{"verse":3,"text":"Know ye not, that so many of us as were baptized into Jesus Christ were baptized into his death?","words":[["Know ye not,",["G50"]],["that so",["G3754"]],["many of us",["G3745"]],["as were baptized",["G907"]],["into",["G1519"]],["Jesus",["G2424"]],["Christ",["G5547"]],["were baptized",["G907"]],["into",["G1519"]],["his",["G846"]],["death?",[]]]},{"verse":4,"text":"Therefore we are buried with him by baptism into death: that like as Christ was raised up from the dead by the glory of the Father, even so we also should walk in newness of life.","words":[["Therefore",["G3767"]],["we are buried with",["G4916"]],["him",["G846"]],["by",["G1223"]],["baptism",["G908"]],["into",["G1519"]],["death:",["G2288"]],["that",["G2443"]],["like as",["G5618"]],["Christ",["G5547"]],["was raised up",["G1453"]],["from",["G1537"]],["the dead",["G3498"]],["by",["G1223"]],["the glory",["G1391"]],["of the Father,",["G3962"]],["even so",["G3779"]],["we",["G2249"]],["also",["G2532"]],["should walk",["G4043"]],["in",["G1722"]],["newness",["G2538"]],["of life.",[]]]},{"verse":5,"text":"For if we have been planted together in the likeness of his death, we shall be also in the likeness of his resurrection:","words":[["For",["G1063"]],["if",["G1487"]],["we have been",["G1096"]],["planted together",["G4854"]],["in the likeness",["G3667"]],["of his",["G846"]],["death,",["G2288"]],["we shall be",["G2071"]],["also",["G235","G2532"]],["in the likeness of his resurrection:",[]]]},{"verse":6,"text":"Knowing this, that our old man is crucified with him, that the body of sin might be destroyed, that henceforth we should not serve sin.","words":[["Knowing",["G1097"]],["this,",["G5124"]],["that",["G3754"]],["our",["G2257"]],["old",["G3820"]],["man",["G444"]],["is crucified with",["G4957"]],["him, that",["G2443"]],["the body",["G4983"]],["of sin",["G266"]],["might be destroyed,",["G2673"]],["that henceforth",["G3371"]],["we",["G2248"]],["should",["G1398"]],["not",["G3371"]],["serve",["G1398"]],["sin.",[]]]},{"verse":7,"text":"For he that is dead is freed from sin.","words":[["For",["G1063"]],["he that is dead",["G599"]],["is freed",["G1344"]],["from",["G575"]],["sin.",[]]]},{"verse":8,"text":"Now if we be dead with Christ, we believe that we shall also live with him:","words":[["Now",["G1161"]],["if",["G1487"]],["we be dead",["G599"]],["with",["G4862"]],["Christ,",["G5547"]],["we believe",["G4100"]],["that",["G3754"]],["we shall",["G4800"]],["also",["G2532"]],["live",["G4800"]],["with him:",[]]]},{"verse":9,"text":"Knowing that Christ being raised from the dead dieth no more; death hath no more dominion over him.","words":[["Knowing",["G1492"]],["that",["G3754"]],["Christ",["G5547"]],["being raised",["G1453"]],["from",["G1537"]],["the dead",["G3498"]],["dieth",["G599"]],["no more;",["G3765"]],["death",["G2288"]],["hath",["G2961"]],["no more",["G3765"]],["dominion over",["G2961"]],["him.",[]]]},{"verse":10,"text":"For in that he died, he died unto sin once: but in that he liveth, he liveth unto God.","words":[["For",["G3739","G1063"]],["in that he died,",["G599"]],["he died",["G599"]],["unto sin",["G266"]],["once:",["G2178"]],["but",["G1161"]],["in that",["G3739"]],["he liveth,",["G2198"]],["he liveth",["G2198"]],["unto God.",[]]]},{"verse":11,"text":"Likewise reckon ye also yourselves to be dead indeed unto sin, but alive unto God through Jesus Christ our Lord.","words":[["Likewise",["G3779"]],["reckon",["G3049"]],["ye",["G5210"]],["also",["G2532"]],["yourselves",["G1438"]],["to be",["G1511"]],["dead",["G3498"]],["indeed",["G3303"]],["unto sin,",["G266"]],["but",["G1161"]],["alive",["G2198"]],["unto God",["G2316"]],["through",["G1722"]],["Jesus",["G2424"]],["Christ",["G5547"]],["our",["G2257"]],["Lord.",[]]]},{"verse":12,"text":"Let not sin therefore reign in your mortal body, that ye should obey it in the lusts thereof.","words":[["Let",["G936"]],["not",["G3361"]],["sin",["G266"]],["therefore",["G3767"]],["reign",["G936"]],["in",["G1722"]],["your",["G5216"]],["mortal",["G2349"]],["body,",["G4983"]],["that",["G1519"]],["ye should obey",["G5219"]],["it",["G846"]],["in",["G1722"]],["the lusts",["G1939"]],["thereof.",[]]]},{"verse":13,"text":"Neither yield ye your members as instruments of unrighteousness unto sin: but yield yourselves unto God, as those that are alive from the dead, and your members as instruments of righteousness unto God.","words":[["Neither",["G3366"]],["yield ye",["G3936"]],["your",["G5216"]],["members",["G3196"]],["as instruments",["G3696"]],["of unrighteousness",["G93"]],["unto sin:",["G266"]],["but",["G235"]],["yield",["G3936"]],["yourselves",["G1438"]],["unto God,",["G2316"]],["as",["G5613"]],["those that are alive",["G2198"]],["from",["G1537"]],["the dead,",["G3498"]],["and",["G2532"]],["your",["G5216"]],["members",["G3196"]],["as instruments",["G3696"]],["of righteousness",["G1343"]],["unto God.",[]]]},{"verse":14,"text":"For sin shall not have dominion over you: for ye are not under the law, but under grace.","words":[["For",["G1063"]],["sin",["G266"]],["shall",["G2961"]],["not",["G3756"]],["have dominion over",["G2961"]],["you:",["G5216"]],["for",["G1063"]],["ye are",["G2075"]],["not",["G3756"]],["under",["G5259"]],["the law,",["G3551"]],["but",["G235"]],["under",["G5259"]],["grace.",[]]]},{"verse":15,"text":"What then? shall we sin, because we are not under the law, but under grace? God forbid.","words":[["What",["G5101"]],["then?",["G3767"]],["shall we sin,",["G264"]],["because",["G3754"]],["we are",["G2070"]],["not",["G3756"]],["under",["G5259"]],["the law,",["G3551"]],["but",["G235"]],["under",["G5259"]],["grace?",["G5485"]],["God forbid.",["G3361"]]]},{"verse":16,"text":"Know ye not, that to whom ye yield yourselves servants to obey, his servants ye are to whom ye obey; whether of sin unto death, or of obedience unto righteousness?","words":[["Know ye",["G1492"]],["not,",["G3756"]],["that",["G3754"]],["to whom",["G3739"]],["ye yield",["G3936"]],["yourselves",["G1438"]],["servants",["G1401"]],["to",["G1519"]],["obey,",["G5218"]],["his servants",["G1401"]],["ye are",["G2075"]],["to whom",["G3739"]],["ye obey;",["G5219"]],["whether",["G2273"]],["of sin",["G266"]],["unto",["G1519"]],["death,",["G2288"]],["or",["G2228"]],["of obedience",["G5218"]],["unto",["G1519"]],["righteousness?",[]]]},{"verse":17,"text":"But God be thanked, that ye were the servants of sin, but ye have obeyed from the heart that form of doctrine which was delivered you.","words":[["But",["G1161"]],["God",["G2316"]],["be thanked,",["G5485"]],["that",["G3754"]],["ye were",["G2258"]],["the servants",["G1401"]],["of sin,",["G266"]],["but",["G1161"]],["ye have obeyed",["G5219"]],["from",["G1537"]],["the heart",["G2588"]],["that form",["G5179"]],["of doctrine",["G1322"]],["which",["G1519","G3739"]],["was delivered you.",[]]]},{"verse":18,"text":"Being then made free from sin, ye became the servants of righteousness.","words":[["Being",["G1659"]],["then",["G1161"]],["made free",["G1659"]],["from",["G575"]],["sin,",["G266"]],["ye became the servants",["G1402"]],["of righteousness.",[]]]},{"verse":19,"text":"I speak after the manner of men because of the infirmity of your flesh: for as ye have yielded your members servants to uncleanness and to iniquity unto iniquity; even so now yield your members servants to righteousness unto holiness.","words":[["I speak",["G3004"]],["after the manner of men",["G442"]],["because",["G1223"]],["of the infirmity",["G769"]],["of your",["G5216"]],["flesh:",["G4561"]],["for",["G1063"]],["as",["G5618"]],["ye have yielded",["G3936"]],["your",["G5216"]],["members",["G3196"]],["servants",["G1401"]],["to uncleanness",["G167"]],["and",["G2532"]],["to iniquity",["G458"]],["unto",["G1519"]],["iniquity;",["G458"]],["even so",["G3779"]],["now",["G3568"]],["yield",["G3936"]],["your",["G5216"]],["members",["G3196"]],["servants",["G1401"]],["to righteousness",["G1343"]],["unto",["G1519"]],["holiness.",[]]]},{"verse":20,"text":"For when ye were the servants of sin, ye were free from righteousness.","words":[["For",["G1063"]],["when",["G3753"]],["ye were",["G2258"]],["the servants",["G1401"]],["of sin,",["G266"]],["ye were",["G2258"]],["free",["G1658"]],["from righteousness.",[]]]},{"verse":21,"text":"What fruit had ye then in those things whereof ye are now ashamed? for the end of those things is death.","words":[["What",["G5101","G3767"]],["fruit",["G2590"]],["had ye",["G2192"]],["then",["G5119"]],["in",["G1909"]],["those things whereof",["G3739"]],["ye are",["G1870"]],["now",["G3568"]],["ashamed?",["G1870"]],["for",["G1063"]],["the end",["G5056"]],["of those things",["G1565"]],["is death.",[]]]},{"verse":22,"text":"But now being made free from sin, and become servants to God, ye have your fruit unto holiness, and the end everlasting life.","words":[["But",["G1161"]],["now",["G3570"]],["being made free",["G1659"]],["from",["G575"]],["sin,",["G266"]],["and",["G1161"]],["become servants",["G1402"]],["to God,",["G2316"]],["ye have",["G2192"]],["your",["G5216"]],["fruit",["G2590"]],["unto",["G1519"]],["holiness,",["G38"]],["and",["G1161"]],["the end",["G5056"]],["everlasting",["G166"]],["life.",[]]]},{"verse":23,"text":"For the wages of sin is death; but the gift of God is eternal life through Jesus Christ our Lord.","words":[["For",["G1063"]],["the wages",["G3800"]],["of sin",["G266"]],["is death;",["G2288"]],["but",["G1161"]],["the gift",["G5486"]],["of God",["G2316"]],["is eternal",["G166"]],["life",["G2222"]],["through",["G1722"]],["Jesus",["G2424"]],["Christ",["G5547"]],["our",["G2257"]],["Lord.",[]]]}]}