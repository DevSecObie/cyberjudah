{"book":"Romans","chapter":9,"translation":"KJV","url":"/bible/romans/9","verses":[{"verse":1,"text":"I say the truth in Christ, I lie not, my conscience also bearing me witness in the Holy Ghost,","words":[["I say",["G3004"]],["the truth",["G225"]],["in",["G1722"]],["Christ,",["G5547"]],["I lie",["G5574"]],["not,",["G3756"]],["my",["G3450"]],["conscience",["G4893"]],["also bearing",["G4828"]],["me",["G3427"]],["witness",["G4828"]],["in",["G1722"]],["the Holy",["G40"]],["Ghost,",[]]]},{"verse":2,"text":"That I have great heaviness and continual sorrow in my heart.","words":[["That",["G3754"]],["I",["G3427"]],["have",["G2076"]],["great",["G3173"]],["heaviness",["G3077"]],["and",["G2532"]],["continual",["G88"]],["sorrow in",["G3601"]],["my",["G3450"]],["heart.",[]]]},{"verse":3,"text":"For I could wish that myself were accursed from Christ for my brethren, my kinsmen according to the flesh:","words":[["For",["G1063"]],["I",["G1473"]],["could wish",["G2172"]],["that myself",["G846"]],["were",["G1511"]],["accursed",["G331"]],["from",["G575"]],["Christ",["G5547"]],["for",["G5228"]],["my",["G3450"]],["brethren,",["G80"]],["my",["G3450"]],["kinsmen",["G4773"]],["according",["G2596"]],["to the flesh:",[]]]},{"verse":4,"text":"Who are Israelites; to whom pertaineth the adoption, and the glory, and the covenants, and the giving of the law, and the service of God, and the promises;","words":[["Who",["G3748"]],["are",["G1526"]],["Israelites;",["G2475"]],["to whom",["G3739"]],["pertaineth the adoption,",["G5206"]],["and",["G2532"]],["the glory,",["G1391"]],["and",["G2532"]],["the covenants,",["G1242"]],["and",["G2532"]],["the giving of the law,",["G3548"]],["and",["G2532"]],["the service",["G2999"]],["of God, and",["G2532"]],["the promises;",[]]]},{"verse":5,"text":"Whose are the fathers, and of whom as concerning the flesh Christ came, who is over all, God blessed for ever. Amen.","words":[["Whose",["G3739"]],["are the fathers,",["G3962"]],["and",["G2532"]],["of",["G1537"]],["whom",["G3739"]],["as concerning",["G2596"]],["the flesh",["G4561"]],["Christ",["G5547"]],["came, who",["G5607"]],["is over",["G1909"]],["all,",["G3956"]],["God",["G2316"]],["blessed",["G2128"]],["for",["G1519"]],["ever.",["G165"]],["Amen.",[]]]},{"verse":6,"text":"Not as though the word of God hath taken none effect. For they are not all Israel, which are of Israel:","words":[["Not",["G3756"]],["as",["G3634"]],["though",["G1161","G3754"]],["the word",["G3056"]],["of God",["G2316"]],["hath taken none effect.",["G1601"]],["For",["G1063"]],["they are not",["G3756"]],["all",["G3956","G1537"]],["Israel,",["G2474"]],["which",["G3588","G3778"]],["are of Israel:",[]]]},{"verse":7,"text":"Neither, because they are the seed of Abraham, are they all children: but, In Isaac shall thy seed be called.","words":[["Neither,",["G3761"]],["because",["G3754"]],["they are",["G1526"]],["the seed",["G4690"]],["of Abraham,",["G11"]],["are they all",["G3956"]],["children:",["G5043"]],["but,",["G235"]],["In",["G1722"]],["Isaac",["G2464"]],["shall",["G2564"]],["thy",["G4671"]],["seed",["G4690"]],["be called.",[]]]},{"verse":8,"text":"That is, They which are the children of the flesh, these are not the children of God: but the children of the promise are counted for the seed.","words":[["That is,",["G5123"]],["They which are the children",["G5043"]],["of the flesh,",["G4561"]],["these",["G5023"]],["are not",["G3756"]],["the children",["G5043"]],["of God:",["G2316"]],["but",["G235"]],["the children",["G5043"]],["of the promise",["G1860"]],["are counted",["G3049"]],["for",["G1519"]],["the seed.",[]]]},{"verse":9,"text":"For this is the word of promise, At this time will I come, and Sara shall have a son.","words":[["For",["G1063"]],["this",["G3778"]],["is the word",["G3056"]],["of promise,",["G1860"]],["At",["G2596"]],["this",["G5126"]],["time",["G2540"]],["will I come,",["G2064"]],["and",["G2532"]],["Sara",["G4564"]],["shall have",["G2071"]],["a son.",[]]]},{"verse":10,"text":"And not only this; but when Rebecca also had conceived by one, even by our father Isaac;","words":[["And",["G1161"]],["not",["G3756"]],["only",["G3440"]],["this; but",["G235"]],["when Rebecca",["G4479"]],["also",["G2532"]],["had conceived",["G2845"]],["by",["G1537"]],["one,",["G1520","G2192"]],["even by our",["G2257"]],["father",["G3962"]],["Isaac;",[]]]},{"verse":11,"text":"(For the children being not yet born, neither having done any good or evil, that the purpose of God according to election might stand, not of works, but of him that calleth;)","words":[["(For",["G1063"]],["the children being",["G1080"]],["not yet",["G3380"]],["born,",["G1080"]],["neither",["G3366"]],["having done",["G4238"]],["any",["G5100"]],["good",["G18"]],["or",["G2228"]],["evil,",["G2556"]],["that",["G2443"]],["the purpose",["G4286"]],["of God",["G2316"]],["according",["G2596"]],["to election",["G1589"]],["might stand,",["G3306"]],["not",["G3756"]],["of",["G1537"]],["works,",["G2041"]],["but",["G235"]],["of",["G1537"]],["him that calleth;)",[]]]},{"verse":12,"text":"It was said unto her, The elder shall serve the younger.","words":[["It was said",["G4483"]],["unto her,",["G846"]],["The elder",["G3187"]],["shall serve",["G1398"]],["the younger.",[]]]},{"verse":13,"text":"As it is written, Jacob have I loved, but Esau have I hated.","words":[["As",["G2531"]],["it is written,",["G1125"]],["Jacob",["G2384"]],["have I loved,",["G25"]],["but",["G1161"]],["Esau",["G2269"]],["have I hated.",[]]]},{"verse":14,"text":"What shall we say then? Is there unrighteousness with God? God forbid.","words":[["What",["G5101"]],["shall we say",["G2046"]],["then?",["G3767","G3361"]],["Is there unrighteousness",["G93"]],["with",["G3844"]],["God?",["G2316"]],["God forbid.",["G3361"]]]},{"verse":15,"text":"For he saith to Moses, I will have mercy on whom I will have mercy, and I will have compassion on whom I will have compassion.","words":[["For",["G1063"]],["he saith",["G3004"]],["to Moses,",["G3475"]],["I will have mercy on",["G1653"]],["whom",["G3739","G302"]],["I will have mercy,",["G1653"]],["and",["G2532"]],["I will have compassion",["G3627"]],["on whom",["G3739","G302"]],["I will have compassion.",[]]]},{"verse":16,"text":"So then it is not of him that willeth, nor of him that runneth, but of God that sheweth mercy.","words":[["So",["G686"]],["then",["G3767"]],["it is not",["G3756"]],["of him that willeth,",["G2309"]],["nor",["G3761"]],["of him that runneth,",["G5143"]],["but",["G235"]],["of God",["G2316"]],["that sheweth mercy.",[]]]},{"verse":17,"text":"For the scripture saith unto Pharaoh, Even for this same purpose have I raised thee up, that I might shew my power in thee, and that my name might be declared throughout all the earth.","words":[["For",["G1063"]],["the scripture",["G1124"]],["saith",["G3004"]],["unto Pharaoh,",["G5328"]],["Even for",["G3754","G1519"]],["this",["G5124"]],["same purpose",["G846"]],["have I raised",["G1825"]],["thee",["G4571"]],["up,",["G1825"]],["that",["G3704"]],["I might shew",["G1731"]],["my",["G3450"]],["power",["G1411"]],["in",["G1722"]],["thee,",["G4671"]],["and",["G2532"]],["that",["G3704"]],["my",["G3450"]],["name",["G3686"]],["might be declared",["G1229"]],["throughout",["G1722"]],["all",["G3956"]],["the earth.",[]]]},{"verse":18,"text":"Therefore hath he mercy on whom he will have mercy, and whom he will he hardeneth.","words":[["Therefore",["G686","G3767"]],["hath he mercy",["G1653"]],["on whom",["G3739"]],["he will",["G2309"]],["have mercy, and",["G1161"]],["whom",["G3739"]],["he will",["G2309"]],["he hardeneth.",[]]]},{"verse":19,"text":"Thou wilt say then unto me, Why doth he yet find fault? For who hath resisted his will?","words":[["Thou wilt say",["G2046"]],["then",["G3767"]],["unto me,",["G3427"]],["Why",["G5101"]],["doth he yet",["G2089"]],["find fault?",["G3201"]],["For",["G1063"]],["who",["G5101"]],["hath resisted",["G436"]],["his",["G846"]],["will?",[]]]},{"verse":20,"text":"Nay but, O man, who art thou that repliest against God? Shall the thing formed say to him that formed it, Why hast thou made me thus?","words":[["Nay but,",["G3304"]],["O",["G5599"]],["man,",["G444"]],["who",["G5101"]],["art",["G1488"]],["thou",["G4771"]],["that repliest against",["G470"]],["God?",["G2316","G3361"]],["Shall",["G2046"]],["the thing formed",["G4110"]],["say",["G2046"]],["to him that formed",["G4111"]],["it, Why",["G5101"]],["hast thou made",["G4160"]],["me",["G3165"]],["thus?",[]]]},{"verse":21,"text":"Hath not the potter power over the clay, of the same lump to make one vessel unto honour, and another unto dishonour?","words":[["Hath",["G2192"]],["not",["G3756"]],["the potter",["G2763"]],["power",["G1849"]],["over the clay,",["G4081"]],["of",["G1537"]],["the same",["G846"]],["lump",["G5445"]],["to",["G3739","G3303"]],["make",["G4160"]],["one vessel",["G4632"]],["unto",["G1519"]],["honour,",["G5092"]],["and",["G1161"]],["another",["G3739"]],["unto",["G1519"]],["dishonour?",[]]]},{"verse":22,"text":"What if God, willing to shew his wrath, and to make his power known, endured with much longsuffering the vessels of wrath fitted to destruction:","words":[["What if",["G1487","G1161"]],["God,",["G2316"]],["willing",["G2309"]],["to shew",["G1731"]],["his wrath,",["G3709"]],["and",["G2532"]],["to make",["G1107"]],["his",["G846"]],["power",["G1415"]],["known,",["G1107"]],["endured",["G5342"]],["with",["G1722"]],["much",["G4183"]],["longsuffering",["G3115"]],["the vessels",["G4632"]],["of wrath",["G3709"]],["fitted",["G2675"]],["to",["G1519"]],["destruction:",[]]]},{"verse":23,"text":"And that he might make known the riches of his glory on the vessels of mercy, which he had afore prepared unto glory,","words":[["And",["G2532"]],["that",["G2443"]],["he might make known",["G1107"]],["the riches",["G4149"]],["of his",["G846"]],["glory",["G1391"]],["on",["G1909"]],["the vessels",["G4632"]],["of mercy,",["G1656"]],["which",["G3739"]],["he had afore prepared",["G4282"]],["unto",["G1519"]],["glory,",[]]]},{"verse":24,"text":"Even us, whom he hath called, not of the Jews only, but also of the Gentiles?","words":[["Even",["G2532"]],["us,",["G2248"]],["whom",["G3739"]],["he hath called,",["G2564"]],["not",["G3756"]],["of",["G1537"]],["the Jews",["G2453"]],["only,",["G3440"]],["but",["G235"]],["also",["G2532"]],["of",["G1537"]],["the Gentiles?",[]]]},{"verse":25,"text":"As he saith also in Osee, I will call them my people, which were not my people; and her beloved, which was not beloved.","words":[["As he saith",["G3004"]],["also",["G2532"]],["in",["G1722"]],["Osee,",["G5617"]],["I will call",["G2564"]],["them my",["G3450"]],["people,",["G2992"]],["which were not",["G3756"]],["my",["G3450"]],["people;",["G2992"]],["and",["G2532"]],["her beloved,",["G25"]],["which was",["G25"]],["not",["G3756"]],["beloved.",[]]]},{"verse":26,"text":"And it shall come to pass, that in the place where it was said unto them, Ye are not my people; there shall they be called the children of the living God.","words":[["And",["G2532"]],["it shall come to pass,",["G2071"]],["that in",["G1722"]],["the place",["G5117"]],["where",["G3757","G3739"]],["it was said",["G4483"]],["unto them,",["G846"]],["Ye",["G5210"]],["are not",["G3756"]],["my",["G3450"]],["people;",["G2992"]],["there",["G1563"]],["shall they be called",["G2564"]],["the children",["G5207"]],["of the living",["G2198"]],["God.",[]]]},{"verse":27,"text":"Esaias also crieth concerning Israel, Though the number of the children of Israel be as the sand of the sea, a remnant shall be saved:","words":[["Esaias",["G2268"]],["also",["G1161"]],["crieth",["G2896"]],["concerning",["G5228"]],["Israel,",["G2474"]],["Though",["G1437"]],["the number",["G706"]],["of the children",["G5207"]],["of Israel",["G2474"]],["be",["G5600"]],["as",["G5613"]],["the sand",["G285"]],["of the sea,",["G2281"]],["a remnant",["G2640"]],["shall be saved:",[]]]},{"verse":28,"text":"For he will finish the work, and cut it short in righteousness: because a short work will the Lord make upon the earth.","words":[["For",["G1063"]],["he will finish",["G4931"]],["the work,",["G3056"]],["and",["G2532"]],["cut it short",["G4932"]],["in",["G1722"]],["righteousness:",["G1343"]],["because",["G3754"]],["a short",["G4932"]],["work",["G3056"]],["will",["G4160"]],["the Lord",["G2962"]],["make",["G4160"]],["upon",["G1909"]],["the earth.",[]]]},{"verse":29,"text":"And as Esaias said before, Except the Lord of Sabaoth had left us a seed, we had been as Sodoma, and been made like unto Gomorrha.","words":[["And",["G2532"]],["as",["G2531"]],["Esaias",["G2268"]],["said before,",["G4280"]],["Except",["G1508"]],["the Lord",["G2962"]],["of Sabaoth",["G4519"]],["had left",["G1459"]],["us",["G2254"]],["a seed,",["G4690"]],["we had been",["G302","G1096"]],["as",["G5613"]],["Sodoma,",["G4670"]],["and",["G2532"]],["been made like",["G302","G3666"]],["unto",["G5613"]],["Gomorrha.",[]]]},{"verse":30,"text":"What shall we say then? That the Gentiles, which followed not after righteousness, have attained to righteousness, even the righteousness which is of faith.","words":[["What",["G5101"]],["shall we say",["G2046"]],["then?",["G3767"]],["That",["G3754"]],["the Gentiles,",["G1484"]],["which",["G3588"]],["followed",["G1377"]],["not",["G3361"]],["after righteousness,",["G1343"]],["have attained",["G2638"]],["to righteousness,",["G1343"]],["even",["G1161"]],["the righteousness",["G1343"]],["which",["G3588"]],["is of",["G1537"]],["faith.",[]]]},{"verse":31,"text":"But Israel, which followed after the law of righteousness, hath not attained to the law of righteousness.","words":[["But",["G1161"]],["Israel,",["G2474"]],["which followed",["G1377"]],["after the law",["G3551"]],["of righteousness,",["G1343"]],["hath",["G5348"]],["not",["G3756"]],["attained",["G5348"]],["to",["G1519"]],["the law",["G3551"]],["of righteousness.",[]]]},{"verse":32,"text":"Wherefore? Because they sought it not by faith, but as it were by the works of the law. For they stumbled at that stumblingstone;","words":[["Wherefore?",["G1302"]],["Because",["G3754"]],["they sought it not",["G3756"]],["by",["G1537"]],["faith,",["G4102"]],["but",["G235"]],["as",["G5613"]],["it were by",["G1537"]],["the works",["G2041"]],["of the law.",["G3551"]],["For",["G1063"]],["they stumbled",["G4350"]],["at that stumblingstone;",["G3037"]]]},{"verse":33,"text":"As it is written, Behold, I lay in Sion a stumblingstone and rock of offence: and whosoever believeth on him shall not be ashamed.","words":[["As",["G2531"]],["it is written,",["G1125"]],["Behold,",["G2400"]],["I lay",["G5087"]],["in",["G1722"]],["Sion",["G4622"]],["a stumblingstone",["G3037","G4348"]],["and",["G2532"]],["rock",["G4073"]],["of offence:",["G4625"]],["and",["G2532"]],["whosoever",["G3956"]],["believeth",["G4100"]],["on",["G1909"]],["him",["G846"]],["shall",["G2617"]],["not",["G3756"]],["be ashamed.",[]]]}]}