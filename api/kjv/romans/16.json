{"book":"Romans","chapter":16,"translation":"KJV","url":"/bible/romans/16","verses":[{"verse":1,"text":"I commend unto you Phebe our sister, which is a servant of the church which is at Cenchrea:","words":[["I commend",["G4921"]],["unto you",["G5213"]],["Phebe",["G5402"]],["our",["G2257"]],["sister,",["G79"]],["which is",["G5607"]],["a servant",["G1249"]],["of the church",["G1577"]],["which",["G3588"]],["is at",["G1722"]],["Cenchrea:",[]]]},{"verse":2,"text":"That ye receive her in the Lord, as becometh saints, and that ye assist her in whatsoever business she hath need of you: for she hath been a succourer of many, and of myself also.","words":[["That",["G2443"]],["ye receive",["G4327"]],["her",["G846"]],["in",["G1722"]],["the Lord,",["G2962"]],["as becometh",["G516"]],["saints,",["G40"]],["and",["G2532"]],["that ye assist",["G3936"]],["her",["G846"]],["in",["G1722"]],["whatsoever",["G3739","G302"]],["business",["G4229"]],["she hath need",["G5535"]],["of you:",["G5216"]],["for",["G1063"]],["she",["G3778","G846"]],["hath been",["G1096"]],["a succourer",["G4368"]],["of many,",["G4183"]],["and",["G2532"]],["of myself",["G846","G1700"]],["also.",[]]]},{"verse":3,"text":"Greet Priscilla and Aquila my helpers in Christ Jesus:","words":[["Greet",["G782"]],["Priscilla",["G4252"]],["and",["G2532"]],["Aquila",["G207"]],["my",["G3450"]],["helpers",["G4904"]],["in",["G1722"]],["Christ",["G5547"]],["Jesus:",[]]]},{"verse":4,"text":"Who have for my life laid down their own necks: unto whom not only I give thanks, but also all the churches of the Gentiles.","words":[["Who",["G3748"]],["have",["G5294"]],["for",["G5228"]],["my",["G3450"]],["life",["G5590"]],["laid down",["G5294"]],["their own",["G1438"]],["necks:",["G5137"]],["unto whom",["G3739"]],["not",["G3756"]],["only",["G3441"]],["I",["G1473"]],["give thanks,",["G2168"]],["but",["G235"]],["also",["G2532"]],["all",["G3956"]],["the churches",["G1577"]],["of the Gentiles.",[]]]},{"verse":5,"text":"Likewise greet the church that is in their house. Salute my wellbeloved Epenetus, who is the firstfruits of Achaia unto Christ.","words":[["Likewise",["G2532"]],["greet the church",["G1577"]],["that is in",["G2596"]],["their",["G846"]],["house.",["G3624"]],["Salute",["G782"]],["my",["G3450"]],["wellbeloved",["G27"]],["Epenetus,",["G1866"]],["who",["G3739"]],["is",["G2076"]],["the firstfruits",["G536"]],["of Achaia",["G882"]],["unto",["G1519"]],["Christ.",[]]]},{"verse":6,"text":"Greet Mary, who bestowed much labour on us.","words":[["Greet",["G782"]],["Mary,",["G3137"]],["who",["G3748"]],["bestowed",["G2872"]],["much",["G4183"]],["labour",["G2872"]],["on",["G1519"]],["us.",[]]]},{"verse":7,"text":"Salute Andronicus and Junia, my kinsmen, and my fellowprisoners, who are of note among the apostles, who also were in Christ before me.","words":[["Salute",["G782"]],["Andronicus",["G408"]],["and",["G2532"]],["Junia,",["G2458"]],["my",["G3450"]],["kinsmen,",["G4773"]],["and",["G2532"]],["my",["G3450"]],["fellowprisoners,",["G4869"]],["who",["G3748"]],["are",["G1526"]],["of note",["G1978"]],["among",["G1722"]],["the apostles,",["G652"]],["who",["G3739"]],["also",["G2532"]],["were",["G1096"]],["in",["G1722"]],["Christ",["G5547"]],["before",["G4253"]],["me.",[]]]},{"verse":8,"text":"Greet Amplias my beloved in the Lord.","words":[["Greet",["G782"]],["Amplias",["G291"]],["my",["G3450"]],["beloved",["G27"]],["in",["G1722"]],["the Lord.",[]]]},{"verse":9,"text":"Salute Urbane, our helper in Christ, and Stachys my beloved.","words":[["Salute",["G782"]],["Urbane,",["G3773"]],["our",["G2257"]],["helper",["G4904"]],["in",["G1722"]],["Christ,",["G5547"]],["and",["G2532"]],["Stachys",["G4720"]],["my",["G3450"]],["beloved.",[]]]},{"verse":10,"text":"Salute Apelles approved in Christ. Salute them which are of Aristobulus’ household.","words":[["Salute",["G782"]],["Apelles",["G559"]],["approved",["G1384"]],["in",["G1722"]],["Christ.",["G5547"]],["Salute",["G782"]],["them",["G3588"]],["which are of",["G1537"]],["Aristobulus’ household.",[]]]},{"verse":11,"text":"Salute Herodion my kinsman. Greet them that be of the household of Narcissus, which are in the Lord.","words":[["Salute",["G782"]],["Herodion",["G2267"]],["my",["G3450"]],["kinsman.",["G4773"]],["Greet",["G782"]],["them",["G3588"]],["that be of",["G1537"]],["the household of Narcissus,",["G3488"]],["which",["G3588"]],["are",["G5607"]],["in",["G1722"]],["the Lord.",[]]]},{"verse":12,"text":"Salute Tryphena and Tryphosa, who labour in the Lord. Salute the beloved Persis, which laboured much in the Lord.","words":[["Salute",["G782"]],["Tryphena",["G5170"]],["and",["G2532"]],["Tryphosa,",["G5173"]],["who labour",["G2872"]],["in",["G1722"]],["the Lord.",["G2962"]],["Salute",["G782"]],["the beloved",["G27"]],["Persis,",["G4069"]],["which",["G3748"]],["laboured",["G2872"]],["much",["G4183"]],["in",["G1722"]],["the Lord.",[]]]},{"verse":13,"text":"Salute Rufus chosen in the Lord, and his mother and mine.","words":[["Salute",["G782"]],["Rufus",["G4504"]],["chosen",["G1588"]],["in",["G1722"]],["the Lord,",["G2962"]],["and",["G2532"]],["his",["G846"]],["mother",["G3384"]],["and",["G2532"]],["mine.",[]]]},{"verse":14,"text":"Salute Asyncritus, Phlegon, Hermas, Patrobas, Hermes, and the brethren which are with them.","words":[["Salute",["G782"]],["Asyncritus,",["G799"]],["Phlegon,",["G5393"]],["Hermas,",["G2057"]],["Patrobas,",["G3969"]],["Hermes,",["G2060"]],["and",["G2532"]],["the brethren",["G80"]],["which are with",["G4862"]],["them.",[]]]},{"verse":15,"text":"Salute Philologus, and Julia, Nereus, and his sister, and Olympas, and all the saints which are with them.","words":[["Salute",["G782"]],["Philologus,",["G5378"]],["and",["G2532"]],["Julia,",["G2456"]],["Nereus,",["G3517"]],["and",["G2532"]],["his",["G846"]],["sister,",["G79"]],["and",["G2532"]],["Olympas,",["G3652"]],["and",["G2532"]],["all",["G3956"]],["the saints",["G40"]],["which are with",["G4862"]],["them.",[]]]},{"verse":16,"text":"Salute one another with an holy kiss. The churches of Christ salute you.","words":[["Salute",["G782"]],["one another",["G240"]],["with",["G1722"]],["an holy",["G40"]],["kiss.",["G5370"]],["The churches",["G1577"]],["of Christ",["G5547"]],["salute",["G782"]],["you.",[]]]},{"verse":17,"text":"Now I beseech you, brethren, mark them which cause divisions and offences contrary to the doctrine which ye have learned; and avoid them.","words":[["Now",["G1161"]],["I beseech",["G3870"]],["you,",["G5209"]],["brethren,",["G80"]],["mark",["G4648"]],["them which cause",["G4160"]],["divisions",["G1370"]],["and",["G2532"]],["offences",["G4625"]],["contrary",["G3844"]],["to the doctrine",["G1322"]],["which",["G3739"]],["ye",["G5210"]],["have learned;",["G3129"]],["and",["G2532"]],["avoid",["G1578"]],["them.",["G575"]]]},{"verse":18,"text":"For they that are such serve not our Lord Jesus Christ, but their own belly; and by good words and fair speeches deceive the hearts of the simple.","words":[["For",["G1063"]],["they that are such",["G5108"]],["serve",["G1398"]],["not",["G3756"]],["our",["G2257"]],["Lord",["G2962"]],["Jesus",["G2424"]],["Christ,",["G5547"]],["but",["G235"]],["their own",["G1438"]],["belly;",["G2836"]],["and",["G2532"]],["by",["G1223"]],["good words",["G5542"]],["and",["G2532"]],["fair speeches",["G2129"]],["deceive",["G1818"]],["the hearts",["G2588"]],["of the simple.",[]]]},{"verse":19,"text":"For your obedience is come abroad unto all men. I am glad therefore on your behalf: but yet I would have you wise unto that which is good, and simple concerning evil.","words":[["For",["G1063"]],["your",["G5216"]],["obedience",["G5218"]],["is come abroad",["G864"]],["unto",["G1519"]],["all",["G3956"]],["men. I am glad",["G5463"]],["therefore",["G3767"]],["on",["G1909"]],["your",["G5213"]],["behalf:",["G1909"]],["but yet",["G1161"]],["I would have",["G2309"]],["you",["G5209"]],["wise",["G4680"]],["unto",["G1519"]],["that which is",["G1511"]],["good,",["G3303","G18"]],["and",["G1161"]],["simple",["G185"]],["concerning",["G1519"]],["evil.",[]]]},{"verse":20,"text":"And the God of peace shall bruise Satan under your feet shortly. The grace of our Lord Jesus Christ be with you. Amen.","words":[["And",["G1161"]],["the God",["G2316"]],["of peace",["G1515"]],["shall bruise",["G4937"]],["Satan",["G4567"]],["under",["G5259"]],["your",["G5216"]],["feet",["G4228"]],["shortly.",["G1722","G5034"]],["The grace",["G5485"]],["of our",["G2257"]],["Lord",["G2962"]],["Jesus",["G2424"]],["Christ",["G5547"]],["be with",["G3326"]],["you.",["G5216"]],["Amen.",[]]]},{"verse":21,"text":"Timotheus my workfellow, and Lucius, and Jason, and Sosipater, my kinsmen, salute you.","words":[["Timotheus",["G5095"]],["my",["G3450"]],["workfellow,",["G4904"]],["and",["G2532"]],["Lucius,",["G3066"]],["and",["G2532"]],["Jason,",["G2394"]],["and",["G2532"]],["Sosipater,",["G4989"]],["my",["G3450"]],["kinsmen,",["G4773"]],["salute",["G782"]],["you.",[]]]},{"verse":22,"text":"I Tertius, who wrote this epistle, salute you in the Lord.","words":[["I",["G1473"]],["Tertius,",["G5060"]],["who wrote",["G1125"]],["this epistle,",["G1992"]],["salute",["G782"]],["you",["G5209"]],["in",["G1722"]],["the Lord.",[]]]},{"verse":23,"text":"Gaius mine host, and of the whole church, saluteth you. Erastus the chamberlain of the city saluteth you, and Quartus a brother.","words":[["Gaius",["G1050"]],["mine",["G3450"]],["host,",["G3581"]],["and",["G2532"]],["of the whole",["G3650"]],["church,",["G1577"]],["saluteth",["G782"]],["you.",["G5209"]],["Erastus",["G2037"]],["the chamberlain",["G3623"]],["of the city",["G4172"]],["saluteth",["G782"]],["you,",["G5209"]],["and",["G2532"]],["Quartus",["G2890"]],["a brother.",[]]]},{"verse":24,"text":"The grace of our Lord Jesus Christ be with you all. Amen.","words":[["The grace",["G5485"]],["of our",["G2257"]],["Lord",["G2962"]],["Jesus",["G2424"]],["Christ",["G5547"]],["be with",["G3326"]],["you",["G5216"]],["all.",["G3956"]],["Amen.",[]]]},{"verse":25,"text":"Now to him that is of power to stablish you according to my gospel, and the preaching of Jesus Christ, according to the revelation of the mystery, which was kept secret since the world began,","words":[["Now",["G1161"]],["to him that is of power",["G1410"]],["to stablish",["G4741"]],["you",["G5209"]],["according",["G2596"]],["to my",["G3450"]],["gospel,",["G2098"]],["and",["G2532"]],["the preaching",["G2782"]],["of Jesus",["G2424"]],["Christ,",["G5547"]],["according",["G2596"]],["to the revelation",["G602"]],["of the mystery,",["G3466"]],["which was kept secret",["G4601"]],["since the world began,",["G5550"]]]},{"verse":26,"text":"But now is made manifest, and by the scriptures of the prophets, according to the commandment of the everlasting God, made known to all nations for the obedience of faith:","words":[["But",["G1161"]],["now",["G3568"]],["is made manifest,",["G5319"]],["and",["G5037"]],["by",["G1223"]],["the scriptures",["G1124"]],["of the prophets,",["G4397"]],["according",["G2596"]],["to the commandment",["G2003"]],["of the everlasting",["G166"]],["God,",["G2316"]],["made known",["G1107"]],["to",["G1519"]],["all",["G3956"]],["nations",["G1484"]],["for",["G1519"]],["the obedience",["G5218"]],["of faith:",[]]]},{"verse":27,"text":"To God only wise, be glory through Jesus Christ for ever. Amen. Written to the Romans from Corinthus, and sent by Phebe servant of the church at Cenchrea.","words":[["To God",["G2316"]],["only",["G3441"]],["wise,",["G4680"]],["be glory",["G1391"]],["through",["G1223"]],["Jesus",["G2424"]],["Christ",["G5547"]],["for",["G1519"]],["ever.",["G165"]],["Amen. Written to the Romans from Corinthus, and sent by Phebe servant of the church at Cenchrea.",[]]]}]}