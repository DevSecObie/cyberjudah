{"book":"Romans","chapter":12,"translation":"KJV","url":"/bible/romans/12","verses":[{"verse":1,"text":"I beseech you therefore, brethren, by the mercies of God, that ye present your bodies a living sacrifice, holy, acceptable unto God, which is your reasonable service.","words":[["I beseech",["G3870"]],["you",["G5209"]],["therefore,",["G3767"]],["brethren,",["G80"]],["by",["G1223"]],["the mercies",["G3628"]],["of God,",["G2316"]],["that ye present",["G3936"]],["your",["G5216"]],["bodies",["G4983"]],["a living",["G2198"]],["sacrifice,",["G2378"]],["holy,",["G40"]],["acceptable",["G2101"]],["unto God,",["G2316"]],["which is your",["G5216"]],["reasonable",["G3050"]],["service.",[]]]},{"verse":2,"text":"And be not conformed to this world: but be ye transformed by the renewing of your mind, that ye may prove what is that good, and acceptable, and perfect, will of God.","words":[["And",["G2532"]],["be",["G4964"]],["not",["G3361"]],["conformed",["G4964"]],["to this",["G5129"]],["world:",["G165"]],["but",["G235"]],["be ye transformed",["G3339"]],["by the renewing",["G342"]],["of your",["G5216"]],["mind,",["G3563"]],["that",["G1519"]],["ye",["G5209"]],["may prove",["G1381"]],["what",["G5101"]],["is that good,",["G18"]],["and",["G2532"]],["acceptable,",["G2101"]],["and",["G2532"]],["perfect,",["G5046"]],["will",["G2307"]],["of God.",[]]]},{"verse":3,"text":"For I say, through the grace given unto me, to every man that is among you, not to think of himself more highly than he ought to think; but to think soberly, according as God hath dealt to every man the measure of faith.","words":[["For",["G1063"]],["I say,",["G3004"]],["through",["G1223"]],["the grace",["G5485"]],["given",["G1325"]],["unto me,",["G3427"]],["to every man",["G3956"]],["that is",["G5607"]],["among",["G1722"]],["you,",["G5213"]],["not",["G3361"]],["to think of himself more",["G3844"]],["highly",["G5252"]],["than",["G3739"]],["he ought",["G1163"]],["to think;",["G5426"]],["but",["G235"]],["to think",["G5426"]],["soberly,",["G1519","G4993"]],["according as",["G5613"]],["God",["G2316"]],["hath dealt",["G3307"]],["to every man",["G1538"]],["the measure",["G3358"]],["of faith.",[]]]},{"verse":4,"text":"For as we have many members in one body, and all members have not the same office:","words":[["For",["G1063"]],["as",["G2509"]],["we have",["G2192"]],["many",["G4183"]],["members",["G3196"]],["in",["G1722"]],["one",["G1520"]],["body,",["G4983"]],["and",["G1161"]],["all",["G3956"]],["members",["G3196"]],["have",["G2192"]],["not",["G3756"]],["the same",["G846"]],["office:",[]]]},{"verse":5,"text":"So we, being many, are one body in Christ, and every one members one of another.","words":[["So",["G3779"]],["we,",["G2070"]],["being many,",["G4183"]],["are",["G2070"]],["one",["G1520"]],["body",["G4983"]],["in",["G1722"]],["Christ,",["G5547"]],["and",["G1161"]],["every",["G2596"]],["one",["G1520"]],["members",["G3196"]],["one of another.",[]]]},{"verse":6,"text":"Having then gifts differing according to the grace that is given to us, whether prophecy, let us prophesy according to the proportion of faith;","words":[["Having",["G2192"]],["then",["G1161"]],["gifts",["G5486"]],["differing",["G1313"]],["according",["G2596"]],["to the grace",["G5485"]],["that is given",["G1325"]],["to us,",["G2254"]],["whether",["G1535"]],["prophecy,",["G4394"]],["let us prophesy according",["G2596"]],["to the proportion",["G356"]],["of faith;",[]]]},{"verse":7,"text":"Or ministry, let us wait on our ministering: or he that teacheth, on teaching;","words":[["Or",["G1535"]],["ministry,",["G1248"]],["let us wait on",["G1722"]],["our ministering:",["G1248"]],["or",["G1535"]],["he that teacheth,",["G1321"]],["on",["G1722"]],["teaching;",[]]]},{"verse":8,"text":"Or he that exhorteth, on exhortation: he that giveth, let him do it with simplicity; he that ruleth, with diligence; he that sheweth mercy, with cheerfulness.","words":[["Or",["G1535"]],["he that exhorteth,",["G3870"]],["on",["G1722"]],["exhortation:",["G3874"]],["he that giveth,",["G3330"]],["let him do it with",["G1722"]],["simplicity;",["G572"]],["he that ruleth,",["G4291"]],["with",["G1722"]],["diligence;",["G4710"]],["he that sheweth mercy,",["G1653"]],["with",["G1722"]],["cheerfulness.",[]]]},{"verse":9,"text":"Let love be without dissimulation. Abhor that which is evil; cleave to that which is good.","words":[["Let love",["G26"]],["be without dissimulation.",["G505"]],["Abhor",["G655"]],["that which is evil;",["G4190"]],["cleave",["G2853"]],["to that which is good.",[]]]},{"verse":10,"text":"Be kindly affectioned one to another with brotherly love; in honour preferring one another;","words":[["Be kindly affectioned",["G5387"]],["one to another",["G1519","G240"]],["with brotherly love;",["G5360"]],["in honour",["G5092"]],["preferring",["G4285"]],["one another;",[]]]},{"verse":11,"text":"Not slothful in business; fervent in spirit; serving the Lord;","words":[["Not",["G3361"]],["slothful",["G3636"]],["in business;",["G4710"]],["fervent",["G2204"]],["in spirit;",["G4151"]],["serving",["G1398"]],["the Lord;",[]]]},{"verse":12,"text":"Rejoicing in hope; patient in tribulation; continuing instant in prayer;","words":[["Rejoicing",["G5463"]],["in hope;",["G1680"]],["patient",["G5278"]],["in tribulation;",["G2347"]],["continuing instant",["G4342"]],["in prayer;",[]]]},{"verse":13,"text":"Distributing to the necessity of saints; given to hospitality.","words":[["Distributing",["G2841"]],["to the necessity",["G5532"]],["of saints;",["G40"]],["given",["G1377"]],["to hospitality.",[]]]},{"verse":14,"text":"Bless them which persecute you: bless, and curse not.","words":[["Bless",["G2127"]],["them which persecute",["G1377"]],["you:",["G5209"]],["bless,",["G2127"]],["and",["G2532"]],["curse",["G2672"]],["not.",[]]]},{"verse":15,"text":"Rejoice with them that do rejoice, and weep with them that weep.","words":[["Rejoice",["G5463"]],["with",["G3326"]],["them that do rejoice,",["G5463"]],["and",["G2532"]],["weep",["G2799"]]