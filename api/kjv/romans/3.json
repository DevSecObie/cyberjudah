{"book":"Romans","chapter":3,"translation":"KJV","url":"/bible/romans/3","verses":[{"verse":1,"text":"What advantage then hath the Jew? or what profit is there of circumcision?","words":[["What",["G5101"]],["advantage",["G4053"]],["then",["G3767"]],["hath the Jew?",["G2453"]],["or",["G2228"]],["what",["G5101"]],["profit",["G5622"]],["is there of circumcision?",[]]]},{"verse":2,"text":"Much every way: chiefly, because that unto them were committed the oracles of God.","words":[["Much",["G4183"]],["every",["G2596","G3956"]],["way:",["G5158"]],["chiefly,",["G4412"]],["because",["G3303","G1063"]],["that",["G3754"]],["unto them were committed",["G4100"]],["the oracles",["G3051"]],["of God.",[]]]},{"verse":3,"text":"For what if some did not believe? shall their unbelief make the faith of God without effect?","words":[["For",["G1063"]],["what",["G5101"]],["if",["G1487"]],["some",["G5100"]],["did not believe?",["G569","G3361"]],["shall",["G2673"]],["their",["G846"]],["unbelief",["G570"]],["make",["G2673"]],["the faith",["G4102"]],["of God",["G2316"]],["without effect?",[]]]},{"verse":4,"text":"God forbid: yea, let God be true, but every man a liar; as it is written, That thou mightest be justified in thy sayings, and mightest overcome when thou art judged.","words":[["God forbid:",["G3361","G1096"]],["yea,",["G1161"]],["let",["G1096"]],["God",["G2316"]],["be",["G1096"]],["true,",["G227"]],["but",["G1161"]],["every",["G3956"]],["man",["G444"]],["a liar;",["G5583"]],["as",["G2531"]],["it is written,",["G1125"]],["That",["G3704"]],["thou mightest",["G302"]],["be justified",["G1344"]],["in",["G1722"]],["thy",["G4675"]],["sayings,",["G3056"]],["and",["G2532"]],["mightest overcome",["G3528"]],["when",["G1722"]],["thou",["G4571"]],["art judged.",[]]]},{"verse":5,"text":"But if our unrighteousness commend the righteousness of God, what shall we say? Is God unrighteous who taketh vengeance? (I speak as a man)","words":[["But",["G1161"]],["if",["G1487"]],["our",["G2257"]],["unrighteousness",["G93"]],["commend",["G4921"]],["the righteousness",["G1343"]],["of God,",["G2316"]],["what",["G5101"]],["shall we say?",["G2046","G3361"]],["Is God",["G2316"]],["unrighteous",["G94"]],["who taketh",["G2018"]],["vengeance?",["G3709"]],["(I speak",["G3004"]],["as",["G2596"]],["a man)",[]]]},{"verse":6,"text":"God forbid: for then how shall God judge the world?","words":[["God forbid:",["G3361","G1096"]],["for then",["G1893"]],["how",["G4459"]],["shall",["G2919"]],["God",["G2316"]],["judge",["G2919"]],["the world?",[]]]},{"verse":7,"text":"For if the truth of God hath more abounded through my lie unto his glory; why yet am I also judged as a sinner?","words":[["For",["G1063"]],["if",["G1487"]],["the truth",["G225"]],["of God",["G2316"]],["hath more abounded",["G4052"]],["through",["G1722"]],["my",["G1699"]],["lie",["G5582"]],["unto",["G1519"]],["his",["G846"]],["glory;",["G1391"]],["why",["G5101"]],["yet",["G2089"]],["am",["G2919"]],["I also",["G2504"]],["judged",["G2919"]],["as",["G5613"]],["a sinner?",[]]]},{"verse":8,"text":"And not rather, (as we be slanderously reported, and as some affirm that we say,) Let us do evil, that good may come? whose damnation is just.","words":[["And",["G2532"]],["not",["G3361"]],["rather, (as",["G2531"]],["we be slanderously reported,",["G987"]],["and",["G2532"]],["as",["G2531"]],["some",["G5100"]],["affirm",["G5346"]],["that we",["G2248"]],["say,)",["G3004","G3754"]],["Let us do",["G4160"]],["evil,",["G2556"]],["that",["G2443"]],["good",["G18"]],["may come?",["G2064"]],["whose",["G3739"]],["damnation",["G2917"]],["is",["G2076"]],["just.",[]]]},{"verse":9,"text":"What then? are we better than they? No, in no wise: for we have before proved both Jews and Gentiles, that they are all under sin;","words":[["What",["G5101"]],["then?",["G3767"]],["are we better",["G4284"]],["than they? No,",["G3756"]],["in no wise:",["G3843"]],["for",["G1063"]],["we have before proved",["G4256"]],["both",["G5037"]],["Jews",["G2453"]],["and",["G2532"]],["Gentiles,",["G1672"]],["that they are",["G1511"]],["all",["G3956"]],["under",["G5259"]],["sin;",[]]]},{"verse":10,"text":"As it is written, There is none righteous, no, not one:","words":[["As",["G2531"]],["it is written,",["G1125","G3754"]],["There is",["G2076"]],["none",["G3756"]],["righteous,",["G1342"]],["no, not",["G3761"]],["one:",[]]]},{"verse":11,"text":"There is none that understandeth, there is none that seeketh after God.","words":[["There is",["G2076"]],["none",["G3756"]],["that understandeth,",["G4920"]],["there is",["G2076"]],["none",["G3756"]],["that seeketh after",["G1567"]],["God.",[]]]},{"verse":12,"text":"They are all gone out of the way, they are together become unprofitable; there is none that doeth good, no, not one.","words":[["They are",["G1578"]],["all",["G3956"]],["gone out of the way,",["G1578"]],["they are",["G889"]],["together",["G260"]],["become unprofitable;",["G889"]],["there is",["G2076"]],["none",["G3756"]],["that doeth",["G4160"]],["good,",["G5544"]],["no, not",["G3756"]],["one.",["G2076","G2193"]]]},{"verse":13,"text":"Their throat is an open sepulchre; with their tongues they have used deceit; the poison of asps is under their lips:","words":[["Their",["G846"]],["throat",["G2995"]],["is an open",["G455"]],["sepulchre;",["G5028"]],["with their",["G846"]],["tongues",["G1100"]],["they have used deceit;",["G1387"]],["the poison",["G2447"]],["of asps",["G785"]],["is under",["G5259"]],["their",["G846"]],["lips:",[]]]},{"verse":14,"text":"Whose mouth is full of cursing and bitterness:","words":[["Whose",["G3739"]],["mouth",["G4750"]],["is full",["G1073"]],["of cursing",["G685"]],["and",["G2532"]],["bitterness:",[]]]},{"verse":15,"text":"Their feet are swift to shed blood:","words":[["Their",["G846"]],["feet",["G4228"]],["are swift",["G3691"]],["to shed",["G1632"]],["blood:",[]]]},{"verse":16,"text":"Destruction and misery are in their ways:","words":[["Destruction",["G4938"]],["and",["G2532"]],["misery",["G5004"]],["are in",["G1722"]],["their",["G846"]],["ways:",[]]]},{"verse":17,"text":"And the way of peace have they not known:","words":[["And",["G2532"]],["the way",["G3598"]],["of peace",["G1515"]],["have",["G1097"]],["they not",["G3756"]],["known:",[]]]},{"verse":18,"text":"There is no fear of God before their eyes.","words":[["There is",["G2076"]],["no",["G3756"]],["fear",["G5401"]],["of God",["G2316"]],["before",["G561"]],["their",["G846"]],["eyes.",[]]]},{"verse":19,"text":"Now we know that what things soever the law saith, it saith to them who are under the law: that every mouth may be stopped, and all the world may become guilty before God.","words":[["Now",["G1161"]],["we know",["G1492"]],["that",["G3754"]],["what things soever",["G3745"]],["the law",["G3551"]],["saith,",["G3004"]],["it saith",["G2980"]],["to them who are under",["G1722"]],["the law:",["G3551"]],["that",["G2443"]],["every",["G3956"]],["mouth",["G4750"]],["may be stopped,",["G5420"]],["and",["G2532"]],["all",["G3956"]],["the world",["G2889"]],["may become",["G1096"]],["guilty",["G5267"]],["before God.",[]]]},{"verse":20,"text":"Therefore by the deeds of the law there shall no flesh be justified in his sight: for by the law is the knowledge of sin.","words":[["Therefore",["G1360"]],["by",["G1537"]],["the deeds",["G2041"]],["of the law",["G3551"]],["there shall",["G1344"]],["no",["G3956","G3756"]],["flesh",["G4561"]],["be justified",["G1344"]],["in his",["G846"]],["sight:",["G1799"]],["for",["G1063"]],["by",["G1223"]],["the law",["G3551"]],["is the knowledge",["G1922"]],["of sin.",[]]]},{"verse":21,"text":"But now the righteousness of God without the law is manifested, being witnessed by the law and the prophets;","words":[["But",["G1161"]],["now",["G3570"]],["the righteousness",["G1343"]],["of God",["G2316"]],["without",["G5565"]],["the law",["G3551"]],["is manifested,",["G5319"]],["being witnessed",["G3140"]],["by",["G5259"]],["the law",["G3551"]],["and",["G2532"]],["the prophets;",[]]]},{"verse":22,"text":"Even the righteousness of God which is by faith of Jesus Christ unto all and upon all them that believe: for there is no difference:","words":[["Even",["G1161"]],["the righteousness",["G1343"]],["of God",["G2316"]],["which is by",["G1223"]],["faith",["G4102"]],["of Jesus",["G2424"]],["Christ",["G5547"]],["unto",["G1519"]],["all",["G3956"]],["and",["G2532"]],["upon",["G1909"]],["all",["G3956"]],["them that believe:",["G4100"]],["for",["G1063"]],["there is",["G2076"]],["no",["G3756"]],["difference:",[]]]},{"verse":23,"text":"For all have sinned, and come short of the glory of God;","words":[["For",["G1063"]],["all",["G3956"]],["have sinned,",["G264"]],["and",["G2532"]],["come short",["G5302"]],["of the glory",["G1391"]],["of God;",[]]]},{"verse":24,"text":"Being justified freely by his grace through the redemption that is in Christ Jesus:","words":[["Being justified",["G1344"]],["freely",["G1432"]],["by his",["G846"]],["grace",["G5485"]],["through",["G1223"]],["the redemption",["G629"]],["that is in",["G1722"]],["Christ",["G5547"]],["Jesus:",[]]]},{"verse":25,"text":"Whom God hath set forth to be a propitiation through faith in his blood, to declare his righteousness for the remission of sins that are past, through the forbearance of God;","words":[["Whom",["G3739"]],["God",["G2316"]],["hath set forth",["G4388"]],["to be a propitiation",["G2435"]],["through",["G1223"]],["faith",["G4102"]],["in",["G1722"]],["his",["G846"]],["blood,",["G129"]],["to",["G1519"]],["declare",["G1732"]],["his",["G846"]],["righteousness",["G1343"]],["for",["G1223"]],["the remission",["G3929"]],["of sins",["G265"]],["that are past,",["G4266"]],["through",["G1722"]],["the forbearance",["G463"]],["of God;",[]]]},{"verse":26,"text":"To declare, I say, at this time his righteousness: that he might be just, and the justifier of him which believeth in Jesus.","words":[["To",["G4314"]],["declare,",["G1732"]],["I say, at",["G1722"]],["this",["G3568"]],["time",["G2540"]],["his",["G846"]],["righteousness:",["G1343"]],["that",["G1519"]],["he might be",["G1511"]],["just,",["G1342"]],["and",["G2532"]],["the justifier",["G1344"]],["of him",["G846"]],["which believeth",["G4102"]],["in",["G1537"]],["Jesus.",[]]]},{"verse":27,"text":"Where is boasting then? It is excluded. By what law? of works? Nay: but by the law of faith.","words":[["Where",["G4226"]],["is boasting",["G2746"]],["then?",["G3767"]],["It is excluded.",["G1576"]],["By",["G1223"]],["what",["G4169"]],["law?",["G3551"]],["of works?",["G2041"]],["Nay:",["G3780"]],["but",["G235"]],["by",["G1223"]],["the law",["G3551"]],["of faith.",[]]]},{"verse":28,"text":"Therefore we conclude that a man is justified by faith without the deeds of the law.","words":[["Therefore",["G3767"]],["we conclude",["G3049"]],["that a man",["G444"]],["is justified",["G1344"]],["by faith",["G4102"]],["without",["G5565"]],["the deeds",["G2041"]],["of the law.",[]]]},{"verse":29,"text":"Is he the God of the Jews only? is he not also of the Gentiles? Yes, of the Gentiles also:","words":[["Is he",["G2228"]],["the God",["G2316"]],["of the Jews",["G2453"]],["only?",["G3440"]],["is he not",["G3780"]],["also",["G1161","G2532"]],["of the Gentiles?",["G1484"]],["Yes,",["G3483"]],["of the Gentiles",["G1484"]],["also:",[]]]},{"verse":30,"text":"Seeing it is one God, which shall justify the circumcision by faith, and uncircumcision through faith.","words":[["Seeing",["G1897"]],["it is one",["G1520"]],["God,",["G2316"]],["which",["G3739"]],["shall justify",["G1344"]],["the circumcision",["G4061"]],["by",["G1537"]],["faith,",["G4102"]],["and",["G2532"]],["uncircumcision",["G203"]],["through",["G1223"]],["faith.",[]]]},{"verse":31,"text":"Do we then make void the law through faith? God forbid: yea, we establish the law.","words":[["Do we",["G2673"]],["then",["G3767"]],["make void",["G2673"]],["the law",["G3551"]],["through",["G1223"]],["faith?",["G4102"]],["God forbid:",["G3361","G1096"]],["yea,",["G235"]],["we establish",["G2476"]],["the law.",[]]]}]}