{"book":"2 Peter","chapter":1,"translation":"KJV","url":"/bible/2-peter/1","verses":[{"verse":1,"text":"Simon Peter, a servant and an apostle of Jesus Christ, to them that have obtained like precious faith with us through the righteousness of God and our Saviour Jesus Christ:","words":[["Simon",["G4826"]],["Peter,",["G4074"]],["a servant",["G1401"]],["and",["G2532"]],["an apostle",["G652"]],["of Jesus",["G2424"]],["Christ,",["G5547"]],["to them that have obtained",["G2975"]],["like precious",["G2472"]],["faith",["G4102"]],["with us",["G2254"]],["through",["G1722"]],["the righteousness",["G1343"]],["of God",["G2316"]],["and",["G2532"]],["our",["G2257"]],["Saviour",["G4990"]],["Jesus",["G2424"]],["Christ:",["G5547"]]]},{"verse":2,"text":"Grace and peace be multiplied unto you through the knowledge of God, and of Jesus our Lord,","words":[["Grace",["G5485"]],["and",["G2532"]],["peace",["G1515"]],["be multiplied",["G4129"]],["unto you",["G5213"]],["through",["G1722"]],["the knowledge",["G1922"]],["of God,",["G2316"]],["and",["G2532"]],["of Jesus",["G2424"]],["our",["G2257"]],["Lord,",["G2962"]]]},{"verse":3,"text":"According as his divine power hath given unto us all things that pertain unto life and godliness, through the knowledge of him that hath called us to glory and virtue:","words":[["According as",["G5613"]],["his",["G846"]],["divine",["G2304"]],["power",["G1411"]],["hath given",["G1433"]],["unto us",["G2254"]],["all things",["G3956"]],["that pertain unto",["G4314"]],["life",["G2222"]],["and",["G2532"]],["godliness,",["G2150"]],["through",["G1223"]],["the knowledge",["G1922"]],["of him that hath called",["G2564"]],["us",["G2248"]],["to",["G1223"]],["glory",["G1391"]],["and",["G2532"]],["virtue:",["G703"]]]},{"verse":4,"text":"Whereby are given unto us exceeding great and precious promises: that by these ye might be partakers of the divine nature, having escaped the corruption that is in the world through lust.","words":[["Whereby",["G1223","G3739"]],["are given",["G1433"]],["unto us",["G2254"]],["exceeding great",["G3176"]],["and",["G2532"]],["precious",["G5093"]],["promises:",["G1862"]],["that",["G2443"]],["by",["G1223"]],["these",["G5130"]],["ye might be",["G1096"]],["partakers",["G2844"]],["of the divine",["G2304"]],["nature,",["G5449"]],["having escaped",["G668"]],["the corruption",["G5356"]],["that is in",["G1722"]],["the world",["G2889"]],["through",["G1722"]],["lust.",["G1939"]]]},{"verse":5,"text":"And beside this, giving all diligence, add to your faith virtue; and to virtue knowledge;","words":[["And",["G2532","G1161"]],["beside",["G846"]],["this,",["G5124"]],["giving",["G3923"]],["all",["G3956"]],["diligence,",["G4710"]],["add",["G2023"]],["to",["G1722"]],["your",["G5216"]],["faith",["G4102"]],["virtue;",["G703"]],["and",["G1161"]],["to",["G1722"]],["virtue",["G703"]],["knowledge;",["G1108"]]]},{"verse":6,"text":"And to knowledge temperance; and to temperance patience; and to patience godliness;","words":[["And",["G1161"]],["to",["G1722"]],["knowledge",["G1108"]],["temperance;",["G1466"]],["and",["G1161"]],["to",["G1722"]],["temperance",["G1466"]],["patience;",["G5281"]],["and",["G1161"]],["to",["G1722"]],["patience",["G5281"]],["godliness;",["G2150"]]]},{"verse":7,"text":"And to godliness brotherly kindness; and to brotherly kindness charity.","words":[["And",["G1161"]],["to",["G1722"]],["godliness",["G2150"]],["brotherly kindness;",["G5360"]],["and",["G1161"]],["to",["G1722"]],["brotherly kindness",["G5360"]],["charity.",["G26"]]]},{"verse":8,"text":"For if these things be in you, and abound, they make you that ye shall neither be barren nor unfruitful in the knowledge of our Lord Jesus Christ.","words":[["For",["G1063"]],["if these things",["G5023"]],["be",["G5225"]],["in you,",["G5213"]],["and",["G2532"]],["abound,",["G4121"]],["they make",["G2525"]],["you that ye shall neither",["G3756"]],["be barren",["G692"]],["nor",["G3761"]],["unfruitful",["G175"]],["in",["G1519"]],["the knowledge",["G1922"]],["of our",["G2257"]],["Lord",["G2962"]],["Jesus",["G2424"]],["Christ.",["G5547"]]]},{"verse":9,"text":"But he that lacketh these things is blind, and cannot see afar off, and hath forgotten that he was purged from his old sins.","words":[["But",["G1063"]],["he that",["G3739"]],["lacketh",["G3361","G3918"]],["these things",["G5023"]],["is",["G2076"]],["blind,",["G5185"]],["and cannot see afar off,",["G3467"]],["and hath forgotten",["G3024","G2983"]],["that he was purged from",["G2512"]],["his",["G846"]],["old",["G3819"]],["sins.",["G266"]]]},{"verse":10,"text":"Wherefore the rather, brethren, give diligence to make your calling and election sure: for if ye do these things, ye shall never fall:","words":[["Wherefore",["G1352"]],["the rather,",["G3123"]],["brethren,",["G80"]],["give diligence",["G4704"]],["to make",["G4160"]],["your",["G5216"]],["calling",["G2821"]],["and",["G2532"]],["election",["G1589"]],["sure:",["G949"]],["for",["G1063"]],["if ye do",["G4160"]],["these things,",["G5023"]],["ye shall",["G4417","G4218"]],["never",["G3364"]],["fall:",["G4417","G4218"]]]},{"verse":11,"text":"For so an entrance shall be ministered unto you abundantly into the everlasting kingdom of our Lord and Saviour Jesus Christ.","words":[["For",["G1063"]],["so",["G3779"]],["an entrance",["G1529"]],["shall be ministered",["G2023"]],["unto you",["G5213"]],["abundantly",["G4146"]],["into",["G1519"]],["the everlasting",["G166"]],["kingdom",["G932"]],["of our",["G2257"]],["Lord",["G2962"]],["and",["G2532"]],["Saviour",["G4990"]],["Jesus",["G2424"]],["Christ.",["G5547"]]]},{"verse":12,"text":"Wherefore I will not be negligent to put you always in remembrance of these things, though ye know them, and be established in the present truth.","words":[["Wherefore",["G1352"]],["I will",["G272"]],["not",["G3756"]],["be negligent",["G272"]],["to put",["G5279"]],["you",["G5209"]],["always",["G104"]],["in remembrance",["G5279"]],["of",["G4012"]],["these things,",["G5130"]],["though",["G2539"]],["ye know",["G1492"]],["them, and",["G2532"]],["be established",["G4741"]],["in",["G1722"]],["the present",["G3918"]],["truth.",["G225"]]]},{"verse":13,"text":"Yea, I think it meet, as long as I am in this tabernacle, to stir you up by putting you in remembrance;","words":[["Yea,",["G1161"]],["I think it",["G2233"]],["meet,",["G1342"]],["as long as",["G1909","G3745"]],["I am",["G1510"]],["in",["G1722"]],["this",["G5129"]],["tabernacle,",["G4638"]],["to stir",["G1326"]],["you",["G5209"]],["up",["G1326"]],["by",["G1722"]],["putting you in remembrance;",["G5280"]]]},{"verse":14,"text":"Knowing that shortly I must put off this my tabernacle, even as our Lord Jesus Christ hath shewed me.","words":[["Knowing",["G1492"]],["that",["G3754"]],["shortly",["G5031"]],["I must",["G2076"]],["put off",["G595"]],["this my",["G3450"]],["tabernacle,",["G4638"]],["even",["G2532"]],["as",["G2531"]],["our",["G2257"]],["Lord",["G2962"]],["Jesus",["G2424"]],["Christ",["G5547"]],["hath shewed",["G1213"]],["me.",["G3427"]]]},{"verse":15,"text":"Moreover I will endeavour that ye may be able after my decease to have these things always in remembrance.","words":[["Moreover",["G1161","G2532"]],["I will endeavour",["G4704"]],["that ye",["G5209"]],["may be able",["G2192"]],["after",["G3326"]],["my",["G1699"]],["decease",["G1841"]],["to have",["G4160"]],["these things",["G5130"]],["always",["G1539"]],["in remembrance.",["G3420"]]]},{"verse":16,"text":"For we have not followed cunningly devised fables, when we made known unto you the power and coming of our Lord Jesus Christ, but were eyewitnesses of his majesty.","words":[["For",["G1063"]],["we have",["G1811"]],["not",["G3756"]],["followed",["G1811"]],["cunningly devised",["G4679"]],["fables,",["G3454"]],["when we made known",["G1107"]],["unto you",["G5213"]],["the power",["G1411"]],["and",["G2532"]],["coming",["G3952"]],["of our",["G2257"]],["Lord",["G2962"]],["Jesus",["G2424"]],["Christ,",["G5547"]],["but",["G235"]],["were",["G1096"]],["eyewitnesses",["G2030"]],["of his",["G1565"]],["majesty.",["G3168"]]]},{"verse":17,"text":"For he received from God the Father honour and glory, when there came such a voice to him from the excellent glory, This is my beloved Son, in whom I am well pleased.","words":[["For",["G1063"]],["he received",["G2983"]],["from",["G3844"]],["God",["G2316"]],["the Father",["G3962"]],["honour",["G5092"]],["and",["G2532"]],["glory,",["G1391"]],["when there came",["G5342"]],["such",["G5107"]],["a voice",["G5456"]],["to him",["G846"]],["from",["G5259"]],["the excellent",["G3169"]],["glory,",["G1391"]],["This",["G3778"]],["is",["G2076"]],["my",["G3450"]],["beloved",["G27"]],["Son,",["G5207"]],["in",["G1519"]],["whom",["G3739"]],["I",["G1473"]],["am well pleased.",["G2106"]]]},{"verse":18,"text":"And this voice which came from heaven we heard, when we were with him in the holy mount.","words":[["And",["G2532"]],["this",["G5026"]],["voice",["G5456"]],["which came",["G5342"]],["from",["G1537"]],["heaven",["G3772"]],["we",["G2249"]],["heard,",["G191"]],["when we were",["G5607"]],["with",["G4862"]],["him",["G846"]],["in",["G1722"]],["the holy",["G40"]],["mount.",["G3735"]]]},{"verse":19,"text":"We have also a more sure word of prophecy; whereunto ye do well that ye take heed, as unto a light that shineth in a dark place, until the day dawn, and the day star arise in your hearts:","words":[["We have",["G2192"]],["also",["G2532"]],["a more sure",["G949"]],["word",["G3056"]],["of prophecy;",["G4397"]],["whereunto",["G3739"]],["ye do",["G4160"]],["well",["G2573"]],["that ye take heed,",["G4337"]],["as",["G5613"]],["unto a light",["G3088"]],["that shineth",["G5316"]],["in",["G1722"]],["a dark",["G850"]],["place,",["G5117"]],["until",["G2193","G3757"]],["the day",["G2250"]],["dawn,",["G1306"]],["and",["G2532"]],["the day star",["G5459"]],["arise",["G393"]],["in",["G1722"]],["your",["G5216"]],["hearts:",["G2588"]]]},{"verse":20,"text":"Knowing this first, that no prophecy of the scripture is of any private interpretation.","words":[["Knowing",["G1097"]],["this",["G5124"]],["first,",["G4412"]],["that",["G3754"]],["no",["G3756","G3956"]],["prophecy",["G4394"]],["of the scripture",["G1124"]],["is",["G1096"]],["of any private",["G2398"]],["interpretation.",["G1955"]]]},{"verse":21,"text":"For the prophecy came not in old time by the will of man: but holy men of God spake as they were moved by the Holy Ghost.","words":[["For",["G1063"]],["the prophecy",["G4394"]],["came",["G5342"]],["not",["G3756"]],["in old time",["G4218"]],["by the will",["G2307"]],["of man:",["G444"]],["but",["G235"]],["holy",["G40"]],["men",["G444"]],["of God",["G2316"]],["spake",["G2980"]],["as they were moved",["G5342"]],["by",["G5259"]],["the Holy",["G40"]],["Ghost.",["G4151"]]]}]}