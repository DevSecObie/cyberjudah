{"book":"2 Corinthians","chapter":6,"translation":"KJV","url":"/bible/2-corinthians/6","verses":[{"verse":1,"text":"We then, as workers together with him, beseech you also that ye receive not the grace of God in vain.","words":[["We",["G3870"]],["then,",["G1161"]],["as workers together",["G4903"]],["with him, beseech",["G3870"]],["you also",["G2532"]],["that ye",["G5209"]],["receive",["G1209"]],["not",["G3361"]],["the grace",["G5485"]],["of God",["G2316"]],["in",["G1519"]],["vain.",["G2756"]]]},{"verse":2,"text":"(For he saith, I have heard thee in a time accepted, and in the day of salvation have I succoured thee: behold, now is the accepted time; behold, now is the day of salvation.)","words":[["(For",["G1063"]],["he saith,",["G3004"]],["I have heard",["G1873"]],["thee",["G4675"]],["in a time",["G2540"]],["accepted,",["G1184"]],["and",["G2532"]],["in",["G1722"]],["the day",["G2250"]],["of salvation",["G4991"]],["have I succoured",["G997"]],["thee:",["G4671"]],["behold,",["G2400"]],["now",["G3568"]],["is the accepted",["G2144"]],["time;",["G2540"]],["behold,",["G2400"]],["now",["G3568"]],["is the day",["G2250"]],["of salvation.)",["G4991"]]]},{"verse":3,"text":"Giving no offence in any thing, that the ministry be not blamed:","words":[["Giving",["G1325"]],["no",["G3367"]],["offence",["G4349"]],["in",["G1722"]],["any thing,",["G3367"]],["that",["G3363"]],["the ministry",["G1248"]],["be",["G3469"]],["not",["G3363"]],["blamed:",["G3469"]]]},{"verse":4,"text":"But in all things approving ourselves as the ministers of God, in much patience, in afflictions, in necessities, in distresses,","words":[["But",["G235"]],["in",["G1722"]],["all",["G3956"]],["things approving",["G4921"]],["ourselves",["G1438"]],["as",["G5613"]],["the ministers",["G1249"]],["of God,",["G2316"]],["in",["G1722"]],["much",["G4183"]],["patience,",["G5281"]],["in",["G1722"]],["afflictions,",["G2347"]],["in",["G1722"]],["necessities,",["G318"]],["in",["G1722"]],["distresses,",["G4730"]]]},{"verse":5,"te