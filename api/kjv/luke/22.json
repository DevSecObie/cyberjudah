{"book":"Luke","chapter":22,"translation":"KJV","url":"/bible/luke/22","verses":[{"verse":1,"text":"Now the feast of unleavened bread drew nigh, which is called the Passover.","words":[["Now",["G1161"]],["the feast",["G1859"]],["of unleavened bread",["G106"]],["drew nigh,",["G1448"]],["which is called",["G3004"]],["the Passover.",[]]]},{"verse":2,"text":"And the chief priests and scribes sought how they might kill him; for they feared the people.","words":[["And",["G2532"]],["the chief priests",["G749"]],["and",["G2532"]],["scribes",["G1122"]],["sought",["G2212"]],["how",["G4459"]],["they might kill",["G337"]],["him;",["G846"]],["for",["G1063"]],["they feared",["G5399"]],["the people.",[]]]},{"verse":3,"text":"Then entered Satan into Judas surnamed Iscariot, being of the number of the twelve.","words":[["Then",["G1161"]],["entered",["G1525"]],["Satan",["G4567"]],["into",["G1519"]],["Judas",["G2455"]],["surnamed",["G1941"]],["Iscariot,",["G2469"]],["being",["G5607"]],["of",["G1537"]],["the number",["G706"]],["of the twelve.",[]]]},{"verse":4,"text":"And he went his way, and communed with the chief priests and captains, how he might betray him unto them.","words":[["And",["G2532"]],["he went his way,",["G565"]],["and communed with",["G4814"]],["the chief priests",["G749"]],["and",["G2532"]],["captains,",["G4755"]],["how",["G4459"]],["he might betray",["G3860"]],["him",["G846"]],["unto them.",[]]]},{"verse":5,"text":"And they were glad, and covenanted to give him money.","words":[["And",["G2532"]],["they were glad,",["G5463"]],["and",["G2532"]],["covenanted",["G4934"]],["to give",["G1325"]],["him",["G846"]],["money.",[]]]},{"verse":6,"text":"And he promised, and sought opportunity to betray him unto them in the absence of the multitude.","words":[["And",["G2532"]],["he promised,",["G1843"]],["and",["G2532"]],["sought",["G2212"]],["opportunity",["G2120"]],["to betray",["G3860"]],["him",["G846"]],["unto them",["G846"]],["in the absence",["G817"]],["of the multitude.",[]]]},{"verse":7,"text":"Then came the day of unleavened bread, when the passover must be killed.","words":[["Then",["G1161"]],["came",["G2064"]],["the day",["G2250"]],["of unleavened bread,",["G106"]],["when",["G1722","G3739"]],["the passover",["G3957"]],["must",["G1163"]],["be killed.",[]]]},{"verse":8,"text":"And he sent Peter and John, saying, Go and prepare us the passover, that we may eat.","words":[["And",["G2532"]],["he sent",["G649"]],["Peter",["G4074"]],["and",["G2532"]],["John,",["G2491"]],["saying,",["G2036"]],["Go",["G4198"]],["and prepare",["G2090"]],["us",["G2254"]],["the passover,",["G3957"]],["that",["G2443"]],["we may eat.",[]]]},{"verse":9,"text":"And they said unto him, Where wilt thou that we prepare?","words":[["And",["G1161"]],["they said",["G2036"]],["unto him,",["G846"]],["Where",["G4226"]],["wilt thou",["G2309"]],["that we prepare?",[]]]},{"verse":10,"text":"And he said unto them, Behold, when ye are entered into the city, there shall a man meet you, bearing a pitcher of water; follow him into the house where he entereth in.","words":[["And",["G1161"]],["he said",["G2036"]],["unto them,",["G846"]],["Behold,",["G2400"]],["when ye",["G5216"]],["are entered",["G1525"]],["into",["G1519"]],["the city,",["G4172"]],["there shall",["G4876"]],["a man",["G444"]],["meet",["G4876"]],["you,",["G5213"]],["bearing",["G941"]],["a pitcher",["G2765"]],["of water;",["G5204"]],["follow",["G190"]],["him",["G846"]],["into",["G1519"]],["the house",["G3614"]],["where",["G3757"]],["he entereth in.",[]]]},{"verse":11,"text":"And ye shall say unto the goodman of the house, The Master saith unto thee, Where is the guestchamber, where I shall eat the passover with my disciples?","words":[["And",["G2532"]],["ye shall say",["G2046"]],["unto the goodman",["G3617"]],["of the house,",["G3614"]],["The Master",["G1320"]],["saith",["G3004"]],["unto thee,",["G4671"]],["Where",["G4226"]],["is",["G2076"]],["the guestchamber,",["G2646"]],["where",["G3699"]],["I shall eat",["G5315"]],["the passover",["G3957"]],["with",["G3326"]],["my",["G3450"]],["disciples?",[]]]},{"verse":12,"text":"And he shall shew you a large upper room furnished: there make ready.","words":[["And",["G2548"]],["he shall shew",["G1166"]],["you",["G5213"]],["a large",["G3173"]],["upper room",["G508"]],["furnished:",["G4766"]],["there",["G1563"]],["make ready.",[]]]},{"verse":13,"text":"And they went, and found as he had said unto them: and they made ready the passover.","words":[["And",["G1161"]],["they went,",["G565"]],["and found",["G2147"]],["as",["G2531"]],["he had said",["G2046"]],["unto them:",["G846"]],["and",["G2532"]],["they made ready",["G2090"]],["the passover.",[]]]},{"verse":14,"text":"And when the hour was come, he sat down, and the twelve apostles with him.","words":[["And",["G2532"]],["when",["G3753"]],["the hour",["G5610"]],["was come,",["G1096"]],["he sat down,",["G377"]],["and",["G2532"]],["the twelve",["G1427"]],["apostles",["G652"]],["with",["G4862"]],["him.",[]]]},{"verse":15,"text":"And he said unto them, With desire I have desired to eat this passover with you before I suffer:","words":[["And",["G2532"]],["he said",["G2036"]],["unto",["G4314"]],["them,",["G846"]],["With desire",["G1939"]],["I have desired",["G1937"]],["to eat",["G5315"]],["this",["G5124"]],["passover",["G3957"]],["with",["G3326"]],["you",["G5216"]],["before",["G4253"]],["I",["G3165"]],["suffer:",[]]]},{"verse":16,"text":"For I say unto you, I will not any more eat thereof, until it be fulfilled in the kingdom of God.","words":[["For",["G1063"]],["I say",["G3004"]],["unto you,",["G5213","G3754"]],["I will",["G5315"]],["not",["G3765"]],["any more",["G3364"]],["eat",["G5315"]],["thereof,",["G846","G1537"]],["until",["G2193","G3755"]],["it be fulfilled",["G4137"]],["in",["G1722"]],["the kingdom",["G932"]],["of God.",[]]]},{"verse":17,"text":"And he took the cup, and gave thanks, and said, Take this, and divide it among yourselves:","words":[["And",["G2532"]],["he took",["G1209"]],["the cup,",["G4221"]],["and gave thanks,",["G2168"]],["and said,",["G2036"]],["Take",["G2983"]],["this,",["G5124"]],["and",["G2532"]],["divide",["G1266"]],["it among yourselves:",[]]]},{"verse":18,"text":"For I say unto you, I will not drink of the fruit of the vine, until the kingdom of God shall come.","words":[["For",["G1063"]],["I say",["G3004"]],["unto you,",["G5213","G3754"]],["I will",["G4095"]],["not",["G3364"]],["drink",["G4095"]],["of",["G575"]],["the fruit",["G1081"]],["of the vine,",["G288"]],["until",["G2193","G3755"]],["the kingdom",["G932"]],["of God",["G2316"]],["shall come.",[]]]},{"verse":19,"text":"And he took bread, and gave thanks, and brake it, and gave unto them, saying, This is my body which is given for you: this do in remembrance of me.","words":[["And",["G2532"]],["he took",["G2983"]],["bread,",["G740"]],["and gave thanks,",["G2168"]],["and brake",["G2806"]],["it, and",["G2532"]],["gave",["G1325"]],["unto them,",["G846"]],["saying,",["G3004"]],["This",["G5124"]],["is",["G2076"]],["my",["G3450"]],["body",["G4983"]],["which",["G3588"]],["is given",["G1325"]],["for",["G5228"]],["you:",["G5216"]],["this",["G5124"]],["do",["G4160"]],["in remembrance",["G364"]],["of",["G1519"]],["me.",[]]]},{"verse":20,"text":"Likewise also the cup after supper, saying, This cup is the new testament in my blood, which is shed for you.","words":[["Likewise",["G5615"]],["also",["G2532"]],["the cup",["G4221"]],["after",["G3326"]],["supper,",["G1172"]],["saying,",["G3004"]],["This",["G5124"]],["cup",["G4221"]],["is the new",["G2537"]],["testament",["G1242"]],["in",["G1722"]],["my",["G3450"]],["blood,",["G129"]],["which",["G3588"]],["is shed",["G1632"]],["for",["G5228"]],["you.",[]]]},{"verse":21,"text":"But, behold, the hand of him that betrayeth me is with me on the table.","words":[["But,",["G4133"]],["behold,",["G2400"]],["the hand",["G5495"]],["of him that betrayeth",["G3860"]],["me",["G3165"]],["is with",["G3326"]],["me",["G1700"]],["on",["G1909"]],["the table.",[]]]},{"verse":22,"text":"And truly the Son of man goeth, as it was determined: but woe unto that man by whom he is betrayed!","words":[["And",["G2532"]],["truly",["G3303"]],["the Son",["G5207"]],["of man",["G444"]],["goeth,",["G4198"]],["as",["G2596"]],["it was determined:",["G3724"]],["but",["G4133"]],["woe",["G3759"]],["unto that",["G1565"]],["man",["G444"]],["by",["G1223"]],["whom",["G3739"]],["he is betrayed!",[]]]},{"verse":23,"text":"And they began to enquire among themselves, which of them it was that should do this thing.","words":[["And",["G2532"]],["they",["G846"]],["began",["G756"]],["to enquire",["G4802"]],["among",["G4314"]],["themselves,",["G1438"]],["which",["G5101","G686"]],["of",["G1537"]],["them",["G846"]],["it was",["G1498"]],["that should",["G3195"]],["do",["G4238"]],["this thing.",[]]]},{"verse":24,"text":"And there was also a strife among them, which of them should be accounted the greatest.","words":[["And",["G1161"]],["there was",["G1096"]],["also",["G2532"]],["a strife",["G5379"]],["among",["G1722"]],["them,",["G846"]],["which",["G5101"]],["of them",["G846"]],["should be accounted",["G1380","G1511"]],["the greatest.",[]]]},{"verse":25,"text":"And he said unto them, The kings of the Gentiles exercise lordship over them; and they that exercise authority upon them are called benefactors.","words":[["And",["G1161"]],["he said",["G2036"]],["unto them,",["G846"]],["The kings",["G935"]],["of the Gentiles",["G1484"]],["exercise lordship over",["G2961"]],["them;",["G846"]],["and",["G2532"]],["they that exercise authority upon",["G1850"]],["them",["G846"]],["are called",["G2564"]],["benefactors.",[]]]},{"verse":26,"text":"But ye shall not be so: but he that is greatest among you, let him be as the younger; and he that is chief, as he that doth serve.","words":[["But",["G1161"]],["ye",["G5210"]],["shall not",["G3756"]],["be so:",["G3779"]],["but",["G235"]],["he that is greatest",["G3187"]],["among",["G1722"]],["you,",["G5213"]],["let him be",["G1096"]],["as",["G5613"]],["the younger;",["G3501"]],["and",["G2532"]],["he that is chief,",["G2233"]],["as",["G5613"]],["he that doth serve.",[]]]},{"verse":27,"text":"For whether is greater, he that sitteth at meat, or he that serveth? is not he that sitteth at meat? but I am among you as he that serveth.","words":[["For",["G1063"]],["whether",["G5101"]],["is greater,",["G3187"]],["he that sitteth at meat,",["G345"]],["or",["G2228"]],["he that serveth?",["G1247"]],["is not",["G3780"]],["he that sitteth at meat?",["G345"]],["but",["G1161"]],["I",["G1473"]],["am",["G1510"]],["among",["G1722","G3319"]],["you",["G5216"]],["as",["G5613"]],["he that serveth.",[]]]},{"verse":28,"text":"Ye are they which have continued with me in my temptations.","words":[["Ye",["G5210"]],["are",["G2075"]],["they which have continued",["G1265"]],["with",["G3326"]],["me",["G1700"]],["in",["G1722"]],["my",["G3450"]],["temptations.",[]]]},{"verse":29,"text":"And I appoint unto you a kingdom, as my Father hath appointed unto me;","words":[["And I",["G2504"]],["appoint",["G1303"]],["unto you",["G5213"]],["a kingdom,",["G932"]],["as",["G2531"]],["my",["G3450"]],["Father",["G3962"]],["hath appointed",["G1303"]],["unto me;",[]]]},{"verse":30,"text":"That ye may eat and drink at my table in my kingdom, and sit on thrones judging the twelve tribes of Israel.","words":[["That",["G2443"]],["ye may eat",["G2068"]],["and",["G2532"]],["drink",["G4095"]],["at",["G1909"]],["my",["G3450"]],["table",["G5132"]],["in",["G1722"]],["my",["G3450"]],["kingdom,",["G932"]],["and",["G2532"]],["sit",["G2523"]],["on",["G1909"]],["thrones",["G2362"]],["judging",["G2919"]],["the twelve",["G1427"]],["tribes",["G5443"]],["of Israel.",[]]]},{"verse":31,"text":"And the Lord said, Simon, Simon, behold, Satan hath desired to have you, that he may sift you as wheat:","words":[["And",["G1161"]],["the Lord",["G2962"]],["said,",["G2036"]],["Simon,",["G4613"]],["Simon,",["G4613"]],["behold,",["G2400"]],["Satan",["G4567"]],["hath desired",["G1809"]],["to have you,",["G5209"]],["that he may sift",["G4617"]],["you as",["G5613"]],["wheat:",[]]]},{"verse":32,"text":"But I have prayed for thee, that thy faith fail not: and when thou art converted, strengthen thy brethren.","words":[["But",["G1161"]],["I",["G1473"]],["have prayed",["G1189"]],["for",["G4012"]],["thee,",["G4675"]],["that",["G3363"]],["thy",["G4675"]],["faith",["G4102"]],["fail",["G1587"]],["not:",["G3363"]],["and",["G2532"]],["when",["G4218"]],["thou",["G4771"]],["art converted,",["G1994"]],["strengthen",["G4741"]],["thy",["G4675"]],["brethren.",[]]]},{"verse":33,"text":"And he said unto him, Lord, I am ready to go with thee, both into prison, and to death.","words":[["And",["G1161"]],["he said",["G2036"]],["unto him,",["G846"]],["Lord,",["G2962"]],["I am",["G1510"]],["ready",["G2092"]],["to go",["G4198"]],["with",["G3326"]],["thee,",["G4675"]],["both",["G2532"]],["into",["G1519"]],["prison,",["G5438"]],["and",["G2532"]],["to",["G1519"]],["death.",[]]]},{"verse":34,"text":"And he said, I tell thee, Peter, the cock shall not crow this day, before that thou shalt thrice deny that thou knowest me.","words":[["And",["G1161"]],["he said,",["G2036"]],["I tell",["G3004"]],["thee,",["G4671"]],["Peter,",["G4074"]],["the cock",["G220"]],["shall",["G5455"]],["not",["G3364"]],["crow",["G5455"]],["this day,",["G4594"]],["before that",["G4250"]],["thou shalt",["G2228"]],["thrice",["G5151"]],["deny",["G533"]],["that thou",["G3361"]],["knowest",["G1492"]],["me.",[]]]},{"verse":35,"text":"And he said unto them, When I sent you without purse, and scrip, and shoes, lacked ye any thing? And they said, Nothing.","words":[["And",["G2532"]],["he said",["G2036"]],["unto them,",["G846"]],["When",["G3753"]],["I sent",["G649"]],["you",["G5209"]],["without",["G817"]],["purse,",["G905"]],["and",["G2532"]],["scrip,",["G4082"]],["and",["G2532"]],["shoes,",["G5266","G3361"]],["lacked ye",["G5302"]],["any thing?",["G5100"]],["And",["G1161"]],["they said,",["G2036"]],["Nothing.",[]]]},{"verse":36,"text":"Then said he unto them, But now, he that hath a purse, let him take it, and likewise his scrip: and he that hath no sword, let him sell his garment, and buy one.","words":[["Then",["G3767"]],["said he",["G2036"]],["unto them,",["G846"]],["But",["G235"]],["now,",["G3568"]],["he that hath",["G2192"]],["a purse,",["G905"]],["let him take",["G142"]],["it, and",["G2532"]],["likewise",["G3668"]],["his scrip:",["G4082"]],["and",["G2532"]],["he that hath",["G2192"]],["no",["G3361"]],["sword,",["G3162"]],["let him sell",["G4453"]],["his",["G846"]],["garment,",["G2440"]],["and",["G2532"]],["buy one.",[]]]},{"verse":37,"text":"For I say unto you, that this that is written must yet be accomplished in me, And he was reckoned among the transgressors: for the things concerning me have an end.","words":[["For",["G1063"]],["I say",["G3004"]],["unto you,",["G5213"]],["that",["G3754"]],["this",["G5124"]],["that is written",["G1125"]],["must",["G1163"]],["yet",["G2089"]],["be accomplished",["G5055"]],["in",["G1722"]],["me,",["G1698"]],["And",["G2532"]],["he was reckoned",["G3049"]],["among",["G3326"]],["the transgressors:",["G459"]],["for",["G2532","G1063"]],["the things concerning",["G4012"]],["me",["G1700"]],["have",["G2192"]],["an end.",[]]]},{"verse":38,"text":"And they said, Lord, behold, here are two swords. And he said unto them, It is enough.","words":[["And",["G1161"]],["they said,",["G2036"]],["Lord,",["G2962"]],["behold,",["G2400"]],["here",["G5602"]],["are two",["G1417"]],["swords.",["G3162"]],["And",["G1161"]],["he said",["G2036"]],["unto them,",["G846"]],["It is",["G2076"]],["enough.",[]]]},{"verse":39,"text":"And he came out, and went, as he was wont, to the mount of Olives; and his disciples also followed him.","words":[["And",["G2532"]],["he came out,",["G1831"]],["and went,",["G4198"]],["as",["G2596"]],["he was wont,",["G1485"]],["to",["G1519"]],["the mount",["G3735"]],["of Olives;",["G1636"]],["and",["G1161"]],["his",["G846"]],["disciples",[