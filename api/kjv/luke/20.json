{"book":"Luke","chapter":20,"translation":"KJV","url":"/bible/luke/20","verses":[{"verse":1,"text":"And it came to pass, that on one of those days, as he taught the people in the temple, and preached the gospel, the chief priests and the scribes came upon him with the elders,","words":[["And",["G2532"]],["it came to pass,",["G1096"]],["that on",["G1722"]],["one",["G3391"]],["of those",["G1565"]],["days,",["G2250"]],["as he",["G846"]],["taught",["G1321"]],["the people",["G2992"]],["in",["G1722"]],["the temple,",["G2411"]],["and",["G2532"]],["preached the gospel,",["G2097"]],["the chief priests",["G749"]],["and",["G2532"]],["the scribes",["G1122"]],["came upon",["G2186"]],["him with",["G4862"]],["the elders,",[]]]},{"verse":2,"text":"And spake unto him, saying, Tell us, by what authority doest thou these things? or who is he that gave thee this authority?","words":[["And",["G2532"]],["spake",["G2036"]],["unto",["G4314"]],["him,",["G846"]],["saying,",["G3004"]],["Tell",["G2036"]],["us,",["G2254"]],["by",["G1722"]],["what",["G4169"]],["authority",["G1849"]],["doest thou",["G4160"]],["these things?",["G5023"]],["or",["G2228"]],["who",["G5101"]],["is he",["G2076"]],["that gave",["G1325"]],["thee",["G4671"]],["this",["G5026"]],["authority?",[]]]},{"verse":3,"text":"And he answered and said unto them, I will also ask you one thing; and answer me:","words":[["And",["G1161"]],["he answered",["G611"]],["and said",["G2036"]],["unto",["G4314"]],["them,",["G846"]],["I",["G2504"]],["will",["G2065"]],["also",["G2504"]],["ask",["G2065"]],["you",["G5209"]],["one",["G1520"]],["thing;",["G3056"]],["and",["G2532"]],["answer",["G2036"]],["me:",[]]]},{"verse":4,"text":"The baptism of John, was it from heaven, or of men?","words":[["The baptism",["G908"]],["of John,",["G2491"]],["was it",["G2258"]],["from",["G1537"]],["heaven,",["G3772"]],["or",["G2228"]],["of",["G1537"]],["men?",[]]]},{"verse":5,"text":"And they reasoned with themselves, saying, If we shall say, From heaven; he will say, Why then believed ye him not?","words":[["And",["G1161"]],["they reasoned",["G4817"]],["with",["G4314"]],["themselves,",["G1438"]],["saying,",["G3004","G3754"]],["If",["G1437"]],["we shall say,",["G2036"]],["From",["G1537"]],["heaven;",["G3772"]],["he will say,",["G2046"]],["Why",["G1302"]],["then",["G3767"]],["believed ye",["G4100"]],["him",["G846"]],["not?",[]]]},{"verse":6,"text":"But and if we say, Of men; all the people will stone us: for they be persuaded that John was a prophet.","words":[["But and",["G1161"]],["if",["G1437"]],["we say,",["G2036"]],["Of",["G1537"]],["men;",["G444"]],["all",["G3956"]],["the people",["G2992"]],["will stone",["G2642"]],["us:",["G2248"]],["for",["G1063"]],["they be",["G2076"]],["persuaded",["G3982"]],["that John",["G2491"]],["was",["G1511"]],["a prophet.",[]]]},{"verse":7,"text":"And they answered, that they could not tell whence it was.","words":[["And",["G2532"]],["they answered,",["G611"]],["that they could",["G1492"]],["not",["G3361"]],["tell",["G1492"]],["whence it was.",[]]]},{"verse":8,"text":"And Jesus said unto them, Neither tell I you by what authority I do these things.","words":[["And",["G2532"]],["Jesus",["G2424"]],["said",["G2036"]],["unto them,",["G846"]],["Neither",["G3761"]],["tell",["G3004"]],["I",["G1473"]],["you",["G5213"]],["by",["G1722"]],["what",["G4169"]],["authority",["G1849"]],["I do",["G4160"]],["these things.",[]]]},{"verse":9,"text":"Then began he to speak to the people this parable; A certain man planted a vineyard, and let it forth to husbandmen, and went into a far country for a long time.","words":[["Then",["G1161"]],["began he",["G756"]],["to speak",["G3004"]],["to",["G4314"]],["the people",["G2992"]],["this",["G5026"]],["parable;",["G3850"]],["A certain",["G5100"]],["man",["G444"]],["planted",["G5452"]],["a vineyard,",["G290"]],["and",["G2532"]],["let",["G1554"]],["it",["G846"]],["forth",["G1554"]],["to husbandmen,",["G1092"]],["and",["G2532"]],["went into a far country",["G589"]],["for a long",["G2425"]],["time.",[]]]},{"verse":10,"text":"And at the season he sent a servant to the husbandmen, that they should give him of the fruit of the vineyard: but the husbandmen beat him, and sent him away empty.","words":[["And",["G2532"]],["at",["G1722"]],["the season",["G2540"]],["he sent",["G649"]],["a servant",["G1401"]],["to",["G4314"]],["the husbandmen,",["G1092"]],["that",["G2443"]],["they should give",["G1325"]],["him",["G846"]],["of",["G575"]],["the fruit",["G2590"]],["of the vineyard:",["G290"]],["but",["G1161"]],["the husbandmen",["G1092"]],["beat",["G1194"]],["him,",["G846"]],["and sent him away",["G1821"]],["empty.",[]]]},{"verse":11,"text":"And again he sent another servant: and they beat him also, and entreated him shamefully, and sent him away empty.","words":[["And",["G2532"]],["again",["G4369"]],["he sent",["G3992"]],["another",["G2087"]],["servant:",["G1401"]],["and",["G1161"]],["they beat",["G1194"]],["him also,",["G2548"]],["and",["G2532"]],["entreated him shamefully,",["G818"]],["and sent him away",["G1821"]],["empty.",[]]]},{"verse":12,"text":"And again he sent a third: and they wounded him also, and cast him out.","words":[["And",["G2532"]],["again",["G4369"]],["he sent",["G3992"]],["a third:",["G5154"]],["and",["G1161"]],["they wounded",["G5135"]],["him",["G5126"]],["also,",["G2532"]],["and cast him out.",[]]]},{"verse":13,"text":"Then said the lord of the vineyard, What shall I do? I will send my beloved son: it may be they will reverence him when they see him.","words":[["Then",["G1161"]],["said",["G2036"]],["the lord",["G2962"]],["of the vineyard,",["G290"]],["What",["G5101"]],["shall I do?",["G4160"]],["I will send",["G3992"]],["my",["G3450"]],["beloved",["G27"]],["son:",["G5207"]],["it may be",["G2481"]],["they will reverence",["G1788"]],["him when they see",["G1492"]],["him.",[]]]},{"verse":14,"text":"But when the husbandmen saw him, they reasoned among themselves, saying, This is the heir: come, let us kill him, that the inheritance may be ours.","words":[["But",["G1161"]],["when the husbandmen",["G1092"]],["saw",["G1492"]],["him,",["G846"]],["they reasoned",["G1260"]],["among",["G4314"]],["themselves,",["G1438"]],["saying,",["G3004"]],["This",["G3778"]],["is",["G2076"]],["the heir:",["G2818"]],["come,",["G1205"]],["let us kill",["G615"]],["him,",["G846"]],["that",["G2443"]],["the inheritance",["G2817"]],["may be",["G1096"]],["ours.",[]]]},{"verse":15,"text":"So they cast him out of the vineyard, and killed him. What therefore shall the lord of the vineyard do unto them?","words":[["So",["G2532"]],["they cast",["G1544"]],["him",["G846"]],["out of",["G1854"]],["the vineyard,",["G290"]],["and killed",["G615"]],["him. What",["G5101"]],["therefore",["G3767"]],["shall",["G4160"]],["the lord",["G2962"]],["of the vineyard",["G290"]],["do",["G4160"]],["unto them?",[]]]},{"verse":16,"text":"He shall come and destroy these husbandmen, and shall give the vineyard to others. And when they heard it, they said, God forbid.","words":[["He shall come",["G2064"]],["and",["G2532"]],["destroy",["G622"]],["these",["G5128"]],["husbandmen,",["G1092"]],["and",["G2532"]],["shall give",["G1325"]],["the vineyard",["G290"]],["to others.",["G243"]],["And",["G1161"]],["when they heard",["G191"]],["it, they said,",["G2036"]],["God forbid.",["G3361"]]]},{"verse":17,"text":"And he beheld them, and said, What is this then that is written, The stone which the builders rejected, the same is become the head of the corner?","words":[["And",["G1161"]],["he beheld",["G1689"]],["them,",["G846"]],["and said,",["G2036"]],["What",["G5101"]],["is",["G2076"]],["this",["G5124"]],["then",["G3767"]],["that is written,",["G1125"]],["The stone",["G3037"]],["which",["G3739"]],["the builders",["G3618"]],["rejected,",["G593"]],["the same",["G3778"]],["is become",["G1096"]],["the head",["G2776"]],["of",["G1519"]],["the corner?",[]]]},{"verse":18,"text":"Whosoever shall fall upon that stone shall be broken; but on whomsoever it shall fall, it will grind him to powder.","words":[["Whosoever",["G3956"]],["shall fall",["G4098"]],["upon",["G1909"]],["that",["G1565"]],["stone",["G3037"]],["shall be broken;",["G4917"]],["but",["G1161"]],["on",["G1909"]],["whomsoever",["G3739","G302"]],["it shall fall,",["G4098"]],["it will grind",["G3039"]],["him",["G846"]],["to powder.",[]]]},{"verse":19,"text":"And the chief priests and the scribes the same hour sought to lay hands on him; and they feared the people: for they perceived that he had spoken this parable against them.","words":[["And",["G2532"]],["the chief priests",["G749"]],["and",["G2532"]],["the scribes",["G1122"]],["the same",["G1722","G846"]],["hour",["G5610"]],["sought",["G2212"]],["to lay",["G1911"]],["hands",["G5495"]],["on",["G1909"]],["him;",["G846"]],["and",["G2532"]],["they feared",["G5399"]],["the people:",["G2992"]],["for",["G1063"]],["they perceived",["G1097"]],["that",["G3754"]],["he had spoken",["G2036"]],["this",["G5026"]],["parable",["G3850"]],["against",["G4314"]],["them.",[]]]},{"verse":20,"text":"And they watched him, and sent forth spies, which should feign themselves just men, that they might take hold of his words, that so they might deliver him unto the power and authority of the governor.","words":[["And",["G2532"]],["they watched",["G3906"]],["him, and sent forth",["G649"]],["spies,",["G1455"]],["which should feign",["G5271","G1511"]],["themselves",["G1438"]],["just men,",["G1342"]],["that",["G2443"]],["they might take hold",["G1949"]],["of his",["G846"]],["words,",["G3056"]],["that so",["G1519"]],["they might deliver",["G3860"]],["him",["G846"]],["unto the power",["G746"]],["and",["G2532"]],["authority",["G1849"]],["of the governor.",[]]]},{"verse":21,"text":"And they asked him, saying, Master, we know that thou sayest and teachest rightly, neither acceptest thou the person of any, but teachest the way of God truly:","words":[["And",["G2532"]],["they asked",["G1905"]],["him,",["G846"]],["saying,",["G3004"]],["Master,",["G1320"]],["we know",["G1492"]],["that",["G3754"]],["thou sayest",["G3004"]],["and",["G2532"]],["teachest",["G1321"]],["rightly,",["G3723","G2532"]],["neither",["G3756"]],["acceptest thou",["G2983"]],["the person",["G4383"]],["of any, but",["G235"]],["teachest",["G1321"]],["the way",["G3598"]],["of God",["G2316"]],["truly:",["G225"]]]},{"verse":22,"text":"Is it lawful for us to give tribute unto Cesar, or no?","words":[["Is it lawful",["G1832"]],["for us",["G2254"]],["to give",["G1325"]],["tribute",["G5411"]],["unto Cesar,",["G2541"]],["or",["G2228"]],["no?",[]]]},{"verse":23,"text":"But he perceived their craftiness, and said unto them, Why tempt ye me?","words":[["But",["G1161"]],["he perceived",["G2657"]],["their",["G846"]],["craftiness,",["G3834"]],["and said",["G2036"]],["unto",["G4314"]],["them,",["G846"]],["Why",["G5101"]],["tempt ye",["G3985"]],["me?",[]]]},{"verse":24,"text":"Shew me a penny. Whose image and superscription hath it? They answered and said, Cesar’s.","words":[["Shew",["G1925"]],["me",["G3427"]],["a penny.",["G1220"]],["Whose",["G5101"]],["image",["G1504"]],["and",["G2532"]],["superscription",["G1923"]],["hath it?",["G2192"]],["They answered",["G611"]],["and",["G1161"]],["said,",["G2036"]],["Cesar’s.",[]]]},{"verse":25,"text":"And he said unto them, Render therefore unto Cesar the things which be Cesar’s, and unto God the things which be God’s.","words":[["And",["G1161"]],["he said",["G2036"]],["unto them,",["G846"]],["Render",["G591"]],["therefore",["G5106"]],["unto Cesar",["G2541"]],["the things which be",["G3588"]],["Cesar’s, and",["G2532"]],["unto God",["G2316"]],["the things which be",["G3588"]],["God’s.",[]]]},{"verse":26,"text":"And they could not take hold of his words before the people: and they marvelled at his answer, and held their peace.","words":[["And",["G2532"]],["they could",["G2480"]],["not",["G3756"]],["take hold",["G1949"]],["of his",["G846"]],["words",["G4487"]],["before",["G1726"]],["the people:",["G2992"]],["and",["G2532"]],["they marvelled",["G2296"]],["at",["G1909"]],["his",["G846"]],["answer,",["G612"]],["and held their peace.",[]]]},{"verse":27,"text":"Then came to him certain of the Sadducees, which deny that there is any resurrection; and they asked him,","words":[["Then",["G1161"]],["came",["G4334"]],["to him certain",["G5100"]],["of the Sadducees,",["G4523"]],["which",["G3588"]],["deny",["G483"]],["that there is",["G1511"]],["any",["G3361"]],["resurrection;",["G386"]],["and they asked",["G1905"]],["him,",[]]]},{"verse":28,"text":"Saying, Master, Moses wrote unto us, If any man’s brother die, having a wife, and he die without children, that his brother should take his wife, and raise up seed unto his brother.","words":[["Saying,",["G3004"]],["Master,",["G1320"]],["Moses",["G3475"]],["wrote",["G1125"]],["unto us,",["G2254"]],["If",["G1437"]],["any man’s brother",["G80"]],["die,",["G599"]],["having",["G2192"]],["a wife,",["G1135"]],["and",["G2532"]],["he",["G3778"]],["die",["G599"]],["without children,",["G815"]],["that",["G2443"]],["his",["G846"]],["brother",["G80"]],["should take",["G2983"]],["his wife,",["G1135"]],["and",["G2532"]],["raise up",["G1817"]],["seed",["G4690"]],["unto his",["G846"]],["brother.",[]]]},{"verse":29,"text":"There were therefore seven brethren: and the first took a wife, and died without children.","words":[["There were",["G2258"]],["therefore",["G3767"]],["seven",["G2033"]],["brethren:",["G80"]],["and",["G2532"]],["the first",["G4413"]],["took",["G2983"]],["a wife,",["G1135"]],["and died",["G599"]],["without children.",[]]]},{"verse":30,"text":"And the second took her to wife, and he died childless.","words":[["And",["G2532"]],["the second",["G1208"]],["took",["G2983"]],["her to wife,",["G1135"]],["and",["G2532"]],["he",["G3778"]],["died",["G599"]],["childless.",[]]]},{"verse":31,"text":"And the third took her; and in like manner the seven also: and they left no children, and died.","words":[["And",["G2532"]],["the third",["G5154"]],["took",["G2983"]],["her;",["G846"]],["and",["G1161"]],["in like manner",["G5615"]],["the seven",["G2033"]],["also:",["G2532"]],["and they left",["G2641"]],["no",["G3756"]],["children,",["G5043"]],["and",["G2532"]],["died.",[]]]},{"verse":32,"text":"Last of all the woman died also.","words":[["Last",["G5305"]],["of all",["G3956"]],["the woman",["G1135"]],["died",["G599"]],["also.",[]]]},{"verse":33,"text":"Therefore in the resurrection whose wife of them is she? for seven had her to wife.","words":[["Therefore",["G3767"]],["in",["G1722"]],["the resurrection",["G386"]],["whose",["G5101"]],["wife",["G1135"]],["of them",["G846"]],["is she?",["G1096"]],["for",["G1063"]],["seven",["G2033"]],["had",["G2192"]],["her",["G846"]],["to wife.",[]]]},{"verse":34,"text":"And Jesus answering said unto them, The children of this world marry, and are given in marriage:","words":[["And",["G2532"]],["Jesus",["G2424"]],["answering",["G611"]],["said",["G2036"]],["unto them,",["G846"]],["The children",["G5207"]],["of this",["G5127"]],["world",["G165"]],["marry,",["G1060"]],["and",["G2532"]],["are given in marriage:",[]]]},{"verse":35,"text":"But they which shall be accounted worthy to obtain that world, and the resurrection from the dead, neither marry, nor are given in marriage:","words":[["But",["G1161"]],["they which shall be accounted worthy",["G2661"]],["to obtain",["G5177"]],["that",["G1565"]],["world,",["G165"]],["and",["G2532"]],["the resurrection",["G386"]],["from",["G1537"]],["the dead,",["G3498"]],["neither",["G3777"]],["marry,",["G1060"]],["nor",["G3777"]],["are given in marriage:",[]]]},{"verse":36,"text":"Neither can they die any more: for they are equal unto the angels; and are the children of God, being the children of the resurrection.","words":[["Neither",["G3777","G1063"]],["can",["G1410"]],["they die",["G599"]],["any more:",["G2089"]],["for",["G1063"]],["they are",["G1526"]],["equal unto the angels;",["G2465"]],["and",["G2532"]],["are",["G1526"]],["the children",["G5207"]],["of God,",["G2316"]],["being",["G5607"]],["the children",["G5207"]],["of the resurrection.",[]]]},{"verse":37,"text":"Now that the dead are raised, even Moses shewed at the bush, when he calleth the Lord the God of Abraham, and the God of Isaac, and the God of Jacob.","words":[["Now",["G1161"]],["that",["G3754"]],["the dead",["G3498"]],["are raised,",["G1453"]],["even",["G2532"]],["Moses",["G3475"]],["shewed",["G3377"]],["at",["G1909"]],["the bush,",["G942"]],["when",["G5613"]],["he calleth",["G3004"]],["the Lord",["G2962"]],["the God",["G2316"]],["of Abraham,",["G11"]],["and",["G2532"]],["the God",["G2316"]],["of Isaac,",["G2464"]],["and",["G2532"]],["the God",["G2316"]],["of Jacob.",[]]]},{"verse":38,"text":"For he is not a God of the dead, but of the living: for all live unto him.","words":[["For",["G1161"]],["he is",["G2076"]],["not",["G3756"]],["a God",["G2316"]],["of the dead,",["G3498"]],["but",["G235"]],["of the living:",["G2198"]],["for",["G1063"]],["all",["G3956"]],["live",["G2198"]],["unto him.",[]]]},{"verse":39,"text":"Then certain of the scribes answering said, Master, thou hast well said.","words":[["Then",["G1161"]],["certain",["G5100"]],["of the scribes",["G1122"]],["answering",["G611"]],["said,",["G2036"]],["Master,",["G1320"]],["thou hast well",["G2573"]],["said.",[]]]},{"verse":40,"text":"And after that they durst not ask him any question at all.","words":[["And",["G1161"]],["after that",["G3765"]],["they durst",["G5111"]],["not",["G3765"]],["ask",["G1905"]],["him",["G846"]],["any question at all.",[]]]},{"verse":41,"text":"And he said unto them, How say they that Christ is David’s son?","words":[["And",["G1161"]],["he said",["G2036"]],["unto",["G4314"]],["them,",["G846"]],["How",["G4459"]],["say",["G3004"]],["they that Christ",["G5547"]],["is",["G1511"]],["David’s son?",[]]]},{"verse":42,"text":"And David himself saith in the book of Psalms, The Lord said unto my Lord, Sit thou on my right hand,","words":[["And",["G2532"]],["David",["G1138"]],["himself",["G846"]],["saith",["G3004"]],["in",["G1722"]],["the book",["G976"]],["of Psalms,",["G5568"]],["The Lord",["G2962"]],["said",["G2036"]],["unto my",["G3450"]],["Lord,",["G2962"]],["Sit thou",["G2521"]],["on",["G1537"]],["my",["G3450"]],["right hand,",[]]]},{"verse":43,"text":"Till I make thine enemies thy footstool.","words":[["Till",["G2193","G302"]],["I make",["G5087"]],["thine",["G4675"]],["enemies",["G2190"]],["thy",["G4675"]],["footstool.",["G4228"]]]},{"verse":44,"text":"David therefore calleth him Lord, how is he then his son?","words":[["David",["G1138"]],["therefore",["G3767"]],["calleth",["G2564"]],["him",["G846"]],["Lord,",["G2962"]],["how",["G4459"]],["is he",["G2076"]],["then",["G2532"]],["his",["G846"]],["son?",[]]]},{"verse":45,"text":"Then in the audience of all the people he said unto his disciples,","words":[["Then",["G1161"]],["in the audience",["G191"]],["of all",["G3956"]],["the people",["G2992"]],["he said",["G2036"]],["unto his",["G846"]],["disciples,",[]]]},{"verse":46,"text":"Beware of the scribes, which desire to walk in long robes, and love greetings in the markets, and the highest seats in the synagogues, and the chief rooms at feasts;","words":[["Beware",["G4337"]],["of",["G575"]],["the scribes,",["G1122"]],["which",["G3588"]],["desire",["G2309"]],["to walk",["G4043"]],["in",["G1722"]],["long robes,",["G4749"]],["and",["G2532"]],["love",["G5368"]],["greetings",["G783"]],["in",["G1722"]],["the markets,",["G58"]],["and",["G2532"]],["the highest seats",["G4410"]],["in",["G1722"]],["the synagogues,",["G4864"]],["and",["G2532"]],["the chief rooms",["G4411"]],["at",["G1722"]],["feasts;",[]]]},{"verse":47,"text":"Which devour widows’ houses, and for a shew make long prayers: the same shall receive greater damnation.","words":[["Which",["G3739"]],["devour",["G2719"]],["widows’",["G5503"]],["houses,",["G3614"]],["and",["G2532"]],["for a shew",["G4392"]],["make",["G4336"]],["long",["G3117"]],["prayers:",["G4336"]],["the same",["G3778"]],["shall receive",["G2983"]],["g