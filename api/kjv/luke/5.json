,["infirmities.",[]]]},{"verse":16,"text":"And he withdrew himself into the wilderness, and prayed.","words":[["And",["G1161"]],["he withdrew",["G2258","G5298"]],["himself",["G846"]],["into",["G1722"]],["the wilderness,",["G2048"]],["and",["G2532"]],["prayed.",[]]]},{"verse":17,"text":"And it came to pass on a certain day, as he was teaching, that there were Pharisees and doctors of the law sitting by, which were come out of every town of Galilee, and Judea, and Jerusalem: and the power of the Lord was present to heal them.","words":[["And",["G2532"]],["it came to pass",["G1096"]],["on",["G1722"]],["a certain",["G3391"]],["day,",["G2250"]],["as",["G2532"]],["he",["G846"]],["was",["G2258"]],["teaching,",["G1321"]],["that",["G2532"]],["there were",["G2258"]],["Pharisees",["G5330"]],["and",["G2532"]],["doctors of the law",["G3547"]],["sitting by,",["G2521"]],["which",["G3739"]],["were",["G2258"]],["come",["G2064"]],["out of",["G1537"]],["every",["G3956"]],["town",["G2968"]],["of Galilee,",["G1056"]],["and",["G2532"]],["Judea,",["G2449"]],["and",["G2532"]],["Jerusalem:",["G2419"]],["and",["G2532"]],["the power",["G1411"]],["of the Lord",["G2962"]],["was",["G2258"]],["present to",["G1519"]],["heal",["G2390"]],["them.",[]]]},{"verse":18,"text":"And, behold, men brought in a bed a man which was taken with a palsy: and they sought means to bring him in, and to lay him before him.","words":[["And,",["G2532"]],["behold,",["G2400"]],["men",["G435"]],["brought",["G5342"]],["in",["G1909"]],["a bed",["G2825"]],["a man",["G444"]],["which",["G3739"]],["was",["G2258"]],["taken with a palsy:",["G3886"]],["and",["G2532"]],["they sought",["G2212"]],["means to bring",["G1533"]],["him",["G846"]],["in,",["G1533"]],["and",["G2532"]],["to lay",["G5087"]],["him before",["G1799"]],["him.",[]]]},{"verse":19,"text":"And when they could not find by what way they might bring him in because of the multitude, they went upon the housetop, and let him down through the tiling with his couch into the m