ll.","words":[["They did eat,",["G2068"]],["they drank,",["G4095"]],["they married wives,",["G1060"]],["they were given in marriage,",["G1547"]],["until",["G891"]],["the day",["G2250"]],["that",["G3739"]],["Noe",["G3575"]],["entered",["G1525"]],["into",["G1519"]],["the ark,",["G2787"]],["and",["G2532"]],["the flood",["G2627"]],["came,",["G2064"]],["and",["G2532"]],["destroyed",["G622"]],["them all.",[]]]},{"verse":28,"text":"Likewise also as it was in the days of Lot; they did eat, they drank, they bought, they sold, they planted, they builded;","words":[["Likewise",["G3668"]],["also",["G2532"]],["as",["G5613"]],["it was",["G1096"]],["in",["G1722"]],["the days",["G2250"]],["of Lot;",["G3091"]],["they did eat,",["G2068"]],["they drank,",["G4095"]],["they bought,",["G59"]],["they sold,",["G4453"]],["they planted,",["G5452"]],["they builded;",[]]]},{"verse":29,"text":"But the same day that Lot went out of Sodom it rained fire and brimstone from heaven, and destroyed them all.","words":[["But",["G3739","G1161"]],["the same day",["G2250"]],["that Lot",["G3091"]],["went",["G1831"]],["out of",["G575"]],["Sodom",["G4670"]],["it rained",["G1026"]],["fire",["G4442"]],["and",["G2532"]],["brimstone",["G2303"]],["from",["G575"]],["heaven,",["G3772"]],["and",["G2532"]],["destroyed",["G622"]],["them all.",[]]]},{"verse":30,"text":"Even thus shall it be in the day when the Son of man is revealed.","words":[["Even",["G2596"]],["thus",["G5024"]],["shall it be",["G2071"]],["in the day",["G3739","G2250"]],["when the Son",["G5207"]],["of man",["G444"]],["is revealed.",[]]]},{"verse":31,"text":"In that day, he which shall be upon the housetop, and his stuff in the house, let him not come down to take it away: and he that is in the field, let him likewise not return back.","words":[["In",["G1722"]],["that",["G1565"]],["day,",["G2250"]],["he which",["G3739"]],["shall be",["G2071"]],["upon",["G1909"]],["the housetop,",["G1430"]],["and",["G2532"]],["his",["G846"]],["stuff",["G4632"]],["in",["G1722"]],["the house,",["G3614"]],["let",["G2597"]],["him not",["G3361"]],["come down",["G2597"]],["to take",["G142"]],["it",["G846"]],["away:",["G142"]],["and",["G2532"]],["he that is in",["G1722"]],["the field,",["G68"]],["let him",["G1994"]],["likewise",["G3668"]],["not",["G3361"]],["return",["G1994"]],["back.",["G1519"]]]},{"verse":32,"text":"Remember Lot’s wife.","words":[["Remember",["G3421"]],["Lot’s wife.",[]]]},{"verse":33,"text":"Whosoever shall seek to save his life shall lose it; and whosoever shall lose his life shall preserve it.","words":[["Whosoever",["G3739","G1437"]],["shall seek",["G2212"]],["to save",["G4982"]],["his",["G846"]],["life",["G5590"]],["shall lose",["G622"]],["it;",["G846"]],["and",["G2532"]],["whosoever",["G3739","G1437"]],["shall lose",["G622"]],["his",["G846"]],["life shall preserve",["G2225"]],["it.",[]]]},{"verse":34,"text":"I tell you, in that night there shall be two men in one bed; the one shall be taken, and the other shall be left.","words":[["I tell",["G3004"]],["you,",["G5213"]],["in that",["G5026"]],["night",["G3571"]],["there shall be",["G2071"]],["two",["G1417"]],["men in",["G1909"]],["one",["G3391"]],["bed;",["G2825"]],["the one",["G1520"]],["shall be taken,",["G3880"]],["and",["G2532"]],["the other",["G2087"]],["shall be left.",[]]]},{"verse":35,"text":"Two women shall be grinding together; the one shall be taken, and the other left.","words":[["Two",["G1417"]],["women shall be",["G2071"]],["grinding",["G229"]],["together;",["G846","G1909"]],["the one",["G3391"]],["shall be taken,",["G3880"]],["and",["G2532"]],["the other",["G2087"]],["left.",[]]]},{"verse":36,"text":"Two men shall be in the field; the one shall be taken, and the other left.","words":[["Two",["G1417"]],["men shall be",["G2071"]],["in",["G1722"]],["the field;",["G68"]],["the one",["G1520"]],["shall be taken,",["G3880"]],["and",["G2532"]],["the other",["G2087"]],["left.",[]]]},{"verse":37,"text":"And they answered and said unto him, Where, Lord? And he