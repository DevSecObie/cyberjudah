]],["which",["G3739"]],["stood",["G2476"]],["afar off:",[]]]},{"verse":13,"text":"And they lifted up their voices, and said, Jesus, Master, have mercy on us.","words":[["And",["G2532"]],["they",["G846"]],["lifted up",["G142"]],["their voices,",["G5456"]],["and said,",["G3004"]],["Jesus,",["G2424"]],["Master,",["G1988"]],["have mercy",["G1653"]],["on us.",[]]]},{"verse":14,"text":"And when he saw them, he said unto them, Go shew yourselves unto the priests. And it came to pass, that, as they went, they were cleansed.","words":[["And",["G2532"]],["when he saw",["G1492"]],["them, he said",["G2036"]],["unto them,",["G846"]],["Go",["G4198"]],["shew",["G1925"]],["yourselves",["G1438"]],["unto the priests.",["G2409"]],["And",["G2532"]],["it came to pass,",["G1096"]],["that, as they",["G846"]],["went,",["G5217","G1722"]],["they were cleansed.",[]]]},{"verse":15,"text":"And one of them, when he saw that he was healed, turned back, and with a loud voice glorified God,","words":[["And",["G1161"]],["one",["G1520"]],["of",["G1537"]],["them,",["G846"]],["when he saw",["G1492"]],["that",["G3754"]],["he was healed,",["G2390"]],["turned back,",["G5290"]],["and with",["G3326"]],["a loud",["G3173"]],["voice",["G5456"]],["glorified",["G1392"]],["God,",[]]]},{"verse":16,"text":"And fell down on his face at his feet, giving him thanks: and he was a Samaritan.","words":[["And",["G2532"]],["fell down",["G4098"]],["on",["G1909"]],["his face",["G4383"]],["at",["G3844"]],["his",["G846"]],["feet,",["G4228"]],["giving",["G2168"]],["him",["G846"]],["thanks:",["G2168"]],["and",["G2532"]],["he",["G846"]],["was",["G2258"]],["a Samaritan.",[]]]},{"verse":17,"text":"And Jesus answering said, Were there not ten cleansed? but where are the nine?","words":[["And",["G1161"]],["Jesus",["G2424"]],["answering",["G611"]],["said,",["G2036"]],["Were there",["G2511"]],["not",["G3780"]],["ten",["G1176"]],["cleansed?",["G2511"]],["but",["G1161"]],["where",["G4226"]],["are the nine?",[]]]},{"verse":18,"text":"There are not found that returned to give glory to God, save this stranger.","words":[["There are",["G2147"]],["not",["G3756"]],["found",["G2147"]],["that returned",["G5290"]],["to give",["G1325"]],["glory",["G1391"]],["to God,",["G2316"]],["save",["G1508"]],["this",["G3778"]],["stranger.",[]]]},{"verse":19,"text":"And he said unto him, Arise, go thy way: thy faith hath made thee whole.","words":[["And",["G2532"]],["he said",["G2036"]],["unto him,",["G846"]],["Arise,",["G450"]],["go thy way:",["G4198"]],["thy",["G4675"]],["faith",["G4102"]],["hath made",["G4982"]],["thee",["G4571"]],["whole.",[]]]},{"verse":20,"text":"And when he was demanded of the Pharisees, when the kingdom of God should come, he answered them and said, The kingdom of God cometh not with observation:","words":[["And",["G1161"]],["when he was demanded",["G1905"]],["of",["G5259"]],["the Pharisees,",["G5330"]],["when",["G4219"]],["the kingdom",["G932"]],["of God",["G2316"]],["should come,",["G2064"]],["he answered",["G611"]],["them",["G846"]],["and",["G2532"]],["said,",["G2036"]],["The kingdom",["G932"]],["of God",["G2316"]],["cometh",["G2064"]],["not",["G3756"]],["with",["G3326"]],["observation:",[]]]},{"verse":21,"text":"Neither shall they say, Lo here! or, lo there! for, behold, the kingdom of God is within you.","words":[["Neither",["G3761"]],["shall they say,",["G2046"]],["Lo",["G2400"]],["here!",["G5602"]],["or,",["G2228"]],["lo",["G2400"]],["there!",["G1563"]],["for,",["G1063"]],["behold,",["G2400"]],["the kingdom",["G932"]],["of God",["G2316"]],["is",["G2076"]],["within",["G1787"]],["you.",[]]]},{"verse":22,"text":"And he said unto the disciples, The days will come, when ye shall desire to see one of the days of the Son of man, and ye shall not see it.","words":[["And",["G1161"]],["he said",["G2036"]],["unto",["G4314"]],["the disciples,",["G3101"]],["The days",["G2250"]],["will come,",["G2064"]],["when",["G3753"]],["ye shall desire",["G1937"]],["to see",["G1492"]],["one",["G3391"]],["of the days