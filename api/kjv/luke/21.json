{"book":"Luke","chapter":21,"translation":"KJV","url":"/bible/luke/21","verses":[{"verse":1,"text":"And he looked up, and saw the rich men casting their gifts into the treasury.","words":[["And",["G1161"]],["he looked up,",["G308"]],["and saw",["G1492"]],["the rich men",["G4145"]],["casting",["G906"]],["their",["G846"]],["gifts",["G1435"]],["into",["G1519"]],["the treasury.",[]]]},{"verse":2,"text":"And he saw also a certain poor widow casting in thither two mites.","words":[["And",["G1161"]],["he saw",["G1492"]],["also",["G2532"]],["a certain",["G5100"]],["poor",["G3998"]],["widow",["G5503"]],["casting",["G906"]],["in thither",["G1563"]],["two",["G1417"]],["mites.",[]]]},{"verse":3,"text":"And he said, Of a truth I say unto you, that this poor widow hath cast in more than they all:","words":[["And",["G2532"]],["he said,",["G2036"]],["Of a truth",["G230"]],["I say",["G3004"]],["unto you,",["G5213"]],["that",["G3754"]],["this",["G3778"]],["poor",["G4434"]],["widow",["G5503"]],["hath cast",["G906"]],["in more than",["G4119"]],["they all:",[]]]},{"verse":4,"text":"For all these have of their abundance cast in unto the offerings of God: but she of her penury hath cast in all the living that she had.","words":[["For",["G1063"]],["all",["G537"]],["these",["G3778"]],["have of",["G1537"]],["their",["G846"]],["abundance",["G4052"]],["cast",["G906"]],["in unto",["G1519"]],["the offerings",["G1435"]],["of God:",["G2316"]],["but",["G1161"]],["she",["G3778","G846"]],["of",["G1537"]],["her",["G846"]],["penury",["G5303"]],["hath cast",["G906"]],["in all",["G537"]],["the living",["G979"]],["that",["G3739"]],["she had.",[]]]},{"verse":5,"text":"And as some spake of the temple, how it was adorned with goodly stones and gifts, he said,","words":[["And",["G2532"]],["as some",["G5100"]],["spake",["G3004"]],["of",["G4012"]],["the temple,",["G2411"]],["how",["G3754"]],["it was adorned",["G2885"]],["with goodly",["G2570"]],["stones",["G3037"]],["and",["G2532"]],["gifts,",["G334"]],["he said,",[]]]},{"verse":6,"text":"As for these things which ye behold, the days will come, in the which there shall not be left one stone upon another, that shall not be thrown down.","words":[["As for these things",["G5023"]],["which",["G3739"]],["ye behold,",["G2334"]],["the days",["G2250"]],["will come,",["G2064"]],["in",["G1722"]],["the which",["G3739"]],["there shall",["G863"]],["not",["G3756"]],["be left",["G863"]],["one stone",["G3037"]],["upon",["G1909"]],["another,",["G3037"]],["that",["G3739"]],["shall",["G2647"]],["not",["G3756"]],["be thrown down.",[]]]},{"verse":7,"text":"And they asked him, saying, Master, but when shall these things be? and what sign will there be when these things shall come to pass?","words":[["And",["G1161"]],["they asked",["G1905"]],["him,",["G846"]],["saying,",["G3004"]],["Master,",["G1320"]],["but",["G3767"]],["when",["G4219"]],["shall",["G2071"]],["these things",["G5023"]],["be?",["G2071"]],["and",["G2532"]],["what",["G5101"]],["sign",["G4592"]],["will there be when",["G3752"]],["these things",["G5023"]],["shall",["G3195"]],["come to pass?",[]]]},{"verse":8,"text":"And he said, Take heed that ye be not deceived: for many shall come in my name, saying, I am Christ; and the time draweth near: go ye not therefore after them.","words":[["And",["G1161"]],["he said,",["G2036"]],["Take heed",["G991"]],["that ye be",["G4105"]],["not",["G3361"]],["deceived:",["G4105"]],["for",["G1063"]],["many",["G4183"]],["shall come",["G2064"]],["in",["G1909"]],["my",["G3450"]],["name,",["G3686"]],["saying,",["G3004","G3754"]],["I",["G1473"]],["am",["G1510"]],["Christ; and",["G2532"]],["the time",["G2540"]],["draweth near:",["G1448"]],["go ye",["G4198"]],["not",["G3361"]],["therefore",["G3767"]],["after",["G3694"]],["them.",[]]]},{"verse":9,"text":"But when ye shall hear of wars and commotions, be not terrified: for these things must first come to pass; but the end is not by and by.","words":[["But",["G1161"]],["when",["G3752"]],["ye shall hear",["G191"]],["of wars",["G4171"]],["and",["G2532"]],["commotions,",["G181"]],["be",["G4422"]],["not",["G3361"]],["terrified:",["G4422"]],["for",["G1063"]],["these things",["G5023"]],["must",["G1163"]],["first",["G4412"]],["come to pass;",["G1096"]],["but",["G235"]],["the end",["G5056"]],["is not",["G3756"]],["by and by.",[]]]},{"verse":10,"text":"Then said he unto them, Nation shall rise against nation, and kingdom against kingdom:","words":[["Then",["G5119"]],["said he",["G3004"]],["unto them,",["G846"]],["Nation",["G1484"]],["shall rise",["G1453"]],["against",["G1909"]],["nation,",["G1484"]],["and",["G2532"]],["kingdom",["G932"]],["against",["G1909"]],["kingdom:",[]]]},{"verse":11,"text":"And great earthquakes shall be in divers places, and famines, and pestilences; and fearful sights and great signs shall there be from heaven.","words":[["And",["G5037"]],["great",["G3173"]],["earthquakes",["G4578"]],["shall be",["G2071"]],["in",["G2596"]],["divers places,",["G5117"]],["and",["G2532"]],["famines,",["G3042"]],["and",["G2532"]],["pestilences;",["G3061"]],["and",["G5037"]],["fearful sights",["G5400"]],["and",["G2532"]],["great",["G3173"]],["signs",["G4592"]],["shall there be",["G2071"]],["from",["G575"]],["heaven.",[]]]},{"verse":12,"text":"But before all these, they shall lay their hands on you, and persecute you, delivering you up to the synagogues, and into prisons, being brought before kings and rulers for my name’s sake.","words":[["But",["G1161"]],["before",["G4253"]],["all",["G537"]],["these,",["G5130"]],["they shall lay",["G1911"]],["their",["G846"]],["hands",["G5495"]],["on",["G1909"]],["you,",["G5209"]],["and",["G2532"]],["persecute",["G1377"]],["you, delivering",["G3860"]],["you up",["G1519"]],["to the synagogues,",["G4864"]],["and",["G2532"]],["into prisons,",["G5438"]],["being brought",["G71"]],["before",["G1909"]],["kings",["G935"]],["and",["G2532"]],["rulers",["G2232"]],["for",["G1752"]],["my",["G3450"]],["name’s sake.",[]]]},{"verse":13,"text":"And it shall turn to you for a testimony.","words":[["And",["G1161"]],["it shall turn",["G576"]],["to you",["G5213"]],["for",["G1519"]],["a testimony.",[]]]},{"verse":14,"text":"Settle it therefore in your hearts, not to meditate before what ye shall answer:","words":[["Settle",["G5087"]],["it therefore",["G3767"]],["in",["G1519"]],["your",["G5216"]],["hearts,",["G2588"]],["not",["G3361"]],["to meditate before",["G4304"]],["what ye shall answer:",[]]]},{"verse":15,"text":"For I will give you a mouth and wisdom, which all your adversaries shall not be able to gainsay nor resist.","words":[["For",["G1063"]],["I",["G1473"]],["will give",["G1325"]],["you",["G5213"]],["a mouth",["G4750"]],["and",["G2532"]],["wisdom,",["G4678"]],["which",["G3739"]],["all",["G3956"]],["your",["G5213"]],["adversaries",["G480"]],["shall",["G1410"]],["not",["G3756"]],["be able",["G1410"]],["to gainsay",["G471"]],["nor",["G3761"]],["resist.",[]]]},{"verse":16,"text":"And ye shall be betrayed both by parents, and brethren, and kinsfolks, and friends; and some of you shall they cause to be put to death.","words":[["And",["G1161"]],["ye shall be betrayed",["G3860"]],["both",["G2532"]],["by",["G5259"]],["parents,",["G1118"]],["and",["G2532"]],["brethren,",["G80"]],["and",["G2532"]],["kinsfolks,",["G4773"]],["and",["G2532"]],["friends;",["G5384"]],["and",["G2532"]],["some of",["G1537"]],["you",["G5216"]],["shall they cause to be put to death.",[]]]},{"verse":17,"text":"And ye shall be hated of all men for my name’s sake.","words":[["And",["G2532"]],["ye shall be",["G2071"]],["hated",["G3404"]],["of",["G5259"]],["all",["G3956"]],["men for",["G1223"]],["my",["G3450"]],["name’s sake.",[]]]},{"verse":18,"text":"But there shall not an hair of your head perish.","words":[["But",["G2532"]],["there shall not",["G3364"]],["an hair",["G2359"]],["of",["G1537"]],["your",["G5216"]],["head",["G2776"]],["perish.",[]]]},{"verse":19,"text":"In your patience possess ye your souls.","words":[["In",["G1722"]],["your",["G5216"]],["patience",["G5281"]],["possess ye",["G2932"]],["your",["G5216"]],["souls.",[]]]},{"verse":20,"text":"And when ye shall see Jerusalem compassed with armies, then know that the desolation thereof is nigh.","words":[["And",["G1161"]],["when",["G3752"]],["ye shall see",["G1492"]],["Jerusalem",["G2419"]],["compassed",["G2944"]],["with",["G5259"]],["armies,",["G4760"]],["then",["G5119"]],["know",["G1097"]],["that",["G3754"]],["the desolation",["G2050"]],["thereof",["G846"]],["is nigh.",[]]]},{"verse":21,"text":"Then let them which are in Judea flee to the mountains; and let them which are in the midst of it depart out; and let not them that are in the countries enter thereinto.","words":[["Then",["G5119"]],["let them",["G5343"]],["which are in",["G1722"]],["Judea",["G2449"]],["flee",["G5343"]],["to",["G1519"]],["the mountains;",["G3735"]],["and",["G2532"]],["let them",["G1633"]],["which are in",["G1722"]],["the midst",["G3319"]],["of it",["G846"]],["depart out;",["G1633"]],["and",["G2532"]],["let",["G1525"]],["not",["G3361"]],["them that are in",["G1722"]],["the countries",["G5561"]],["enter",["G1525"]],["thereinto.",["G1519"]]]},{"verse":22,"text":"For these be the days of vengeance, that all things which are written may be fulfilled.","words":[["For",["G3754"]],["these",["G3778"]],["be",["G1526"]],["the days",["G2250"]],["of vengeance,",["G1557"]],["that all things",["G3956"]],["which",["G3588"]],["are written",["G1125"]],["may be fulfilled.",[]]]},{"verse":23,"text":"But woe unto them that are with child, and to them that give suck, in those days! for there shall be great distress in the land, and wrath upon this people.","words":[["But",["G1161"]],["woe",["G3759"]],["unto",["G1722"]],["them that are with child,",["G1064","G2192"]],["and",["G2532"]],["to them that give suck,",["G2337"]],["in",["G1722"]],["those",["G1565"]],["days!",["G2250"]],["for",["G1063"]],["there shall be",["G2071"]],["great",["G3173"]],["distress",["G318"]],["in",["G1909"]],["the land,",["G1093"]],["and",["G2532"]],["wrath",["G3709"]],["upon",["G1722"]],["this",["G5129"]],["people.",[]]]},{"verse":24,"text":"And they shall fall by the edge of the sword, and shall be led away captive into all nations: and Jerusalem shall be trodden down of the Gentiles, until the times of the Gentiles be fulfilled.","words":[["And",["G2532"]],["they shall fall",["G4098"]],["by the edge",["G4750"]],["of the sword,",["G3162"]],["and",["G2532"]],["shall be led away captive",["G163"]],["into",["G1519"]],["all",["G3956"]],["nations:",["G1484"]],["and",["G2532"]],["Jerusalem",["G2419"]],["shall be",["G2071"]],["trodden down",["G3961"]],["of",["G5259"]],["the Gentiles,",["G1484"]],["until",["G891"]],["the times",["G2540"]],["of the Gentiles",["G1484"]],["be fulfilled.",[]]]},{"verse":25,"text":"And there shall be signs in the sun, and in the moon, and in the stars; and upon the earth distress of nations, with perplexity; the sea and the waves roaring;","words":[["And",["G2532"]],["there shall be",["G2071"]],["signs",["G4592"]],["in",["G1722"]],["the sun,",["G2246"]],["and",["G2532"]],["in the moon,",["G4582"]],["and",["G2532"]],["in the stars;",["G798"]],["and",["G2532"]],["upon",["G1909"]],["the earth",["G1093"]],["distress",["G4928"]],["of nations,",["G1484"]],["with",["G1722"]],["perplexity;",["G640"]],["the sea",["G2281"]],["and",["G2532"]],["the waves",["G4535"]],["roaring;",[]]]},{"verse":26,"text":"Men’s hearts failing them for fear, and for looking after those things which are coming on the earth: for the powers of heaven shall be shaken.","words":[["Men’s hearts failing them",["G674"]],["for",["G575"]],["fear,",["G5401"]],["and",["G2532"]],["for looking after",["G4329"]],["those things which are coming on",["G1904"]],["the earth:",["G3625"]],["for",["G1063"]],["the powers",["G1411"]],["of heaven",["G3772"]],["shall be shaken.",[]]]},{"verse":27,"text":"And then shall they see the Son of man coming in a cloud with power and great glory.","words":[["And",["G2532"]],["then",["G5119"]],["shall they see",["G3700"]],["the Son",["G5207"]],["of man",["G444"]],["coming",["G2064"]],["in",["G1722"]],["a cloud",["G3507"]],["with",["G3326"]],["power",["G1411"]],["and",["G2532"]],["great",["G4183"]],["glory.",[]]]},{"verse":28,"text":"And when these things begin to come to pass, then look up, and lift up your heads; for your redemption draweth nigh.","words":[["And",["G1161"]],["when these things",["G5130"]],["begin",["G756"]],["to come to pass,",["G1096"]],["then look up,",["G352"]],["and",["G2532"]],["lift up",["G1869"]],["your",["G5216"]],["heads;",["G2776"]],["for",["G1360"]],["your",["G5216"]],["redemption",["G629"]],["draweth nigh.",[]]]},{"verse":29,"text":"And he spake to them a parable; Behold the fig tree, and all the trees;","words":[["And",["G2532"]],["he spake",["G2036"]],["to them",["G846"]],["a parable;",["G3850"]],["Behold",["G1492"]],["the fig tree,",["G4808"]],["and",["G2532"]],["all",["G3956"]],["the trees;",[]]]},{"verse":30,"text":"When they now shoot forth, ye see and know of your own selves that summer is now nigh at hand.","words":[["When",["G3752"]],["they now",["G2235"]],["shoot forth,",["G4261"]],["ye see",["G991"]],["and know",["G1097"]],["of",["G575"]],["your own selves",["G1438"]],["that",["G3754"]],["summer",["G2330"]],["is",["G2076"]],["now",["G2235"]],["nigh at hand.",[]]]},{"verse":31,"text":"So likewise ye, when ye see these things come to pass, know ye that the kingdom of God is nigh at hand.","words":[["So",["G3779"]],["likewise",["G2532"]],["ye,",["G5210"]],["when",["G3752"]],["ye see",["G1492"]],["these things",["G5023"]],["come to pass,",["G1096"]],["know ye",["G1097"]],["that",["G3754"]],["the kingdom",["G932"]],["of God",["G2316"]],["is",["G2076"]],["nigh at hand.",[]]]},{"verse":32,"text":"Verily I say unto you, This generation shall not pass away, till all be fulfilled.","words":[["Verily",["G281"]],["I say",["G3004"]],["unto you,",["G5213","G3754"]],["This",["G3778"]],["generation",["G1074"]],["shall",["G3928"]],["not",["G3364"]],["pass away,",["G3928","G302"]],["till",["G2193"]],["all",["G3956"]],["be fulfilled.",[]]]},{"verse":33,"text":"Heaven and earth shall pass away: but my words shall not pass away.","words":[["Heaven",["G3772"]],["and",["G2532"]],["earth",["G1093"]],["shall pass away:",["G3928"]],["but",["G1161"]],["my",["G3450"]],["words",["G3056"]],["shall",["G3928"]],["not",["G3364"]],["pass away.",[]]]},{"verse":34,"text":"And take heed to yourselves, lest at any time your hearts be overcharged with surfeiting, and drunkenness, and cares of this life, and so that day come upon you unawares.","words":[["And",["G1161"]],["take heed",["G4337"]],["to yourselves,",["G1438"]],["lest at any time",["G3379"]],["your",["G5216"]],["hearts",["G2588"]],["be overcharged",["G925"]],["with",["G1722"]],["surfeiting,",["G2897"]],["and",["G2532"]],["drunkenness,",["G3178"]],["and",["G2532"]],["cares",["G3308"]],["of this life,",["G982"]],["and",["G2532"]],["so that",["G1565"]],["day",["G2250"]],["come",["G2186"]],["upon",["G1909"]],["you",["G5209"]],["unawares.",[]]]},{"verse":35,"text":"For as a snare shall it come on all them that dwell on the face of the whole earth.","words":[["For",["G1063"]],["as",["G5613"]],["a snare",["G3803"]],["shall it come",["G1904"]],["on",["G1909"]],["all",["G3956"]],["them that dwell",["G2521"]],["on",["G1909"]],["the face",["G4383"]],["of the whole",["G3956"]],["earth.",[]]]},{"verse":36,"text":"Watch ye therefore, and pray always, that ye may be accounted worthy to escape all these things that shall come to pass, and to stand before the Son of man.","words":[["Watch ye",["G69"]],["therefore,",["G3767"]],["and pray",["G1189"]],["always,",["G1722","G3956","G2540"]],["that",["G2443"]],["ye may be accounted worthy",["G2661"]],["to escape",["G1628"]],["all",["G3956"]],["these things",["G5023"]],["that shall",["G3195"]],["come to pass,",["G1096"]],["and",["G2532"]],["to stand",["G2476"]],["before",["G1715"]],["the Son",["G5207"]],["of man.",[]]]},{"verse":37,"text":"And in the day time he was teaching in the temple; and at night he went out, and abode in the mount that is called the mount of Olives.","words":[["And",["G1161"]],["in the day time",["G2250"]],["he was",["G2258"]],["teaching",["G1321"]],["in",["G1722"]],["the temple;",["G2411"]],["and",["G1161"]],["at night",["G3571"]],["he went out,",["G1831"]],["and abode",["G835"]],["in",["G1519"]],["the mount",["G3735"]],["that is called",["G2564"]],["the mount of Olives.",[]]]},{"verse":38,"text":"And all the people came early in the morning to him in the temple, for to hear him.","words":[["And",["G2532"]],["all",["G3956"]],["the people",["G2992"]],["came early in the morning",["G3719"]],["to",["G4314"]],["him",["G846"]],["in",["G1722"]],["the temple,",["G2411"]],["for to hear",["G191"]],["him.",[]]]}]}