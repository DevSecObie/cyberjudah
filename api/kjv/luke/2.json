{"book":"Luke","chapter":2,"translation":"KJV","url":"/bible/luke/2","verses":[{"verse":1,"text":"And it came to pass in those days, that there went out a decree from Cesar Augustus, that all the world should be taxed.","words":[["And",["G1161"]],["it came to pass",["G1096"]],["in",["G1722"]],["those",["G1565"]],["days,",["G2250"]],["that there went out",["G1831"]],["a decree",["G1378"]],["from",["G3844"]],["Cesar",["G2541"]],["Augustus,",["G828"]],["that all",["G3956"]],["the world",["G3625"]],["should be taxed.",[]]]},{"verse":2,"text":"(And this taxing was first made when Cyrenius was governor of Syria.)","words":[["(And this",["G3778"]],["taxing",["G582"]],["was",["G1096"]],["first",["G4413"]],["made",["G1096"]],["when Cyrenius",["G2958"]],["was governor",["G2230"]],["of Syria.)",[]]]},{"verse":3,"text":"And all went to be taxed, every one into his own city.","words":[["And",["G2532"]],["all",["G3956"]],["went",["G4198"]],["to be taxed,",["G583"]],["every one",["G1538"]],["into",["G1519"]],["his own",["G2398"]],["city.",[]]]},{"verse":4,"text":"And Joseph also went up from Galilee, out of the city of Nazareth, into Judea, unto the city of David, which is called Bethlehem; (because he was of the house and lineage of David:)","words":[["And",["G1161"]],["Joseph",["G2501"]],["also",["G2532"]],["went up",["G305"]],["from",["G575"]],["Galilee,",["G1056"]],["out of",["G1537"]],["the city",["G4172"]],["of Nazareth,",["G3478"]],["into",["G1519"]],["Judea,",["G2449"]],["unto",["G1519"]],["the city",["G4172"]],["of David,",["G1138"]],["which",["G3748"]],["is called",["G2564"]],["Bethlehem;",["G965"]],["(because",["G1223"]],["he",["G846"]],["was",["G1511"]],["of",["G1537"]],["the house",["G3624"]],["and",["G2532"]],["lineage",["G3965"]],["of David:)",[]]]},{"verse":5,"text":"To be taxed with Mary his espoused wife, being great with child.","words":[["To be taxed",["G583"]],["with",["G4862"]],["Mary",["G3137"]],["his",["G846"]],["espoused",["G3423"]],["wife,",["G1135"]],["being",["G5607"]],["great with child.",[]]]},{"verse":6,"text":"And so it was, that, while they were there, the days were accomplished that she should be delivered.","words":[["And",["G1161"]],["so it was,",["G1096"]],["that, while",["G1722"]],["they",["G846"]],["were",["G1511"]],["there,",["G1563"]],["the days",["G2250"]],["were accomplished",["G4130"]],["that she",["G846"]],["should be delivered.",[]]]},{"verse":7,"text":"And she brought forth her firstborn son, and wrapped him in swaddling clothes, and laid him in a manger; because there was no room for them in the inn.","words":[["And",["G2532"]],["she brought forth",["G5088"]],["her",["G846"]],["firstborn",["G4416"]],["son,",["G5207"]],["and",["G2532"]],["wrapped",["G4683"]],["him",["G846"]],["in swaddling clothes,",["G4683"]],["and",["G2532"]],["laid",["G347"]],["him",["G846"]],["in",["G1722"]],["a manger;",["G5336"]],["because",["G1360"]],["there was",["G2258"]],["no",["G3756"]],["room",["G5117"]],["for them",["G846"]],["in",["G1722"]],["the inn.",[]]]},{"verse":8,"text":"And there were in the same country shepherds abiding in the field, keeping watch over their flock by night.","words":[["And",["G2532"]],["there were",["G2258"]],["in",["G1722"]],["the same",["G846"]],["country",["G5561"]],["shepherds",["G4166"]],["abiding in the field,",["G63","G2532"]],["keeping",["G5442"]],["watch",["G5438"]],["over",["G1909"]],["their",["G846"]],["flock",["G4167"]],["by night.",[]]]},{"verse":9,"text":"And, lo, the angel of the Lord came upon them, and the glory of the Lord shone round about them: and they were sore afraid.","words":[["And,",["G2532"]],["lo,",["G2400"]],["the angel",["G32"]],["of the Lord",["G2962"]],["came upon",["G2186"]],["them,",["G846"]],["and",["G2532"]],["the glory",["G1391"]],["of the Lord",["G2962"]],["shone round about",["G4034"]],["them:",["G846"]],["and",["G2532"]],["they were sore",["G3173"]],["afraid.",["G5399"]]]},{"verse":10,"text":"And the angel said unto them, Fear not: for, behold, I bri