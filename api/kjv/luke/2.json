other, Let us now go even unto Bethlehem, and see this thing which is come to pass, which the Lord hath made known unto us.","words":[["And",["G2532"]],["it came to pass,",["G1096"]],["as",["G5613"]],["the angels",["G32"]],["were gone away",["G565"]],["from",["G575"]],["them",["G846"]],["into",["G1519"]],["heaven,",["G3772","G2532"]],["the shepherds",["G444","G4166"]],["said",["G2036"]],["one",["G240"]],["to",["G4314"]],["another,",["G240"]],["Let us",["G1330"]],["now",["G1211"]],["go",["G1330"]],["even unto",["G2193"]],["Bethlehem,",["G965"]],["and",["G2532"]],["see",["G1492"]],["this",["G5124"]],["thing",["G4487"]],["which is come to pass,",["G1096"]],["which",["G3739","G3588"]],["the Lord",["G2962"]],["hath made known",["G1107"]],["unto us.",[]]]},{"verse":16,"text":"And they came with haste, and found Mary, and Joseph, and the babe lying in a manger.","words":[["And",["G2532"]],["they came",["G2064"]],["with haste,",["G4692"]],["and",["G2532","G5037"]],["found",["G429"]],["Mary,",["G3137"]],["and",["G2532"]],["Joseph,",["G2501"]],["and",["G2532"]],["the babe",["G1025"]],["lying",["G2749"]],["in",["G1722"]],["a manger.",[]]]},{"verse":17,"text":"And when they had seen it, they made known abroad the saying which was told them concerning this child.","words":[["And",["G1161"]],["when they had seen",["G1492"]],["it, they made known abroad",["G1232"]],["the saying",["G4012","G4487"]],["which",["G3588"]],["was told",["G2980"]],["them",["G846"]],["concerning",["G4012"]],["this",["G5127"]],["child.",[]]]},{"verse":18,"text":"And all they that heard it wondered at those things which were told them by the shepherds.","words":[["And",["G2532"]],["all",["G3956"]],["they that heard",["G191"]],["it wondered",["G2296"]],["at",["G4012"]],["those things which",["G3588"]],["were told",["G2980"]],["them",["G4314","G846"]],["by",["G5259"]],["the shepherds.",[]]]},{"verse":19,"text":"But Mary kept all these things, and pondered them in her heart.","words":[["But",["G1161"]],["Mary",