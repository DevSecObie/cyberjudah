s brought in the child Jesus, to do for him after the custom of the law,","words":[["And",["G2532"]],["he came",["G2064"]],["by",["G1722"]],["the Spirit",["G4151"]],["into",["G1519"]],["the temple:",["G2411"]],["and",["G2532"]],["when the parents",["G1118"]],["brought",["G1521"]],["in",["G1722"]],["the child",["G3813"]],["Jesus,",["G2424"]],["to do",["G4160","G846"]],["for",["G4012"]],["him",["G846"]],["after",["G2596"]],["the custom",["G1480"]],["of the law,",[]]]},{"verse":28,"text":"Then took he him up in his arms, and blessed God, and said,","words":[["Then",["G2532"]],["took",["G1209"]],["he",["G846"]],["him",["G846"]],["up",["G1209"]],["in",["G1519"]],["his",["G846"]],["arms,",["G43"]],["and",["G2532"]],["blessed",["G2127"]],["God,",["G2316"]],["and",["G2532"]],["said,",[]]]},{"verse":29,"text":"Lord, now lettest thou thy servant depart in peace, according to thy word:","words":[["Lord,",["G1203"]],["now",["G3568"]],["lettest thou",["G630"]],["thy",["G4675"]],["servant",["G1401"]],["depart",["G630"]],["in",["G1722"]],["peace,",["G1515"]],["according",["G2596"]],["to thy",["G4675"]],["word:",[]]]},{"verse":30,"text":"For mine eyes have seen thy salvation,","words":[["For",["G3754"]],["mine",["G3450"]],["eyes",["G3788"]],["have seen",["G1492"]],["thy",["G4675"]],["salvation,",[]]]},{"verse":31,"text":"Which thou hast prepared before the face of all people;","words":[["Which",["G3739"]],["thou hast prepared",["G2090"]],["before",["G2596"]],["the face",["G4383"]],["of all",["G3956"]],["people;",[]]]},{"verse":32,"text":"A light to lighten the Gentiles, and the glory of thy people Israel.","words":[["A light",["G5457"]],["to",["G1519"]],["lighten",["G602"]],["the Gentiles,",["G1484"]],["and",["G2532"]],["the glory",["G1391"]],["of thy",["G4675"]],["people",["G2992"]],["Israel.",[]]]},{"verse":33,"text":"And Joseph and his mother marvelled at those things which were spoken of him.","words":[["And",["G2532"]],["Joseph",["G2501"]],["and",["G2532"]],["his",["G846"]],["