{"book":"Luke","chapter":18,"translation":"KJV","url":"/bible/luke/18","verses":[{"verse":1,"text":"And he spake a parable unto them to this end, that men ought always to pray, and not to faint;","words":[["And",["G1161"]],["he spake",["G3004","G2532"]],["a parable",["G3850"]],["unto them",["G846","G4314"]],["to this end, that men ought",["G1163"]],["always",["G3842"]],["to pray,",["G4336"]],["and",["G2532"]],["not",["G3361"]],["to faint;",[]]]},{"verse":2,"text":"Saying, There was in a city a judge, which feared not God, neither regarded man:","words":[["Saying,",["G3004"]],["There was",["G2258"]],["in",["G1722"]],["a",["G5100"]],["city",["G4172"]],["a",["G5100"]],["judge,",["G2923"]],["which feared",["G5399"]],["not",["G3361"]],["God,",["G2316"]],["neither",["G2532","G3361"]],["regarded",["G1788"]],["man:",[]]]},{"verse":3,"text":"And there was a widow in that city; and she came unto him, saying, Avenge me of mine adversary.","words":[["And",["G1161"]],["there was",["G2258"]],["a widow",["G5503"]],["in",["G1722"]],["that",["G1565"]],["city;",["G4172"]],["and",["G2532"]],["she came",["G2064"]],["unto",["G4314"]],["him,",["G846"]],["saying,",["G3004"]],["Avenge",["G1556"]],["me",["G3165"]],["of",["G575"]],["mine",["G3450"]],["adversary.",[]]]},{"verse":4,"text":"And he would not for a while: but afterward he said within himself, Though I fear not God, nor regard man;","words":[["And",["G2532"]],["he would",["G2309"]],["not",["G3756"]],["for",["G1909"]],["a while:",["G5550"]],["but",["G1161"]],["afterward",["G5023","G3326"]],["he said",["G2036"]],["within",["G1722"]],["himself,",["G1438"]],["Though",["G1499"]],["I fear",["G5399"]],["not",["G3756"]],["God,",["G2316"]],["nor",["G2532","G3756"]],["regard",["G1788"]],["man;",[]]]},{"verse":5,"text":"Yet because this widow troubleth me, I will avenge her, lest by her continual coming she weary me.","words":[["Yet",["G1065"]],["because",["G1223"]],["this",["G5026"]],["widow",["G5503"]],["troubleth",["G3930","G2873"]],["me,