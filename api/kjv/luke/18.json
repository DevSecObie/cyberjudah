45"]],["thou hast,",["G2192"]],["and",["G2532"]],["distribute",["G1239"]],["unto the poor,",["G4434"]],["and",["G2532"]],["thou shalt have",["G2192"]],["treasure",["G2344"]],["in",["G1722"]],["heaven:",["G3772"]],["and",["G2532"]],["come,",["G1204"]],["follow",["G190"]],["me.",[]]]},{"verse":23,"text":"And when he heard this, he was very sorrowful: for he was very rich.","words":[["And",["G1161"]],["when he heard",["G191"]],["this,",["G5023"]],["he was",["G1096"]],["very sorrowful:",["G4036"]],["for",["G1063"]],["he was",["G2258"]],["very",["G4970"]],["rich.",[]]]},{"verse":24,"text":"And when Jesus saw that he was very sorrowful, he said, How hardly shall they that have riches enter into the kingdom of God!","words":[["And",["G1161"]],["when Jesus",["G2424"]],["saw",["G1492"]],["that he",["G846"]],["was",["G1096"]],["very sorrowful,",["G4036"]],["he said,",["G2036"]],["How",["G4459"]],["hardly",["G1423"]],["shall they",["G1525"]],["that have",["G2192"]],["riches",["G5536"]],["enter",["G1525"]],["into",["G1519"]],["the kingdom",["G932"]],["of God!",[]]]},{"verse":25,"text":"For it is easier for a camel to go through a needle’s eye, than for a rich man to enter into the kingdom of God.","words":[["For",["G1063"]],["it is",["G2076"]],["easier",["G2123"]],["for a camel",["G2574"]],["to go",["G1525"]],["through",["G1223"]],["a needle’s eye,",["G5168"]],["than",["G2228"]],["for a rich man",["G4145"]],["to enter",["G1525"]],["into",["G1519"]],["the kingdom",["G932"]],["of God.",[]]]},{"verse":26,"text":"And they that heard it said, Who then can be saved?","words":[["And",["G1161"]],["they that heard",["G191"]],["it said,",["G2036"]],["Who",["G5101"]],["then",["G2532"]],["can be",["G1410"]],["saved?",[]]]},{"verse":27,"text":"And he said, The things which are impossible with men are possible with God.","words":[["And",["G1161"]],["he said,",["G2036"]],["The things which are impossible",["G102"]],["with",["G3844"]],["men",["G444"]],["are",["G2076"]],["possible",["G1415"]],[