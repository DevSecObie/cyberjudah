{"book":"Luke","chapter":1,"translation":"KJV","url":"/bible/luke/1","verses":[{"verse":1,"text":"Forasmuch as many have taken in hand to set forth in order a declaration of those things which are most surely believed among us,","words":[["Forasmuch",["G1895"]],["as many",["G4183"]],["have taken in hand",["G2021"]],["to set forth in order",["G392"]],["a declaration",["G1335"]],["of",["G4012"]],["those things",["G4229"]],["which are most surely believed",["G4135"]],["among",["G1722"]],["us,",[]]]},{"verse":2,"text":"Even as they delivered them unto us, which from the beginning were eyewitnesses, and ministers of the word;","words":[["Even",["G2531"]],["as they delivered",["G3860"]],["them unto us,",["G2254"]],["which",["G3588"]],["from",["G575"]],["the beginning",["G746"]],["were",["G1096"]],["eyewitnesses,",["G845"]],["and",["G2532"]],["ministers",["G5257"]],["of the word;",[]]]},{"verse":3,"text":"It seemed good to me also, having had perfect understanding of all things from the very first, to write unto thee in order, most excellent Theophilus,","words":[["It seemed",["G1380"]],["good to me also,",["G2504"]],["having had perfect",["G199"]],["understanding",["G3877"]],["of all things",["G3956"]],["from the very first,",["G509"]],["to write",["G1125"]],["unto thee",["G4671"]],["in order,",["G2517"]],["most excellent",["G2903"]],["Theophilus,",[]]]},{"verse":4,"text":"That thou mightest know the certainty of those things, wherein thou hast been instructed.","words":[["That",["G2443"]],["thou mightest know",["G1921"]],["the certainty",["G803"]],["of",["G4012"]],["those things,",["G3056"]],["wherein",["G3739"]],["thou hast been instructed.",[]]]},{"verse":5,"text":"There was in the days of Herod, the king of Judea, a certain priest named Zacharias, of the course of Abia: and his wife was of the daughters of Aaron, and her name was Elisabeth.","words":[["There was",["G1096"]],["in",["G1722"]],["the days",["G2250"]],["of Herod,",["G2264"]],["the king",["G935"]],["of Judea,",["G2449"]],["a certain",["G5100"]],["priest",["G2409"]],["named",["G3686"]],["Zacharias,",["G2197"]],["of",["G1537"]],["the course",["G2183"]],["of Abia:",["G7"]],["and",["G2532"]],["his",["G846"]],["wife",["G1135"]],["was of",["G1537"]],["the daughters",["G2364"]],["of Aaron,",["G2"]],["and",["G2532"]],["her",["G846"]],["name",["G3686"]],["was Elisabeth.",[]]]},{"verse":6,"text":"And they were both righteous before God, walking in all the commandments and ordinances of the Lord blameless.","words":[["And",["G1161"]],["they were",["G2258"]],["both",["G297"]],["righteous",["G1342"]],["before",["G1799"]],["God,",["G2316"]],["walking",["G4198"]],["in",["G1722"]],["all",["G3956"]],["the commandments",["G1785"]],["and",["G2532"]],["ordinances",["G1345"]],["of the Lord",["G2962"]],["blameless.",[]]]},{"verse":7,"text":"And they had no child, because that Elisabeth was barren, and they both were now well stricken in years.","words":[["And",["G2532"]],["they",["G846"]],["had",["G2258"]],["no",["G3756"]],["child,",["G5043"]],["because",["G2530"]],["that Elisabeth",["G1665"]],["was",["G2258"]],["barren,",["G4723"]],["and",["G2532"]],["they",["G846"]],["both",["G297"]],["were",["G2258"]],["now well stricken",["G4260"]],["in",["G1722"]],["years.",[]]]},{"verse":8,"text":"And it came to pass, that while he executed the priest’s office before God in the order of his course,","words":[["And",["G1161"]],["it came to pass,",["G1096"]],["that while",["G1722"]],["he",["G846"]],["executed the priest’s office",["G2407"]],["before",["G1725"]],["God",["G2316"]],["in",["G1722"]],["the order",["G5010"]],["of his",["G846"]],["course,",[]]]},{"verse":9,"text":"According to the custom of the priest’s office, his lot was to burn incense when he went into the temple of the Lord.","words":[["According",["G2596"]],["to the custom",["G1485"]],["of the priest’s office,",["G2405"]],["his lot",["G2975"]],["was to burn incense",["G2370"]],["when he went",["G1525"]],["into",["G1519"]],["the temple",["G3485"]],["of the Lord.",[]]]},{"verse":10,"text":"And the whole multitude of the people were praying without at the time of incense.","words":[["And",["G2532"]],["the whole",["G3956"]],["multitude",["G4128"]],["of the people",["G2992"]],["were",["G2258"]],["praying",["G4336"]],["without",["G1854"]],["at the time",["G5610"]],["of incense.",[]]]},{"verse":11,"text":"And there appeared unto him an angel of the Lord standing on the right side of the altar of incense.","words":[["And",["G1161"]],["there appeared",["G3700"]],["unto him",["G846"]],["an angel",["G32"]],["of the Lord",["G2962"]],["standing",["G2476"]],["on",["G1537"]],["the right side",["G1188"]],["of the altar",["G2379"]],["of incense.",[]]]},{"verse":12,"text":"And when Zacharias saw him, he was troubled, and fear fell upon him.","words":[["And",["G2532"]],["when Zacharias",["G2197"]],["saw",["G1492"]],["him, he was troubled,",["G5015"]],["and",["G2532"]],["fear",["G5401"]],["fell",["G1968"]],["upon",["G1909"]],["him.",[]]]},{"verse":13,"text":"But the angel said unto him, Fear not, Zacharias: for thy prayer is heard; and thy wife Elisabeth shall bear thee a son, and thou shalt call his name John.","words":[["But",["G1161"]],["the angel",["G32"]],["said",["G2036"]],["unto",["G4314"]],["him,",["G846"]],["Fear",["G5399"]],["not,",["G3361"]],["Zacharias:",["G2197"]],["for",["G1360"]],["thy",["G4675"]],["prayer",["G1162"]],["is heard;",["G1522"]],["and",["G2532"]],["thy",["G4675"]],["wife",["G1135"]],["Elisabeth",["G1665"]],["shall bear",["G1080"]],["thee",["G4671"]],["a son,",["G5207"]],["and",["G2532"]],["thou shalt call",["G2564"]],["his",["G846"]],["name",["G3686"]],["John.",[]]]},{"verse":14,"text":"And thou shalt have joy and gladness; and many shall rejoice at his birth.","words":[["And",["G2532"]],["thou",["G4671"]],["shalt have",["G2071"]],["joy",["G5479"]],["and",["G2532"]],["gladness;",["G20"]],["and",["G2532"]],["many",["G4183"]],["shall rejoice",["G5463"]],["at",["G1909"]],["his",["G846"]],["birth.",[]]]},{"verse":15,"text":"For he shall be great in the sight of the Lord, and shall drink neither wine nor strong drink; and he shall be filled with the Holy Ghost, even from his mother’s womb.","words":[["For",["G1063"]],["he shall be",["G2071"]],["great",["G3173"]],["in the sight",["G1799"]],["of the Lord,",["G2962"]],["and",["G2532"]],["shall drink",["G4095"]],["neither",["G3364"]],["wine",["G3631"]],["nor",["G2532"]],["strong drink;",["G4608"]],["and",["G2532"]],["he shall be filled",["G4130"]],["with the Holy",["G40"]],["Ghost,",["G4151"]],["even",["G2089"]],["from",["G1537"]],["his",["G846"]],["mother’s womb.",[]]]},{"verse":16,"text":"And many of the children of Israel shall he turn to the Lord their God.","words":[["And",["G2532"]],["many",["G4183"]],["of the children",["G5207"]],["of Israel",["G2474"]],["shall he turn",["G1994"]],["to",["G1909"]],["the Lord",["G2962"]],["their",["G846"]],["God.",[]]]},{"verse":17,"text":"And he shall go before him in the spirit and power of Elias, to turn the hearts of the fathers to the children, and the disobedient to the wisdom of the just; to make ready a people prepared for the Lord.","words":[["And",["G2532"]],["he",["G846"]],["shall go",["G4281"]],["before",["G1799"]],["him",["G846"]],["in",["G1722"]],["the spirit",["G4151"]],["and",["G2532"]],["power",["G1411"]],["of Elias,",["G2243"]],["to turn",["G1994"]],["the hearts",["G2588"]],["of the fathers",["G3962"]],["to",["G1909"]],["the children,",["G5043"]],["and",["G2532"]],["the disobedient",["G545"]],["to",["G1722"]],["the wisdom",["G5428"]],["of the just;",["G1342"]],["to make ready",["G2090"]],["a people",["G2992"]],["prepared",["G2680"]],["for the Lord.",[]]]},{"verse":18,"text":"And Zacharias said unto the angel, Whereby shall I know this? for I am an old man, and my wife well stricken in years.","words":[["And",["G2532"]],["Zacharias",["G2197"]],["said",["G2036"]],["unto",["G4314"]],["the angel,",["G32"]],["Whereby",["G2596","G5101"]],["shall I know",["G1097"]],["this?",["G5124"]],["for",["G1063"]],["I",["G1473"]],["am",["G1510"]],["an old man,",["G4246"]],["and",["G2532"]],["my",["G3450"]],["wife",["G1135"]],["well stricken",["G4260"]],["in",["G1722"]],["years.",["G2250"]]]},{"verse":19,"text":"And the angel answering said unto him, I am Gabriel, that stand in the presence of God; and am sent to speak unto thee, and to shew thee these glad tidings.","words":[["And",["G2532"]],["the angel",["G32"]],["answering",["G611"]],["said",["G2036"]],["unto him,",["G846"]],["I",["G1473"]],["am",["G1510"]],["Gabriel,",["G1043"]],["that stand",["G3936"]],["in the presence",["G1799"]],["of God;",["G2316"]],["and",["G2532"]],["am sent",["G649"]],["to speak",["G2980"]],["unto",["G4314"]],["thee,",["G4571"]],["and",["G2532"]],["to shew",["G2097"]],["thee",["G4671"]],["these",["G5023"]],["glad tidings.",[]]]},{"verse":20,"text":"And, behold, thou shalt be dumb, and not able to speak, until the day that these things shall be performed, because thou believest not my words, which shall be fulfilled in their season.","words":[["And,",["G2532"]],["behold,",["G2400"]],["thou",["G2071"]],["shalt be dumb,",["G4623"]],["and",["G2532"]],["not",["G3361"]],["able",["G1410"]],["to speak,",["G2980"]],["until",["G891"]],["the day",["G2250"]],["that",["G3739"]],["these things",["G5023"]],["shall be performed,",["G1096"]],["because",["G473","G3739"]],["thou believest",["G4100"]],["not",["G3756"]],["my",["G3450"]],["words,",["G3056"]],["which",["G3748"]],["shall be fulfilled",["G4137"]],["in",["G1519"]],["their",["G846"]],["season.",[]]]},{"verse":21,"text":"And the people waited for Zacharias, and marvelled that he tarried so long in the temple.","words":[["And",["G2532"]],["the people",["G2992"]],["waited",["G2258","G4328"]],["for Zacharias,",["G2197"]],["and",["G2532"]],["marvelled",["G2296"]],["that",["G1722"]],["he",["G846"]],["tarried so long",["G5549"]],["in",["G1722"]],["the temple.",[]]]},{"verse":22,"text":"And when he came out, he could not speak unto them: and they perceived that he had seen a vision in the temple: for he beckoned unto them, and remained speechless.","words":[["And",["G1161"]],["when he came out,",["G1831"]],["he could",["G1410"]],["not",["G3756"]],["speak",["G2980"]],["unto them:",["G846"]],["and",["G2532"]],["they perceived",["G1921"]],["that",["G3754"]],["he had seen",["G3708"]],["a vision",["G3701"]],["in",["G1722"]],["the temple:",["G3485"]],["for",["G2532"]],["he",["G846"]],["beckoned",["G2258","G1269"]],["unto them,",["G846"]],["and",["G2532"]],["remained",["G1265"]],["speechless.",[]]]},{"verse":23,"text":"And it came to pass, that, as soon as the days of his ministration were accomplished, he departed to his own house.","words":[["And",["G2532"]],["it came to pass,",["G1096"]],["that, as soon as",["G5613"]],["the days",["G2250"]],["of his",["G846"]],["ministration",["G3009"]],["were accomplished,",["G4130"]],["he departed",["G565"]],["to",["G1519"]],["his own",["G846"]],["house.",[]]]},{"verse":24,"text":"And after those days his wife Elisabeth conceived, and hid herself five months, saying,","words":[["And",["G1161"]],["after",["G3326"]],["those",["G5025"]],["days",["G2250"]],["his",["G846"]],["wife",["G1135"]],["Elisabeth",["G1665"]],["conceived,",["G4815"]],["and",["G2532"]],["hid",["G4032"]],["herself",["G1438"]],["five",["G4002"]],["months,",["G3376"]],["saying,",[]]]},{"verse":25,"text":"Thus hath the Lord dealt with me in the days wherein he looked on me, to take away my reproach among men.","words":[["Thus",["G3779"]],["hath",["G4160"]],["the Lord",["G2962"]],["dealt",["G4160"]],["with me",["G3427"]],["in",["G1722"]],["the days",["G2250"]],["wherein",["G3739"]],["he looked on",["G1896"]],["me, to take away",["G851"]],["my",["G3450"]],["reproach",["G3681"]],["among",["G1722"]],["men.",[]]]},{"verse":26,"text":"And in the sixth month the angel Gabriel was sent from God unto a city of Galilee, named Nazareth,","words":[["And",["G1161"]],["in",["G1722"]],["the sixth",["G1623"]],["month",["G3376"]],["the angel",["G32"]],["Gabriel",["G1043"]],["was sent",["G649"]],["from",["G5259"]],["God",["G2316"]],["unto",["G1519"]],["a city",["G4172"]],["of Galilee,",["G1056"]],["named",["G3739","G3686"]],["Nazareth,",[]]]},{"verse":27,"text":"To a virgin espoused to a man whose name was Joseph, of the house of David; and the virgin’s name was Mary.","words":[["To",["G4314"]],["a virgin",["G3933"]],["espoused",["G3423"]],["to a man",["G435"]],["whose",["G3739"]],["name",["G3686"]],["was Joseph,",["G2501"]],["of",["G1537"]],["the house",["G3624"]],["of David;",["G1138"]],["and",["G2532"]],["the virgin’s name",["G3686"]],["was Mary.",[]]]},{"verse":28,"text":"And the angel came in unto her, and said, Hail, thou that art highly favoured, the Lord is with thee: blessed art thou among women.","words":[["And",["G2532"]],["the angel",["G32"]],["came in",["G1525"]],["unto",["G4314"]],["her,",["G846"]],["and said,",["G2036"]],["Hail,",["G5463"]],["thou that art highly favoured,",["G5487"]],["the Lord",["G2962"]],["is with",["G3326"]],["thee:",["G4675"]],["blessed",["G2127"]],["art thou",["G4771"]],["among",["G1722"]],["women.",[]]]},{"verse":29,"text":"And when she saw him, she was troubled at his saying, and cast in her mind what manner of salutation this should be.","words":[["And",["G1161"]],["when she saw",["G1492"]],["him, she was troubled",["G1298"]],["at",["G1909"]],["his",["G846"]],["saying,",["G3056"]],["and",["G2532"]],["cast in her mind",["G1260"]],["what manner",["G4217"]],["of salutation",["G783"]],["this",["G3778"]],["should be.",[]]]},{"verse":30,"text":"And the angel said unto her, Fear not, Mary: for thou hast found favour with God.","words":[["And",["G2532"]],["the angel",["G32"]],["said",["G2036"]],["unto her,",["G846"]],["Fear",["G5399"]],["not,",["G3361"]],["Mary:",["G3137"]],["for",["G1063"]],["thou hast found",["G2147"]],["favour",["G5485"]],["with",["G3844"]],["God.",[]]]},{"verse":31,"text":"And, behold, thou shalt conceive in thy womb, and bring forth a son, and shalt call his name JESUS.","words":[["And,",["G2532"]],["behold,",["G2400"]],["thou shalt conceive",["G4815"]],["in",["G1722"]],["thy womb,",["G1064"]],["and",["G2532"]],["bring forth",["G5088"]],["a son,",["G5207"]],["and",["G2532"]],["shalt call",["G2564"]],["his",["G846"]],["name",["G3686"]],["JESUS.",[]]]},{"verse":32,"text":"He shall be great, and shall be called the Son of the Highest: and the Lord God shall give unto him the throne of his father David:","words":[["He",["G3778"]],["shall be",["G2071"]],["great,",["G3173"]],["and",["G2532"]],["shall be called",["G2564"]],["the Son",["G5207"]],["of the Highest:",["G5310"]],["and",["G2532"]],["the Lord",["G2962"]],["God",["G2316"]],["shall give",["G1325"]],["unto him",["G846"]],["the throne",["G2362"]],["of his",["G846"]],["father",["G3962"]],["David:",[]]]},{"verse":33,"text":"And he shall reign over the house of Jacob for ever; and of his kingdom there shall be no end.","words":[["And",["G2532"]],["he shall reign",["G936"]],["over",["G1909"]],["the house",["G3624"]],["of Jacob",["G2384"]],["for",["G1519"]],["ever;",["G165"]],["and",["G2532"]],["of his",["G846"]],["kingdom",["G932"]],["there shall be",["G2071"]],["no",["G3756"]],["end.",[]]]},{"verse":34,"text":"Then said Mary unto the angel, How shall this be, seeing I know not a man?","words":[["Then",["G1161"]],["said",["G2036"]],["Mary",["G3137"]],["unto",["G4314"]],["the angel,",["G32"]],["How",["G4459"]],["shall",["G2071"]],["this",["G5124"]],["be,",["G2071"]],["seeing",["G1893"]],["I know",["G1097"]],["not",["G3756"]],["a man?",[]]]},{"verse":35,"text":"And the angel answered and said unto her, The Holy Ghost shall come upon thee, and the power of the Highest shall overshadow thee: therefore also that holy thing which shall be born of thee shall be called the Son of God.","words":[["And",["G2532"]],["the angel",["G32"]],["answered",["G611"]],["and said",["G2036"]],["unto her,",["G846"]],["The Holy",["G40"]],["Ghost",["G4151"]],["shall come",["G1904"]],["upon",["G1909"]],["thee,",["G4571"]],["and",["G2532"]],["the power",["G1411"]],["of the Highest",["G5310"]],["shall overshadow",["G1982"]],["thee:",["G4671"]],["therefore",["G1352"]],["also",["G2532"]],["that holy thing",["G40"]],["which shall be born",["G1080"]],["of",["G1537"]],["thee",["G4675"]],["shall be called",["G2564"]],["the Son",["G5207"]],["of God.",[]]]},{"verse":36,"text":"And, behold, thy cousin Elisabeth, she hath also conceived a son in her old age: and this is the sixth month with her, who was called barren.","words":[["And,",["G2532"]],["behold,",["G2400"]],["thy",["G4675"]],["cousin",["G4773"]],["Elisabeth,",["G1665"]],["she",["G846"]],["hath",["G4815"]],["also",["G2532"]],["conceived",["G4815"]],["a son",["G5207"]],["in",["G1722"]],["her",["G846"]],["old age:",["G1094"]],["and",["G2532"]],["this",["G3778"]],["is",["G2076"]],["the sixth",["G1623"]],["month",["G3376"]],["with her,",["G846"]],["who",["G3588"]],["was called",["G2564"]],["barren.",[]]]},{"verse":37,"text":"For with God nothing shall be impossible.","words":[["For",["G3754"]],["with",["G3844"]],["God",["G2316"]],["nothing",["G3756","G3956","G4487"]],["shall be impossible.",[]]]},{"verse":38,"text":"And Mary said, Behold the handmaid of the Lord; be it unto me according to thy word. And the angel departed from her.","words":[["And",["G1161"]],["Mary",["G3137"]],["said,",["G2036"]],["Behold",["G2400"]],["the handmaid",["G1399"]],["of the Lord;",["G2962"]],["be it",["G1096"]],["unto me",["G3427"]],["according",["G2596"]],["to thy",["G4675"]],["word.",["G4487"]],["And",["G2532"]],["the angel",["G32"]],["departed",["G565"]],["from",["G575"]],["her.",[]]]},{"verse":39,"text":"And Mary arose in those days, and went into the hill country with haste, into a city of Juda;","words":[["And",["G1161"]],["Mary",["G3137"]],["arose",["G450"]],["in",["G1722"]],["those",["G5025"]],["days,",["G2250"]],["and went",["G4198"]],["into",["G1519"]],["the hill country",["G3714"]],["with",["G3326"]],["haste,",["G4710"]],["into",["G1519"]],["a city",["G4172"]],["of Juda;",[]]]},{"verse":40,"text":"And entered into the house of Zacharias, and saluted Elisabeth.","words":[["And",["G2532"]],["entered",["G1525"]],["into",["G1519"]],["the house",["G3624"]],["of Zacharias,",["G2197"]],["and",["G2532"]],["saluted",["G782"]],["Elisabeth.",[]]]},{"verse":41,"text":"And it came to pass, that, when Elisabeth heard the salutation of Mary, the babe leaped in her womb; and Elisabeth was filled with the Holy Ghost:","words":[["And",["G2532"]],["it came to pass,",["G1096"]],["that, when",["G5613"]],["Elisabeth",["G1665"]],["heard",["G191"]],["the salutation",["G783"]],["of Mary,",["G3137"]],["the babe",["G1025"]],["leaped",["G4640"]],["in",["G1722"]],["her",["G846"]],["womb;",["G2836"]],["and",["G2532"]],["Elisabeth",["G1665"]],["was filled",["G4130"]],["with the Holy",["G40"]],["Ghost:",[]]]},{"verse":42,"text":"And she spake out with a loud voice, and said, Blessed art thou among women, and blessed is the fruit of thy womb.","words":[["And",["G2532"]],["she spake out",["G400"]],["with a loud",["G3173"]],["voice,",["G5456"]],["and",["G2532"]],["said,",["G2036"]],["Blessed",["G2127"]],["art thou",["G4771"]],["among",["G1722"]],["women,",["G1135"]],["and",["G2532"]],["blessed",["G2127"]],["is the fruit",["G2590"]],["of thy",["G4675"]],["womb.",[]]]},{"verse":43,"text":"And whence is this to me, that the mother of my Lord should come to me?","words":[["And",["G2532"]],["whence",["G4159"]],["is this",["G5124"]],["to me,",["G3427"]],["that",["G2443"]],["the mother",["G3384"]],["of my",["G3450"]],["Lord",["G2962"]],["should come",["G2064"]],["to",["G4314"]],["me?",[]]]},{"verse":44,"text":"For, lo, as soon as the voice of thy salutation sounded in mine ears, the babe leaped in my womb for joy.","words":[["For,",["G1063"]],["lo,",["G2400"]],["as soon as",["G5613"]],["the voice",["G5456"]],["of thy",["G4675"]],["salutation",["G783"]],["sounded",["G1096"]],["in",["G1519"]],["mine",["G3450"]],["ears,",["G3775"]],["the babe",["G1025"]],["leaped",["G4640"]],["in",["G1722"]],["my",["G3450"]],["womb",["G2836"]],["for",["G1722"]],["joy.",[]]]},{"verse":45,"text":"And blessed is she that believed: for there shall be a performance of those things which were told her from the Lord.","words":[["And",["G2532"]],["blessed",["G3107"]],["is she that believed:",["G4100"]],["for",["G3754"]],["there shall be",["G2071"]],["a performance",["G5050"]],["of those things which were told",["G2980"]],["her",["G846"]],["from",["G3844"]],["the Lord.",[]]]},{"verse":46,"text":"And Mary said, My soul doth magnify the Lord,","words":[["And",["G2532"]],["Mary",["G3137"]],["said,",["G2036"]],["My",["G3450"]],["soul",["G5590"]],["doth magnify",["G3170"]],["the Lord,",[]]]},{"verse":47,"text":"And my spirit hath rejoiced in God my Saviour.","words":[["And",["G2532"]],["my",["G3450"]],["spirit",["G4151"]],["hath rejoiced",["G21"]],["in",["G1909"]],["God",["G2316"]],["my",["G3450"]],["Saviour.",[]]]},{"verse":48,"text":"For he hath regarded the low estate of his handmaiden: for, behold, from henceforth all generations shall call me blessed.","words":[["For",["G3754"]],["he hath regarded",["G1914","G1909"]],["the low estate",["G5014"]],["of his",["G846"]],["handmaiden:",["G1399"]],["for,",["G1063"]],["behold,",["G2400"]],["from",["G575"]],["henceforth",["G3568"]],["all",["G3956"]],["generations",["G1074"]],["shall call",["G3106"]],["me",["G3165"]],["blessed.",[]]]},{"verse":49,"text":"For he that is mighty hath done to me great things; and holy is his name.","words":[["For",["G3754"]],["he that is mighty",["G1415"]],["hath done",["G4160"]],["to me",["G3427"]],["great things;",["G3167"]],["and",["G2532"]],["holy",["G40"]],["is his",["G846"]],["name.",[]]]},{"verse":50,"text":"And his mercy is on them that fear him from generation to generation.","words":[["And",["G2532"]],["his",["G846"]],["mercy",["G1656"]],["is on them that fear",["G5399"]],["him",["G846"]],["from",["G1519"]],["generation",["G1074"]],["to generation.",[]]]},{"verse":51,"text":"He hath shewed strength with his arm; he hath scattered the proud in the imagination of their hearts.","words":[["He hath shewed",["G4160"]],["strength",["G2904"]],["with",["G1722"]],["his",["G846"]],["arm;",["G1023"]],["he hath scattered",["G1287"]],["the proud",["G5244"]],["in the imagination",["G1271"]],["of their",["G846"]],["hearts.",[]]]},{"verse":52,"text":"He hath put down the mighty from their seats, and exalted them of low degree.","words":[["He hath put down",["G2507"]],["the mighty",["G1413"]],["from",["G575"]],["their seats,",["G2362"]],["and",["G2532"]],["exalted",["G5312"]],["them of low degree.",[]]]},{"verse":53,"text":"He hath filled the hungry with good things; and the rich he hath sent empty away.","words":[["He hath filled",["G1705"]],["the hungry",["G3983"]],["with good things;",["G18"]],["and",["G2532"]],["the rich",["G4147"]],["he hath sent",["G1821"]],["empty",["G2756"]],["away.",[]]]},{"verse":54,"text":"He hath holpen his servant Israel, in remembrance of his mercy;","words":[["He hath holpen",["G482"]],["his",["G846"]],["servant",["G3816"]],["Israel,",["G2474"]],["in remembrance",["G3415"]],["of his mercy;",[]]]},{"verse":55,"text":"As he spake to our fathers, to Abraham, and to his seed for ever.","words":[["As",["G2531"]],["he spake",["G2980"]],["to",["G4314"]],["our",["G2257"]],["fathers,",["G3962"]],["to Abraham,",["G11"]],["and",["G2532"]],["to his",["G846"]],["seed",["G4690"]],["for",["G1519"]],["ever.",[]]]},{"verse":56,"text":"And Mary abode with her about three months, and returned to her own house.","words":[["And",["G1161"]],["Mary",["G3137"]],["abode",["G3306"]],["with",["G4862"]],["her",["G846"]],["about",["G5616"]],["three",["G5140"]],["months,",["G3376"]],["and",["G2532"]],["returned",["G5290"]],["to",["G1519"]],["her own",["G846"]],["house.",[]]]},{"verse":57,"text":"Now Elisabeth’s full time came that she should be delivered; and she brought forth a son.","words":[["Now",["G1161"]],["Elisabeth’s full",["G4130"]],["time",["G5550"]],["came",["G4130"]],["that she",["G846"]],["should be delivered;",["G5088"]],["and",["G2532"]],["she brought forth",["G1080"]],["a son.",[]]]},{"verse":58,"text":"And her neighbours and her cousins heard how the Lord had shewed great mercy upon her; and they rejoiced with her.","words":[["And",["G2532"]],["her neighbours",["G4040"]],["and",["G2532"]],["her",["G846"]],["cousins",["G4773"]],["heard",["G191"]],["how",["G3754"]],["the Lord",["G2962"]],["had shewed great",["G3170"]],["mercy",["G1656","G846"]],["upon",["G3326"]],["her;",["G846"]],["and",["G2532"]],["they rejoiced",["G4796"]],["with her.",[]]]},{"verse":59,"text":"And it came to pass, that on the eighth day they came to circumcise the child; and they called him Zacharias, after the name of his father.","words":[["And",["G2532"]],["it came to pass,",["G1096"]],["that on",["G1722"]],["the eighth",["G3590"]],["day",["G2250"]],["they came",["G2064"]],["to circumcise",["G4059"]],["the child;",["G3813"]],["and",["G2532"]],["they called",["G2564"]],["him",["G846"]],["Zacharias,",["G2197"]],["after",["G1909"]],["the name",["G3686"]],["of his",["G846"]],["father.",[]]]},{"verse":60,"text":"And his mother answered and said, Not so; but he shall be called John.","words":[["And",["G2532"]],["his",["G846"]],["mother",["G3384"]],["answered",["G611"]],["and said,",["G2036"]],["Not",["G3780"]],["so; but",["G235"]],["he shall be called",["G2564"]],["John.",[]]]},{"verse":61,"text":"And they said unto her, There is none of thy kindred that is called by this name.","words":[["And",["G2532"]],["they said",["G2036"]],["unto",["G4314"]],["her,",["G846","G3754"]],["There is",["G2076"]],["none",["G3762"]],["of",["G1722"]],["thy",["G4675"]],["kindred",["G4772"]],["that",["G3739"]],["is called",["G2564"]],["by this",["G5129"]],["name.",[]]]},{"verse":62,"text":"And they made signs to his father, how he would have him called.","words":[["And",["G1161"]],["they made signs",["G1770"]],["to his",["G846"]],["father,",["G3962"]],["how",["G5101","G302"]],["he would have",["G2309"]],["him",["G846"]],["called.",[]]]},{"verse":63,"text":"And he asked for a writing table, and wrote, saying, His name is John. And they marvelled all.","words":[["And",["G2532"]],["he asked for",["G154"]],["a writing table,",["G4093"]],["and wrote,",["G1125"]],["saying,",["G3004"]],["His",["G846"]],["name",["G3686"]],["is",["G2076"]],["John.",["G2491"]],["And",["G2532"]],["they marvelled",["G2296"]],["all.",[]]]},{"verse":64,"text":"And his mouth was opened immediately, and his tongue loosed, and he spake, and praised God.","words":[["And",["G1161"]],["his",["G846"]],["mouth",["G4750"]],["was opened",["G455"]],["immediately,",["G3916"]],["and",["G2532"]],["his",["G846"]],["tongue",["G1100"]],["loosed, and",["G2532"]],["he spake,",["G2980"]],["and praised",["G2127"]],["God.",[]]]},{"verse":65,"text":"And fear came on all that dwelt round about them: and all these sayings were noised abroad throughout all the hill country of Judea.","words":[["And",["G2532"]],["fear",["G5401"]],["came",["G1096"]],["on",["G1909"]],["all",["G3956"]],["that dwelt round about",["G4039"]],["them:",["G846"]],["and",["G2532"]],["all",["G3956"]],["these",["G5023"]],["sayings",["G4487"]],["were noised abroad",["G1255"]],["throughout",["G1722"]],["all",["G3650"]],["the hill country",["G3714"]],["of Judea.",[]]]},{"verse":66,"text":"And all they that heard them laid them up in their hearts, saying, What manner of child shall this be! And the hand of the Lord was with him.","words":[["And",["G2532"]],["all",["G3956"]],["they that heard",["G191"]],["them laid them up",["G5087"]],["in",["G1722"]],["their",["G846"]],["hearts,",["G2588"]],["saying,",["G3004"]],["What",["G5101"]],["manner",["G686"]],["of child",["G3813"]],["shall",["G2071"]],["this",["G5124"]],["be!",["G2071"]],["And",["G2532"]],["the hand",["G5495"]],["of the Lord",["G2962"]],["was",["G2258"]],["with",["G3326"]],["him.",[]]]},{"verse":67,"text":"And his father Zacharias was filled with the Holy Ghost, and prophesied, saying,","words":[["And",["G2532"]],["his",["G846"]],["father",["G3962"]],["Zacharias",["G2197"]],["was filled",["G4130"]],["with the Holy",["G40"]],["Ghost,",["G4151"]],["and",["G2532"]],["prophesied,",["G4395"]],["saying,",[]]]},{"verse":68,"text":"Blessed be the Lord God of Israel; for he hath visited and redeemed his people,","words":[["Blessed",["G2128"]],["be the Lord",["G2962"]],["God",["G2316"]],["of Israel;",["G2474"]],["for",["G3754"]],["he hath visited",["G1980"]],["and",["G2532"]],["redeemed",["G3085"]],["his",["G846"]],["people,",["G2992"]]]},{"verse":69,"text":"And hath raised up an horn of salvation for us in the house of his servant David;","words":[["And",["G2532"]],["hath raised up",["G1453"]],["an horn",["G2768"]],["of salvation",["G4991"]],["for us",["G2254"]],["in",["G1722"]],["the house",["G3624"]],["of his",["G846"]],["servant",["G3816"]],["David;",[]]]},{"verse":70,"text":"As he spake by the mouth of his holy prophets, which have been since the world began:","words":[["As",["G2531"]],["he spake",["G2980"]],["by",["G1223"]],["the mouth",["G4750"]],["of his",["G846"]],["holy",["G40"]],["prophets,",["G4396"]],["which",["G3588"]],["have been since",["G575"]],["the world began:",[]]]},{"verse":71,"text":"That we should be saved from our enemies, and from the hand of all that hate us;","words":[["That we should be saved",["G4991"]],["from",["G1537"]],["our",["G2257"]],["enemies,",["G2190"]],["and",["G2532"]],["from",["G1537"]],["the hand",["G5495"]],["of all",["G3956"]],["that hate",["G3404"]],["us;",[]]]},{"verse":72,"text":"To perform the mercy promised to our fathers, and to remember his holy covenant;","words":[["To perform",["G4160"]],["the mercy",["G1656"]],["promised to",["G3326"]],["our",["G2257"]],["fathers,",["G3962"]],["and",["G2532"]],["to remember",["G3415"]],["his",["G846"]],["holy",["G40"]],["covenant;",[]]]},{"verse":73,"text":"The oath which he sware to our father Abraham,","words":[["The oath",["G3727"]],["which",["G3739"]],["he sware",["G3660"]],["to",["G4314"]],["our",["G2257"]],["father",["G3962"]],["Abraham,",[]]]},{"verse":74,"text":"That he would grant unto us, that we being delivered out of the hand of our enemies might serve him without fear,","words":[["That he would grant",["G1325"]],["unto us,",["G2254"]],["that we being delivered",["G4506"]],["out of",["G1537"]],["the hand",["G5495"]],["of our",["G2257"]],["enemies",["G2190"]],["might serve",["G3000"]],["him",["G846"]],["without fear,",[]]]},{"verse":75,"text":"In holiness and righteousness before him, all the days of our life.","words":[["In",["G1722"]],["holiness",["G3742"]],["and",["G2532"]],["righteousness",["G1343"]],["before",["G1799"]],["him,",["G846"]],["all",["G3956"]],["the days",["G2250"]],["of our",["G2257"]],["life.",[]]]},{"verse":76,"text":"And thou, child, shalt be called the prophet of the Highest: for thou shalt go before the face of the Lord to prepare his ways;","words":[["And",["G2532"]],["thou,",["G4771"]],["child,",["G3813"]],["shalt be called",["G2564"]],["the prophet",["G4396"]],["of the Highest:",["G5310"]],["for",["G1063"]],["thou shalt go",["G4313"]],["before",["G4253"]],["the face",["G4383"]],["of the Lord",["G2962"]],["to prepare",["G2090"]],["his",["G846"]],["ways;",[]]]},{"verse":77,"text":"To give knowledge of salvation unto his people by the remission of their sins,","words":[["To give",["G1325"]],["knowledge",["G1108"]],["of salvation",["G4991"]],["unto his",["G846"]],["people",["G2992"]],["by",["G1722"]],["the remission",["G859"]],["of their",["G846"]],["sins,",[]]]},{"verse":78,"text":"Through the tender mercy of our God; whereby the dayspring from on high hath visited us,","words":[["Through",["G1223"]],["the tender",["G4698"]],["mercy",["G1656"]],["of our",["G2257"]],["God;",["G2316"]],["whereby",["G1722","G3739"]],["the dayspring",["G395"]],["from",["G1537"]],["on high",["G5311"]],["hath visited",["G1980"]],["us,",[]]]},{"verse":79,"text":"To give light to them that sit in darkness and in the shadow of death, to guide our feet into the way of peace.","words":[["To give light",["G2014"]],["to them that sit",["G2521"]],["in",["G1722"]],["darkness",["G4655"]],["and",["G2532"]],["in the shadow",["G4639"]],["of death,",["G2288"]],["to guide",["G2720"]],["our",["G2257"]],["feet",["G4228"]],["into",["G1519"]],["the way",["G3598"]],["of peace.",[]]]},{"verse":80,"text":"And the child grew, and waxed strong in spirit, and was in the deserts till the day of his shewing unto Israel.","words":[["And",["G1161"]],["the child",["G3813"]],["grew,",["G837"]],["and",["G2532"]],["waxed strong",["G2901"]],["in spirit,",["G4151"]],["and",["G2532"]],["was",["G2258"]],["in",["G1722"]],["the deserts",["G2048"]],["till",["G2193"]],["the day",["G2250"]],["of his",["G846"]],["shewing",["G323"]],["unto",["G4314"]],["Israel.",[]]]}]}