{"book":"Ephesians","chapter":4,"translation":"KJV","url":"/bible/ephesians/4","verses":[{"verse":1,"text":"I therefore, the prisoner of the Lord, beseech you that ye walk worthy of the vocation wherewith ye are called,","words":[["I",["G1473"]],["therefore,",["G3767"]],["the prisoner",["G1198"]],["of",["G1722"]],["the Lord,",["G2962"]],["beseech",["G3870"]],["you",["G5209"]],["that ye walk",["G4043"]],["worthy",["G516"]],["of the vocation",["G2821"]],["wherewith",["G3739"]],["ye are called,",[]]]},{"verse":2,"text":"With all lowliness and meekness, with longsuffering, forbearing one another in love;","words":[["With",["G3326"]],["all",["G3956"]],["lowliness",["G5012"]],["and",["G2532"]],["meekness,",["G4236"]],["with",["G3326"]],["longsuffering,",["G3115"]],["forbearing",["G430"]],["one another",["G240"]],["in",["G1722"]],["love;",[]]]},{"verse":3,"text":"Endeavouring to keep the unity of the Spirit in the bond of peace.","words":[["Endeavouring",["G4704"]],["to keep",["G5083"]],["the unity",["G1775"]],["of the Spirit",["G4151"]],["in",["G1722"]],["the bond",["G4886"]],["of peace.",[]]]},{"verse":4,"text":"There is one body, and one Spirit, even as ye are called in one hope of your calling;","words":[["There is one",["G1520"]],["body,",["G4983"]],["and",["G2532"]],["one",["G1520"]],["Spirit,",["G4151"]],["even as",["G2531","G2532"]],["ye are called",["G2564"]],["in",["G1722"]],["one",["G3391"]],["hope",["G1680"]],["of your",["G5216"]],["calling;",[]]]},{"verse":5,"text":"One Lord, one faith, one baptism,","words":[["One",["G1520"]],["Lord,",["G2962"]],["one",["G1520"]],["faith,",["G4102"]],["one",["G3391"]],["baptism,",[]]]},{"verse":6,"text":"One God and Father of all, who is above all, and through all, and in you all.","words":[["One",["G1520"]],["God",["G2316"]],["and",["G2532"]],["Father",["G3962"]],["of all,",["G3956"]],["who",["G3588"]],["is above",["G1909"]],["all,",["G3956"]],["and",["G2532"]],["through",["G1223"]],["all,",["G3956"]],["and",["G2532"]],["in",["G1722"]],["you",["G5213"]],["all.",[]]]},{"verse":7,"text":"But unto every one of us is given grace according to the measure of the gift of Christ.","words":[["But",["G1161"]],["unto every",["G1538"]],["one",["G1520"]],["of us",["G2257"]],["is given",["G1325"]],["grace",["G5485"]],["according to",["G2596"]],["the measure",["G3358"]],["of the gift",["G1431"]],["of Christ.",[]]]},{"verse":8,"text":"Wherefore he saith, When he ascended up on high, he led captivity captive, and gave gifts unto men.","words":[["Wherefore",["G1352"]],["he saith,",["G3004"]],["When he ascended",["G305"]],["up",["G1519"]],["on high,",["G5311"]],["he led captivity",["G162"]],["captive,",["G161"]],["and",["G2532"]],["gave",["G1325"]],["gifts",["G1390"]],["unto men.",[]]]},{"verse":9,"text":"(Now that he ascended, what is it but that he also descended first into the lower parts of the earth?","words":[["(Now",["G1161"]],["that he ascended,",["G305"]],["what",["G5101"]],["is it",["G2076"]],["but",["G1508"]],["that",["G3754"]],["he",["G2597"]],["also",["G2532"]],["descended",["G2597"]],["first",["G4412"]],["into",["G1519"]],["the lower",["G2737"]],["parts",["G3313"]],["of the earth?",[]]]},{"verse":10,"text":"He that descended is the same also that ascended up far above all heavens, that he might fill all things.)","words":[["He",["G846"]],["that descended",["G2597"]],["is",["G2076"]],["the same also",["G2532"]],["that ascended up",["G305"]],["far above",["G5231"]],["all",["G3956"]],["heavens,",["G3772"]],["that",["G2443"]],["he might fill",["G4137"]],["all things.)",[]]]},{"verse":11,"text":"And he gave some, apostles; and some, prophets; and some, evangelists; and some, pastors and teachers;","words":[["And",["G2532"]],["he",["G846"]],["gave",["G1325"]],["some,",["G3303"]],["apostles;",["G652"]],["and",["G1161"]],["some, prophets;",["G4396"]],["and",["G1161"]],["some, evangelists;",["G2099"]],["and",["G1161"]],["some, pastors",["G4166"]],["and",["G2532"]],["teachers;",[]]]},{"verse":12,"text":"For the perfecting of the saints, for the work of the ministry, for the edifying of the body of Christ:","words":[["For",["G4314"]],["the perfecting",["G2677"]],["of the saints,",["G40"]],["for",["G1519"]],["the work",["G2041"]],["of the ministry,",["G1248"]],["for",["G1519"]],["the edifying",["G3619"]],["of the body",["G4983"]],["of Christ:",[]]]},{"verse":13,"text":"Till we all come in the unity of the faith, and of the knowledge of the Son of God, unto a perfect man, unto the measure of the stature of the fulness of Christ:","words":[["Till",["G3360"]],["we all",["G3956"]],["come",["G2658"]],["in",["G1519"]],["the unity",["G1775"]],["of the faith,",["G4102"]],["and",["G2532"]],["of the knowledge",["G1922"]],["of the Son",["G5207"]],["of God,",["G2316"]],["unto",["G1519"]],["a perfect",["G5046"]],["man,",["G435"]],["unto",["G1519"]],["the measure",["G3358"]],["of the stature",["G2244"]],["of the fulness",["G4138"]],["of Christ:",[]]]},{"verse":14,"text":"That we henceforth be no more children, tossed to and fro, and carried about with every wind of doctrine, by the sleight of men, and cunning craftiness, whereby they lie in wait to deceive;","words":[["That",["G2443"]],["we henceforth be",["G5600"]],["no more",["G3371"]],["children,",["G3516"]],["tossed to and fro,",["G2831"]],["and",["G2532"]],["carried about with",["G4064"]],["every",["G3956"]],["wind",["G417"]],["of doctrine,",["G1319"]],["by",["G1722"]],["the sleight",["G2940"]],["of men,",["G444"]],["and cunning craftiness,",["G1722","G3834"]],["whereby",["G4314"]],["they lie in wait",["G3180"]],["to deceive;",[]]]},{"verse":15,"text":"But speaking the truth in love, may grow up into him in all things, which is the head, even Christ:","words":[["But",["G1161"]],["speaking the truth",["G226"]],["in",["G1722"]],["love,",["G26"]],["may grow up",["G837"]],["into",["G1519"]],["him",["G846"]],["in all things,",["G3956"]],["which",["G3739"]],["is",["G2076"]],["the head,",["G2776"]],["even Christ:",[]]]},{"verse":16,"text":"From whom the whole body fitly joined together and compacted by that which every joint supplieth, according to the effectual working in the measure of every part, maketh increase of the body unto the edifying of itself in love.","words":[["From",["G1537"]],["whom",["G3739"]],["the whole",["G3956"]],["body",["G4983"]],["fitly joined together",["G4883"]],["and",["G2532"]],["compacted",["G4822"]],["by",["G1223"]],["that which every",["G3956"]],["joint",["G860"]],["supplieth,",["G2024"]],["according",["G2596"]],["to the effectual working",["G1753"]],["in",["G1722"]],["the measure",["G3358"]],["of every",["G1538"]],["part,",["G1520","G3313"]],["maketh",["G4160"]],["increase",["G838"]],["of the body",["G4983"]],["unto",["G1519"]],["the edifying",["G3619"]],["of itself",["G1438"]],["in",["G1722"]],["love.",[]]]},{"verse":17,"text":"This I say therefore, and testify in the Lord, that ye henceforth walk not as other Gentiles walk, in the vanity of their mind,","words":[["This",["G5124"]],["I say",["G3004"]],["therefore,",["G3767"]],["and",["G2532"]],["testify",["G3143"]],["in",["G1722"]],["the Lord,",["G2962"]],["that ye",["G5209"]],["henceforth",["G3371"]],["walk",["G4043"]],["not",["G3371"]],["as",["G2531","G2532"]],["other",["G3062"]],["Gentiles",["G1484"]],["walk,",["G4043"]],["in",["G1722"]],["the vanity",["G3153"]],["of their",["G846"]],["mind,",[]]]},{"verse":18,"text":"Having the understanding darkened, being alienated from the life of God through the ignorance that is in them, because of the blindness of their heart:","words":[["Having the understanding",["G1271"]],["darkened,",["G4654"]],["being",["G5607"]],["alienated",["G526"]],["from the life",["G2222"]],["of God",["G2316"]],["through",["G1223"]],["the ignorance",["G52"]],["that is",["G5607"]],["in",["G1722"]],["them,",["G846"]],["because",["G1223"]],["of the blindness",["G4457"]],["of their",["G846"]],["heart:",[]]]},{"verse":19,"text":"Who being past feeling have given themselves over unto lasciviousness, to work all uncleanness with greediness.","words":[["Who",["G3748"]],["being past feeling",["G524"]],["have given",["G3860"]],["themselves",["G1438"]],["over",["G3860"]],["unto lasciviousness,",["G766"]],["to",["G1519"]],["work",["G2039"]],["all",["G3956"]],["uncleanness",["G167"]],["with",["G1722"]],["greediness.",[]]]},{"verse":20,"text":"But ye have not so learned Christ;","words":[["But",["G1161"]],["ye",["G5210"]],["have",["G3129"]],["not",["G3756"]],["so",["G3779"]],["learned",["G3129"]],["Christ;",[]]]},{"verse":21,"text":"If so be that ye have heard him, and have been taught by him, as the truth is in Jesus:","words":[["If so be that",["G1489"]],["ye have heard",["G191"]],["him,",["G846"]],["and",["G2532"]],["have been taught",["G1321"]],["by",["G1722"]],["him,",["G846"]],["as",["G2531"]],["the truth",["G225"]],["is",["G2076"]],["in",["G1722"]],["Jesus:",[]]]},{"verse":22,"text":"That ye put off concerning the former conversation the old man, which is corrupt according to the deceitful lusts;","words":[["That ye",["G5209"]],["put off",["G659"]],["concerning",["G2596"]],["the former",["G4387"]],["conversation",["G391"]],["the old",["G3820"]],["man,",["G444"]],["which",["G3588"]],["is corrupt",["G5351"]],["according",["G2596"]],["to the deceitful",["G539"]],["lusts;",[]]]},{"verse":23,"text":"And be renewed in the spirit of your mind;","words":[["And",["G1161"]],["be renewed",["G365"]],["in the spirit",["G4151"]],["of your",["G5216"]],["mind;",[]]]},{"verse":24,"text":"And that ye put on the new man, which after God is created in righteousness and true holiness.","words":[["And",["G2532"]],["that ye put on",["G1746"]],["the new",["G2537"]],["man,",["G444"]],["which",["G3588"]],["after",["G2596"]],["God",["G2316"]],["is created",["G2936"]],["in",["G1722"]],["righteousness",["G1343"]],["and",["G2532"]],["true",["G225"]],["holiness.",[]]]},{"verse":25,"text":"Wherefore putting away lying, speak every man truth with his neighbour: for we are members one of another.","words":[["Wherefore",["G1352"]],["putting away",["G659"]],["lying,",["G5579"]],["speak",["G2980"]],["every man",["G1538"]],["truth",["G225"]],["with",["G3326"]],["his",["G846"]],["neighbour:",["G4139"]],["for",["G3754"]],["we are",["G2070"]],["members",["G3196"]],["one of another.",[]]]},{"verse":26,"text":"Be ye angry, and sin not: let not the sun go down upon your wrath:","words":[["Be ye angry,",["G3710"]],["and",["G2532"]],["sin",["G264"]],["not:",["G3361"]],["let",["G1931"]],["not",["G3361"]],["the sun",["G2246"]],["go down",["G1931"]],["upon",["G1909"]],["your",["G5216"]],["wrath:",[]]]},{"verse":27,"text":"Neither give place to the devil.","words":[["Neither",["G3383"]],["give",["G1325"]],["place",["G5117"]],["to the devil.",[]]]},{"verse":28,"text":"Let him that stole steal no more: but rather let him labour, working with his hands the thing which is good, that he may have to give to him that needeth.","words":[["Let",["G2813"]],["him that stole",["G2813"]],["steal",["G2813"]],["no more:",["G3371"]],["but",["G1161"]],["rather",["G3123"]],["let him labour,",["G2872"]],["working",["G2038"]],["with his hands",["G5495"]],["the thing which is good,",["G18"]],["that",["G2443"]],["he may have",["G2192"]],["to give",["G3330"]],["to him that needeth.",["G5532"]]]},{"verse":29,"text":"Let no corrupt communication proceed out of your mouth, but that which is good to the use of edifying, that it may minister grace unto the hearers.","words":[["Let",["G4550"]],["no",["G3361","G3956"]],["corrupt",["G4550"]],["communication",["G3056"]],["proceed",["G1607"]],["out of",["G1537"]],["your",["G5216"]],["mouth,",["G4750"]],["but",["G235"]],["that which",["G1536"]],["is good",["G18"]],["to",["G4314"]],["the use",["G5532"]],["of edifying,",["G3619"]],["that",["G2443"]],["it may minister",["G1325"]],["grace",["G5485"]],["unto the hearers.",[]]]},{"verse":30,"text":"And grieve not the holy Spirit of God, whereby ye are sealed unto the day of redemption.","words":[["And",["G2532"]],["grieve",["G3076"]],["not",["G3361"]],["the holy",["G40"]],["Spirit",["G4151"]],["of God,",["G2316"]],["whereby",["G1722","G3739"]],["ye are sealed",["G4972"]],["unto",["G1519"]],["the day",["G2250"]],["of redemption.",[]]]},{"verse":31,"text":"Let all bitterness, and wrath, and anger, and clamour, and evil speaking, be put away from you, with all malice:","words":[["Let",["G142"]],["all",["G3956"]],["bitterness,",["G4088"]],["and",["G2532"]],["wrath,",["G2372"]],["and",["G2532"]],["anger,",["G3709"]],["and",["G2532"]],["clamour,",["G2906"]],["and",["G2532"]],["evil speaking,",["G988"]],["be put away",["G142"]],["from",["G575"]],["you,",["G5216"]],["with",["G4862"]],["all",["G3956"]],["malice:",[]]]},{"verse":32,"text":"And be ye kind one to another, tenderhearted, forgiving one another, even as God for Christ’s sake hath forgiven you.","words":[["And",["G1161"]],["be",["G1096"]],["ye kind",["G5543"]],["one to another,",["G1519","G240"]],["tenderhearted,",["G2155"]],["forgiving",["G5483"]],["one another,",["G1438"]],["even as",["G2531","G2532"]],["God",["G2316"]],["for",["G1722"]],["Christ’s sake",["G1722"]],["hath forgiven",["G5483"]],["you.",[]]]}]}