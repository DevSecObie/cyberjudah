{"book":"Ephesians","chapter":5,"translation":"KJV","url":"/bible/ephesians/5","verses":[{"verse":1,"text":"Be ye therefore followers of God, as dear children;","words":[["Be",["G1096"]],["ye",["G3402"]],["therefore",["G3767"]],["followers",["G3402"]],["of God,",["G2316"]],["as",["G5613"]],["dear",["G27"]],["children;",[]]]},{"verse":2,"text":"And walk in love, as Christ also hath loved us, and hath given himself for us an offering and a sacrifice to God for a sweetsmelling savour.","words":[["And",["G2532"]],["walk",["G4043"]],["in",["G1722"]],["love,",["G26"]],["as",["G2531"]],["Christ",["G5547"]],["also",["G2532"]],["hath loved",["G25"]],["us,",["G2248"]],["and",["G2532"]],["hath given",["G3860"]],["himself",["G1438"]],["for",["G5228"]],["us",["G2257"]],["an offering",["G4376"]],["and",["G2532"]],["a sacrifice",["G2378"]],["to God",["G2316"]],["for",["G1519"]],["a sweetsmelling",["G2175"]],["savour.",[]]]},{"verse":3,"text":"But fornication, and all uncleanness, or covetousness, let it not be once named among you, as becometh saints;","words":[["But",["G2532"]],["fornication,",["G4202"]],["and",["G1161"]],["all",["G3956"]],["uncleanness,",["G167"]],["or",["G2228"]],["covetousness,",["G4124"]],["let it",["G3687"]],["not be once",["G3366"]],["named",["G3687"]],["among",["G1722"]],["you,",["G5213"]],["as",["G2531"]],["becometh",["G4241"]],["saints;",[]]]},{"verse":4,"text":"Neither filthiness, nor foolish talking, nor jesting, which are not convenient: but rather giving of thanks.","words":[["Neither",["G2532"]],["filthiness,",["G151"]],["nor",["G2532"]],["foolish talking,",["G3473"]],["nor",["G2228"]],["jesting,",["G2160"]],["which",["G3588"]],["are",["G433"]],["not",["G3756"]],["convenient:",["G433"]],["but",["G235"]],["rather",["G3123"]],["giving of thanks.",[]]]},{"verse":5,"text":"For this ye know, that no whoremonger, nor unclean person, nor covetous man, who is an idolater, hath any inheritance in the kingdom of Christ and of God.","words":[["For",["G1063"]],["this",["G5124"]],["ye know,",["G2075","G1097"]],["that",["G3754"]],["no",["G3756","G3956"]],["whoremonger,",["G4205"]],["nor",["G2228"]],["unclean person,",["G169"]],["nor",["G2228"]],["covetous man,",["G4123"]],["who",["G3739"]],["is",["G2076"]],["an idolater,",["G1496"]],["hath",["G2192"]],["any inheritance",["G2817"]],["in",["G1722"]],["the kingdom",["G932"]],["of Christ",["G5547"]],["and",["G2532"]],["of God.",[]]]},{"verse":6,"text":"Let no man deceive you with vain words: for because of these things cometh the wrath of God upon the children of disobedience.","words":[["Let",["G538"]],["no man",["G3367"]],["deceive",["G538"]],["you",["G5209"]],["with vain",["G2756"]],["words:",["G3056"]],["for",["G1063"]],["because",["G1223"]],["of these things",["G5023"]],["cometh",["G2064"]],["the wrath",["G3709"]],["of God",["G2316"]],["upon",["G1909"]],["the children",["G5207"]],["of disobedience.",[]]]},{"verse":7,"text":"Be not ye therefore partakers with them.","words":[["Be",["G1096"]],["not",["G3361"]],["ye",["G1096"]],["therefore",["G3767"]],["partakers",["G4830"]],["with them.",[]]]},{"verse":8,"text":"For ye were sometimes darkness, but now are ye light in the Lord: walk as children of light:","words":[["For",["G1063"]],["ye were",["G2258"]],["sometimes",["G4218"]],["darkness,",["G4655"]],["but",["G1161"]],["now",["G3568"]],["are ye light",["G5457"]],["in",["G1722"]],["the Lord:",["G2962"]],["walk",["G4043"]],["as",["G5613"]],["children",["G5043"]],["of light:",[]]]},{"verse":9,"text":"(For the fruit of the Spirit is in all goodness and righteousness and truth;)","words":[["(For",["G1063"]],["the fruit",["G2590"]],["of the Spirit",["G4151"]],["is in",["G1722"]],["all",["G3956"]],["goodness",["G19"]],["and",["G2532"]],["righteousness",["G1343"]],["and",["G2532"]],["truth;)",[]]]},{"verse":10,"text":"Proving what is acceptable unto the Lord.","words":[["Proving",["G1381"]],["what",["G5101"]],["is",["G2076"]],["acceptable",["G2101"]],["unto the Lord.",[]]]},{"verse":11,"text":"And have no fellowship with the unfruitful works of darkness, but rather reprove them.","words":[["And",["G2532"]],["have",["G4790"]],["no",["G3361"]],["fellowship",["G4790"]],["with the unfruitful",["G175"]],["works",["G2041"]],["of darkness,",["G4655"]],["but",["G1161"]],["rather",["G3123","G2532"]],["reprove them.",[]]]},{"verse":12,"text":"For it is a shame even to speak of those things which are done of them in secret.","words":[["For",["G1063"]],["it is",["G2076"]],["a shame",["G149"]],["even",["G2532"]],["to speak",["G3004"]],["of those things",["G2931"]],["which are done",["G1096"]],["of",["G5259"]],["them",["G846"]],["in secret.",[]]]},{"verse":13,"text":"But all things that are reproved are made manifest by the light: for whatsoever doth make manifest is light.","words":[["But",["G1161"]],["all things",["G3956"]],["that are reproved",["G1651"]],["are made manifest",["G5319"]],["by",["G5259"]],["the light:",["G5457"]],["for",["G1063"]],["whatsoever",["G3956"]],["doth make manifest",["G5319"]],["is",["G2076"]],["light.",[]]]},{"verse":14,"text":"Wherefore he saith, Awake thou that sleepest, and arise from the dead, and Christ shall give thee light.","words":[["Wherefore",["G1352"]],["he saith,",["G3004"]],["Awake thou",["G1453"]],["that sleepest,",["G2518"]],["and",["G2532"]],["arise",["G450"]],["from",["G1537"]],["the dead,",["G3498"]],["and",["G2532"]],["Christ",["G5547"]],["shall give",["G2017"]],["thee",["G4671"]],["light.",[]]]},{"verse":15,"text":"See then that ye walk circumspectly, not as fools, but as wise,","words":[["See",["G991"]],["then",["G3767"]],["that",["G4459"]],["ye walk",["G4043"]],["circumspectly,",["G199"]],["not",["G3361"]],["as",["G5613"]],["fools,",["G781"]],["but",["G235"]],["as",["G5613"]],["wise,",[]]]},{"verse":16,"text":"Redeeming the time, because the days are evil.","words":[["Redeeming",["G1805"]],["the time,",["G2540"]],["because",["G3754"]],["the days",["G2250"]],["are",["G1526"]],["evil.",[]]]},{"verse":17,"text":"Wherefore be ye not unwise, but understanding what the will of the Lord is.","words":[["Wherefore",["G1223","G5124"]],["be ye",["G1096"]],["not",["G3361"]],["unwise,",["G878"]],["but",["G235"]],["understanding",["G4920"]],["what",["G5101"]],["the will",["G2307"]],["of the Lord is.",[]]]},{"verse":18,"text":"And be not drunk with wine, wherein is excess; but be filled with the Spirit;","words":[["And",["G2532"]],["be",["G3182"]],["not",["G3361"]],["drunk",["G3182"]],["with wine,",["G3631"]],["wherein",["G1722","G3739"]],["is",["G2076"]],["excess;",["G810"]],["but",["G235"]],["be filled",["G4137"]],["with",["G1722"]],["the Spirit;",[]]]},{"verse":19,"text":"Speaking to yourselves in psalms and hymns and spiritual songs, singing and making melody in your heart to the Lord;","words":[["Speaking",["G2980"]],["to yourselves",["G1438"]],["in psalms",["G5568"]],["and",["G2532"]],["hymns",["G5215"]],["and",["G2532"]],["spiritual",["G4152"]],["songs,",["G5603"]],["singing",["G103"]],["and",["G2532"]],["making melody",["G5567"]],["in",["G1722"]],["your",["G5216"]],["heart",["G2588"]],["to the Lord;",[]]]},{"verse":20,"text":"Giving thanks always for all things unto God and the Father in the name of our Lord Jesus Christ;","words":[["Giving thanks",["G2168"]],["always",["G3842"]],["for",["G5228"]],["all things",["G3956"]],["unto God",["G2316"]],["and",["G2532"]],["the Father",["G3962"]],["in",["G1722"]],["the name",["G3686"]],["of our",["G2257"]],["Lord",["G2962"]],["Jesus",["G2424"]],["Christ;",[]]]},{"verse":21,"text":"Submitting yourselves one to another in the fear of God.","words":[["Submitting yourselves",["G5293"]],["one to another",["G240"]],["in",["G1722"]],["the fear",["G5401"]],["of God.",[]]]},{"verse":22,"text":"Wives, submit yourselves unto your own husbands, as unto the Lord.","words":[["Wives,",["G1135"]],["submit yourselves",["G5293"]],["unto your own",["G2398"]],["husbands,",["G435"]],["as",["G5613"]],["unto the Lord.",[]]]},{"verse":23,"text":"For the husband is the head of the wife, even as Christ is the head of the church: and he is the saviour of the body.","words":[["For",["G3754"]],["the husband",["G435"]],["is",["G2076"]],["the head",["G2776"]],["of the wife,",["G1135"]],["even",["G2532"]],["as",["G5613"]],["Christ",["G5547"]],["is the head",["G2776"]],["of the church:",["G1577"]],["and",["G2532"]],["he",["G846"]],["is",["G2076"]],["the saviour",["G4990"]],["of the body.",[]]]},{"verse":24,"text":"Therefore as the church is subject unto Christ, so let the wives be to their own husbands in every thing.","words":[["Therefore",["G235"]],["as",["G5618"]],["the church",["G1577"]],["is subject",["G5293"]],["unto Christ,",["G5547"]],["so",["G3779","G2532"]],["let the wives",["G1135"]],["be to their own",["G2398"]],["husbands",["G435"]],["in",["G1722"]],["every thing.",[]]]},{"verse":25,"text":"Husbands, love your wives, even as Christ also loved the church, and gave himself for it;","words":[["Husbands,",["G435"]],["love",["G25"]],["your",["G1438"]],["wives,",["G1135"]],["even as",["G2531"]],["Christ",["G5547"]],["also",["G2532"]],["loved",["G25"]],["the church,",["G1577"]],["and",["G2532"]],["gave",["G3860"]],["himself",["G1438"]],["for",["G5228"]],["it;",[]]]},{"verse":26,"text":"That he might sanctify and cleanse it with the washing of water by the word,","words":[["That",["G2443"]],["he might sanctify",["G37"]],["and cleanse it",["G2511"]],["with the washing",["G3067"]],["of water",["G5204"]],["by",["G1722"]],["the word,",[]]]},{"verse":27,"text":"That he might present it to himself a glorious church, not having spot, or wrinkle, or any such thing; but that it should be holy and without blemish.","words":[["That",["G2443"]],["he might present",["G3936"]],["it",["G846"]],["to himself",["G1438"]],["a glorious",["G1741"]],["church,",["G1577"]],["not",["G3361"]],["having",["G2192"]],["spot,",["G4696"]],["or",["G2228"]],["wrinkle,",["G4512"]],["or",["G2228"]],["any",["G5100"]],["such thing;",["G5108"]],["but",["G235"]],["that",["G2443"]],["it should be",["G5600"]],["holy",["G40"]],["and",["G2532"]],["without blemish.",[]]]},{"verse":28,"text":"So ought men to love their wives as their own bodies. He that loveth his wife loveth himself.","words":[["So",["G3779"]],["ought",["G3784"]],["men",["G435"]],["to love",["G25"]],["their",["G1438"]],["wives",["G1135"]],["as",["G5613"]],["their own",["G1438"]],["bodies.",["G4983"]],["He that loveth",["G25"]],["his",["G1438"]],["wife",["G1135"]],["loveth",["G25"]],["himself.",[]]]},{"verse":29,"text":"For no man ever yet hated his own flesh; but nourisheth and cherisheth it, even as the Lord the church:","words":[["For",["G1063"]],["no man",["G3762"]],["ever yet",["G4218"]],["hated",["G3404"]],["his own",["G1438"]],["flesh;",["G4561"]],["but",["G235"]],["nourisheth",["G1625"]],["and",["G2532"]],["cherisheth",["G2282"]],["it,",["G846"]],["even as",["G2531","G2532"]],["the Lord",["G2962"]],["the church:",[]]]},{"verse":30,"text":"For we are members of his body, of his flesh, and of his bones.","words":[["For",["G3754"]],["we are",["G2070"]],["members",["G3196"]],["of his",["G846"]],["body,",["G4983"]],["of",["G1537"]],["his",["G846"]],["flesh,",["G4561"]],["and",["G2532"]],["of",["G1537"]],["his",["G846"]],["bones.",[]]]},{"verse":31,"text":"For this cause shall a man leave his father and mother, and shall be joined unto his wife, and they two shall be one flesh.","words":[["For",["G473"]],["this cause",["G5127"]],["shall",["G2641"]],["a man",["G444"]],["leave",["G2641"]],["his",["G846"]],["father",["G3962"]],["and",["G2532"]],["mother,",["G3384"]],["and",["G2532"]],["shall be joined",["G4347"]],["unto",["G4314"]],["his",["G846"]],["wife,",["G1135"]],["and",["G2532"]],["they two",["G1417"]],["shall be",["G2071"]],["one",["G1519","G3391"]],["flesh.",[]]]},{"verse":32,"text":"This is a great mystery: but I speak concerning Christ and the church.","words":[["This",["G5124"]],["is",["G2076"]],["a great",["G3173"]],["mystery:",["G3466"]],["but",["G1161"]],["I",["G1473"]],["speak",["G3004"]],["concerning",["G1519"]],["Christ",["G5547"]],["and",["G1519","G2532"]],["the church.",[]]]},{"verse":33,"text":"Nevertheless let every one of you in particular so love his wife even as himself; and the wife see that she reverence her husband.","words":[["Nevertheless",["G4133","G2532"]],["let",["G25"]],["every one",["G1520","G1538"]],["of you",["G5210"]],["in particular",["G2596"]],["so",["G3779"]],["love",["G25"]],["his",["G1438"]],["wife",["G1135"]],["even as",["G5613"]],["himself;",["G1438"]],["and",["G1161"]],["the wife",["G1135"]],["see that",["G2443"]],["she reverence",["G5399"]],["her husband.",[]]]}]}