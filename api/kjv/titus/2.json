{"book":"Titus","chapter":2,"translation":"KJV","url":"/bible/titus/2","verses":[{"verse":1,"text":"But speak thou the things which become sound doctrine:","words":[["But",["G1161"]],["speak",["G2980"]],["thou",["G4771"]],["the things which",["G3739"]],["become",["G4241"]],["sound",["G5198"]],["doctrine:",[]]]},{"verse":2,"text":"That the aged men be sober, grave, temperate, sound in faith, in charity, in patience.","words":[["That the aged men",["G4246"]],["be",["G1511"]],["sober,",["G3524"]],["grave,",["G4586"]],["temperate,",["G4998"]],["sound",["G5198"]],["in faith,",["G4102"]],["in charity,",["G26"]],["in patience.",[]]]},{"verse":3,"text":"The aged women likewise, that they be in behaviour as becometh holiness, not false accusers, not given to much wine, teachers of good things;","words":[["The aged women",["G4247"]],["likewise,",["G5615"]],["that they be in",["G1722"]],["behaviour",["G2688"]],["as becometh holiness,",["G2412"]],["not",["G3361"]],["false accusers,",["G1228"]],["not",["G3361"]],["given",["G1402"]],["to much",["G4183"]],["wine,",["G3631"]],["teachers of good things;",[]]]},{"verse":4,"text":"That they may teach the young women to be sober, to love their husbands, to love their children,","words":[["That",["G2443"]],["they may teach",["G4994"]],["the young women",["G3501"]],["to be",["G1511"]],["sober,",["G4994"]],["to love their husbands,",["G5362"]],["to love their children,",[]]]},{"verse":5,"text":"To be discreet, chaste, keepers at home, good, obedient to their own husbands, that the word of God be not blasphemed.","words":[["To be discreet,",["G4998"]],["chaste,",["G53"]],["keepers at home,",["G3626"]],["good,",["G18"]],["obedient",["G5293"]],["to their own",["G2398"]],["husbands,",["G435"]],["that",["G3363"]],["the word",["G3056"]],["of God",["G2316"]],["be",["G987"]],["not",["G3363"]],["blasphemed.",[]]]},{"verse":6,"text":"Young men likewise exhort to be sober minded.","words":[["Young men",["G3501"]],["likewise",["G5615"]],["exhort",["G3870"]],["to be sober minded.",[]]]},{"verse":7,"text":"In all things shewing thyself a pattern of good works: in doctrine shewing uncorruptness, gravity, sincerity,","words":[["In",["G4012"]],["all things",["G3956"]],["shewing",["G3930"]],["thyself",["G4572"]],["a pattern",["G5179"]],["of good",["G2570"]],["works:",["G2041"]],["in",["G1722"]],["doctrine",["G1319"]],["shewing uncorruptness,",["G90"]],["gravity,",["G4587"]],["sincerity,",[]]]},{"verse":8,"text":"Sound speech, that cannot be condemned; that he that is of the contrary part may be ashamed, having no evil thing to say of you.","words":[["Sound",["G5199"]],["speech,",["G3056"]],["that cannot be condemned;",["G176"]],["that",["G2443"]],["he that is of",["G1537"]],["the contrary part",["G1727"]],["may be ashamed,",["G1788"]],["having",["G2192"]],["no",["G3367"]],["evil",["G5337"]],["thing",["G3367"]],["to say",["G3004"]],["of",["G4012"]],["you.",[]]]},{"verse":9,"text":"Exhort servants to be obedient unto their own masters, and to please them well in all things; not answering again;","words":[["Exhort servants",["G1401"]],["to be obedient",["G5293"]],["unto their own",["G2398"]],["masters,",["G1203"]],["and to",["G1511"]],["please them well",["G2101"]],["in",["G1722"]],["all",["G3956"]],["things; not",["G3361"]],["answering again;",[]]]},{"verse":10,"text":"Not purloining, but shewing all good fidelity; that they may adorn the doctrine of God our Saviour in all things.","words":[["Not",["G3361"]],["purloining,",["G3557"]],["but",["G235"]],["shewing",["G1731"]],["all",["G3956"]],["good",["G18"]],["fidelity;",["G4102"]],["that",["G2443"]],["they may adorn",["G2885"]],["the doctrine",["G1319"]],["of God",["G2316"]],["our",["G2257"]],["Saviour",["G4990"]],["in",["G1722"]],["all things.",[]]]},{"verse":11,"text":"For the grace of God that bringeth salvation hath appeared to all men,","words":[["For",["G1063"]],["the grace",["G5485"]],["of God",["G2316"]],["that bringeth salvation",["G4992"]],["hath appeared",["G2014"]],["to all",["G3956"]],["men,",[]]]},{"verse":12,"text":"Teaching us that, denying ungodliness and worldly lusts, we should live soberly, righteously, and godly, in this present world;","words":[["Teaching",["G3811"]],["us",["G2248"]],["that,",["G2443"]],["denying",["G720"]],["ungodliness",["G763"]],["and",["G2532"]],["worldly",["G2886"]],["lusts,",["G1939"]],["we should live",["G2198"]],["soberly,",["G4996","G2532"]],["righteously,",["G1346"]],["and",["G2532"]],["godly,",["G2153"]],["in",["G1722"]],["this present",["G3568"]],["world;",[]]]},{"verse":13,"text":"Looking for that blessed hope, and the glorious appearing of the great God and our Saviour Jesus Christ;","words":[["Looking for",["G4327"]],["that blessed",["G3107"]],["hope,",["G1680"]],["and",["G2532"]],["the glorious",["G1391"]],["appearing",["G2015"]],["of the great",["G3173"]],["God",["G2316"]],["and",["G2532"]],["our",["G2257"]],["Saviour",["G4990"]],["Jesus",["G2424"]],["Christ;",[]]]},{"verse":14,"text":"Who gave himself for us, that he might redeem us from all iniquity, and purify unto himself a peculiar people, zealous of good works.","words":[["Who",["G3739"]],["gave",["G1325"]],["himself",["G1438"]],["for",["G5228"]],["us,",["G2257"]],["that",["G2443"]],["he might redeem",["G3084"]],["us",["G2248"]],["from",["G575"]],["all",["G3956"]],["iniquity,",["G458"]],["and",["G2532"]],["purify",["G2511"]],["unto himself",["G1438"]],["a peculiar",["G4041"]],["people,",["G2992"]],["zealous",["G2207"]],["of good",["G2570"]],["works.",[]]]},{"verse":15,"text":"These things speak, and exhort, and rebuke with all authority. Let no man despise thee.","words":[["These things",["G5023"]],["speak,",["G2980"]],["and",["G2532"]],["exhort,",["G3870"]],["and",["G2532"]],["rebuke",["G1651"]],["with",["G3326"]],["all",["G3956"]],["authority.",["G2003"]],["Let",["G4065"]],["no man",["G3367"]],["despise",["G4065"]],["thee.",[]]]}]}