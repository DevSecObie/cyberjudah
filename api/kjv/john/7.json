{"book":"John","chapter":7,"translation":"KJV","url":"/bible/john/7","verses":[{"verse":1,"text":"After these things Jesus walked in Galilee: for he would not walk in Jewry, because the Jews sought to kill him.","words":[["After",["G3326"]],["these things",["G5023"]],["Jesus",["G2424"]],["walked",["G4043"]],["in",["G1722"]],["Galilee:",["G1056"]],["for",["G1063"]],["he would",["G2309"]],["not",["G3756"]],["walk",["G4043"]],["in",["G1722"]],["Jewry,",["G2449"]],["because",["G3754"]],["the Jews",["G2453"]],["sought",["G2212"]],["to kill",["G615"]],["him.",[]]]},{"verse":2,"text":"Now the Jews’ feast of tabernacles was at hand.","words":[["Now",["G1161"]],["the Jews’",["G2453"]],["feast",["G1859"]],["of tabernacles",["G4634"]],["was",["G2258"]],["at hand.",[]]]},{"verse":3,"text":"His brethren therefore said unto him, Depart hence, and go into Judea, that thy disciples also may see the works that thou doest.","words":[["His",["G846"]],["brethren",["G80"]],["therefore",["G3767"]],["said",["G2036"]],["unto",["G4314"]],["him,",["G846"]],["Depart",["G3327"]],["hence,",["G1782"]],["and",["G2532"]],["go",["G5217"]],["into",["G1519"]],["Judea,",["G2449"]],["that",["G2443"]],["thy",["G4675"]],["disciples",["G3101"]],["also",["G2532"]],["may see",["G2334"]],["the works",["G2041"]],["that",["G3739"]],["thou",["G4675"]],["doest.",[]]]},{"verse":4,"text":"For there is no man that doeth any thing in secret, and he himself seeketh to be known openly. If thou do these things, shew thyself to the world.","words":[["For",["G1063"]],["there is no man",["G3762"]],["that doeth",["G4160"]],["any thing",["G5100"]],["in",["G1722"]],["secret,",["G2927"]],["and",["G2532"]],["he himself",["G846"]],["seeketh",["G2212"]],["to be",["G1511"]],["known openly.",["G1722","G3954"]],["If",["G1487"]],["thou do",["G4160"]],["these things,",["G5023"]],["shew",["G5319"]],["thyself",["G4572"]],["to the world.",[]]]},{"verse":5,"text":"For neither did his brethren believe in him.","words":[["For",["G1063"]],[