ver",["G3361"]],["learned?",[]]]},{"verse":16,"text":"Jesus answered them, and said, My doctrine is not mine, but his that sent me.","words":[["Jesus",["G2424"]],["answered",["G611"]],["them,",["G846"]],["and",["G2532"]],["said,",["G2036"]],["My",["G1699"]],["doctrine",["G1322"]],["is",["G2076"]],["not",["G3756"]],["mine,",["G1699"]],["but",["G235"]],["his that sent",["G3992"]],["me.",[]]]},{"verse":17,"text":"If any man will do his will, he shall know of the doctrine, whether it be of God, or whether I speak of myself.","words":[["If",["G1437"]],["any man",["G5100"]],["will",["G2309"]],["do",["G4160"]],["his",["G846"]],["will,",["G2307"]],["he shall know",["G1097"]],["of",["G4012"]],["the doctrine,",["G1322"]],["whether",["G4220"]],["it be",["G2076"]],["of",["G1537"]],["God,",["G2316"]],["or",["G2228"]],["whether I",["G1473"]],["speak",["G2980"]],["of",["G575"]],["myself.",[]]]},{"verse":18,"text":"He that speaketh of himself seeketh his own glory: but he that seeketh his glory that sent him, the same is true, and no unrighteousness is in him.","words":[["He that speaketh",["G2980"]],["of",["G575"]],["himself",["G1438"]],["seeketh",["G2212"]],["his own",["G2398"]],["glory:",["G1391"]],["but",["G1161"]],["he that seeketh",["G2212"]],["his glory",["G1391"]],["that sent",["G3992"]],["him,",["G846"]],["the same",["G3778"]],["is",["G2076"]],["true,",["G227"]],["and",["G2532"]],["no",["G3756"]],["unrighteousness",["G93"]],["is",["G2076"]],["in",["G1722"]],["him.",[]]]},{"verse":19,"text":"Did not Moses give you the law, and yet none of you keepeth the law? Why go ye about to kill me?","words":[["Did",["G1325"]],["not",["G3756"]],["Moses",["G3475"]],["give",["G1325"]],["you",["G5213"]],["the law,",["G3551"]],["and",["G2532"]],["yet none",["G3762"]],["of",["G1537"]],["you",["G5216"]],["keepeth",["G4160"]],["the law?",["G3551"]],["Why",["G5101"]],["go ye about",["G2212"]],["to kill",["G615"]],["me?",[]]]},{"verse":20,"text":"The people answered and said, Thou hast a devil: who goeth about to kill thee?","words":[["The people",["G3793"]],["answered",["G611"]],["and",["G2532"]],["said,",["G2036"]],["Thou hast",["G2192"]],["a devil:",["G1140"]],["who",["G5101"]],["goeth about",["G2212"]],["to kill",["G615"]],["thee?",[]]]},{"verse":21,"text":"Jesus answered and said unto them, I have done one work, and ye all marvel.","words":[["Jesus",["G2424"]],["answered",["G611"]],["and",["G2532"]],["said",["G2036"]],["unto them,",["G846"]],["I have done",["G4160"]],["one",["G1520"]],["work,",["G2041"]],["and",["G2532"]],["ye",["G2296"]],["all",["G3956"]],["marvel.",[]]]},{"verse":22,"text":"Moses therefore gave unto you circumcision; (not because it is of Moses, but of the fathers;) and ye on the sabbath day circumcise a man.","words":[["Moses",["G3475"]],["therefore",["G1223","G5124"]],["gave",["G1325"]],["unto you",["G5213"]],["circumcision;",["G4061"]],["(not",["G3756"]],["because",["G3754"]],["it is",["G2076"]],["of",["G1537"]],["Moses,",["G3475"]],["but",["G235"]],["of",["G1537"]],["the fathers;)",["G3962"]],["and",["G2532"]],["ye",["G4059"]],["on",["G1722"]],["the sabbath day",["G4521"]],["circumcise",["G4059"]],["a man.",[]]]},{"verse":23,"text":"If a man on the sabbath day receive circumcision, that the law of Moses should not be broken; are ye angry at me, because I have made a man every whit whole on the sabbath day?","words":[["If",["G1487"]],["a man",["G444"]],["on",["G1722"]],["the sabbath day",["G4521"]],["receive",["G2983"]],["circumcision,",["G4061"]],["that",["G3363"]],["the law",["G3551"]],["of Moses",["G3475"]],["should",["G3089"]],["not",["G3363"]],["be broken;",["G3089"]],["are ye angry",["G5520"]],["at me,",["G1698"]],["because",["G3754"]],["I have made",["G4160"]],["a man",["G444"]],["every whit",["G3650"]],["whole",["G5199"]],["on",["G1722"]],["the sabbath day?",[]]]},{"verse":24,"text":"Judge not according to the appearance, but judge righteous judgment.","words":[["Judge",["G2919"]],["not",["G3361"]],["according to",["G2596"]],["the appearance,",["G3799"]],["but",["G235"]],["judge",["G2919"]],["righteous",["G1342"]],["judgment.",[]]]},{"verse":25,"text":"Then said some of them of Jerusalem, Is not this he, whom they seek to kill?","words":[["Then",["G3767"]],["said",["G3004"]],["some",["G5100"]],["of",["G1537"]],["them of Jerusalem,",["G2415"]],["Is",["G2076"]],["not",["G3756"]],["this",["G3778"]],["he, whom",["G3739"]],["they seek",["G2212"]],["to kill?",[]]]},{"verse":26,"text":"But, lo, he speaketh boldly, and they say nothing unto him. Do the rulers know indeed that this is the very Christ?","words":[["But,",["G2532"]],["lo,",["G2396"]],["he speaketh",["G2980"]],["boldly,",["G3954"]],["and",["G2532"]],["they say",["G3004"]],["nothing",["G3762"]],["unto him.",["G846"]],["Do",["G1097"]],["the rulers",["G758"]],["know",["G1097"]],["indeed",["G3379","G230"]],["that",["G3754"]],["this",["G3778"]],["is",["G2076"]],["the very",["G230"]],["Christ?",[]]]},{"verse":27,"text":"Howbeit we know this man whence he is: but when Christ cometh, no man knoweth whence he is.","words":[["Howbeit",["G235"]],["we know",["G1492"]],["this man",["G5126"]],["whence",["G4159"]],["he is:",["G2076"]],["but",["G1161"]],["when",["G3752"]],["Christ",["G5547"]],["cometh,",["G2064"]],["no man",["G3762"]],["knoweth",["G1097"]],["whence",["G4159"]],["he is.",[]]]},{"verse":28,"text":"Then cried Jesus in the temple as he taught, saying, Ye both know me, and ye know whence I am: and I am not come of myself, but he that sent me is true, whom ye know not.","words":[["Then",["G3767"]],["cried",["G2896"]],["Jesus",["G2424"]],["in",["G1722"]],["the temple",["G2411"]],["as he taught,",["G1321","G2532"]],["saying,",["G3004"]],["Ye both",["G2504"]],["know me,",["G1492"]],["and",["G2532"]],["ye know",["G1492"]],["whence",["G4159"]],["I am:",["G1510"]],["and",["G2532"]],["I am",["G2064"]],["not",["G3756"]],["come",["G2064"]],["of",["G575"]],["myself,",["G1683"]],["but",["G235"]],["he that sent",["G3992"]],["me",["G3165"]],["is"