,",["G846"]],["Now",["G3568"]],["we know",["G1097"]],["that",["G3754"]],["thou hast",["G2192"]],["a devil.",["G1140"]],["Abraham",["G11"]],["is dead,",["G599"]],["and",["G2532"]],["the prophets;",["G4396"]],["and",["G2532"]],["thou",["G4771"]],["sayest,",["G3004"]],["If",["G1437"]],["a man",["G5100"]],["keep",["G5083"]],["my",["G3450"]],["saying,",["G3056"]],["he shall",["G1089"]],["never",["G3364","G1519","G165"]],["taste",["G1089"]],["of death.",[]]]},{"verse":53,"text":"Art thou greater than our father Abraham, which is dead? and the prophets are dead: whom makest thou thyself?","words":[["Art",["G3361","G1488"]],["thou",["G4771"]],["greater than",["G3187"]],["our",["G2257"]],["father",["G3962"]],["Abraham,",["G11"]],["which",["G3748"]],["is dead?",["G599"]],["and",["G2532"]],["the prophets",["G4396"]],["are dead:",["G599"]],["whom",["G5101"]],["makest",["G4160"]],["thou",["G4771"]],["thyself?",[]]]},{"verse":54,"text":"Jesus answered, If I honour myself, my honour is nothing: it is my Father that honoureth me; of whom ye say, that he is your God:","words":[["Jesus",["G2424"]],["answered,",["G611"]],["If",["G1437"]],["I",["G1473"]],["honour",["G1392"]],["myself,",["G1683"]],["my",["G3450"]],["honour",["G1391"]],["is",["G2076"]],["nothing:",["G3762"]],["it is",["G2076"]],["my",["G3450"]],["Father",["G3962"]],["that honoureth",["G1392"]],["me;",["G3165"]],["of whom",["G3739"]],["ye",["G5210"]],["say,",["G3004"]],["that",["G3754"]],["he is",["G2076"]],["your",["G5216"]],["God:",[]]]},{"verse":55,"text":"Yet ye have not known him; but I know him: and if I should say, I know him not, I shall be a liar like unto you: but I know him, and keep his saying.","words":[["Yet",["G2532"]],["ye have",["G1097"]],["not",["G3756"]],["known",["G1097"]],["him;",["G846"]],["but",["G1161"]],["I",["G1473"]],["know",["G1492"]],["him:",["G846"]],["and",["G2532"]],["if",["G1437"]],["I should say,",["G2036","G3754"]],["I know",["G1492"]],["him",["G846"]],["not,",["G3756"]],["I shall be",["G2071"]],["a liar",["G5583"]],["like",["G3664"]],["unto you:",["G5216"]],["but",["G235"]],["I know",["G1492"]],["him,",["G846"]],["and",["G2532"]],["keep",["G5083"]],["his",["G846"]],["saying.",[]]]},{"verse":56,"text":"Your father Abraham rejoiced to see my day: and he saw it, and was glad.","words":[["Your",["G5216"]],["father",["G3962"]],["Abraham",["G11"]],["rejoiced",["G21"]],["to",["G2443"]],["see",["G1492"]],["my",["G1699"]],["day:",["G2250"]],["and",["G2532"]],["he saw",["G1492"]],["it, and",["G2532"]],["was glad.",[]]]},{"verse":57,"text":"Then said the Jews unto him, Thou art not yet fifty years old, and hast thou seen Abraham?","words":[["Then",["G3767"]],["said",["G2036"]],["the Jews",["G2453"]],["unto",["G4314"]],["him,",["G846"]],["Thou art",["G2192"]],["not yet",["G3768"]],["fifty",["G4004"]],["years old,",["G2094"]],["and",["G2532"]],["hast thou seen",["G3708"]],["Abraham?",[]]]},{"verse":58,"text":"Jesus said unto them, Verily, verily, I say unto you, Before Abraham was, I am.","words":[["Jesus",["G2424"]],["said",["G2036"]],["unto them,",["G846"]],["Verily,",["G281"]],["verily,",["G281"]],["I say",["G3004"]],["unto you,",["G5213"]],["Before",["G4250"]],["Abraham",["G11"]],["was,",["G1096"]],["I",["G1473"]],["am.",[]]]},{"verse":59,"text":"Then took they up stones to cast at him: but Jesus hid himself, and went out of the temple, going through the midst of them, and so passed by.","words":[["Then",["G3767"]],["took they up",["G142"]],["stones",["G3037"]],["to",["G2443"]],["cast",["G906"]],["at",["G1909"]],["him:",["G846"]],["but",["G1161"]],["Jesus",["G2424"]],["hid himself,",["G2928"]],["and",["G2532"]],["went",["G1831"]],["out of",["G1537"]],["the temple,",["G2411"]],["going",["G1330"]],["through",["G1223"]],["the midst",["G3319"]],["of them,",["G846"]],["and",["G2532"]],["so",["G3779"]],["passed by.",[]]]}]}