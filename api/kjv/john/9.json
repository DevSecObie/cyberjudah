{"book":"John","chapter":9,"translation":"KJV","url":"/bible/john/9","verses":[{"verse":1,"text":"And as Jesus passed by, he saw a man which was blind from his birth.","words":[["And",["G2532"]],["as Jesus passed by,",["G3855"]],["he saw",["G1492"]],["a man",["G444"]],["which was blind",["G5185"]],["from",["G1537"]],["his birth.",[]]]},{"verse":2,"text":"And his disciples asked him, saying, Master, who did sin, this man, or his parents, that he was born blind?","words":[["And",["G2532"]],["his",["G846"]],["disciples",["G3101"]],["asked",["G2065"]],["him,",["G846"]],["saying,",["G3004"]],["Master,",["G4461"]],["who",["G5101"]],["did sin,",["G264"]],["this man,",["G3778"]],["or",["G2228"]],["his",["G846"]],["parents,",["G1118"]],["that",["G2443"]],["he was born",["G1080"]],["blind?",[]]]},{"verse":3,"text":"Jesus answered, Neither hath this man sinned, nor his parents: but that the works of God should be made manifest in him.","words":[["Jesus",["G2424"]],["answered,",["G611"]],["Neither",["G3777"]],["hath",["G264"]],["this man",["G3778"]],["sinned,",["G264"]],["nor",["G3777"]],["his",["G846"]],["parents:",["G1118"]],["but",["G235"]],["that",["G2443"]],["the works",["G2041"]],["of God",["G2316"]],["should be made manifest",["G5319"]],["in",["G1722"]],["him.",[]]]},{"verse":4,"text":"I must work the works of him that sent me, while it is day: the night cometh, when no man can work.","words":[["I",["G1691"]],["must",["G1163"]],["work",["G2038"]],["the works",["G2041"]],["of him that sent",["G3992"]],["me,",["G3165"]],["while",["G2193"]],["it is",["G2076"]],["day:",["G2250"]],["the night",["G3571"]],["cometh,",["G2064"]],["when",["G3753"]],["no man",["G3762"]],["can",["G1410"]],["work.",[]]]},{"verse":5,"text":"As long as I am in the world, I am the light of the world.","words":[["As long as",["G3752"]],["I am",["G5600"]],["in",["G1722"]],["the world,",["G2889"]],["I am",["G1510"]],["the light",["G5457"]],["of the world.",[]]]},{"verse":6,"text":"When he had thus spoken, he spat on the ground, and made clay of the spittle, and he anointed the eyes of the blind man with the clay,","words":[["When he had thus",["G5023"]],["spoken,",["G2036"]],["he spat",["G4429"]],["on the ground,",["G5476"]],["and",["G2532"]],["made",["G4160"]],["clay",["G4081"]],["of",["G1537"]],["the spittle,",["G4427"]],["and",["G2532"]],["he anointed",["G2025","G1909"]],["the eyes",["G3788"]],["of the blind man",["G5185"]],["with the clay,",[]]]},{"verse":7,"text":"And said unto him, Go, wash in the pool of Siloam, (which is by interpretation, Sent.) He went his way therefore, and washed, and came seeing.","words":[["And",["G2532"]],["said",["G2036"]],["unto him,",["G846"]],["Go,",["G5217"]],["wash",["G3538"]],["in",["G1519"]],["the pool",["G2861"]],["of Siloam,",["G4611"]],["(which",["G3739"]],["is by interpretation,",["G2059"]],["Sent.)",["G649"]],["He went his way",["G565"]],["therefore,",["G3767"]],["and",["G2532"]],["washed,",["G3538"]],["and",["G2532"]],["came",["G2064"]],["seeing.",[]]]},{"verse":8,"text":"The neighbours therefore, and they which before had seen him that he was blind, said, Is not this he that sat and begged?","words":[["The neighbours",["G1069"]],["therefore,",["G3767"]],["and",["G2532"]],["they which before",["G4386"]],["had seen",["G2334"]],["him",["G846"]],["that",["G3754"]],["he was",["G2258"]],["blind,",["G5185"]],["said,",["G3004"]],["Is",["G2076"]],["not",["G3756"]],["this",["G3778"]],["he that sat",["G2521"]],["and",["G2532"]],["begged?",[]]]},{"verse":9,"text":"Some said, This is he: others said, He is like him: but he said, I am he.","words":[["Some",["G243"]],["said,",["G3004","G3754"]],["This",["G3778"]],["is he:",["G2076","G1161"]],["others",["G243"]],["said,",["G3754"]],["He is",["G2076"]],["like",["G3664"]],["him:",["G846"]],["but he",["G1565"]],["said,",["G3004","G3754"]],["I",["G1473"]],["am he.",[]]]},{"verse":10,"text":"Therefore said they unto him, How were thine eyes opened?","words":[["Therefore",["G3767"]],["said t