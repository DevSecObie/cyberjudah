{"book":"John","chapter":4,"translation":"KJV","url":"/bible/john/4","verses":[{"verse":1,"text":"When therefore the Lord knew how the Pharisees had heard that Jesus made and baptized more disciples than John,","words":[["When",["G5613"]],["therefore",["G3767"]],["the Lord",["G2962"]],["knew",["G1097"]],["how",["G3754"]],["the Pharisees",["G5330"]],["had heard",["G191"]],["that",["G3754"]],["Jesus",["G2424"]],["made",["G4160"]],["and",["G2532"]],["baptized",["G907"]],["more",["G4119"]],["disciples",["G3101"]],["than",["G2228"]],["John,",[]]]},{"verse":2,"text":"(Though Jesus himself baptized not, but his disciples,)","words":[["(Though",["G2544"]],["Jesus",["G2424"]],["himself",["G846"]],["baptized",["G907"]],["not,",["G3756"]],["but",["G235"]],["his",["G846"]],["disciples,)",[]]]},{"verse":3,"text":"He left Judea, and departed again into Galilee.","words":[["He left",["G863"]],["Judea,",["G2449"]],["and",["G2532"]],["departed",["G565"]],["again",["G3825"]],["into",["G1519"]],["Galilee.",[]]]},{"verse":4,"text":"And he must needs go through Samaria.","words":[["And",["G1161"]],["he must needs",["G1163"]],["go",["G1330"]],["through",["G1223"]],["Samaria.",[]]]},{"verse":5,"text":"Then cometh he to a city of Samaria, which is called Sychar, near to the parcel of ground that Jacob gave to his son Joseph.","words":[["Then",["G3767"]],["cometh he",["G2064"]],["to",["G1519"]],["a city",["G4172"]],["of Samaria,",["G4540"]],["which is called",["G3004"]],["Sychar,",["G4965"]],["near",["G4139"]],["to the parcel of ground",["G5564"]],["that",["G3739"]],["Jacob",["G2384"]],["gave",["G1325"]],["to his",["G846"]],["son",["G5207"]],["Joseph.",[]]]},{"verse":6,"text":"Now Jacob’s well was there. Jesus therefore, being wearied with his journey, sat thus on the well: and it was about the sixth hour.","words":[["Now",["G1161"]],["Jacob’s well",["G4077"]],["was",["G2258"]],["there.",["G1563"]],["Jesus",["G2424"]],["therefore,",["G3767"]],["being wearied",["G2872"]],["with",["G1537"]],["his journey,",["G3597"]],["sat",["G2516"]],["thus",["G3779"]],["on",["G1909"]],["the well:",["G4077"]],["and it was",["G2258"]],["about",["G5616"]],["the sixth",["G1623"]],["hour.",[]]]},{"verse":7,"text":"There cometh a woman of Samaria to draw water: Jesus saith unto her, Give me to drink.","words":[["There cometh",["G2064"]],["a woman",["G1135"]],["of",["G1537"]],["Samaria",["G4540"]],["to draw",["G501"]],["water:",["G5204"]],["Jesus",["G2424"]],["saith",["G3004"]],["unto her,",["G846"]],["Give",["G1325"]],["me",["G3427"]],["to drink.",[]]]},{"verse":8,"text":"(For his disciples were gone away unto the city to buy meat.)","words":[["(For",["G1063"]],["his",["G846"]],["disciples",["G3101"]],["were gone away",["G565"]],["unto",["G1519"]],["the city",["G4172"]],["to",["G2443"]],["buy",["G59"]],["meat.)",[]]]},{"verse":9,"text":"Then saith the woman of Samaria unto him, How is it that thou, being a Jew, askest drink of me, which am a woman of Samaria? for the Jews have no dealings with the Samaritans.","words":[["Then",["G3767"]],["saith",["G3004"]],["the woman",["G1135"]],["of Samaria",["G4542"]],["unto him,",["G846"]],["How is it that",["G4459"]],["thou,",["G4771"]],["being",["G5607"]],["a Jew,",["G2453"]],["askest",["G154"]],["drink",["G4095"]],["of",["G3844"]],["me,",["G1700"]],["which am",["G5607"]],["a woman",["G1135"]],["of Samaria?",["G4542"]],["for",["G1063"]],["the Jews",["G2453"]],["have",["G4798"]],["no",["G3756"]],["dealings",["G4798"]],["with the Samaritans.",[]]]},{"verse":10,"text":"Jesus answered and said unto her, If thou knewest the gift of God, and who it is that saith to thee, Give me to drink; thou wouldest have asked of him, and he would have given thee living water.","words":[["Jesus",["G2424"]],["answered",["G611"]],["and",["G2532"]],["said",["G2036"]],["unto her,",["G846"]],["If",["G1487"]],["thou knewest",["G1492"]],["the gift",["G1431"]],["of God,",["G2316"]],["and",["G2532"]],["who",["G5101"]],["it is",["G2076"]],["that saith",["G3004"]],["to thee,",["G4671"]],["Give",["G1325"]],["me",["G3427"]],["to drink;",["G4095"]],["thou",["G4771"]],["wouldest",["G302"]],["have asked",["G154"]],["of him,",["G846"]],["and",["G2532"]],["he would",["G302"]],["have given",["G1325"]],["thee",["G4671"]],["living",["G2198"]],["water.",[]]]},{"verse":11,"text":"The woman saith unto him, Sir, thou hast nothing to draw with, and the well is deep: from whence then hast thou that living water?","words":[["The woman",["G1135"]],["saith",["G3004"]],["unto him,",["G846"]],["Sir,",["G2962"]],["thou hast",["G2192"]],["nothing",["G3777"]],["to draw with,",["G502"]],["and",["G2532"]],["the well",["G5421"]],["is",["G2076"]],["deep:",["G901"]],["from whence",["G4159"]],["then",["G3767"]],["hast thou",["G2192"]],["that living",["G2198"]],["water?",[]]]},{"verse":12,"text":"Art thou greater than our father Jacob, which gave us the well, and drank thereof himself, and his children, and his cattle?","words":[["Art",["G1488"]],["thou",["G4771"]],["greater",["G3187"]],["than our",["G2257"]],["father",["G3962"]],["Jacob,",["G2384"]],["which",["G3739"]],["gave",["G1325"]],["us",["G2254"]],["the well,",["G5421"]],["and",["G2532"]],["drank",["G4095"]],["thereof",["G1537","G846"]],["himself,",["G846"]],["and",["G2532"]],["his",["G846"]],["children,",["G5207"]],["and",["G2532"]],["his",["G846"]],["cattle?",[]]]},{"verse":13,"text":"Jesus answered and said unto her, Whosoever drinketh of this water shall thirst again:","words":[["Jesus",["G2424"]],["answered",["G611"]],["and",["G2532"]],["said",["G2036"]],["unto her,",["G846"]],["Whosoever",["G3956"]],["drinketh",["G4095"]],["of",["G1537"]],["this",["G5127"]],["water",["G5204"]],["shall thirst",["G1372"]],["again:",[]]]},{"verse":14,"text":"But whosoever drinketh of the water that I shall give him shall never thirst; but the water that I shall give him shall be in him a well of water springing up into everlasting life.","words":[["But",["G1161"]],["whosoever",["G3739","G302"]],["drinketh",["G4095"]],["of",["G1537"]],["the water",["G5204"]],["that",["G3739"]],["I",["G1473"]],["shall give",["G1325"]],["him",["G846"]],["shall",["G1372"]],["never",["G1519","G165","G3364"]],["thirst;",["G1372"]],["but",["G235"]],["the water",["G5204"]],["that",["G3739"]],["I shall give",["G1325"]],["him",["G846"]],["shall be",["G1096"]],["in",["G1722"]],["him",["G846"]],["a well",["G4077"]],["of water",["G5204"]],["springing up",["G242"]],["into",["G1519"]],["everlasting",["G166"]],["life.",[]]]},{"verse":15,"text":"The woman saith unto him, Sir, give me this water, that I thirst not, neither come hither to draw.","words":[["The woman",["G1135"]],["saith",["G3004"]],["unto",["G4314"]],["him,",["G846"]],["Sir,",["G2962"]],["give",["G1325"]],["me",["G3427"]],["this",["G5124"]],["water,",["G5204"]],["that",["G3363"]],["I thirst",["G1372"]],["not,",["G3363"]],["neither",["G3366"]],["come",["G2064"]],["hither",["G1759"]],["to draw.",[]]]},{"verse":16,"text":"Jesus saith unto her, Go, call thy husband, and come hither.","words":[["Jesus",["G2424"]],["saith",["G3004"]],["unto her,",["G846"]],["Go,",["G5217"]],["call",["G5455"]],["thy",["G4675"]],["husband,",["G435"]],["and",["G2532"]],["come",["G2064"]],["hither.",[]]]},{"verse":17,"text":"The woman answered and said, I have no husband. Jesus said unto her, Thou hast well said, I have no husband:","words":[["The woman",["G1135"]],["answered",["G611"]],["and",["G2532"]],["said,",["G2036"]],["I have",["G2192"]],["no",["G3756"]],["husband.",["G435"]],["Jesus",["G2424"]],["said",["G3004"]],["unto her,",["G846"]],["Thou hast",["G2036"]],["well",["G2573"]],["said,",["G2036","G3754"]],["I have",["G2192"]],["no",["G3756"]],["husband:",[]]]},{"verse":18,"text":"For thou hast had five husbands; and he whom thou now hast is not thy husband: in that saidst thou truly.","words":[["For",["G1063"]],["thou hast had",["G2192"]],["five",["G4002"]],["husbands;",["G435"]],["and",["G2532"]],["he whom",["G3739"]],["thou",["G2192"]],["now",["G3568"]],["hast",["G2192"]],["is",["G2076"]],["not",["G3756"]],["thy",["G4675"]],["husband:",["G435"]],["in that",["G5124"]],["saidst thou",["G2046"]],["truly.",[]]]},{"verse":19,"text":"The woman saith unto him, Sir, I perceive that thou art a prophet.","words":[["The woman",["G1135"]],["saith",["G3004"]],["unto him,",["G846"]],["Sir,",["G2962"]],["I perceive",["G2334"]],["that",["G3754"]],["thou",["G4771"]],["art",["G1488"]],["a prophet.",[]]]},{"verse":20,"text":"Our fathers worshipped in this mountain; and ye say, that in Jerusalem is the place where men ought to worship.","words":[["Our",["G2257"]],["fathers",["G3962"]],["worshipped",["G4352"]],["in",["G1722"]],["this",["G5129"]],["mountain;",["G3735"]],["and",["G2532"]],["ye",["G5210"]],["say,",["G3004"]],["that",["G3754"]],["in",["G1722"]],["Jerusalem",["G2414"]],["is",["G2076"]],["the place",["G5117"]],["where",["G3699"]],["men ought",["G1163"]],["to worship.",[]]]},{"verse":21,"text":"Jesus saith unto her, Woman, believe me, the hour cometh, when ye shall neither in this mountain, nor yet at Jerusalem, worship the Father.","words":[["Jesus",["G2424"]],["saith",["G3004"]],["unto her,",["G846"]],["Woman,",["G1135"]],["believe",["G4100"]],["me,",["G3427"]],["the hour",["G5610"]],["cometh,",["G3754","G2064"]],["when",["G3753"]],["ye shall",["G4352"]],["neither",["G3777"]],["in",["G1722"]],["this",["G5129"]],["mountain,",["G3735"]],["nor yet",["G3777"]],["at",["G1722"]],["Jerusalem,",["G2414"]],["worship",["G4352"]],["the Father.",[]]]},{"verse":22,"text":"Ye worship ye know not what: we know what we worship: for salvation is of the Jews.","words":[["Ye",["G5210"]],["worship",["G4352"]],["ye know",["G1492"]],["not",["G3756"]],["what:",["G3739"]],["we know",["G1492"]],["what",["G3739"]],["we",["G2249"]],["worship:",["G4352"]],["for",["G3754"]],["salvation",["G4991"]],["is",["G2076"]],["of",["G1537"]],["the Jews.",[]]]},{"verse":23,"text":"But the hour cometh, and now is, when the true worshippers shall worship the Father in spirit and in truth: for the Father seeketh such to worship him.","words":[["But",["G235"]],["the hour",["G5610"]],["cometh,",["G2064"]],["and",["G2532"]],["now",["G3568"]],["is,",["G2076"]],["when",["G3753"]],["the true",["G228"]],["worshippers",["G4353"]],["shall worship",["G4352"]],["the Father",["G3962"]],["in",["G1722"]],["spirit",["G4151"]],["and",["G2532"]],["in truth:",["G225"]],["for",["G2532","G1063"]],["the Father",["G3962"]],["seeketh",["G2212"]],["such",["G5108"]],["to worship",["G4352"]],["him.",[]]]},{"verse":24,"text":"God is a Spirit: and they that worship him must worship him in spirit and in truth.","words":[["God",["G2316"]],["is a Spirit:",["G4151"]],["and",["G2532"]],["they that worship",["G4352"]],["him",["G846"]],["must",["G1163"]],["worship",["G4352"]],["him in",["G1722"]],["spirit",["G4151"]],["and",["G2532"]],["in truth.",[]]]},{"verse":25,"text":"The woman saith unto him, I know that Messias cometh, which is called Christ: when he is come, he will tell us all things.","words":[["The woman",["G1135"]],["saith",["G3004"]],["unto him,",["G846"]],["I know",["G1492"]],["that",["G3754"]],["Messias",["G3323"]],["cometh,",["G2064"]],["which",["G3588"]],["is called",["G3004"]],["Christ:",["G5547"]],["when",["G3752"]],["he",["G1565"]],["is come,",["G2064"]],["he will tell",["G312"]],["us",["G2254"]],["all things.",[]]]},{"verse":26,"text":"Jesus saith unto her, I that speak unto thee am he.","words":[["Jesus",["G2424"]],["saith",["G3004"]],["unto her,",["G846"]],["I",["G1473"]],["that speak",["G2980"]],["unto thee",["G4671"]],["am he.",[]]]},{"verse":27,"text":"And upon this came his disciples, and marvelled that he talked with the woman: yet no man said, What seekest thou? or, Why talkest thou with her?","words":[["And",["G2532"]],["upon",["G1909"]],["this",["G5129"]],["came",["G2064"]],["his",["G846"]],["disciples,",["G3101"]],["and",["G2532"]],["marvelled",["G2296"]],["that",["G3754"]],["he talked",["G2980"]],["with",["G3326"]],["the woman:",["G1135"]],["yet",["G3305"]],["no man",["G3762"]],["said,",["G2036"]],["What",["G5101"]],["seekest thou?",["G2212"]],["or,",["G2228"]],["Why",["G5101"]],["talkest thou",["G2980"]],["with",["G3326"]],["her?",[]]]},{"verse":28,"text":"The woman then left her waterpot, and went her way into the city, and saith to the men,","words":[["The woman",["G1135"]],["then",["G3767"]],["left",["G863"]],["her",["G846"]],["waterpot,",["G5201"]],["and",["G2532"]],["went her way",["G565"]],["into",["G1519"]],["the city,",["G4172"]],["and",["G2532"]],["saith",["G3004"]],["to the men,",[]]]},{"verse":29,"text":"Come, see a man, which told me all things that ever I did: is not this the Christ?","words":[["Come,",["G1205"]],["see",["G1492"]],["a man,",["G444"]],["which",["G3739"]],["told",["G2036"]],["me",["G3427"]],["all things",["G3956"]],["that ever",["G3745"]],["I did:",["G4160"]],["is",["G2076"]],["not",["G3385"]],["this",["G3778"]],["the Christ?",[]]]},{"verse":30,"text":"Then they went out of the city, and came unto him.","words":[["Then",["G3767"]],["they went",["G1831"]],["out of",["G1537"]],["the city,",["G4172"]],["and",["G2532"]],["came",["G2064"]],["unto",["G4314"]],["him.",[]]]},{"verse":31,"text":"In the mean while his disciples prayed him, saying, Master, eat.","words":[["In",["G1722"]],["the mean",["G3342"]],["while his disciples",["G3101"]],["prayed",["G2065"]],["him,",["G846"]],["saying,",["G3004"]],["Master,",["G4461"]],["eat.",[]]]},{"verse":32,"text":"But he said unto them, I have meat to eat that ye know not of.","words":[["But",["G1161"]],["he said",["G2036"]],["unto them,",["G846"]],["I",["G1473"]],["have",["G2192"]],["meat",["G1035"]],["to eat",["G5315"]],["that",["G3739"]],["ye",["G5210"]],["know",["G1492"]],["not",["G3756"]],["of.",[]]]},{"verse":33,"text":"Therefore said the disciples one to another, Hath any man brought him ought to eat?","words":[["Therefore",["G3767"]],["said",["G3004"]],["the disciples",["G3101"]],["one to another,",["G4314","G240"]],["Hath",["G5342"]],["any man",["G3387"]],["brought",["G5342"]],["him",["G846"]],["ought to eat?",[]]]},{"verse":34,"text":"Jesus saith unto them, My meat is to do the will of him that sent me, and to finish his work.","words":[["Jesus",["G2424"]],["saith",["G3004"]],["unto them,",["G846"]],["My",["G1699"]],["meat",["G1033"]],["is",["G2076"]],["to",["G2443"]],["do",["G4160"]],["the will",["G2307"]],["of him that sent",["G3992"]],["me,",["G3165"]],["and",["G2532"]],["to finish",["G5048"]],["his",["G846"]],["work.",[]]]},{"verse":35,"text":"Say not ye, There are yet four months, and then cometh harvest? behold, I say unto you, Lift up your eyes, and look on the fields; for they are white already to harvest.","words":[["Say",["G3004"]],["not",["G3756"]],["ye,",["G5210"]],["There",["G3754"]],["are",["G2076"]],["yet",["G2089"]],["four months,",["G5072"]],["and",["G2532"]],["then cometh",["G2064"]],["harvest?",["G2326"]],["behold,",["G2400"]],["I say",["G3004"]],["unto you,",["G5213"]],["Lift up",["G1869"]],["your",["G5216"]],["eyes,",["G3788"]],["and",["G2532"]],["look on",["G2300"]],["the fields;",["G5561"]],["for",["G3754"]],["they are",["G1526"]],["white",["G3022"]],["already",["G2235"]],["to",["G4314"]],["harvest.",[]]]},{"verse":36,"text":"And he that reapeth receiveth wages, and gathereth fruit unto life eternal: that both he that soweth and he that reapeth may rejoice together.","words":[["And",["G2532"]],["he that reapeth",["G2325"]],["receiveth",["G2983"]],["wages,",["G3408"]],["and",["G2532"]],["gathereth",["G4863"]],["fruit",["G2590"]],["unto",["G1519"]],["life",["G2222"]],["eternal:",["G166"]],["that",["G2443"]],["both",["G2532"]],["he that soweth",["G4687"]],["and",["G2532"]],["he that reapeth",["G2325"]],["may rejoice",["G5463"]],["together.",[]]]},{"verse":37,"text":"And herein is that saying true, One soweth, and another reapeth.","words":[["And",["G1063"]],["herein",["G1722","G5129"]],["is",["G2076"]],["that saying",["G3056"]],["true,",["G228","G3754"]],["One",["G243"]],["soweth,",["G2076","G4687"]],["and",["G2532"]],["another",["G243"]],["reapeth.",[]]]},{"verse":38,"text":"I sent you to reap that whereon ye bestowed no labour: other men laboured, and ye are entered into their labours.","words":[["I",["G1473"]],["sent",["G649"]],["you",["G5209"]],["to reap",["G2325"]],["that whereon",["G3739"]],["ye",["G5210"]],["bestowed",["G2872"]],["no",["G3756"]],["labour:",["G2872"]],["other men",["G243"]],["laboured,",["G2872"]],["and",["G2532"]],["ye",["G5210"]],["are entered",["G1525"]],["into",["G1519"]],["their",["G846"]],["labours.",[]]]},{"verse":39,"text":"And many of the Samaritans of that city believed on him for the saying of the woman, which testified, He told me all that ever I did.","words":[["And",["G1161"]],["many",["G4183"]],["of the Samaritans",["G4541"]],["of",["G1537"]],["that",["G1565"]],["city",["G4172"]],["believed",["G4100"]],["on",["G1519"]],["him",["G846"]],["for",["G1223"]],["the saying",["G3056"]],["of the woman,",["G1135"]],["which testified,",["G3140","G3754"]],["He told",["G2036"]],["me",["G3427"]],["all",["G3956"]],["that ever",["G3745"]],["I did.",[]]]},{"verse":40,"text":"So when the Samaritans were come unto him, they besought him that he would tarry with them: and he abode there two days.","words":[["So",["G3767"]],["when",["G5613"]],["the Samaritans",["G4541"]],["were come",["G2064"]],["unto",["G4314"]],["him,",["G846"]],["they besought",["G2065"]],["him",["G846"]],["that he would tarry",["G3306"]],["with",["G3844"]],["them:",["G846"]],["and",["G2532"]],["he abode",["G3306"]],["there",["G1563"]],["two",["G1417"]],["days.",[]]]},{"verse":41,"text":"And many more believed because of his own word;","words":[["And",["G2532"]],["many",["G4183"]],["more",["G4119"]],["believed",["G4100"]],["because",["G1223"]],["of his own",["G846"]],["word;",[]]]},{"verse":42,"text":"And said unto the woman, Now we believe, not because of thy saying: for we have heard him ourselves, and know that this is indeed the Christ, the Saviour of the world.","words":[["And",["G5037"]],["said",["G3004"]],["unto the woman,",["G1135","G3754"]],["Now",["G3765"]],["we believe,",["G4100"]],["not",["G3754"]],["because",["G1223"]],["of thy",["G4674"]],["saying:",["G2981"]],["for",["G1063"]],["we have heard",["G191"]],["him ourselves,",["G846"]],["and",["G2532"]],["know",["G1492"]],["that",["G3754"]],["this",["G3778"]],["is",["G2076"]],["indeed",["G230"]],["the Christ,",["G5547"]],["the Saviour",["G4990"]],["of the world.",[]]]},{"verse":43,"text":"Now after two days he departed thence, and went into Galilee.","words":[["Now",["G1161"]],["after",["G3326"]],["two",["G1417"]],["days",["G2250"]],["he departed",["G565","G1831"]],["thence,",["G1564"]],["and",["G2532"]],["went into",["G1519"]],["Galilee.",[]]]},{"verse":44,"text":"For Jesus himself testified, that a prophet hath no honour in his own country.","words":[["For",["G1063"]],["Jesus",["G2424"]],["himself",["G846"]],["testified,",["G3140"]],["that",["G3754"]],["a prophet",["G4396"]],["hath",["G2192"]],["no",["G3756"]],["honour",["G5092"]],["in",["G1722"]],["his own",["G2398"]],["country.",[]]]},{"verse":45,"text":"Then when he was come into Galilee, the Galileans received him, having seen all the things that he did at Jerusalem at the feast: for they also went unto the feast.","words":[["Then",["G3767"]],["when",["G3753"]],["he was come",["G2064"]],["into",["G1519"]],["Galilee,",["G1056"]],["the Galileans",["G1057"]],["received",["G1209"]],["him,",["G846"]],["having seen",["G3708"]],["all the things",["G3956"]],["that",["G3739"]],["he did",["G4160"]],["at",["G1722"]],["Jerusalem",["G2414"]],["at",["G1722"]],["the feast:",["G1859"]],["for",["G1063"]],["they",["G846"]],["also",["G2532"]],["went",["G2064"]],["unto",["G1519"]],["the feast.",[]]]},{"verse":46,"text":"So Jesus came again into Cana of Galilee, where he made the water wine. And there was a certain nobleman, whose son was sick at Capernaum.","words":[["So",["G3767"]],["Jesus",["G2424"]],["came",["G2064"]],["again",["G3825"]],["into",["G1519"]],["Cana",["G2580"]],["of Galilee,",["G1056"]],["where",["G3699"]],["he made",["G4160"]],["the water",["G5204"]],["wine.",["G3631"]],["And",["G2532"]],["there was",["G2258"]],["a certain",["G5100"]],["nobleman,",["G937"]],["whose",["G3739"]],["son",["G5207"]],["was sick",["G770"]],["at",["G1722"]],["Capernaum.",[]]]},{"verse":47,"text":"When he heard that Jesus was come out of Judea into Galilee, he went unto him, and besought him that he would come down, and heal his son: for he was at the point of death.","words":[["When he",["G3778"]],["heard",["G191"]],["that",["G3754"]],["Jesus",["G2424"]],["was come",["G2240"]],["out of",["G1537"]],["Judea",["G2449"]],["into",["G1519"]],["Galilee,",["G1056"]],["he went",["G565"]],["unto",["G4314"]],["him,",["G846"]],["and",["G2532"]],["besought",["G2065"]],["him",["G846"]],["that",["G2443"]],["he would come down,",["G2597"]],["and",["G2532"]],["heal",["G2390"]],["his",["G846"]],["son:",["G5207"]],["for",["G1063"]],["he was at the point",["G3195"]],["of death.",[]]]},{"verse":48,"text":"Then said Jesus unto him, Except ye see signs and wonders, ye will not believe.","words":[["Then",["G3767"]],["said",["G2036"]],["Jesus",["G2424"]],["unto",["G4314"]],["him,",["G846"]],["Except",["G3362"]],["ye see",["G1492"]],["signs",["G4592"]],["and",["G2532"]],["wonders,",["G5059"]],["ye will",["G4100"]],["not",["G3364"]],["believe.",[]]]},{"verse":49,"text":"The nobleman saith unto him, Sir, come down ere my child die.","words":[["The nobleman",["G937"]],["saith",["G3004"]],["unto",["G4314"]],["him,",["G846"]],["Sir,",["G2962"]],["come down",["G2597"]],["ere",["G4250"]],["my",["G3450"]],["child",["G3813"]],["die.",[]]]},{"verse":50,"text":"Jesus saith unto him, Go thy way; thy son liveth. And the man believed the word that Jesus had spoken unto him, and he went his way.","words":[["Jesus",["G2424"]],["saith",["G3004"]],["unto him,",["G846"]],["Go thy way;",["G4198"]],["thy",["G4675"]],["son",["G5207"]],["liveth.",["G2198"]],["And",["G2532"]],["the man",["G444"]],["believed",["G4100"]],["the word",["G3056"]],["that",["G3739"]],["Jesus",["G2424"]],["had spoken",["G2036"]],["unto him,",["G846"]],["and",["G2532"]],["he went his way.",[]]]},{"verse":51,"text":"And as he was now going down, his servants met him, and told him, saying, Thy son liveth.","words":[["And",["G1161"]],["as he",["G846"]],["was now",["G2235"]],["going down,",["G2597"]],["his",["G846"]],["servants",["G1401"]],["met",["G528"]],["him,",["G846"]],["and",["G2532"]],["told",["G518"]],["him, saying,",["G3004","G3754"]],["Thy",["G4675"]],["son",["G3816"]],["liveth.",[]]]},{"verse":52,"text":"Then enquired he of them the hour when he began to amend. And they said unto him, Yesterday at the seventh hour the fever left him.","words":[["Then",["G3767"]],["enquired he",["G4441"]],["of",["G3844"]],["them",["G846"]],["the hour",["G5610"]],["when",["G1722","G3739"]],["he began",["G2192"]],["to amend.",["G2866"]],["And",["G2532"]],["they said",["G2036"]],["unto him,",["G846","G3754"]],["Yesterday",["G5504"]],["at the seventh",["G1442"]],["hour",["G5610"]],["the fever",["G4446"]],["left",["G863"]],["him.",[]]]},{"verse":53,"text":"So the father knew that it was at the same hour, in the which Jesus said unto him, Thy son liveth: and himself believed, and his whole house.","words":[["So",["G3767"]],["the father",["G3962"]],["knew",["G1097"]],["that",["G3754"]],["it was at",["G1722"]],["the same",["G1565"]],["hour,",["G5610"]],["in",["G1722"]],["the which",["G3739"]],["Jesus",["G2424"]],["said",["G2036"]],["unto him,",["G846","G3754"]],["Thy",["G4675"]],["son",["G5207"]],["liveth:",["G2198"]],["and",["G2532"]],["himself",["G846"]],["believed,",["G4100"]],["and",["G2532"]],["his",["G846"]],["whole",["G3650"]],["house.",[]]]},{"verse":54,"text":"This is again the second miracle that Jesus did, when he was come out of Judea into Galilee.","words":[["This",["G5124"]],["is again",["G3825"]],["the second",["G1208"]],["miracle",["G4592"]],["that Jesus",["G2424"]],["did,",["G4160"]],["when he was come out",["G2064"]],["of",["G1537"]],["Judea",["G2449"]],["into",["G1519"]],["Galilee.",[]]]}]}