{"book":"John","chapter":21,"translation":"KJV","url":"/bible/john/21","verses":[{"verse":1,"text":"After these things Jesus shewed himself again to the disciples at the sea of Tiberias; and on this wise shewed he himself.","words":[["After",["G3326"]],["these things",["G5023"]],["Jesus",["G2424"]],["shewed",["G5319"]],["himself",["G1438"]],["again",["G3825"]],["to the disciples",["G3101"]],["at",["G1909"]],["the sea",["G2281"]],["of Tiberias;",["G5085"]],["and",["G1161"]],["on this wise",["G3779"]],["shewed he himself.",[]]]},{"verse":2,"text":"There were together Simon Peter, and Thomas called Didymus, and Nathanael of Cana in Galilee, and the sons of Zebedee, and two other of his disciples.","words":[["There were",["G2258"]],["together",["G3674"]],["Simon",["G4613"]],["Peter,",["G4074"]],["and",["G2532"]],["Thomas",["G2381"]],["called",["G3004"]],["Didymus,",["G1324"]],["and",["G2532"]],["Nathanael",["G3482"]],["of",["G575"]],["Cana",["G2580"]],["in Galilee,",["G1056"]],["and",["G2532"]],["the sons",["G3588"]],["of Zebedee,",["G2199"]],["and",["G2532"]],["two",["G1417"]],["other",["G243"]],["of",["G1537"]],["his",["G846"]],["disciples.",[]]]},{"verse":3,"text":"Simon Peter saith unto them, I go a fishing. They say unto him, We also go with thee. They went forth, and entered into a ship immediately; and that night they caught nothing.","words":[["Simon",["G4613"]],["Peter",["G4074"]],["saith",["G3004"]],["unto them,",["G846"]],["I go",["G5217"]],["a fishing.",["G232"]],["They say",["G3004"]],["unto him,",["G846"]],["We",["G2249"]],["also",["G2532"]],["go",["G2064"]],["with",["G4862"]],["thee.",["G4671"]],["They went forth,",["G1831"]],["and",["G2532"]],["entered",["G305"]],["into",["G1519"]],["a ship",["G4143"]],["immediately;",["G2117"]],["and",["G2532"]],["that",["G1722","G1565"]],["night",["G3571"]],["they caught",["G4084"]],["nothing.",[]]]},{"verse":4,"text":"But when the morning was now come, Jesus stood on the shore: but the disciples knew not that it was Jesus.","words":[["But",["G1161"]],["when the morning",["G4405"]],["was",["G1096"]],["now",["G2235"]],["come,",["G1096"]],["Jesus",["G2424"]],["stood",["G2476"]],["on",["G1519"]],["the shore:",["G123"]],["but",["G3305"]],["the disciples",["G3101"]],["knew",["G1492"]],["not",["G3756"]],["that",["G3754"]],["it was",["G2076"]],["Jesus.",[]]]},{"verse":5,"text":"Then Jesus saith unto them, Children, have ye any meat? They answered him, No.","words":[["Then",["G3767"]],["Jesus",["G2424"]],["saith",["G3004"]],["unto them,",["G846"]],["Children,",["G3813"]],["have ye",["G2192"]],["any",["G3387"]],["meat?",["G4371"]],["They answered",["G611"]],["him,",["G846"]],["No.",[]]]},{"verse":6,"text":"And he said unto them, Cast the net on the right side of the ship, and ye shall find. They cast therefore, and now they were not able to draw it for the multitude of fishes.","words":[["And",["G1161"]],["he said",["G2036"]],["unto them,",["G846"]],["Cast",["G906"]],["the net",["G1350"]],["on",["G1519"]],["the right",["G1188"]],["side",["G3313"]],["of the ship,",["G4143"]],["and",["G2532"]],["ye shall find.",["G2147"]],["They cast",["G906"]],["therefore,",["G3767"]],["and",["G2532"]],["now",["G3765"]],["they were",["G2480"]],["not",["G3765"]],["able",["G2480"]],["to draw",["G1670"]],["it",["G846"]],["for",["G575"]],["the multitude",["G4128"]],["of fishes.",[]]]},{"verse":7,"text":"Therefore that disciple whom Jesus loved saith unto Peter, It is the Lord. Now when Simon Peter heard that it was the Lord, he girt his fisher’s coat unto him, (for he was naked,) and did cast himself into the sea.","words":[["Therefore",["G3767"]],["that",["G1565"]],["disciple",["G3101"]],["whom",["G3739"]],["Jesus",["G2424"]],["loved",["G25"]],["saith",["G3004"]],["unto Peter,",["G4074"]],["It is",["G2076"]],["the Lord.",["G2962"]],["Now",["G3767"]],["when Simon",["G4613"]],["Peter",["G4074"]],["heard",["G191"]],["that",["G3754"]],["it was",["G2076"]],["the Lord,",["G2962"]],["he girt",["G1241"]],["his fisher’s coat",["G1903"]],["unto him, (for",["G1063"]],["he was",["G2258"]],["naked,)",["G1131"]],["and",["G2532"]],["did cast",["G906"]],["himself",["G1438"]],["into",["G1519"]],["the sea.",[]]]},{"verse":8,"text":"And the other disciples came in a little ship; (for they were not far from land, but as it were two hundred cubits,) dragging the net with fishes.","words":[["And",["G1161"]],["the other",["G243"]],["disciples",["G3101"]],["came",["G2064"]],["in a little ship;",["G4142"]],["(for",["G1063"]],["they were",["G2258"]],["not",["G3756"]],["far",["G3112"]],["from",["G575"]],["land,",["G1093"]],["but",["G235"]],["as it were",["G5613","G575"]],["two hundred",["G1250"]],["cubits,)",["G4083"]],["dragging",["G4951"]],["the net",["G1350"]],["with fishes.",[]]]},{"verse":9,"text":"As soon then as they were come to land, they saw a fire of coals there, and fish laid thereon, and bread.","words":[["As soon",["G5613"]],["then",["G3767"]],["as they were come",["G576"]],["to",["G1519"]],["land,",["G1093"]],["they saw",["G991"]],["a fire of coals",["G439"]],["there, and",["G2532"]],["fish",["G3795"]],["laid",["G2749"]],["thereon,",["G1945"]],["and",["G2532"]],["bread.",[]]]},{"verse":10,"text":"Jesus saith unto them, Bring of the fish which ye have now caught.","words":[["Jesus",["G2424"]],["saith",["G3004"]],["unto them,",["G846"]],["Bring",["G5342"]],["of",["G575"]],["the fish",["G3795"]],["which",["G3739"]],["ye have",["G4084"]],["now",["G3568"]],["caught.",[]]]},{"verse":11,"text":"Simon Peter went up, and drew the net to land full of great fishes, an hundred and fifty and three: and for all there were so many, yet was not the net broken.","words":[["Simon",["G4613"]],["Peter",["G4074"]],["went up,",["G305"]],["and",["G2532"]],["drew",["G1670"]],["the net",["G1350"]],["to",["G1909"]],["land",["G1093"]],["full",["G3324"]],["of great",["G3173"]],["fishes,",["G2486"]],["an hundred",["G1540"]],["and fifty",["G4004"]],["and three:",["G5140"]],["and",["G2532"]],["for all there were so many,",["G5118"]],["yet was",["G5607"]],["not",["G3756"]],["the net",["G1350"]],["broken.",[]]]},{"verse":12,"text":"Jesus saith unto them, Come and dine. And none of the disciples durst ask him, Who art thou? knowing that it was the Lord.","words":[["Jesus",["G2424"]],["saith",["G3004"]],["unto them,",["G846"]],["Come",["G1205"]],["and dine.",["G709"]],["And",["G1161"]],["none",["G3762"]],["of the disciples",["G3101"]],["durst",["G5111"]],["ask",["G1833"]],["him,",["G846"]],["Who",["G5101"]],["art",["G1488"]],["thou?",["G4771"]],["knowing",["G1492"]],["that",["G3754"]],["it was",["G2076"]],["the Lord.",[]]]},{"verse":13,"text":"Jesus then cometh, and taketh bread, and giveth them, and fish likewise.","words":[["Jesus",["G2424"]],["then",["G3767"]],["cometh,",["G2064"]],["and",["G2532"]],["taketh",["G2983"]],["bread,",["G740"]],["and",["G2532"]],["giveth",["G1325"]],["them,",["G846"]],["and",["G2532"]],["fish",["G3795"]],["likewise.",[]]]},{"verse":14,"text":"This is now the third time that Jesus shewed himself to his disciples, after that he was risen from the dead.","words":[["This",["G5124"]],["is",["G5319"]],["now",["G2235"]],["the third time",["G5154"]],["that Jesus",["G2424"]],["shewed himself",["G5319"]],["to his",["G846"]],["disciples,",["G3101"]],["after that he was risen",["G1453"]],["from",["G1537"]],["the dead.",[]]]},{"verse":15,"text":"So when they had dined, Jesus saith to Simon Peter, Simon, son of Jonas, lovest thou me more than these? He saith unto him, Yea, Lord; thou knowest that I love thee. He saith unto him, Feed my lambs.","words":[["So",["G3767"]],["when",["G3753"]],["they had dined,",["G709"]],["Jesus",["G2424"]],["saith",["G3004"]],["to Simon",["G4613"]],["Peter,",["G4074"]],["Simon,",["G4613"]],["son of Jonas,",["G2495"]],["lovest thou",["G25"]],["me",["G3165"]],["more than",["G4119"]],["these?",["G5130"]],["He saith",["G3004"]],["unto him,",["G846"]],["Yea,",["G3483"]],["Lord;",["G2962"]],["thou",["G4771"]],["knowest",["G1492"]],["th