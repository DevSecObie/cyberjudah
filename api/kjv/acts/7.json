,["and",["G3739"]],["nourished up",["G397"]],["in",["G1722"]],["his",["G846"]],["father’s house",["G3624"]],["three",["G5140"]],["months:",[]]]},{"verse":21,"text":"And when he was cast out, Pharaoh’s daughter took him up, and nourished him for her own son.","words":[["And",["G1161"]],["when he",["G846"]],["was cast out,",["G1620"]],["Pharaoh’s daughter",["G2364"]],["took",["G337"]],["him",["G846"]],["up,",["G337"]],["and",["G2532"]],["nourished",["G397"]],["him",["G846"]],["for",["G1519"]],["her own",["G1438"]],["son.",[]]]},{"verse":22,"text":"And Moses was learned in all the wisdom of the Egyptians, and was mighty in words and in deeds.","words":[["And",["G2532"]],["Moses",["G3475"]],["was learned",["G3811"]],["in all",["G3956"]],["the wisdom",["G4678"]],["of the Egyptians,",["G124"]],["and",["G1161"]],["was",["G2258"]],["mighty",["G1415"]],["in",["G1722"]],["words",["G3056"]],["and",["G2532"]],["in",["G1722"]],["deeds.",[]]]},{"verse":23,"text":"And when he was full forty years old, it came into his heart to visit his brethren the children of Israel.","words":[["And",["G1161"]],["when",["G5613"]],["he",["G846"]],["was full",["G4137"]],["forty years",["G5063"]],["old,",["G5550"]],["it came",["G305"]],["into",["G1909"]],["his",["G846"]],["heart",["G2588"]],["to visit",["G1980"]],["his",["G846"]],["brethren",["G80"]],["the children",["G5207"]],["of Israel.",[]]]},{"verse":24,"text":"And seeing one of them suffer wrong, he defended him, and avenged him that was oppressed, and smote the Egyptian:","words":[["And",["G2532"]],["seeing",["G1492"]],["one",["G5100"]],["of them suffer wrong,",["G91"]],["he defended",["G292"]],["him, and",["G2532"]],["avenged",["G1557","G4160"]],["him that was oppressed,",["G2669"]],["and smote",["G3960"]],["the Egyptian:",[]]]},{"verse":25,"text":"For he supposed his brethren would have understood how that God by his hand would deliver them: but they understood not.","words":[["For",["G1161"]],["he supposed",["G3543"]],["his",["G846"]],["b