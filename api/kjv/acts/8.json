nd in the bond of iniquity.","words":[["For",["G1063"]],["I perceive",["G3708"]],["that thou",["G4571"]],["art",["G5607"]],["in",["G1519"]],["the gall",["G5521"]],["of bitterness,",["G4088"]],["and",["G2532"]],["in the bond",["G4886"]],["of iniquity.",[]]]},{"verse":24,"text":"Then answered Simon, and said, Pray ye to the Lord for me, that none of these things which ye have spoken come upon me.","words":[["Then",["G1161"]],["answered",["G611"]],["Simon,",["G4613"]],["and said,",["G2036"]],["Pray",["G1189"]],["ye",["G5210"]],["to",["G4314"]],["the Lord",["G2962"]],["for",["G5228"]],["me,",["G1700"]],["that",["G3704"]],["none of these things",["G3367"]],["which",["G3739"]],["ye have spoken",["G2046"]],["come",["G1904"]],["upon",["G1909"]],["me.",[]]]},{"verse":25,"text":"And they, when they had testified and preached the word of the Lord, returned to Jerusalem, and preached the gospel in many villages of the Samaritans.","words":[["And they, when",["G3303","G3767"]],["they had testified",["G1263"]],["and",["G2532"]],["preached",["G2980"]],["the word",["G3056"]],["of the Lord,",["G2962"]],["returned",["G5290"]],["to",["G1519"]],["Jerusalem,",["G2419"]],["and",["G5037"]],["preached the gospel",["G2097"]],["in many",["G4183"]],["villages",["G2968"]],["of the Samaritans.",[]]]},{"verse":26,"text":"And the angel of the Lord spake unto Philip, saying, Arise, and go toward the south unto the way that goeth down from Jerusalem unto Gaza, which is desert.","words":[["And",["G1161"]],["the angel",["G32"]],["of the Lord",["G2962"]],["spake",["G2980"]],["unto",["G4314"]],["Philip,",["G5376"]],["saying,",["G3004"]],["Arise,",["G450"]],["and",["G2532"]],["go",["G4198"]],["toward",["G2596"]],["the south",["G3314"]],["unto",["G1909"]],["the way",["G3598"]],["that goeth down",["G2597"]],["from",["G575"]],["Jerusalem",["G2419"]],["unto",["G1519"]],["Gaza,",["G1048"]],["which",["G3778"]],["is",["G2076"]],["desert.",[]]]},{"verse":27,"text":"And he arose and went: and, behold, a man of E