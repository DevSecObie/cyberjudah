ust",["G1342"]],["man,",["G435"]],["and",["G2532"]],["one that feareth",["G5399"]],["God,",["G2316"]],["and",["G5037"]],["of good report",["G3140"]],["among",["G5259"]],["all",["G3650"]],["the nation",["G1484"]],["of the Jews,",["G2453"]],["was warned from God",["G5537"]],["by",["G5259"]],["an holy",["G40"]],["angel",["G32"]],["to send",["G3343"]],["for thee",["G4571"]],["into",["G1519"]],["his",["G846"]],["house,",["G3624"]],["and",["G2532"]],["to hear",["G191"]],["words",["G4487"]],["of",["G3844"]],["thee.",[]]]},{"verse":23,"text":"Then called he them in, and lodged them. And on the morrow Peter went away with them, and certain brethren from Joppa accompanied him.","words":[["Then",["G3767"]],["called he",["G1528"]],["them",["G846"]],["in,",["G1528"]],["and lodged",["G3579"]],["them. And",["G1161"]],["on the morrow",["G1887"]],["Peter",["G4074"]],["went away",["G1831"]],["with",["G4862"]],["them,",["G846"]],["and",["G2532"]],["certain",["G5100"]],["brethren",["G80"]],["from",["G575"]],["Joppa",["G2445"]],["accompanied",["G4905"]],["him.",[]]]},{"verse":24,"text":"And the morrow after they entered into Cesarea. And Cornelius waited for them, and had called together his kinsmen and near friends.","words":[["And",["G2532"]],["the morrow",["G1887"]],["after they entered",["G1525"]],["into",["G1519"]],["Cesarea.",["G2542"]],["And",["G1161"]],["Cornelius",["G2883"]],["waited for",["G4328"]],["them,",["G846","G2258"]],["and had called together",["G4779"]],["his",["G846"]],["kinsmen",["G4773"]],["and",["G2532"]],["near",["G316"]],["friends.",[]]]},{"verse":25,"text":"And as Peter was coming in, Cornelius met him, and fell down at his feet, and worshipped him.","words":[["And",["G1161"]],["as",["G5613"]],["Peter",["G4074"]],["was",["G1096"]],["coming in,",["G1525"]],["Cornelius",["G2883"]],["met",["G4876"]],["him,",["G846"]],["and fell down",["G4098"]],["at",["G1909"]],["his feet,",["G4228"]],["and worshipped him.",[]]]},{"verse":26,"text":"But Peter took him up, saying, Stand up; I myself also am a man.","words":[["But",["G1161"]],["Peter",["G4074"]],["took",["G1453"]],["him",["G846"]],["up,",["G1453"]],["saying,",["G3004"]],["Stand up;",["G450"]],["I",["G2504"]],["myself",["G846"]],["also",["G2504"]],["am",["G1510"]],["a man.",[]]]},{"verse":27,"text":"And as he talked with him, he went in, and found many that were come together.","words":[["And",["G2532"]],["as he talked",["G4926"]],["with him,",["G846"]],["he went in,",["G1525"]],["and",["G2532"]],["found",["G2147"]],["many",["G4183"]],["that were come together.",[]]]},{"verse":28,"text":"And he said unto them, Ye know how that it is an unlawful thing for a man that is a Jew to keep company, or come unto one of another nation; but God hath shewed me that I should not call any man common or unclean.","words":[["And",["G5037"]],["he said",["G5346"]],["unto",["G4314"]],["them,",["G846"]],["Ye",["G5210"]],["know",["G1987"]],["how",["G5613"]],["that it is",["G2076"]],["an unlawful thing",["G111"]],["for a man",["G435"]],["that is a Jew",["G2453"]],["to keep company,",["G2853"]],["or",["G2228"]],["come unto",["G4334"]],["one of another nation;",["G246"]],["but",["G2532"]],["God",["G2316"]],["hath shewed",["G1166"]],["me",["G1698"]],["that I should not",["G3367"]],["call",["G3004"]],["any",["G3367"]],["man",["G444"]],["common",["G2839"]],["or",["G2228"]],["unclean.",[]]]},{"verse":29,"text":"Therefore came I unto you without gainsaying, as soon as I was sent for: I ask therefore for what intent ye have sent for me?","words":[["Therefore",["G1352","G2532"]],["came I",["G2064"]],["unto you without gainsaying,",["G369"]],["as soon as I was sent for:",["G3343"]],["I ask",["G4441"]],["therefore",["G3767"]],["for what",["G5101"]],["intent",["G3056"]],["ye have sent for",["G3343"]],["me?",[]]]},{"verse":30,"text":"And Cornelius said, Four days ago I was fasting until this hour; and at the ninth hour I prayed in my house, and, behold, a man stood before me in bright clothing,","words":[["And",["G2532"]],["Cornelius",["G2883"]],["said,",["G5346"]],["Four",["G5067"]],["days",["G2250"]],["ago",["G575"]],["I was",["G2252"]],["fasting",["G3522"]],["until",["G3360"]],["this",["G5026"]],["hour;",["G5610"]],["and",["G2532"]],["at the ninth",["G1766"]],["hour",["G5610"]],["I prayed",["G4336"]],["in",["G1722"]],["my",["G3450"]],["house,",["G3624"]],["and,",["G2532"]],["behold,",["G2400"]],["a man",["G435"]],["stood",["G2476"]],["before",["G1799"]],["me",["G3450"]],["in",["G1722"]],["bright",["G2986"]],["clothing,",[]]]},{"verse":31,"text":"And said, Cornelius, thy prayer is heard, and thine alms are had in remembrance in the sight of God.","words":[["And",["G2532"]],["said,",["G5346"]],["Cornelius,",["G2883"]],["thy",["G4675"]],["prayer",["G4335"]],["is heard,",["G1522"]],["and",["G2532"]],["thine",["G4675"]],["alms",["G1654"]],["are had in remembrance",["G3415"]],["in the sight",["G1799"]],["of God.",[]]]},{"verse":32,"text":"Send therefore to Joppa, and call hither Simon, whose surname is Peter; he is lodged in the house of one Simon a tanner by the sea side: who, when he cometh, shall speak unto thee.","words":[["Send",["G3992"]],["therefore",["G3767"]],["to",["G1519"]],["Joppa,",["G2445"]],["and",["G2532"]],["call hither",["G3333"]],["Simon,",["G4613"]],["whose",["G3739"]],["surname is",["G1941"]],["Peter;",["G4074"]],["he",["G3778"]],["is lodged",["G3579"]],["in",["G1722"]],["the house",["G3614"]],["of one Simon",["G4613"]],["a tanner",["G1038"]],["by",["G3844"]],["the sea side:",["G2281"]],["who,",["G3739"]],["when he cometh,",["G3854"]],["shall speak",["G2980"]],["unto thee.",[]]]},{"verse":33,"text":"Immediately therefore I sent to thee; and thou hast well done that thou art come. Now therefore are we all here present before God, to hear all things that are commanded thee of God.","words":[["Immediately",["G1824"]],["therefore",["G3767"]],["I sent",["G3992"]],["to",["G4314"]],["thee;",["G4571"]],["and",["G5037"]],["thou",["G4771"]],["hast well",["G2573"]],