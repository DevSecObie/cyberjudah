{"book":"Mark","chapter":7,"translation":"KJV","url":"/bible/mark/7","verses":[{"verse":1,"text":"Then came together unto him the Pharisees, and certain of the scribes, which came from Jerusalem.","words":[["Then",["G2532"]],["came together",["G4863"]],["unto",["G4314"]],["him",["G846"]],["the Pharisees,",["G5330"]],["and",["G2532"]],["certain",["G5100"]],["of the scribes,",["G1122"]],["which came",["G2064"]],["from",["G575"]],["Jerusalem.",[]]]},{"verse":2,"text":"And when they saw some of his disciples eat bread with defiled, that is to say, with unwashen, hands, they found fault.","words":[["And",["G2532"]],["when they saw",["G1492"]],["some",["G5100"]],["of his",["G846"]],["disciples",["G3101"]],["eat",["G2068"]],["bread",["G740"]],["with defiled,",["G2839"]],["that is to say,",["G5123"]],["with unwashen,",["G449"]],["hands,",["G5495"]],["they found fault.",[]]]},{"verse":3,"text":"For the Pharisees, and all the Jews, except they wash their hands oft, eat not, holding the tradition of the elders.","words":[["For",["G1063"]],["the Pharisees,",["G5330"]],["and",["G2532"]],["all",["G3956"]],["the Jews,",["G2453"]],["except",["G3362"]],["they wash",["G3538"]],["their hands",["G5495"]],["oft,",["G4435"]],["eat",["G2068"]],["not,",["G3756"]],["holding",["G2902"]],["the tradition",["G3862"]],["of the elders.",[]]]},{"verse":4,"text":"And when they come from the market, except they wash, they eat not. And many other things there be, which they have received to hold, as the washing of cups, and pots, brasen vessels, and of tables.","words":[["And",["G2532"]],["when they come from",["G575"]],["the market,",["G58"]],["except",["G3362"]],["they wash,",["G907"]],["they eat",["G2068"]],["not.",["G3756"]],["And",["G2532"]],["many",["G4183"]],["other things",["G243"]],["there be,",["G2076"]],["which",["G3739"]],["they have received",["G3880"]],["to hold,",["G2902"]],["as the washing",["G909"]],["of cups,",["G4221"]],["and",["G2532"]],["pots,",["G3582","G2532"]],["brasen vessels,",["G5473"]],["and",["G2532"]],["of tables.",[]]]},{"verse":5,"text":"Then the Pharisees and scribes asked him, Why walk not thy disciples according to the tradition of the elders, but eat bread with unwashen hands?","words":[["Then",["G1899"]],["the Pharisees",["G5330"]],["and",["G2532"]],["scribes",["G1122"]],["asked",["G1905"]],["him,",["G846"]],["Why",["G1302"]],["walk",["G4043"]],["not",["G3756"]],["thy",["G4675"]],["disciples",["G3101"]],["according",["G2596"]],["to the tradition",["G3862"]],["of the elders,",["G4245"]],["but",["G235"]],["eat",["G2068"]],["bread",["G740"]],["with unwashen",["G449"]],["hands?",[]]]},{"verse":6,"text":"He answered and said unto them, Well hath Esaias prophesied of you hypocrites, as it is written, This people honoureth me with their lips, but their heart is far from me.","words":[["He answered",["G611"]],["and",["G1161"]],["said",["G2036"]],["unto them,",["G846","G3754"]],["Well",["G2573"]],["hath Esaias",["G2268"]],["prophesied",["G4395"]],["of",["G4012"]],["you",["G5216"]],["hypocrites,",["G5273"]],["as",["G5613"]],["it is written,",["G1125"]],["This",["G3778"]],["people",["G2992"]],["honoureth",["G5091"]],["me",["G3165"]],["with their lips,",["G5491"]],["but",["G1161"]],["their",["G846"]],["heart",["G2588"]],["is",["G568"]],["far",["G4206"]],["from",["G575"]],["me.",[]]]},{"verse":7,"text":"Howbeit in vain do they worship me, teaching for doctrines the commandments of men.","words":[["Howbeit",["G1161"]],["in vain",["G3155"]],["do they worship",["G4576"]],["me,",["G3165"]],["teaching",["G1321"]],["for doctrines",["G1319"]],["the commandments",["G1778"]],["of men.",[]]]},{"verse":8,"text":"For laying aside the commandment of God, ye hold the tradition of men, as the washing of pots and cups: and many other such like things ye do.","words":[["For",["G1063"]],["laying aside",["G863"]],["the commandment",["G1785"]],["of God,",["G2316"]],["ye hold",["G2902"]],["the tradition",["G3862"]],["of men,",["G444"]],["as the washing",["G909"]],["of pots",["G3582"]],["and",["G2532"]],["cups:",["G4221"]],["and",["G2532"]],["many",["G4183"]],["other",["G243"]],["such",["G5108"]],["like things",["G3946"]],["ye do.",[]]]},{"verse":9,"text":"And he said unto them, Full well ye reject the commandment of God, that ye may keep your own tradition.","words":[["And",["G2532"]],["he said",["G3004"]],["unto them,",["G846"]],["Full well",["G2573"]],["ye reject",["G114"]],["the commandment",["G1785"]],["of God,",["G2316"]],["that",["G2443"]],["ye may keep",["G5083"]],["your own",["G5216"]],["tradition.",[]]]},{"verse":10,"text":"For Moses said, Honour thy father and thy mother; and, Whoso curseth father or mother, let him die the death:","words":[["For",["G1063"]],["Moses",["G3475"]],["said,",["G2036"]],["Honour",["G5091"]],["thy",["G4675"]],["father",["G3962"]],["and",["G2532"]],["thy",["G4675"]],["mother;",["G3384"]],["and,",["G2532"]],["Whoso curseth",["G2551"]],["father",["G3962"]],["or",["G2228"]],["mother,",["G3384"]],["let him die",["G5053"]],["the death:",[]]]},{"verse":11,"text":"But ye say, If a man shall say to his father or mother, It is Corban, that is to say, a gift, by whatsoever thou mightest be profited by me; he shall be free.","words":[["But",["G1161"]],["ye",["G5210"]],["say,",["G3004"]],["If",["G1437"]],["a man",["G444"]],["shall say",["G2036"]],["to his father",["G3962"]],["or",["G2228"]],["mother,",["G3384"]],["It is Corban,",["G2878"]],["that is to say,",["G3603"]],["a gift,",["G1435"]],["by",["G1537"]],["whatsoever",["G3739","G1437"]],["thou mightest be profited by",["G5623"]],["me; he shall be free.",[]]]},{"verse":12,"text":"And ye suffer him no more to do ought for his father or his mother;","words":[["And",["G2532"]],["ye suffer",["G863"]],["him",["G846"]],["no more",["G3765"]],["to do",["G4160"]],["ought",["G3762"]],["for his",["G846"]],["father",["G3962"]],["or",["G2228"]],["his",["G846"]],["mother;",[]]]},{"verse":13,"text":"Making the word of God of none effect through your tradition, which ye have delivered: and many such like things do ye.","words":[["Making",["G208"]],["the word",["G3056"]],["of God",["G2316"]],["of none effect",["G208"]],["through your",["G5216"]],["tradition,",["G3862"]],["which",["G3739"]],["ye have delivered:",["G3860"]],["and",["G2532"]],["many",["G4183"]],["such",["G5108"]],["like things",["G3946"]],["do ye.",[]]]},{"verse":14,"text":"And when he had called all the people unto him, he said unto them, Hearken unto me every one of you, and understand:","words":[["And",["G2532"]],["when he had called",["G4341"]],["all",["G3956"]],["the people",["G3793"]],["unto him, he said",["G3004"]],["unto them,",["G846"]],["Hearken",["G191"]],["unto me",["G3450"]],["every one",["G3956"]],["of you, and",["G2532"]],["understand:",[]]]},{"verse":15,"text":"There is nothing from without a man, that entering into him can defile him: but the things which come out of him, those are they that defile the man.","words":[["There is",["G2076"]],["nothing",["G3762"]],["from without",["G1855"]],["a man,",["G444"]],["that",["G3739"]],["entering",["G1531"]],["into",["G1519"]],["him",["G846"]],["can",["G1410"]],["defile",["G2840"]],["him:",["G846"]],["but",["G235"]],["the things which come",["G1607"]],["out of",["G575"]],["him,",["G846"]],["those",["G1565"]],["are they",["G2076"]],["that defile",["G2840"]],["the man.",[]]]},{"verse":16,"text":"If any man have ears to hear, let him hear.","words":[["If any man",["G1536"]],["have",["G2192"]],["ears",["G3775"]],["to hear,",["G191"]],["let him hear.",[]]]},{"verse":17,"text":"And when he was entered into the house from the people, his disciples asked him concerning the parable.","words":[["And",["G2532"]],["when",["G3753"]],["he was entered",["G1525"]],["into",["G1519"]],["the house",["G3624"]],["from",["G575"]],["the people,",["G3793"]],["his",["G846"]],["disciples",["G3101"]],["asked",["G1905"]],["him",["G846"]],["concerning",["G4012"]],["the parable.",[]]]},{"verse":18,"text":"And he saith unto them, Are ye so without understanding also? Do ye not perceive, that whatsoever thing from without entereth into the man, it cannot defile him;","words":[["And",["G2532"]],["he saith",["G3004"]],["unto them,",["G846"]],["Are",["G2075"]],["ye",["G5210"]],["so",["G3779"]],["without understanding",["G801"]],["also?",["G2532"]],["Do ye",["G3539"]],["not",["G3756"]],["perceive,",["G3539"]],["that",["G3754"]],["whatsoever thing",["G3956"]],["from without",["G1855"]],["entereth",["G1531"]],["into",["G1519"]],["the man,",["G444"]],["it cannot",["G3756","G1410"]],["defile",["G2840"]],["him;",[]]]},{"verse":19,"text":"Because it entereth not into his heart, but into the belly, and goeth out into the draught, purging all meats?","words":[["Because",["G3754"]],["it entereth",["G1531"]],["not",["G3756"]],["into",["G1519"]],["his",["G846"]],["heart,",["G2588"]],["but",["G235"]],["into",["G1519"]],["the belly,",["G2836"]],["and",["G2532"]],["goeth out",["G1607"]],["into",["G1519"]],["the draught,",["G856"]],["purging",["G2511"]],["all",["G3956"]],["meats?",[]]]},{"verse":20,"text":"And he said, That which cometh out of the man, that defileth the man.","words":[["And",["G1161"]],["he said,",["G3004","G3754"]],["That which cometh",["G1607"]],["out of",["G1537"]],["the man,",["G444"]],["that",["G1565"]],["defileth",["G2840"]],["the man.",[]]]},{"verse":21,"text":"For from within, out of the heart of men, proceed evil thoughts, adulteries, fornications, murders,","words":[["For",["G1063"]],["from within,",["G2081"]],["out of",["G1537"]],["the heart",["G2588"]],["of men,",["G444"]],["proceed",["G1607"]],["evil",["G2556"]],["thoughts,",["G1261"]],["adulteries,",["G3430"]],["fornications,",["G4202"]],["murders,",[]]]},{"verse":22,"text":"Thefts, covetousness, wickedness, deceit, lasciviousness, an evil eye, blasphemy, pride, foolishness:","words":[["Thefts,",["G2829"]],["covetousness,",["G4124"]],["wickedness,",["G4189"]],["deceit,",["G1388"]],["lasciviousness,",["G766"]],["an evil",["G4190"]],["eye,",["G3788"]],["blasphemy,",["G988"]],["pride,",["G5243"]],["foolishness:",[]]]},{"verse":23,"text":"All these evil things come from within, and defile the man.","words":[["All",["G3956"]],["these",["G5023"]],["evil things",["G4190"]],["come",["G1607"]],["from within,",["G2081"]],["and",["G2532"]],["defile",["G2840"]],["the man.",[]]]},{"verse":24,"text":"And from thence he arose, and went into the borders of Tyre and Sidon, and entered into an house, and would have no man know it: but he could not be hid.","words":[["And",["G2532"]],["from thence",["G1564"]],["he arose,",["G450"]],["and went",["G565"]],["into",["G1519"]],["the borders",["G3181"]],["of Tyre",["G5184"]],["and",["G2532"]],["Sidon,",["G4605"]],["and",["G2532"]],["entered",["G1525"]],["into",["G1519"]],["an house,",["G3614"]],["and would have",["G2309"]],["no man",["G3762"]],["know",["G1097"]],["it: but",["G2532"]],["he could",["G1410"]],["not",["G3756"]],["be hid.",[]]]},{"verse":25,"text":"For a certain woman, whose young daughter had an unclean spirit, heard of him, and came and fell at his feet:","words":[["For",["G1063"]],["a certain woman,",["G1135"]],["whose",["G3739","G846"]],["young daughter",["G2365"]],["had",["G2192"]],["an unclean",["G169"]],["spirit,",["G4151"]],["heard",["G191"]],["of",["G4012"]],["him,",["G846"]],["and came",["G2064"]],["and fell",["G4363"]],["at",["G4314"]],["his",["G846"]],["feet:",[]]]},{"verse":26,"text":"The woman was a Greek, a Syrophenician by nation; and she besought him that he would cast forth the devil out of her daughter.","words":[["The woman",["G1135"]],["was",["G2258"]],["a Greek,",["G1674"]],["a Syrophenician",["G4949"]],["by nation;",["G1085"]],["and",["G2532"]],["she besought",["G2065"]],["him",["G846"]],["that",["G2443"]],["he would cast forth",["G1544"]],["the devil",["G1140"]],["out of",["G1537"]],["her",["G846"]],["daughter.",[]]]},{"verse":27,"text":"But Jesus said unto her, Let the children first be filled: for it is not meet to take the children’s bread, and to cast it unto the dogs.","words":[["But",["G1161"]],["Jesus",["G2424"]],["said",["G2036"]],["unto her,",["G846"]],["Let",["G863"]],["the children",["G5043"]],["first",["G4412"]],["be filled:",["G5526"]],["for",["G1063"]],["it is",["G2076"]],["not",["G3756"]],["meet",["G2570"]],["to take",["G2983"]],["the children’s bread,",["G740"]],["and",["G2532"]],["to cast",["G906"]],["it unto the dogs.",[]]]},{"verse":28,"text":"And she answered and said unto him, Yes, Lord: yet the dogs under the table eat of the children’s crumbs.","words":[["And",["G1161"]],["she answered",["G611"]],["and",["G2532"]],["said",["G3004"]],["unto him,",["G846"]],["Yes,",["G3483"]],["Lord:",["G2962"]],["yet",["G2532","G1063"]],["the dogs",["G2952"]],["under",["G5270"]],["the table",["G5132"]],["eat",["G2068"]],["of",["G575"]],["the children’s crumbs.",[]]]},{"verse":29,"text":"And he said unto her, For this saying go thy way; the devil is gone out of thy daughter.","words":[["And",["G2532"]],["he said",["G2036"]],["unto her,",["G846"]],["For",["G1223"]],["this",["G5126"]],["saying",["G3056"]],["go thy way;",["G5217"]],["the devil",["G1140"]],["is gone",["G1831"]],["out of",["G1537"]],["thy",["G4675"]],["daughter.",[]]]},{"verse":30,"text":"And when she was come to her house, she found the devil gone out, and her daughter laid upon the bed.","words":[["And",["G2532"]],["when she was come",["G565"]],["to",["G1519"]],["her",["G846"]],["house,",["G3624"]],["she found",["G2147"]],["the devil",["G1140"]],["gone out,",["G1831"]],["and",["G2532"]],["her daughter",["G2364"]],["laid",["G906"]],["upon",["G1909"]],["the bed.",[]]]},{"verse":31,"text":"And again, departing from the coasts of Tyre and Sidon, he came unto the sea of Galilee, through the midst of the coasts of Decapolis.","words":[["And",["G2532"]],["again,",["G3825"]],["departing",["G1831"]],["from",["G1537"]],["the coasts",["G3725"]],["of Tyre",["G5184"]],["and",["G2532"]],["Sidon,",["G4605"]],["he came",["G2064"]],["unto",["G4314"]],["the sea",["G2281"]],["of Galilee,",["G1056"]],["through",["G303"]],["the midst",["G3319"]],["of the coasts",["G3725"]],["of Decapolis.",[]]]},{"verse":32,"text":"And they bring unto him one that was deaf, and had an impediment in his speech; and they beseech him to put his hand upon him.","words":[["And",["G2532"]],["they bring",["G5342"]],["unto him",["G846"]],["one that was deaf,",["G2974"]],["and had an impediment in his speech;",["G3424"]],["and",["G2532"]],["they beseech",["G3870"]],["him",["G846"]],["to",["G2443"]],["put",["G2007"]],["his hand",["G5495"]],["upon him.",[]]]},{"verse":33,"text":"And he took him aside from the multitude, and put his fingers into his ears, and he spit, and touched his tongue;","words":[["And",["G2532"]],["he took",["G618"]],["him",["G846"]],["aside",["G2596","G2398"]],["from",["G575"]],["the multitude,",["G3793"]],["and put",["G906"]],["his",["G846"]],["fingers",["G1147"]],["into",["G1519"]],["his",["G846"]],["ears,",["G3775"]],["and",["G2532"]],["he spit,",["G4429"]],["and touched",["G680"]],["his",["G846"]],["tongue;",[]]]},{"verse":34,"text":"And looking up to heaven, he sighed, and saith unto him, Ephphatha, that is, Be opened.","words":[["And",["G2532"]],["looking up",["G308"]],["to",["G1519"]],["heaven,",["G3772"]],["he sighed,",["G4727"]],["and",["G2532"]],["saith",["G3004"]],["unto him,",["G846"]],["Ephphatha,",["G2188"]],["that is,",["G3603"]],["Be opened.",[]]]},{"verse":35,"text":"And straightway his ears were opened, and the string of his tongue was loosed, and he spake plain.","words":[["And",["G2532"]],["straightway",["G2112"]],["his",["G846"]],["ears",["G189"]],["were opened,",["G1272"]],["and",["G2532"]],["the string",["G1199"]],["of his",["G846"]],["tongue",["G1100"]],["was loosed,",["G3089"]],["and",["G2532"]],["he spake",["G2980"]],["plain.",[]]]},{"verse":36,"text":"And he charged them that they should tell no man: but the more he charged them, so much the more a great deal they published it;","words":[["And",["G2532"]],["he charged",["G1291"]],["them",["G846"]],["that",["G2443"]],["they should tell",["G2036"]],["no man:",["G3367"]],["but",["G1161"]],["the more",["G3745"]],["he",["G846"]],["charged",["G1291"]],["them,",["G846"]],["so much the more",["G3123"]],["a great deal",["G4054"]],["they published it;",[]]]},{"verse":37,"text":"And were beyond measure astonished, saying, He hath done all things well: he maketh both the deaf to hear, and the dumb to speak.","words":[["And",["G2532"]],["were beyond measure",["G5249"]],["astonished,",["G1605"]],["saying,",["G3004"]],["He hath done",["G4160"]],["all things",["G3956"]],["well:",["G2573"]],["he maketh",["G4160"]],["both",["G2532"]],["the deaf",["G2974"]],["to hear,",["G191"]],["and",["G2532"]],["the dumb",["G216"]],["to speak.",[]]]}]}