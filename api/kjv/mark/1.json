m.",[]]]},{"verse":28,"text":"And immediately his fame spread abroad throughout all the region round about Galilee.","words":[["And",["G1161"]],["immediately",["G2117"]],["his",["G846"]],["fame",["G189"]],["spread abroad",["G1831"]],["throughout",["G1519"]],["all",["G3650"]],["the region round about",["G4066"]],["Galilee.",[]]]},{"verse":29,"text":"And forthwith, when they were come out of the synagogue, they entered into the house of Simon and Andrew, with James and John.","words":[["And",["G2532"]],["forthwith,",["G2112"]],["when they were come",["G1831"]],["out of",["G1537"]],["the synagogue,",["G4864"]],["they entered",["G2064"]],["into",["G1519"]],["the house",["G3614"]],["of Simon",["G4613"]],["and",["G2532"]],["Andrew,",["G406"]],["with",["G3326"]],["James",["G2385"]],["and",["G2532"]],["John.",[]]]},{"verse":30,"text":"But Simon’s wife’s mother lay sick of a fever, and anon they tell him of her.","words":[["But",["G1161"]],["Simon’s wife’s mother",["G3994"]],["lay",["G2621"]],["sick of a fever,",["G4445"]],["and",["G2532"]],["anon",["G2112"]],["they tell",["G3004"]],["him",["G846"]],["of",["G4012"]],["her.",[]]]},{"verse":31,"text":"And he came and took her by the hand, and lifted her up; and immediately the fever left her, and she ministered unto them.","words":[["And",["G2532"]],["he came",["G4334"]],["and took",["G2902"]],["her",["G846"]],["by the hand,",["G5495"]],["and lifted",["G1453"]],["her",["G846"]],["up;",["G1453"]],["and",["G2532"]],["immediately",["G2112"]],["the fever",["G4446"]],["left",["G863"]],["her,",["G846"]],["and",["G2532"]],["she ministered",["G1247"]],["unto them.",[]]]},{"verse":32,"text":"And at even, when the sun did set, they brought unto him all that were diseased, and them that were possessed with devils.","words":[["And",["G1161"]],["at",["G1096"]],["even,",["G3798"]],["when",["G3753"]],["the sun",["G2246"]],["did set,",["G1416"]],["they brought",["G5342"]],["unto",["G4314"]],["him",["G846"]],["all",["G3956"]],["that were",["G2192"]],["diseased,",["G2560"]],["and",["G2532"]],["them that were possessed with devils.",[]]]},{"verse":33,"text":"And all the city was gathered together at the door.","words":[["And",["G2532"]],["all",["G3650"]],["the city",["G4172"]],["was",["G2258"]],["gathered together",["G1996"]],["at",["G4314"]],["the door.",[]]]},{"verse":34,"text":"And he healed many that were sick of divers diseases, and cast out many devils; and suffered not the devils to speak, because they knew him.","words":[["And",["G2532"]],["he healed",["G2323"]],["many",["G4183"]],["that were",["G2192"]],["sick",["G2560"]],["of divers",["G4164"]],["diseases,",["G3554"]],["and",["G2532"]],["cast out",["G1544"]],["many",["G4183"]],["devils;",["G1140"]],["and",["G2532"]],["suffered",["G863"]],["not",["G3756"]],["the devils",["G1140"]],["to speak,",["G2980"]],["because",["G3754"]],["they knew",["G1492"]],["him.",[]]]},{"verse":35,"text":"And in the morning, rising up a great while before day, he went out, and departed into a solitary place, and there prayed.","words":[["And",["G2532"]],["in the morning,",["G4404"]],["rising up",["G450"]],["a great while",["G3029"]],["before day,",["G1773"]],["he went out,",["G1831"]],["and",["G2532"]],["departed",["G565"]],["into",["G1519"]],["a solitary",["G2048"]],["place,",["G5117"]],["and there",["G2546"]],["prayed.",[]]]},{"verse":36,"text":"And Simon and they that were with him followed after him.","words":[["And",["G2532"]],["Simon",["G4613"]],["and",["G2532"]],["they that were with",["G3326"]],["him",["G846"]],["followed after",["G2614"]],["him.",[]]]},{"verse":37,"text":"And when they had found him, they said unto him, All men seek for thee.","words":[["And",["G2532"]],["when they had found",["G2147"]],["him,",["G846"]],["they said",["G3004"]],["unto him,",["G846","G3754"]],["All",["G3956"]],["men seek",["G2212"]],["for thee.",[]]]},{"verse":38,"text":"And he said unto them, Let us go into the next towns, that I may preach there also: for therefore came I fort