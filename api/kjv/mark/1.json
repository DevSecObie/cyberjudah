{"book":"Mark","chapter":1,"translation":"KJV","url":"/bible/mark/1","verses":[{"verse":1,"text":"The beginning of the gospel of Jesus Christ, the Son of God;","words":[["The beginning",["G746"]],["of the gospel",["G2098"]],["of Jesus",["G2424"]],["Christ,",["G5547"]],["the Son",["G5207"]],["of God;",[]]]},{"verse":2,"text":"As it is written in the prophets, Behold, I send my messenger before thy face, which shall prepare thy way before thee.","words":[["As",["G5613"]],["it is written",["G1125"]],["in",["G1722"]],["the prophets,",["G4396"]],["Behold,",["G2400"]],["I",["G1473"]],["send",["G649"]],["my",["G3450"]],["messenger",["G32"]],["before",["G4253"]],["thy",["G4675"]],["face,",["G4383"]],["which",["G3739"]],["shall prepare",["G2680"]],["thy",["G4675"]],["way",["G3598"]],["before",["G1715"]],["thee.",[]]]},{"verse":3,"text":"The voice of one crying in the wilderness, Prepare ye the way of the Lord, make his paths straight.","words":[["The voice",["G5456"]],["of one crying",["G994"]],["in",["G1722"]],["the wilderness,",["G2048"]],["Prepare ye",["G2090"]],["the way",["G3598"]],["of the Lord,",["G2962"]],["make",["G4160"]],["his",["G846"]],["paths",["G5147"]],["straight.",[]]]},{"verse":4,"text":"John did baptize in the wilderness, and preach the baptism of repentance for the remission of sins.","words":[["John",["G2491"]],["did",["G1096"]],["baptize",["G907"]],["in",["G1722"]],["the wilderness,",["G2048"]],["and",["G2532"]],["preach",["G2784"]],["the baptism",["G908"]],["of repentance",["G3341"]],["for",["G1519"]],["the remission",["G859"]],["of sins.",[]]]},{"verse":5,"text":"And there went out unto him all the land of Judea, and they of Jerusalem, and were all baptized of him in the river of Jordan, confessing their sins.","words":[["And",["G2532"]],["there went out",["G1607"]],["unto",["G4314"]],["him",["G846"]],["all",["G3956"]],["the land",["G5561"]],["of Judea,",["G2449"]],["and",["G2532"]],["they of Jerusalem,",["G2415"]],["and",["G2532"]],["were",["G907"]],["all",["G3956"]],["baptized",["G907"]],["of",["G5259"]],["him",["G846"]],["in",["G1722"]],["the river",["G4215"]],["of Jordan,",["G2446"]],["confessing",["G1843"]],["their",["G846"]],["sins.",[]]]},{"verse":6,"text":"And John was clothed with camel’s hair, and with a girdle of a skin about his loins; and he did eat locusts and wild honey;","words":[["And",["G1161"]],["John",["G2491"]],["was",["G2258"]],["clothed",["G1746"]],["with camel’s hair,",["G2359"]],["and",["G2532"]],["with a girdle",["G2223"]],["of a skin",["G1193"]],["about",["G4012"]],["his",["G846"]],["loins;",["G3751"]],["and",["G2532"]],["he did eat",["G2068"]],["locusts",["G200"]],["and",["G2532"]],["wild",["G66"]],["honey;",[]]]},{"verse":7,"text":"And preached, saying, There cometh one mightier than I after me, the latchet of whose shoes I am not worthy to stoop down and unloose.","words":[["And",["G2532"]],["preached,",["G2784"]],["saying,",["G3004"]],["There cometh",["G2064"]],["one mightier than",["G2478"]],["I",["G3450"]],["after",["G3694"]],["me,",["G3450"]],["the latchet",["G2438"]],["of whose",["G3739"]],["shoes",["G846","G5266"]],["I am",["G1510"]],["not",["G3756"]],["worthy",["G2425"]],["to stoop down",["G2955"]],["and unloose.",[]]]},{"verse":8,"text":"I indeed have baptized you with water: but he shall baptize you with the Holy Ghost.","words":[["I",["G1473"]],["indeed",["G3303"]],["have baptized",["G907"]],["you",["G5209"]],["with",["G1722"]],["water:",["G5204"]],["but",["G1161"]],["he",["G846"]],["shall baptize",["G907"]],["you",["G5209"]],["with",["G1722"]],["the Holy",["G40"]],["Ghost.",[]]]},{"verse":9,"text":"And it came to pass in those days, that Jesus came from Nazareth of Galilee, and was baptized of John in Jordan.","words":[["And",["G2532"]],["it came to pass",["G1096"]],["in",["G1722"]],["those",["G1565"]],["days,",["G2250"]],["that Jesus",["G2424"]],["came",["G2064"]],["from",["G575"]],["Nazareth",["G3478"]],["of Galilee,",["G1056"]],["and",["G2532"]],["was baptized",["G907"]],["of",["G5259"]],["John",["G2491"]],["in",["G1519"]],["Jordan.",[]]]},{"verse":10,"text":"And straightway coming up out of the water, he saw the heavens opened, and the Spirit like a dove descending upon him:","words":[["And",["G2532"]],["straightway",["G2112"]],["coming up",["G305"]],["out of",["G575"]],["the water,",["G5204"]],["he saw",["G1492"]],["the heavens",["G3772"]],["opened,",["G4977"]],["and",["G2532"]],["the Spirit",["G4151"]],["like",["G5616"]],["a dove",["G4058"]],["descending",["G2597"]],["upon",["G1909"]],["him:",[]]]},{"verse":11,"text":"And there came a voice from heaven, saying, Thou art my beloved Son, in whom I am well pleased.","words":[["And",["G2532"]],["there came",["G1096"]],["a voice",["G5456"]],["from",["G1537"]],["heaven,",["G3772"]],["saying, Thou",["G4771"]],["art",["G1488"]],["my",["G3450"]],["beloved",["G27"]],["Son,",["G5207"]],["in",["G1722"]],["whom",["G3739"]],["I am well pleased.",[]]]},{"verse":12,"text":"And immediately the Spirit driveth him into the wilderness.","words":[["And",["G2532"]],["immediately",["G2117"]],["the Spirit",["G4151"]],["driveth",["G1544"]],["him",["G846"]],["into",["G1519"]],["the wilderness.",[]]]},{"verse":13,"text":"And he was there in the wilderness forty days, tempted of Satan; and was with the wild beasts; and the angels ministered unto him.","words":[["And",["G2532"]],["he was",["G2258"]],["there",["G1563"]],["in",["G1722"]],["the wilderness",["G2048"]],["forty",["G5062"]],["days,",["G2250"]],["tempted",["G3985"]],["of",["G5259"]],["Satan;",["G4567"]],["and",["G2532"]],["was",["G2258"]],["with",["G3326"]],["the wild beasts;",["G2342"]],["and",["G2532"]],["the angels",["G32"]],["ministered",["G1247"]],["unto him.",[]]]},{"verse":14,"text":"Now after that John was put in prison, Jesus came into Galilee, preaching the gospel of the kingdom of God,","words":[["Now",["G1161"]],["after",["G3326"]],["that John",["G2491"]],["was put in prison,",["G3860"]],["Jesus",["G2424"]],["came",["G2064"]],["into",["G1519"]],["Galilee,",["G1056"]],["preaching",["G2784"]],["the gospel",["G2098"]],["of the kingdom",["G932"]],["of God,",[]]]},{"verse":15,"text":"And saying, The time is fulfilled, and the kingdom of God is at hand: repent ye, and believe the gospel.","words":[["And",["G2532"]],["saying,",["G3004","G3754"]],["The time",["G2540"]],["is fulfilled,",["G4137"]],["and",["G2532"]],["the kingdom",["G932"]],["of God",["G2316"]],["is at hand:",["G1448"]],["repent ye,",["G3340"]],["and",["G2532"]],["believe",["G4100","G1722"]],["the gospel.",[]]]},{"verse":16,"text":"Now as he walked by the sea of Galilee, he saw Simon and Andrew his brother casting a net into the sea: for they were fishers.","words":[["Now",["G1161"]],["as he walked",["G4043"]],["by",["G3844"]],["the sea",["G2281"]],["of Galilee,",["G1056"]],["he saw",["G1492"]],["Simon",["G4613"]],["and",["G2532"]],["Andrew",["G406"]],["his",["G846"]],["brother",["G80"]],["casting",["G906"]],["a net",["G293"]],["into",["G1722"]],["the sea:",["G2281"]],["for",["G1063"]],["they were",["G2258"]],["fishers.",[]]]},{"verse":17,"text":"And Jesus said unto them, Come ye after me, and I will make you to become fishers of men.","words":[["And",["G2532"]],["Jesus",["G2424"]],["said",["G2036"]],["unto them,",["G846"]],["Come ye",["G1205"]],["after",["G3694"]],["me,",["G3450"]],["and",["G2532"]],["I will make",["G4160"]],["you",["G5209"]],["to become",["G1096"]],["fishers",["G231"]],["of men.",[]]]},{"verse":18,"text":"And straightway they forsook their nets, and followed him.","words":[["And",["G2532"]],["straightway",["G2112"]],["they forsook",["G863"]],["their",["G846"]],["nets,",["G1350"]],["and followed",["G190"]],["him.",[]]]},{"verse":19,"text":"And when he had gone a little further thence, he saw James the son of Zebedee, and John his brother, who also were in the ship mending their nets.","words":[["And",["G2532"]],["when he had gone",["G4260"]],["a little",["G3641"]],["further",["G4260"]],["thence,",["G1564"]],["he saw",["G1492"]],["James",["G2385"]],["the son",["G3588"]],["of Zebedee,",["G2199"]],["and",["G2532"]],["John",["G2491"]],["his",["G846"]],["brother,",["G80"]],["who",["G846"]],["also",["G2532"]],["were in",["G1722"]],["the ship",["G4143"]],["mending",["G2675"]],["their nets.",[]]]},{"verse":20,"text":"And straightway he called them: and they left their father Zebedee in the ship with the hired servants, and went after him.","words":[["And",["G2532"]],["straightway",["G2112"]],["he called",["G2564"]],["them:",["G846"]],["and",["G2532"]],["they left",["G863"]],["their",["G846"]],["father",["G3962"]],["Zebedee",["G2199"]],["in",["G1722"]],["the ship",["G4143"]],["with",["G3326"]],["the hired servants,",["G3411"]],["and went",["G565"]],["after",["G3694"]],["him.",[]]]},{"verse":21,"text":"And they went into Capernaum; and straightway on the sabbath day he entered into the synagogue, and taught.","words":[["And",["G2532"]],["they went",["G1531"]],["into",["G1519"]],["Capernaum;",["G2584"]],["and",["G2532"]],["straightway",["G2112"]],["on the sabbath day",["G4521"]],["he entered",["G1525"]],["into",["G1519"]],["the synagogue,",["G4864"]],["and taught.",[]]]},{"verse":22,"text":"And they were astonished at his doctrine: for he taught them as one that had authority, and not as the scribes.","words":[["And",["G2532"]],["they were astonished",["G1605"]],["at",["G1909"]],["his",["G846"]],["doctrine:",["G1322"]],["for",["G1063"]],["he taught",["G1321","G2258"]],["them",["G846"]],["as",["G5613"]],["one that had",["G2192"]],["authority,",["G1849"]],["and",["G2532"]],["not",["G3756"]],["as",["G5613"]],["the scribes.",[]]]},{"verse":23,"text":"And there was in their synagogue a man with an unclean spirit; and he cried out,","words":[["And",["G2532"]],["there was",["G2258"]],["in",["G1722"]],["their",["G846"]],["synagogue",["G4864"]],["a man",["G444"]],["with",["G1722"]],["an unclean",["G169"]],["spirit;",["G4151"]],["and",["G2532"]],["he cried out,",[]]]},{"verse":24,"text":"Saying, Let us