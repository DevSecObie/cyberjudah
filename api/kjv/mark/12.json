"G2532"]],["Jesus",["G2424"]],["answering",["G611"]],["said",["G2036"]],["unto them,",["G846"]],["Render",["G591"]],["to Cesar",["G2541"]],["the things that are",["G3588"]],["Cesar’s, and",["G2532"]],["to God",["G2316"]],["the things that are",["G3588"]],["God’s. And",["G2532"]],["they marvelled",["G2296"]],["at",["G1909"]],["him.",[]]]},{"verse":18,"text":"Then come unto him the Sadducees, which say there is no resurrection; and they asked him, saying,","words":[["Then",["G2532"]],["come",["G2064"]],["unto",["G4314"]],["him",["G846"]],["the Sadducees,",["G4523"]],["which",["G3748"]],["say",["G3004"]],["there is",["G1511"]],["no",["G3361"]],["resurrection;",["G386"]],["and",["G2532"]],["they asked",["G1905"]],["him,",["G846"]],["saying,",[]]]},{"verse":19,"text":"Master, Moses wrote unto us, If a man’s brother die, and leave his wife behind him, and leave no children, that his brother should take his wife, and raise up seed unto his brother.","words":[["Master,",["G1320"]],["Moses",["G3475"]],["wrote",["G1125"]],["unto us,",["G2254"]],["If",["G3754","G1437"]],["a man’s brother",["G80"]],["die,",["G599"]],["and",["G2532"]],["leave",["G2641"]],["his wife",["G1135"]],["behind him, and",["G2532"]],["leave",["G863"]],["no",["G3361"]],["children,",["G5043"]],["that",["G2443"]],["his",["G846"]],["brother",["G80"]],["should take",["G2983"]],["his",["G846"]],["wife,",["G1135"]],["and",["G2532"]],["raise up",["G1817"]],["seed",["G4690"]],["unto his",["G846"]],["brother.",[]]]},{"verse":20,"text":"Now there were seven brethren: and the first took a wife, and dying left no seed.","words":[["Now there were",["G2258"]],["seven",["G2033"]],["brethren:",["G80"]],["and",["G2532"]],["the first",["G4413"]],["took",["G2983"]],["a wife,",["G1135"]],["and",["G2532"]],["dying",["G599"]],["left",["G863"]],["no",["G3756"]],["seed.",[]]]},{"verse":21,"text":"And the second took her, and died, neither left he any seed: and the third likewise.","words":[["And",["G2532"]],["the second",["G1208"