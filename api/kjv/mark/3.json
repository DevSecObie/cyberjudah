{"book":"Mark","chapter":3,"translation":"KJV","url":"/bible/mark/3","verses":[{"verse":1,"text":"And he entered again into the synagogue; and there was a man there which had a withered hand.","words":[["And",["G2532"]],["he entered",["G1525"]],["again",["G3825"]],["into",["G1519"]],["the synagogue;",["G4864"]],["and",["G2532"]],["there was",["G2258"]],["a man",["G444"]],["there",["G1563"]],["which had",["G2192"]],["a withered",["G3583"]],["hand.",[]]]},{"verse":2,"text":"And they watched him, whether he would heal him on the sabbath day; that they might accuse him.","words":[["And",["G2532"]],["they watched",["G3906"]],["him,",["G846"]],["whether",["G1487"]],["he would heal",["G2323"]],["him",["G846"]],["on the sabbath day;",["G4521"]],["that",["G2443"]],["they might accuse",["G2723"]],["him.",[]]]},{"verse":3,"text":"And he saith unto the man which had the withered hand, Stand forth.","words":[["And",["G2532"]],["he saith",["G3004"]],["unto the man",["G444"]],["which had",["G2192"]],["the withered",["G3583"]],["hand,",["G5495"]],["Stand",["G1453"]],["forth.",["G1519"]]]},{"verse":4,"text":"And he saith unto them, Is it lawful to do good on the sabbath days, or to do evil? to save life, or to kill? But they held their peace.","words":[["And",["G2532"]],["he saith",["G3004"]],["unto them,",["G846"]],["Is it lawful",["G1832"]],["to do good",["G15"]],["on the sabbath days,",["G4521"]],["or",["G2228"]],["to do evil?",["G2554"]],["to save",["G4982"]],["life,",["G5590"]],["or",["G2228"]],["to kill?",["G615"]],["But",["G1161"]],["they held their peace.",[]]]},{"verse":5,"text":"And when he had looked round about on them with anger, being grieved for the hardness of their hearts, he saith unto the man, Stretch forth thine hand. And he stretched it out: and his hand was restored whole as the other.","words":[["And",["G2532"]],["when he had looked round about",["G4017"]],["on them",["G846"]],["with",["G3326"]],["anger,",["G3709"]],["being grieved",["G4818"]],["for",["G1909"]