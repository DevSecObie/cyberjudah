]]]},{"verse":23,"text":"And besought him greatly, saying, My little daughter lieth at the point of death: I pray thee, come and lay thy hands on her, that she may be healed; and she shall live.","words":[["And",["G2532"]],["besought",["G3870"]],["him",["G846"]],["greatly,",["G4183"]],["saying,",["G3004","G3754"]],["My",["G3450"]],["little daughter",["G2365"]],["lieth",["G2079"]],["at the point of death:",["G2192"]],["I pray thee, come",["G2064"]],["and",["G2443"]],["lay",["G2007"]],["thy hands",["G5495"]],["on her,",["G846"]],["that",["G3704"]],["she may be healed;",["G4982"]],["and",["G2532"]],["she shall live.",[]]]},{"verse":24,"text":"And Jesus went with him; and much people followed him, and thronged him.","words":[["And",["G2532"]],["Jesus went",["G565"]],["with",["G3326"]],["him;",["G846"]],["and",["G2532"]],["much",["G4183"]],["people",["G3793"]],["followed",["G190"]],["him,",["G846"]],["and",["G2532"]],["thronged",["G4918"]],["him.",[]]]},{"verse":25,"text":"And a certain woman, which had an issue of blood twelve years,","words":[["And",["G2532"]],["a certain",["G5100"]],["woman,",["G1135"]],["which had an",["G1722"]],["issue",["G4511"]],["of blood",["G129","G5607"]],["twelve",["G1427"]],["years,",[]]]},{"verse":26,"text":"And had suffered many things of many physicians, and had spent all that she had, and was nothing bettered, but rather grew worse,","words":[["And",["G2532"]],["had suffered",["G3958"]],["many things",["G4183"]],["of",["G5259"]],["many",["G4183"]],["physicians,",["G2395"]],["and",["G2532"]],["had spent",["G1159"]],["all",["G3956"]],["that she",["G1438"]],["had,",["G3844"]],["and",["G2532"]],["was",["G5623"]],["nothing",["G3367"]],["bettered,",["G5623"]],["but",["G235"]],["rather",["G3123"]],["grew",["G2064"]],["worse,",["G1519"]]]},{"verse":27,"text":"When she had heard of Jesus, came in the press behind, and touched his garment.","words":[["When she had heard",["G191"]],["of",["G4012"]],["Jesus,",["G2424"]],["came",["G2064"]],["in",["G1722"]],["the press",["G3793"]],["behind,",["G3693"]],["and touched",["G680"]],["his",["G846"]],["garment.",[]]]},{"verse":28,"text":"For she said, If I may touch but his clothes, I shall be whole.","words":[["For",["G1063"]],["she said,",["G3004","G3754"]],["If",["G2579"]],["I may touch",["G680"]],["but",["G2579"]],["his",["G846"]],["clothes,",["G2440"]],["I shall be whole.",[]]]},{"verse":29,"text":"And straightway the fountain of her blood was dried up; and she felt in her body that she was healed of that plague.","words":[["And",["G2532"]],["straightway",["G2112"]],["the fountain",["G4077"]],["of her",["G846"]],["blood",["G129"]],["was dried up;",["G3583"]],["and",["G2532"]],["she felt",["G1097"]],["in her body",["G4983"]],["that",["G3754"]],["she was healed",["G2390"]],["of",["G575"]],["that plague.",[]]]},{"verse":30,"text":"And Jesus, immediately knowing in himself that virtue had gone out of him, turned him about in the press, and said, Who touched my clothes?","words":[["And",["G2532"]],["Jesus,",["G2424"]],["immediately",["G2112"]],["knowing",["G1921"]],["in",["G1722"]],["himself",["G1438"]],["that virtue",["G1411"]],["had gone",["G1831"]],["out of",["G1537"]],["him,",["G846"]],["turned him about",["G1994"]],["in",["G1722"]],["the press,",["G3793"]],["and said,",["G3004"]],["Who",["G5101"]],["touched",["G680"]],["my",["G3450"]],["clothes?",[]]]},{"verse":31,"text":"And his disciples said unto him, Thou seest the multitude thronging thee, and sayest thou, Who touched me?","words":[["And",["G2532"]],["his",["G846"]],["disciples",["G3101"]],["said",["G3004"]],["unto him,",["G846"]],["Thou seest",["G991"]],["the multitude",["G3793"]],["thronging",["G4918"]],["thee,",["G4571"]],["and",["G2532"]],["sayest thou,",["G3004"]],["Who",["G5101"]],["touched",["G680"]],["me?",[]]]},{"verse":32,"text":"And he looked round about to see her that had done this thing.","words":[["And",["G2532"]],["he looked round about",["G4017"]],["to see",["G1492"]],["her that had done",["G4