d",["G2532"]],["the scribes.",[]]]},{"verse":54,"text":"And Peter followed him afar off, even into the palace of the high priest: and he sat with the servants, and warmed himself at the fire.","words":[["And",["G2532"]],["Peter",["G4074"]],["followed",["G190"]],["him",["G846"]],["afar",["G3113"]],["off,",["G575"]],["even",["G2193"]],["into",["G2080","G1519"]],["the palace",["G833"]],["of the high priest:",["G749"]],["and",["G2532"]],["he sat",["G2258","G4775"]],["with",["G3326"]],["the servants,",["G5257"]],["and",["G2532"]],["warmed himself",["G2328"]],["at",["G4314"]],["the fire.",[]]]},{"verse":55,"text":"And the chief priests and all the council sought for witness against Jesus to put him to death; and found none.","words":[["And",["G1161"]],["the chief priests",["G749"]],["and",["G2532"]],["all",["G3650"]],["the council",["G4892"]],["sought",["G2212"]],["for witness",["G3141"]],["against",["G2596"]],["Jesus",["G2424"]],["to",["G1519"]],["put",["G2289"]],["him",["G846"]],["to death;",["G2289"]],["and",["G2532"]],["found",["G2147"]],["none.",[]]]},{"verse":56,"text":"For many bare false witness against him, but their witness agreed not together.","words":[["For",["G1063"]],["many",["G4183"]],["bare false witness",["G5576"]],["against",["G2596"]],["him,",["G846"]],["but",["G2532"]],["their witness",["G3141"]],["agreed",["G2258"]],["not",["G2470","G3756"]],["together.",[]]]},{"verse":57,"text":"And there arose certain, and bare false witness against him, saying,","words":[["And",["G2532"]],["there arose",["G450"]],["certain,",["G5100"]],["and bare false witness",["G5576"]],["against",["G2596"]],["him,",["G846"]],["saying,",[]]]},{"verse":58,"text":"We heard him say, I will destroy this temple that is made with hands, and within three days I will build another made without hands.","words":[["We",["G2249"]],["heard",["G191"]],["him",["G846"]],["say,",["G3004","G3754"]],["I",["G1473"]],["will destroy",["G2647"]],["this",["G5126"]],["temple",["G3485"]],["that is made with hands,",["G5499"]],["and",["G2532"]],["within",["G1223"]],["three",["G5140"]],["days",["G2250"]],["I will build",["G3618"]],["another",["G243"]],["made without hands.",[]]]},{"verse":59,"text":"But neither so did their witness agree together.","words":[["But",["G2532"]],["neither",["G3761"]],["so",["G3779"]],["did",["G2470"]],["their",["G846"]],["witness",["G3141"]],["agree together.",["G2258"]]]},{"verse":60,"text":"And the high priest stood up in the midst, and asked Jesus, saying, Answerest thou nothing? what is it which these witness against thee?","words":[["And",["G2532"]],["the high priest",["G749"]],["stood up",["G450"]],["in",["G1519"]],["the midst,",["G3319"]],["and asked",["G1905"]],["Jesus,",["G2424"]],["saying,",["G3004"]],["Answerest",["G3756"]],["thou",["G611"]],["nothing?",["G3762"]],["what",["G5101"]],["is it which these",["G3778"]],["witness",["G2649"]],["against thee?",[]]]},{"verse":61,"text":"But he held his peace, and answered nothing. Again the high priest asked him, and said unto him, Art thou the Christ, the Son of the Blessed?","words":[["But",["G1161"]],["he held his peace,",["G4623"]],["and",["G2532"]],["answered",["G611"]],["nothing.",["G3762"]],["Again",["G3825"]],["the high priest",["G749"]],["asked",["G1905"]],["him,",["G846"]],["and",["G2532"]],["said",["G3004"]],["unto him,",["G846"]],["Art",["G1488"]],["thou",["G4771"]],["the Christ,",["G5547"]],["the Son",["G5207"]],["of the Blessed?",[]]]},{"verse":62,"text":"And Jesus said, I am: and ye shall see the Son of man sitting on the right hand of power, and coming in the clouds of heaven.","words":[["And",["G1161"]],["Jesus",["G2424"]],["said,",["G2036"]],["I",["G1473"]],["am:",["G1510"]],["and",["G2532"]],["ye shall see",["G3700"]],["the Son",["G5207"]],["of man",["G444"]],["sitting",["G2521"]],["on",["G1537"]],["the right hand",["G1188"]],["of power,",["G1411"]],["and",["G2532"]],["coming",["G2064"]],["in",["G3326"]],["the clouds",["G3507"]],["of heaven.",[]]]},{"verse":63,"text"