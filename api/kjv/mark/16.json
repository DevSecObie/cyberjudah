["Afterward",["G5305"]],["he appeared",["G5319"]],["unto the eleven",["G1733"]],["as they",["G846"]],["sat at meat,",["G345"]],["and",["G2532"]],["upbraided",["G3679"]],["them with their",["G846"]],["unbelief",["G570"]],["and",["G2532"]],["hardness of heart,",["G4641"]],["because",["G3754"]],["they believed",["G4100"]],["not",["G3756"]],["them which had seen",["G2300"]],["him",["G846"]],["after he was risen.",[]]]},{"verse":15,"text":"And he said unto them, Go ye into all the world, and preach the gospel to every creature.","words":[["And",["G2532"]],["he said",["G2036"]],["unto them,",["G846"]],["Go ye",["G4198"]],["into",["G1519"]],["all",["G537"]],["the world,",["G2889"]],["and preach",["G2784"]],["the gospel",["G2098"]],["to every",["G3956"]],["creature.",[]]]},{"verse":16,"text":"He that believeth and is baptized shall be saved; but he that believeth not shall be damned.","words":[["He that believeth",["G4100"]],["and",["G2532"]],["is baptized",["G907"]],["shall be saved;",["G4982"]],["but",["G1161"]],["he that believeth not",["G569"]],["shall be damned.",[]]]},{"verse":17,"text":"And these signs shall follow them that believe; In my name shall they cast out devils; they shall speak with new tongues;","words":[["And",["G1161"]],["these",["G5023"]],["signs",["G4592"]],["shall follow",["G3877"]],["them that believe;",["G4100"]],["In",["G1722"]],["my",["G3450"]],["name",["G3686"]],["shall they cast out",["G1544"]],["devils;",["G1140"]],["they shall speak",["G2980"]],["with new",["G2537"]],["tongues;",[]]]},{"verse":18,"text":"They shall take up serpents; and if they drink any deadly thing, it shall not hurt them; they shall lay hands on the sick, and they shall recover.","words":[["They shall take up",["G142"]],["serpents;",["G3789"]],["and if",["G2579"]],["they drink",["G4095"]],["any",["G5100"]],["deadly",["G2286"]],["thing,",["G5100"]],["it shall not",["G3364"]],["hurt",["G984"]],["them;",["G846"]],["they shall lay",["G2007"]],["hands",["G5495"]],["on",["G1909"]],["the sick,",["G732"]],["and",["G2532"]],["they shall",["G2192"]],["recover.",[]]]},{"verse":19,"text":"So then after the Lord had spoken unto them, he was received up into heaven, and sat on the right hand of God.","words":[["So",["G3303"]],["then",["G3767"]],["after",["G3326"]],["the Lord",["G2962"]],["had spoken",["G2980"]],["unto them,",["G846"]],["he was received up",["G353"]],["into",["G1519"]],["heaven,",["G3772"]],["and",["G2532"]],["sat",["G2523"]],["on",["G1537"]],["the right hand",["G1188"]],["of God.",[]]]},{"verse":20,"text":"And they went forth, and preached every where, the Lord working with them, and confirming the word with signs following. Amen.","words":[["And",["G1161"]],["they",["G1565"]],["went forth,",["G1831"]],["and preached",["G2784"]],["every where,",["G3837"]],["the Lord",["G2962"]],["working with",["G4903"]],["them, and",["G2532"]],["confirming",["G950"]],["the word",["G3056"]],["with",["G1223"]],["signs",["G4592"]],["following.",["G1872"]],["Amen.",[]]]}]}