s",["G749"]],["moved",["G383"]],["the people,",["G3793"]],["that",["G2443"]],["he should rather",["G3123"]],["release",["G630"]],["Barabbas",["G912"]],["unto them.",[]]]},{"verse":12,"text":"And Pilate answered and said again unto them, What will ye then that I shall do unto him whom ye call the King of the Jews?","words":[["And",["G1161"]],["Pilate",["G4091"]],["answered",["G611"]],["and said",["G2036"]],["again",["G3825"]],["unto them,",["G846"]],["What",["G5101"]],["will ye",["G2309"]],["then",["G3767"]],["that I shall do",["G4160"]],["unto him whom",["G3739"]],["ye call",["G3004"]],["the King",["G935"]],["of the Jews?",[]]]},{"verse":13,"text":"And they cried out again, Crucify him.","words":[["And",["G1161"]],["they cried out",["G2896"]],["again,",["G3825"]],["Crucify",["G4717"]],["him.",[]]]},{"verse":14,"text":"Then Pilate said unto them, Why, what evil hath he done? And they cried out the more exceedingly, Crucify him.","words":[["Then",["G1161"]],["Pilate",["G4091"]],["said",["G3004"]],["unto them,",["G846"]],["Why,",["G1063"]],["what",["G5101"]],["evil",["G2556"]],["hath he done?",["G4160"]],["And",["G1161"]],["they cried out",["G2896"]],["the more exceedingly,",["G4056"]],["Crucify",["G4717"]],["him.",[]]]},{"verse":15,"text":"And so Pilate, willing to content the people, released Barabbas unto them, and delivered Jesus, when he had scourged him, to be crucified.","words":[["And",["G1161"]],["so Pilate,",["G4091"]],["willing",["G1014"]],["to content",["G2425","G4160"]],["the people,",["G3793"]],["released",["G630"]],["Barabbas",["G912"]],["unto them,",["G846"]],["and",["G2532"]],["delivered",["G3860"]],["Jesus,",["G2424"]],["when he had scourged",["G5417"]],["him, to",["G2443"]],["be crucified.",[]]]},{"verse":16,"text":"And the soldiers led him away into the hall, called Pretorium; and they call together the whole band.","words":[["And",["G1161"]],["the soldiers",["G4757"]],["led",["G520"]],["him",["G846"]],["away",["G520"]],["into",["G2080"]],["the hall,",["G833"]],["called",["G3603"]],["Pretorium;",["G4232"]],["and",["G2532"]],["they call together",["G4779"]],["the whole",["G3650"]],["band.",[]]]},{"verse":17,"text":"And they clothed him with purple, and platted a crown of thorns, and put it about his head,","words":[["And",["G2532"]],["they clothed",["G1746"]],["him",["G846"]],["with purple,",["G4209"]],["and",["G2532"]],["platted",["G4120"]],["a crown",["G4735"]],["of thorns,",["G174"]],["and put it about",["G4060"]],["his head,",[]]]},{"verse":18,"text":"And began to salute him, Hail, King of the Jews!","words":[["And",["G2532"]],["began",["G756"]],["to salute",["G782"]],["him,",["G846"]],["Hail,",["G5463"]],["King",["G935"]],["of the Jews!",[]]]},{"verse":19,"text":"And they smote him on the head with a reed, and did spit upon him, and bowing their knees worshipped him.","words":[["And",["G2532"]],["they smote",["G5180"]],["him",["G846"]],["on the head",["G2776"]],["with a reed,",["G2563"]],["and",["G2532"]],["did spit",["G1716"]],["upon him,",["G846"]],["and",["G2532"]],["bowing",["G5087"]],["their knees",["G1119"]],["worshipped",["G4352"]],["him.",[]]]},{"verse":20,"text":"And when they had mocked him, they took off the purple from him, and put his own clothes on him, and led him out to crucify him.","words":[["And",["G2532"]],["when",["G3753"]],["they had mocked",["G1702"]],["him,",["G846"]],["they took off",["G1562"]],["the purple",["G4209"]],["from him,",["G846"]],["and",["G2532"]],["put",["G1746"]],["his own",["G2398"]],["clothes",["G2440"]],["on",["G1746"]],["him,",["G846"]],["and",["G2532"]],["led",["G1806"]],["him",["G846"]],["out",["G1806"]],["to",["G2443"]],["crucify",["G4717"]],["him.",[]]]},{"verse":21,"text":"And they compel one Simon a Cyrenian, who passed by, coming out of the country, the father of Alexander and Rufus, to bear his cross.","words":[["And",["G2532"]],["they compel",["G29"]],["one",["G5100"]],["Simon",["G4613"]],["a Cyrenian,",["G2956"]],["who passed by,",["G3855"]],["coming",["G2064"]],["out of",["G575"]],["the country,",["G68"]],["the father",["G3962"]],["of Alexander",["G223"]],["and",["G2532"]],["Rufus,",["G4504"]],["to",["G2443"]],["bear",["G142"]],["his",["G846"]],["cross.",[]]]},{"verse":22,"text":"And they bring him unto the place Golgotha, which is, being interpreted, The place of a skull.","words":[["And",["G2532"]],["they bring",["G5342"]],["him",["G846"]],["unto",["G1909"]],["the place",["G5117"]],["Golgotha,",["G1115"]],["which",["G3739"]],["is,",["G2076"]],["being interpreted,",["G3177"]],["The place",["G5117"]],["of a skull.",[]]]},{"verse":23,"text":"And they gave him to drink wine mingled with myrrh: but he received it not.","words":[["And",["G2532"]],["they gave",["G1325"]],["him",["G846"]],["to drink",["G4095"]],["wine",["G3631"]],["mingled with myrrh:",["G4669"]],["but",["G1161"]],["he received",["G2983"]],["it not.",[]]]},{"verse":24,"text":"And when they had crucified him, they parted his garments, casting lots upon them, what every man should take.","words":[["And",["G2532"]],["when they had crucified",["G4717"]],["him,",["G846"]],["they parted",["G1266"]],["his",["G846"]],["garments,",["G2440"]],["casting",["G906"]],["lots",["G2819"]],["upon",["G1909"]],["them,",["G846"]],["what",["G5101"]],["every man",["G5101"]],["should take.",[]]]},{"verse":25,"text":"And it was the third hour, and they crucified him.","words":[["And",["G1161"]],["it was",["G2258"]],["the third",["G5154"]],["hour,",["G5610"]],["and",["G2532"]],["they crucified",["G4717"]],["him.",[]]]},{"verse":26,"text":"And the superscription of his accusation was written over, THE KING OF THE JEWS.","words":[["And",["G2532"]],["the superscription",["G1923"]],["of his",["G846"]],["accusation",["G156"]],["was",["G2258"]],["written over,",["G1924"]],["THE KING",["G935"]],["OF THE JEWS.",[]]]},{"verse":27,"text":"And with him they crucify two thieves; the one on his right hand, and the other on his left.","words":[["And",["G2532"]],["with",["G4862"]],["him",["G846"]],["they crucify",["G4717"]],["two",["G1417"]],["thieves;",["G3027"]],["the one",["G1520"]],["on",["G1537"]],["his right hand,",["G1188"]],["and",["G2532"]],["the other",["G1520"]],["on",["G1537"]],["his",["G846"]],["left.",[]]]},{"verse":28,"text":"And the scripture was fulfilled, which saith, And he was numbered with the transgressors.","words":[["And",["G2532"]],["the scripture",["G1124"]],["was fulfilled,",["G4137"]],["which",["G3588"]],["saith,",["G3004"]],["And",["G2532"]],["he was numbered",["G3049"]],["with",["G3326"]],["the transgressors.",[]]]},{"verse":29,"text":"And they that passed by railed on him, wagging their heads, and saying, Ah, thou that destroyest the temple, and buildest it in three days,","words":[["And",["G2532"]],["they that passed by",["G3899"]],["railed",["G987"]],["on him,",["G846"]],["wagging",["G2795"]],["their",["G846"]],["heads,",["G2776"]],["and",["G2532"]],["saying,",["G3004"]],["Ah,",["G3758"]],["thou that destroyest",["G2647"]],["the temple,",["G3485"]],["and",["G2532"]],["buildest",["G3618"]],["it in",["G1722"]],["three",["G5140"]],["days,",[]]]},{"verse":30,"text":"Save thyself, and come down from the cross.","words":[["Save",["G4982"]],["thyself,",["G4572"]],["and",["G2532"]],["come down",["G2597"]],["from",["G575"]],["the cross.",[]]]},{"verse":31,"text":"Likewise also the chief priests mocking said among themselves with the scribes, He saved others; himself he cannot save.","words":[["Likewise",["G1161","G3668"]],["also",["G2532"]],["the chief priests",["G749"]],["mocking",["G1702"]],["said",["G3004"]],["among",["G4314"]],["themselves",["G240"]],["with",["G3326"]],["the scribes,",["G1122"]],["He saved",["G4982"]],["others;",["G243"]],["himself",["G1438"]],["he cannot",["G3756","G1410"]],["save.",[]]]},{"verse":32,"text":"Let Christ the King of Israel descend now from the cross, that we may see and believe. And they that were crucified with him reviled him.","words":[["Let",["G2597"]],["Christ",["G5547"]],["the King",["G935"]],["of Israel",["G2474"]],["descend",["G2597"]],["now",["G3568"]],["from",["G575"]],["the cross,",["G4716"]],["that",["G2443"]],["we may see",["G1492"]],["and",["G2532"]],["believe.",["G4100"]],["And",["G2532"]],["they that were crucified",["G4957"]],["with him",["G846"]],["reviled",["G3679"]],["him.",[]]]},{"verse":33,"text":"And when the sixth hour was come, there was darkness over the whole land until the ninth hour.","words":[["And",["G1161"]],["when",["G1096"]],["the sixth",["G1623"]],["hour",["G5610"]],["was come,",["G1096"]],["there was",["G1096"]],["darkness",["G4655"]],["over",["G1909"]],["the whole",["G3650"]],["land",["G1093"]],["until",["G2193"]],["the ninth",["G1766"]],["hour.",[]]]},{"verse":34,"text":"And at the ninth hour Jesus cried with a loud voice, saying, Eloi, Eloi, lama sabachthani? which is, being interpreted, My God, my God, why hast thou forsaken me?","words":[["And",["G2532"]],["at the ninth",["G1766"]],["hour",["G5610"]],["Jesus",["G2424"]],["cried",["G994"]],["with a loud",["G3173"]],["voice,",["G5456"]],["saying,",["G3004"]],["Eloi,",["G1682"]],["Eloi,",["G1682"]],["lama",["G2982"]],["sabachthani?",["G4518"]],["which",["G3739"]],["is,",["G2076"]],["being interpreted,",["G3177"]],["My",["G3450"]],["God,",["G2316"]],["my",["G3450"]],["God,",["G2316"]],["why",["G5101"]],["hast",["G1519"]],["thou forsaken",["G1459"]],["me?",[]]]},{"verse":35,"text":"And some of them that stood by, when they heard it, said, Behold, he calleth Elias.","words":[["And",["G2532"]],["some of them",["G5100"]],["that stood by,",["G3936"]],["when they heard",["G191"]],["it, said,",["G3004"]],["Behold,",["G2400"]],["he calleth",["G5455"]],["Elias.",[]]]},{"verse":36,"text":"And one ran and filled a spunge full of vinegar, and put it on a reed, and gave him to drink, saying, Let alone; let us see whether Elias will come to take him down.","words":[["And",["G1161"]],["one",["G1520"]],["ran",["G5143"]],["and",["G2532"]],["filled",["G1072"]],["a spunge",["G4699"]],["f