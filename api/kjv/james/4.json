{"book":"James","chapter":4,"translation":"KJV","url":"/bible/james/4","verses":[{"verse":1,"text":"From whence come wars and fightings among you? come they not hence, even of your lusts that war in your members?","words":[["From whence",["G4159"]],["come wars",["G4171"]],["and",["G2532"]],["fightings",["G3163"]],["among",["G1722"]],["you?",["G5213"]],["come they not",["G3756"]],["hence,",["G1782"]],["even of",["G1537"]],["your",["G5216"]],["lusts",["G2237"]],["that war",["G4754"]],["in",["G1722"]],["your",["G5216"]],["members?",[]]]},{"verse":2,"text":"Ye lust, and have not: ye kill, and desire to have, and cannot obtain: ye fight and war, yet ye have not, because ye ask not.","words":[["Ye lust,",["G1937"]],["and",["G2532"]],["have",["G2192"]],["not:",["G3756"]],["ye kill,",["G5407"]],["and",["G2532"]],["desire to have,",["G2206"]],["and",["G2532"]],["cannot",["G3756","G1410"]],["obtain:",["G2013"]],["ye fight",["G3164"]],["and",["G2532"]],["war,",["G4170"]],["yet",["G1161"]],["ye have",["G2192"]],["not,",["G3756"]],["because",["G1223"]],["ye",["G5209"]],["ask",["G154"]],["not.",[]]]},{"verse":3,"text":"Ye ask, and receive not, because ye ask amiss, that ye may consume it upon your lusts.","words":[["Ye ask,",["G154"]],["and",["G2532"]],["receive",["G2983"]],["not,",["G3756"]],["because",["G1360"]],["ye ask",["G154"]],["amiss,",["G2560"]],["that",["G2443"]],["ye may consume",["G1159"]],["it upon",["G1722"]],["your",["G5216"]],["lusts.",[]]]},{"verse":4,"text":"Ye adulterers and adulteresses, know ye not that the friendship of the world is enmity with God? whosoever therefore will be a friend of the world is the enemy of God.","words":[["Ye adulterers",["G3432"]],["and",["G2532"]],["adulteresses,",["G3428"]],["know ye",["G1492"]],["not",["G3756"]],["that",["G3754"]],["the friendship",["G5373"]],["of the world",["G2889"]],["is",["G2076"]],["enmity",["G2189"]],["with God?",["G2316"]],["whosoever",["G3739","G302"]],["therefore",["G3767"]],["will be",["G1511","G1014"]],["a friend",["G5384"]],["of the world",["G2889"]],["is",["G2525"]],["the enemy",["G2190"]],["of God.",[]]]},{"verse":5,"text":"Do ye think that the scripture saith in vain, The spirit that dwelleth in us lusteth to envy?","words":[["Do ye think",["G1380"]],["that",["G3754"]],["the scripture",["G1124"]],["saith",["G3004"]],["in vain,",["G2761"]],["The spirit",["G4151"]],["that",["G3739"]],["dwelleth",["G2730"]],["in",["G1722"]],["us",["G2254"]],["lusteth",["G1971"]],["to",["G4314"]],["envy?",[]]]},{"verse":6,"text":"But he giveth more grace. Wherefore he saith, God resisteth the proud, but giveth grace unto the humble.","words":[["But",["G1161"]],["he giveth",["G1325"]],["more",["G3187"]],["grace.",["G5485"]],["Wherefore",["G1352"]],["he saith,",["G3004"]],["God",["G2316"]],["resisteth",["G498"]],["the proud,",["G5244"]],["but",["G1161"]],["giveth",["G1325"]],["grace",["G5485"]],["unto the humble.",[]]]},{"verse":7,"text":"Submit yourselves therefore to God. Resist the devil, and he will flee from you.","words":[["Submit yourselves",["G5293"]],["therefore",["G3767"]],["to God.",["G2316"]],["Resist",["G436"]],["the devil,",["G1228"]],["and",["G2532"]],["he will flee",["G5343"]],["from",["G575"]],["you.",[]]]},{"verse":8,"text":"Draw nigh to God, and he will draw nigh to you. Cleanse your hands, ye sinners; and purify your hearts, ye double minded.","words":[["Draw nigh",["G1448"]],["to God,",["G2316"]],["and",["G2532"]],["he will draw nigh",["G1448"]],["to you.",["G5213"]],["Cleanse",["G2511"]],["your hands,",["G5495"]],["ye sinners;",["G268"]],["and",["G2532"]],["purify",["G48"]],["your hearts,",["G2588"]],["ye double minded.",[]]]},{"verse":9,"text":"Be afflicted, and mourn, and weep: let your laughter be turned to mourning, and your joy to heaviness.","words":[["Be afflicted,",["G5003"]],["and",["G2532"]],["mourn,",["G3996"]],["and",["G2532"]],["weep:",["G2799"]],["let your",["G5216"]],["laughter",["G1071"]],["be turned",["G3344"]],["to",["G1519"]],["mourning,",["G3997"]],["and",["G2532"]],["your joy",["G5479"]],["to",["G1519"]],["heaviness.",[]]]},{"verse":10,"text":"Humble yourselves in the sight of the Lord, and he shall lift you up.","words":[["Humble yourselves",["G5013"]],["in the sight",["G1799"]],["of the Lord,",["G2962"]],["and",["G2532"]],["he shall lift",["G5312"]],["you",["G5209"]],["up.",[]]]},{"verse":11,"text":"Speak not evil one of another, brethren. He that speaketh evil of his brother, and judgeth his brother, speaketh evil of the law, and judgeth the law: but if thou judge the law, thou art not a doer of the law, but a judge.","words":[["Speak",["G2635"]],["not",["G3361"]],["evil",["G2635"]],["one of another,",["G240"]],["brethren.",["G80"]],["He that speaketh evil",["G2635"]],["of his brother,",["G80"]],["and",["G2532"]],["judgeth",["G2919"]],["his",["G846"]],["brother,",["G80"]],["speaketh evil",["G2635"]],["of the law,",["G3551"]],["and",["G2532"]],["judgeth",["G2919"]],["the law:",["G3551"]],["but",["G1161"]],["if",["G1487"]],["thou judge",["G2919"]],["the law,",["G3551"]],["thou art",["G1488"]],["not",["G3756"]],["a doer",["G4163"]],["of the law,",["G3551"]],["but",["G235"]],["a judge.",[]]]},{"verse":12,"text":"There is one lawgiver, who is able to save and to destroy: who art thou that judgest another?","words":[["There is",["G2076"]],["one",["G1520"]],["lawgiver,",["G3550"]],["who",["G3588"]],["is able",["G1410"]],["to save",["G4982"]],["and",["G2532"]],["to destroy:",["G622"]],["who",["G5101"]],["art",["G1488"]],["thou",["G4771"]],["that",["G3739"]],["judgest",["G2919"]],["another?",[]]]},{"verse":13,"text":"Go to now, ye that say, To day or to morrow we will go into such a city, and continue there a year, and buy and sell, and get gain:","words":[["Go to",["G33"]],["now,",["G3568"]],["ye that say,",["G3004"]],["To day",["G4594"]],["or",["G2532"]],["to morrow",["G839"]],["we will go",["G4198"]],["into",["G1519"]],["such",["G3592"]],["a city,",["G4172"]],["and",["G2532"]],["continue",["G4160","G4160"]],["there",["G1563"]],["a",["G1520"]],["year,",["G1763"]],["and",["G2532"]],["buy and sell,",["G1710","G1710"]],["and",["G2532"]],["get gain:",["G2770"]]]},{"verse":14,"text":"Whereas ye know not what shall be on the morrow. For what is your life? It is even a vapour, that appeareth for a little time, and then vanisheth away.","words":[["Whereas",["G3748"]],["ye know",["G1987"]],["not",["G3756"]],["what",["G3588"]],["shall be on the morrow.",["G839"]],["For",["G1063"]],["what",["G4169"]],["is your",["G5216"]],["life?",["G2222"]],["It is",["G2076"]],["even",["G1063"]],["a vapour,",["G822"]],["that",["G4314"]],["appeareth for",["G5316"]],["a little time,",["G3641"]],["and",["G1161"]],["then",["G1899"]],["vanisheth away.",[]]]},{"verse":15,"text":"For that ye ought to say, If the Lord will, we shall live, and do this, or that.","words":[["For that",["G473"]],["ye",["G5209"]],["ought to say,",["G3004"]],["If",["G1437"]],["the Lord",["G2962"]],["will,",["G2309","G2532"]],["we shall live,",["G2198","G2198"]],["and",["G2532"]],["do",["G4160","G4160"]],["this,",["G5124"]],["or",["G2228"]],["that.",[]]]},{"verse":16,"text":"But now ye rejoice in your boastings: all such rejoicing is evil.","words":[["But",["G1161"]],["now",["G3568"]],["ye rejoice",["G2744"]],["in",["G1722"]],["your",["G5216"]],["boastings:",["G212"]],["all",["G3956"]],["such",["G5108"]],["rejoicing",["G2746"]],["is",["G2076"]],["evil.",[]]]},{"verse":17,"text":"Therefore to him that knoweth to do good, and doeth it not, to him it is sin.","words":[["Therefore",["G3767"]],["to him that knoweth",["G1492"]],["to do",["G4160"]],["good,",["G2570"]],["and",["G2532"]],["doeth",["G4160"]],["it not,",["G3361"]],["to him",["G846"]],["it is",["G2076"]],["sin.",[]]]}]}