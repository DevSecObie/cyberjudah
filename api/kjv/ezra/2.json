]],["the children",["H1121"]],["of Reaiah,",[]]]},{"verse":48,"text":"The children of Rezin, the children of Nekoda, the children of Gazzam,","words":[["The children",["H1121"]],["of Rezin,",["H7526"]],["the children",["H1121"]],["of Nekoda,",["H5353"]],["the children",["H1121"]],["of Gazzam,",[]]]},{"verse":49,"text":"The children of Uzza, the children of Paseah, the children of Besai,","words":[["The children",["H1121"]],["of Uzza,",["H5798"]],["the children",["H1121"]],["of Paseah,",["H6454"]],["the children",["H1121"]],["of Besai,",[]]]},{"verse":50,"text":"The children of Asnah, the children of Mehunim, the children of Nephusim,","words":[["The children",["H1121"]],["of Asnah,",["H619"]],["the children",["H1121"]],["of Mehunim,",["H4586"]],["the children",["H1121"]],["of Nephusim,",["H5300"]]]},{"verse":51,"text":"The children of Bakbuk, the children of Hakupha, the children of Harhur,","words":[["The children",["H1121"]],["of Bakbuk,",["H1227"]],["the children",["H1121"]],["of Hakupha,",["H2709"]],["the children",["H1121"]],["of Harhur,",[]]]},{"verse":52,"text":"The children of Bazluth, the children of Mehida, the children of Harsha,","words":[["The children",["H1121"]],["of Bazluth,",["H1213"]],["the children",["H1121"]],["of Mehida,",["H4240"]],["the children",["H1121"]],["of Harsha,",[]]]},{"verse":53,"text":"The children of Barkos, the children of Sisera, the children of Thamah,","words":[["The children",["H1121"]],["of Barkos,",["H1302"]],["the children",["H1121"]],["of Sisera,",["H5516"]],["the children",["H1121"]],["of Thamah,",[]]]},{"verse":54,"text":"The children of Neziah, the children of Hatipha.","words":[["The children",["H1121"]],["of Neziah,",["H5335"]],["the children",["H1121"]],["of Hatipha.",[]]]},{"verse":55,"text":"The children of Solomon’s servants: the children of Sotai, the children of Sophereth, the children of Peruda,","words":[["The children",["H1121"]],["of Solomon’s servants:",["H5650"]],["the children",["H1121"]],["of Sotai,",["H5479"]],["the children",["H1121"]],["of Sophereth,",["H5618"]],["the children",["H1121"]],["of Peruda,",[]]]},{"verse":56,"text":"The children of Jaalah, the children of Darkon, the children of Giddel,","words":[["The children",["H1121"]],["of Jaalah,",["H3279"]],["the children",["H1121"]],["of Darkon,",["H1874"]],["the children",["H1121"]],["of Giddel,",[]]]},{"verse":57,"text":"The children of Shephatiah, the children of Hattil, the children of Pochereth of Zebaim, the children of Ami.","words":[["The children",["H1121"]],["of Shephatiah,",["H8203"]],["the children",["H1121"]],["of Hattil,",["H2411"]],["the children",["H1121"]],["of Pochereth of Zebaim,",["H6380"]],["the children",["H1121"]],["of Ami.",[]]]},{"verse":58,"text":"All the Nethinims, and the children of Solomon’s servants, were three hundred ninety and two.","words":[["All the Nethinims,",["H5411"]],["and the children",["H1121"]],["of Solomon’s servants,",["H5650"]],["were three",["H7969"]],["hundred",["H3967"]],["ninety",["H8673"]],["and two.",[]]]},{"verse":59,"text":"And these were they which went up from Tel–melah, Tel–harsa, Cherub, Addan, and Immer: but they could not shew their father’s house, and their seed, whether they were of Israel:","words":[["And these were they which went up",["H5927"]],["from Tel–melah,",["H8528"]],["Tel–harsa,",["H8521"]],["Cherub,",["H3743"]],["Addan,",["H135"]],["and Immer:",["H564"]],["but they could",["H3201"]],["not shew",["H5046"]],["their father’s house,",["H1004"]],["and their seed,",["H2233"]],["whether they were of Israel:",[]]]},{"verse":60,"text":"The children of Delaiah, the children of Tobiah, the children of Nekoda, six hundred fifty and two.","words":[["The children",["H1121"]],["of Delaiah,",["H1806"]],["the children",["H1121"]],["of Tobiah,",["H2900"]],["the children",["H1121"]],["of Nekoda,",["H5353"]],["six",["H8337"]],["hundred",["H3967"]],["fifty",["H2572"]],["and two.",[]]]},{"verse":61,"text":"And of the children of the priests: the children of Habaiah, the children of Koz, the children of Barzillai; which took a wife of the daughters of Barzillai the Gileadite, and was called after their name:","words":[["And of the children",["H1121"]],["of the priests:",["H3548"]],["the children",["H1121"]],["of Habaiah,",["H2252"]],["the children",["H1121"]],["of Koz,",["H6976"]],["the children",["H1121"]],["of Barzillai;",["H1271"]],["which took",["H3947"]],["a wife",["H802"]],["of the daughters",["H1323"]],["of Barzillai",["H1271"]],["the Gileadite,",["H1569"]],["and was called",["H7121"]],["after their name:",[]]]},{"verse":62,"text":"These sought their register among those that were reckoned by genealogy, but they were not found: therefore were they, as polluted, put from the priesthood.","words":[["These sought",["H1245"]],["their register",["H3791"]],["among those that were reckoned by genealogy,",["H3187"]],["but they were not found:",["H4672"]],["therefore were they, as polluted,",["H1351"]],["put from the priesthood.",[]]]},{"verse":63,"text":"And the Tirshatha said unto them, that they should not eat of the most holy things, till there stood up a priest with Urim and with Thummim.","words":[["And the Tirshatha",["H8660"]],["said",["H559"]],["unto them, that they should not eat",["H398"]],["of the most",["H6944"]],["holy things,",["H6944"]],["till there stood up",["H5975"]],["a priest",["H3548"]],["with Urim",["H224"]],["and with Thummim.",[]]]},{"verse":64,"text":"The whole congregation together was forty and two thousand three hundred and threescore,","words":[["The whole congregation",["H6951"]],["together",["H259"]],["was forty",["H702","H7239"]],["and two thousand",["H505"]],["three",["H7969"]],["hundred",["H3967"]],["and threescore,",[]]]},{"verse":65,"text":"Beside their servants and their maids, of whom there were seven thousand three hundred thirty and seven: and there were among them two hundred singing men and singing women.","words":[["Beside their servants",["H5650"]],["and their maids,",["H519"]],["of whom there were seven",["H7651"]],["thousand",["H505"]],["three",["H7969"]],["hundred",["H3967"]],["thirty",["H7970"]],["and seven:",["H7651"]],["and there were",["H428"]],["among them two hundred",["H3967"]],["singing men",["H7891"]],["and singing women.",[]]]},{"verse":66,"text":"Their horses were seven hundred thirty and six; their mules, two hundred forty and five;","words":[["Their horses",["H5483"]],["were seven",["H7651"]],["hundred",["H3967"]],["thirty",["H7970"]],["and six;",["H8337"]],["their mules,",["H6505"]],["two hundred",["H3967"]],["forty",["H705"]],["and five;",[]]]},{"verse":67,"text":"Their camels, four hundred thirty and five; their asses, six thousand seven hundred and twenty.","words":[["Their camels,",["H1581"]],["four",["H702"]],["hundred",["H3967"]],["thirty",["H7970"]],["and five;",["H2568"]],["their asses,",["H2543"]],["six",["H8337"]],["thousand",["H505"]],["seven",["H7651"]],["hundred",["H3967"]],["and twenty.",[]]]},{"verse":68,"text":"And some of the chief of the fathers, when they came to the house of the Lord which is at Jerusalem, offered freely for the house of God to set it up in his place:","words":[["And some of the chief",["H7218"]],["of the fathers,",["H1"]],["when they came",["H935"]],["to the house",["H1004"]],["of the Lord",["H3068"]],["which is at Jerusalem,",["H3389"]],["offered freely",["H5068"]],["for the house",["H1004"]],["of God",["H430"]],["to set it up",["H5975"]],["in his place:",[]]]},{"verse":69,"text":"They gave after their ability unto the treasure of the work threescore and one thousand drams of gold, and five thousand pound of silver, and one hundred priests’ garments.","words":[["They gave",["H5414"]],["after their ability",["H3581"]],["unto the treasure",["H214"]],["of the work",["H4399"]],["threescore",["H8337","H7239"]],["and one thousand",["H505"]],["drams",["H1871"]],["of gold,",["H2091"]],["and five",["H2568"]],["thousand",["H505"]],["pound",["H4488"]],["of silver,",["H3701"]],["and one hundred",["H3967"]],["priests’",["H3548"]],["garments.",[]]]},{"verse":70,"text":"So the priests, and the Levites, and some of the people, and the singers, and the porters, and the Nethinims, dwelt in their cities, and all Israel in their cities.","words":[["So the priests,",["H3548"]],["and the Levites,",["H3881"]],["and some of the people,",["H5971"]],["and the singers,",["H7891"]],["and the porters,",["H7778"]],["and the Nethinims,",["H5411"]],["dwelt",["H3427"]],["in their cities,",["H5892"]],["and all Israel",["H3478"]],["in their cities.",[]]]}]}