{"book":"2 Timothy","chapter":4,"translation":"KJV","url":"/bible/2-timothy/4","verses":[{"verse":1,"text":"I charge thee therefore before God, and the Lord Jesus Christ, who shall judge the quick and the dead at his appearing and his kingdom;","words":[["I",["G1473"]],["charge",["G1263"]],["thee therefore",["G3767"]],["before",["G1799"]],["God,",["G2316"]],["and",["G2532"]],["the Lord",["G2962"]],["Jesus",["G2424"]],["Christ,",["G5547"]],["who",["G3588"]],["shall",["G3195"]],["judge",["G2919"]],["the quick",["G2198"]],["and",["G2532"]],["the dead",["G3498"]],["at",["G2596"]],["his",["G846"]],["appearing",["G2015"]],["and",["G2532"]],["his",["G846"]],["kingdom;",["G932"]]]},{"verse":2,"text":"Preach the word; be instant in season, out of season; reprove, rebuke, exhort with all longsuffering and doctrine.","words":[["Preach",["G2784"]],["the word;",["G3056"]],["be instant",["G2186"]],["in season,",["G2122"]],["out of season;",["G171"]],["reprove,",["G1651"]],["rebuke,",["G2008"]],["exhort",["G3870"]],["with",["G1722"]],["all",["G3956"]],["longsuffering",["G3115"]],["and",["G2532"]],["doctrine.",["G1322"]]]},{"verse":3,"text":"For the time will come when they will not endure sound doctrine; but after their own lusts shall they heap to themselves teachers, having itching ears;","words":[["For",["G1063"]],["the time",["G2540"]],["will come",["G2071"]],["when",["G3753"]],["they will",["G430"]],["not",["G3756"]],["endure",["G430"]],["sound",["G5198"]],["doctrine;",["G1319"]],["but",["G235"]],["after",["G2596"]],["their own",["G2398"]],["lusts",["G1939"]],["shall they heap",["G2002"]],["to themselves",["G1438"]],["teachers,",["G1320"]],["having itching",["G2833"]],["ears;",["G189"]]]},{"verse":4,"text":"And they shall turn away their ears from the truth, and shall be turned unto fables.","words":[["And",["G2532"]],["they shall turn away",["G3303","G654"]],["their ears",["G189"]],["from",["G575"]],["the truth,",["G225"]],["and",["G1161"]],["shall be turned",["G1624"]],["unto",["G1909"]],["fables.",["G3454"]]]},{"verse":5,"text":"But watch thou in all things, endure afflictions, do the work of an evangelist, make full proof of thy ministry.","words":[["But",["G1161"]],["watch",["G3525"]],["thou",["G4771"]],["in",["G1722"]],["all things,",["G3956"]],["endure afflictions,",["G2553"]],["do",["G4160"]],["the work",["G2041"]],["of an evangelist,",["G2099"]],["make full proof",["G4135"]],["of thy",["G4675"]],["ministry.",["G1248"]]]},{"verse":6,"text":"For I am now ready to be offered, and the time of my departure is at hand.","words":[["For",["G1063"]],["I",["G1473"]],["am",["G4689"]],["now",["G2235"]],["ready to be offered,",["G4689"]],["and",["G2532"]],["the time",["G2540"]],["of my",["G1699"]],["departure",["G359"]],["is at hand.",["G2186"]]]},{"verse":7,"text":"I have fought a good fight, I have finished my course, I have kept the faith:","words":[["I have fought",["G75"]],["a good",["G2570"]],["fight,",["G73"]],["I have finished",["G5055"]],["my course,",["G1408"]],["I have kept",["G5083"]],["the faith:",["G4102"]]]},{"verse":8,"text":"Henceforth there is laid up for me a crown of righteousness, which the Lord, the righteous judge, shall give me at that day: and not to me only, but unto all them also that love his appearing.","words":[["Henceforth",["G3063"]],["there is laid up",["G606"]],["for me",["G3427"]],["a crown",["G4735"]],["of righteousness,",["G1343"]],["which",["G3739"]],["the Lord,",["G2962"]],["the righteous",["G1342"]],["judge,",["G2923"]],["shall give",["G591"]],["me",["G3427"]],["at",["G1722"]],["that",["G1565"]],["day:",["G2250"]],["and",["G1161"]],["not",["G3756"]],["to me",["G1698"]],["only,",["G3440"]],["but",["G235"]],["unto all them",["G3956"]],["also",["G2532"]],["that love",["G25"]],["his",["G846"]],["appearing.",["G2015"]]]},{"verse":9,"text":"Do thy diligence to come shortly unto me:","words":[["Do thy diligence",["G4704"]],["to come",["G2064"]],["shortly",["G5030"]],["unto",["G4314"]],["me:",["G3165"]]]},{"verse":10,"text":"For Demas hath forsaken me, having loved this present world, and is departed unto Thessalonica; Crescens to Galatia, Titus unto Dalmatia.","words":[["For",["G1063"]],["Demas",["G1214"]],["hath forsaken",["G1459"]],["me, having loved",["G25"]],["this present",["G3568"]],["world,",["G165"]],["and",["G2532"]],["is departed",["G4198"]],["unto",["G1519"]],["Thessalonica;",["G2332"]],["Crescens",["G2913"]],["to",["G1519"]],["Galatia,",["G1053"]],["Titus",["G5103"]],["unto",["G1519"]],["Dalmatia.",["G1149"]]]},{"verse":11,"text":"Only Luke is with me. Take Mark, and bring him with thee: for he is profitable to me for the ministry.","words":[["Only",["G3441"]],["Luke",["G3065"]],["is",["G2076"]],["with",["G3326"]],["me.",["G1700"]],["Take",["G353"]],["Mark,",["G3138"]],["and bring him",["G71"]],["with",["G3326"]],["thee:",["G4572"]],["for",["G1063"]],["he is",["G2076"]],["profitable",["G2173"]],["to me",["G3427"]],["for",["G1519"]],["the ministry.",["G1248"]]]},{"verse":12,"text":"And Tychicus have I sent to Ephesus.","words":[["And",["G1161"]],["Tychicus",["G5190"]],["have I sent",["G649"]],["to",["G1519"]],["Ephesus.",["G2181"]]]},{"verse":13,"text":"The cloke that I left at Troas with Carpus, when thou comest, bring with thee, and the books, but especially the parchments.","words":[["The cloke",["G5341"]],["that",["G3739"]],["I left",["G620"]],["at",["G1722"]],["Troas",["G5174"]],["with",["G3844"]],["Carpus,",["G2591"]],["when thou comest,",["G2064"]],["bring",["G5342"]],["with thee, and",["G2532"]],["the books,",["G975"]],["but especially",["G3122"]],["the parchments.",["G3200"]]]},{"verse":14,"text":"Alexander the coppersmith did me much evil: the Lord reward him according to his works:","words":[["Alexander",["G223"]],["the coppersmith",["G5471"]],["did",["G1731"]],["me",["G3427"]],["much",["G4183"]],["evil:",["G2556"]],["the Lord",["G2962"]],["reward",["G591"]],["him",["G846"]],["according to",["G2596"]],["his",["G846"]],["works:",["G2041"]]]},{"verse":15,"text":"Of whom be thou ware also; for he hath greatly withstood our words.","words":[["Of whom",["G3739"]],["be",["G5442"]],["thou",["G4771"]],["ware",["G5442"]],["also;",["G2532"]],["for",["G1063"]],["he hath",["G436"]],["greatly",["G3029"]],["withstood",["G436"]],["our",["G2251"]],["words.",["G3056"]]]},{"verse":16,"text":"At my first answer no man stood with me, but all men forsook me: I pray God that it may not be laid to their charge.","words":[["At",["G1722"]],["my",["G3450"]],["first",["G4413"]],["answer",["G627"]],["no man",["G3762"]],["stood",["G4836"]],["with me,",["G3427"]],["but",["G235"]],["all",["G3956"]],["men forsook",["G1459"]],["me:",["G3165"]],["I pray God that it may",["G3049"]],["not",["G3361"]],["be laid",["G3049"]],["to their charge.",["G846"]]]},{"verse":17,"text":"Notwithstanding the Lord stood with me, and strengthened me; that by me the preaching might be fully known, and that all the Gentiles might hear: and I was delivered out of the mouth of the lion.","words":[["Notwithstanding",["G1161"]],["the Lord",["G2962"]],["stood",["G3936"]],["with me,",["G3427"]],["and",["G2532"]],["strengthened",["G1743"]],["me;",["G3165"]],["that",["G2443"]],["by",["G1223"]],["me",["G1700"]],["the preaching",["G2782"]],["might be fully known,",["G4135"]],["and",["G2532"]],["that all",["G3956"]],["the Gentiles",["G1484"]],["might hear:",["G191"]],["and",["G2532"]],["I was delivered",["G4506"]],["out of",["G1537"]],["the mouth",["G4750"]],["of the lion.",["G3023"]]]},{"verse":18,"text":"And the Lord shall deliver me from every evil work, and will preserve me unto his heavenly kingdom: to whom be glory for ever and ever. Amen.","words":[["And",["G2532"]],["the Lord",["G2962"]],["shall deliver",["G4506"]],["me",["G3165"]],["from",["G575"]],["every",["G3956"]],["evil",["G4190"]],["work,",["G2041"]],["and",["G2532"]],["will preserve",["G4982"]],["me unto",["G1519"]],["his",["G846"]],["heavenly",["G2032"]],["kingdom:",["G932"]],["to whom",["G3739"]],["be glory",["G1391"]],["for",["G1519"]],["ever",["G165"]],["and ever.",["G165"]],["Amen.",["G281"]]]},{"verse":19,"text":"Salute Prisca and Aquila, and the household of Onesiphorus.","words":[["Salute",["G782"]],["Prisca",["G4251"]],["and",["G2532"]],["Aquila,",["G207"]],["and",["G2532"]],["the household",["G3624"]],["of Onesiphorus.",["G3683"]]]},{"verse":20,"text":"Erastus abode at Corinth: but Trophimus have I left at Miletum sick.","words":[["Erastus",["G2037"]],["abode",["G3306"]],["at",["G1722"]],["Corinth:",["G2882"]],["but",["G1161"]],["Trophimus",["G5161"]],["have I left",["G620"]],["at",["G1722"]],["Miletum",["G3399"]],["sick.",["G770"]]]},{"verse":21,"text":"Do thy diligence to come before winter. Eubulus greeteth thee, and Pudens, and Linus, and Claudia, and all the brethren.","words":[["Do thy diligence",["G4704"]],["to come",["G2064"]],["before",["G4253"]],["winter.",["G5494"]],["Eubulus",["G2103"]],["greeteth",["G782"]],["thee,",["G4571"]],["and",["G2532"]],["Pudens,",["G4227"]],["and",["G2532"]],["Linus,",["G3044"]],["and",["G2532"]],["Claudia,",["G2803"]],["and",["G2532"]],["all",["G3956"]],["the brethren.",["G80"]]]},{"verse":22,"text":"The Lord Jesus Christ be with thy spirit. Grace be with you. Amen. The second epistle unto Timotheus, ordained the first bishop of the church of the Ephesians, was written from Rome, when Paul was brought before Nero the second time.","words":[["The Lord",["G2962"]],["Jesus",["G2424"]],["Christ",["G5547"]],["be with",["G3326"]],["thy",["G4675"]],["spirit.",["G4151"]],["Grace",["G5485"]],["be with",["G3326"]],["you.",["G5216"]],["Amen.",["G281"]],["The second epistle unto Timotheus, ordained the first bishop of the church of the Ephesians, was written from Rome, when Paul was brought before Nero the second time.",[]]]}]}