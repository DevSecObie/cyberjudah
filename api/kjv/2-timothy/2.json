{"book":"2 Timothy","chapter":2,"translation":"KJV","url":"/bible/2-timothy/2","verses":[{"verse":1,"text":"Thou therefore, my son, be strong in the grace that is in Christ Jesus.","words":[["Thou",["G4771"]],["therefore,",["G3767"]],["my",["G3450"]],["son,",["G5043"]],["be strong",["G1743"]],["in",["G1722"]],["the grace",["G5485"]],["that is in",["G1722"]],["Christ",["G5547"]],["Jesus.",["G2424"]]]},{"verse":2,"text":"And the things that thou hast heard of me among many witnesses, the same commit thou to faithful men, who shall be able to teach others also.","words":[["And",["G2532"]],["the things",["G3739"]],["that thou hast heard",["G191"]],["of",["G3844"]],["me",["G1700"]],["among",["G1223"]],["many",["G4183"]],["witnesses,",["G3144"]],["the same",["G5023"]],["commit thou",["G3908"]],["to faithful",["G4103"]],["men,",["G444"]],["who",["G3748"]],["shall be",["G2071"]],["able",["G2425"]],["to teach",["G1321"]],["others",["G2087"]],["also.",["G2532"]]]},{"verse":3,"text":"Thou therefore endure hardness, as a good soldier of Jesus Christ.","words":[["Thou",["G4771"]],["therefore",["G3767"]],["endure hardness,",["G2553"]],["as",["G5613"]],["a good",["G2570"]],["soldier",["G4757"]],["of Jesus",["G2424"]],["Christ.",["G5547"]]]},{"verse":4,"text":"No man that warreth entangleth himself with the affairs of this life; that he may please him who hath chosen him to be a soldier.","words":[["No man",["G3762"]],["that warreth",["G4754"]],["entangleth himself",["G1707"]],["with the affairs",["G4230"]],["of this life;",["G979"]],["that",["G2443"]],["he may please",["G700"]],["him who hath chosen him to be a soldier.",["G4758"]]]},{"verse":5,"text":"And if a man also strive for masteries, yet is he not crowned, except he strive lawfully.","words":[["And",["G1161"]],["if",["G1437"]],["a man",["G5100"]],["also",["G2532"]],["strive",["G118"]],["for masteries, yet is he",["G4737"]],["not",["G3756"]],["crowned,",["G4737"]],["except",["G3362"]],["he strive",["G118"]],["lawfully.",["G3545"]]]},{"verse":6,"text":"The husbandman that laboureth must be first partaker of the fruits.","words":[["The husbandman",["G1092"]],["that laboureth",["G2872"]],["must be",["G1163"]],["first",["G4413"]],["partaker",["G3335"]],["of the fruits.",["G2590"]]]},{"verse":7,"text":"Consider what I say; and the Lord give thee understanding in all things.","words":[["Consider",["G3539"]],["what",["G3739"]],["I say;",["G3004"]],["and",["G1063"]],["the Lord",["G2962"]],["give",["G1325"]],["thee",["G4671"]],["understanding",["G4907"]],["in",["G1722"]],["all things.",["G3956"]]]},{"verse":8,"text":"Remember that Jesus Christ of the seed of David was raised from the dead according to my gospel:","words":[["Remember",["G3421"]],["that Jesus",["G2424"]],["Christ",["G5547"]],["of",["G1537"]],["the seed",["G4690"]],["of David",["G1138"]],["was raised",["G1453"]],["from",["G1537"]],["the dead",["G3498"]],["according to",["G2596"]],["my",["G3450"]],["gospel:",["G2098"]]]},{"verse":9,"text":"Wherein I suffer trouble, as an evil doer, even unto bonds; but the word of God is not bound.","words":[["Wherein",["G1722","G3739"]],["I suffer trouble,",["G2553"]],["as",["G5613"]],["an evil doer,",["G2557"]],["even unto",["G3360"]],["bonds;",["G1199"]],["but",["G235"]],["the word",["G3056"]],["of God",["G2316"]],["is",["G1210"]],["not",["G3756"]],["bound.",["G1210"]]]},{"verse":10,"text":"Therefore I endure all things for the elect’s sakes, that they may also obtain the salvation which is in Christ Jesus with eternal glory.","words":[["Therefore",["G1223","G5124"]],["I endure",["G5278"]],["all things",["G3956"]],["for",["G1588"]],["the elect’s sakes,",["G1223"]],["that",["G2443"]],["they",["G846"]],["may",["G5177"]],["also",["G2532"]],["obtain",["G5177"]],["the salvation",["G4991"]],["which",["G3588"]],["is in",["G1722"]],["Christ",["G5547"]],["Jesus",["G2424"]],["with",["G3326"]],["eternal",["G166"]],["glory.",["G1391"]]]},{"verse":11,"text":"It is a faithful saying: For if we be dead with him, we shall also live with him:","words":[["It is a faithful",["G4103"]],["saying:",["G3056"]],["For",["G1063"]],["if",["G1487"]],["we be dead with",["G4880"]],["him, we shall",["G4800"]],["also",["G2532"]],["live with",["G4800"]],["him:",[]]]},{"verse":12,"text":"If we suffer, we shall also reign with him: if we deny him, he also will deny us:","words":[["If",["G1487"]],["we suffer,",["G5278"]],["we shall",["G4821"]],["also",["G2532"]],["reign with",["G4821"]],["him: if",["G1487"]],["we deny",["G720"]],["him, he also",["G2548"]],["will deny",["G720"]],["us:",["G2248"]]]},{"verse":13,"text":"If we believe not, yet he abideth faithful: he cannot deny himself.","words":[["If",["G1487"]],["we believe not,",["G569"]],["yet he",["G1565"]],["abideth",["G3306"]],["faithful:",["G4103"]],["he cannot",["G3756","G1410"]],["deny",["G720"]],["himself.",["G1438"]]]},{"verse":14,"text":"Of these things put them in remembrance, charging them before the Lord that they strive not about words to no profit, but to the subverting of the hearers.","words":[["Of these things",["G5023"]],["put them in remembrance,",["G5279"]],["charging",["G1263"]],["them before",["G1799"]],["the Lord",["G2962"]],["that they strive",["G3054"]],["not",["G3361"]],["about words",["G3054"]],["to",["G1519"]],["no",["G3762"]],["profit,",["G5539"]],["but to",["G1909"]],["the subverting",["G2692"]],["of the hearers.",["G191"]]]},{"verse":15,"text":"Study to shew thyself approved unto God, a workman that needeth not to be ashamed, rightly dividing the word of truth.","words":[["Study",["G4704"]],["to shew",["G3936"]],["thyself",["G4572"]],["approved",["G1384"]],["unto God,",["G2316"]],["a workman",["G2040"]],["that needeth not to be ashamed,",["G422"]],["rightly dividing",["G3718"]],["the word",["G3056"]],["of truth.",["G225"]]]},{"verse":16,"text":"But shun profane and vain babblings: for they will increase unto more ungodliness.","words":[["But",["G1161"]],["shun",["G4026"]],["profane",["G952"]],["and vain babblings:",["G2757"]],["for",["G1063"]],["they will increase",["G4298"]],["unto",["G1909"]],["more",["G4119"]],["ungodliness.",["G763"]]]},{"verse":17,"text":"And their word will eat as doth a canker: of whom is Hymeneus and Philetus;","words":[["And",["G2532"]],["their",["G846"]],["word",["G3056"]],["will eat",["G2192","G3542"]],["as",["G5613"]],["doth a canker:",["G1044"]],["of whom",["G3739"]],["is",["G2076"]],["Hymeneus",["G5211"]],["and",["G2532"]],["Philetus;",["G5372"]]]},{"verse":18,"text":"Who concerning the truth have erred, saying that the resurrection is past already; and overthrow the faith of some.","words":[["Who",["G3748"]],["concerning",["G4012"]],["the truth",["G225"]],["have erred,",["G795"]],["saying",["G3004"]],["that the resurrection",["G386"]],["is past",["G1096"]],["already;",["G2235"]],["and",["G2532"]],["overthrow",["G396"]],["the faith",["G4102"]],["of some.",["G5100"]]]},{"verse":19,"text":"Nevertheless the foundation of God standeth sure, having this seal, The Lord knoweth them that are his. And, Let every one that nameth the name of Christ depart from iniquity.","words":[["Nevertheless",["G3305"]],["the foundation",["G2310"]],["of God",["G2316"]],["standeth",["G2476"]],["sure,",["G4731"]],["having",["G2192"]],["this",["G5026"]],["seal,",["G4973"]],["The Lord",["G2962"]],["knoweth",["G1097"]],["them that are",["G5607"]],["his.",["G846"]],["And,",["G2532"]],["Let",["G868"]],["every one",["G3956"]],["that nameth",["G3687"]],["the name",["G3686"]],["of Christ",["G5547"]],["depart",["G868"]],["from",["G575"]],["iniquity.",["G93"]]]},{"verse":20,"text":"But in a great house there are not only vessels of gold and of silver, but also of wood and of earth; and some to honour, and some to dishonour.","words":[["But",["G1161"]],["in",["G1722"]],["a great",["G3173"]],["house",["G3614"]],["there are",["G2076"]],["not",["G3756"]],["only",["G3440"]],["vessels",["G4632"]],["of gold",["G5552"]],["and",["G2532"]],["of silver,",["G693"]],["but",["G235"]],["also",["G2532"]],["of wood",["G3585"]],["and",["G2532"]],["of earth;",["G3749"]],["and",["G2532"]],["some",["G3739","G3303"]],["to",["G1519"]],["honour,",["G5092"]],["and",["G1161"]],["some",["G3739"]],["to",["G1519"]],["dishonour.",["G819"]]]},{"verse":21,"text":"If a man therefore purge himself from these, he shall be a vessel unto honour, sanctified, and meet for the master’s use, and prepared unto every good work.","words":[["If",["G1437"]],["a man",["G5100"]],["therefore",["G3767"]],["purge",["G1571"]],["himself",["G1438"]],["from",["G575"]],["these,",["G5130"]],["he shall be",["G2071"]],["a vessel",["G4632"]],["unto",["G1519"]],["honour,",["G5092"]],["sanctified,",["G37"]],["and",["G2532"]],["meet",["G2173"]],["for the master’s use,",["G1203"]],["and prepared",["G2090"]],["unto",["G1519"]],["every",["G3956"]],["good",["G18"]],["work.",["G2041"]]]},{"verse":22,"text":"Flee also youthful lusts: but follow righteousness, faith, charity, peace, with them that call on the Lord out of a pure heart.","words":[["Flee",["G5343"]],["also",["G1161"]],["youthful",["G3512"]],["lusts:",["G1939"]],["but",["G1161"]],["follow",["G1377"]],["righteousness,",["G1343"]],["faith,",["G4102"]],["charity,",["G26"]],["peace,",["G1515"]],["with",["G3326"]],["them that call on",["G1941"]],["the Lord",["G2962"]],["out of",["G1537"]],["a pure",["G2513"]],["heart.",["G2588"]]]},{"verse":23,"text":"But foolish and unlearned questions avoid, knowing that they do gender strifes.","words":[["But",["G1161"]],["foolish",["G3474"]],["and",["G2532"]],["unlearned",["G521"]],["questions",["G2214"]],["avoid,",["G3868"]],["knowing",["G1492"]],["that",["G3754"]],["they do gender",["G1080"]],["strifes.",["G3163"]]]},{"verse":24,"text":"And the servant of the Lord must not strive; but be gentle unto all men, apt to teach, patient,","words":[["And",["G1161"]],["the servant",["G1401"]],["of the Lord",["G2962"]],["must",["G1163"]],["not",["G3756"]],["strive;",["G3164"]],["but",["G235"]],["be",["G1511"]],["gentle",["G2261"]],["unto",["G4314"]],["all",["G3956"]],["men, apt to teach,",["G1317"]],["patient,",["G420"]]]},{"verse":25,"text":"In meekness instructing those that oppose themselves; if God peradventure will give them repentance to the acknowledging of the truth;","words":[["In",["G1722"]],["meekness",["G4236"]],["instructing",["G3811"]],["those that oppose themselves;",["G475"]],["if",["G3379"]],["God",["G2316"]],["peradventure",["G3379"]],["will give",["G1325"]],["them",["G846"]],["repentance",["G3341"]],["to",["G1519"]],["the acknowledging",["G1922"]],["of the truth;",["G225"]]]},{"verse":26,"text":"And that they may recover themselves out of the snare of the devil, who are taken captive by him at his will.","words":[["And",["G2532"]],["that they may recover themselves",["G366"]],["out of",["G1537"]],["the snare",["G3803"]],["of the devil,",["G1228"]],["who are taken captive",["G2221"]],["by",["G5259"]],["him",["G846"]],["at",["G1519"]],["his",["G1565"]],["will.",["G2307"]]]}]}