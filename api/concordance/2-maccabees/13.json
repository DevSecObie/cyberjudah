ly: for inasmuch as he had committed many sins about the altar, whose fire and ashes were holy, he received his death in ashes. He got his just reward."],"note":{"label":"From Brother To Betrayer","url":"/classes/2026/2026-06-20-from-brother-to-betrayer","date":"2026-06-20","teacher":"Bishop Nathanyel"},"ts":"2:18:38","video":"Qw2v07pohR4","t":8318}],"people":{"1":["judas-maccabeus-1ma-2-4","antiochus-1ma-3-33"],"2":["lysias-1ma-3-32"],"3":["antiochus-1ma-3-33","menelaus-2ma-4-23"],"4":["lysias-1ma-3-32","antiochus-1ma-3-33"],"10":["judas-maccabeus-1ma-2-4"],"12":["judas-maccabeus-1ma-2-4"],"13":["judas-maccabeus-1ma-2-4"],"20":["judas-maccabeus-1ma-2-4"],"21":["rhodocus-2ma-13-21"],"22":["judas-maccabeus-1ma-2-4"],"23":["philip-1ma-6-14"],"26":["lysias-1ma-3-32"]},"read":{"1":[{"video":"2VZPutmKhJ4","t":6042,"ts":"1:40:42","title":"Beware Of The Angels | Level 2","date":"2023-06-24","teacher":""}],"2":[{"video":"2VZPutmKhJ4","t":6042,"ts":"1:40:42","title":"Beware Of The Angels | Level 2","date":"2023-06-24","teacher":""}],"3":[{"video":"Qw2v07pohR4","t":8316,"ts":"2:18:36","title":"From Brother To Betrayer","date":"2026-06-20","teacher":"","url":"/classes/2026/2026-06-20-from-brother-to-betrayer"},{"video":"2VZPutmKhJ4","t":6042,"ts":"1:40:42","title":"Beware Of The Angels | Level 2","date":"2023-06-24","teacher":""}],"4":[{"video":"Qw2v07pohR4","t":8316,"ts":"2:18:36","title":"From Brother To Betrayer","date":"2026-06-20","teacher":"","url":"/classes/2026/2026-06-20-from-brother-to-betrayer"}],"5":[{"video":"Qw2v07pohR4","t":8316,"ts":"2:18:36","title":"From Brother To Betrayer","date":"2026-06-20","teacher":"","url":"/classes/2026/2026-06-20-from-brother-to-betrayer"}],"6":[{"video":"Qw2v07pohR4","t":8316,"ts":"2:18:36","title":"From Brother To Betrayer","date":"2026-06-20","teacher":"","url":"/classes/2026/2026-06-20-from-brother-to-betrayer"}],"7":[{"video":"Qw2v07pohR4","t":8316,"ts":"2:18:36","title":"From Brother To Betrayer","date":"2026-06-20","teacher":"