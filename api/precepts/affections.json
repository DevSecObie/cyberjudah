{"title":"Affections","slug":"affections","refs":[{"book":"Wisdom of Solomon","chapter":6,"verses":"11","key":false,"slug":"wisdom-of-solomon","url":"/bible/wisdom-of-solomon/6#v11","label":"Wisdom of Solomon 6:11","study":null,"text":[{"verse":11,"text":"Wherefore set your affection upon my words; desire them, and ye shall be instructed."}],"more":0},{"book":"Colossians","chapter":3,"verses":"2","key":false,"slug":"colossians","url":"/bible/colossians/3#v2","label":"Colossians 3:2","study":null,"text":[{"verse":2,"text":"Set your affection on things above, not on things on the earth."}],"more":0},{"book":"Galatians","chapter":5,"verses":"24","key":false,"slug":"galatians","url":"/bible/galatians/5#v24","label":"Galatians 5:24","study":null,"text":[{"verse":24,"text":"And they that are Christ’s have crucified the flesh with the affections and lusts."}],"more":0}],"url":"/precepts/affections"}