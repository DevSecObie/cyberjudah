{"title":"Bribe","slug":"bribe","refs":[{"book":"Ecclesiastes","chapter":7,"verses":"7","key":false,"slug":"ecclesiastes","url":"/bible/ecclesiastes/7#v7","label":"Ecclesiastes 7:7","study":{"range":"Ecclesiastes 7","url":"/study/ecclesiastes/7"},"text":[{"verse":7,"text":"Surely oppression maketh a wise man mad; and a gift destroyeth the heart."}],"more":0},{"book":"Exodus","chapter":23,"verses":"8","key":false,"slug":"exodus","url":"/bible/exodus/23#v8","label":"Exodus 23:8","study":{"range":"Exodus 23","url":"/study/exodus/23"},"text":[{"verse":8,"text":"And thou shalt take no gift: for the gift blindeth the wise, and perverteth the words of the righteous."}],"more":0},{"book":"Sirach","chapter":40,"verses":"12","key":false,"slug":"sirach","url":"/bible/sirach/40#v12","label":"Sirach 40:12","study":null,"text":[{"verse":12,"text":"All bribery and injustice shall be blotted out: but true dealing shall endure for ever."}],"more":0}],"url":"/precepts/bribe"}