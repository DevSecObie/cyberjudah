{"title":"The Lord’s Day","slug":"the-lord-s-day","refs":[{"book":"Mark","chapter":2,"verses":"28","key":false,"slug":"mark","url":"/bible/mark/2#v28","label":"Mark 2:28","study":null,"text":[{"verse":28,"text":"Therefore the Son of man is Lord also of the sabbath."}],"more":0},{"book":"Matthew","chapter":12,"verses":"8","key":false,"slug":"matthew","url":"/bible/matthew/12#v8","label":"Matthew 12:8","study":{"range":"Matthew 12","url":"/study/matthew/12"},"text":[{"verse":8,"text":"For the Son of man is Lord even of the sabbath day."}],"more":0},{"book":"Revelation","chapter":1,"verses":"10","key":false,"slug":"revelation","url":"/bible/revelation/1#v10","label":"Revelation 1:10","study":null,"text":[{"verse":10,"text":"I was in the Spirit on the Lord’s day, and heard behind me a great voice, as of a trumpet,"}],"more":0},{"book":"Luke","chapter":6,"verses":"5","key":false,"slug":"luke","url":"/bible/luke/6#v5","label":"Luke 6:5","study":{"range":"Luke 6","url":"/study/luke/6"},"text":[{"verse":5,"text":"And he said unto them, That the Son of man is Lord also of the sabbath."}],"more":0}],"url":"/precepts/the-lord-s-day"}