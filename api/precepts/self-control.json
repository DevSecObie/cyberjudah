{"title":"Self Control","slug":"self-control","refs":[{"book":"Galatians","chapter":5,"verses":"23","key":false,"slug":"galatians","url":"/bible/galatians/5#v23","label":"Galatians 5:23","study":null,"text":[{"verse":23,"text":"Meekness, temperance: against such there is no law."}],"more":0},{"book":"Proverbs","chapter":25,"verses":"28","key":false,"slug":"proverbs","url":"/bible/proverbs/25#v28","label":"Proverbs 25:28","study":{"range":"Proverbs 25","url":"/study/proverbs/25"},"text":[{"verse":28,"text":"He that hath no rule over his own spirit is like a city that is broken down, and without walls."}],"more":0},{"book":"Sirach","chapter":7,"verses":"14","key":false,"slug":"sirach","url":"/bible/sirach/7#v14","label":"Sirach 7:14","study":null,"text":[{"verse":14,"text":"Use not many words in a multitude of elders, and make not much babbling when thou prayest."}],"more":0},{"book":"Sirach","chapter":31,"verses":"18","key":false,"slug":"sirach","url":"/bible/sirach/31#v18","label":"Sirach 31:18","study":null,"text":[{"verse":18,"text":"When thou sittest among many, reach not thine hand out first of all."}],"more":0},{"book":"Sirach","chapter":32,"verses":"7","key":false,"slug":"sirach","url":"/bible/sirach/32#v7","label":"Sirach 32:7","study":null,"text":[{"verse":7,"text":"Speak, young man, if there be need of thee: and yet scarcely when thou art twice asked."}],"more":0}],"url":"/precepts/self-control"}