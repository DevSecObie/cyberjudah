{"title":"Stealing","slug":"stealing","refs":[{"book":"Exodus","chapter":20,"verses":"15","key":false,"slug":"exodus","url":"/bible/exodus/20#v15","label":"Exodus 20:15","study":{"range":"Exodus 20","url":"/study/exodus/20"},"text":[{"verse":15,"text":"Thou shalt not steal."}],"more":0},{"book":"Deuteronomy","chapter":5,"verses":"19","key":false,"slug":"deuteronomy","url":"/bible/deuteronomy/5#v19","label":"Deuteronomy 5:19","study":{"range":"Deuteronomy 5","url":"/study/deuteronomy/5"},"text":[{"verse":19,"text":"Neither shalt thou steal."}],"more":0},{"book":"Leviticus","chapter":19,"verses":"11","key":false,"slug":"leviticus","url":"/bible/leviticus/19#v11","label":"Leviticus 19:11","study":{"range":"Leviticus 19","url":"/study/leviticus/19"},"text":[{"verse":11,"text":"Ye shall not steal, neither deal falsely, neither lie one to another."}],"more":0},{"book":"Ephesians","chapter":4,"verses":"28","key":false,"slug":"ephesians","url":"/bible/ephesians/4#v28","label":"Ephesians 4:28","study":null,"text":[{"verse":28,"text":"Let him that stole steal no more: but rather let him labour, working with his hands the thing which is good, that he may have to give to him that needeth."}],"more":0}],"url":"/precepts/stealing"}