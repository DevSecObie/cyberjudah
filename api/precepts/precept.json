{"title":"Precept","slug":"precept","refs":[{"book":"Isaiah","chapter":28,"verses":"10","key":false,"slug":"isaiah","url":"/bible/isaiah/28#v10","label":"Isaiah 28:10","study":{"range":"Isaiah 28","url":"/study/isaiah/28"},"text":[{"verse":10,"text":"For precept must be upon precept, precept upon precept; line upon line, line upon line; here a little, and there a little:"}],"more":0},{"book":"Psalms","chapter":119,"verses":"27","key":false,"slug":"psalms","url":"/bible/psalms/119#v27","label":"Psalms 119:27","study":{"range":"Psalms 119","url":"/study/psalms/119"},"text":[{"verse":27,"text":"Make me to understand the way of thy precepts: so shall I talk of thy wondrous works."}],"more":0},{"book":"Psalms","chapter":119,"verses":"100","key":false,"slug":"psalms","url":"/bible/psalms/119#v100","label":"Psalms 119:100","study":{"range":"Psalms 119","url":"/study/psalms/119"},"text":[{"verse":100,"text":"I understand more than the ancients, because I keep thy precepts."}],"more":0},{"book":"Psalms","chapter":119,"verses":"104","key":false,"slug":"psalms","url":"/bible/psalms/119#v104","label":"Psalms 119:104","study":{"range":"Psalms 119","url":"/study/psalms/119"},"text":[{"verse":104,"text":"Through thy precepts I get understanding: therefore I hate every false way."}],"more":0}],"url":"/precepts/precept"}