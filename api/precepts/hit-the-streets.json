{"title":"Hit the streets","slug":"hit-the-streets","refs":[{"book":"Proverbs","chapter":1,"verses":"20","key":false,"slug":"proverbs","url":"/bible/proverbs/1#v20","label":"Proverbs 1:20","study":{"range":"Proverbs 1","url":"/study/proverbs/1"},"text":[{"verse":20,"text":"Wisdom crieth without; she uttereth her voice in the streets:"}],"more":0},{"book":"Isaiah","chapter":51,"verses":"20","key":false,"slug":"isaiah","url":"/bible/isaiah/51#v20","label":"Isaiah 51:20","study":{"range":"Isaiah 51","url":"/study/isaiah/51"},"text":[{"verse":20,"text":"Thy sons have fainted, they lie at the head of all the streets, as a wild bull in a net: they are full of the fury of the Lord, the rebuke of thy God."}],"more":0},{"book":"Matthew","chapter":22,"verses":"9","key":false,"slug":"matthew","url":"/bible/matthew/22#v9","label":"Matthew 22:9","study":{"range":"Matthew 22","url":"/study/matthew/22"},"text":[{"verse":9,"text":"Go ye therefore into the highways, and as many as ye shall find, bid to the marriage."}],"more":0}],"url":"/precepts/hit-the-streets"}