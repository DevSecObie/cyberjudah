{"title":"Dietary Laws","slug":"dietary-laws","refs":[{"book":"Genesis","chapter":8,"verses":"20","key":false,"slug":"genesis","url":"/bible/genesis/8#v20","label":"Genesis 8:20","study":{"range":"Genesis 8","url":"/study/genesis/8"},"text":[{"verse":20,"text":"And Noah builded an altar unto the Lord; and took of every clean beast, and of every clean fowl, and offered burnt offerings on the altar."}],"more":0},{"book":"Deuteronomy","chapter":14,"verses":"3","key":false,"slug":"deuteronomy","url":"/bible/deuteronomy/14#v3","label":"Deuteronomy 14:3","study":{"range":"Deuteronomy 14","url":"/study/deuteronomy/14"},"text":[{"verse":3,"text":"Thou shalt not eat any abominable thing."}],"more":0},{"book":"Leviticus","chapter":11,"verses":"2","key":false,"slug":"leviticus","url":"/bible/leviticus/11#v2","label":"Leviticus 11:2","study":{"range":"Leviticus 11","url":"/study/leviticus/11"},"text":[{"verse":2,"text":"Speak unto the children of Israel, saying, These are the beasts which ye shall eat among all the beasts that are on the earth."}],"more":0}],"url":"/precepts/dietary-laws"}