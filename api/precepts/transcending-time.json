{"title":"Transcending Time","slug":"transcending-time","refs":[{"book":"Genesis","chapter":1,"verses":"1","key":false,"slug":"genesis","url":"/bible/genesis/1#v1","label":"Genesis 1:1","study":{"range":"Genesis 1","url":"/study/genesis/1"},"text":[{"verse":1,"text":"In the beginning God created the heaven and the earth."}],"more":0},{"book":"Malachi","chapter":3,"verses":"6","key":false,"slug":"malachi","url":"/bible/malachi/3#v6","label":"Malachi 3:6","study":null,"text":[{"verse":6,"text":"For I am the Lord, I change not; therefore ye sons of Jacob are not consumed."}],"more":0},{"book":"Psalms","chapter":90,"verses":"4","key":false,"slug":"psalms","url":"/bible/psalms/90#v4","label":"Psalms 90:4","study":{"range":"Psalms 90","url":"/study/psalms/90"},"text":[{"verse":4,"text":"For a thousand years in thy sight are but as yesterday when it is past, and as a watch in the night."}],"more":0},{"book":"Hebrews","chapter":13,"verses":"8","key":false,"slug":"hebrews","url":"/bible/hebrews/13#v8","label":"Hebrews 13:8","study":null,"text":[{"verse":8,"text":"Jesus Christ the same yesterday, and to day, and for ever."}],"more":0},{"book":"Isaiah","chapter":46,"verses":"10","key":false,"slug":"isaiah","url":"/bible/isaiah/46#v10","label":"Isaiah 46:10","study":{"range":"Isaiah 46","url":"/study/isaiah/46"},"text":[{"verse":10,"text":"Declaring the end from the beginning, and from ancient times the things that are not yet done, saying, My counsel shall stand, and I will do all my pleasure:"}],"more":0},{"book":"Matthew","chapter":17,"verses":"3","key":false,"slug":"matthew","url":"/bible/matthew/17#v3","label":"Matthew 17:3","study":null,"text":[{"verse":3,"text":"And, behold, there appeared unto them Moses and Elias talking with him."}],"more":0}],"url":"/precepts/transcending-time"}