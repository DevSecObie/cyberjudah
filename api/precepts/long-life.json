{"title":"Long Life","slug":"long-life","refs":[{"book":"Exodus","chapter":20,"verses":"12","key":false,"slug":"exodus","url":"/bible/exodus/20#v12","label":"Exodus 20:12","study":{"range":"Exodus 20","url":"/study/exodus/20"},"text":[{"verse":12,"text":"Honour thy father and thy mother: that thy days may be long upon the land which the Lord thy God giveth thee."}],"more":0},{"book":"Ephesians","chapter":6,"verses":"3","key":false,"slug":"ephesians","url":"/bible/ephesians/6#v3","label":"Ephesians 6:3","study":null,"text":[{"verse":3,"text":"That it may be well with thee, and thou mayest live long on the earth."}],"more":0},{"book":"Proverbs","chapter":3,"verses":"2","key":false,"slug":"proverbs","url":"/bible/proverbs/3#v2","label":"Proverbs 3:2","study":{"range":"Proverbs 3","url":"/study/proverbs/3"},"text":[{"verse":2,"text":"For length of days, and long life, and peace, shall they add to thee."}],"more":0},{"book":"Sirach","chapter":3,"verses":"8","key":false,"slug":"sirach","url":"/bible/sirach/3#v8","label":"Sirach 3:8","study":null,"text":[{"verse":8,"text":"Honour thy father and mother both in word and deed, that a blessing may come upon thee from them."}],"more":0}],"url":"/precepts/long-life"}