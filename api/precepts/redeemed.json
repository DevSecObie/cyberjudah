{"title":"Redeemed","slug":"redeemed","refs":[{"book":"Galatians","chapter":4,"verses":"5","key":false,"slug":"galatians","url":"/bible/galatians/4#v5","label":"Galatians 4:5","study":null,"text":[{"verse":5,"text":"To redeem them that were under the law, that we might receive the adoption of sons."}],"more":0},{"book":"Psalms","chapter":25,"verses":"22","key":false,"slug":"psalms","url":"/bible/psalms/25#v22","label":"Psalms 25:22","study":{"range":"Psalms 25","url":"/study/psalms/25"},"text":[{"verse":22,"text":"Redeem Israel, O God, out of all his troubles."}],"more":0},{"book":"Psalms","chapter":130,"verses":"8","key":false,"slug":"psalms","url":"/bible/psalms/130#v8","label":"Psalms 130:8","study":{"range":"Psalms 130","url":"/study/psalms/130"},"text":[{"verse":8,"text":"And he shall redeem Israel from all his iniquities."}],"more":0},{"book":"Isaiah","chapter":43,"verses":"1","key":false,"slug":"isaiah","url":"/bible/isaiah/43#v1","label":"Isaiah 43:1","study":{"range":"Isaiah 43","url":"/study/isaiah/43"},"text":[{"verse":1,"text":"But now thus saith the Lord that created thee, O Jacob, and he that formed thee, O Israel, Fear not: for I have redeemed thee, I have called thee by thy name; thou art mine."}],"more":0},{"book":"Jeremiah","chapter":31,"verses":"11","key":false,"slug":"jeremiah","url":"/bible/jeremiah/31#v11","label":"Jeremiah 31:11","study":{"range":"Jeremiah 31","url":"/study/jeremiah/31"},"text":[{"verse":11,"text":"For the Lord hath redeemed Jacob, and ransomed him from the hand of him that was stronger than he."}],"more":0},{"book":"Luke","chapter":1,"verses":"68","key":false,"slug":"luke","url":"/bible/luke/1#v68","label":"Luke 1:68","study":null,"text":[{"verse":68,"text":"Blessed be the Lord God of Israel; for he hath visited and redeemed his people,"}],"more":0}],"url":"/precepts/redeemed"}