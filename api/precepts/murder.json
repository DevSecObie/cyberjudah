{"title":"Murder","slug":"murder","refs":[{"book":"1 John","chapter":3,"verses":"15","key":false,"slug":"1-john","url":"/bible/1-john/3#v15","label":"1 John 3:15","study":null,"text":[{"verse":15,"text":"Whosoever hateth his brother is a murderer: and ye know that no murderer hath eternal life abiding in him."}],"more":0},{"book":"Genesis","chapter":4,"verses":"8","key":false,"slug":"genesis","url":"/bible/genesis/4#v8","label":"Genesis 4:8","study":{"range":"Genesis 4","url":"/study/genesis/4"},"text":[{"verse":8,"text":"And Cain talked with Abel his brother: and it came to pass, when they were in the field, that Cain rose up against Abel his brother, and slew him."}],"more":0},{"book":"Genesis","chapter":9,"verses":"6","key":false,"slug":"genesis","url":"/bible/genesis/9#v6","label":"Genesis 9:6","study":{"range":"Genesis 9","url":"/study/genesis/9"},"text":[{"verse":6,"text":"Whoso sheddeth man’s blood, by man shall his blood be shed: for in the image of God made he man."}],"more":0},{"book":"Exodus","chapter":20,"verses":"13","key":false,"slug":"exodus","url":"/bible/exodus/20#v13","label":"Exodus 20:13","study":{"range":"Exodus 20","url":"/study/exodus/20"},"text":[{"verse":13,"text":"Thou shalt not kill."}],"more":0},{"book":"Exodus","chapter":21,"verses":"14","key":false,"slug":"exodus","url":"/bible/exodus/21#v14","label":"Exodus 21:14","study":{"range":"Exodus 21","url":"/study/exodus/21"},"text":[{"verse":14,"text":"But if a man come presumptuously upon his neighbour, to slay him with guile; thou shalt take him from mine altar, that he may die."}],"more":0},{"book":"Deuteronomy","chapter":5,"verses":"17","key":false,"slug":"deuteronomy","url":"/bible/deuteronomy/5#v17","label":"Deuteronomy 5:17","study":{"range":"Deuteronomy 5","url":"/study/deuteronomy/5"},"text":[{"verse":17,"text":"Thou shalt not kill."}],"more":0},{"book":"Leviticus","chapter":24,"verses":"17","key":false,"slug":"leviticus","url":"/bible/leviticus/24#v17","label":"Leviticus 24:17","study":{"range":"Leviticus 24","url":"/study/leviticus/24"},"text":[{"verse":17,"text":"And he that killeth any man shall surely be put to death."}],"more":0}],"url":"/precepts/murder"}