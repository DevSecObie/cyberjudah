{"title":"Tempt God","slug":"tempt-god","refs":[{"book":"Judith","chapter":8,"verses":"12","key":false,"slug":"judith","url":"/bible/judith/8#v12","label":"Judith 8:12","study":null,"text":[{"verse":12,"text":"And now who are ye that have tempted God this day, and stand instead of God among the children of men?"}],"more":0},{"book":"James","chapter":1,"verses":"13","key":false,"slug":"james","url":"/bible/james/1#v13","label":"James 1:13","study":null,"text":[{"verse":13,"text":"Let no man say when he is tempted, I am tempted of God: for God cannot be tempted with evil, neither tempteth he any man:"}],"more":0},{"book":"Deuteronomy","chapter":6,"verses":"16","key":false,"slug":"deuteronomy","url":"/bible/deuteronomy/6#v16","label":"Deuteronomy 6:16","study":{"range":"Deuteronomy 6","url":"/study/deuteronomy/6"},"text":[{"verse":16,"text":"Ye shall not tempt the Lord your God, as ye tempted him in Massah."}],"more":0},{"book":"Psalms","chapter":78,"verses":"56","key":false,"slug":"psalms","url":"/bible/psalms/78#v56","label":"Psalms 78:56","study":{"range":"Psalms 78","url":"/study/psalms/78"},"text":[{"verse":56,"text":"Yet they tempted and provoked the most high God, and kept not his testimonies:"}],"more":0},{"book":"Matthew","chapter":4,"verses":"7","key":false,"slug":"matthew","url":"/bible/matthew/4#v7","label":"Matthew 4:7","study":{"range":"Matthew 4","url":"/study/matthew/4"},"text":[{"verse":7,"text":"Jesus said unto him, It is written again, Thou shalt not tempt the Lord thy God."}],"more":0},{"book":"Luke","chapter":4,"verses":"12","key":false,"slug":"luke","url":"/bible/luke/4#v12","label":"Luke 4:12","study":{"range":"Luke 4","url":"/study/luke/4"},"text":[{"verse":12,"text":"And Jesus answering said unto him, It is said, Thou shalt not tempt the Lord thy God."}],"more":0}],"url":"/precepts/tempt-god"}