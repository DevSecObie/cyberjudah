{"title":"Reputation","slug":"reputation","refs":[{"book":"Ecclesiastes","chapter":7,"verses":"1","key":false,"slug":"ecclesiastes","url":"/bible/ecclesiastes/7#v1","label":"Ecclesiastes 7:1","study":{"range":"Ecclesiastes 7","url":"/study/ecclesiastes/7"},"text":[{"verse":1,"text":"A good name is better than precious ointment; and the day of death than the day of one’s birth."}],"more":0},{"book":"Proverbs","chapter":22,"verses":"1","key":false,"slug":"proverbs","url":"/bible/proverbs/22#v1","label":"Proverbs 22:1","study":{"range":"Proverbs 22","url":"/study/proverbs/22"},"text":[{"verse":1,"text":"A good name is rather to be chosen than great riches, and loving favour rather than silver and gold."}],"more":0},{"book":"Sirach","chapter":41,"verses":"13","key":false,"slug":"sirach","url":"/bible/sirach/41#v13","label":"Sirach 41:13","study":null,"text":[{"verse":13,"text":"A good life hath but few days: but a good name endureth for ever."}],"more":0},{"book":"Matthew","chapter":7,"verses":"23","key":false,"slug":"matthew","url":"/bible/matthew/7#v23","label":"Matthew 7:23","study":null,"text":[{"verse":23,"text":"And then will I profess unto them, I never knew you: depart from me, ye that work iniquity."}],"more":0}],"url":"/precepts/reputation"}