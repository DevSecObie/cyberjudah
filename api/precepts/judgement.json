{"title":"Judgement","slug":"judgement","refs":[{"book":"Psalms","chapter":147,"verses":"19","key":false,"slug":"psalms","url":"/bible/psalms/147#v19","label":"Psalms 147:19","study":{"range":"Psalms 147","url":"/study/psalms/147"},"text":[{"verse":19,"text":"He sheweth his word unto Jacob, his statutes and his judgments unto Israel."}],"more":0},{"book":"John","chapter":16,"verses":"8","key":false,"slug":"john","url":"/bible/john/16#v8","label":"John 16:8","study":null,"text":[{"verse":8,"text":"And when he is come, he will reprove the world of sin, and of righteousness, and of judgment:"}],"more":0},{"book":"Psalms","chapter":119,"verses":"120","key":false,"slug":"psalms","url":"/bible/psalms/119#v120","label":"Psalms 119:120","study":{"range":"Psalms 119","url":"/study/psalms/119"},"text":[{"verse":120,"text":"My flesh trembleth for fear of thee; and I am afraid of thy judgments."}],"more":0}],"url":"/precepts/judgement"}