{"title":"Peace","slug":"peace","refs":[{"book":"Romans","chapter":12,"verses":"18","key":false,"slug":"romans","url":"/bible/romans/12#v18","label":"Romans 12:18","study":null,"text":[{"verse":18,"text":"If it be possible, as much as lieth in you, live peaceably with all men."}],"more":0},{"book":"James","chapter":3,"verses":"18","key":false,"slug":"james","url":"/bible/james/3#v18","label":"James 3:18","study":null,"text":[{"verse":18,"text":"And the fruit of righteousness is sown in peace of them that make peace."}],"more":0},{"book":"Psalms","chapter":34,"verses":"14","key":false,"slug":"psalms","url":"/bible/psalms/34#v14","label":"Psalms 34:14","study":{"range":"Psalms 34","url":"/study/psalms/34"},"text":[{"verse":14,"text":"Depart from evil, and do good; seek peace, and pursue it."}],"more":0},{"book":"Psalms","chapter":37,"verses":"37","key":false,"slug":"psalms","url":"/bible/psalms/37#v37","label":"Psalms 37:37","study":{"range":"Psalms 37","url":"/study/psalms/37"},"text":[{"verse":37,"text":"Mark the perfect man, and behold the upright: for the end of that man is peace."}],"more":0},{"book":"Ephesians","chapter":4,"verses":"3","key":false,"slug":"ephesians","url":"/bible/ephesians/4#v3","label":"Ephesians 4:3","study":null,"text":[{"verse":3,"text":"Endeavouring to keep the unity of the Spirit in the bond of peace."}],"more":0},{"book":"2 Corinthians","chapter":13,"verses":"11","key":false,"slug":"2-corinthians","url":"/bible/2-corinthians/13#v11","label":"2 Corinthians 13:11","study":null,"text":[{"verse":11,"text":"Finally, brethren, farewell. Be perfect, be of good comfort, be of one mind, live in peace; and the God of love and peace shall be with you."}],"more":0},{"book":"Proverbs","chapter":16,"verses":"7","key":false,"slug":"proverbs","url":"/bible/proverbs/16#v7","label":"Proverbs 16:7","study":{"range":"Proverbs 16","url":"/study/proverbs/16"},"text":[{"verse":7,"text":"When a man’s ways please the Lord, he maketh even his enemies to be at peace with him."}],"more":0},{"book":"Isaiah","chapter":26,"verses":"3","key":false,"slug":"isaiah","url":"/bible/isaiah/26#v3","label":"Isaiah 26:3","study":{"range":"Isaiah 26","url":"/study/isaiah/26"},"text":[{"verse":3,"text":"Thou wilt keep him in perfect peace, whose mind is stayed on thee: because he trusteth in thee."}],"more":0},{"book":"Sirach","chapter":28,"verses":"9","key":false,"slug":"sirach","url":"/bible/sirach/28#v9","label":"Sirach 28:9","study":null,"text":[{"verse":9,"text":"A sinful man disquieteth friends, and maketh debate among them that be at peace."}],"more":0},{"book":"Matthew","chapter":5,"verses":"9","key":false,"slug":"matthew","url":"/bible/matthew/5#v9","label":"Matthew 5:9","study":{"range":"Matthew 5","url":"/study/matthew/5"},"text":[{"verse":9,"text":"Blessed are the peacemakers: for they shall be called the children of God."}],"more":0}],"url":"/precepts/peace"}