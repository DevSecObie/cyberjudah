{"title":"Lying","slug":"lying","refs":[{"book":"Exodus","chapter":20,"verses":"16","key":false,"slug":"exodus","url":"/bible/exodus/20#v16","label":"Exodus 20:16","study":{"range":"Exodus 20","url":"/study/exodus/20"},"text":[{"verse":16,"text":"Thou shalt not bear false witness against thy neighbour."}],"more":0},{"book":"Deuteronomy","chapter":5,"verses":"20","key":false,"slug":"deuteronomy","url":"/bible/deuteronomy/5#v20","label":"Deuteronomy 5:20","study":{"range":"Deuteronomy 5","url":"/study/deuteronomy/5"},"text":[{"verse":20,"text":"Neither shalt thou bear false witness against thy neighbour."}],"more":0},{"book":"Leviticus","chapter":19,"verses":"11","key":false,"slug":"leviticus","url":"/bible/leviticus/19#v11","label":"Leviticus 19:11","study":{"range":"Leviticus 19","url":"/study/leviticus/19"},"text":[{"verse":11,"text":"Ye shall not steal, neither deal falsely, neither lie one to another."}],"more":0},{"book":"Ephesians","chapter":4,"verses":"25","key":false,"slug":"ephesians","url":"/bible/ephesians/4#v25","label":"Ephesians 4:25","study":null,"text":[{"verse":25,"text":"Wherefore putting away lying, speak every man truth with his neighbour: for we are members one of another."}],"more":0},{"book":"Proverbs","chapter":12,"verses":"19","key":false,"slug":"proverbs","url":"/bible/proverbs/12#v19","label":"Proverbs 12:19","study":{"range":"Proverbs 12","url":"/study/proverbs/12"},"text":[{"verse":19,"text":"The lip of truth shall be established for ever: but a lying tongue is but for a moment."}],"more":0},{"book":"Proverbs","chapter":12,"verses":"22","key":false,"slug":"proverbs","url":"/bible/proverbs/12#v22","label":"Proverbs 12:22","study":{"range":"Proverbs 12","url":"/study/proverbs/12"},"text":[{"verse":22,"text":"Lying lips are abomination to the Lord: but they that deal truly are his delight."}],"more":0},{"book":"Proverbs","chapter":26,"verses":"28","key":false,"slug":"proverbs","url":"/bible/proverbs/26#v28","label":"Proverbs 26:28","study":{"range":"Proverbs 26","url":"/study/proverbs/26"},"text":[{"verse":28,"text":"A lying tongue hateth those that are afflicted by it; and a flattering mouth worketh ruin."}],"more":0},{"book":"Sirach","chapter":7,"verses":"13","key":false,"slug":"sirach","url":"/bible/sirach/7#v13","label":"Sirach 7:13","study":null,"text":[{"verse":13,"text":"Use not to make any manner of lie: for the custom thereof is not good."}],"more":0},{"book":"Sirach","chapter":20,"verses":"24","key":false,"slug":"sirach","url":"/bible/sirach/20#v24","label":"Sirach 20:24","study":null,"text":[{"verse":24,"text":"A lie is a foul blot in a man, yet it is continually in the mouth of the untaught."}],"more":0}],"url":"/precepts/lying"}