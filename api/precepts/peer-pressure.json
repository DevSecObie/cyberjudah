{"title":"Peer Pressure","slug":"peer-pressure","refs":[{"book":"Exodus","chapter":23,"verses":"2","key":false,"slug":"exodus","url":"/bible/exodus/23#v2","label":"Exodus 23:2","study":{"range":"Exodus 23","url":"/study/exodus/23"},"text":[{"verse":2,"text":"Thou shalt not follow a multitude to do evil; neither shalt thou speak in a cause to decline after many to wrest judgment:"}],"more":0},{"book":"Proverbs","chapter":1,"verses":"10","key":false,"slug":"proverbs","url":"/bible/proverbs/1#v10","label":"Proverbs 1:10","study":{"range":"Proverbs 1","url":"/study/proverbs/1"},"text":[{"verse":10,"text":"My son, if sinners entice thee, consent thou not."}],"more":0},{"book":"Sirach","chapter":7,"verses":"16","key":false,"slug":"sirach","url":"/bible/sirach/7#v16","label":"Sirach 7:16","study":null,"text":[{"verse":16,"text":"Number not thyself among the multitude of sinners, but remember that wrath will not tarry long."}],"more":0}],"url":"/precepts/peer-pressure"}