{"title":"Truth","slug":"truth","refs":[{"book":"1 John","chapter":2,"verses":"4","key":false,"slug":"1-john","url":"/bible/1-john/2#v4","label":"1 John 2:4","study":null,"text":[{"verse":4,"text":"He that saith, I know him, and keepeth not his commandments, is a liar, and the truth is not in him."}],"more":0},{"book":"John","chapter":8,"verses":"32","key":false,"slug":"john","url":"/bible/john/8#v32","label":"John 8:32","study":null,"text":[{"verse":32,"text":"And ye shall know the truth, and the truth shall make you free."}],"more":0},{"book":"John","chapter":14,"verses":"6","key":false,"slug":"john","url":"/bible/john/14#v6","label":"John 14:6","study":null,"text":[{"verse":6,"text":"Jesus saith unto him, I am the way, the truth, and the life: no man cometh unto the Father, but by me."}],"more":0},{"book":"John","chapter":17,"verses":"17","key":false,"slug":"john","url":"/bible/john/17#v17","label":"John 17:17","study":null,"text":[{"verse":17,"text":"Sanctify them through thy truth: thy word is truth."}],"more":0},{"book":"Psalms","chapter":119,"verses":"142","key":false,"slug":"psalms","url":"/bible/psalms/119#v142","label":"Psalms 119:142","study":{"range":"Psalms 119","url":"/study/psalms/119"},"text":[{"verse":142,"text":"Thy righteousness is an everlasting righteousness, and thy law is the truth."}],"more":0},{"book":"Psalms","chapter":119,"verses":"151","key":false,"slug":"psalms","url":"/bible/psalms/119#v151","label":"Psalms 119:151","study":{"range":"Psalms 119","url":"/study/psalms/119"},"text":[{"verse":151,"text":"Thou art near, O Lord; and all thy commandments are truth."}],"more":0}],"url":"/precepts/truth"}