{"title":"Envy","slug":"envy","refs":[{"book":"Proverbs","chapter":3,"verses":"31","key":false,"slug":"proverbs","url":"/bible/proverbs/3#v31","label":"Proverbs 3:31","study":{"range":"Proverbs 3","url":"/study/proverbs/3"},"text":[{"verse":31,"text":"Envy thou not the oppressor, and choose none of his ways."}],"more":0},{"book":"Sirach","chapter":9,"verses":"11","key":false,"slug":"sirach","url":"/bible/sirach/9#v11","label":"Sirach 9:11","study":null,"text":[{"verse":11,"text":"Envy not the glory of a sinner: for thou knowest not what shall be his end."}],"more":0},{"book":"2 Maccabees","chapter":4,"verses":"15","key":false,"slug":"2-maccabees","url":"/bible/2-maccabees/4#v15","label":"2 Maccabees 4:15","study":null,"text":[{"verse":15,"text":"Not setting by the honours of their fathers, but liking the glory of the Grecians best of all."}],"more":0}],"url":"/precepts/envy"}