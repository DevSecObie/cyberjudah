{"title":"Examine","slug":"examine","refs":[{"book":"Lamentations","chapter":3,"verses":"40","key":false,"slug":"lamentations","url":"/bible/lamentations/3#v40","label":"Lamentations 3:40","study":{"range":"Lamentations 3","url":"/study/lamentations/3"},"text":[{"verse":40,"text":"Let us search and try our ways, and turn again to the Lord."}],"more":0},{"book":"Psalms","chapter":4,"verses":"4","key":false,"slug":"psalms","url":"/bible/psalms/4#v4","label":"Psalms 4:4","study":{"range":"Psalms 4","url":"/study/psalms/4"},"text":[{"verse":4,"text":"Stand in awe, and sin not: commune with your own heart upon your bed, and be still. Selah."}],"more":0},{"book":"Psalms","chapter":26,"verses":"2","key":false,"slug":"psalms","url":"/bible/psalms/26#v2","label":"Psalms 26:2","study":{"range":"Psalms 26","url":"/study/psalms/26"},"text":[{"verse":2,"text":"Examine me, O Lord, and prove me; try my reins and my heart."}],"more":0},{"book":"Job","chapter":13,"verses":"23","key":false,"slug":"job","url":"/bible/job/13#v23","label":"Job 13:23","study":{"range":"Job 13","url":"/study/job/13"},"text":[{"verse":23,"text":"How many are mine iniquities and sins? make me to know my transgression and my sin."}],"more":0},{"book":"1 Corinthians","chapter":10,"verses":"12","key":false,"slug":"1-corinthians","url":"/bible/1-corinthians/10#v12","label":"1 Corinthians 10:12","study":null,"text":[{"verse":12,"text":"Wherefore let him that thinketh he standeth take heed lest he fall."}],"more":0},{"book":"1 Corinthians","chapter":11,"verses":"31","key":false,"slug":"1-corinthians","url":"/bible/1-corinthians/11#v31","label":"1 Corinthians 11:31","study":null,"text":[{"verse":31,"text":"For if we would judge ourselves, we should not be judged."}],"more":0},{"book":"2 Corinthians","chapter":13,"verses":"5","key":false,"slug":"2-corinthians","url":"/bible/2-corinthians/13#v5","label":"2 Corinthians 13:5","study":null,"text":[{"verse":5,"text":"Examine yourselves, whether ye be in the faith; prove your own selves. Know ye not your own selves, how that Jesus Christ is in you, except ye be reprobates?"}],"more":0},{"book":"Sirach","chapter":18,"verses":"20","key":false,"slug":"sirach","url":"/bible/sirach/18#v20","label":"Sirach 18:20","study":null,"text":[{"verse":20,"text":"Before judgment examine thyself, and in the day of visitation thou shalt find mercy."}],"more":0},{"book":"Sirach","chapter":37,"verses":"27","key":false,"slug":"sirach","url":"/bible/sirach/37#v27","label":"Sirach 37:27","study":null,"text":[{"verse":27,"text":"My son, prove thy soul in thy life, and see what is evil for it, and give not that unto it."}],"more":0},{"book":"Psalms","chapter":119,"verses":"59","key":false,"slug":"psalms","url":"/bible/psalms/119#v59","label":"Psalms 119:59","study":{"range":"Psalms 119","url":"/study/psalms/119"},"text":[{"verse":59,"text":"I thought on my ways, and turned my feet unto thy testimonies."}],"more":0}],"url":"/precepts/examine"}