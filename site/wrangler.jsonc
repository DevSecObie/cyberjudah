{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cyberjudah",
  "main": "dist/server/server.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  // Static files in dist/client serve directly; every other path (including /) is
  // rendered by the Worker. The domain records are created by Cloudflare on deploy.
  "assets": { "directory": "./dist/client", "binding": "ASSETS", "not_found_handling": "none" },
  // The search index (search_docs, FTS5) lives in D1; the data workflow reloads it from the
  // engine's search.sql on every publish. The id is filled in by the deploy workflow from
  // `wrangler d1 list`, so nothing account-specific is committed.
  "d1_databases": [{ "binding": "DB", "database_name": "cyberjudah", "database_id": "00000000-0000-0000-0000-000000000000" }],
  "routes": [
    { "pattern": "cyberjudah.io", "custom_domain": true },
    { "pattern": "www.cyberjudah.io", "custom_domain": true }
  ]
}
