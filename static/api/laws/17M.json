{"id":"17M","title":"Revenge and Vengeance","part":{"n":17,"title":"Personal character traits"},"url":"/law/17-personal-character-traits/17m","entries":[{"id":"17M.1","text":"You are not to personally avenge or bear any grudge against your brethren.","refs":[{"book":"Leviticus","chapter":19,"verses":"18"},{"book":"Proverbs","chapter":24,"verses":"29"}],"citation":"Lev. 19:18; Prov. 24:29."},{"id":"17M.2","text":"Repay to no man evil for evil.","refs":[{"book":"Romans","chapter":12,"verses":"17"},{"book":"1 Thessalonians","chapter":5,"verses":"15"},{"book":"1 Peter","chapter":3,"verses":"9"}],"citation":"Rom. 12:17; 1 Thes. 5:15; 1 Pet 3:9."},{"id":"17M.3","text":"Avenge not yourselves, for vengeance is in God's hands.","refs":[{"book":"Deuteronomy","chapter":32,"verses":"35"},{"book":"Psalms","chapter":18,"verses":"47"},{"book":"Psalms","chapter":94,"verses":"1"},{"book":"Jeremiah","chapter":46,"verses":"9-10"},{"book":"Ezekiel","chapter":25,"verses":"12-17"},{"book":"Nahum","chapter":1,"verses":"2"},{"book":"Luke","chapter":18,"verses":"7"},{"book":"Romans","chapter":12,"verses":"19"},{"book":"1 Thessalonians","chapter":4,"verses":"6"},{"book":"Hebrews","chapter":10,"verses":"30"}],"citation":"Deut 32:35; Psa. 18:47; Psa. 94:1; Jer. 46:9-10; Ezek. 25:12-17; Nah. 1:2; Luke 18:7; Rom. 12:19; 1 Thes. 4:6; Heb. 10:30."},{"id":"17M.4","text":"Trust in God instead of taking revenge.","refs":[{"book":"Proverbs","chapter":20,"verses":"22"}],"citation":"Prov. 20:22."},{"id":"17M.5","text":"God will repay with affliction and tribulation those who persecute and afflict you because of your faith.","refs":[{"book":"2 Thessalonians","chapter":1,"verses":"4-9"}],"citation":"2 Thes. 1:4-9."},{"id":"17M.6","text":"We should keep others from taking revenge.","refs":[{"book":"1 Samuel","chapter":24,"verses":"4-7"},{"book":"1 Samuel","chapter":26,"verses":"9"}],"citation":"1 Sam. 24:4-7; 1 Sam. 26:9."},{"id":"17M.7","text":"Revenge often brings punishment.","refs":[{"book":"Ezekiel","chapter":25,"verses":"15-17"},{"book":"Amos","chapter":1,"verses":"11-12"}],"citation":"Ezek. 25:15-17; Amos 1:11-12."},{"id":"17M.8","text":"We should pray to God for His vengeance against those that unjustly inflict us.","refs":[{"book":"Jeremiah","chapter":11,"verses":"19-20"},{"book":"Jeremiah","chapter":20,"verses":"10-12"}],"citation":"Jer. 11: 19-20; Jer. 20:10-12."}]}