{"id":"15C","title":"Widows and Orphans","part":{"n":15,"title":"General welfare"},"url":"/law/15-general-welfare/15c","entries":[{"id":"15C.1","text":"We should be of aid and help to the fatherless and widows with their afflictions.","refs":[{"book":"Deuteronomy","chapter":14,"verses":"29"},{"book":"Job","chapter":24,"verses":"21"},{"book":"Job","chapter":29,"verses":"12-13"},{"book":"James","chapter":1,"verses":"27"},{"book":"1 Timothy","chapter":5,"verses":"16"}],"citation":"Deut. 14:29; Job 24:21; Job 29:12-13; James 1:27; 1 Tim. 5:16."},{"id":"15C.2","text":"Do not take a widow's raiment in pledge.","refs":[{"book":"Deuteronomy","chapter":24,"verses":"17"}],"citation":"Deut 24:17."},{"id":"15C.3","text":"You shall not afflict or oppress any widow or fatherless child.","refs":[{"book":"Exodus","chapter":22,"verses":"22-3"},{"book":"Deuteronomy","chapter":27,"verses":"19"},{"book":"Jeremiah","chapter":7,"verses":"6-7"},{"book":"Jeremiah","chapter":22,"verses":"3"},{"book":"Zechariah","chapter":7,"verses":"10"}],"citation":"Exod. 22:22-3; Deut. 27:19; Jer. 7:6-7; Jer. 22:3; Zech. 7:10."},{"id":"15C.4","text":"We should defend the fatherless and needy and plead for the widow.","refs":[{"book":"Psalms","chapter":82,"verses":"3"},{"book":"Isaiah","chapter":1,"verses":"17"}],"citation":"Psa. 82:3; Isa. 1:17."},{"id":"15C.5","text":"Curses and Punishments will befall those who neglect or cause affliction to the fatherless and widows.","refs":[{"book":"Deuteronomy","chapter":27,"verses":"19"},{"book":"Job","chapter":31,"verses":"16-23"},{"book":"Malachi","chapter":3,"verses":"5"}],"citation":"Deut 27:19; Job 31:16-23; Mal. 3:5."},{"id":"15C.6","text":"We should visit orphans and widows in their trouble.","refs":[{"book":"James","chapter":1,"verses":"27"}],"citation":"James 1:27."},{"id":"15C.7","text":"Honor widows who are really widows (those 60 years old and up and been the wife of one man).","refs":[{"book":"1 Timothy","chapter":5,"verses":"3,9"}],"citation":"1 Tim. 5:3, 9."}]}