{"id":"10H","title":"Child Sacrifice","part":{"n":10,"title":"Capital laws & offenses"},"url":"/law/10-capital-laws-offenses/10h","entries":[{"id":"10H.1","text":"Any that offer their children to pagan gods shall be put to death.","refs":[{"book":"Leviticus","chapter":20,"verses":"2-5"},{"book":"Deuteronomy","chapter":12,"verses":"30-31"}],"citation":"Lev. 20:2-5; Deut 12:30-31."},{"id":"10H.2","text":"Curses brought upon a nation that allows child sacrifice in its land.","refs":[{"book":"Jeremiah","chapter":7,"verses":"31-34"},{"book":"Jeremiah","chapter":19,"verses":"5-12"}],"citation":"Jer. 7:31-34; Jer. 19:5-12."},{"id":"10H.3","text":"You shall not let any of your offspring pass through the fire of Molech.","refs":[{"book":"Leviticus","chapter":18,"verses":"21"},{"book":"Leviticus","chapter":20,"verses":"2-5"},{"book":"2 Kings","chapter":23,"verses":"10"},{"book":"Jeremiah","chapter":32,"verses":"35"}],"citation":"Lev. 18:21; Lev. 20:2-5; 2 Kings 23:10; Jer. 32:35."}]}