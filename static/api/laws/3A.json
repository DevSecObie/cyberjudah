{"id":"3A","title":"Duty Towards Brethren","part":{"n":3,"title":"Relationship to Other Persons"},"url":"/law/03-relationship-to-other-persons/3a","entries":[{"id":"3A.1","text":"To restore the erring.","refs":[{"book":"Galatians","chapter":6,"verses":"1"},{"book":"James","chapter":5,"verses":"19-20"}],"citation":"Gal. 6:1; James 5:19-20."},{"id":"3A.2","text":"To help bear the burdens of one another.","refs":[{"book":"Romans","chapter":15,"verses":"1"},{"book":"Galatians","chapter":6,"verses":"2"}],"citation":"Rom. 15:1; Gal. 6:2."},{"id":"3A.3","text":"To help those that are weak in faith.","refs":[{"book":"Romans","chapter":14,"verses":"1"},{"book":"1 Thessalonians","chapter":5,"verses":"12"}],"citation":"Rom. 141; 1 Thes. 5:12."},{"id":"3A.4","text":"To pray for brethren.","refs":[{"book":"Job","chapter":42,"verses":"8-10"},{"book":"2 Corinthians","chapter":1,"verses":"11"},{"book":"1 Thessalonians","chapter":5,"verses":"25"},{"book":"2 Thessalonians","chapter":3,"verses":"1"}],"citation":"Job 42:8-10; 2 Cor. 1: 11; 1 Thes. 5:25; 2 Thes. 3:1."},{"id":"3A.5","text":"That which we do for our brethren we do for Christ.","refs":[{"book":"Matthew","chapter":25,"verses":"35-45"}],"citation":"Matt. 25:35-45."},{"id":"3A.6","text":"Comfort each other and edify one another.","refs":[{"book":"1 Thessalonians","chapter":5,"verses":"11"}],"citation":"1 Thes. 5:11."},{"id":"3A.7","text":"He is considered great who is servant to his brethren.","refs":[{"book":"Matthew","chapter":20,"verses":"26-28"},{"book":"Matthew","chapter":23,"verses":"11"},{"book":"Mark","chapter":10,"verses":"43-44"},{"book":"Luke","chapter":22,"verses":"26"}],"citation":"Matt. 20:26-28; Matt. 23:11; Mark 10:43-44; Luke 22:26."},{"id":"3A.8","text":"It is not good to do anything which causes your brother to stumble, or become offended, or be made weak.","refs":[{"book":"Romans","chapter":14,"verses":"13,21"},{"book":"1 Corinthians","chapter":8,"verses":"11-13"}],"citation":"Rom. 14:13, 21; 1 Cor. 8:11-13."},{"id":"3A.9","text":"We ought to lay down our lives for the brethren whom God laid down his life for.","refs":[{"book":"1 John","chapter":3,"verses":"16"}],"citation":"1 John 3:16."},{"id":"3A.10","text":"Do unto others as you would want others to treat you.","refs":[{"book":"Matthew","chapter":7,"verses":"12"},{"book":"Luke","chapter":6,"verses":"31"}],"citation":"Matt. 7:12; Luke 6:31."},{"id":"3A.11","text":"Endure all things for the sake of the elect.","refs":[{"book":"2 Timothy","chapter":2,"verses":"10"}],"citation":"2 Tim. 2:10."}]}