{"id":"2N","title":"Prayer","part":{"n":2,"title":"Relationship to God"},"url":"/law/02-relationship-to-god/2n","entries":[{"id":"2N.1","text":"Prayer to God commanded.","refs":[{"book":"Isaiah","chapter":55,"verses":"6"},{"book":"Matthew","chapter":7,"verses":"7"},{"book":"Philippians","chapter":4,"verses":"6"}],"citation":"Isa. 55:6; Matt. 7:7; Philip. 4:6."},{"id":"2N.2","text":"To be close to God we must call on God.","refs":[{"book":"Psalms","chapter":145,"verses":"18"}],"citation":"Psa. 145:18."},{"id":"2N.3","text":"Prayer to be continuous (without ceasing).","refs":[{"book":"Acts","chapter":12,"verses":"5"},{"book":"Colossians","chapter":4,"verses":"2"},{"book":"1 Thessalonians","chapter":5,"verses":"17"},{"book":"2 Timothy","chapter":1,"verses":"3"}],"citation":"Acts 12:5; Col. 4:2; 1 Thes. 5:17; 2 Tim. 1:3."},{"id":"2N.4","text":"Prayer brings to us the things we need.","refs":[{"book":"Deuteronomy","chapter":4,"verses":"7"},{"book":"Psalms","chapter":99,"verses":"6"},{"book":"Psalms","chapter":118,"verses":"5"},{"book":"Zechariah","chapter":10,"verses":"1"},{"book":"Matthew","chapter":6,"verses":"6"},{"book":"John","chapter":14,"verses":"13-4"}],"citation":"Deut 4:7; Psa. 99:6; Psa. 118:5; Zech. 10:1; Matt. 6:6; John 14:13-4."},{"id":"2N.5","text":"Pray for God to lead us in His righteousness.","refs":[{"book":"Psalms","chapter":5,"verses":"8"}],"citation":"Psa. 5:8."},{"id":"2N.6","text":"Public prayer and worship acceptable.","refs":[{"book":"2 Chronicles","chapter":7,"verses":"14"},{"book":"Nehemiah","chapter":8,"verses":"5-6"},{"book":"Nehemiah","chapter":9,"verses":"3"},{"book":"Psalms","chapter":42,"verses":"4"},{"book":"Psalms","chapter":95,"verses":"6"},{"book":"Isaiah","chapter":56,"verses":"7"},{"book":"Zechariah","chapter":8,"verses":"21"},{"book":"Matthew","chapter":18,"verses":"19"},{"book":"Luke","chapter":1,"verses":"10"},{"book":"Hebrews","chapter":10,"verses":"25"}],"citation":"2 Chron. 7:14; Neh. 8:5-6; Neh. 9:3; Psa. 42:4; Psa. 95:6; Isa. 56:7; Zech. 8:21; Matt. 18:19; Luke 1:10; Heb. 10:25."},{"id":"2N.7","text":"Whatsoever you shall ask the Father in Christ's name, He will give it to you.","refs":[{"book":"John","chapter":14,"verses":"13-14"},{"book":"John","chapter":16,"verses":"23-24"}],"citation":"John 14:13-14; John 16:23-24."},{"id":"2N.8","text":"Do not be theatrical or showy when you pray, for it is better to make your prayer in secret.","refs":[{"book":"Matthew","chapter":6,"verses":"5-6"},{"book":"Luke","chapter":20,"verses":"47"}],"citation":"Matt. 6:5-6; Luke 20:47."},{"id":"2N.9","text":"Your requests and needs are to be made known to God by prayer and supplication.","refs":[{"book":"Philippians","chapter":4,"verses":"6"}],"citation":"Phil. 4:6."},{"id":"2N.10","text":"We are not to have vain repetitions in prayer.","refs":[{"book":"Matthew","chapter":6,"verses":"7"}],"citation":"Matt. 6:7."},{"id":"2N.11","text":"Prayers not answered to those who ask with wrong motives so as to satisfy personal pleasures.","refs":[{"book":"James","chapter":4,"verses":"3"}],"citation":"James 4:3."},{"id":"2N.12","text":"Prayers of intercession to be made on behalf of others.","refs":[{"book":"Exodus","chapter":32,"verses":"31-32"},{"book":"Exodus","chapter":34,"verses":"8-9"},{"book":"2 Chronicles","chapter":30,"verses":"18-20"},{"book":"Luke","chapter":22,"verses":"31-32"},{"book":"Acts","chapter":12,"verses":"5"},{"book":"Ephesians","chapter":1,"verses":"15-16"},{"book":"2 Timothy","chapter":1,"verses":"3"}],"citation":"Exod. 32:31-32; Exod. 34:8-9; 2 Chron. 30:18-20; Luke 22:31-32; Acts 12:5; Eph. 1:15-16; 2 Tim. 1:3."},{"id":"2N.13","text":"All things which you ask in prayer, believing, you shall receive.","refs":[{"book":"Matthew","chapter":7,"verses":"7-11"},{"book":"Matthew","chapter":21,"verses":"22"},{"book":"Mark","chapter":11,"verses":"24"},{"book":"Luke","chapter":11,"verses":"9-13"}],"citation":"Matt. 7:7-11; Matt. 21:22; Mark 11:24; Luke 11:9-13."},{"id":"2N.14","text":"God will not hear the prayers of a wicked people.","refs":[{"book":"Isaiah","chapter":1,"verses":"15"}],"citation":"Isa. 1: 15."},{"id":"2N.15","text":"Prayer regarded as an abomination and rejected by God from those who hear not the law.","refs":[{"book":"Proverbs","chapter":28,"verses":"9"},{"book":"Zechariah","chapter":7,"verses":"11-13"}],"citation":"Prov. 28:9; Zech. 7:11-13."},{"id":"2N.16","text":"Be not hasty to utter anything before God, therefore it is better that your words be few.","refs":[{"book":"Ecclesiastes","chapter":5,"verses":"2"}],"citation":"Eccl. 5:2."},{"id":"2N.17","text":"The manner of prayer commanded by Christ (The Lord's Prayer).","refs":[{"book":"Matthew","chapter":6,"verses":"9-15"},{"book":"Luke","chapter":11,"verses":"2-4"}],"citation":"Matt. 6:9-15; Luke 11:2-4."},{"id":"2N.18","text":"Prayer to be without wrath and doubting.","refs":[{"book":"1 Timothy","chapter":2,"verses":"8"}],"citation":"1 Tim. 2:8."},{"id":"2N.19","text":"Pray to be restored from backsliding.","refs":[{"book":"Psalms","chapter":80,"verses":"3"},{"book":"Psalms","chapter":85,"verses":"4"},{"book":"Lamentations","chapter":5,"verses":"21"}],"citation":"Psa. 80:3; Psa. 85:4; Lam. 5:21."},{"id":"2N.20","text":"Prayer required for forgiveness of iniquities.","refs":[{"book":"2 Samuel","chapter":24,"verses":"10"},{"book":"2 Chronicles","chapter":7,"verses":"14"},{"book":"Psalms","chapter":25,"verses":"11"},{"book":"Psalms","chapter":51,"verses":"1-4"},{"book":"Jeremiah","chapter":14,"verses":"7"}],"citation":"2 Sam. 24:10; 2 Chron. 7:14; Psa. 25:11; Psa. 51:1-4; Jer. 14:7."}]}