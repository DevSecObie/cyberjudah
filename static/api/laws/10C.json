{"id":"10C","title":"Kidnapping","part":{"n":10,"title":"Capital laws & offenses"},"url":"/law/10-capital-laws-offenses/10c","entries":[{"id":"10C.1","text":"He that kidnaps a man, whether he sells him or he is found in his possession, he shall be put to death.","refs":[{"book":"Exodus","chapter":21,"verses":"16"},{"book":"Deuteronomy","chapter":24,"verses":"7"}],"citation":"Exod. 21:16; Deut. 24:7."}]}