{"id":"14F","title":"Personal Health and Hygiene","part":{"n":14,"title":"Food and health laws"},"url":"/law/14-food-and-health-laws/14f","entries":[{"id":"14F.1","text":"You are not to disfigure your body by making any cuttings in your flesh or tattoo marks in your skin.","refs":[{"book":"Leviticus","chapter":19,"verses":"28"},{"book":"Leviticus","chapter":21,"verses":"5"},{"book":"Deuteronomy","chapter":14,"verses":"1"}],"citation":"Lev. 19:28; Lev. 21:5; Deut. 14:1."},{"id":"14F.2","text":"God promises health and to heal sickness of those who will pray to Him for it.","refs":[{"book":"2 Kings","chapter":20,"verses":"5"},{"book":"Psalms","chapter":30,"verses":"2"},{"book":"Jeremiah","chapter":17,"verses":"14"}],"citation":"2 Kings 20:5; Psa. 30:2; Jer. 17:14."},{"id":"14F.3","text":"We are to praise God for recovery from sickness.","refs":[{"book":"Psalms","chapter":103,"verses":"1-3"},{"book":"Luke","chapter":17,"verses":"15-19"},{"book":"Acts","chapter":3,"verses":"7-8"}],"citation":"Psa. 103:1-3; Luke 17:15-19; Acts 3:7-8."},{"id":"14F.4","text":"You shall touch no unclean thing, nor touch the carcass of any unclean beast.","refs":[{"book":"Leviticus","chapter":11,"verses":"26,31"},{"book":"Isaiah","chapter":52,"verses":"11"}],"citation":"Lev. 11:26, 31; Isa. 52:11."},{"id":"14F.5","text":"Cleansing of a woman after child birth.","refs":[{"book":"Leviticus","chapter":12,"verses":"1-8"}],"citation":"Lev. 12:1-8."},{"id":"14F.6","text":"Laws concerning women during menstruation.","refs":[{"book":"Leviticus","chapter":15,"verses":"19-33"}],"citation":"Lev. 15:19-33."},{"id":"14F.7","text":"Pregnant women are not to take alcoholic drink.","refs":[{"book":"Judges","chapter":13,"verses":"3-42"},{"book":"1 Samuel","chapter":1,"verses":"15"}],"citation":"Judges 13:3-42 77 14; 1 Sam. 1:15."},{"id":"14F.8","text":"Laws concerning bodily discharges and cleansing.","refs":[{"book":"Leviticus","chapter":15,"verses":"1-18"}],"citation":"Lev. 15:1-18."},{"id":"14F.9","text":"All male children born are to be circumcised on the eighth day after birth.","refs":[{"book":"Genesis","chapter":17,"verses":"10-14"},{"book":"Genesis","chapter":21,"verses":"4"},{"book":"Exodus","chapter":12,"verses":"48"},{"book":"Leviticus","chapter":12,"verses":"3"},{"book":"Luke","chapter":1,"verses":"59"},{"book":"Luke","chapter":2,"verses":"21"},{"book":"Acts","chapter":7,"verses":"8"},{"book":"Philippians","chapter":3,"verses":"5"}],"citation":"Gen. 17:10-14; Gen. 21:4; Exod. 12:48; Lev. 12:3; Luke 1:59; Luke 2:21; Acts 7:8; Phil. 3:5."}]}