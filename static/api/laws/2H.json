{"id":"2H","title":"Obedience and Submission","part":{"n":2,"title":"Relationship to God"},"url":"/law/02-relationship-to-god/2h","entries":[{"id":"2H.1","text":"You shall obey the voice of the LORD your God.","refs":[{"book":"Exodus","chapter":15,"verses":"26"},{"book":"Deuteronomy","chapter":13,"verses":"4"},{"book":"Deuteronomy","chapter":27,"verses":"10"},{"book":"Deuteronomy","chapter":30,"verses":"2,10,20"},{"book":"Joshua","chapter":24,"verses":"24"},{"book":"1 Samuel","chapter":12,"verses":"14"},{"book":"Jeremiah","chapter":7,"verses":"23"},{"book":"Jeremiah","chapter":26,"verses":"13"}],"citation":"Exod. 15:26; Deut 13:4; Deut 27:10; Deut 30:2, 10, 20; Josh. 24:24; 1 Sam. 12:14; Jer. 7:23; Jer. 26:13."},{"id":"2H.2","text":"Submit yourselves to God.","refs":[{"book":"James","chapter":4,"verses":"7"}],"citation":"James 4:7."},{"id":"2H.3","text":"Disobedience to God causes national captivity by heathen or enemy nations.","refs":[{"book":"Judges","chapter":3,"verses":"7-8"},{"book":"Judges","chapter":6,"verses":"1-2"},{"book":"Judges","chapter":10,"verses":"6-7"},{"book":"Judges","chapter":13,"verses":"1"},{"book":"Nehemiah","chapter":9,"verses":"26"}],"citation":"Judges 3:7-8; Judges 6:1-2; Judges 10:6-7; Judges 13:1; Neh. 9:26."},{"id":"2H.4","text":"Obedience to God required by walking in His ways and by keeping His commandments.","refs":[{"book":"Deuteronomy","chapter":10,"verses":"12-13"},{"book":"Deuteronomy","chapter":11,"verses":"8"},{"book":"Deuteronomy","chapter":28,"verses":"1"},{"book":"Joshua","chapter":22,"verses":"5"},{"book":"1 Samuel","chapter":12,"verses":"14"},{"book":"1 Kings","chapter":2,"verses":"3"},{"book":"Ephesians","chapter":5,"verses":"1"}],"citation":"Deut. 10:12-13; Deut. 11:8; Deut 28:1; Josh. 22:5; 1 Sam. 12:14; 1 Kings 2:3; Eph. 5:1."},{"id":"2H.5","text":"We are to be obedient to the faith.","refs":[{"book":"Acts","chapter":6,"verses":"7"},{"book":"Romans","chapter":1,"verses":"5"}],"citation":"Acts 6:7; Rom. 1:5."},{"id":"2H.6","text":"Blessed are those who hear the word of God and keep it.","refs":[{"book":"Luke","chapter":11,"verses":"28"}],"citation":"Luke 11:28."},{"id":"2H.7","text":"Circumcise the foreskin of your heart, and be stiff-necked no longer.","refs":[{"book":"Deuteronomy","chapter":10,"verses":"16"},{"book":"Jeremiah","chapter":4,"verses":"4"}],"citation":"Deut. 10:16; Jer. 4:4."},{"id":"2H.8","text":"We ought to obey God rather than men.","refs":[{"book":"Acts","chapter":5,"verses":"29"}],"citation":"Acts 5:29."},{"id":"2H.9","text":"To him who knows to do good and does not do it, to him it is sin.","refs":[{"book":"James","chapter":4,"verses":"17"}],"citation":"James 4:17."},{"id":"2H.10","text":"As servants of God you are to obey God.","refs":[{"book":"Romans","chapter":6,"verses":"16"}],"citation":"Rom. 6:16."},{"id":"2H.11","text":"To be obedient to God we are to be doers of His word and not hearers only.","refs":[{"book":"James","chapter":1,"verses":"22-25"}],"citation":"James 1:22-25."},{"id":"2H.12","text":"It is not sufficient to call on the name of Christ, but to do the things which He says.","refs":[{"book":"Luke","chapter":6,"verses":"46"}],"citation":"Luke 6:46."}]}