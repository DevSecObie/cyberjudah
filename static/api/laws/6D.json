{"id":"6D","title":"Education of Children","part":{"n":6,"title":"Family law & relationships"},"url":"/law/06-family-law-relationships/6d","entries":[{"id":"6D.1","text":"Parents should see that children are educated and instructed in the ways and laws of God.","refs":[{"book":"Genesis","chapter":18,"verses":"19"},{"book":"Deuteronomy","chapter":4,"verses":"9-10"},{"book":"Deuteronomy","chapter":6,"verses":"6-9"},{"book":"Deuteronomy","chapter":11,"verses":"18-20"},{"book":"Deuteronomy","chapter":31,"verses":"12,13"},{"book":"Joshua","chapter":22,"verses":"24-27"},{"book":"Psalms","chapter":78,"verses":"1-7"},{"book":"Joel","chapter":1,"verses":"3"},{"book":"Ephesians","chapter":6,"verses":"4"}],"citation":"Gen. 18:19; Deut 4:9-10; Deut 6:6-9; Deut 11:18-20; Deut 31:12,13; Josh. 22:24-27; Psa. 78:1-7; Joel 1:3; Eph. 6:4."},{"id":"6D.2","text":"Children to be taught to fear God.","refs":[{"book":"Psalms","chapter":34,"verses":"11"}],"citation":"Psa. 34:11."},{"id":"6D.3","text":"Bible stories and illustrations, and the works of God, are to be taught to each generation.","refs":[{"book":"Exodus","chapter":10,"verses":"2"},{"book":"Exodus","chapter":12,"verses":"25-27"},{"book":"Exodus","chapter":13,"verses":"14"},{"book":"Deuteronomy","chapter":6,"verses":"20-25"},{"book":"Joshua","chapter":4,"verses":"22"},{"book":"Psalms","chapter":78,"verses":"4-6"}],"citation":"Exod. 10:2; Exod. 12:25-27; Exod. 13:14; Deut. 6:20-25; Josh. 4:22; Psa. 78:4-6."},{"id":"6D.4","text":"Train up a child in the way he should go, and when he is old, he will not depart from it.","refs":[{"book":"Proverbs","chapter":22,"verses":"6"}],"citation":"Prov. 22:6."},{"id":"6D.5","text":"Education to be by right examples.","refs":[{"book":"Proverbs","chapter":20,"verses":"7"},{"book":"2 Timothy","chapter":1,"verses":"5"}],"citation":"Prov. 20:7; 2 Tim. 1:5."},{"id":"6D.6","text":"Reproofs for discipline to be given to the young to keep them from immoral temptations and lusts.","refs":[{"book":"Proverbs","chapter":6,"verses":"23-29"},{"book":"Proverbs","chapter":7,"verses":"4-5"}],"citation":"Prov. 6:23-29; Prov. 7:4-5."}]}