{"id":"17G","title":"Pride","part":{"n":17,"title":"Personal character traits"},"url":"/law/17-personal-character-traits/17g","entries":[{"id":"17G.1","text":"Pride is a sin and is hateful to God.","refs":[{"book":"Proverbs","chapter":6,"verses":"16-17"},{"book":"Proverbs","chapter":16,"verses":"5"},{"book":"Proverbs","chapter":21,"verses":"4,24"},{"book":"Isaiah","chapter":23,"verses":"9"},{"book":"Jeremiah","chapter":50,"verses":"31-32"}],"citation":"Prov. 6:16-17; Prov. 16:5; Prov. 21:4, 24; Isa. 23:9; Jer. 50:31-32."},{"id":"17G.2","text":"Pride is not of God but is of the world.","refs":[{"book":"1 John","chapter":2,"verses":"26"}],"citation":"1 John 2:26."},{"id":"17G.3","text":"The inexperienced tend to be filled with pride.","refs":[{"book":"1 Timothy","chapter":3,"verses":"6"}],"citation":"1 Tim. 3:6."},{"id":"17G.4","text":"Through pride the wicked will not seek after or acknowledge God.","refs":[{"book":"Psalms","chapter":10,"verses":"4"}],"citation":"Psa. 10:4."},{"id":"17G.5","text":"Pride causes contention and stirs up strife.","refs":[{"book":"Proverbs","chapter":13,"verses":"10"},{"book":"Proverbs","chapter":28,"verses":"25"}],"citation":"Prov. 13:10; Prov. 28:25."},{"id":"17G.6","text":"We are not to respect those that are proud.","refs":[{"book":"Psalms","chapter":40,"verses":"4"},{"book":"Psalms","chapter":101,"verses":"5"}],"citation":"Psa. 40:4; Psa. 101:5."},{"id":"17G.7","text":"Pride defiles a man.","refs":[{"book":"Mark","chapter":7,"verses":"20,22"}],"citation":"Mark 7:20, 22."},{"id":"17G.8","text":"Beware of those that are proud.","refs":[{"book":"2 Timothy","chapter":3,"verses":"2"}],"citation":"2 Tim. 3:2."},{"id":"17G.9","text":"Pride and arrogance are contrary to wisdom.","refs":[{"book":"Proverbs","chapter":8,"verses":"12-13"}],"citation":"Prov. 8:12-13."},{"id":"17G.10","text":"The pride of your heart will deceive you.","refs":[{"book":"Obadiah","chapter":1,"verses":"3"}],"citation":"Obad. 1:3."},{"id":"17G.11","text":"Pride and arrogance is reproved and forbidden.","refs":[{"book":"Exodus","chapter":18,"verses":"11"},{"book":"1 Samuel","chapter":2,"verses":"3"},{"book":"Matthew","chapter":23,"verses":"12"},{"book":"Romans","chapter":12,"verses":"3"}],"citation":"Exod. 18:11; 1 Sam. 2:3; Matt. 23:12; Rom. 12:3."},{"id":"17G.12","text":"Pride stems from the possession of wealth and power.","refs":[{"book":"Leviticus","chapter":26,"verses":"19"},{"book":"2 Kings","chapter":20,"verses":"13"},{"book":"Ezekiel","chapter":30,"verses":"6"}],"citation":"Lev. 26:19; 2 Kings 20:13; Ezek. 30:6."},{"id":"17G.13","text":"Pride and arrogance brings decline, punishment and destruction.","refs":[{"book":"2 Samuel","chapter":22,"verses":"28"},{"book":"Psalms","chapter":18,"verses":"27"},{"book":"Proverbs","chapter":16,"verses":"18"},{"book":"Proverbs","chapter":18,"verses":"12"},{"book":"Isaiah","chapter":2,"verses":"11-17"},{"book":"Isaiah","chapter":3,"verses":"16-17"},{"book":"Isaiah","chapter":13,"verses":"11"},{"book":"Isaiah","chapter":28,"verses":"1,3"},{"book":"Jeremiah","chapter":13,"verses":"9"},{"book":"Hosea","chapter":5,"verses":"5"},{"book":"Zephaniah","chapter":2,"verses":"10-11"},{"book":"Malachi","chapter":4,"verses":"1"},{"book":"Luke","chapter":1,"verses":"51"}],"citation":"2 Sam. 22:28; Psa. 18:27; Prov. 16:18; Prov. 18:12; Isa. 2:11-17; Isa. 3:16-17; Isa. 13:11; Isa. 28:1, 3; Jer. 13:9; Hos. 5:5; Zeph. 2:10-11; Mal. 4:1; Luke 1:51."},{"id":"17G.14","text":"From out of the heart proceeds pride.","refs":[{"book":"Mark","chapter":7,"verses":"21-22"}],"citation":"Mark 7:21-22."},{"id":"17G.15","text":"Those who are rich are not to be haughty.","refs":[{"book":"1 Timothy","chapter":6,"verses":"17"}],"citation":"1 Tim. 6:17."},{"id":"17G.16","text":"Beware of those that are haughty.","refs":[{"book":"2 Timothy","chapter":3,"verses":"4"}],"citation":"2 Tim. 3:4."},{"id":"17G.17","text":"A haughty look or attitude is regarded as a sin.","refs":[{"book":"Proverbs","chapter":21,"verses":"4,24"}],"citation":"Prov. 21:4, 24."},{"id":"17G.18","text":"Do not endure one who has a haughty look and a proud heart.","refs":[{"book":"Psalms","chapter":10,"verses":""}],"citation":"Psa. 10 1: 5."},{"id":"17G.19","text":"A haughty heart leads to destruction.","refs":[{"book":"Proverbs","chapter":18,"verses":"12"}],"citation":"Prov. 18:12."}]}