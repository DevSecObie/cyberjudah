{"id":"3J","title":"Fraud and Deceit","part":{"n":3,"title":"Relationship to Other Persons"},"url":"/law/03-relationship-to-other-persons/3j","entries":[{"id":"3J.1","text":"We are forbidden to defraud our neighbor or brethren.","refs":[{"book":"Leviticus","chapter":19,"verses":"13"},{"book":"Mark","chapter":10,"verses":"19"},{"book":"1 Corinthians","chapter":6,"verses":"8"}],"citation":"Lev. 19:Mark 10: 1 Cor 6:8."},{"id":"3J.2","text":"No one should defraud his brother regarding the matter of lust and sexual immorality.","refs":[{"book":"1 Thessalonians","chapter":4,"verses":"3-7"}],"citation":"1 Thes. 4:3-7."},{"id":"3J.3","text":"Do not let those who work deceit dwell within your house.","refs":[{"book":"Psalms","chapter":101,"verses":"7"}],"citation":"Psa. 101:7."},{"id":"3J.4","text":"Deceive not with your lips.","refs":[{"book":"Proverbs","chapter":24,"verses":"28"}],"citation":"Prov. 24:28."},{"id":"3J.5","text":"Beware of those that serve not our Lord Jesus Christ, for by their good words and flattering speech they deceive the hearts of the unsuspecting.","refs":[{"book":"Romans","chapter":16,"verses":"18"}],"citation":"Rom. 16:18."},{"id":"3J.6","text":"You shall not deal falsely or treacherously with your brethren.","refs":[{"book":"Leviticus","chapter":19,"verses":"11"},{"book":"Proverbs","chapter":3,"verses":"27-29"},{"book":"Isaiah","chapter":33,"verses":"1"},{"book":"Malachi","chapter":2,"verses":"10"}],"citation":"Lev. 19:11; Prov. 3:27-29; Isa. 33: 1; Mal. 2:10."},{"id":"3J.7","text":"You shall not keep back the wages due a hired laborer by fraud.","refs":[{"book":"James","chapter":5,"verses":"4"}],"citation":"James 5:4."},{"id":"3J.8","text":"Deceit is falsehood.","refs":[{"book":"Psalms","chapter":119,"verses":"118"}],"citation":"Psa. 119:118."},{"id":"3J.9","text":"Keep your lips from speaking guile.","refs":[{"book":"Psalms","chapter":34,"verses":"13"}],"citation":"Psa. 34:13."},{"id":"3J.10","text":"Take heed that no man deceive you regarding the Gospel.","refs":[{"book":"Matthew","chapter":24,"verses":"4"},{"book":"Mark","chapter":13,"verses":"5-6"},{"book":"Colossians","chapter":2,"verses":"18"}],"citation":"Matt. 24:4; Mark 13:5- 6; Col. 2:18."},{"id":"3J.11","text":"God abhors a deceitful man.","refs":[{"book":"Psalms","chapter":5,"verses":"6"},{"book":"1 Peter","chapter":3,"verses":"10"}],"citation":"Psa. 5:6; 1 Pet 3:10."},{"id":"3J.12","text":"Deceit and fraud a characteristic of the wicked.","refs":[{"book":"Psalms","chapter":10,"verses":"4,7"}],"citation":"Psa. 10:4, 7."},{"id":"3J.13","text":"The saints are to be free from deceit and avoid such practices.","refs":[{"book":"Job","chapter":31,"verses":"5"},{"book":"Psalms","chapter":24,"verses":"4"},{"book":"Zephaniah","chapter":3,"verses":"13"},{"book":"Revelation","chapter":14,"verses":"5"}],"citation":"Job 31:5; Psa. 24:4; Zeph. 3:13; Rev. 14:5."},{"id":"3J.14","text":"Let no one deceive you by any means that would cause you to depart from the faith.","refs":[{"book":"2 Thessalonians","chapter":2,"verses":"3"},{"book":"1 Timothy","chapter":4,"verses":"1-3"}],"citation":"2 Thes. 2:3; 1 Tim. 4:1-3."},{"id":"3J.15","text":"Punishment will come to those who attempt to gain by deceit.","refs":[{"book":"Proverbs","chapter":20,"verses":"17"}],"citation":"Prov. 20:17."},{"id":"3J.16","text":"Deceive not yourself regarding the ways and prophesies of God.","refs":[{"book":"Jeremiah","chapter":37,"verses":"9"},{"book":"James","chapter":1,"verses":"26"}],"citation":"Jer. 37:9; James 1:26."}]}