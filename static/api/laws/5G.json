{"id":"5G","title":"Prohibited Marriages","part":{"n":5,"title":"Marriage and Divorce"},"url":"/law/05-marriage-and-divorce/5g","entries":[{"id":"5G.1","text":"With father or mother.","refs":[{"book":"Leviticus","chapter":18,"verses":"7-8"},{"book":"Leviticus","chapter":20,"verses":"11"},{"book":"Deuteronomy","chapter":22,"verses":"30"},{"book":"Deuteronomy","chapter":27,"verses":"20"}],"citation":"Lev. 18:7-8; Lev. 20:11; Deut. 22:30; Deut. 27:20."},{"id":"5G.2","text":"With one's sister or half-sister.","refs":[{"book":"Leviticus","chapter":18,"verses":"9,11"},{"book":"Leviticus","chapter":20,"verses":"17"},{"book":"Deuteronomy","chapter":27,"verses":"22"},{"book":"Ezekiel","chapter":22,"verses":"11"}],"citation":"Lev. 18:9, 11; Lev. 20:17; Deut. 27:22; Ezek. 22:11."},{"id":"5G.3","text":"With one's mother-in-law.","refs":[{"book":"Deuteronomy","chapter":27,"verses":"23"}],"citation":"Deut. 27:23."},{"id":"5G.4","text":"With a grandchild.","refs":[{"book":"Leviticus","chapter":18,"verses":"10"}],"citation":"Lev. 18:10."},{"id":"5G.5","text":"With one's aunt.","refs":[{"book":"Leviticus","chapter":18,"verses":"12-14"},{"book":"Leviticus","chapter":20,"verses":"19"}],"citation":"Lev. 18:12-14; Lev. 20:19."},{"id":"5G.6","text":"With one's uncle or uncle's wife.","refs":[{"book":"Leviticus","chapter":18,"verses":"14"},{"book":"Leviticus","chapter":20,"verses":"20"}],"citation":"Lev. 18:14; Lev. 20:20."},{"id":"5G.7","text":"With one's daughter-in-law.","refs":[{"book":"Leviticus","chapter":18,"verses":"15"},{"book":"Leviticus","chapter":20,"verses":"12"},{"book":"Ezekiel","chapter":22,"verses":"11"}],"citation":"Lev. 18:15; Lev. 20:12; Ezek. 22:11."},{"id":"5G.8","text":"With your brother's wife.","refs":[{"book":"Leviticus","chapter":18,"verses":"16"},{"book":"Leviticus","chapter":20,"verses":"21"}],"citation":"Lev. 18:16; Lev. 20:21."},{"id":"5G.9","text":"With a woman and her daughter or her grand daughter.","refs":[{"book":"Leviticus","chapter":18,"verses":"17"},{"book":"Leviticus","chapter":20,"verses":"14"}],"citation":"Lev. 18:17; Lev. 20:14."},{"id":"5G.10","text":"With two women who are sisters.","refs":[{"book":"Leviticus","chapter":18,"verses":"18"}],"citation":"Lev. 18:18."},{"id":"5G.11","text":"With thy neighbor's wife.","refs":[{"book":"Leviticus","chapter":18,"verses":"20"},{"book":"Leviticus","chapter":20,"verses":"10"},{"book":"Ezekiel","chapter":22,"verses":"11"}],"citation":"Lev. 18:20; Lev. 20:10; Ezek. 22:11."},{"id":"5G.12","text":"We are not to intermarry with those who practice idolatry.","refs":[{"book":"Exodus","chapter":34,"verses":"16"},{"book":"Deuteronomy","chapter":7,"verses":"3"}],"citation":"Exod. 34:16; Deut 7:3."},{"id":"5G.13","text":"We are not to marry unbelievers.","refs":[{"book":"2 Corinthians","chapter":6,"verses":"14-17"}],"citation":"2 Cor. 6:14-17."},{"id":"5G.14","text":"We are not to marry those of other races.","refs":[{"book":"Genesis","chapter":28,"verses":"6"},{"book":"Exodus","chapter":34,"verses":"15-16"},{"book":"Numbers","chapter":25,"verses":"6-11"},{"book":"Deuteronomy","chapter":7,"verses":"1-3"},{"book":"Joshua","chapter":23,"verses":"12-13"},{"book":"Judges","chapter":3,"verses":"5-8"},{"book":"1 Kings","chapter":11,"verses":"1-2"},{"book":"Ezra","chapter":9,"verses":"1-2,12"},{"book":"Ezra","chapter":10,"verses":"2-3,10-11"},{"book":"Nehemiah","chapter":10,"verses":"30"},{"book":"Nehemiah","chapter":13,"verses":"25-27"}],"citation":"Gen. 28:6; Exod. 34:15-16; Num. 25:6-11; Deut. 7:1-3; Josh. 23:12-13; Judges 3:5-8; 1 Kings 11:1-2; Ezra 9:1- 2, 12; Ezra 10:2-3, 10-11; Neh. 10:30; Neh. 13:25-27."}]}