{"id":"17J","title":"Slothfulness","part":{"n":17,"title":"Personal character traits"},"url":"/law/17-personal-character-traits/17j","entries":[{"id":"17J.1","text":"Slothfulness brings one into bondage.","refs":[{"book":"Proverbs","chapter":12,"verses":"24"}],"citation":"Prov. 12:24."},{"id":"17J.2","text":"Slothfulness magnifies obstacles.","refs":[{"book":"Proverbs","chapter":10,"verses":"26"},{"book":"Proverbs","chapter":15,"verses":"19"},{"book":"Proverbs","chapter":22,"verses":"13"}],"citation":"Prov. 10:26; Prov. 15:19; Prov. 22:13."},{"id":"17J.3","text":"If any would not work, neither should he eat.","refs":[{"book":"2 Thessalonians","chapter":3,"verses":"10"}],"citation":"2 Thes. 3:10."},{"id":"17J.4","text":"Slothfulness brings hardship and destruction.","refs":[{"book":"Proverbs","chapter":21,"verses":"25"}],"citation":"Prov. 21:25."},{"id":"17J.5","text":"Slothfulness and idleness leads to want, poverty and hunger.","refs":[{"book":"Proverbs","chapter":6,"verses":"6-11"},{"book":"Proverbs","chapter":10,"verses":"4"},{"book":"Proverbs","chapter":13,"verses":"4"},{"book":"Proverbs","chapter":18,"verses":"9"},{"book":"Proverbs","chapter":19,"verses":"15"},{"book":"Proverbs","chapter":24,"verses":"30-34"},{"book":"Ecclesiastes","chapter":10,"verses":"18"}],"citation":"Prov. 6:6-11; Prov. 10:4; Prov. 13:4; Prov. 18:9; Prov. 19:15; Prov. 24:30-34; Eccl. 10:18."},{"id":"17J.6","text":"Exhortations against slothfulness.","refs":[{"book":"Proverbs","chapter":6,"verses":"4"},{"book":"Proverbs","chapter":26,"verses":"13-16"},{"book":"Romans","chapter":13,"verses":"11"},{"book":"1 Thessalonians","chapter":5,"verses":"6"},{"book":"Hebrews","chapter":6,"verses":"12"}],"citation":"Prov. 6:4; Prov. 26:13-16; Rom. 13:11; 1 Thes. 5:6; Heb. 6:12."},{"id":"17J.7","text":"Be not slothful in business.","refs":[{"book":"Romans","chapter":12,"verses":"11"}],"citation":"Rom. 12:11."},{"id":"17J.8","text":"We are not to give false excuses for being slothful.","refs":[{"book":"Proverbs","chapter":20,"verses":"4,13"},{"book":"Proverbs","chapter":26,"verses":"13-16"}],"citation":"Prov.20:4, 13; Prov. 26:13- 16."}]}