{"id":"14E","title":"Fasting","part":{"n":14,"title":"Food and health laws"},"url":"/law/14-food-and-health-laws/14e","entries":[{"id":"14E.1","text":"Fast observed on occasions of judgments of God.","refs":[{"book":"Joel","chapter":1,"verses":"14"},{"book":"Joel","chapter":2,"verses":"12"}],"citation":"Joel 1: 14; Joel 2:12."},{"id":"14E.2","text":"Fasting is not to be made a subject of display.","refs":[{"book":"Matthew","chapter":6,"verses":"16-18"}],"citation":"Matt. 6:16-18."},{"id":"14E.3","text":"Fasting is to be unto God.","refs":[{"book":"Zechariah","chapter":7,"verses":"5"},{"book":"Matthew","chapter":6,"verses":"18"}],"citation":"Zech. 7:5; Matt. 6:18."},{"id":"14E.4","text":"Fasting for private afflictions.","refs":[{"book":"2 Samuel","chapter":12,"verses":"16"}],"citation":"2 Sam. 12:16."},{"id":"14E.5","text":"You shall 'afflict your souls' (fast) on the Day of Atonement.","refs":[{"book":"Leviticus","chapter":16,"verses":"29,31"},{"book":"Leviticus","chapter":23,"verses":"27,29"}],"citation":"Lev. 16:29, 31; Lev. 23:27, 29."},{"id":"14E.6","text":"Fasting accompanied by confession of sin.","refs":[{"book":"1 Samuel","chapter":7,"verses":"6"},{"book":"Nehemiah","chapter":9,"verses":"1-2"}],"citation":"1 Sam. 7:6; Neh. 9:1-2."},{"id":"14E.7","text":"Public fasts proclaimed.","refs":[{"book":"1 Kings","chapter":21,"verses":"9"},{"book":"Ezra","chapter":8,"verses":"21"},{"book":"Zechariah","chapter":8,"verses":"19"}],"citation":"1 Kings 21:9; Ezra 8:21; Zech. 8:19."},{"id":"14E.8","text":"Fasting accompanied by prayer.","refs":[{"book":"Ezra","chapter":8,"verses":"23"},{"book":"Daniel","chapter":9,"verses":"3"},{"book":"Matthew","chapter":17,"verses":"21"}],"citation":"Ezra 8:23; Dan. 9:3.; Matt. 17:21."}]}