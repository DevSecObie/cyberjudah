{"id":"6A","title":"Parent responsibility","part":{"n":6,"title":"Family law & relationships"},"url":"/law/06-family-law-relationships/6a","entries":[{"id":"6A.1","text":"Children are a gift and heritage from God, and thus are to be asked of from God.","refs":[{"book":"Genesis","chapter":25,"verses":"21"},{"book":"Genesis","chapter":30,"verses":"17"},{"book":"Genesis","chapter":33,"verses":"5"},{"book":"Deuteronomy","chapter":28,"verses":"4"},{"book":"Ruth","chapter":4,"verses":"13"},{"book":"Psalms","chapter":127,"verses":"3"}],"citation":"Gen. 25:21; Gen. 30:17; Gen. 33:5; Deut. 28:4; Ruth 4:13; Psa. 127:3."},{"id":"6A.2","text":"Parents are to love their children.","refs":[{"book":"Titus","chapter":2,"verses":"4"}],"citation":"Titus 2:4."},{"id":"6A.3","text":"Parents should pray for and bless their children.","refs":[{"book":"Genesis","chapter":48,"verses":"9,15"},{"book":"2 Samuel","chapter":12,"verses":"16"},{"book":"1 Chronicles","chapter":29,"verses":"19"},{"book":"Job","chapter":1,"verses":"5"},{"book":"Mark","chapter":5,"verses":"23"},{"book":"John","chapter":4,"verses":"46-49"},{"book":"Hebrews","chapter":11,"verses":"20-21"}],"citation":"Gen. 48:9, 15; 2 Sam. 12:16; 1 Chron. 29:19; Job. 1:5; Mark 5:23; John 4:46-49; Heb. 11:20-21."},{"id":"6A.4","text":"Parents should sternly chastise and punish their children to put them on a righteous course - For he who spares the rod hates his son, but he who loves his son disciplines him diligently.","refs":[{"book":"Proverbs","chapter":3,"verses":"12"},{"book":"Proverbs","chapter":13,"verses":"24"},{"book":"Proverbs","chapter":19,"verses":"18"},{"book":"Proverbs","chapter":22,"verses":"15"},{"book":"Proverbs","chapter":23,"verses":"13-14"},{"book":"Proverbs","chapter":29,"verses":"15,17"},{"book":"Hebrews","chapter":12,"verses":"7"}],"citation":"Prov. 3:12; Prov. 13:24; Prov. 19:18; Prov. 22:15; Prov. 23:13-14; Prov. 29:15, 17; Heb. 12:7."},{"id":"6A.5","text":"Father to have authority over children.","refs":[{"book":"Deuteronomy","chapter":30,"verses":"3-5"},{"book":"1 Timothy","chapter":3,"verses":"4"}],"citation":"Deut. 30:3-5; 1 Tim. 3:4."},{"id":"6A.6","text":"The head of the house is to provide for the family.","refs":[{"book":"Job","chapter":42,"verses":"15"},{"book":"Luke","chapter":11,"verses":"11"},{"book":"2 Corinthians","chapter":12,"verses":"14"},{"book":"1 Timothy","chapter":5,"verses":"8"}],"citation":"Job 42:15; Luke 11:11; 2 Cor. 12:14; 1 Tim. 5:8."},{"id":"6A.7","text":"Parents are responsible to save up for their children's future.","refs":[{"book":"2 Corinthians","chapter":12,"verses":"14"}],"citation":"2 Cor. 12:14."},{"id":"6A.8","text":"Fathers are not to provoke children to anger.","refs":[{"book":"Ephesians","chapter":6,"verses":"4"},{"book":"Colossians","chapter":3,"verses":"21"}],"citation":"Eph. 6:4; Col. 3:21."},{"id":"6A.9","text":"Mothers are to be concerned about the ways of their household.","refs":[{"book":"Proverbs","chapter":31,"verses":"27"}],"citation":"Prov. 31:27."},{"id":"6A.10","text":"The sins of the fathers are visited on their children to the third and fourth generation.","refs":[{"book":"Exodus","chapter":20,"verses":"5"},{"book":"Exodus","chapter":34,"verses":"7"},{"book":"Isaiah","chapter":14,"verses":"20-21"},{"book":"Lamentations","chapter":5,"verses":"7"}],"citation":"Exod. 20:5; Exod. 34:7; Isa. 14:20-21; Lam. 5:7."}]}