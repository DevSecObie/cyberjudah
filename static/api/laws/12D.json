{"id":"12D","title":"Dress and Appearance","part":{"n":12,"title":"Etiquette and moral issues"},"url":"/law/12-etiquette-and-moral-issues/12d","entries":[{"id":"12D.1","text":"Women shall not wear men's clothing, nor shall a man put on women's clothing, this is an abomination to God.","refs":[{"book":"Deuteronomy","chapter":22,"verses":"5"}],"citation":"Deut. 22:5."},{"id":"12D.2","text":"We are not to wear a garment of mixed fabrics (e.g. wool and linen).","refs":[{"book":"Leviticus","chapter":19,"verses":"19"},{"book":"Deuteronomy","chapter":22,"verses":"11"}],"citation":"Lev. 19:19; Deut 22:11."},{"id":"12D.3","text":"Women are to wear modest apparel and should not have braided hair or adorn themselves with gold or fancy and costly array.","refs":[{"book":"Isaiah","chapter":3,"verses":"16-24"},{"book":"1 Timothy","chapter":2,"verses":"9"},{"book":"1 Peter","chapter":3,"verses":"3"}],"citation":"Isa. 3:16-24; 1 Tim. 2:9; 1 Pet 3:3."},{"id":"12D.4","text":"Clothes are to be washed before appearing in the sight of God.","refs":[{"book":"Exodus","chapter":19,"verses":"10-11"}],"citation":"Exod. 19:10-11."},{"id":"12D.5","text":"Whoever handles the carcass of unclean animals is to wash their clothes.","refs":[{"book":"Leviticus","chapter":11,"verses":"25"}],"citation":"Lev. 11:25."},{"id":"12D.6","text":"Long hair is a shame for men.","refs":[{"book":"1 Corinthians","chapter":11,"verses":"14"}],"citation":"1 Cor. 11: 14."},{"id":"12D.7","text":"Long hair is a glory for women.","refs":[{"book":"1 Corinthians","chapter":11,"verses":"15"}],"citation":"1 Cor. 11: 15."},{"id":"12D.8","text":"Nakedness is condemned.","refs":[{"book":"Genesis","chapter":9,"verses":"21-27"},{"book":"Isaiah","chapter":47,"verses":"3"},{"book":"Ezekiel","chapter":16,"verses":"36-37"},{"book":"Habakkuk","chapter":2,"verses":"15"}],"citation":"Gen. 9:21-27; Isa. 47:3; Ezek. 16:36-37; Hab. 2:15."}]}