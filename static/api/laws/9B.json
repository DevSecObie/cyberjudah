{"id":"9B","title":"Practices and Observances to Follow","part":{"n":9,"title":"Feasts and observances"},"url":"/law/09-feasts-and-observances/9b","entries":[{"id":"9B.1","text":"Anointing (inauguration ceremony) for new civil leader coming into office.","refs":[{"book":"1 Samuel","chapter":10,"verses":"1"},{"book":"1 Samuel","chapter":16,"verses":"12-13"},{"book":"1 Kings","chapter":1,"verses":"39"}],"citation":"1 Sam. 10:1; 1 Sam. 16:12-13; 1 Kings 1:39."},{"id":"9B.2","text":"The first born of man or animal to be dedicated to God.","refs":[{"book":"Exodus","chapter":13,"verses":"2,12"},{"book":"Exodus","chapter":34,"verses":"19-20"}],"citation":"Exod. 13:2,12; Exod. 34:19-20."},{"id":"9B.3","text":"Three times in a year all males shall appear before the God of Israel, and make an offering to provide for the feasts.","refs":[{"book":"Exodus","chapter":23,"verses":"14-17"},{"book":"Exodus","chapter":34,"verses":"23"},{"book":"Deuteronomy","chapter":16,"verses":"16"}],"citation":"Exod. 23:14-17; Exod. 34:23; Deut. 16:16."},{"id":"9B.4","text":"Be baptized every one of you in the name of Jesus Christ for the remission of sins.","refs":[{"book":"Acts","chapter":2,"verses":"38"},{"book":"Acts","chapter":8,"verses":"12"}],"citation":"Acts 2:38; Acts 8:12."},{"id":"9B.5","text":"Feasts to be published and proclaimed in all the cities and towns in the land.","refs":[{"book":"Nehemiah","chapter":8,"verses":"15"}],"citation":"Neh. 8:15."},{"id":"9B.6","text":"Partaking of Communion in remembrance of Christ and in celebration of the Lord's supper.","refs":[{"book":"Matthew","chapter":26,"verses":"26-29"},{"book":"Mark","chapter":14,"verses":"22-25"},{"book":"Luke","chapter":22,"verses":"17-19"},{"book":"1 Corinthians","chapter":10,"verses":"16"},{"book":"1 Corinthians","chapter":11,"verses":"23-26"}],"citation":"Matt. 26:26-29; Mark 14:22-25; Luke 22:17-19; 1 Cor. 10:16; 1 Cor. 11:23-26."}]}