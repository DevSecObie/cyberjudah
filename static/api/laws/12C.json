{"id":"12C","title":"Excessiveness & Indulgence","part":{"n":12,"title":"Etiquette and moral issues"},"url":"/law/12-etiquette-and-moral-issues/12c","entries":[{"id":"12C.1","text":"Seeking pleasures and lavish living is not Godly.","refs":[{"book":"Romans","chapter":13,"verses":"13"},{"book":"1 Timothy","chapter":5,"verses":"6"},{"book":"Titus","chapter":3,"verses":"3"},{"book":"Hebrews","chapter":11,"verses":"25"},{"book":"1 Peter","chapter":4,"verses":"3-4"}],"citation":"Rom. 13:13; 1 Tim. 5:6; Titus 3:3; Heb. 11:25; 1 Pet 4:3-4."},{"id":"12C.2","text":"Lovers of pleasure are brought into poverty.","refs":[{"book":"Proverbs","chapter":21,"verses":"17"},{"book":"Proverbs","chapter":23,"verses":"20-21"},{"book":"Luke","chapter":15,"verses":"13-14"}],"citation":"Prov. 21:17; Prov. 23:20-21; Luke 15:13-14."},{"id":"12C.3","text":"To seek mirth and pleasure is vanity.","refs":[{"book":"Ecclesiastes","chapter":2,"verses":"1,10-11"},{"book":"Jeremiah","chapter":7,"verses":"34"},{"book":"Jeremiah","chapter":16,"verses":"9"},{"book":"Hosea","chapter":2,"verses":"11"}],"citation":"Eccl. 2:1, 10-11; Jer. 7:34; Jer. 16:9; Hosea 2:11."},{"id":"12C.4","text":"Beware of those who are lovers of pleasure rather than lovers of God.","refs":[{"book":"2 Timothy","chapter":3,"verses":"4"}],"citation":"2 Tim. 3:4."},{"id":"12C.5","text":"We should display moderation.","refs":[{"book":"Philippians","chapter":4,"verses":"5"}],"citation":"Phil. 4:5."},{"id":"12C.6","text":"Gluttony and excessiveness is iniquity and leads to a carnal outlook on life.","refs":[{"book":"Isaiah","chapter":22,"verses":"13-14"},{"book":"Luke","chapter":12,"verses":"19-20"},{"book":"1 Corinthians","chapter":15,"verses":"32"}],"citation":"Isa. 22:13-14; Luke 12:19-20; 1 Cor. 15:32."},{"id":"12C.7","text":"It is wise to abstain from indulgences.","refs":[{"book":"Proverbs","chapter":28,"verses":"7"},{"book":"Ecclesiastes","chapter":7,"verses":"2-3"}],"citation":"Prov. 28:7; Eccl. 7:2-3."},{"id":"12C.8","text":"Avoid lasciviousness and wantonness or covetousness.","refs":[{"book":"Ephesians","chapter":4,"verses":"19"},{"book":"1 Peter","chapter":4,"verses":"3-4"},{"book":"2 Peter","chapter":2,"verses":"13-15"}],"citation":"Eph. 4:19; 1 Pet 4:3-4; 2 Pet 2:13-15."},{"id":"12C.9","text":"We are not to desire riches.","refs":[{"book":"Proverbs","chapter":23,"verses":"3-4"},{"book":"James","chapter":5,"verses":"1-5"}],"citation":"Prov. 23:3-4; James 5:1-5."},{"id":"12C.10","text":"Indulgence is a proof of folly.","refs":[{"book":"Ecclesiastes","chapter":7,"verses":"4"}],"citation":"Eccl. 7:4."}]}