{"id":"8D","title":"Obligations to Officers and Government","part":{"n":8,"title":"Government & civil officers"},"url":"/law/08-government-civil-officers/8d","entries":[{"id":"8D.1","text":"We should respect and give obedience to rulers and authorities who preside as God's ministers.","refs":[{"book":"Deuteronomy","chapter":17,"verses":"12-13"},{"book":"Joshua","chapter":1,"verses":"16-17"},{"book":"Romans","chapter":13,"verses":"1-7"},{"book":"Titus","chapter":3,"verses":"1"},{"book":"Hebrews","chapter":13,"verses":"17"},{"book":"1 Peter","chapter":2,"verses":"13-14,17"},{"book":"2 Peter","chapter":2,"verses":"10"}],"citation":"Deut. 17:12-13; Josh. 1:16-17; Rom. 13:1-7; Titus 3:1; Heb. 13:17; 1 Pet 2:13-14, 17; 2 Pet 2:10."},{"id":"8D.2","text":"Disobedience to government is justified when government requires an ungodly or unlawful act.","refs":[{"book":"Exodus","chapter":1,"verses":"15-20"},{"book":"Joshua","chapter":2,"verses":"1-18"}],"citation":"Exod. 1:15-20; Josh. 2:1-18."},{"id":"8D.3","text":"We should pray for civil leaders.","refs":[{"book":"Ezra","chapter":6,"verses":"10"},{"book":"1 Timothy","chapter":2,"verses":"1-2"}],"citation":"Ezra 6:10; 1 Tim. 2:1-2."},{"id":"8D.4","text":"It is not proper to despise government.","refs":[{"book":"2 Peter","chapter":2,"verses":"10"}],"citation":"2 Pet 2:10."},{"id":"8D.5","text":"Rebellion is justified by oppressive laws and taxes.","refs":[{"book":"2 Chronicles","chapter":10,"verses":"13-19"}],"citation":"2 Chron. 10:13-19."},{"id":"8D.6","text":"We should disregard laws prohibiting the gospel.","refs":[{"book":"Acts","chapter":4,"verses":"18-21"},{"book":"Acts","chapter":27,"verses":""}],"citation":"Acts 4:18-21; Acts 27-29."},{"id":"8D.7","text":"We should not rebel or cause insurrection against the established government.","refs":[{"book":"2 Samuel","chapter":20,"verses":"1-22"}],"citation":"2 Sam. 20:1-22."},{"id":"8D.8","text":"You shall not curse or speak evil of civil rulers or dignitaries.","refs":[{"book":"Exodus","chapter":22,"verses":"28"},{"book":"Acts","chapter":23,"verses":"5"},{"book":"2 Peter","chapter":2,"verses":"10"},{"book":"Jude","chapter":1,"verses":"8"}],"citation":"Exod. 22:28; Acts 23:5; 2 Pet. 2:10; Jude 1: 8."},{"id":"8D.9","text":"Submit to them that have civil authority.","refs":[{"book":"Hebrews","chapter":13,"verses":"17"},{"book":"1 Peter","chapter":2,"verses":"13-14"}],"citation":"Heb. 13:17; 1 Pet. 2:13-14."},{"id":"8D.10","text":"We are not to submit to human edicts when in conflict with Divine laws.","refs":[{"book":"Daniel","chapter":3,"verses":"10-18"},{"book":"Daniel","chapter":6,"verses":"7-23"},{"book":"Acts","chapter":4,"verses":"13-21"},{"book":"Acts","chapter":5,"verses":"16-32"}],"citation":"Dan. 3:10-18; Dan. 6:7-23; Acts 4:13-21; Acts 5:16-32."}]}