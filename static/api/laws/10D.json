{"id":"10D","title":"Witchcraft and Sorcery","part":{"n":10,"title":"Capital laws & offenses"},"url":"/law/10-capital-laws-offenses/10d","entries":[{"id":"10D.1","text":"A man or a woman with a familiar spirit or who is a wizard shall be put to death.","refs":[{"book":"Leviticus","chapter":20,"verses":"27"},{"book":"2 Kings","chapter":23,"verses":"24"}],"citation":"Lev. 20:27; 2 Kings 23:24."},{"id":"10D.2","text":"You are not to allow a witch or sorceress to live.","refs":[{"book":"Exodus","chapter":22,"verses":"18"}],"citation":"Exod. 22:18."}]}