{"id":"18B","title":"Property Rights and Theft","part":{"n":18,"title":"Laws regarding property"},"url":"/law/18-laws-regarding-property/18b","entries":[{"id":"18B.1","text":"You shall not steal another's property.","refs":[{"book":"Exodus","chapter":20,"verses":"15"},{"book":"Leviticus","chapter":19,"verses":"11,13"},{"book":"Psalms","chapter":62,"verses":"10"},{"book":"Proverbs","chapter":21,"verses":"7"},{"book":"Amos","chapter":3,"verses":"10"},{"book":"Deuteronomy","chapter":5,"verses":"19"},{"book":"Matthew","chapter":19,"verses":"18"},{"book":"Mark","chapter":10,"verses":"19"},{"book":"Luke","chapter":18,"verses":"20"},{"book":"Romans","chapter":13,"verses":"9"},{"book":"1 Corinthians","chapter":6,"verses":"10"},{"book":"1 Peter","chapter":4,"verses":"15"}],"citation":"Exod. 20:15; Lev. 19:11, 13; Psa. 62:10; Prov. 21:7; Amos 3:10; Deut 5:19; Matt. 19:18; Mark 10: 19; Luke 18:20; Rom. 13:9; 1 Cor. 6:10; 1 Pet 4:15."},{"id":"18B.2","text":"Theft from the poor is especially forbidden.","refs":[{"book":"Proverbs","chapter":22,"verses":"22"}],"citation":"Prov. 22:22."},{"id":"18B.3","text":"A thief is cursed by God and to be cut off from the people.","refs":[{"book":"Jeremiah","chapter":7,"verses":"9-15"},{"book":"Zechariah","chapter":5,"verses":"3-4"},{"book":"1 Corinthians","chapter":6,"verses":"10"}],"citation":"Jer. 7:9-15; Zech. 5:3-4; 1 Cor. 6:10."},{"id":"18B.4","text":"Theft proceeds from the heart and defiles a man.","refs":[{"book":"Matthew","chapter":15,"verses":"19-20"}],"citation":"Matt. 15:19-20."},{"id":"18B.5","text":"One who is judged to have stolen property is to repay double to the owner.","refs":[{"book":"Exodus","chapter":22,"verses":"7-9"}],"citation":"Exod. 22:7-9."},{"id":"18B.6","text":"If one strikes a thief found breaking in a building and he dies, there shall be no guilt upon him for murder.","refs":[{"book":"Exodus","chapter":22,"verses":"2"}],"citation":"Exod. 22:2."},{"id":"18B.7","text":"We are exhorted to stop theft in the land by having a thief labor with his hands.","refs":[{"book":"Ephesians","chapter":4,"verses":"28"}],"citation":"Eph. 4:28."},{"id":"18B.8","text":"We should not despise one who steals due to hunger, though he must restore sevenfold of what he took.","refs":[{"book":"Proverbs","chapter":6,"verses":"30"}],"citation":"Prov. 6:30."}]}