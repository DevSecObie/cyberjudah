{"id":"20C","title":"Duty and Purpose of the Church","part":{"n":20,"title":"Churches & ministers"},"url":"/law/20-churches-ministers/20c","entries":[{"id":"20C.1","text":"The members of the church are to be as one body with one and the same Spirit as Christ's body.","refs":[{"book":"Romans","chapter":12,"verses":"5"},{"book":"1 Corinthians","chapter":10,"verses":"17"},{"book":"1 Corinthians","chapter":12,"verses":"11-31"},{"book":"Ephesians","chapter":4,"verses":"4"}],"citation":"Rom. 12:5; 1 Cor. 10: 17; 1 Cor. 12:11-31; Eph. 4:4."},{"id":"20C.2","text":"A church body should labor with perseverance for the sake of Christ's name.","refs":[{"book":"Revelation","chapter":2,"verses":"3"}],"citation":"Rev. 2:3."},{"id":"20C.3","text":"The church is to assist only those widows that are not in the care of anyone.","refs":[{"book":"1 Timothy","chapter":5,"verses":"16"}],"citation":"1 Tim. 5:16."},{"id":"20C.4","text":"A church body is not to be lukewarm in its beliefs, but be either hot or cold regarding them.","refs":[{"book":"Revelation","chapter":3,"verses":"15-16"}],"citation":"Rev. 3:15-16."},{"id":"20C.5","text":"The church is to make known the wisdom of God to civil leaders.","refs":[{"book":"Ephesians","chapter":3,"verses":"10"}],"citation":"Eph. 3:10."},{"id":"20C.6","text":"The house of God is to be a house of prayer.","refs":[{"book":"Matthew","chapter":21,"verses":"13"},{"book":"Mark","chapter":11,"verses":"17"},{"book":"Luke","chapter":19,"verses":"46"}],"citation":"Matt. 21:13; Mark 11:17; Luke 19:46."},{"id":"20C.7","text":"Christ is the head of the church.","refs":[{"book":"Ephesians","chapter":5,"verses":"23,29-30"}],"citation":"Eph. 5:23, 29-30."},{"id":"20C.8","text":"It is an abomination to do evil practices in God's house.","refs":[{"book":"2 Chronicles","chapter":36,"verses":"14"},{"book":"Jeremiah","chapter":7,"verses":"30"}],"citation":"2 Chron. 36:14; Jer. 7:30."},{"id":"20C.9","text":"The church is to be the pillar and ground of the truth.","refs":[{"book":"1 Timothy","chapter":3,"verses":"15"}],"citation":"1 Tim. 3:15."},{"id":"20C.10","text":"A church is to be for the purpose of teaching.","refs":[{"book":"Mark","chapter":12,"verses":"35"},{"book":"Acts","chapter":5,"verses":"21"},{"book":"Acts","chapter":11,"verses":"26"},{"book":"1 Corinthians","chapter":4,"verses":"17"},{"book":"1 Corinthians","chapter":14,"verses":"19"},{"book":"1 Corinthians","chapter":12,"verses":"28"}],"citation":"Mark 12:35; Acts 5:21; Acts 11:26; 1 Cor. 4:17; 1 Cor. 14:19; 1 Cor. 12:28."}]}