{"id":"6B","title":"Requirements of Children","part":{"n":6,"title":"Family law & relationships"},"url":"/law/06-family-law-relationships/6b","entries":[{"id":"6B.1","text":"Children are to obey and listen to their parents.","refs":[{"book":"Genesis","chapter":28,"verses":"7"},{"book":"Proverbs","chapter":1,"verses":"8,9"},{"book":"Proverbs","chapter":6,"verses":"20"},{"book":"Proverbs","chapter":13,"verses":"1"},{"book":"Proverbs","chapter":13,"verses":"22"},{"book":"Proverbs","chapter":23,"verses":"22"},{"book":"Romans","chapter":1,"verses":"30"},{"book":"Ephesians","chapter":6,"verses":"1"},{"book":"Colossians","chapter":3,"verses":"20"}],"citation":"Gen. 28:7; Prov. 1:8, 9; Prov. 6:20; Prov. 13:1; Prov. 13:22; Prov. 23:22; Rom. 1:30; Eph. 6:1; Col. 3:20."},{"id":"6B.2","text":"Children to honor their father and mother.","refs":[{"book":"Exodus","chapter":20,"verses":"12"},{"book":"Deuteronomy","chapter":5,"verses":"16"},{"book":"Matthew","chapter":15,"verses":"4"},{"book":"Mark","chapter":10,"verses":"19"},{"book":"Luke","chapter":18,"verses":"20"},{"book":"Ephesians","chapter":6,"verses":"2"}],"citation":"Exod. 20:12; Deut 5:16; Matt. 15:4; Mark 10: 19; Luke 18:20; Eph. 6:2."},{"id":"6B.3","text":"Everyone shall fear (reverence) his mother and his father.","refs":[{"book":"Leviticus","chapter":19,"verses":"3"}],"citation":"Lev. 19:3."},{"id":"6B.4","text":"Children are to hear the instruction of their father, and forsake not the law of their mother.","refs":[{"book":"Proverbs","chapter":1,"verses":"8"},{"book":"Proverbs","chapter":4,"verses":"1-2"},{"book":"Proverbs","chapter":6,"verses":"20"},{"book":"Proverbs","chapter":19,"verses":"27"}],"citation":"Prov. 1:8; Prov. 4:1-2; Prov. 6:20; Prov. 19:27."},{"id":"6B.5","text":"A wise son makes a father glad, but a foolish son is a grief to his mother and father.","refs":[{"book":"Proverbs","chapter":10,"verses":"1"},{"book":"Proverbs","chapter":17,"verses":"25"},{"book":"Proverbs","chapter":19,"verses":"13"}],"citation":"Prov. 10: 1; Prov. 17:25; Prov. 19:13."},{"id":"6B.6","text":"Children shall not rob their father or mother.","refs":[{"book":"Proverbs","chapter":28,"verses":"24"}],"citation":"Prov. 28:24."},{"id":"6B.7","text":"Children are to take care of their parents.","refs":[{"book":"Genesis","chapter":45,"verses":"9-11"},{"book":"Genesis","chapter":47,"verses":"12"},{"book":"1 Timothy","chapter":5,"verses":"4"}],"citation":"Gen. 45:9-11; Gen. 47:12; 1 Tim. 5:4."},{"id":"6B.8","text":"Children are not to curse their parents.","refs":[{"book":"Leviticus","chapter":20,"verses":"9"}],"citation":"Lev. 20:9."}]}