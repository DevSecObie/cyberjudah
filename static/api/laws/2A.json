{"id":"2A","title":"Access To God","part":{"n":2,"title":"Relationship to God"},"url":"/law/02-relationship-to-god/2a","entries":[{"id":"2A.1","text":"Access to God is by Christ.","refs":[{"book":"John","chapter":14,"verses":"6-7"},{"book":"Romans","chapter":5,"verses":"1-2"},{"book":"Ephesians","chapter":2,"verses":"12-13,18"},{"book":"Hebrews","chapter":7,"verses":"19,25"},{"book":"Hebrews","chapter":10,"verses":"19"},{"book":"1 Peter","chapter":3,"verses":"18"}],"citation":"John 14:6-7; Rom. 5:1-2; Eph. 2:12-13, 18; Heb. 7:19, 25; Heb. 10:19; 1 Pet 3:18."},{"id":"2A.2","text":"No man comes to the Father but by Christ.","refs":[{"book":"John","chapter":14,"verses":"6"}],"citation":"John 14:6."},{"id":"2A.3","text":"Access to God needed to obtain mercy and grace.","refs":[{"book":"Hebrews","chapter":4,"verses":"16"}],"citation":"Heb. 4:16."},{"id":"2A.4","text":"Draw near to God and He will draw near to you.","refs":[{"book":"James","chapter":4,"verses":"8"}],"citation":"James 4:8."},{"id":"2A.5","text":"Access to God is privileged to the saints of God.","refs":[{"book":"Deuteronomy","chapter":4,"verses":"7"},{"book":"Psalms","chapter":15,"verses":""},{"book":"Psalms","chapter":23,"verses":"6"},{"book":"Psalms","chapter":24,"verses":"3-4"}],"citation":"Deut. 4:7; Psa. 15; Psa. 23:6; Psa. 24:3-4."},{"id":"2A.6","text":"If you seek God, He will be found by you; but if you forsake Him, He will cast you off.","refs":[{"book":"Deuteronomy","chapter":4,"verses":"27-29"},{"book":"1 Chronicles","chapter":28,"verses":"9"}],"citation":"Deut. 4:27-29; 1 Chron. 28:9."},{"id":"2A.7","text":"The LORD is near to all who call upon Him in truth.","refs":[{"book":"Psalms","chapter":145,"verses":"18"}],"citation":"Psa. 145:18."},{"id":"2A.8","text":"We are to earnestly seek God.","refs":[{"book":"1 Chronicles","chapter":16,"verses":"11"},{"book":"Job","chapter":5,"verses":"8"},{"book":"Psalms","chapter":27,"verses":"4"},{"book":"Psalms","chapter":42,"verses":"1-2"},{"book":"Psalms","chapter":84,"verses":"1-2"},{"book":"Psalms","chapter":105,"verses":"4"},{"book":"Isaiah","chapter":55,"verses":"6"},{"book":"Hosea","chapter":10,"verses":"12"},{"book":"Zephaniah","chapter":2,"verses":"3"}],"citation":"1 Chron. 16:11; Job 5:8; Psa. 27:4; Psa. 42:1-2; Psa. 84:1-2; Psa. 105:4; Isa. 55:6; Hos. 10: 12; Zeph. 2:3."},{"id":"2A.9","text":"The wicked are commanded to seek God.","refs":[{"book":"Isaiah","chapter":55,"verses":"6-7"},{"book":"James","chapter":4,"verses":"8"}],"citation":"Isa. 55:6-7; James 4:8."},{"id":"2A.10","text":"We are to urge others to seek God.","refs":[{"book":"Isaiah","chapter":2,"verses":"3"},{"book":"Jeremiah","chapter":31,"verses":"6"}],"citation":"Isa. 2:3; Jer. 31:6."},{"id":"2A.11","text":"Those who are far from God shall perish, it is thus good to draw near to God.","refs":[{"book":"Psalms","chapter":73,"verses":"27-28"}],"citation":"Psa. 73:27-28."},{"id":"2A.12","text":"Seek the LORD and you shall live.","refs":[{"book":"Amos","chapter":5,"verses":"4-6"}],"citation":"Amos 5:4-6."}]}