{"id":"11A","title":"Foreign Enemies","part":{"n":11,"title":"Foreign relations"},"url":"/law/11-foreign-relations/11a","entries":[{"id":"11A.1","text":"We are to pray for deliverance from our enemies.","refs":[{"book":"1 Samuel","chapter":12,"verses":"10-11"},{"book":"Psalms","chapter":17,"verses":"6-9"},{"book":"Psalms","chapter":35,"verses":"15-17"},{"book":"Psalms","chapter":59,"verses":"1"},{"book":"Psalms","chapter":64,"verses":"1"}],"citation":"1 Sam. 12:10-11; Psa. 17:6-9; Psa. 35:15-17; Psa. 59:1; Psa.64:1."},{"id":"11A.2","text":"Overcome enemies by kindness.","refs":[{"book":"1 Samuel","chapter":26,"verses":"21"},{"book":"Romans","chapter":12,"verses":"20-21"}],"citation":"1 Sam. 26:21; 25:21-22; Rom. 12:20-21."},{"id":"11A.3","text":"Christ's enemies are to be destroyed.","refs":[{"book":"Luke","chapter":19,"verses":"27"}],"citation":"Luke 19:27."}]}