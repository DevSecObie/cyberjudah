{"id":"15D","title":"Handicapped","part":{"n":15,"title":"General welfare"},"url":"/law/15-general-welfare/15d","entries":[{"id":"15D.1","text":"We are not to curse the deaf or put a stumbling block before the blind.","refs":[{"book":"Leviticus","chapter":19,"verses":"14"}],"citation":"Lev. 19:14."},{"id":"15D.2","text":"Cursed be he that causes the blind to wander out of the way.","refs":[{"book":"Deuteronomy","chapter":27,"verses":"18"}],"citation":"Deut 27:18."},{"id":"15D.3","text":"We are to invite the maimed, the lame and the blind to our feasts.","refs":[{"book":"Luke","chapter":14,"verses":"13"}],"citation":"Luke 14:13."},{"id":"15D.4","text":"Show respect for the aged.","refs":[{"book":"Leviticus","chapter":19,"verses":"32"},{"book":"1 Timothy","chapter":5,"verses":"1"}],"citation":"Lev. 19:32; 1 Tim. 5:1."},{"id":"15D.5","text":"You should support and help the weak.","refs":[{"book":"Acts","chapter":20,"verses":"35"},{"book":"Romans","chapter":15,"verses":"1"}],"citation":"Acts 20:35; Rom. 15:1."}]}