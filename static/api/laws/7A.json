{"id":"7A","title":"Animals Used For Labor","part":{"n":7,"title":"Animal regulations"},"url":"/law/07-animal-regulations/7a","entries":[{"id":"7A.1","text":"You are not to work animals on the Sabbath.","refs":[{"book":"Exodus","chapter":20,"verses":"10"},{"book":"Exodus","chapter":23,"verses":"12"},{"book":"Deuteronomy","chapter":5,"verses":"14"}],"citation":"Exod. 20:10; Exod. 23:12; Deut 5:14."},{"id":"7A.2","text":"You are not to have two different kinds of animals work together; You shall not plow with an ox and an ass together.","refs":[{"book":"Deuteronomy","chapter":22,"verses":"10"}],"citation":"Deut 22:10."},{"id":"7A.3","text":"You shall not muzzle the mouth of the ox that is being used for work.","refs":[{"book":"Deuteronomy","chapter":25,"verses":"4"},{"book":"1 Corinthians","chapter":9,"verses":"9"},{"book":"1 Timothy","chapter":5,"verses":"18"}],"citation":"Deut 25:4; 1 Cor. 9:9; 1 Tim. 5:18."}]}