{"id":"5A","title":"Principles of Marriage","part":{"n":5,"title":"Marriage and Divorce"},"url":"/law/05-marriage-and-divorce/5a","entries":[{"id":"5A.1","text":"Marriage between man and woman is instituted by God as a good and natural thing.","refs":[{"book":"Genesis","chapter":2,"verses":"18"},{"book":"Proverbs","chapter":18,"verses":"22"},{"book":"Matthew","chapter":19,"verses":"4"},{"book":"Mark","chapter":10,"verses":"6"}],"citation":"Gen. 2:18; Prov. 18:22; Matt. 19:4; Mark 10:6."},{"id":"5A.2","text":"Husband and wife are to remain together for life (marriage vows to be kept).","refs":[{"book":"Genesis","chapter":2,"verses":"24"},{"book":"Matthew","chapter":19,"verses":"5"},{"book":"Mark","chapter":10,"verses":"7"},{"book":"1 Corinthians","chapter":7,"verses":"10-11,27"}],"citation":"Gen. 2:24; Matt. 19:5; Mark 10:7; 1 Cor. 7:10-11, 27."},{"id":"5A.3","text":"A woman is bound by the law to her husband so long as he lives; but if the husband dies, she is released from the law concerning the husband.","refs":[{"book":"Romans","chapter":7,"verses":"2-3"}],"citation":"Rom. 7:2-3."},{"id":"5A.4","text":"Husband and wife regarded as one flesh. Gen, 2:23-24;","refs":[{"book":"Matthew","chapter":19,"verses":"5"},{"book":"Mark","chapter":10,"verses":"8"},{"book":"Ephesians","chapter":5,"verses":"31"}],"citation":"Matt. 19:5; Mark 10:8; Eph. 5:31."},{"id":"5A.5","text":"Marriage is honorable among all, and the bed undefiled.","refs":[{"book":"Hebrews","chapter":13,"verses":"4"}],"citation":"Heb. 13:4."},{"id":"5A.6","text":"Husband and wife are to have children (be fruitful and multiply).","refs":[{"book":"Genesis","chapter":1,"verses":"28"},{"book":"Genesis","chapter":9,"verses":"1,7"},{"book":"Genesis","chapter":35,"verses":"11"},{"book":"Psalms","chapter":127,"verses":"3"},{"book":"Jeremiah","chapter":29,"verses":"6"},{"book":"1 Timothy","chapter":5,"verses":"14"}],"citation":"Gen. 1:28; Gen. 9:1, 7; Gen. 35:11; Psa. 127:3; Jer. 29:6; 1 Tim. 5:14."},{"id":"5A.7","text":"Marriage bonds are of God and not to be put asunder by any man.","refs":[{"book":"Matthew","chapter":19,"verses":"6"},{"book":"Mark","chapter":10,"verses":"9"}],"citation":"Matt. 19:6; Mark 10:9."},{"id":"5A.8","text":"Man is not independent of woman, nor is woman independent of man.","refs":[{"book":"1 Corinthians","chapter":7,"verses":"4"},{"book":"1 Corinthians","chapter":11,"verses":"11"}],"citation":"1 Cor. 7:4; 1 Cor. 11: 11."}]}