{"id":"1A","title":"Ten Commandments","part":{"n":1,"title":"The Ten Commandments"},"url":"/law/01-the-ten-commandments/1a","entries":[{"id":"1A.1","text":"I am the LORD your God, you shall have no other gods besides me.","refs":[{"book":"Exodus","chapter":20,"verses":"2-3"},{"book":"Deuteronomy","chapter":5,"verses":"6-7"}],"citation":"Exod. 20:2-3; Deut. 5:6-7."},{"id":"1A.2","text":"You shall not make for yourself any carved image, or any likeness of anything; you shall not bow down to them nor serve them.","refs":[{"book":"Exodus","chapter":20,"verses":"4-5"},{"book":"Deuteronomy","chapter":5,"verses":"8-9"}],"citation":"Exod. 20:4-5; Deut. 5:8-9."},{"id":"1A.3","text":"You shall not take the name of the LORD your God in vain.","refs":[{"book":"Exodus","chapter":20,"verses":"7"},{"book":"Deuteronomy","chapter":5,"verses":"11"}],"citation":"Exod. 20:7; Deut. 5:11."},{"id":"1A.4","text":"Observe the Sabbath day, to keep it holy.","refs":[{"book":"Exodus","chapter":20,"verses":"8-11"},{"book":"Deuteronomy","chapter":5,"verses":"12"}],"citation":"Exod. 20:8-11; Deut 5:12."},{"id":"1A.5","text":"Honor your father and your mother.","refs":[{"book":"Exodus","chapter":20,"verses":"12"},{"book":"Deuteronomy","chapter":5,"verses":"16"}],"citation":"Exod. 20:12; Deut. 5:16."},{"id":"1A.6","text":"You shall not murder.","refs":[{"book":"Exodus","chapter":20,"verses":"13"},{"book":"Deuteronomy","chapter":5,"verses":"17"}],"citation":"Exod. 20:13; Deut. 5:17."},{"id":"1A.7","text":"You shall not commit adultery.","refs":[{"book":"Exodus","chapter":20,"verses":"14"},{"book":"Deuteronomy","chapter":5,"verses":"18"}],"citation":"Exod. 20:14; Deut. 5:18."},{"id":"1A.8","text":"You shall not steal.","refs":[{"book":"Exodus","chapter":20,"verses":"15"},{"book":"Deuteronomy","chapter":5,"verses":"19"}],"citation":"Exod. 20:15; Deut. 5:19."},{"id":"1A.9","text":"You shall not bear false witness.","refs":[{"book":"Exodus","chapter":20,"verses":"16"},{"book":"Deuteronomy","chapter":5,"verses":"20"}],"citation":"Exod. 20:16; Deut. 5:20."},{"id":"1A.10","text":"You shall not covet anything that is your neighbor's.","refs":[{"book":"Exodus","chapter":20,"verses":"17"},{"book":"Deuteronomy","chapter":5,"verses":"21"}],"citation":"Exod. 20:17; Deut 5:21."}]}