{"id":"17K","title":"Hypocrisy","part":{"n":17,"title":"Personal character traits"},"url":"/law/17-personal-character-traits/17k","entries":[{"id":"17K.1","text":"Do not be hypocritical in serving God or in living a godly life.","refs":[{"book":"Matthew","chapter":23,"verses":"13-33"}],"citation":"Matt. 23:13-33."},{"id":"17K.2","text":"Hypocrisy is condemned as causing apostasy.","refs":[{"book":"1 Timothy","chapter":4,"verses":"1-2"}],"citation":"1 Tim. 4:1-2."},{"id":"17K.3","text":"God has no pleasure in hypocrites.","refs":[{"book":"Isaiah","chapter":9,"verses":"17"}],"citation":"Isa. 9:17."},{"id":"17K.4","text":"A hypocrite shall not come before God.","refs":[{"book":"Job","chapter":13,"verses":"16"}],"citation":"Job 13:16."},{"id":"17K.5","text":"We are not to have hypocritical leaders because they ensnare the people.","refs":[{"book":"Job","chapter":34,"verses":"30"}],"citation":"Job. 34:30."},{"id":"17K.6","text":"Christian growth requires you set aside all hypocrisies.","refs":[{"book":"1 Peter","chapter":2,"verses":"1-2"}],"citation":"1 Pet 2:1-2."},{"id":"17K.7","text":"A hypocrite is destructive to others.","refs":[{"book":"Proverbs","chapter":11,"verses":"9"}],"citation":"Prov. 11:9."},{"id":"17K.8","text":"Beware of the principles of hypocrisy.","refs":[{"book":"Luke","chapter":12,"verses":"1"}],"citation":"Luke 12:1."},{"id":"17K.9","text":"Punishment due to hypocrites.","refs":[{"book":"Job","chapter":15,"verses":"34"},{"book":"Isaiah","chapter":10,"verses":"5-6"},{"book":"Jeremiah","chapter":42,"verses":"20-22"},{"book":"Matthew","chapter":24,"verses":"51"}],"citation":"Job 15:34; Isa. 10:5-6; Jer. 42:20-22; Matt. 24:51."}]}