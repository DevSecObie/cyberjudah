{"id":"10B","title":"Sabbath Desecration","part":{"n":10,"title":"Capital laws & offenses"},"url":"/law/10-capital-laws-offenses/10b","entries":[{"id":"10B.1","text":"Every one that defiles the Sabbath by doing servile work on that day shall be put to death.","refs":[{"book":"Exodus","chapter":31,"verses":"14-15"},{"book":"Exodus","chapter":35,"verses":"2"},{"book":"Numbers","chapter":15,"verses":"32-36"}],"citation":"Exod. 31:14-15; Exod. 35:2; Num. 15:32-36."}]}