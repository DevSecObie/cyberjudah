{"id":"10J","title":"Crimes of Sexual Immorality","part":{"n":10,"title":"Capital laws & offenses"},"url":"/law/10-capital-laws-offenses/10j","entries":[{"id":"10J.1","text":"The adulterer and adulteress are to be put to death.","refs":[{"book":"Leviticus","chapter":20,"verses":"10"},{"book":"Deuteronomy","chapter":22,"verses":"22"},{"book":"Ezekiel","chapter":18,"verses":"11,13"}],"citation":"Lev.20:10; Deut. 22:22; Ezek. 18:11, 13."},{"id":"10J.2","text":"Sexual relations to affinity of blood that require death.","refs":[{"book":"Leviticus","chapter":20,"verses":"11,12,14"}],"citation":"Lev. 20:11, 12, 20, 21."},{"id":"10J.3","text":"Those guilty of sodomy (homosexuality) to be put to death.","refs":[{"book":"Leviticus","chapter":18,"verses":"22"},{"book":"Leviticus","chapter":20,"verses":"13"}],"citation":"Lev. 18:22; Lev. 20:13."},{"id":"10J.4","text":"The act of sodomy condemned as an abomination and an unnatural act.","refs":[{"book":"Leviticus","chapter":18,"verses":"22"},{"book":"Romans","chapter":1,"verses":"26-27,32"},{"book":"1 Corinthians","chapter":6,"verses":"9"}],"citation":"Lev. 18:22: Rom. 1:26-27, 32: 1 Cor. 6:9."},{"id":"10J.5","text":"Sodomites are not allowed to exist in the nation.","refs":[{"book":"Deuteronomy","chapter":23,"verses":"17"}],"citation":"Deut. 23:17."},{"id":"10J.6","text":"Those having sexual relations with animals are to be put to death.","refs":[{"book":"Exodus","chapter":22,"verses":"19"},{"book":"Leviticus","chapter":18,"verses":"23"},{"book":"Leviticus","chapter":20,"verses":"15-16"},{"book":"Deuteronomy","chapter":27,"verses":"21"}],"citation":"Exod. 22:19: Lev. 18:23; Lev. 20:15-16; Deut. 27:21."},{"id":"10J.7","text":"Whores or prostitutes are to be put to death.","refs":[{"book":"Leviticus","chapter":21,"verses":"9"},{"book":"Deuteronomy","chapter":22,"verses":"21"},{"book":"Deuteronomy","chapter":23,"verses":"17"}],"citation":"Lev. 21:9; Deut 22:21; Deut 23:17."},{"id":"10J.8","text":"If a virgin betrothed to a husband lie with another man, both the man and woman shall be put to death.","refs":[{"book":"Deuteronomy","chapter":22,"verses":"24"}],"citation":"Deut 22:24."},{"id":"10J.9","text":"A rapist is to be put to death.","refs":[{"book":"Deuteronomy","chapter":22,"verses":"25-26"}],"citation":"Deut. 22:25-26."}]}