{"id":"5C","title":"Wife's Duties & Responsibilities","part":{"n":5,"title":"Marriage and Divorce"},"url":"/law/05-marriage-and-divorce/5c","entries":[{"id":"5C.1","text":"Wives are to obey their husband.","refs":[{"book":"1 Corinthians","chapter":14,"verses":"34"},{"book":"Titus","chapter":2,"verses":"5"}],"citation":"1 Cor. 14:34; Titus 2:5."},{"id":"5C.2","text":"Wife is to remain with her husband for life.","refs":[{"book":"Romans","chapter":7,"verses":"2,3"}],"citation":"Rom. 7:2, 3."},{"id":"5C.3","text":"Wives to be in subjection to their husbands.","refs":[{"book":"Genesis","chapter":3,"verses":"16"},{"book":"Ephesians","chapter":5,"verses":"22,24"},{"book":"Colossians","chapter":3,"verses":"18"},{"book":"1 Peter","chapter":3,"verses":"1,5-6"}],"citation":"Gen. 3:16; Eph. 5:22, 24; Col. 3:18; 1 Pet. 3:1, 5-6."},{"id":"5C.4","text":"The wife is to take care of the house and family needs.","refs":[{"book":"Proverbs","chapter":14,"verses":"1"},{"book":"Proverbs","chapter":31,"verses":"10-31"},{"book":"1 Timothy","chapter":5,"verses":"14"},{"book":"Titus","chapter":2,"verses":"5"}],"citation":"Prov. 14:1; Prov. 31:10- 31; 1 Tim. 5:14; Titus 2:5."},{"id":"5C.5","text":"Wives are to be modest, chaste, discreet and sober.","refs":[{"book":"1 Timothy","chapter":2,"verses":"9,15"},{"book":"Titus","chapter":2,"verses":"4-5"}],"citation":"1 Tim. 2:9, 15; Titus 2:4-5."},{"id":"5C.6","text":"Wife not to usurp authority over the man.","refs":[{"book":"1 Timothy","chapter":2,"verses":"12"},{"book":"Titus","chapter":2,"verses":"5"}],"citation":"1 Tim. 2:12; Titus 2:5."},{"id":"5C.7","text":"The wife is not to raise questions in the church but to ask through her husband.","refs":[{"book":"1 Corinthians","chapter":14,"verses":"34-35"}],"citation":"1 Cor. 14:34-35."},{"id":"5C.8","text":"Wives are to render due benevolence or affection to her husband.","refs":[{"book":"1 Corinthians","chapter":7,"verses":"3"}],"citation":"1 Cor. 7:3."},{"id":"5C.9","text":"A wife is to be virtuous.","refs":[{"book":"Proverbs","chapter":12,"verses":"4"},{"book":"Proverbs","chapter":31,"verses":"10-11"}],"citation":"Prov. 12:4; Prov. 31:10-11."},{"id":"5C.10","text":"Wife is to love her husband and children.","refs":[{"book":"Titus","chapter":2,"verses":"4"}],"citation":"Titus 2:4."},{"id":"5C.11","text":"A woman of valor is the crown of her husband, but she who shames him is as rottenness in his bones.","refs":[{"book":"Proverbs","chapter":12,"verses":"4"}],"citation":"Prov. 12:4."},{"id":"5C.12","text":"Wife is to reverence her husband.","refs":[{"book":"Ephesians","chapter":5,"verses":"33"}],"citation":"Eph. 5:33."},{"id":"5C.13","text":"Wife is to be faithful to her husband.","refs":[{"book":"1 Corinthians","chapter":7,"verses":"3-5,10"}],"citation":"1 Cor. 7:3-5, 10."},{"id":"5C.14","text":"Wives are to love their children.","refs":[{"book":"Titus","chapter":2,"verses":"4"}],"citation":"Titus 2:4."}]}