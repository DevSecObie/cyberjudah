{"id":"2M","title":"Glorifying & Praising God","part":{"n":2,"title":"Relationship to God"},"url":"/law/02-relationship-to-god/2m","entries":[{"id":"2M.1","text":"We are to give glory and praise unto God.","refs":[{"book":"1 Chronicles","chapter":16,"verses":"28-29"},{"book":"Psalms","chapter":22,"verses":"23"},{"book":"Psalms","chapter":86,"verses":"9"},{"book":"Isaiah","chapter":42,"verses":"12"},{"book":"Isaiah","chapter":43,"verses":"21"},{"book":"Matthew","chapter":15,"verses":"31"},{"book":"Acts","chapter":4,"verses":"21"},{"book":"Acts","chapter":11,"verses":"18"},{"book":"Revelation","chapter":5,"verses":"13"},{"book":"Revelation","chapter":14,"verses":"7"}],"citation":"1 Chron. 16:28-29; Psa. 22:23; Psa. 86:9; Isa. 42:12; Isa. 43:21; Matt. 15:31; Acts 4:21; Acts 11:18; Rev. 5:13; Rev. 14:7."},{"id":"2M.2","text":"We should glorify God in body and spirit.","refs":[{"book":"1 Corinthians","chapter":6,"verses":"20"}],"citation":"1 Cor. 6:20."},{"id":"2M.3","text":"Whether you eat or drink, or whatever you do, do all to the glory of God.","refs":[{"book":"1 Corinthians","chapter":10,"verses":"31"}],"citation":"1 Cor. 10:31."},{"id":"2M.4","text":"Let no one glory or boast in men.","refs":[{"book":"1 Corinthians","chapter":3,"verses":"21"},{"book":"1 Thessalonians","chapter":2,"verses":"6"}],"citation":"1 Cor. 3:21; 1 Thes. 2:6."},{"id":"2M.5","text":"Praise should be offered to God continually.","refs":[{"book":"Psalms","chapter":34,"verses":"1"},{"book":"Psalms","chapter":35,"verses":"28"},{"book":"Psalms","chapter":44,"verses":"8"},{"book":"Psalms","chapter":45,"verses":"17"},{"book":"Psalms","chapter":71,"verses":"6"}],"citation":"Psa. 34:1; Psa. 35:28; Psa. 44:8; Psa. 45:17; Psa. 71:6."},{"id":"2M.6","text":"We are to give to God the glory and praise due to his name (the LORD's name is to be praised).","refs":[{"book":"Psalms","chapter":29,"verses":"2"},{"book":"Psalms","chapter":96,"verses":"8"},{"book":"Psalms","chapter":113,"verses":"1,3"},{"book":"Psalms","chapter":135,"verses":"1"},{"book":"Psalms","chapter":145,"verses":"1-3"}],"citation":"Psa. 29:2; Psa. 96:8; Psa. 113:1, 3; Psa. 135:1; Psa. 145:1-3."},{"id":"2M.7","text":"Exalt the LORD our God.","refs":[{"book":"Psalms","chapter":99,"verses":"5,9"},{"book":"Psalms","chapter":118,"verses":"28"},{"book":"Isaiah","chapter":25,"verses":"1-3"}],"citation":"Psa. 99:5,9; Psa. 118:28; Isa. 25:1-3."},{"id":"2M.8","text":"Praise and exalt the name of God with song.","refs":[{"book":"Exodus","chapter":15,"verses":"2"},{"book":"Psalms","chapter":9,"verses":"11"},{"book":"Psalms","chapter":27,"verses":"6"},{"book":"Psalms","chapter":30,"verses":"4"},{"book":"Psalms","chapter":40,"verses":"3"},{"book":"Psalms","chapter":47,"verses":"6"},{"book":"Psalms","chapter":66,"verses":"4"},{"book":"Psalms","chapter":68,"verses":"4,32"},{"book":"Psalms","chapter":69,"verses":"30"},{"book":"Psalms","chapter":101,"verses":"1"},{"book":"Psalms","chapter":135,"verses":"3"},{"book":"Isaiah","chapter":12,"verses":"4-5"},{"book":"Isaiah","chapter":42,"verses":"10"},{"book":"Jeremiah","chapter":31,"verses":"7"}],"citation":"Exod. 15:2; Psa. 9:11; Psa. 27:6; Psa. 30:4; Psa. 40:3; Psa. 47:6; Psa. 66:4; Psa. 68:4, 32; Psa. 69:30; Psa. 101:1; Psa. 135:3; Isa. 12:4-5; Isa. 42:10; Jer. 31:7."},{"id":"2M.9","text":"Punishment for not giving glory unto the name of God.","refs":[{"book":"Daniel","chapter":5,"verses":"23"},{"book":"Malachi","chapter":2,"verses":"2"},{"book":"Acts","chapter":12,"verses":"23"},{"book":"Romans","chapter":1,"verses":"21"}],"citation":"Dan. 5:23; Mal. 2:2; Acts 12:23; Rom. 1:21."},{"id":"2M.10","text":"Praise God for healing received.","refs":[{"book":"Acts","chapter":3,"verses":"6-8"}],"citation":"Acts 3:6-8."},{"id":"2M.11","text":"Glorify God to others by your good works which they may observe.","refs":[{"book":"1 Peter","chapter":2,"verses":"12"}],"citation":"1 Pet 2:12."},{"id":"2M.12","text":"He who glories, let him glory in the LORD.","refs":[{"book":"Jeremiah","chapter":9,"verses":"24"},{"book":"1 Corinthians","chapter":1,"verses":"31"},{"book":"2 Corinthians","chapter":10,"verses":"17"}],"citation":"Jer. 9:24; 1 Cor. 1:31; 2 Cor. 10:17."},{"id":"2M.13","text":"Praise and extol the LORD in the congregation of the people and among the multitude.","refs":[{"book":"Psalms","chapter":107,"verses":"32"},{"book":"Psalms","chapter":111,"verses":"1"},{"book":"Psalms","chapter":109,"verses":"30"},{"book":"Psalms","chapter":149,"verses":"1"}],"citation":"Psa. 107:32; Psa. 111:1; Psa. 109:30; Psa. 149:1."}]}